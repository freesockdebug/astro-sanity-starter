---
// src/layouts/BuyerLayout.astro
// Unified B2B Buyer Shell: Fluid Vertical Sidebar, Desktop Breadcrumb, Mobile Sticky Bars, and Embedded QuoteDrawer
import Layout from './Layout.astro';
import BuyerSidebar from '@components/buyer/BuyerSidebar.astro';
import TierBadge from '@components/TierBadge.astro';
import QuoteDrawer from '@components/QuoteDrawer.astro';
import { getLocalizedPath, getLangFromUrl, useTranslations } from '@i18n';

interface Props {
  title: string;
  description?: string;
  currentTab: 'orders' | 'account';
  sessionUser: {
    id: string;
    email: string;
    name?: string;
    company?: string;
    isAdmin?: boolean;
  };
  dbUser?: {
    tier?: string;
    company?: string;
    name?: string;
    country?: string;
    phone?: string;
  } | null;
  totalOrdersCount?: number;
}

const {
  title,
  description,
  currentTab,
  sessionUser,
  dbUser,
  totalOrdersCount = 0,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const tabNames: Record<string, string> = {
  orders: t('orders.tabOrdersTitle'),
  account: t('orders.tabAccountTitle'),
};

const currentTabTitle = tabNames[currentTab] || t('buyer.portal');
const isShellReq = Astro.request.headers.get('x-shell-request') === '1';

const displayName = dbUser?.name || sessionUser.name || sessionUser.email.split('@')[0];
const displayCompany = dbUser?.company || sessionUser.company || '';
const tier = dbUser?.tier || 'STANDARD';
const initial = (displayName || sessionUser.email || 'B').slice(0, 1).toUpperCase();
---

<Layout
  title={`${title} | Buyer Portal`}
  description={description}
  bare={true}
  bodyClass="bg-[#f5f5f7] text-[#1d1d1f] font-sans antialiased selection:bg-zinc-900 selection:text-white min-h-screen"
>
  <div id="shell-root" class="min-h-screen flex flex-col lg:flex-row">
    <!-- 1. Left Grouped Vertical Sidebar (Slide-over on Mobile, Sticky on Desktop >= lg) -->
    {
      !isShellReq && (
        <BuyerSidebar
          currentTab={currentTab}
          sessionUser={sessionUser}
          dbUser={dbUser}
          totalOrdersCount={totalOrdersCount}
          currentLang={currentLang}
        />
      )
    }

    <!-- 2. Right Main Canvas Area -->
    <div id="shell-right-col" class="relative flex-1 flex flex-col min-w-0">
      {
        !isShellReq && (
          <>
            <!-- Mobile Top Sticky Bar (< lg): 56px (h-14) Compact Header -->
            <header class="lg:hidden h-14 flex items-center justify-between px-3.5 bg-white/95 backdrop-blur-md border-b border-black/10 sticky top-0 z-30 shadow-2xs print:hidden">
              <div class="flex items-center gap-2">
                <button
                  id="buyer-open-sidebar-btn"
                  type="button"
                  class="p-2 -ml-1 rounded-xl text-[#1d1d1f] hover:bg-[#f5f5f7] active:scale-95 transition-all cursor-pointer"
                  aria-label="Open Navigation Menu"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                </button>
                <span class="text-sm font-bold tracking-tight text-[#1d1d1f]">Buyer Portal</span>
                <TierBadge tier={dbUser?.tier} size="sm" variant="short" />
              </div>

              <div class="flex items-center gap-2">
                <label
                  for="quote-drawer-toggle"
                  id="mobile-header-quote-btn"
                  class="relative p-2 rounded-xl text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all cursor-pointer"
                  aria-label="Open Quote Basket"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <span class="nav-quote-badge quote-badge hidden absolute -top-0.5 -right-0.5 px-1.5 py-0.2 rounded-full text-[9px] font-bold bg-[#1d1d1f] text-white min-w-[14px] text-center shadow-xs">
                    0
                  </span>
                </label>

                <a
                  href={getLocalizedPath('/products', currentLang)}
                  class="px-2 py-1 rounded-lg bg-[#f5f5f7] border border-black/5 text-[#52525b] hover:text-black text-xs font-medium"
                >
                  {t('buyer.browseCatalog')} ↗
                </a>

                <button
                  id="buyer-account-trigger-mobile"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  class="group p-1 rounded-xl bg-[#f5f5f7] hover:bg-black/5 border border-black/10 text-xs transition-all cursor-pointer flex items-center gap-1"
                  aria-label="Account Menu"
                >
                  <div class="w-6 h-6 rounded-lg bg-[#1d1d1f] text-white flex items-center justify-center font-mono font-semibold text-[11px] shrink-0">
                    {initial}
                  </div>
                  <svg class="w-3 h-3 text-[#86868b] transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            </header>

            <!-- Desktop Top Context Breadcrumb Bar (>= lg) -->
            <header class="hidden lg:flex items-center justify-between px-8 py-3.5 bg-white/95 backdrop-blur-md border-b border-black/5 shrink-0 print:hidden sticky top-0 z-30">
              <div class="flex items-center gap-2 text-xs">
                <span class="text-[#86868b]">{t('buyer.portal')}</span>
                <span class="text-[#86868b]">/</span>
                <span id="shell-breadcrumb-title" class="font-semibold text-[#1d1d1f]">{currentTabTitle}</span>
              </div>

              <div class="flex items-center gap-3 text-xs">
                <a
                  href={getLocalizedPath('/products', currentLang)}
                  class="text-[#52525b] hover:text-[#1d1d1f] transition-colors font-medium flex items-center gap-1"
                >
                  <span>← {t('buyer.backToCatalog')}</span>
                </a>

                <label
                  for="quote-drawer-toggle"
                  id="desktop-header-quote-btn"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1d1d1f] hover:bg-black text-white transition-all text-xs font-semibold shadow-2xs cursor-pointer active:scale-95"
                >
                  <span>🛒 {t('buyer.openQuoteBag')}</span>
                  <span class="nav-quote-badge quote-badge hidden px-1.5 py-0.2 rounded-md text-[10px] font-bold bg-white text-[#1d1d1f]">
                    0
                  </span>
                </label>

                <div class="h-4 w-px bg-black/10 shrink-0"></div>

                <button
                  id="buyer-account-trigger-desktop"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  class="group inline-flex items-center gap-2 p-1 pl-2.5 rounded-xl bg-[#f5f5f7] hover:bg-black/5 border border-black/10 text-xs transition-all cursor-pointer shadow-2xs select-none"
                >
                  <TierBadge tier={tier} size="sm" variant="short" />
                  <span class="font-semibold text-[#1d1d1f] max-w-[120px] truncate">{displayName}</span>
                  <div class="w-6 h-6 rounded-lg bg-[#1d1d1f] text-white flex items-center justify-center font-mono font-semibold text-[11px] shrink-0">
                    {initial}
                  </div>
                  <svg class="w-3 h-3 text-[#86868b] transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            </header>

            <!-- Buyer Account Popover Dropdown Card -->
            <div
              id="buyer-account-popover"
              class="hidden fixed right-3.5 lg:right-8 top-14 w-64 bg-white border border-black/10 rounded-2xl shadow-xl p-2 z-50 transition-all origin-top-right text-xs print:hidden"
              role="menu"
              aria-orientation="vertical"
            >
              <!-- Buyer Info Header -->
              <div class="p-2.5 border-b border-black/5 bg-[#fafafa] rounded-xl mb-1.5">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-[#1d1d1f] text-white flex items-center justify-center font-mono font-semibold text-xs shrink-0">
                      {initial}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold text-[#1d1d1f] truncate">{displayName}</p>
                      {displayCompany && <p class="text-[10px] text-[#52525b] truncate">{displayCompany}</p>}
                    </div>
                  </div>
                  <TierBadge tier={tier} size="sm" variant="short" />
                </div>
                <p class="text-[10px] text-[#86868b] font-mono truncate mt-1.5">{sessionUser.email}</p>
              </div>

              <!-- Navigation Actions -->
              <div class="space-y-0.5">
                <a
                  href={getLocalizedPath('/account', currentLang)}
                  data-tab-key="account"
                  data-tab-title={t('orders.tabAccountTitle')}
                  class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-[#1d1d1f] hover:bg-[#f5f5f7] transition-colors font-medium buyer-popover-nav-item"
                >
                  <span>👤</span>
                  <span>{t('orders.tabAccountTitle')}</span>
                </a>

                <a
                  href={getLocalizedPath('/orders', currentLang)}
                  data-tab-key="orders"
                  data-tab-title={t('orders.tabOrdersTitle')}
                  class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-[#1d1d1f] hover:bg-[#f5f5f7] transition-colors font-medium buyer-popover-nav-item"
                >
                  <span>📦</span>
                  <span>{t('orders.tabOrdersTitle')}</span>
                </a>

                {sessionUser?.isAdmin && (
                  <a
                    href="/admin/orders"
                    class="flex items-center justify-between px-2.5 py-2 rounded-lg text-amber-900 bg-amber-50/70 hover:bg-amber-100/80 transition-colors font-semibold"
                  >
                    <div class="flex items-center gap-2">
                      <span>⚙️</span>
                      <span>Switch to Admin</span>
                    </div>
                    <span class="text-[10px] text-amber-800 font-mono">↗</span>
                  </a>
                )}
              </div>

              <!-- Sign Out -->
              <div class="pt-1 mt-1 border-t border-black/5">
                <a
                  href="/api/auth/logout"
                  class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-rose-600 hover:text-rose-700 hover:bg-rose-50 transition-colors font-medium"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span>{t('orders.signOut')}</span>
                </a>
              </div>
            </div>
          </>
        )
      }

      <!-- Main Dynamic Content Canvas: Bottom padded pb-24 on mobile to clear Bottom Tab Bar -->
      <div id="shell-main-canvas" class="flex-1 p-[clamp(1rem,0.4rem+2vw,2.25rem)] pb-24 lg:pb-8 w-full max-w-[1700px] mx-auto">
        <slot />
      </div>
    </div>
  </div>

  <!-- Mobile High-Frequency Bottom Tab Bar (< lg) -->
  {
    !isShellReq && (
      <nav
        class="fixed bottom-0 inset-x-0 h-14 bg-white/95 backdrop-blur-md border-t border-black/10 z-30 lg:hidden flex items-center justify-around px-2 pb-[max(0px,env(safe-area-inset-bottom))] shadow-lg print:hidden"
        aria-label="Mobile Quick Bottom Navigation"
      >
        <!-- Tab 1: Orders -->
        <a
          href={getLocalizedPath('/orders', currentLang)}
          data-shell-nav="buyer"
          data-tab-key="orders"
          data-tab-title={t('orders.tabOrdersTitle')}
          class:list={[
            'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors relative',
            currentTab === 'orders' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
          ]}
        >
          <div class="relative">
            <span class="text-base">📦</span>
            {totalOrdersCount > 0 && (
              <span class="absolute -top-1 -right-2 bg-amber-500 text-white font-mono text-[9px] font-bold px-1 rounded-full min-w-[14px] text-center">
                {totalOrdersCount}
              </span>
            )}
          </div>
          <span class="truncate max-w-[22vw]">{t('orders.breadcrumb')}</span>
        </a>

        <!-- Tab 2: Account -->
        <a
          href={getLocalizedPath('/account', currentLang)}
          data-shell-nav="buyer"
          data-tab-key="account"
          data-tab-title={t('orders.tabAccountTitle')}
          class:list={[
            'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors',
            currentTab === 'account' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
          ]}
        >
          <span class="text-base">👤</span>
          <span class="truncate max-w-[22vw]">{t('orders.tabAccountTitle')}</span>
        </a>

        <!-- Tab 3: Quote Bag Drawer -->
        <label
          for="quote-drawer-toggle"
          id="mobile-bottom-quote-btn"
          class="flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors text-[#86868b] hover:text-black cursor-pointer"
        >
          <div class="relative">
            <span class="text-base">🛒</span>
            <span class="nav-quote-badge quote-badge hidden absolute -top-1 -right-2 bg-[#1d1d1f] text-white font-mono text-[9px] font-bold px-1 rounded-full min-w-[14px] text-center">
              0
            </span>
          </div>
          <span class="truncate max-w-[22vw]">{t('buyer.openQuoteBag')}</span>
        </label>

        <!-- Tab 4: Catalog -->
        <a
          href={getLocalizedPath('/products', currentLang)}
          class="flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors text-[#86868b] hover:text-black"
        >
          <span class="text-base">✨</span>
          <span class="truncate max-w-[22vw]">{t('buyer.browseCatalog')}</span>
        </a>
      </nav>
    )
  }

  <!-- Mount Quote Drawer (Required for RFQ and Reordering) -->
  { !isShellReq && <QuoteDrawer /> }

  <!-- Modals & Slide-over Drawers Slots -->
  <div id="shell-overlays">
    <slot name="drawers" />
    <slot name="modals" />
    <slot name="dialogs" />
  </div>

  {
    !isShellReq && (
      <>
        <!-- Pure Vanilla JS for Mobile Sidebar Drawer Toggle & Global openQuoteDrawer helper -->
        <script is:inline data-shell-persist="true">
    (function() {
      // Global bridge for any caller triggering openQuoteDrawer()
      window.openQuoteDrawer = function() {
        var toggle = document.getElementById('quote-drawer-toggle');
        if (toggle) {
          toggle.checked = true;
          toggle.dispatchEvent(new Event('change'));
        }
      };

      var openBtn = document.getElementById('buyer-open-sidebar-btn');
      var closeBtn = document.getElementById('buyer-close-sidebar-btn');
      var backdrop = document.getElementById('buyer-sidebar-backdrop');
      var sidebar = document.getElementById('buyer-sidebar');

      function openSidebar() {
        if (!sidebar || !backdrop) return;
        backdrop.classList.remove('hidden');
        requestAnimationFrame(function() {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
          sidebar.classList.remove('-translate-x-full');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(function() {
          backdrop.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      if (openBtn) openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (backdrop) backdrop.addEventListener('click', closeSidebar);

      // iOS Swipe-Left-to-Close Gesture for Mobile Sidebar Drawer
      if (sidebar && backdrop) {
        var touchStartX = 0;
        var touchStartY = 0;
        var touchCurrentX = 0;
        var touchStartTime = 0;
        var isSwipingSidebar = false;
        var lockAxis = null;

        sidebar.addEventListener('touchstart', function(e) {
          if (window.innerWidth >= 1024 || sidebar.classList.contains('-translate-x-full') || e.touches.length !== 1) return;
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchCurrentX = touchStartX;
          touchStartTime = performance.now();
          isSwipingSidebar = false;
          lockAxis = null;
        }, { passive: true });

        sidebar.addEventListener('touchmove', function(e) {
          if (!touchStartTime || e.touches.length !== 1) return;
          var dx = e.touches[0].clientX - touchStartX;
          var dy = e.touches[0].clientY - touchStartY;

          if (!lockAxis) {
            if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
            lockAxis = Math.abs(dx) > Math.abs(dy) * 1.15 ? 'x' : 'y';
          }
          if (lockAxis === 'y') return;

          if (!isSwipingSidebar) {
            isSwipingSidebar = true;
            sidebar.classList.add('is-swiping');
            backdrop.classList.add('is-swiping-backdrop');
          }

          touchCurrentX = e.touches[0].clientX;
          var offset = dx <= 0 ? dx : 0; // Left sidebar only slides left (negative X)
          var w = sidebar.offsetWidth || 260;
          var progress = Math.min(1, Math.abs(offset) / w);

          sidebar.style.transform = 'translate3d(' + offset + 'px, 0, 0)';
          backdrop.style.opacity = String(1 - progress);
        }, { passive: true });

        function endSidebarSwipe() {
          if (!isSwipingSidebar) {
            touchStartTime = 0;
            return;
          }
          isSwipingSidebar = false;
          sidebar.classList.remove('is-swiping');
          backdrop.classList.remove('is-swiping-backdrop');

          var dx = touchCurrentX - touchStartX;
          var dt = Math.max(1, performance.now() - touchStartTime);
          var velocity = Math.abs(dx) / dt;
          var w = sidebar.offsetWidth || 260;
          touchStartTime = 0;

          sidebar.style.transform = '';
          backdrop.style.opacity = '';

          if (dx < -w * 0.32 || (dx < -36 && velocity > 0.45)) {
            closeSidebar();
          }
        }

        sidebar.addEventListener('touchend', endSidebarSwipe, { passive: true });
        sidebar.addEventListener('touchcancel', endSidebarSwipe, { passive: true });
      }

      var sidebarQuoteBtn = document.getElementById('sidebar-open-quote-btn');
      if (sidebarQuoteBtn) {
        sidebarQuoteBtn.addEventListener('click', function() {
          closeSidebar();
        });
      }

      // Buyer Account Popover Dropdown Toggle
      var triggerDesktop = document.getElementById('buyer-account-trigger-desktop');
      var triggerMobile = document.getElementById('buyer-account-trigger-mobile');
      var popover = document.getElementById('buyer-account-popover');

      function togglePopover(e) {
        if (e) e.stopPropagation();
        if (!popover) return;
        var isHidden = popover.classList.contains('hidden');
        if (isHidden) {
          popover.classList.remove('hidden');
          triggerDesktop?.setAttribute('aria-expanded', 'true');
          triggerMobile?.setAttribute('aria-expanded', 'true');
        } else {
          closePopover();
        }
      }

      function closePopover() {
        if (!popover || popover.classList.contains('hidden')) return;
        popover.classList.add('hidden');
        triggerDesktop?.setAttribute('aria-expanded', 'false');
        triggerMobile?.setAttribute('aria-expanded', 'false');
      }

      if (triggerDesktop) triggerDesktop.addEventListener('click', togglePopover);
      if (triggerMobile) triggerMobile.addEventListener('click', togglePopover);

      document.addEventListener('click', function(e) {
        if (popover && !popover.contains(e.target) && !triggerDesktop?.contains(e.target) && !triggerMobile?.contains(e.target)) {
          closePopover();
        }
      });

      document.querySelectorAll('.buyer-popover-nav-item').forEach(function(item) {
        item.addEventListener('click', closePopover);
      });

      document.addEventListener('shell:page-load', closePopover);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closePopover();
          if (sidebar && !sidebar.classList.contains('-translate-x-full')) {
            closeSidebar();
          }
        }
      });
    })();
        </script>
      </>
    )
  }

  <script>
    import { initAppShellRouter } from '@utils/appShellRouter';
    initAppShellRouter({ scope: 'buyer' });
  </script>
</Layout>

