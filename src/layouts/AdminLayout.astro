---
// src/layouts/AdminLayout.astro
// Fully Decoupled B2B Admin Shell: Zero-Sanity-Overhead, Grouped Vertical Sidebar, Mobile Bottom Bar, Dynamic RBAC
import Layout from './Layout.astro';
import AdminSidebar from '@components/admin/AdminSidebar.astro';

interface Props {
  title: string;
  currentTab: 'dashboard' | 'orders' | 'users' | 'products' | 'pages' | 'cms_config' | 'cache' | 'members' | 'roles' | 'dicts' | 'logins' | 'logs' | 'settings';
  sessionEmail: string;
  pendingOrdersCount?: number;
  fullscreenWorkbench?: boolean;
  adminName?: string;
  roleName?: string;
  roleCode?: string;
  menus?: string[];
  permissions?: string[];
  dataScope?: string;
}

const {
  title,
  currentTab,
  sessionEmail,
  pendingOrdersCount = 0,
  fullscreenWorkbench = false,
  adminName,
  roleName,
  roleCode = 'super_admin',
  menus,
  permissions = ['*'],
  dataScope = 'ALL',
} = Astro.props;

const tabNames: Record<string, string> = {
  dashboard: 'Business Overview',
  orders: 'Orders & Fulfillment',
  users: 'Customers & CRM',
  members: 'Team Members',
  roles: 'Roles & Permissions',
  dicts: 'Data Dictionaries',
  logins: 'Login Audit Logs',
  logs: 'System Diagnostics',
  settings: 'Workspace Settings',
};

const currentTabTitle = tabNames[currentTab] || 'Workspace';
const canShow = (key: string) => !menus || menus.includes(key);
---

<Layout
  title={`${title} | B2B Admin`}
  bare={true}
  noindex={true}
  nofollow={true}
  bodyClass="bg-[#f5f5f7] text-[#1d1d1f] font-sans antialiased selection:bg-zinc-900 selection:text-white min-h-screen"
>
  <div class:list={['flex flex-col lg:flex-row', fullscreenWorkbench ? 'h-[100dvh] overflow-hidden' : 'min-h-screen']}>
    <!-- 1. Left Grouped Vertical Sidebar (Fixed on Mobile/Tablet, Sticky on Desktop >= lg) -->
    <AdminSidebar
      currentTab={currentTab}
      sessionEmail={sessionEmail}
      pendingOrdersCount={pendingOrdersCount}
      adminName={adminName}
      roleName={roleName}
      roleCode={roleCode}
      menus={menus}
      dataScope={dataScope}
    />

    <!-- 2. Right Main Canvas Area -->
    <div class:list={['flex-1 flex flex-col min-w-0 min-h-0', fullscreenWorkbench && 'h-full overflow-hidden']}>
      <!-- Mobile Top Sticky Bar (< lg): 56px (h-14) Compact Header -->
      <header class="lg:hidden h-14 flex items-center justify-between px-3.5 bg-white/95 backdrop-blur-md border-b border-black/10 sticky top-0 z-30 shadow-2xs">
        <div class="flex items-center gap-2">
          <button
            id="admin-open-sidebar-btn"
            type="button"
            class="p-2 -ml-1 rounded-xl text-[#1d1d1f] hover:bg-[#f5f5f7] active:scale-95 transition-all"
            aria-label="Open Navigation Menu"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <span class="text-sm font-bold tracking-tight text-[#1d1d1f]">Admin Portal</span>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            D1
          </span>
        </div>

        <div class="flex items-center gap-2">
          {pendingOrdersCount > 0 && canShow('orders') && (
            <a
              href="/admin/orders?status=PENDING_APPROVAL"
              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 font-mono text-[11px] font-bold"
              title="Pending approvals"
            >
              <span>📦</span>
              <span>{pendingOrdersCount}</span>
            </a>
          )}
          <a
            href="/orders"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded-lg bg-[#f5f5f7] border border-black/5 text-[#52525b] hover:text-black text-xs font-medium"
          >
            Buyer ↗
          </a>
        </div>
      </header>

      <!-- Desktop Top Context Breadcrumb Bar (>= lg) -->
      <header class="hidden lg:flex items-center justify-between px-8 py-3.5 bg-white border-b border-black/5 shrink-0">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-[#86868b]">Workspace</span>
          <span class="text-[#86868b]">/</span>
          <span class="font-semibold text-[#1d1d1f]">{currentTabTitle}</span>
        </div>

        <div class="flex items-center gap-4 text-xs text-[#86868b]">
          <button
            id="cmd-palette-trigger"
            type="button"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#f5f5f7] hover:bg-black/5 border border-black/10 text-xs text-[#52525b] hover:text-[#1d1d1f] transition-all cursor-pointer shadow-2xs"
            title="Press ⌘K or Ctrl+K anywhere to open Command Palette"
          >
            <svg class="w-3.5 h-3.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="font-medium">Quick Jump / Search</span>
            <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-white border border-black/10 shadow-2xs text-[#86868b]">⌘K</kbd>
          </button>

          <span class="flex items-center gap-1.5 font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Cloudflare D1 Edge
          </span>
        </div>
      </header>

      <!-- Main Dynamic Content Canvas: Bottom padded pb-20 on mobile to clear Bottom Tab Bar -->
      <div class:list={[
        fullscreenWorkbench
          ? 'flex-1 flex flex-col min-h-[420px] lg:min-h-0 min-w-0 w-full p-2.5 sm:p-3 lg:p-4 overflow-hidden pb-16 lg:pb-3 max-w-[1920px] mx-auto'
          : 'flex-1 p-[clamp(1rem,0.4rem+2vw,2.25rem)] pb-20 lg:pb-8 max-w-[1700px] w-full mx-auto'
      ]}>
        <slot />
      </div>
    </div>
  </div>

  <!-- Mobile High-Frequency Bottom Tab Bar (< lg) -->
  <nav
    class="fixed bottom-0 inset-x-0 h-14 bg-white/95 backdrop-blur-md border-t border-black/10 z-30 lg:hidden flex items-center justify-around px-2 pb-[max(0px,env(safe-area-inset-bottom))] shadow-lg"
    aria-label="Mobile Quick Bottom Navigation"
  >
    {canShow('orders') && (
      <a
        href="/admin/orders"
        class:list={[
          'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors relative',
          currentTab === 'orders' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
        ]}
      >
        <div class="relative">
          <span class="text-base">📦</span>
          {pendingOrdersCount > 0 && (
            <span class="absolute -top-1 -right-2 bg-amber-500 text-white font-mono text-[9px] font-bold px-1 rounded-full min-w-[14px] text-center">
              {pendingOrdersCount}
            </span>
          )}
        </div>
        <span>Orders</span>
      </a>
    )}

    {canShow('users') && (
      <a
        href="/admin/users"
        class:list={[
          'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors',
          currentTab === 'users' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
        ]}
      >
        <span class="text-base">👥</span>
        <span>CRM</span>
      </a>
    )}

    {canShow('members') && (
      <a
        href="/admin/members"
        class:list={[
          'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors',
          currentTab === 'members' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
        ]}
      >
        <span class="text-base">🧑‍💼</span>
        <span>Team</span>
      </a>
    )}

    {canShow('logins') && (
      <a
        href="/admin/logins"
        class:list={[
          'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors',
          currentTab === 'logins' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
        ]}
      >
        <span class="text-base">🛡️</span>
        <span>Audit</span>
      </a>
    )}

    {canShow('settings') && (
      <a
        href="/admin/settings"
        class:list={[
          'flex flex-col items-center justify-center flex-1 py-1 text-[10px] font-medium transition-colors',
          currentTab === 'settings' ? 'text-[#1d1d1f] font-bold' : 'text-[#86868b] hover:text-black'
        ]}
      >
        <span class="text-base">⚙️</span>
        <span>Settings</span>
      </a>
    )}
  </nav>

  <!-- Modals & Slide-over Drawers Slots -->
  <slot name="drawers" />
  <slot name="modals" />

  <!-- Global Command Palette Modal (⌘K / Ctrl+K) -->
  <dialog
    id="cmd-palette-dialog"
    class="backdrop:bg-black/50 backdrop:backdrop-blur-xs rounded-2xl p-0 shadow-2xl border border-black/10 bg-white w-full max-w-xl m-auto overflow-hidden text-xs"
  >
    <div class="p-3 border-b border-black/5 flex items-center gap-2.5 bg-white">
      <svg class="w-4 h-4 text-[#86868b] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="cmd-palette-input"
        placeholder="Type command, menu, order (GW-), or customer email..."
        class="flex-1 bg-transparent border-0 outline-none text-xs font-medium text-[#1d1d1f] placeholder:text-[#86868b]"
      />
      <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-[#f5f5f7] border border-black/10 text-[#86868b]">ESC</kbd>
    </div>

    <div id="cmd-palette-results" class="max-h-80 overflow-y-auto p-2 space-y-1">
      <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[#86868b]">
        Navigation Consoles
      </div>
      <a href="/admin/dashboard" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">📊</span>
          <span class="font-semibold text-xs">Business Overview</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/dashboard</span>
      </a>
      <a href="/admin/orders" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">📦</span>
          <span class="font-semibold text-xs">Orders & Fulfillment</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/orders</span>
      </a>
      <a href="/admin/users" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">👥</span>
          <span class="font-semibold text-xs">Customers & CRM</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/users</span>
      </a>
      <a href="/admin/products" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🛍️</span>
          <span class="font-semibold text-xs">Products & Catalog</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/products</span>
      </a>
      <a href="/admin/pages" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">📄</span>
          <span class="font-semibold text-xs">Pages & Visual Builder</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/pages</span>
      </a>
      <a href="/admin/cms-config" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🎨</span>
          <span class="font-semibold text-xs">CMS Site Config</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/cms-config</span>
      </a>
      <a href="/admin/cache" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">⚡</span>
          <span class="font-semibold text-xs">Cache Purge Console</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/cache</span>
      </a>
      <a href="/admin/members" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🧑‍💼</span>
          <span class="font-semibold text-xs">Team Members</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/members</span>
      </a>
      <a href="/admin/roles" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🔐</span>
          <span class="font-semibold text-xs">Roles & Permissions</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/roles</span>
      </a>
      <a href="/admin/dicts" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🏷️</span>
          <span class="font-semibold text-xs">Data Dictionaries</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/dicts</span>
      </a>
      <a href="/admin/logins" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🛡️</span>
          <span class="font-semibold text-xs">Login Audit Logs</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/logins</span>
      </a>
      <a href="/admin/logs" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">🩺</span>
          <span class="font-semibold text-xs">System Diagnostics</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/logs</span>
      </a>
      <a href="/admin/settings" class="cmd-item flex items-center justify-between p-2 rounded-xl hover:bg-[#f5f5f7] transition-colors text-[#1d1d1f] group">
        <div class="flex items-center gap-2.5">
          <span class="text-sm">⚙️</span>
          <span class="font-semibold text-xs">Workspace Settings</span>
        </div>
        <span class="text-[10px] text-[#86868b] font-mono">/admin/settings</span>
      </a>
    </div>

    <div class="p-2.5 bg-[#fafafa] border-t border-black/5 flex items-center justify-between text-[11px] text-[#86868b]">
      <span>Tip: Enter order number to jump to order; enter email to search buyers</span>
      <span>Press <kbd class="font-mono bg-white px-1 py-0.5 rounded border border-black/10">↵</kbd> to select</span>
    </div>
  </dialog>

  <!-- Inject Client RBAC Context for Button Trimming -->
  <script is:inline define:vars={{ permissions, roleCode, dataScope }}>
    window.__ADMIN_PERMS__ = permissions || ['*'];
    window.__ADMIN_ROLE__ = roleCode || 'super_admin';
    window.__ADMIN_DATA_SCOPE__ = dataScope || 'ALL';
    window.__hasPermission = function(code) {
      if (!window.__ADMIN_PERMS__) return false;
      if (window.__ADMIN_PERMS__.includes('*')) return true;
      return window.__ADMIN_PERMS__.includes(code);
    };
  </script>

  <!-- Pure Vanilla JS for Mobile Sidebar Drawer Toggle (Zero TS syntax) -->
  <!-- Command Palette & Mobile Drawer Vanilla Scripts -->
  <script is:inline>
    (function() {
      // Command Palette (⌘K)
      var cmdDialog = document.getElementById('cmd-palette-dialog');
      var cmdInput = document.getElementById('cmd-palette-input');
      var cmdTrigger = document.getElementById('cmd-palette-trigger');

      function openCmdPalette() {
        if (!cmdDialog) return;
        cmdDialog.showModal();
        if (cmdInput) {
          cmdInput.value = '';
          cmdInput.focus();
          filterCmdItems('');
        }
      }

      function filterCmdItems(query) {
        var q = query.trim().toLowerCase();
        var items = document.querySelectorAll('.cmd-item');
        items.forEach(function(item) {
          var text = (item.textContent || '').toLowerCase();
          var href = item.getAttribute('href') || '';
          var matched = !q || text.includes(q) || href.includes(q);
          item.style.display = matched ? 'flex' : 'none';
        });
      }

      if (cmdTrigger) cmdTrigger.addEventListener('click', openCmdPalette);

      if (cmdInput) {
        cmdInput.addEventListener('input', function() {
          filterCmdItems(cmdInput.value);
        });

        cmdInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            var val = cmdInput.value.trim();
            if (!val) return;
            // Detect Order query
            if (val.toUpperCase().startsWith('GW-') || val.toUpperCase().startsWith('ORD-') || /^[\d\-]+$/.test(val)) {
              window.location.href = '/admin/orders?q=' + encodeURIComponent(val);
              return;
            }
            // Detect Email query
            if (val.includes('@')) {
              window.location.href = '/admin/users?q=' + encodeURIComponent(val);
              return;
            }
            // First visible item
            var firstVisible = document.querySelector('.cmd-item:not([style*="display: none"])');
            if (firstVisible) {
              window.location.href = firstVisible.getAttribute('href');
            }
          }
        });
      }

      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (cmdDialog && cmdDialog.open) {
            cmdDialog.close();
          } else {
            openCmdPalette();
          }
        }
      });

      // Mobile Drawer Toggle
      var openBtn = document.getElementById('admin-open-sidebar-btn');
      var closeBtn = document.getElementById('admin-close-sidebar-btn');
      var backdrop = document.getElementById('admin-sidebar-backdrop');
      var sidebar = document.getElementById('admin-sidebar');

      function openSidebar() {
        if (!sidebar || !backdrop) return;
        backdrop.classList.remove('hidden');
        requestAnimationFrame(function() {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
          sidebar.classList.remove('-translate-x-full');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(function() {
          backdrop.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      if (openBtn) openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (backdrop) backdrop.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          if (cmdDialog && cmdDialog.open) cmdDialog.close();
          if (sidebar && !sidebar.classList.contains('-translate-x-full')) closeSidebar();
        }
      });
    })();
  </script>
</Layout>
