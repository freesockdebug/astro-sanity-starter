                </div>
              </div>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    const desktopTableHtml = `
      <div class="hidden md:block">
        <table id="orders-main-table" class="w-full text-left text-xs border-collapse table-fixed select-text">
          <thead class="sticky top-0 z-10 bg-[#fbfbfd]/95 backdrop-blur-xs border-b border-black/10 shadow-2xs">
            <tr id="orders-header-row"></tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            ${desktopRowsHtml}
          </tbody>
        </table>
      </div>
    `;

    container.innerHTML = mobileCardsHtml + desktopTableHtml;
    container.classList.remove('hidden');

    const ordersTable = document.getElementById('orders-main-table');
    const ordersHeaderRow = document.getElementById('orders-header-row');
    if (ordersTable && ordersHeaderRow) {
      tableSettings.renderHeader(ordersHeaderRow, ordersTable);
    }
  }

  async function fetchOrders(updateUrl = true) {
    if (activeAbortController) {
      activeAbortController.abort();
    }
    activeAbortController = new AbortController();

    const skeleton = document.getElementById('orders-skeleton');
    const content = document.getElementById('orders-content');
    const paginationContainer = document.getElementById('pagination-container');

    let skeletonTimer: any = null;
    if (skeleton && content) {
      // If content is empty (cold start), show skeleton immediately.
      // If content is already populated (switching tabs), wait 80ms to avoid flicker on instant cache hits.
      if (content.classList.contains('hidden') || !content.innerHTML.trim()) {
        skeleton.classList.remove('hidden');
        content.classList.add('hidden');
      } else {
        skeletonTimer = setTimeout(() => {
          skeleton.classList.remove('hidden');
          content.classList.add('hidden');
        }, 80);
      }
    }
    if (paginationContainer) {
      paginationContainer.classList.add('hidden');
    }

    updateActiveVisuals();

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (currentStatus && currentStatus !== 'ALL') {
        url.searchParams.set('status', currentStatus);
      } else {
        url.searchParams.delete('status');
      }

      if (currentSearch) {
        url.searchParams.set('search', currentSearch);
      } else {
        url.searchParams.delete('search');
      }

      if (currentPage > 1) {
        url.searchParams.set('page', String(currentPage));
      } else {
        url.searchParams.delete('page');
      }

      window.history.pushState({ status: currentStatus, search: currentSearch, page: currentPage }, '', url.toString());
    }

    try {
      const qs = new URLSearchParams();
      if (currentStatus && currentStatus !== 'ALL') qs.set('status', currentStatus);
      if (currentSearch) qs.set('search', currentSearch);
      qs.set('page', String(currentPage));
      qs.set('limit', String(currentLimit));

      const cacheKey = `admin:orders:${currentStatus}:${currentSearch}:${currentPage}:${currentLimit}`;
      await clientCache.fetchWithCache(
        cacheKey,
        `/api/admin/orders?${qs.toString()}`,
        {
          mode: 'swr',
          init: { signal: activeAbortController.signal },
          onData: (data: any) => {
            if (skeletonTimer) clearTimeout(skeletonTimer);
            if (skeleton) skeleton.classList.add('hidden');
            renderStats(data.stats, data.total);
            renderOrders(data.orders || []);
            pagination.render(data.page || 1, data.totalPages || 1, data.total || 0, data.limit || 50);
          },
        }
      );
    } catch (err: any) {
      if (skeletonTimer) clearTimeout(skeletonTimer);
      if (err?.name === 'AbortError') return;
      console.error('[Orders] Fetch failed:', err);
      if (skeleton) skeleton.classList.add('hidden');
      if (content) {
        content.innerHTML = `
          <div class="py-16 text-center text-xs text-rose-600 space-y-2">
            <p>Failed to load orders (${escapeHtml(err.message)}).</p>
            <button type="button" id="retry-fetch-btn" class="px-3 py-1.5 rounded-lg bg-black text-white text-xs font-semibold cursor-pointer">
              Retry
            </button>
          </div>
        `;
        content.classList.remove('hidden');
        document.getElementById('retry-fetch-btn')?.addEventListener('click', () => fetchOrders(false));
      }
    }
  }

  // Event Delegation for Accordion and Action Modals
  const ordersContainer = document.getElementById('orders-container');
  ordersContainer?.addEventListener('click', (e) => {
    const target = e.target;

    // 1. Toggle Accordion
    const toggleBtn = target.closest('.action-toggle-detail-btn');
    if (toggleBtn) {
      const targetId = toggleBtn.getAttribute('data-target');
      if (!targetId) return;
      const targetRow = document.getElementById(targetId);
      const icon = toggleBtn.querySelector('.chevron-icon');
      if (targetRow) {
        const isCurrentlyHidden = targetRow.classList.contains('hidden');
        if (isCurrentlyHidden) {
          targetRow.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(180deg)';
        } else {
          targetRow.classList.add('hidden');
          if (icon) icon.style.transform = 'rotate(0deg)';
        }
      }
      return;
    }

    // 2. Approve Button
    const approveBtn = target.closest('.action-approve-btn');
    if (approveBtn) {
      const orderId = approveBtn.getAttribute('data-id');
      const orderNo = approveBtn.getAttribute('data-no');
      const modal = document.getElementById('approve-modal');
      const orderIdInput = document.getElementById('approve-order-id');
      const orderNoLabel = document.getElementById('approve-modal-order-no');
      const errorEl = document.getElementById('approve-error');

      if (!orderId || !modal) return;
      clearError(errorEl);
      if (orderIdInput) orderIdInput.value = orderId;
      if (orderNoLabel) orderNoLabel.textContent = orderNo || orderId;
      modal.showModal();
      return;
    }

    // 3. Reject Button
    const rejectBtn = target.closest('.action-reject-btn');
    if (rejectBtn) {
      const orderId = rejectBtn.getAttribute('data-id');
      const orderNo = rejectBtn.getAttribute('data-no');
      const modal = document.getElementById('reject-modal');
      const orderIdInput = document.getElementById('reject-order-id');
      const orderNoLabel = document.getElementById('reject-modal-order-no');
      const reasonInput = document.getElementById('reject-reason-input');
      const errorEl = document.getElementById('reject-error');

      if (!orderId || !modal) return;
      clearError(errorEl);
      if (orderIdInput) orderIdInput.value = orderId;
      if (orderNoLabel) orderNoLabel.textContent = orderNo || orderId;
      if (reasonInput) reasonInput.value = '';
      modal.showModal();
      setTimeout(() => reasonInput?.focus(), 100);
      return;
    }

    // 4. Ship Button
    const shipBtn = target.closest('.action-ship-btn');
    if (shipBtn) {
      const orderId = shipBtn.getAttribute('data-id');
      const orderNo = shipBtn.getAttribute('data-no');
      const modal = document.getElementById('ship-modal');
      const orderIdInput = document.getElementById('ship-order-id');
      const orderNoLabel = document.getElementById('ship-modal-order-no');
      const errorEl = document.getElementById('ship-error');

      if (!orderId || !modal) return;
      clearError(errorEl);
      if (orderIdInput) orderIdInput.value = orderId;
      if (orderNoLabel) orderNoLabel.textContent = orderNo || orderId;
      modal.showModal();
      return;
    }
  });

  // Card filter clicks
  document.getElementById('stats-cards-container')?.addEventListener('click', (e) => {
    const card = e.target.closest('[data-status]');
    if (!card) return;
    e.preventDefault();
    const status = card.getAttribute('data-status') || 'ALL';
    if (status === currentStatus && currentPage === 1) return;
    currentStatus = status;
    currentPage = 1;
    fetchOrders();
  });

  // Tab filter clicks
  document.getElementById('status-tabs-container')?.addEventListener('click', (e) => {
    const tab = e.target.closest('[data-tab-status]');
    if (!tab) return;
    e.preventDefault();
    const status = tab.getAttribute('data-tab-status') || 'ALL';
    if (status === currentStatus && currentPage === 1) return;
    currentStatus = status;
    currentPage = 1;
    fetchOrders();
  });

  // Search submission and clear
  const searchForm = document.getElementById('orders-search-form');
  const searchInput = document.getElementById('orders-search-input');
  const clearSearchBtn = document.getElementById('clear-search-btn');

  searchInput?.addEventListener('input', () => {
    if (clearSearchBtn) {
      if (searchInput.value.trim()) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
    }
  });

  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    clearSearchBtn.classList.add('hidden');
    currentSearch = '';
    currentPage = 1;
    fetchOrders();
  });

  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = searchInput?.value.trim() || '';
    if (val === currentSearch && currentPage === 1) return;
    currentSearch = val;
    currentPage = 1;
    fetchOrders();
  });

  // Handle browser back/forward popstate
  window.addEventListener('popstate', () => {
    const url = new URL(window.location.href);
    currentStatus = url.searchParams.get('status') || 'ALL';
    currentSearch = url.searchParams.get('search') || '';
    currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
    if (searchInput) searchInput.value = currentSearch;
    if (clearSearchBtn) {
      if (currentSearch) clearSearchBtn.classList.remove('hidden');
      else clearSearchBtn.classList.add('hidden');
    }
    fetchOrders(false);
  });

  // Modals confirmation logic
  // 1. Approve modal
  const approveModal = document.getElementById('approve-modal');
  const approveErrorEl = document.getElementById('approve-error');
  const confirmApproveBtn = document.getElementById('confirm-approve-btn');
  const cancelApproveBtn = document.getElementById('cancel-approve-btn');
  const closeApproveModal = document.getElementById('close-approve-modal');

  const hideApproveModal = () => {
    clearError(approveErrorEl);
    approveModal?.close();
  };
  cancelApproveBtn?.addEventListener('click', hideApproveModal);
  closeApproveModal?.addEventListener('click', hideApproveModal);

  confirmApproveBtn?.addEventListener('click', async () => {
    const orderId = document.getElementById('approve-order-id')?.value;
    if (!orderId) return;

    clearError(approveErrorEl);
    if (confirmApproveBtn) {
      confirmApproveBtn.disabled = true;
      confirmApproveBtn.textContent = 'Approving...';
    }

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'approve' }),
      });
      if (res.ok) {
        hideApproveModal();
        (window as any).__showToast?.('Order approved successfully', 'success');
        await clientCache.invalidatePrefix('admin:orders');
        await clientCache.invalidatePrefix('buyer:orders');
        fetchOrders(false);
      } else {
        const data = await res.json();
        showError(approveErrorEl, data.error || 'Approval failed');
      }
    } catch (err) {
      showError(approveErrorEl, err.message || 'Network error');
    } finally {
      if (confirmApproveBtn) {
        confirmApproveBtn.disabled = false;
        confirmApproveBtn.textContent = 'Confirm Approval';
      }
    }
  });

  // 2. Reject modal
  const rejectModal = document.getElementById('reject-modal');
  const rejectErrorEl = document.getElementById('reject-error');
  const confirmRejectBtn = document.getElementById('confirm-reject-btn');
  const cancelRejectBtn = document.getElementById('cancel-reject-btn');
  const closeRejectModal = document.getElementById('close-reject-modal');

  const hideRejectModal = () => {
    clearError(rejectErrorEl);
    rejectModal?.close();
  };
  cancelRejectBtn?.addEventListener('click', hideRejectModal);
  closeRejectModal?.addEventListener('click', hideRejectModal);

  confirmRejectBtn?.addEventListener('click', async () => {
    const orderId = document.getElementById('reject-order-id')?.value;
    const reason = document.getElementById('reject-reason-input')?.value?.trim();
    if (!orderId) return;

    clearError(rejectErrorEl);
    if (!reason) {
      showError(rejectErrorEl, 'Please provide a reason for rejecting this order.');
      document.getElementById('reject-reason-input')?.focus();
      return;
    }

    if (confirmRejectBtn) {
      confirmRejectBtn.disabled = true;
      confirmRejectBtn.textContent = 'Rejecting...';
    }

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reject', adminRemark: reason }),
      });
      if (res.ok) {
        hideRejectModal();
        (window as any).__showToast?.('Order rejected', 'info');
        await clientCache.invalidatePrefix('admin:orders');
        await clientCache.invalidatePrefix('buyer:orders');
        fetchOrders(false);
      } else {
        const data = await res.json();
        showError(rejectErrorEl, data.error || 'Rejection failed');
      }
    } catch (err) {
      showError(rejectErrorEl, err.message || 'Network error');
    } finally {
      if (confirmRejectBtn) {
        confirmRejectBtn.disabled = false;
        confirmRejectBtn.textContent = 'Confirm Rejection';
      }
    }
  });

  // 3. Ship modal
  const shipModal = document.getElementById('ship-modal');
  const shipForm = document.getElementById('ship-form');
  const shipErrorEl = document.getElementById('ship-error');
  const closeShipModal = document.getElementById('close-ship-modal');
  const cancelShipBtn = document.getElementById('cancel-ship-btn');

  const hideShipModal = () => {
    clearError(shipErrorEl);
    shipModal?.close();
  };
  closeShipModal?.addEventListener('click', hideShipModal);
  cancelShipBtn?.addEventListener('click', hideShipModal);

  shipForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const orderId = document.getElementById('ship-order-id')?.value;
    if (!orderId) return;

    clearError(shipErrorEl);
    const formData = new FormData(shipForm);
    const carrier = formData.get('carrier')?.toString();
    const trackingNumber = formData.get('tracking_number')?.toString();
    const adminRemark = formData.get('admin_remark')?.toString();

    const submitBtn = document.getElementById('confirm-ship-btn');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'ship',
          carrier,
          trackingNumber,
          adminRemark,
        }),
      });

      if (res.ok) {
        hideShipModal();
        (window as any).__showToast?.('Shipment dispatched & tracking updated', 'success');
        await clientCache.invalidatePrefix('admin:orders');
        await clientCache.invalidatePrefix('buyer:orders');
        fetchOrders(false);
      } else {
        const data = await res.json();
        showError(shipErrorEl, data.error || 'Failed to dispatch shipment');
      }
    } catch (err) {
      showError(shipErrorEl, err.message || 'Network error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // Initial load
  tableSettings.renderMenu();
  const initialUrl = new URL(window.location.href);
  currentStatus = initialUrl.searchParams.get('status') || 'ALL';
  currentSearch = initialUrl.searchParams.get('search') || '';
  currentPage = Math.max(1, parseInt(initialUrl.searchParams.get('page') || '1', 10));

  fetchOrders(false);
</script>
