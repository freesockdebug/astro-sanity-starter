---
// src/components/MarkdownRenderer.astro
import { marked } from 'marked';
import { SanityImageService } from '../utils/image';

export interface Props {
  content?: string;
  className?: string;
}

const { content = '', className = '' } = Astro.props;

let htmlContent = '';
if (content && typeof content === 'string' && content.trim().length > 0) {
  try {
    const renderer = new marked.Renderer();
    renderer.image = ({ href, title, text }) => {
      let finalHref = href || '';
      if (finalHref.includes('cdn.sanity.io') || finalHref.includes('/cdn-image/')) {
        finalHref = SanityImageService.optimize(finalHref, { format: 'auto', quality: 85 });
      }
      const titleAttr = title ? ` title="${title}"` : '';
      const altAttr = text ? ` alt="${text}"` : '';
      return `<img src="${finalHref}"${altAttr}${titleAttr} loading="lazy" decoding="async" class="product-story-image" />`;
    };

    const rawParsed = marked.parse(content, { gfm: true, breaks: true, renderer }) as string;

    // Lightweight defense against malicious script tags, iframes, inline event handlers, and javascript pseudo-protocols
    let sanitized = rawParsed
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
      .replace(/\s+on\w+\s*=\s*(?:'[^']*'|"[^"]*"|[^\s>]+)/gi, '')
      .replace(/(href|src)\s*=\s*["']?\s*javascript:[^"'>]*/gi, '$1="#"');

    // Ensure all direct cdn.sanity.io URLs route through Cloudflare Edge Proxy (/cdn-image)
    if (SanityImageService.isProxyEnabled()) {
      sanitized = sanitized.replace(/https:\/\/cdn\.sanity\.io/g, '/cdn-image');
    }

    htmlContent = sanitized;
  } catch (err) {
    console.error('Error parsing markdown in MarkdownRenderer:', err);
    htmlContent = content;
  }
}
---

{htmlContent && (
  <div class:list={["markdown-renderer max-w-none text-[#424245] leading-relaxed", className]}>
    <div class="product-story-prose" set:html={htmlContent} />
  </div>
)}

<style>
  :global(.product-story-prose) {
    color: #374151;
    font-size: 0.9375rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  :global(.product-story-prose h1),
  :global(.product-story-prose h2),
  :global(.product-story-prose h3),
  :global(.product-story-prose h4) {
    color: #111827;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  :global(.product-story-prose h1) {
    font-size: clamp(1.35rem, 1.2rem + 0.8vw, 1.75rem);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  :global(.product-story-prose h2) {
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem);
    margin-top: 1.25rem;
    margin-bottom: 0.45rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  :global(.product-story-prose h3) {
    font-size: clamp(1.025rem, 0.975rem + 0.3vw, 1.2rem);
    margin-top: 1rem;
    margin-bottom: 0.35rem;
  }
  :global(.product-story-prose h4) {
    font-size: 0.95rem;
    margin-top: 0.875rem;
    margin-bottom: 0.25rem;
  }
  :global(.product-story-prose p) {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  :global(.product-story-prose blockquote) {
    margin: 0.875rem 0;
    padding: 0.625rem 1rem;
    background-color: #fbf9f5;
    border-left: 3px solid #111827;
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
    color: #1f2937;
    font-size: 0.9rem;
    line-height: 1.55;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
  }
  :global(.product-story-prose ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9375rem;
  }
  :global(.product-story-prose ol) {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9375rem;
  }
  :global(.product-story-prose li) {
    line-height: 1.55;
    padding-left: 0.15rem;
  }
  :global(.product-story-prose li strong) {
    color: #111827;
  }
  /* Table formatting: Strict 100% full-width alignment, tight row heights, clean borders */
  :global(.product-story-prose table) {
    width: 100% !important;
    max-width: 100%;
    margin: 0.875rem 0 1.125rem 0;
    border-collapse: collapse;
    font-size: 0.8125rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.625rem;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
    table-layout: auto;
  }
  :global(.product-story-prose thead) {
    background-color: #f8fafc;
  }
  :global(.product-story-prose th) {
    background-color: #f8fafc;
    color: #1e293b;
    font-weight: 600;
    padding: 0.55rem 0.875rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-align: left;
    white-space: nowrap;
  }
  :global(.product-story-prose td) {
    padding: 0.55rem 0.875rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    font-family: var(--font-mono, monospace);
    color: #374151;
    text-align: left;
    vertical-align: middle;
  }
  :global(.product-story-prose tr:last-child td) {
    border-bottom: none;
  }
  :global(.product-story-prose tr:nth-child(even) td) {
    background-color: #fbfbfd;
  }
  :global(.product-story-prose tr:hover td) {
    background-color: #f1f5f9;
  }
  :global(.product-story-prose img) {
    border-radius: 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
    margin: 0.875rem 0;
    max-width: 100%;
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  :global(.product-story-prose hr) {
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
    margin: 1.25rem 0;
  }
  :global(.product-story-prose a) {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.product-story-prose code) {
    font-family: var(--font-mono, monospace);
    background-color: #f1f5f9;
    padding: 0.125rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    color: #0f172a;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
</style>
