---
// src/pages/admin/orders.astro
import Layout from '@layouts/Layout.astro';
import { getSessionFromRequest } from '@utils/auth';
import { listAdminOrders } from '@utils/db';
import { getLangFromUrl, getLocalizedPath } from '@i18n';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, max-age=0');

const currentLang = getLangFromUrl(Astro.url);
const sessionUser = await getSessionFromRequest(Astro.request, cfEnv);

if (!sessionUser || !sessionUser.isAdmin) {
  // If not authenticated or not admin, return forbidden / redirect
  return Astro.redirect(`/api/auth/login?returnUrl=/admin/orders`);
}

const currentStatus = Astro.url.searchParams.get('status') || 'ALL';
const currentSearch = Astro.url.searchParams.get('search') || '';

const { orders, total, stats } = await listAdminOrders({
  status: currentStatus,
  search: currentSearch,
  limit: 50,
});

const pageTitle = 'B2B Admin Fulfillment Workspace | GwenVenni Atelier';

const resolveItemImage = (item: any) => {
  if (item?.image_url && item.image_url.trim()) {
    return item.image_url.replace('https://cdn.sanity.io', '/cdn-image');
  }
  const str = `${item?.title || ''} ${item?.sku || ''}`.toLowerCase();
  if (str.includes('spec') || str.includes('pdf') || str.includes('dossier')) {
    return '/images/spec-light.webp';
  }
  if (str.includes('ruffle') || str.includes('gv-ru')) {
    return '/images/products/gv-ruffle-detail.webp';
  }
  return '/images/hero-light.webp';
};
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-[#f5f5f7] pt-24 pb-20 text-[#1d1d1f]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Breadcrumbs & Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-black/5 gap-4">
        <div>
          <nav class="flex items-center gap-2 text-xs text-[#86868b] mb-1">
            <a href={getLocalizedPath('/', currentLang)} class="hover:text-black transition-colors">Home</a>
            <span>/</span>
            <a href="/orders" class="hover:text-black transition-colors">Orders</a>
            <span>/</span>
            <span class="text-[#1d1d1f] font-medium">Admin Workspace</span>
          </nav>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
            Order Fulfillment & Approval
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <span class="text-xs text-[#86868b] hidden sm:inline">
            Admin: <strong class="text-[#1d1d1f] font-mono">{sessionUser.email}</strong>
          </span>
          <a
            href="/orders"
            class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-black/10 hover:border-black/30 text-[#1d1d1f] transition-all shadow-2xs"
          >
            Buyer View
          </a>
          <a
            href="/api/auth/logout"
            class="px-3 py-1.5 rounded-full text-xs font-medium text-[#86868b] hover:text-black hover:bg-black/5 transition-all"
          >
            Sign Out
          </a>
        </div>
      </div>

      <!-- Stats Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mt-6">
        <a
          href="/admin/orders"
          class={`p-3.5 rounded-xl border text-xs transition-all ${
            currentStatus === 'ALL'
              ? 'bg-[#1d1d1f] text-white border-black shadow-xs'
              : 'bg-white text-[#1d1d1f] border-black/5 hover:border-black/20'
          }`}
        >
          <span class="text-[11px] block opacity-75">All Orders</span>
          <span class="text-lg font-bold font-mono tabular-nums">{stats.all}</span>
        </a>

        <a
          href="/admin/orders?status=PENDING_APPROVAL"
          class={`p-3.5 rounded-xl border text-xs transition-all ${
            currentStatus === 'PENDING_APPROVAL'
              ? 'bg-amber-600 text-white border-amber-700 shadow-xs'
              : 'bg-white text-amber-900 border-black/5 hover:border-amber-300'
          }`}
        >
          <span class="text-[11px] block opacity-75">Pending Approval</span>
          <span class="text-lg font-bold font-mono tabular-nums text-amber-600 ${currentStatus === 'PENDING_APPROVAL' ? '!text-white' : ''}">
            {stats.pending}
          </span>
        </a>

        <a
          href="/admin/orders?status=APPROVED"
          class={`p-3.5 rounded-xl border text-xs transition-all ${
            currentStatus === 'APPROVED'
              ? 'bg-blue-600 text-white border-blue-700 shadow-xs'
              : 'bg-white text-blue-900 border-black/5 hover:border-blue-300'
          }`}
        >
          <span class="text-[11px] block opacity-75">Approved (To Ship)</span>
          <span class="text-lg font-bold font-mono tabular-nums text-blue-600 ${currentStatus === 'APPROVED' ? '!text-white' : ''}">
            {stats.approved}
          </span>
        </a>

        <a
          href="/admin/orders?status=SHIPPED"
          class={`p-3.5 rounded-xl border text-xs transition-all ${
            currentStatus === 'SHIPPED'
              ? 'bg-emerald-600 text-white border-emerald-700 shadow-xs'
              : 'bg-white text-emerald-900 border-black/5 hover:border-emerald-300'
          }`}
        >
          <span class="text-[11px] block opacity-75">Shipped</span>
          <span class="text-lg font-bold font-mono tabular-nums text-emerald-600 ${currentStatus === 'SHIPPED' ? '!text-white' : ''}">
            {stats.shipped}
          </span>
        </a>

        <a
          href="/admin/orders?status=REJECTED"
          class={`p-3.5 rounded-xl border text-xs transition-all ${
            currentStatus === 'REJECTED'
              ? 'bg-zinc-700 text-white border-zinc-800 shadow-xs'
              : 'bg-white text-zinc-700 border-black/5 hover:border-zinc-300'
          }`}
        >
          <span class="text-[11px] block opacity-75">Rejected</span>
          <span class="text-lg font-bold font-mono tabular-nums">{stats.rejected}</span>
        </a>
      </div>

      <!-- Search & Filter Bar -->
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <form method="GET" action="/admin/orders" class="flex-1 flex gap-2">
          {currentStatus !== 'ALL' && <input type="hidden" name="status" value={currentStatus} />}
          <div class="relative flex-1">
            <input
              type="text"
              name="search"
              value={currentSearch}
              placeholder="Search by Order No, buyer email or company name..."
              class="w-full px-3.5 py-2 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f]"
            />
            {currentSearch && (
              <a
                href={currentStatus !== 'ALL' ? `/admin/orders?status=${currentStatus}` : '/admin/orders'}
                class="absolute right-3 top-2 text-xs text-[#86868b] hover:text-black"
              >
                ✕
              </a>
            )}
          </div>
          <button
            type="submit"
            class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all cursor-pointer"
          >
            Filter
          </button>
        </form>
      </div>

      <!-- Orders Table Container -->
      <div class="mt-6 bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
        
        {orders.length === 0 ? (
          <div class="py-16 text-center text-xs text-[#86868b]">
            No orders matching the current filter.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="bg-[#fbfbfd] border-b border-black/5 text-[#86868b] font-medium">
                  <th class="py-3 px-4">Order No / Date</th>
                  <th class="py-3 px-4">Buyer / Company</th>
                  <th class="py-3 px-4">Destination</th>
                  <th class="py-3 px-4 text-right">Styles / Qty</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Fulfillment Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-black/5">
                {orders.map((order) => {
                  const isPending = order.status === 'PENDING_APPROVAL';
                  const isApproved = order.status === 'APPROVED';
                  const isShipped = order.status === 'SHIPPED';
                  const isRejected = order.status === 'REJECTED';

                  return (
                    <tr class="hover:bg-[#fbfbfd] transition-colors">
                      <!-- Order No & Date -->
                      <td class="py-3.5 px-4 font-mono">
                        <span class="font-semibold text-[#1d1d1f] block">{order.order_no}</span>
                        <span class="text-[11px] text-[#86868b]">{order.created_at.slice(0, 16)}</span>
                      </td>

                      <!-- Buyer & Company -->
                      <td class="py-3.5 px-4">
                        <span class="font-medium text-[#1d1d1f] block truncate max-w-[180px]">
                          {order.company_name || order.contact_name || 'Independent Buyer'}
                        </span>
                        <span class="text-[11px] text-[#86868b] font-mono block truncate max-w-[180px]">
                          {order.buyer_email}
                        </span>
                      </td>

                      <!-- Destination -->
                      <td class="py-3.5 px-4 text-[#52525b]">
                        {order.destination_country || 'Unspecified'}
                      </td>

                      <!-- Items & Quantity -->
                      <td class="py-3.5 px-4 text-right font-mono tabular-nums">
                        <span class="font-semibold text-[#1d1d1f]">{order.total_quantity} pcs</span>
                        <span class="text-[11px] text-[#86868b] block">{order.total_styles} style(s)</span>
                      </td>

                      <!-- Status Badge -->
                      <td class="py-3.5 px-4">
                        {isPending && (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                            Pending Approval
                          </span>
                        )}
                        {isApproved && (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                            Approved
                          </span>
                        )}
                        {isShipped && (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            Shipped
                          </span>
                        )}
                        {isRejected && (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
                            Rejected
                          </span>
                        )}
                      </td>

                      <!-- Actions Column -->
                      <td class="py-3.5 px-4 text-right">
                        <div class="flex items-center justify-end gap-1.5 flex-wrap">
                          <!-- View Details Toggle Button -->
                          <button
                            type="button"
                            class="action-toggle-detail-btn h-8 px-2.5 rounded-lg text-xs font-medium text-[#1d1d1f] bg-white hover:bg-[#f5f5f7] border border-black/10 hover:border-black/30 shadow-2xs inline-flex items-center gap-1 transition-all cursor-pointer active:scale-95"
                            data-target={`detail-${order.id}`}
                            title="Toggle line items and customer details"
                          >
                            <span>Details</span>
                            <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                          </button>

                          {isPending && (
                            <>
                              <button
                                type="button"
                                class="action-approve-btn h-8 px-3 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-2xs shadow-emerald-700/20 inline-flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer"
                                data-id={order.id}
                                data-no={order.order_no}
                              >
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Approve</span>
                              </button>
                              <button
                                type="button"
                                class="action-reject-btn h-8 px-3 rounded-lg text-xs font-medium bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 hover:border-rose-300 shadow-2xs inline-flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer"
                                data-id={order.id}
                                data-no={order.order_no}
                              >
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                <span>Reject</span>
                              </button>
                            </>
                          )}

                          {isApproved && (
                            <button
                              type="button"
                              class="action-ship-btn h-8 px-3.5 rounded-lg text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white shadow-2xs inline-flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer"
                              data-id={order.id}
                              data-no={order.order_no}
                            >
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                              </svg>
                              <span>Fulfill & Ship</span>
                            </button>
                          )}

                          {isShipped && (
                            <div class="h-8 inline-flex items-center gap-1.5 px-2.5 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-mono font-medium">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                              <span>{order.carrier || 'Express'}</span>
                              {order.tracking_number && (
                                <span class="font-bold truncate max-w-[120px]" title={order.tracking_number}>
                                  {order.tracking_number}
                                </span>
                              )}
                            </div>
                          )}

                          {isRejected && (
                            <span class="h-8 inline-flex items-center px-2.5 rounded-lg bg-zinc-100 text-zinc-500 text-[11px] font-medium border border-zinc-200">
                              Rejected
                            </span>
                          )}
                        </div>
                      </td>
                    </tr>

                    <!-- Expandable Order Details Drawer Row -->
                    <tr id={`detail-${order.id}`} class="order-detail-row hidden bg-[#fafafa] border-b border-black/5">
                      <td colspan="6" class="p-4 sm:p-6">
                        <div class="space-y-4">
                          
                          <!-- Top Meta Bar -->
                          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-black/5 gap-2">
                            <div class="flex items-center gap-2">
                              <span class="text-xs font-semibold text-[#1d1d1f]">Order Breakdown:</span>
                              <span class="font-mono text-xs font-bold text-[#1d1d1f] bg-white px-2 py-0.5 rounded border border-black/5">
                                {order.order_no}
                              </span>
                              <span class="text-[11px] text-[#86868b]">
                                Type: <strong class="capitalize text-[#1d1d1f]">{order.inquiry_type || 'Quote Cart'}</strong>
                              </span>
                            </div>
                            <div class="text-[11px] text-[#86868b] flex items-center gap-3">
                              <span>Submitted: <strong class="text-[#1d1d1f] font-mono">{order.created_at}</strong></span>
                              {order.claimed_at && (
                                <span>· Claimed: <strong class="text-emerald-700 font-mono">{order.claimed_at.slice(0, 16)}</strong></span>
                              )}
                            </div>
                          </div>

                          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                            
                            <!-- Left: Line Items List (2 cols on large) -->
                            <div class="lg:col-span-2 bg-white rounded-xl border border-black/5 p-4 space-y-3">
                              <div class="flex items-center justify-between border-b border-black/5 pb-2">
                                <h4 class="font-semibold text-xs text-[#1d1d1f]">Ordered Styles & Quantities ({order.items?.length || 0})</h4>
                                <span class="font-mono text-xs font-bold text-[#1d1d1f]">{order.total_quantity} pcs total</span>
                              </div>

                              <div class="divide-y divide-black/5 max-h-72 overflow-y-auto pr-1">
                                {(order.items && order.items.length > 0) ? (
                                  order.items.map((item) => (
                                    <div class="py-2.5 flex items-center justify-between gap-3 text-xs">
                                      <div class="flex items-center gap-3 min-w-0">
                                        <img
                                          src={resolveItemImage(item)}
                                          alt={item.title}
                                          class="w-11 h-11 rounded-lg object-cover bg-[#f5f5f7] border border-black/5 shrink-0"
                                          loading="lazy"
                                        />
                                        <div class="min-w-0">
                                          <p class="font-medium text-[#1d1d1f] truncate text-xs">{item.title}</p>
                                          <div class="flex items-center gap-2 text-[11px] text-[#86868b] mt-0.5 font-mono">
                                            {item.sku && (
                                              <span class="bg-[#f5f5f7] px-1.5 py-0.5 rounded text-[10px] text-[#52525b] border border-black/5">
                                                {item.sku}
                                              </span>
                                            )}
                                            <span class="truncate">{item.variant || 'Standard Spec'}</span>
                                          </div>
                                        </div>
                                      </div>
                                      <div class="font-mono font-semibold text-xs tabular-nums text-right shrink-0">
                                        {item.quantity} pcs
                                      </div>
                                    </div>
                                  ))
                                ) : (
                                  <div class="py-4 text-center text-xs text-[#86868b]">
                                    No item details recorded.
                                  </div>
                                )}
                              </div>
                            </div>

                            <!-- Right: Buyer Contact & Delivery Destination -->
                            <div class="space-y-3">
                              <div class="bg-white rounded-xl border border-black/5 p-4 space-y-2.5 text-xs">
                                <h4 class="font-semibold text-xs text-[#1d1d1f] border-b border-black/5 pb-1.5">
                                  Buyer & Delivery Details
                                </h4>
                                
                                <div>
                                  <span class="text-[11px] text-[#86868b] block">Contact / Company:</span>
                                  <p class="font-medium text-[#1d1d1f]">
                                    {order.contact_name || 'Anonymous'}{order.company_name ? ` · ${order.company_name}` : ''}
                                  </p>
                                </div>

                                <div>
                                  <span class="text-[11px] text-[#86868b] block">Email:</span>
                                  <a href={`mailto:${order.buyer_email}`} class="font-mono text-[#1d1d1f] hover:underline font-medium break-all">
                                    {order.buyer_email}
                                  </a>
                                </div>

                                {order.whatsapp && (
                                  <div>
                                    <span class="text-[11px] text-[#86868b] block">WhatsApp:</span>
                                    <a
                                      href={`https://wa.me/${order.whatsapp.replace(/[^0-9]/g, '')}`}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="inline-flex items-center gap-1.5 font-mono font-medium text-emerald-700 hover:text-emerald-800 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200 text-[11px] mt-0.5"
                                    >
                                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z" />
                                      </svg>
                                      <span>{order.whatsapp}</span>
                                    </a>
                                  </div>
                                )}

                                <div>
                                  <span class="text-[11px] text-[#86868b] block">Destination Country:</span>
                                  <p class="font-medium text-[#1d1d1f]">
                                    {order.destination_country || 'Worldwide / Not Specified'}
                                  </p>
                                </div>
                              </div>

                              <!-- Customer Procurement Message -->
                              {order.customer_notes && (
                                <div class="bg-amber-50/60 rounded-xl border border-amber-200/70 p-3.5 text-xs text-amber-950 space-y-1">
                                  <span class="text-[11px] font-semibold text-amber-900 block">Customer Procurement Notes:</span>
                                  <p class="italic leading-relaxed whitespace-pre-wrap">{order.customer_notes}</p>
                                </div>
                              )}

                              <!-- Logistics details if shipped -->
                              {isShipped && (
                                <div class="bg-emerald-50/70 rounded-xl border border-emerald-200 p-3.5 text-xs text-emerald-950 space-y-1">
                                  <span class="text-[11px] font-semibold text-emerald-900 block">Fulfillment Dispatched:</span>
                                  <p><strong>Carrier:</strong> {order.carrier || 'Standard'}</p>
                                  {order.tracking_number && (
                                    <p class="font-mono"><strong>Waybill No:</strong> {order.tracking_number}</p>
                                  )}
                                  {order.admin_remark && (
                                    <p class="text-[11px] text-emerald-800">Note: {order.admin_remark}</p>
                                  )}
                                </div>
                              )}

                              {isRejected && order.admin_remark && (
                                <div class="bg-rose-50 rounded-xl border border-rose-200 p-3.5 text-xs text-rose-900 space-y-1">
                                  <span class="text-[11px] font-semibold text-rose-800 block">Rejection Remark:</span>
                                  <p>{order.admin_remark}</p>
                                </div>
                              )}
                            </div>

                          </div>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

    </div>
  </main>

  <!-- Unified Apple-Grade Modals: Approve, Reject, Ship -->

  <!-- 1. Approve Confirmation Modal -->
  <dialog id="approve-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl max-w-sm w-full mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
    <div class="space-y-4 text-xs text-[#1d1d1f]">
      <div class="flex items-center justify-between pb-1">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100/80">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <button id="close-approve-modal" type="button" class="text-base text-[#86868b] hover:text-black">✕</button>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[#1d1d1f]">Approve Order Request</h3>
        <p class="text-[11px] text-[#86868b] mt-1 leading-relaxed">
          Are you sure you want to approve order <strong id="approve-modal-order-no" class="font-mono text-[#1d1d1f]"></strong>?
          It will be marked as <strong class="text-emerald-700">APPROVED</strong> and moved to the fulfillment dispatch queue.
        </p>
      </div>

      <input type="hidden" id="approve-order-id" />

      <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
        <button
          type="button"
          id="cancel-approve-btn"
          class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-approve-btn"
          class="h-9 px-5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-2xs shadow-emerald-700/20 active:scale-95 transition-all cursor-pointer"
        >
          Confirm Approval
        </button>
      </div>
    </div>
  </dialog>

  <!-- 2. Reject Order Modal -->
  <dialog id="reject-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl max-w-sm w-full mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
    <div class="space-y-4 text-xs text-[#1d1d1f]">
      <div class="flex items-center justify-between pb-1">
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center border border-rose-100/80">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <button id="close-reject-modal" type="button" class="text-base text-[#86868b] hover:text-black">✕</button>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[#1d1d1f]">Reject Order Request</h3>
        <p class="text-[11px] text-[#86868b] mt-1 leading-relaxed">
          Order <strong id="reject-modal-order-no" class="font-mono text-[#1d1d1f]"></strong>. Please provide a clear rejection reason (visible to the buyer):
        </p>
      </div>

      <input type="hidden" id="reject-order-id" />
      <div>
        <textarea
          id="reject-reason-input"
          rows="3"
          required
          placeholder="e.g. Fabric lot out of stock, order quantity below minimum threshold..."
          class="w-full px-3 py-2.5 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-xs resize-none placeholder:text-[#86868b]"
        ></textarea>
      </div>

      <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
        <button
          type="button"
          id="cancel-reject-btn"
          class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-reject-btn"
          class="h-9 px-5 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white shadow-2xs shadow-rose-700/20 active:scale-95 transition-all cursor-pointer"
        >
          Confirm Rejection
        </button>
      </div>
    </div>
  </dialog>

  <!-- 3. Ship & Logistics Dispatch Modal -->
  <dialog id="ship-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl max-w-md w-full mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
    <div class="space-y-4 text-xs text-[#1d1d1f]">
      <div class="flex items-center justify-between pb-1 border-b border-black/5">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-[#1d1d1f] text-white flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold">Fulfill & Dispatch Shipment</h3>
            <p class="text-[11px] text-[#86868b]">Order: <strong id="ship-modal-order-no" class="font-mono text-[#1d1d1f]"></strong></p>
          </div>
        </div>
        <button id="close-ship-modal" type="button" class="text-base text-[#86868b] hover:text-black">✕</button>
      </div>

      <form id="ship-form" class="space-y-3">
        <input type="hidden" id="ship-order-id" name="order_id" />
        
        <div>
          <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Logistics Carrier / Freight Provider</label>
          <select
            id="ship-carrier-select"
            name="carrier"
            required
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-xs"
          >
            <option value="DHL Express">DHL Express</option>
            <option value="FedEx International">FedEx International</option>
            <option value="UPS Worldwide">UPS Worldwide</option>
            <option value="SF Express (International)">SF Express (顺丰国际)</option>
            <option value="Sea Freight (DDP)">Sea Freight (海运专线 DDP)</option>
            <option value="Air Freight">Air Freight (空运专线)</option>
            <option value="Other">Other / Custom Carrier</option>
          </select>
        </div>

        <div>
          <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Waybill / Tracking Number</label>
          <input
            type="text"
            id="ship-tracking-number"
            name="tracking_number"
            required
            placeholder="e.g. 78349281923"
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black font-mono text-xs"
          />
        </div>

        <div>
          <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Dispatch Notes / Admin Remarks (Optional)</label>
          <textarea
            id="ship-remark"
            name="admin_remark"
            rows="2"
            placeholder="e.g. Packed in 2 export cartons, estimated arrival Nov 12."
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black resize-none text-xs"
          ></textarea>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
          <button
            type="button"
            id="cancel-ship-btn"
            class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="confirm-ship-btn"
            class="h-9 px-5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all cursor-pointer"
          >
            Confirm Shipment
          </button>
        </div>
      </form>
    </div>
  </dialog>
</Layout>

<script>
  // Handle Toggle Order Details Accordion
  document.querySelectorAll<HTMLButtonElement>('.action-toggle-detail-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const targetRow = document.getElementById(targetId);
      const icon = btn.querySelector('.chevron-icon') as HTMLElement | null;
      if (targetRow) {
        const isCurrentlyHidden = targetRow.classList.contains('hidden');
        if (isCurrentlyHidden) {
          targetRow.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(180deg)';
        } else {
          targetRow.classList.add('hidden');
          if (icon) icon.style.transform = 'rotate(0deg)';
        }
      }
    });
  });

  // 1. Handle Approve Modal
  const approveModal = document.getElementById('approve-modal') as HTMLDialogElement | null;
  const approveOrderIdInput = document.getElementById('approve-order-id') as HTMLInputElement | null;
  const approveOrderNoLabel = document.getElementById('approve-modal-order-no');
  const confirmApproveBtn = document.getElementById('confirm-approve-btn') as HTMLButtonElement | null;
  const cancelApproveBtn = document.getElementById('cancel-approve-btn');
  const closeApproveModal = document.getElementById('close-approve-modal');

  document.querySelectorAll<HTMLButtonElement>('.action-approve-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const orderId = btn.getAttribute('data-id');
      const orderNo = btn.getAttribute('data-no');
      if (!orderId || !approveModal) return;

      if (approveOrderIdInput) approveOrderIdInput.value = orderId;
      if (approveOrderNoLabel) approveOrderNoLabel.textContent = orderNo || orderId;
      approveModal.showModal();
    });
  });

  const hideApproveModal = () => approveModal?.close();
  cancelApproveBtn?.addEventListener('click', hideApproveModal);
  closeApproveModal?.addEventListener('click', hideApproveModal);

  confirmApproveBtn?.addEventListener('click', async () => {
    const orderId = approveOrderIdInput?.value;
    if (!orderId) return;

    if (confirmApproveBtn) {
      confirmApproveBtn.disabled = true;
      confirmApproveBtn.textContent = 'Approving...';
    }

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'approve' }),
      });
      if (res.ok) {
        hideApproveModal();
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Approval failed');
      }
    } catch (err: any) {
      alert(err.message || 'Network error');
    } finally {
      if (confirmApproveBtn) {
        confirmApproveBtn.disabled = false;
        confirmApproveBtn.textContent = 'Confirm Approval';
      }
    }
  });

  // 2. Handle Reject Modal
  const rejectModal = document.getElementById('reject-modal') as HTMLDialogElement | null;
  const rejectOrderIdInput = document.getElementById('reject-order-id') as HTMLInputElement | null;
  const rejectOrderNoLabel = document.getElementById('reject-modal-order-no');
  const rejectReasonInput = document.getElementById('reject-reason-input') as HTMLTextAreaElement | null;
  const confirmRejectBtn = document.getElementById('confirm-reject-btn') as HTMLButtonElement | null;
  const cancelRejectBtn = document.getElementById('cancel-reject-btn');
  const closeRejectModal = document.getElementById('close-reject-modal');

  document.querySelectorAll<HTMLButtonElement>('.action-reject-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const orderId = btn.getAttribute('data-id');
      const orderNo = btn.getAttribute('data-no');
      if (!orderId || !rejectModal) return;

      if (rejectOrderIdInput) rejectOrderIdInput.value = orderId;
      if (rejectOrderNoLabel) rejectOrderNoLabel.textContent = orderNo || orderId;
      if (rejectReasonInput) rejectReasonInput.value = '';
      rejectModal.showModal();
      setTimeout(() => rejectReasonInput?.focus(), 100);
    });
  });

  const hideRejectModal = () => rejectModal?.close();
  cancelRejectBtn?.addEventListener('click', hideRejectModal);
  closeRejectModal?.addEventListener('click', hideRejectModal);

  confirmRejectBtn?.addEventListener('click', async () => {
    const orderId = rejectOrderIdInput?.value;
    const reason = rejectReasonInput?.value?.trim();
    if (!orderId) return;

    if (!reason) {
      alert('Please provide a reason for rejecting this order.');
      rejectReasonInput?.focus();
      return;
    }

    if (confirmRejectBtn) {
      confirmRejectBtn.disabled = true;
      confirmRejectBtn.textContent = 'Rejecting...';
    }

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reject', adminRemark: reason }),
      });
      if (res.ok) {
        hideRejectModal();
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Rejection failed');
      }
    } catch (err: any) {
      alert(err.message || 'Network error');
    } finally {
      if (confirmRejectBtn) {
        confirmRejectBtn.disabled = false;
        confirmRejectBtn.textContent = 'Confirm Rejection';
      }
    }
  });

  // 3. Handle Ship Modal
  const shipModal = document.getElementById('ship-modal') as HTMLDialogElement | null;
  const closeShipModal = document.getElementById('close-ship-modal');
  const cancelShipBtn = document.getElementById('cancel-ship-btn');
  const shipForm = document.getElementById('ship-form') as HTMLFormElement | null;
  const shipOrderIdInput = document.getElementById('ship-order-id') as HTMLInputElement | null;
  const shipOrderNoLabel = document.getElementById('ship-modal-order-no');

  document.querySelectorAll<HTMLButtonElement>('.action-ship-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const orderId = btn.getAttribute('data-id');
      const orderNo = btn.getAttribute('data-no');
      if (!orderId || !shipModal) return;

      if (shipOrderIdInput) shipOrderIdInput.value = orderId;
      if (shipOrderNoLabel) shipOrderNoLabel.textContent = orderNo || orderId;

      shipModal.showModal();
    });
  });

  const hideModal = () => {
    if (shipModal) shipModal.close();
  };

  closeShipModal?.addEventListener('click', hideModal);
  cancelShipBtn?.addEventListener('click', hideModal);

  shipForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const orderId = shipOrderIdInput?.value;
    if (!orderId) return;

    const formData = new FormData(shipForm);
    const carrier = formData.get('carrier')?.toString();
    const trackingNumber = formData.get('tracking_number')?.toString();
    const adminRemark = formData.get('admin_remark')?.toString();

    const submitBtn = document.getElementById('confirm-ship-btn') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'ship',
          carrier,
          trackingNumber,
          adminRemark,
        }),
      });

      if (res.ok) {
        hideModal();
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to dispatch shipment');
      }
    } catch (err: any) {
      alert(err.message || 'Network error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

