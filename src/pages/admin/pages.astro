    function renderSectionForm(sec: any, idx: number): string {
      const type = sec._type;
      const specs = SECTION_FIELD_SPECS[type];
      if (!specs) {
        return `<div class="p-4 text-xs text-[#86868b]">Unknown section type: ${escapeHtml(type)}</div>`;
      }

      const fieldsHtml = `<div data-sec-fields>${renderSchemaFields(specs, sec, currentLang)}</div>`;

      if (type === 'heroSection') {
        const heroImgUrl = (window as any).resolveSanityRefUrl?.(sec.heroImage) || '';
        return `<div class="space-y-4">${fieldsHtml}${renderImagePickerRow('Hero Cover Image (首屏大图)', 'Select high-res visual from cloud media library', 'heroImage', heroImgUrl, idx)}</div>`;
      }

      if (type === 'featureMatrixSection') {
        const macroImgUrl = (window as any).resolveSanityRefUrl?.(sec.macroImage) || '';
        return `<div class="space-y-4">${fieldsHtml}${renderImagePickerRow('Macro Feature Image (macroImage)', 'Select macro yarn/fabric detail visual', 'macroImage', macroImgUrl, idx)}</div>`;
      }

      if (type === 'productShowcaseSection') {
