---
// src/pages/[lang]/products/index.astro
import ProductsPage from '../../products/index.astro';
import { LANGUAGES } from '@i18n';

export const prerender = false;
const { lang } = Astro.params;

// Guard against static assets, hidden paths, or file extensions falling into dynamic lang products
if (!lang || lang.startsWith('_') || lang.includes('.')) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!(lang in LANGUAGES) || lang === 'en') {
  return Astro.redirect('/products');
}
---

<ProductsPage />
