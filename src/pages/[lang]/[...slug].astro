---
// src/pages/[lang]/[...slug].astro
import CatchAllPage from '../[...slug].astro';
import { LANGUAGES } from '@i18n';

export const prerender = false;
const { lang, slug } = Astro.params;

// Guard against static assets, hidden paths, or file extensions falling into dynamic i18n routes
if (
  !lang ||
  lang.startsWith('_') ||
  lang.includes('.') ||
  slug?.includes('.')
) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!(lang in LANGUAGES) || lang === 'en') {
  return Astro.redirect(`/${slug || ''}`);
}
---

<CatchAllPage />
