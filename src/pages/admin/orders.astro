                  <div class="flex items-center gap-1">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200/60" title="${escapeHtml(order.assigned_to)}">
