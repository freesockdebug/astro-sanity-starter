                    ${safeEmail}
                  </a>
                  <span class="text-[#1d1d1f] font-semibold shrink-0">${totalStyles} styles · ${totalQty} pcs</span>
                </div>
              </div>

              <div class="flex items-center justify-between gap-2 pt-0.5">
                <button
                  type="button"
                  class="action-toggle-detail-btn h-8 px-2.5 rounded-lg text-xs font-medium text-[#1d1d1f] bg-white hover:bg-[#f5f5f7] border border-black/10 hover:border-black/30 shadow-2xs inline-flex items-center gap-1 transition-all cursor-pointer active:scale-95 shrink-0"
                  data-target="detail-m-${safeId}"
                  title="Toggle order breakdown and line items"
                >
                  <span>Items (${itemCount})</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron-icon" style="${isMobileExpanded ? 'transform: rotate(180deg);' : ''}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${renderActionButtons(order, true)}
