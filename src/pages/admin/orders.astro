      if (res.ok) {
        hideRejectModal();
        (window as any).__showToast?.('Order rejected', 'info');
        await clientCache.invalidatePrefix('admin:orders');
        await clientCache.invalidatePrefix('buyer:orders');
        fetchOrders(false);
      } else {
        const data = await res.json();
        showError(rejectErrorEl, data.error || 'Rejection failed');
      }
    } catch (err) {
      showError(rejectErrorEl, err.message || 'Network error');
    } finally {
      if (confirmRejectBtn) {
        confirmRejectBtn.disabled = false;
        confirmRejectBtn.textContent = 'Confirm Rejection';
      }
    }
