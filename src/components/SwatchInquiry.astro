---
// src/components/SwatchInquiry.astro
import { fetchRfqSettings } from '@data/rfqSettings';
import { DEFAULT_SWATCH_INQUIRY } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue, toText } from '@i18n';

interface Props {
  badge?: string;
  headline?: string;
  subline?: string;
  buttonText?: string;
  swatchSku?: string;
  categories?: string[];
  showSection?: boolean;
  showButton?: boolean;
}

const {
  badge = DEFAULT_SWATCH_INQUIRY.badge,
  headline = DEFAULT_SWATCH_INQUIRY.headline,
  subline = DEFAULT_SWATCH_INQUIRY.subline,
  buttonText: propButtonText,
  swatchSku,
  categories = DEFAULT_SWATCH_INQUIRY.categories,
  showSection: propShowSection,
  showButton: propShowButton,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const safeBadge = toText(badge, currentLang, DEFAULT_SWATCH_INQUIRY.badge);
const safeHeadline = toText(headline, currentLang, DEFAULT_SWATCH_INQUIRY.headline);
const safeSubline = toText(subline, currentLang, DEFAULT_SWATCH_INQUIRY.subline);

const rfqSettings = await fetchRfqSettings();
const showInquirySection = propShowSection !== undefined ? propShowSection : (rfqSettings?.showInquirySection ?? true);
const showSwatchButton = propShowButton !== undefined ? Boolean(propShowButton) : true;
const displayButtonText = toText(propButtonText, currentLang) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));

const copy = {
  tagText: t('inquiry.tagText'),
  tagSubtitle: t('inquiry.tagSubtitle'),
  verified: t('inquiry.verified'),
  included: t('inquiry.included'),
  note: t('inquiry.note'),
};
---

{showInquirySection && (
<section id="inquiry" class="bg-canvas text-ink border-t border-hairline">
  <div class="apple-rail-bento w-full">
    <div class="max-w-5xl mx-auto bg-surface rounded-[var(--gv-radius-card)] border border-hairline overflow-hidden grid grid-cols-1 md:grid-cols-12 items-stretch">
      
      <!-- Left Side (5 Cols): Physical Swatch Kit & Fabric Macro Visual Presentation -->
      <div class="md:col-span-5 relative min-h-[240px] md:min-h-full bg-surface overflow-hidden group">
        <picture>
          <source srcset="/images/products/gv-ruffle-detail.webp" type="image/webp" />
          <img
            src="/images/products/gv-ruffle-detail.webp"
            alt="Curated Swatch Kit & Fabric Dossier"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            loading="lazy"
            decoding="async"
            width="800"
            height="509"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent flex flex-col justify-end p-6 sm:p-7 text-white">
          <span class="text-xs font-mono tracking-[0.14em] uppercase text-white/80">{copy.tagText}</span>
          <p class="text-sm sm:text-base font-medium mt-1 text-white">
            {copy.tagSubtitle}
          </p>
        </div>
      </div>

      <!-- Right Side (7 Cols): Spacious Details & Action -->
      <div class="md:col-span-7 p-7 sm:p-10 lg:p-12 flex flex-col justify-center gap-5">
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="text-xs font-medium uppercase tracking-[0.14em] text-muted">{safeBadge}</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-canvas text-ink border border-hairline font-mono">
              48h Express
            </span>
            <span class="hidden sm:inline-block text-xs text-muted font-mono">· {copy.verified}</span>
          </div>
          
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-tight text-ink mt-2.5">
            {safeHeadline}
          </h2>
          <p class="text-[15px] text-muted font-normal leading-relaxed mt-2">
            {safeSubline}
          </p>
        </div>

        <!-- Included Fabric Silhouettes Pills -->
        <div class="pt-4 border-t border-hairline">
          <span class="text-xs font-mono uppercase tracking-[0.12em] text-muted block mb-2.5">
            {copy.included}
          </span>
          <div class="flex flex-wrap gap-2">
            {categories.map((cat: string) => (
              <span class="px-3 py-1 rounded-full bg-elevated text-ink text-xs font-medium border border-hairline">
                ✓ {cat}
              </span>
            ))}
          </div>
        </div>

        <!-- Action Row -->
        <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          {showSwatchButton && (
            <button
              type="button"
              data-open-swatch-kit
              data-swatch-sku={swatchSku}
              class="px-6 py-3 rounded-full text-sm font-medium bg-ink text-canvas hover:opacity-85 transition-opacity cursor-pointer inline-flex items-center justify-center gap-2 shrink-0"
            >
              <span>{displayButtonText}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          )}
          <p class="text-xs text-muted">
            {copy.note}
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
)}
