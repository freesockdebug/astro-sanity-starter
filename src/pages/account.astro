---
// src/pages/account.astro
import BuyerLayout from '@layouts/BuyerLayout.astro';
import LocalTime from '@components/LocalTime.astro';
import TierBadge from '@components/TierBadge.astro';
import { getBuyerContext, getRuntimeEnv } from '@utils/auth';
import { getUserLoginHistory } from '@utils/db';
import { getLangFromUrl, useTranslations } from '@i18n';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { sessionUser, dbUser, redirectResponse } = await getBuyerContext(Astro, cfEnv, { requireLogin: true });
if (redirectResponse) return redirectResponse;

const loginHistory = await getUserLoginHistory(sessionUser!.id, 20);
const logtoEndpoint = getRuntimeEnv('LOGTO_ENDPOINT', cfEnv);
const pageTitle = t('account.metaTitle');
const pageDesc = t('account.metaDesc');
const tier = dbUser?.tier || 'STANDARD';
---

<BuyerLayout
  title={pageTitle}
  description={pageDesc}
  currentTab="account"
  sessionUser={sessionUser}
  dbUser={dbUser}
>
  <!-- Main Layout: 2-Column Asymmetric Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-[clamp(1rem,0.5rem+1vw,1.75rem)] items-start">

        <!-- Left Column (8/12 Cols): Profile Form & Password Management -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-6">

          <!-- Section 1: Profile Maintenance -->
          <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.75rem)] shadow-2xs space-y-4">
            <div>
              <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">{t('account.sectionProfile')}</h2>
              <p class="text-[11px] text-[#86868b] mt-0.5">
                {t('account.sectionProfileDesc')}
              </p>
            </div>

            <form
              id="profile-form"
              class="space-y-4 text-xs"
              data-msg-saving={t('account.saving')}
              data-msg-save={t('account.saveProfile')}
              data-msg-success={t('account.profileUpdated')}
              data-msg-failed={t('account.profileFailed')}
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="profile-name" class="block font-semibold mb-1 text-[11px] text-[#52525b]">{t('account.nameLabel')}</label>
                  <input
                    type="text"
                    id="profile-name"
                    name="name"
                    value={dbUser?.name || sessionUser.name || ''}
                    placeholder={t('account.namePlaceholder')}
                    class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
                  />
                </div>

                <div>
                  <label for="profile-email" class="block font-semibold mb-1 text-[11px] text-[#52525b]">{t('account.emailLabel')}</label>
                  <input
                    type="email"
                    id="profile-email"
                    value={sessionUser.email}
                    disabled
                    class="w-full px-3.5 py-2 rounded-xl bg-black/5 border border-black/10 text-[#86868b] font-mono cursor-not-allowed"
                  />
                </div>

                <div>
                  <label for="profile-company" class="block font-semibold mb-1 text-[11px] text-[#52525b]">{t('account.companyLabel')}</label>
                  <input
                    type="text"
                    id="profile-company"
                    name="company"
                    value={dbUser?.company || ''}
                    placeholder={t('account.companyPlaceholder')}
                    class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
                  />
                </div>

                <div>
                  <label for="profile-country" class="block font-semibold mb-1 text-[11px] text-[#52525b]">{t('account.countryLabel')}</label>
                  <input
                    type="text"
                    id="profile-country"
                    name="country"
                    value={dbUser?.country || ''}
                    placeholder={t('account.countryPlaceholder')}
                    class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="profile-phone" class="block font-semibold mb-1 text-[11px] text-[#52525b]">{t('account.phoneLabel')}</label>
                  <input
                    type="text"
                    id="profile-phone"
                    name="phone"
                    value={dbUser?.phone || ''}
                    placeholder="e.g. +33 6 12 34 56 78"
                    class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
                  />
                </div>
              </div>

              <div id="profile-feedback" class="hidden p-3 rounded-xl text-xs font-medium"></div>

              <div class="flex items-center justify-end pt-2">
                <button
                  type="submit"
                  id="save-profile-btn"
                  class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs active:scale-95 cursor-pointer"
                >
                  {t('account.saveProfile')}
                </button>
              </div>
            </form>
          </div>

          <!-- Section 2: Security & Password Management -->
          <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.75rem)] shadow-2xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">{t('account.sectionSecurity')}</h2>
                <p class="text-[11px] text-[#86868b] mt-0.5">
                  {t('account.sectionSecurityDesc')}
                </p>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                {t('account.logtoActive')}
              </span>
            </div>

            <div class="p-4 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <span class="font-semibold text-xs text-[#1d1d1f] block">{t('account.passwordCardTitle')}</span>
                <p class="text-[11px] text-[#86868b] max-w-lg leading-relaxed">
                  {t('account.passwordCardDesc')}
                </p>
              </div>

              <button
                type="button"
                id="btn-open-password-modal"
                class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs text-center shrink-0 inline-flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
                <span>{t('account.changePasswordBtn')}</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Right Column (4/12 Cols): Tier Perks & Login Activity -->
        <div class="lg:col-span-5 xl:col-span-4 space-y-6">

          <!-- B2B Tier Privileges Card -->
          <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.75rem)] shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-[#86868b]">B2B Membership</span>
              <TierBadge tier={tier} />
            </div>

            <div class="space-y-3 pt-1">
              <div class="flex items-start gap-2.5 text-xs text-[#1d1d1f]">
                <span class="text-base shrink-0">📦</span>
                <div>
                  <span class="font-semibold block">Free Swatch Kits</span>
                  <p class="text-[11px] text-[#86868b] leading-tight mt-0.5">Physical swatches & seasonal color cards</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5 text-xs text-[#1d1d1f]">
                <span class="text-base shrink-0">💳</span>
                <div>
                  <span class="font-semibold block">Flexible Terms</span>
                  <p class="text-[11px] text-[#86868b] leading-tight mt-0.5">Wire Transfer, Net 30, and Irrevocable L/C</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5 text-xs text-[#1d1d1f]">
                <span class="text-base shrink-0">⚡</span>
                <div>
                  <span class="font-semibold block">Priority Production</span>
                  <p class="text-[11px] text-[#86868b] leading-tight mt-0.5">Fast-track sample weaving & dedicated lines</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5 text-xs text-[#1d1d1f]">
                <span class="text-base shrink-0">💬</span>
                <div>
                  <span class="font-semibold block">Key Account Manager</span>
                  <p class="text-[11px] text-[#86868b] leading-tight mt-0.5">Direct 1-on-1 technical consultation via WhatsApp</p>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-black/5 flex items-center justify-between text-[11px] text-[#86868b]">
              <span>Annual volume tiering</span>
              <a href="https://wa.me/8613867512218" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Upgrade Inquiry →</a>
            </div>
          </div>

          <!-- Dedicated Atelier Concierge Card -->
          <div class="bg-gradient-to-br from-[#1d1d1f] to-[#2c2c2e] text-white rounded-2xl p-5 sm:p-6 shadow-md space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-white/60">Dedicated Concierge</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/10 text-emerald-400 border border-emerald-400/20">
                Online Direct
              </span>
            </div>
            <div>
              <h3 class="text-sm font-semibold">Atelier Key Account Manager</h3>
              <p class="text-[11px] text-zinc-300 mt-1 leading-relaxed">
                Direct access for yarn customization, bulk pricing & priority sample dispatch.
              </p>
            </div>
            <div class="pt-2 flex items-center gap-2">
              <a
                href={`https://wa.me/8613867512218?text=${encodeURIComponent(`Hello GwenVenni Atelier, this is ${dbUser?.name || sessionUser.name || 'a B2B client'} from ${dbUser?.company || 'our company'} (${sessionUser.email}). I would like to consult on custom manufacturing & wholesale orders.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 py-2 px-3 rounded-xl text-xs font-semibold bg-emerald-500 hover:bg-emerald-600 text-white transition-all text-center inline-flex items-center justify-center gap-1.5 shadow-sm"
              >
                <span>WhatsApp 1-on-1</span>
              </a>
              <a
                href={`mailto:b2b@gwenvenni.com?subject=${encodeURIComponent(`[B2B Inquiry] ${dbUser?.company || sessionUser.email}`)}`}
                class="py-2 px-3 rounded-xl text-xs font-semibold bg-white/10 hover:bg-white/20 text-white transition-all border border-white/15 text-center shrink-0"
                title="Send inquiry email"
              >
                ✉️ Email
              </a>
            </div>
          </div>

          <!-- Section 3: Login Security Activity -->
          <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.75rem)] shadow-2xs space-y-4">
            <div class="flex items-center justify-between gap-2">
              <div>
                <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">{t('account.sectionActivity')}</h2>
                <p class="text-[11px] text-[#86868b] mt-0.5">{t('account.retention')}</p>
              </div>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" title="Active"></span>
            </div>

            {loginHistory.length === 0 ? (
              <div class="p-4 rounded-xl bg-[#f5f5f7] text-center text-xs text-[#86868b]">
                {t('account.noActivity')}
              </div>
            ) : (
              <div class="space-y-2.5 max-h-[460px] overflow-y-auto pr-0.5 scrollbar-thin">
                {loginHistory.map((item, idx) => {
                  const isLatest = idx === 0;
                  const locationStr = [item.city, item.country].filter(Boolean).join(', ') || 'Global';
                  let deviceSummary = t('account.deviceDesktop');
                  if (/mobile|iphone|android/i.test(item.user_agent)) deviceSummary = t('account.deviceMobile');
                  else if (/macintosh|mac os/i.test(item.user_agent)) deviceSummary = t('account.deviceMac');
                  else if (/windows/i.test(item.user_agent)) deviceSummary = t('account.deviceWindows');

                  return (
                    <div class="p-3 rounded-xl bg-[#f5f5f7] border border-black/5 text-xs space-y-1">
                      <div class="flex items-center justify-between">
                        <span class="font-mono text-[11px] font-semibold text-[#1d1d1f]">
                          <LocalTime datetime={item.created_at} />
                        </span>
                        {isLatest && (
                          <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800">
                            {t('account.currentSession')}
                          </span>
                        )}
                      </div>
                      <div class="flex items-center justify-between text-[11px] text-[#86868b]">
                        <span>{locationStr}</span>
                        <span class="font-mono text-[#52525b]">{item.ip || '—'} · {deviceSummary}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            <div class="pt-2 text-[10px] text-[#86868b] flex items-start gap-1.5">
              <svg class="w-3.5 h-3.5 shrink-0 text-[#86868b] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{t('account.securityNotice')}</span>
            </div>
          </div>

        </div>

      </div>

  <!-- Change Password Modal Dialog (修改密码弹窗) -->
  <div
    id="password-modal"
    class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    data-msg-mismatch={t('account.passwordMismatch')}
    data-msg-short={t('account.passwordTooShort')}
    data-msg-saving={t('account.savingPassword')}
    data-msg-save={t('account.savePasswordBtn')}
    data-msg-success={t('account.passwordSuccess')}
  >
    <div
      id="password-modal-card"
      class="bg-white rounded-2xl border border-black/10 shadow-2xl max-w-md w-full p-6 space-y-5 transform scale-95 transition-transform duration-200"
    >
      <div class="flex items-center justify-between border-b border-black/5 pb-3">
        <div>
          <h3 id="modal-title" class="text-sm font-semibold text-[#1d1d1f]">{t('account.modalTitle')}</h3>
          <p class="text-[11px] text-[#86868b] mt-0.5">{t('account.modalDesc')} <span class="font-mono text-[#1d1d1f]">{sessionUser.email}</span></p>
        </div>
        <button
          type="button"
          id="btn-close-password-modal"
          class="text-[#86868b] hover:text-[#1d1d1f] p-1.5 rounded-lg hover:bg-[#f5f5f7] transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-change-password" class="space-y-4">
        <div id="password-alert" class="hidden p-3 rounded-xl text-xs leading-relaxed"></div>

        <div class="space-y-1.5">
          <label for="input-new-password" class="block text-[11px] font-semibold text-[#1d1d1f] uppercase tracking-wider">
            {t('account.newPasswordLabel')} <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <input
              type="password"
              id="input-new-password"
              name="password"
              required
              minlength="8"
              placeholder={t('account.newPasswordPlaceholder')}
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-black/15 bg-white text-[#1d1d1f] focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-10"
            />
            <button
              type="button"
              class="btn-toggle-pwd absolute right-2.5 top-1/2 -translate-y-1/2 text-[#86868b] hover:text-[#1d1d1f] p-1 cursor-pointer"
              data-target="input-new-password"
              title="Toggle visibility"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
          <span class="text-[10px] text-[#86868b] block">{t('account.passwordHint')}</span>
        </div>

        <div class="space-y-1.5">
          <label for="input-confirm-password" class="block text-[11px] font-semibold text-[#1d1d1f] uppercase tracking-wider">
            {t('account.confirmPasswordLabel')} <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <input
              type="password"
              id="input-confirm-password"
              name="confirmPassword"
              required
              minlength="8"
              placeholder={t('account.confirmPasswordPlaceholder')}
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-black/15 bg-white text-[#1d1d1f] focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-10"
            />
            <button
              type="button"
              class="btn-toggle-pwd absolute right-2.5 top-1/2 -translate-y-1/2 text-[#86868b] hover:text-[#1d1d1f] p-1 cursor-pointer"
              data-target="input-confirm-password"
              title="Toggle visibility"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-black/5">
          <button
            type="button"
            id="btn-cancel-password"
            class="px-4 py-2 rounded-xl text-xs font-medium text-[#86868b] hover:text-[#1d1d1f] hover:bg-[#f5f5f7] transition-colors cursor-pointer"
          >
            {t('account.cancelBtn')}
          </button>
          <button
            type="submit"
            id="btn-submit-password"
            class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
          >
            <span id="btn-submit-password-text">{t('account.savePasswordBtn')}</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</BuyerLayout>

<script>
  // Profile update handling
  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;
  const feedbackEl = document.getElementById('profile-feedback');

  const profileMsgSaving = form?.dataset.msgSaving || 'Saving...';
  const profileMsgSave = form?.dataset.msgSave || 'Save Profile Changes';
  const profileMsgSuccess = form?.dataset.msgSuccess || '✓ Profile details updated successfully.';
  const profileMsgFailed = form?.dataset.msgFailed || 'Failed to update profile';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!saveBtn) return;

    saveBtn.disabled = true;
    saveBtn.textContent = profileMsgSaving;

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      company: formData.get('company'),
      country: formData.get('country'),
      phone: formData.get('phone'),
    };

    try {
      const res = await fetch('/api/user/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (res.ok) {
        try {
          const emailVal = (document.getElementById('profile-email') as HTMLInputElement)?.value || '';
          localStorage.setItem('b2b_buyer_profile', JSON.stringify({
            name: payload.name,
            email: emailVal,
            company: payload.company,
            country: payload.country,
            phone: payload.phone,
          }));
        } catch {}

        if (feedbackEl) {
          feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          feedbackEl.textContent = profileMsgSuccess;
        }
        setTimeout(() => {
          if (feedbackEl) feedbackEl.className = 'hidden';
        }, 3000);
      } else {
        if (feedbackEl) {
          feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
          feedbackEl.textContent = data.error || profileMsgFailed;
        }
      }
    } catch (err: any) {
      if (feedbackEl) {
        feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
        feedbackEl.textContent = err.message || profileMsgFailed;
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = profileMsgSave;
    }
  });

  // Password change modal handling
  const modal = document.getElementById('password-modal');
  const modalCard = document.getElementById('password-modal-card');
  const btnOpenModal = document.getElementById('btn-open-password-modal');
  const btnCloseModal = document.getElementById('btn-close-password-modal');
  const btnCancelModal = document.getElementById('btn-cancel-password');
  const formPassword = document.getElementById('form-change-password') as HTMLFormElement | null;
  const alertEl = document.getElementById('password-alert');
  const submitBtn = document.getElementById('btn-submit-password') as HTMLButtonElement | null;
  const submitBtnText = document.getElementById('btn-submit-password-text');

  const pwdMsgMismatch = modal?.dataset.msgMismatch || 'Passwords do not match';
  const pwdMsgShort = modal?.dataset.msgShort || 'Password must be at least 8 characters long';
  const pwdMsgSaving = modal?.dataset.msgSaving || 'Updating...';
  const pwdMsgSave = modal?.dataset.msgSave || 'Save New Password';
  const pwdMsgSuccess = modal?.dataset.msgSuccess || '✓ Password updated successfully!';

  function openPasswordModal() {
    if (!modal || !modalCard) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalCard.classList.remove('scale-95');
    modalCard.classList.add('scale-100');
    if (alertEl) alertEl.className = 'hidden';
    const firstInput = document.getElementById('input-new-password') as HTMLInputElement | null;
    firstInput?.focus();
  }

  function closePasswordModal() {
    if (!modal || !modalCard) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalCard.classList.remove('scale-100');
    modalCard.classList.add('scale-95');
    formPassword?.reset();
    if (alertEl) alertEl.className = 'hidden';
  }

  btnOpenModal?.addEventListener('click', openPasswordModal);
  btnCloseModal?.addEventListener('click', closePasswordModal);
  btnCancelModal?.addEventListener('click', closePasswordModal);

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePasswordModal();
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      closePasswordModal();
    }
  });

  // Toggle password visibility buttons
  document.querySelectorAll('.btn-toggle-pwd').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  });

  // Password submission handler
  formPassword?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitBtnText || !alertEl) return;

    const inputPwd = (document.getElementById('input-new-password') as HTMLInputElement)?.value || '';
    const inputConfirm = (document.getElementById('input-confirm-password') as HTMLInputElement)?.value || '';

    if (inputPwd.length < 8) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = pwdMsgShort;
      return;
    }

    if (inputPwd !== inputConfirm) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = pwdMsgMismatch;
      return;
    }

    submitBtn.disabled = true;
    submitBtnText.textContent = pwdMsgSaving;

    try {
      const res = await fetch('/api/user/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: inputPwd, confirmPassword: inputConfirm }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        alertEl.textContent = pwdMsgSuccess;
        setTimeout(() => {
          closePasswordModal();
        }, 1500);
      } else {
        alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
        alertEl.textContent = data.error || 'Failed to update password.';
      }
    } catch (err: any) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = err.message || 'Network communication error.';
    } finally {
      submitBtn.disabled = false;
      submitBtnText.textContent = pwdMsgSave;
    }
  });
</script>

