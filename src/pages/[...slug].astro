---
// src/pages/[...slug].astro
import type { Page } from 'types';
import Layout from '@layouts/Layout.astro';
import { componentMap } from '@components';
import { client } from '@utils/sanity-client';
import { PAGE_QUERY_OBJ } from '@data/page';
import { CONFIG_QUERY_OBJ, SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { normalizeSections, extractHeroPreload } from '@data/blocks';
import { getLangFromUrl, getLocalizedValue } from '@i18n';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');

const currentLang = getLangFromUrl(Astro.url);
let rawSlug = Astro.params.slug || Astro.params.lang || Astro.url.pathname.replace(/^\//, '');

// Strip language prefix if present (e.g. "de/about" -> "about", "de" -> "") so Sanity query matches standard page slug
if (currentLang && currentLang !== 'en') {
  rawSlug = rawSlug.replace(new RegExp(`^${currentLang}(/|$)`), '');
}

// Fast 404 for static asset extensions to prevent unnecessary CMS roundtrips or MIME confusion
if (rawSlug && /\.(css|js|map|png|jpe?g|webp|avif|jxl|svg|woff2?|ttf|ico|txt|xml|json)$/i.test(rawSlug)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const formattedSlug = !rawSlug || rawSlug === '/' ? '/' : (rawSlug.startsWith('/') ? rawSlug : `/${rawSlug}`);
const unslashed = formattedSlug.replace(/^\//, '');

// Scheme 2: Single Aggregated GROQ Query - combines 3 independent API calls into 1 single roundtrip
let batchData: any = null;
try {
  batchData = await client.fetch(
    `{
      "page": *[_type == "page" && (slug.current == $formattedSlug || slug.current == $unslashed)][0] ${PAGE_QUERY_OBJ},
      "siteConfig": *[_type == "siteConfig"][0] ${CONFIG_QUERY_OBJ},
      "rfqSettings": *[_type == "rfqSettings"][0]
    }`,
    { formattedSlug, unslashed }
  );
} catch (e) {
  console.error(`Failed to batch-fetch page data for ${formattedSlug}:`, e);
}

// Pre-populate service caches unconditionally so Layout, AppleNav, QuoteDrawer, and sections make 0 additional API requests
SiteConfigService.seed(batchData?.siteConfig);
RfqSettingsService.seed(batchData?.rfqSettings);

const page: Page = batchData?.page;
if (!page) {
    return new Response("404 Not Found", { status: 404, statusText: "Not Found" });
}

const { title, sections: rawSections, metaTitle, addTitleSuffix, metaDescription, socialImage } = page;
const sections = normalizeSections(rawSections, currentLang);
const heroPreload = extractHeroPreload(sections);
const localizedTitle = (title && typeof title === 'object' ? getLocalizedValue(title, currentLang) : '') || title;
const localizedMetaTitle = (metaTitle && typeof metaTitle === 'object' ? getLocalizedValue(metaTitle, currentLang) : '') || metaTitle;
const localizedMetaDescription = (metaDescription && typeof metaDescription === 'object' ? getLocalizedValue(metaDescription, currentLang) : '') || metaDescription;
---

{
    page && (
        <Layout
            title={localizedMetaTitle || localizedTitle}
            addTitleSuffix={addTitleSuffix}
            description={localizedMetaDescription}
            image={socialImage}
            page={page}
            preloadHeroImage={heroPreload}
        >
            <Fragment>
                {sections?.length &&
                    sections.map((section: any) => {
                        const Component = componentMap[section._type];
                        return Component ? <Component {...section} /> : null;
                    })}
            </Fragment>
        </Layout>
    )
}
