---
// src/components/admin/TableColumnController.astro
// Unified table columns controller button + popover menu with drag & drop reordering,
// visibility toggles, cloud synchronization status, and density switcher

interface Props {
  controllerBtnId?: string;
  controllerMenuId?: string;
  columnsListId?: string;
  countBadgeId?: string;
  syncStatusId?: string;
  resetBtnId?: string;
  densityBtnId?: string;
  densityLabelId?: string;
  showDensityToggle?: boolean;
  class?: string;
}

const {
  controllerBtnId = 'table-columns-btn',
  controllerMenuId = 'table-columns-menu',
  columnsListId = 'table-columns-list',
  countBadgeId = 'table-columns-count',
  syncStatusId = 'table-columns-sync-status',
  resetBtnId = 'table-columns-reset-btn',
  densityBtnId = 'table-density-btn',
  densityLabelId = 'table-density-label',
  showDensityToggle = true,
  class: className = '',
} = Astro.props;
---

<div class={`relative inline-flex items-center gap-1.5 ${className}`}>
  <!-- 1. Optional Density Toggle Button -->
  {
    showDensityToggle && (
      <button
        type="button"
        id={densityBtnId}
        class="h-8 px-2.5 rounded-lg border border-black/10 bg-white hover:bg-[#f5f5f7] active:scale-95 text-xs font-medium text-[#1d1d1f] flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs"
        title="Toggle Table Row Density (Compact / Cozy)"
      >
        <span class="text-xs">☵</span>
        <span id={densityLabelId}>Cozy</span>
      </button>
    )
  }

  <!-- 2. Columns Trigger Button -->
  <button
    type="button"
    id={controllerBtnId}
    class="h-8 px-2.5 rounded-lg border border-black/10 bg-white hover:bg-[#f5f5f7] active:scale-95 text-xs font-medium text-[#1d1d1f] flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs"
    title="Customize Visible Columns & Order"
  >
    <svg class="w-3.5 h-3.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <span>Cols</span>
    <span id={countBadgeId} class="px-1.5 py-0.2 rounded-full bg-black/5 text-[10px] font-mono font-semibold text-[#86868b]">
      —
    </span>
  </button>

  <!-- 3. Dropdown Popover Menu -->
  <div
    id={controllerMenuId}
    class="hidden absolute right-0 top-full mt-1.5 z-40 w-72 bg-white/95 backdrop-blur-xl border border-black/10 rounded-2xl shadow-xl p-3 text-xs divide-y divide-black/5 animate-in fade-in zoom-in-95 duration-100"
  >
    <!-- Menu Top Bar -->
    <div class="pb-2.5 flex items-center justify-between">
      <div>
        <div class="font-semibold text-[#1d1d1f] tracking-tight text-xs">Table Columns</div>
        <div id={syncStatusId} class="text-[10px] text-[#86868b] mt-0.5">
          <span class="inline-flex items-center gap-1">☁ Synced</span>
        </div>
      </div>
      <button
        type="button"
        id={resetBtnId}
        class="text-[11px] text-blue-600 hover:text-blue-700 font-medium px-2 py-0.5 rounded hover:bg-blue-50 transition-colors cursor-pointer"
        title="Reset columns, order & widths to default"
      >
        Reset
      </button>
    </div>

    <!-- Interactive Column List -->
    <div
      id={columnsListId}
      class="py-2 space-y-0.5 max-h-64 overflow-y-auto scrollbar-thin overscroll-contain"
    >
      <!-- Hydrated dynamically by useTableSettings -->
    </div>

    <!-- Helper Tip -->
    <div class="pt-2 text-[10px] text-[#86868b] flex items-center justify-between">
      <span>Drag ⠿ or click ↑↓ to reorder</span>
      <span>Drag border to resize</span>
    </div>
  </div>
</div>

