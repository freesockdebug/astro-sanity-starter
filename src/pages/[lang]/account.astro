---
// src/pages/[lang]/account.astro
import AccountPage from '../account.astro';
import { LANGUAGES } from '@i18n';
import { getSessionFromRequest } from '@utils/auth';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;
const { lang } = Astro.params;

// Guard against static assets, hidden paths, or file extensions
if (!lang || lang.startsWith('_') || lang.includes('.')) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!(lang in LANGUAGES) || lang === 'en') {
  return Astro.redirect('/account');
}

const sessionUser = await getSessionFromRequest(Astro, cfEnv);
if (!sessionUser) {
  return Astro.redirect(`/api/auth/login?returnUrl=${encodeURIComponent(Astro.url.pathname)}`);
}
---

<AccountPage />
