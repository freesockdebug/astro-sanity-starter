    // Attach Event Listeners to Section Card Elements
    function attachSectionEvents() {
      const container = document.getElementById('sections-container');
      if (!container) return;

      // Bug 3 Fix: Collapse / Expand toggle using unique key
      container.querySelectorAll('.btn-sec-toggle').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const key = btn.getAttribute('data-key');
          if (!key) return;
          if (collapsedSections.has(key)) {
            collapsedSections.delete(key);
          } else {
            collapsedSections.add(key);
          }
          renderSections();
        });
      });

      // Card Header click to toggle
      container.querySelectorAll('.card-header-row').forEach((header) => {
        header.addEventListener('click', (e: any) => {
          if (e.target.closest('button') || e.target.closest('.drag-handle')) return;
          syncSectionsFromDom();
          const card = header.closest('.section-card');
          const key = card?.getAttribute('data-key');
          if (!key) return;
          if (collapsedSections.has(key)) {
            collapsedSections.delete(key);
          } else {
            collapsedSections.add(key);
          }
          renderSections();
        });
      });

      // Move Up
      container.querySelectorAll('.btn-sec-up').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx > 0) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx - 1, 0, item);
            renderSections();
          }
        });
      });

      // Move Down
      container.querySelectorAll('.btn-sec-down').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx < activePageDoc.sections.length - 1) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx + 1, 0, item);
            renderSections();
          }
        });
      });

      // Duplicate Section
      container.querySelectorAll('.btn-sec-copy').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const cloned = JSON.parse(JSON.stringify(activePageDoc.sections[idx]));
          cloned._key = crypto.randomUUID().slice(0, 8);
          if (cloned.adminLabel) cloned.adminLabel = `${cloned.adminLabel} (Copy)`;
          activePageDoc.sections.splice(idx + 1, 0, cloned);
          renderSections();
          (window as any).__showToast?.('Section duplicated', 'success');
        });
      });

      // Delete Section
      container.querySelectorAll('.btn-sec-del').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          activePageDoc.sections.splice(idx, 1);
          renderSections();
        });
      });

      // HTML5 Drag and Drop Reorder
      const cards = container.querySelectorAll('.section-card');
      cards.forEach((card) => {
        const handle = card.querySelector('.drag-handle');
        handle?.addEventListener('mouseenter', () => card.setAttribute('draggable', 'true'));
        handle?.addEventListener('mouseleave', () => card.removeAttribute('draggable'));

        card.addEventListener('dragstart', (e: any) => {
          draggedSectionIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          e.dataTransfer.effectAllowed = 'move';
          card.classList.add('opacity-40');
        });

        card.addEventListener('dragend', () => {
          draggedSectionIdx = null;
          card.classList.remove('opacity-40');
          cards.forEach((c) => c.classList.remove('ring-2', 'ring-black'));
        });

        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer!.dropEffect = 'move';
          card.classList.add('ring-2', 'ring-black');
        });

        card.addEventListener('dragleave', () => {
          card.classList.remove('ring-2', 'ring-black');
        });

        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('ring-2', 'ring-black');
          syncSectionsFromDom();
          const targetIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          if (draggedSectionIdx !== null && draggedSectionIdx !== targetIdx) {
            const item = activePageDoc.sections.splice(draggedSectionIdx, 1)[0];
            activePageDoc.sections.splice(targetIdx, 0, item);
            renderSections();
          }
        });
      });

      // Section Image Picker (heroImage, macroImage)
      container.querySelectorAll('.btn-sec-choose-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: `Select Image for ${target}`,
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              const asset = assets[0];
              activePageDoc.sections[idx][target] = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: asset._id,
                },
              };
              renderSections();
              (window as any).__showToast?.('Updated section image', 'success');
            },
          });
        });
      });

      container.querySelectorAll('.btn-sec-clear-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          activePageDoc.sections[idx][target] = null;
          renderSections();
        });
      });

      // Product Showcase Picker Add
      container.querySelectorAll('.picker-add-product').forEach((select: any) => {
        select.addEventListener('change', () => {
          syncSectionsFromDom();
          const idx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const prodId = select.value;
          if (!prodId) return;
          if (!activePageDoc.sections[idx].products) activePageDoc.sections[idx].products = [];
          activePageDoc.sections[idx].products.push({
            _key: crypto.randomUUID().slice(0, 8),
            _type: 'reference',
            _ref: prodId,
          });
          renderSections();
          (window as any).__showToast?.('Added product to showcase', 'success');
        });
      });

      // Product Showcase Reorder & Delete
      container.querySelectorAll('.btn-prod-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          if (pIdx > 0) {
            const item = activePageDoc.sections[sIdx].products.splice(pIdx, 1)[0];
            activePageDoc.sections[sIdx].products.splice(pIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].products;
          if (pIdx < list.length - 1) {
            const item = list.splice(pIdx, 1)[0];
            list.splice(pIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-del').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          activePageDoc.sections[sIdx].products.splice(pIdx, 1);
          renderSections();
        });
      });

      // Manufacturing Add Capability
      container.querySelectorAll('.btn-add-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (!activePageDoc.sections[sIdx].capabilities) activePageDoc.sections[sIdx].capabilities = [];
          activePageDoc.sections[sIdx].capabilities.push({
            _key: crypto.randomUUID().slice(0, 8),
            title: { _type: 'localeString', en: 'New Manufacturing Capability' },
            description: { _type: 'localeText', en: 'High capacity apparel fabrication line.' },
          });
          renderSections();
        });
      });

      // Manufacturing Move Up/Down & Delete Capability
      container.querySelectorAll('.btn-cap-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          if (cIdx > 0) {
            const item = activePageDoc.sections[sIdx].capabilities.splice(cIdx, 1)[0];
            activePageDoc.sections[sIdx].capabilities.splice(cIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-cap-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].capabilities;
          if (cIdx < list.length - 1) {
            const item = list.splice(cIdx, 1)[0];
            list.splice(cIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-del-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          activePageDoc.sections[sIdx].capabilities.splice(cIdx, 1);
          renderSections();
        });
      });

      // Custom Section Add Block
      container.querySelectorAll('.picker-add-block').forEach((select: any) => {
        select.addEventListener('change', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const blockType = select.value;
          if (!blockType) return;
          if (!activePageDoc.sections[sIdx].blocks) activePageDoc.sections[sIdx].blocks = [];

          let newBlock: any = { _key: crypto.randomUUID().slice(0, 8), _type: blockType };
          if (blockType === 'headingBlock') {
            newBlock.headline = 'New Section Heading';
            newBlock.subtitle = 'Supporting paragraph text.';
            newBlock.align = 'center';
          }
          activePageDoc.sections[sIdx].blocks.push(newBlock);
          renderSections();
        });
      });

      // Custom Section Block Reorder & Delete
      container.querySelectorAll('.btn-block-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          if (bIdx > 0) {
            const item = activePageDoc.sections[sIdx].blocks.splice(bIdx, 1)[0];
            activePageDoc.sections[sIdx].blocks.splice(bIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-block-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].blocks;
          if (bIdx < list.length - 1) {
            const item = list.splice(bIdx, 1)[0];
            list.splice(bIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-del-block').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          activePageDoc.sections[sIdx].blocks.splice(bIdx, 1);
          renderSections();
        });
      });

      // Custom Section Choose MediaBlock Image
      container.querySelectorAll('.btn-choose-block-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: 'Select Media Block Image',
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              activePageDoc.sections[sIdx].blocks[bIdx].image = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: assets[0]._id,
                },
              };
              renderSections();
            },
          });
        });
      });
    }

    // Read Form Values from DOM back into activePageDoc.sections
    // Bug 2 Fix: Unconditional assignment when input element exists in DOM (allows clearing text to "")
    function syncSectionsFromDom() {
      if (!activePageDoc?.sections) return;
      document.querySelectorAll<HTMLElement>('.section-card').forEach((card, idx) => {
        const key = card.getAttribute('data-key');
        const sec = (key && activePageDoc.sections.find((s: any) => s._key === key)) || activePageDoc.sections[idx];
        if (!sec) return;

        const secScope = card.querySelector('[data-sec-fields]') || card;
        syncSchemaFieldsFromDom(secScope, sec, currentLang);

        if (sec._type === 'manufacturingSection' && sec.capabilities) {
          sec.capabilities.forEach((cap: any, cIdx: number) => {
            const row = card.querySelector(`[data-cap-row="${cIdx}"]`);
            if (row) syncSchemaFieldsFromDom(row, cap, currentLang);
          });
        } else if (sec._type === 'customSection' && sec.blocks) {
          sec.blocks.forEach((b: any, bIdx: number) => {
            const bCard = card.querySelector(`.block-card[data-block-idx="${bIdx}"]`);
            if (bCard) syncSchemaFieldsFromDom(bCard, b, currentLang);
          });
        }
      });
    }

    // Save & Publish Page to Sanity CMS
    document.getElementById('btn-save-page')?.addEventListener('click', async () => {
      if (!activePageDoc) {
        (window as any).__showToast?.('No page loaded', 'error');
        return;
      }

      syncMetaFromDom();
      syncSectionsFromDom();

      (window as any).__showToast?.('Saving page & synchronizing KV/Edge cache...', 'info');

      try {
        const payload = { document: activePageDoc };
        const res = await fetch('/api/admin/cms/pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save page');

        (window as any).__showToast?.('Page saved & published successfully!', 'success');
        loadPages();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    });

    // Create New Page
    document.getElementById('btn-create-page')?.addEventListener('click', () => {
      const titlePrompt = prompt('Enter new page title:');
      if (!titlePrompt || !titlePrompt.trim()) return;

      const slugPrompt = prompt('Enter URL slug (e.g. /custom-line or custom-line):', titlePrompt.toLowerCase().replace(/\s+/g, '-'));
      if (!slugPrompt) return;

      const cleanSlug = slugPrompt.startsWith('/') ? slugPrompt : `/${slugPrompt}`;

      activePageDoc = {
        _type: 'page',
        title: { _type: 'localeString', en: titlePrompt.trim() },
        slug: { _type: 'slug', current: cleanSlug },
        metaTitle: { _type: 'localeString', en: `${titlePrompt.trim()} | Gwen & Venni Luxury Apparel` },
        metaDescription: { _type: 'localeText', en: 'B2B Wholesale & Luxury Apparel Manufacturing' },
        addTitleSuffix: true,
        sections: [getSectionInitialValues('heroSection')],
      };

      currentPages.push(activePageDoc);
      renderPagesList();
      populateMetaInputs();
      renderSocialImagePreview();
      renderSections();
      (window as any).__showToast?.('Created draft page. Click Save to publish.', 'info');
    });

    // Initialize
    loadCatalogProducts();
    loadPages();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagesWorkbench);
  } else {
    initPagesWorkbench();
  }

  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('pages-list')) {
      initPagesWorkbench();
    }
  });
</script>
