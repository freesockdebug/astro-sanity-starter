  // Assign / Reassign Dialog Handling
  let assignTarget: { mode: 'single'; orderId: string } | { mode: 'batch'; count: number } | null = null;
  const assignDialog = document.getElementById('assign-dialog') as HTMLDialogElement | null;
  const assignMemberSelect = document.getElementById('assign-member-select') as HTMLSelectElement | null;
  const assignDialogTitle = document.getElementById('assign-dialog-title');
  const assignDialogDesc = document.getElementById('assign-dialog-desc');
  const confirmAssignBtn = document.getElementById('confirm-assign-btn') as HTMLButtonElement | null;
  const cancelAssignBtn = document.getElementById('cancel-assign-btn');
  const closeAssignDialog = document.getElementById('close-assign-dialog');

  function openAssignDialog(target: { mode: 'single'; orderId: string; currentEmail?: string } | { mode: 'batch'; count: number }) {
    if (!assignDialog) return;
    assignTarget = target;
    if (target.mode === 'single') {
      if (assignDialogTitle) assignDialogTitle.textContent = 'Reassign Order';
      if (assignDialogDesc) assignDialogDesc.textContent = `Assign order #${target.orderId.slice(-6)} to:`;
      if (assignMemberSelect) assignMemberSelect.value = target.currentEmail || '';
    } else {
      if (assignDialogTitle) assignDialogTitle.textContent = 'Batch Assign Orders';
      if (assignDialogDesc) assignDialogDesc.textContent = `Assign ${target.count} selected orders to:`;
      if (assignMemberSelect) assignMemberSelect.value = '';
    }
    assignDialog.showModal();
  }

  function closeAssign() {
    assignDialog?.close();
    assignTarget = null;
  }
  cancelAssignBtn?.addEventListener('click', closeAssign);
  closeAssignDialog?.addEventListener('click', closeAssign);

  confirmAssignBtn?.addEventListener('click', async () => {
    if (!assignTarget) return;
    const targetEmail = assignMemberSelect?.value?.trim() || null;
    confirmAssignBtn.disabled = true;
    confirmAssignBtn.textContent = 'Assigning...';

    try {
      if (assignTarget.mode === 'single') {
        const res = await fetch(`/api/admin/orders/${assignTarget.orderId}/assign`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ assignedTo: targetEmail }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).__showToast?.(
            targetEmail ? `Reassigned to ${targetEmail}` : 'Order returned to unassigned pool',
            'success'
          );
          closeAssign();
          await clientCache.invalidatePrefix('admin:orders');
          fetchOrders(false);
        } else {
          (window as any).__showToast?.(data.error || 'Failed to reassign order', 'error');
        }
      } else if (assignTarget.mode === 'batch') {
        const res = await fetch('/api/admin/orders/batch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderIds: Array.from(selectedOrderIds),
            action: 'ASSIGN',
            assignedTo: targetEmail,
          }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).__showToast?.(
            `Batch assign completed: ${data.updatedCount} orders updated`,
            'success'
          );
          closeAssign();
          selectedOrderIds.clear();
          updateBatchBar();
          await clientCache.invalidatePrefix('admin:orders');
          fetchOrders(false);
        } else {
          (window as any).__showToast?.(data.error || 'Batch assign failed', 'error');
        }
      }
    } catch (err: any) {
      (window as any).__showToast?.(err.message || 'Network error', 'error');
    } finally {
      if (confirmAssignBtn) {
        confirmAssignBtn.disabled = false;
        confirmAssignBtn.textContent = 'Confirm';
      }
    }
  });

  document.addEventListener('click', async (e) => {
    const claimBtn = (e.target as HTMLElement).closest('.btn-claim-order-row') as HTMLElement | null;
    if (claimBtn) {
      const orderId = claimBtn.getAttribute('data-id');
      if (!orderId) return;
      claimBtn.setAttribute('disabled', 'true');
      claimBtn.textContent = '...';
      try {
        const res = await fetch(`/api/admin/orders/${orderId}/assign`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).__showToast?.('Order claimed successfully', 'success');
          await clientCache.invalidatePrefix('admin:orders');
          fetchOrders(false);
        } else {
          (window as any).__showToast?.(data.error || 'Failed to claim order', 'error');
          claimBtn.removeAttribute('disabled');
          claimBtn.textContent = 'Claim';
        }
      } catch (err: any) {
        (window as any).__showToast?.(err.message || 'Network error', 'error');
        claimBtn.removeAttribute('disabled');
        claimBtn.textContent = 'Claim';
      }
    }

    const reassignBtn = (e.target as HTMLElement).closest('.btn-reassign-order') as HTMLElement | null;
    if (reassignBtn) {
      const orderId = reassignBtn.getAttribute('data-id');
      const current = reassignBtn.getAttribute('data-current') || '';
      if (!orderId) return;
      openAssignDialog({ mode: 'single', orderId, currentEmail: current });
    }
  }, { signal });

  async function executeBatchAction(action: 'APPROVE' | 'REJECT') {
    if (selectedOrderIds.size === 0) return;
    const confirmMsg = action === 'APPROVE'
      ? `Are you sure you want to approve ${selectedOrderIds.size} selected orders?`
      : `Are you sure you want to reject ${selectedOrderIds.size} selected orders?`;
    if (!confirm(confirmMsg)) return;

    try {
      const res = await fetch('/api/admin/orders/batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderIds: Array.from(selectedOrderIds), action }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        (window as any).__showToast?.(`Batch ${action} completed: ${data.updatedCount} orders updated`, 'success');
        selectedOrderIds.clear();
        updateBatchBar();
        await clientCache.invalidatePrefix('admin:orders');
        fetchOrders(false);
      } else {
        (window as any).__showToast?.(data.error || 'Batch operation failed', 'error');
      }
    } catch (err: any) {
      (window as any).__showToast?.(err.message || 'Network error', 'error');
    }
  }

  btnBatchApprove?.addEventListener('click', () => executeBatchAction('APPROVE'));
  btnBatchReject?.addEventListener('click', () => executeBatchAction('REJECT'));

  const btnBatchAssign = document.getElementById('btn-batch-assign');
  btnBatchAssign?.addEventListener('click', () => {
    if (selectedOrderIds.size === 0) return;
    openAssignDialog({ mode: 'batch', count: selectedOrderIds.size });
  });

  // Initial load
  tableSettings.renderMenu();
  const initialUrl = new URL(window.location.href);
  currentStatus = initialUrl.searchParams.get('status') || 'ALL';
  currentSearch = initialUrl.searchParams.get('search') || '';
  currentTimeWindow = initialUrl.searchParams.get('timeWindow') || 'ALL';
  currentAssignedTo = initialUrl.searchParams.get('assignedTo') || '';
  currentPage = Math.max(1, parseInt(initialUrl.searchParams.get('page') || '1', 10));

  const timeSelect = document.getElementById('orders-timewindow-select') as HTMLSelectElement | null;
  if (timeSelect) {
    timeSelect.value = currentTimeWindow;
    timeSelect.addEventListener('change', () => {
      currentTimeWindow = timeSelect.value || 'ALL';
      currentPage = 1;
      fetchOrders();
    });
  }

    fetchOrders(false);
  }

  initOrdersPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('orders-app-meta')) {
      initOrdersPage();
    } else {
      pageAbort?.abort();
      pageAbort = null;
    }
  });
</script>
