{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-sanity-starter",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "SANITY_PROJECT_ID": "xvhhd8u0",
    "SANITY_DATASET": "production",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFXbqPn5Jkh6bMhV",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1,gwenvenni.com",
    "ADMIN_EMAILS": "forhaisome@gmail.com",
    "LOGTO_ENDPOINT": "https://8tvr1q.logto.app/",
    "LOGTO_APP_ID": "btx7meodkblwjce23ulpc"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b",
      "database_id": "ee9bf95f-2f23-4df7-aea4-cb81346473dd"
    }
  ],
  "observability": {
    "enabled": true
  }
}