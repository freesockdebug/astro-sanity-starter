                        ${canAssign ? `<button type="button" class="btn-reassign-order p-0.5 text-zinc-400 hover:text-black cursor-pointer" data-id="${safeId}" data-current="" title="Assign to specific sales rep"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg></button>` : ''}
