---
// src/pages/[...slug].astro
import type { Page } from 'types';
import Layout from '@layouts/Layout.astro';
import { componentMap } from '@components/site';
import { client } from '@utils/sanity-client';
import { PAGE_QUERY_OBJ } from '@data/page';
import { CONFIG_QUERY_OBJ, SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { normalizeSections } from '@data/blocks';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=86400, stale-while-revalidate=604800');

const { slug } = Astro.params;
const formattedSlug = !slug || slug === '/' ? '/' : (slug.startsWith('/') ? slug : `/${slug}`);
const unslashed = formattedSlug.replace(/^\//, '');

// Scheme 2: Single Aggregated GROQ Query - combines 3 independent API calls into 1 single roundtrip
let batchData: any = null;
try {
  batchData = await client.fetch(
    `{
      "page": *[_type == "page" && (slug.current == $formattedSlug || slug.current == $unslashed)][0] ${PAGE_QUERY_OBJ},
      "siteConfig": *[_type == "siteConfig"][0] ${CONFIG_QUERY_OBJ},
      "rfqSettings": *[_type == "rfqSettings"][0]
    }`,
    { formattedSlug, unslashed }
  );
} catch (e) {
  console.error(`Failed to batch-fetch page data for ${slug}:`, e);
}

// Pre-populate service caches so Layout, AppleNav, QuoteDrawer, and sections make 0 additional API requests
if (batchData?.siteConfig) SiteConfigService.seed(batchData.siteConfig);
if (batchData?.rfqSettings) RfqSettingsService.seed(batchData.rfqSettings);

const page: Page = batchData?.page;
if (!page) {
    return new Response("404 Not Found", { status: 404, statusText: "Not Found" });
}

const { title, sections: rawSections, metaTitle, metaDescription, socialImage } = page;
const sections = normalizeSections(rawSections);
---

{
    page && (
        <Layout title={metaTitle ?? title} description={metaDescription} image={socialImage}>
            <Fragment>
                {sections?.length &&
                    sections.map((section: any) => {
                        const Component = componentMap[section._type];
                        return Component ? <Component {...section} /> : null;
                    })}
            </Fragment>
        </Layout>
    )
}
