# ==============================================================================
# B2B Commerce Starter - Environment Variables Template
# ==============================================================================
# NOTE: Brand identity, Support Email, VIP WhatsApp, Turnstile Keys & Hostnames,
# Resend Email & Alerts, Webhook Dispatch, and Edge CDN Cache Purge are now
# dynamically managed via the D1-backed Workspace Settings console (/admin/settings).
#
# Only the core infrastructure bootstrap secrets below are strictly needed in .env:
# ==============================================================================

# Authentication & Root Admin Access (Bootstrap)
SESSION_SECRET=
ADMIN_EMAILS=

# Logto Identity Provider (OIDC & Management API)
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
LOGTO_MANAGEMENT_RESOURCE=

# Sanity Headless CMS (Build-time Static Generation & Content Management)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
SANITY_PREVIEW_DRAFTS=
STACKBIT_PREVIEW=

# ==============================================================================
# Optional Environment Overrides (Also configurable live in /admin/settings)
# ==============================================================================
# APP_URL=https://gwenvenni.com
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# REVALIDATE_SECRET=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
