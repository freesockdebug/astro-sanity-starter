---
// src/components/admin/MediaLibraryModal.astro
// Global Cloud Media Library & Asset Picker Modal for CMS Workbench
---

<div id="media-library-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-[100] hidden opacity-0 transition-opacity duration-200"></div>

<div
  id="media-library-modal"
  class="fixed inset-0 z-[110] hidden items-center justify-center p-3 sm:p-6 overflow-hidden pointer-events-none"
  role="dialog"
  aria-modal="true"
>
  <div class="pointer-events-auto w-full max-w-4xl h-[90vh] max-h-[820px] bg-white rounded-3xl shadow-2xl border border-black/10 flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200">
    <!-- Modal Header -->
    <div class="p-4 sm:px-6 border-b border-black/5 bg-[#fafafc] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-[#1d1d1f] text-white flex items-center justify-center text-sm shadow-2xs">
          📁
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-[#1d1d1f]" id="media-modal-title">Cloud Media Library</h3>
            <span id="media-modal-mode-badge" class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-black/5 text-[#52525b]">
              Single Select
            </span>
          </div>
          <p class="text-[11px] text-[#86868b]">Select high-res assets from Sanity CDN or upload new photos</p>
        </div>
      </div>

      <!-- Tab Switcher -->
      <div class="flex items-center bg-[#f5f5f7] p-1 rounded-xl border border-black/5 text-xs">
        <button
          type="button"
          id="tab-media-browse"
          class="px-3.5 py-1.5 rounded-lg font-semibold transition-all shadow-2xs bg-white text-[#1d1d1f] cursor-pointer"
        >
          🖼️ Cloud Assets
        </button>
        <button
          type="button"
          id="tab-media-upload"
          class="px-3.5 py-1.5 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] transition-all cursor-pointer"
        >
          ⬆️ Upload Local
        </button>
      </div>

      <button
        type="button"
        id="btn-close-media-modal"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#86868b] hover:text-[#1d1d1f] hover:bg-black/5 transition-colors cursor-pointer"
        title="Close modal"
      >
        ✕
      </button>
    </div>

    <!-- Tab 1: Cloud Media Browser -->
    <div id="media-pane-browse" class="flex-1 min-h-0 flex flex-col overflow-hidden">
      <!-- Toolbar: Search & Refresh -->
      <div class="p-3 sm:px-6 border-b border-black/5 bg-white flex items-center justify-between gap-3 shrink-0">
        <div class="relative flex-1 max-w-md">
          <svg class="w-4 h-4 text-[#86868b] absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="media-search-input"
            placeholder="Search assets by filename..."
            class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-[#f5f5f7] border border-black/5 focus:outline-none focus:border-black focus:bg-white transition-all"
          />
        </div>

        <div class="flex items-center gap-2">
          <span id="media-count-label" class="text-[11px] text-[#86868b] mr-1">Loading assets...</span>

          <!-- Pagination Controls -->
          <div class="flex items-center gap-1 bg-[#f5f5f7] p-0.5 rounded-lg border border-black/5">
            <button
              type="button"
              id="btn-media-prev"
              disabled
              class="h-6 px-2 rounded-md text-[11px] font-medium text-[#1d1d1f] hover:bg-white disabled:opacity-40 disabled:hover:bg-transparent disabled:cursor-not-allowed transition-all cursor-pointer"
              title="Previous page"
            >
              ◀ Prev
            </button>
            <span id="media-page-label" class="px-2 text-[11px] font-mono text-[#52525b]">
              Page 1 / 1
            </span>
            <button
              type="button"
              id="btn-media-next"
              disabled
              class="h-6 px-2 rounded-md text-[11px] font-medium text-[#1d1d1f] hover:bg-white disabled:opacity-40 disabled:hover:bg-transparent disabled:cursor-not-allowed transition-all cursor-pointer"
              title="Next page"
            >
              Next ▶
            </button>
          </div>

          <button
            type="button"
            id="btn-refresh-media"
            class="h-7 px-2.5 rounded-lg text-xs font-medium text-[#52525b] bg-[#f5f5f7] hover:bg-black/5 border border-black/5 flex items-center gap-1 cursor-pointer"
            title="Refresh asset list"
          >
            <span>🔄 Refresh</span>
          </button>
        </div>
      </div>

      <!-- Assets Grid Container: Outer scroll container + inner grid container -->
      <div id="media-grid-scroll" class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-6 bg-[#fcfcfd]">
        <div id="media-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3.5 items-start">
          <!-- Skeleton loaders or items rendered via JS -->
        </div>
      </div>
    </div>

    <!-- Tab 2: Upload Local File -->
    <div id="media-pane-upload" class="hidden flex-1 min-h-0 p-6 flex flex-col items-center justify-center bg-[#fafafc]">
      <div
        id="media-dropzone"
        class="w-full max-w-lg p-8 sm:p-12 rounded-3xl border-2 border-dashed border-black/20 hover:border-black bg-white flex flex-col items-center justify-center text-center transition-all cursor-pointer shadow-xs"
      >
        <div class="w-16 h-16 rounded-2xl bg-[#f5f5f7] flex items-center justify-center text-2xl mb-4 shadow-inner">
          📸
        </div>
        <h4 class="text-sm font-bold text-[#1d1d1f] mb-1">Drag and drop images here</h4>
        <p class="text-xs text-[#86868b] mb-4">Supports high-res JPG, PNG, WEBP up to 50MB</p>
        <label
          for="media-file-input"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs cursor-pointer"
        >
          Browse Local Files
        </label>
        <input
          type="file"
          id="media-file-input"
          accept="image/jpeg,image/png,image/webp,image/svg+xml"
          class="hidden"
          multiple
        />
        <div id="media-upload-status" class="mt-4 text-xs font-medium text-[#1d1d1f] hidden"></div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-3 sm:px-6 border-t border-black/5 bg-[#fafafc] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <span id="media-selection-info" class="text-xs font-medium text-[#52525b]">
          No image selected
        </span>
        <button
          type="button"
          id="btn-media-clear"
          class="text-xs text-rose-600 hover:underline hidden cursor-pointer"
        >
          Clear
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-cancel-media"
          class="h-8 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] hover:bg-black/5 transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="btn-confirm-media"
          disabled
          class="h-8 px-5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-2xs cursor-pointer"
        >
          Insert Selected (0)
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { escapeHtml } from '@utils/adminWorkbench';
  import { SanityImageService, type ImageOptimizationOptions } from '@utils/image';

  /**
   * Universal Sanity Ref URL resolver (0-request instant preview).
   * Transforms `image-hash-1600x1200-webp` into permanent CDN URL,
   * respecting edge image proxy settings (/cdn-image) and optimization options.
   */
  export function resolveSanityRefUrl(
    imgObj: any,
    options?: ImageOptimizationOptions,
    projectId = 'xvhhd8u0',
    dataset = 'production'
  ): string {
    if (!imgObj) return '';
    let rawUrl = '';
    if (typeof imgObj === 'string') {
      const trimmed = imgObj.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://') || trimmed.startsWith('/')) {
        rawUrl = trimmed;
      } else {
        const match = trimmed.match(/^image-([a-f0-9]+)-([0-9]+x[0-9]+)-([a-z0-9]+)$/);
        if (match) {
          rawUrl = `https://cdn.sanity.io/images/${projectId}/${dataset}/${match[1]}-${match[2]}.${match[3]}`;
        } else {
          rawUrl = trimmed;
        }
      }
    } else if (typeof imgObj === 'object') {
      if (imgObj.url && typeof imgObj.url === 'string') {
        rawUrl = imgObj.url;
      } else if (imgObj.src && typeof imgObj.src === 'string') {
        rawUrl = imgObj.src;
      } else {
        const ref = imgObj.asset?._ref || imgObj._ref;
        if (typeof ref === 'string') {
          const match = ref.match(/^image-([a-f0-9]+)-([0-9]+x[0-9]+)-([a-z0-9]+)$/);
          if (match) {
            rawUrl = `https://cdn.sanity.io/images/${projectId}/${dataset}/${match[1]}-${match[2]}.${match[3]}`;
          }
        }
      }
    }

    if (!rawUrl) return '';

    if (options) {
      return SanityImageService.optimize(rawUrl, options);
    }
    return SanityImageService.toEdgeUrl(rawUrl);
  }

  // Register globally for window access
  (window as any).resolveSanityRefUrl = resolveSanityRefUrl;

  interface MediaAsset {
    _id: string;
    url: string;
    originalFilename?: string;
    width?: number;
    height?: number;
    size?: number;
    mimeType?: string;
    _createdAt?: string;
  }

  interface OpenMediaOptions {
    mode?: 'single' | 'multiple';
    title?: string;
    selectedIds?: string[];
    onSelect: (selectedAssets: MediaAsset[]) => void;
  }

  const PAGE_SIZE = 40;
  let mediaAssets: MediaAsset[] = [];
  let totalAssets = 0;
  let currentPage = 1;
  let pendingSelectedIds: string[] = [];
  let currentSelection: Map<string, MediaAsset> = new Map();
  let currentOptions: OpenMediaOptions | null = null;
  let isLoading = false;
  let searchDebounceTimer: any = null;

  function ensureSingleMediaModalPortal() {
    let canonicalBackdrop = document.querySelector('body > #media-library-backdrop');
    let canonicalModal = document.querySelector('body > #media-library-modal');

    if (!canonicalBackdrop) {
      const anyBackdrop = document.getElementById('media-library-backdrop');
      if (anyBackdrop) {
        document.body.appendChild(anyBackdrop);
        canonicalBackdrop = anyBackdrop;
      }
    }
    if (!canonicalModal) {
      const anyModal = document.getElementById('media-library-modal');
      if (anyModal) {
        document.body.appendChild(anyModal);
        canonicalModal = anyModal;
      }
    }

    // Prune all redundant duplicates inside #shell-main-canvas or other containers
    document.querySelectorAll('#media-library-backdrop').forEach((el) => {
      if (el !== canonicalBackdrop) el.remove();
    });
    document.querySelectorAll('#media-library-modal').forEach((el) => {
      if (el !== canonicalModal) el.remove();
    });
  }

  ensureSingleMediaModalPortal();
  document.addEventListener('shell:page-load', ensureSingleMediaModalPortal);

  const backdrop = document.getElementById('media-library-backdrop');
  const modal = document.getElementById('media-library-modal');
  const modalContent = modal?.querySelector('div');
  const modalTitle = document.getElementById('media-modal-title');
  const modeBadge = document.getElementById('media-modal-mode-badge');
  const searchInput = document.getElementById('media-search-input') as HTMLInputElement | null;
  const countLabel = document.getElementById('media-count-label');
  const pageLabel = document.getElementById('media-page-label');
  const btnPrev = document.getElementById('btn-media-prev') as HTMLButtonElement | null;
  const btnNext = document.getElementById('btn-media-next') as HTMLButtonElement | null;
  const mediaGridScroll = document.getElementById('media-grid-scroll');
  const mediaGrid = document.getElementById('media-grid');
  const selectionInfo = document.getElementById('media-selection-info');
  const btnClear = document.getElementById('btn-media-clear');
  const btnConfirm = document.getElementById('btn-confirm-media') as HTMLButtonElement | null;
  const tabBrowse = document.getElementById('tab-media-browse');
  const tabUpload = document.getElementById('tab-media-upload');
  const paneBrowse = document.getElementById('media-pane-browse');
  const paneUpload = document.getElementById('media-pane-upload');
  const fileInput = document.getElementById('media-file-input') as HTMLInputElement | null;
  const dropzone = document.getElementById('media-dropzone');
  const uploadStatus = document.getElementById('media-upload-status');

  function switchTab(tab: 'browse' | 'upload') {
    if (tab === 'browse') {
      tabBrowse?.classList.add('bg-white', 'text-[#1d1d1f]', 'shadow-2xs', 'font-semibold');
      tabBrowse?.classList.remove('text-[#52525b]', 'font-medium');
      tabUpload?.classList.remove('bg-white', 'text-[#1d1d1f]', 'shadow-2xs', 'font-semibold');
      tabUpload?.classList.add('text-[#52525b]', 'font-medium');
      paneBrowse?.classList.remove('hidden');
      paneUpload?.classList.add('hidden');
    } else {
      tabUpload?.classList.add('bg-white', 'text-[#1d1d1f]', 'shadow-2xs', 'font-semibold');
      tabUpload?.classList.remove('text-[#52525b]', 'font-medium');
      tabBrowse?.classList.remove('bg-white', 'text-[#1d1d1f]', 'shadow-2xs', 'font-semibold');
      tabBrowse?.classList.add('text-[#52525b]', 'font-medium');
      paneUpload?.classList.remove('hidden');
      paneBrowse?.classList.add('hidden');
    }
  }

  tabBrowse?.addEventListener('click', () => switchTab('browse'));
  tabUpload?.addEventListener('click', () => switchTab('upload'));

  function formatBytes(bytes?: number): string {
    if (!bytes || isNaN(bytes)) return '';
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function updatePaginationControls() {
    const totalPages = Math.max(1, Math.ceil(totalAssets / PAGE_SIZE));
    if (pageLabel) {
      pageLabel.textContent = `Page ${currentPage} / ${totalPages}`;
    }
    if (btnPrev) {
      btnPrev.disabled = isLoading || currentPage <= 1;
    }
    if (btnNext) {
      btnNext.disabled = isLoading || currentPage >= totalPages;
    }
    if (countLabel && !isLoading) {
      if (totalAssets === 0) {
        countLabel.textContent = '0 assets';
      } else {
        const start = (currentPage - 1) * PAGE_SIZE + 1;
        const end = Math.min(currentPage * PAGE_SIZE, totalAssets);
        countLabel.textContent = `${start}–${end} of ${totalAssets} assets`;
      }
    }
  }

  function updateFooterSelection() {
    const count = currentSelection.size;
    if (count === 0) {
      if (selectionInfo) selectionInfo.textContent = 'No image selected';
      btnClear?.classList.add('hidden');
      if (btnConfirm) {
        btnConfirm.disabled = true;
        btnConfirm.textContent = 'Insert Selected (0)';
      }
    } else {
      const mode = currentOptions?.mode || 'single';
      if (selectionInfo) {
        selectionInfo.textContent = mode === 'single'
          ? `Selected: 1 image`
          : `Selected: ${count} images`;
      }
      btnClear?.classList.remove('hidden');
      if (btnConfirm) {
        btnConfirm.disabled = false;
        btnConfirm.textContent = `Insert Selected (${count})`;
      }
    }
  }

  function updateGridSelectionDom() {
    if (!mediaGrid) return;
    const isMultiple = currentOptions?.mode === 'multiple';

    mediaGrid.querySelectorAll('.media-card').forEach((card) => {
      const id = card.getAttribute('data-id');
      if (!id) return;
      const isSelected = currentSelection.has(id);
      const badge = card.querySelector('.media-card-badge');

      if (isSelected) {
        card.classList.add('border-[#1d1d1f]', 'ring-2', 'ring-black', 'ring-offset-1', 'shadow-md');
        card.classList.remove('border-black/10', 'hover:border-black/30', 'hover:shadow-xs');
        if (badge) {
          badge.classList.add('bg-[#1d1d1f]', 'text-white', 'shadow-md');
          badge.classList.remove('bg-black/30', 'text-white/70', 'group-hover:bg-black/50');
          badge.textContent = '✓';
        }
      } else {
        card.classList.remove('border-[#1d1d1f]', 'ring-2', 'ring-black', 'ring-offset-1', 'shadow-md');
        card.classList.add('border-black/10', 'hover:border-black/30', 'hover:shadow-xs');
        if (badge) {
          badge.classList.remove('bg-[#1d1d1f]', 'text-white', 'shadow-md');
          badge.classList.add('bg-black/30', 'text-white/70', 'group-hover:bg-black/50');
          badge.textContent = isMultiple ? '＋' : '';
        }
      }
    });
  }

  function renderGrid() {
    if (!mediaGrid) return;

    if (isLoading) {
      mediaGrid.innerHTML = Array.from({ length: 10 }).map(() => `
        <div class="aspect-square rounded-2xl bg-[#f0f0f2] animate-pulse"></div>
      `).join('');
      return;
    }

    if (mediaAssets.length === 0) {
      mediaGrid.innerHTML = `
        <div class="col-span-full py-16 text-center text-[#86868b] space-y-2">
          <div class="text-3xl">🖼️</div>
          <p class="text-xs font-semibold text-[#1d1d1f]">No images found in cloud library</p>
          <p class="text-[11px]">Upload photos using the "Upload Local" tab or adjust your search.</p>
        </div>
      `;
      return;
    }

    const isMultiple = currentOptions?.mode === 'multiple';

    mediaGrid.innerHTML = mediaAssets.map((asset) => {
      const isSelected = currentSelection.has(asset._id);
      const res = asset.width && asset.height ? `${asset.width}×${asset.height}` : '';
      const sizeStr = formatBytes(asset.size);
      const filename = asset.originalFilename || asset._id.replace(/^image-/, '');

      return `
        <div
          class="media-card group relative rounded-2xl overflow-hidden border transition-all cursor-pointer bg-white flex flex-col ${
            isSelected
              ? 'border-[#1d1d1f] ring-2 ring-black ring-offset-1 shadow-md'
              : 'border-black/10 hover:border-black/30 hover:shadow-xs'
          }"
          style="content-visibility: auto; contain-intrinsic-size: 200px;"
          data-id="${escapeHtml(asset._id)}"
        >
          <!-- Image Thumbnail (aspect-square on container, absolute inset-0 img) -->
          <div class="aspect-square w-full relative overflow-hidden bg-[#f5f5f7] shrink-0">
            <img
              src="${escapeHtml(resolveSanityRefUrl(asset.url, { width: 360 }))}"
              alt="${escapeHtml(filename)}"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            
            <!-- Selection Badge -->
            <div class="media-card-badge absolute top-2 right-2 w-6 h-6 rounded-full flex items-center justify-center transition-all ${
              isSelected
                ? 'bg-[#1d1d1f] text-white shadow-md'
                : 'bg-black/30 text-white/70 group-hover:bg-black/50'
            }">
              ${isSelected ? '✓' : (isMultiple ? '＋' : '')}
            </div>

            <!-- Resolution & Size Pill -->
            ${res || sizeStr ? `
              <div class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-white text-[9px] font-mono leading-tight">
                ${res ? res : ''}${res && sizeStr ? ' · ' : ''}${sizeStr}
              </div>
            ` : ''}
          </div>

          <!-- Filename Footer -->
          <div class="p-2 border-t border-black/5 bg-white shrink-0">
            <p class="text-[10px] font-medium text-[#1d1d1f] truncate" title="${escapeHtml(filename)}">
              ${escapeHtml(filename)}
            </p>
          </div>
        </div>
      `;
    }).join('');

    // Attach click events
    mediaGrid.querySelectorAll('.media-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        if (!id) return;
        const asset = mediaAssets.find((a) => a._id === id);
        if (!asset) return;

        const isMultiple = currentOptions?.mode === 'multiple';
        if (isMultiple) {
          if (currentSelection.has(id)) {
            currentSelection.delete(id);
          } else {
            currentSelection.set(id, asset);
          }
        } else {
          currentSelection.clear();
          currentSelection.set(id, asset);
        }
        updateGridSelectionDom();
        updateFooterSelection();
      });

      // Double-click to instantly insert in single mode
      card.addEventListener('dblclick', () => {
        if (currentOptions?.mode !== 'multiple') {
          const id = card.getAttribute('data-id');
          const asset = mediaAssets.find((a) => a._id === id);
          if (asset && currentOptions?.onSelect) {
            currentOptions.onSelect([asset]);
            closeMediaModal();
          }
        }
      });
    });
  }

  async function fetchAssets(query = '', page = 1) {
    isLoading = true;
    currentPage = Math.max(1, page);
    updatePaginationControls();
    renderGrid();
    if (countLabel) countLabel.textContent = 'Loading...';

    try {
      const offset = (currentPage - 1) * PAGE_SIZE;
      const qParam = query.trim() ? `&q=${encodeURIComponent(query.trim())}` : '';
      const res = await fetch(`/api/admin/cms/upload?offset=${offset}&limit=${PAGE_SIZE}${qParam}`);
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to fetch assets');

      mediaAssets = data.assets || [];
      totalAssets = typeof data.total === 'number' ? data.total : mediaAssets.length;

      // Restore pre-selected assets if selectedIds were passed on modal open
      if (pendingSelectedIds.length > 0) {
        pendingSelectedIds.forEach((id) => {
          const found = mediaAssets.find((a) => a._id === id);
          if (found) currentSelection.set(id, found);
        });
      }
    } catch (e: any) {
      if (countLabel) countLabel.textContent = 'Failed to load';
      (window as any).__showToast?.(e.message, 'error');
      mediaAssets = [];
      totalAssets = 0;
    } finally {
      isLoading = false;
      updatePaginationControls();
      renderGrid();
      updateFooterSelection();
      if (mediaGridScroll) {
        mediaGridScroll.scrollTop = 0;
      }
    }
  }

  btnPrev?.addEventListener('click', () => {
    if (currentPage > 1 && !isLoading) {
      fetchAssets(searchInput?.value || '', currentPage - 1);
    }
  });

  btnNext?.addEventListener('click', () => {
    const totalPages = Math.max(1, Math.ceil(totalAssets / PAGE_SIZE));
    if (currentPage < totalPages && !isLoading) {
      fetchAssets(searchInput?.value || '', currentPage + 1);
    }
  });

  // Search input handler
  searchInput?.addEventListener('input', (e: any) => {
    clearTimeout(searchDebounceTimer);
    const val = e.target.value;
    searchDebounceTimer = setTimeout(() => {
      fetchAssets(val, 1);
    }, 300);
  });

  document.getElementById('btn-refresh-media')?.addEventListener('click', () => {
    fetchAssets(searchInput?.value || '', currentPage);
  });

  btnClear?.addEventListener('click', () => {
    currentSelection.clear();
    updateGridSelectionDom();
    updateFooterSelection();
  });

  function closeMediaModal() {
    modalContent?.classList.add('scale-95', 'opacity-0');
    backdrop?.classList.add('opacity-0');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      backdrop?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      currentOptions = null;
      currentSelection.clear();
    }, 200);
  }

  document.getElementById('btn-close-media-modal')?.addEventListener('click', closeMediaModal);
  document.getElementById('btn-cancel-media')?.addEventListener('click', closeMediaModal);
  backdrop?.addEventListener('click', closeMediaModal);

  btnConfirm?.addEventListener('click', () => {
    if (currentSelection.size > 0 && currentOptions?.onSelect) {
      const selected = Array.from(currentSelection.values());
      currentOptions.onSelect(selected);
      closeMediaModal();
    }
  });

  // Local Upload Handling
  async function handleFilesUpload(files: FileList | File[]) {
    if (!files || files.length === 0) return;
    if (uploadStatus) {
      uploadStatus.classList.remove('hidden');
      uploadStatus.textContent = `Uploading ${files.length} file(s) to Sanity CDN...`;
    }

    let uploadedCount = 0;
    const newAssets: MediaAsset[] = [];

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      const fd = new FormData();
      fd.append('file', file);

      try {
        const res = await fetch('/api/admin/cms/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok && data.success) {
          uploadedCount++;
          const assetObj: MediaAsset = {
            _id: data.id || data.asset?.asset?._ref,
            url: data.url,
            originalFilename: data.originalFilename || file.name,
            width: data.width,
            height: data.height,
            size: data.size || file.size,
          };
          newAssets.push(assetObj);
        }
      } catch (err: any) {
        console.error('File upload error:', err);
      }
    }

    if (uploadStatus) {
      uploadStatus.textContent = `Uploaded ${uploadedCount} file(s) successfully!`;
      setTimeout(() => uploadStatus.classList.add('hidden'), 2000);
    }

    (window as any).__showToast?.(`Uploaded ${uploadedCount} image(s) to cloud library`, 'success');

    if (newAssets.length > 0) {
      totalAssets += newAssets.length;
      // Prepend newly uploaded assets to current page, capped to PAGE_SIZE
      mediaAssets = [...newAssets, ...mediaAssets].slice(0, PAGE_SIZE);

      // Auto-select newly uploaded in currentSelection
      if (currentOptions?.mode === 'multiple') {
        newAssets.forEach((a) => currentSelection.set(a._id, a));
      } else {
        currentSelection.clear();
        currentSelection.set(newAssets[0]._id, newAssets[0]);
      }

      updatePaginationControls();
    }

    // Switch to Browse tab
    switchTab('browse');
    renderGrid();
    updateFooterSelection();
  }

  fileInput?.addEventListener('change', (e: any) => {
    handleFilesUpload(e.target.files);
    e.target.value = '';
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-black', 'bg-[#f5f5f7]');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-black', 'bg-[#f5f5f7]');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-black', 'bg-[#f5f5f7]');
    if (e.dataTransfer?.files) {
      handleFilesUpload(e.dataTransfer.files);
    }
  });

  /**
   * Global function to open Cloud Media Library modal
   */
  (window as any).__openMediaLibrary = function(options: OpenMediaOptions) {
    ensureSingleMediaModalPortal();
    currentOptions = options;
    currentSelection.clear();

    const mode = options.mode || 'single';
    if (modeBadge) {
      modeBadge.textContent = mode === 'single' ? 'Single Select' : 'Multiple Select';
    }
    if (modalTitle) {
      modalTitle.textContent = options.title || 'Cloud Media Library';
    }

    // Track requested pre-selections
    pendingSelectedIds = Array.isArray(options.selectedIds) ? options.selectedIds : [];
    if (pendingSelectedIds.length > 0 && mediaAssets.length > 0) {
      pendingSelectedIds.forEach((id) => {
        const found = mediaAssets.find((a) => a._id === id);
        if (found) currentSelection.set(id, found);
      });
    }

    updateFooterSelection();
    switchTab('browse');

    // Show modal
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    backdrop?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');

    requestAnimationFrame(() => {
      backdrop?.classList.remove('opacity-0');
      modalContent?.classList.remove('scale-95', 'opacity-0');
    });

    if (mediaAssets.length === 0) {
      fetchAssets();
    } else {
      renderGrid();
    }
  };
</script>

