---
import { type SiteConfig, type CustomImage, type Page } from 'types';
import { AppleNav, AppleFooter, QuoteDrawer, WhatsAppWidget, SEO } from '@components';
import SectionBoundary from '@components/SectionBoundary.astro';
import { fetchData } from '@data/siteConfig';
import { SanityImageService } from '@utils/image';
import { getHreflangAlternates, getLangFromUrl, getLocalizedValue, useTranslations } from '@i18n';
import type { TwitterCardType } from 'astro-seo';

import '../styles/globals.css';

interface Props {
    title?: string;
    addTitleSuffix?: boolean;
    description?: string;
    image?: CustomImage | string;
    canonicalUrl?: string | URL;
    type?: 'website' | 'article' | 'product';
    twitterCard?: TwitterCardType;
    noindex?: boolean;
    nofollow?: boolean;
    page?: Partial<Page>;
    structuredData?: Record<string, any> | Record<string, any>[];
    bodyClass?: string;
    mainClass?: string;
    preloadHeroImage?: boolean | { src: string; srcset?: string; sizes?: string };
    bare?: boolean;
}

const {
    title,
    addTitleSuffix,
    description,
    image,
    canonicalUrl,
    type,
    twitterCard,
    noindex,
    nofollow,
    page,
    structuredData,
    bodyClass,
    mainClass,
    preloadHeroImage,
    bare = false,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const hreflangAlternates = getHreflangAlternates(Astro.url, Astro.site);
const configData: SiteConfig = bare ? ({} as SiteConfig) : ((await fetchData()) || {});
if (!bare) {
    SanityImageService.setStudioProxyConfig(configData?.enableImageProxy);
}

const rawImage = image ?? page?.socialImage;
const rawImageSrc = typeof rawImage === 'string' ? rawImage : rawImage?.src;
const imageSrc = rawImageSrc ? SanityImageService.hero(rawImageSrc, 1200) : undefined;
const resolvedImage = imageSrc
    ? { src: imageSrc.startsWith('http') || imageSrc.startsWith('/') ? imageSrc : new URL(imageSrc, Astro.site || Astro.url).toString() }
    : undefined;
---

<!doctype html>
<html lang={currentLang} data-theme="light" class="scroll-smooth">
    <head>
        <!-- High Priority Global Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <!-- Reusable Sanity & Astro SEO Component (Title, Canonical, OpenGraph, Twitter Cards) -->
        <SEO
            title={title}
            addTitleSuffix={addTitleSuffix}
            description={description}
            image={image}
            canonicalUrl={canonicalUrl}
            type={type}
            twitterCard={twitterCard}
            noindex={noindex || bare}
            nofollow={nofollow || bare}
            page={page}
            siteConfig={configData}
            structuredData={structuredData}
        />

        <!-- Automatic Google SEO Multilingual Hreflang Interlinking Tags (en, de, fr, es + x-default) -->
        {hreflangAlternates.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}

        <!-- High-priority Responsive LCP Image Preload (Avoids downloading mismatched 1200px on mobile) -->
        {preloadHeroImage && (
            typeof preloadHeroImage === 'object' ? (
                <link
                    rel="preload"
                    as="image"
                    href={preloadHeroImage.src}
                    imagesrcset={preloadHeroImage.srcset}
                    imagesizes={preloadHeroImage.sizes}
                    fetchpriority="high"
                />
            ) : (
                resolvedImage?.src && (
                    <link rel="preload" as="image" href={resolvedImage.src} fetchpriority="high" />
                )
            )
        )}

        <!-- Low Priority Global Metadata -->
        <link rel="icon" type="image/svg+xml" href={configData?.favicon?.src || "/favicon.svg"} />
        <link rel="alternate icon" href="/favicon.ico" />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body class={bodyClass || "bg-white text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white"}>
        {!bare && (
            <SectionBoundary sectionName="AppleNav">
                <AppleNav config={configData} />
            </SectionBoundary>
        )}
        <main class={mainClass}>
            <slot />
        </main>
        {!bare && (
            <SectionBoundary sectionName="AppleFooter">
                <AppleFooter config={configData} />
            </SectionBoundary>
        )}
        {!bare && (
            <SectionBoundary sectionName="QuoteDrawer">
                <QuoteDrawer />
            </SectionBoundary>
        )}

        <!-- 1. WhatsApp Instant Live Chat Widget (Controlled from Sanity Studio) -->
        {!bare && configData?.enableWhatsApp && configData?.whatsAppNumber && (
            <SectionBoundary sectionName="WhatsAppWidget">
                <WhatsAppWidget
                    phoneNumber={configData.whatsAppNumber}
                    prefillText={getLocalizedValue(configData.whatsAppPrefillText, currentLang, t('whatsapp.prefill'))}
                    tooltip={getLocalizedValue(configData.whatsAppTooltip, currentLang, t('whatsapp.tooltip'))}
                />
            </SectionBoundary>
        )}

        <!-- 2. Idle + Viewport Shimmer Hook: Pooled IntersectionObserver with idle scheduling -->
        <script>
            import { useIntersectionShimmer } from '@utils/useIntersectionShimmer';

            const shimmerController = useIntersectionShimmer(
                '.apple-skeleton, .apple-skeleton-warm, .apple-skeleton-surface, .apple-shimmer-wave',
                { rootMargin: '160px 160px', deferUntilIdle: true }
            );

            // Expose global handles for inline onload triggers, dynamic components & define:vars scripts
            const win = window as any;
            win.__shimmerController = shimmerController;
            win.__observeAppleShimmer = (target?: any, scope?: ParentNode) => shimmerController.observe(target || document, scope);
            win.__unobserveAppleShimmer = (el?: any) => shimmerController.unobserve(el);
        </script>

        <!-- 3. Client-side Global Runtime Resilience Boundary -->
        <div id="global-runtime-fallback" role="alert" class="fixed bottom-4 right-4 z-50 hidden max-w-sm bg-white border border-black/10 rounded-2xl shadow-lg p-4 text-xs">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1 min-w-0 flex-1">
              <p class="font-semibold text-[#1d1d1f]">Interactive script encountered an error</p>
              <p id="global-runtime-msg" class="text-[11px] text-[#86868b] line-clamp-2 break-all"></p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" onclick="location.reload()" class="px-2.5 py-1 rounded-full bg-[#1d1d1f] text-white text-[11px] font-medium hover:bg-black transition-colors cursor-pointer">
                Reload
              </button>
              <button type="button" aria-label="Dismiss" onclick="document.getElementById('global-runtime-fallback')?.classList.add('hidden')" class="w-6 h-6 rounded-full bg-[#f5f5f7] text-[#52525b] hover:text-black flex items-center justify-center cursor-pointer">
                ✕
              </button>
            </div>
          </div>
        </div>

        <script is:inline>
          (function () {
            function handleRuntimeError(message, source) {
              var msgStr = String(message || '');
              if (!msgStr || msgStr.includes('ResizeObserver') || msgStr === 'Script error.') return;
              if (source && !String(source).startsWith(location.origin) && !String(source).startsWith('/')) return;
              console.warn('[ClientBoundary] Caught runtime exception:', msgStr, source);
              var box = document.getElementById('global-runtime-fallback');
              var textEl = document.getElementById('global-runtime-msg');
              if (textEl) textEl.textContent = msgStr;
              if (box) box.classList.remove('hidden');
            }

            window.addEventListener('error', function (event) {
              if (!event.error && !event.message) return;
              handleRuntimeError(event.message || (event.error && event.error.message), event.filename);
            });

            window.addEventListener('unhandledrejection', function (event) {
              var reason = event.reason && (event.reason.message || String(event.reason));
              handleRuntimeError(reason, location.pathname);
            });
          })();
        </script>
    </body>
</html>
