  "ribbed-cashmere-crew": {
    slug: "ribbed-cashmere-crew",
    title: "200N Ribbed Cashmere-Silk Crew",
    tagline: "Ultra-Fine 15.2µm Mongolian Cashmere & Grade 6A Mulberry Silk",
