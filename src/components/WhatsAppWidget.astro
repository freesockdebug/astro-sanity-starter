---
// src/components/WhatsAppWidget.astro
interface Props {
  phoneNumber?: string;
  prefillText?: string;
  tooltip?: string;
}

const {
  phoneNumber = "",
  prefillText = "Hello Gwenvenni, I'm interested in your private-label knitwear collection.",
  tooltip = "Chat with B2B Specialist"
} = Astro.props;

// Strip all non-numeric characters for WhatsApp international URL standard (e.g. "+86 138-0000" -> "861380000")
const safePhone = typeof phoneNumber === 'string' ? phoneNumber : (phoneNumber ? String(phoneNumber) : "");
const cleanPhone = safePhone.replace(/\D/g, "");
const chatUrl = cleanPhone 
  ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent(prefillText)}`
  : "#";
---

{cleanPhone && (
  <aside 
    id="whatsapp-chat-widget" 
    class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] left-[max(1.25rem,env(safe-area-inset-left))] sm:bottom-6 sm:left-6 z-40 group select-none"
    aria-label="WhatsApp Instant Communication"
  >
    <a
      href={chatUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex items-center justify-center w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-[#25D366] text-white shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#25D366]/40"
      aria-label={tooltip}
    >
      <!-- Subtle Pulsing Live Ping Dot -->
      <span class="absolute -top-0.5 -right-0.5 flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-600 border-2 border-white"></span>
      </span>

      <!-- Official WhatsApp Clean Vector Glyph -->
      <svg 
        class="w-6 h-6 sm:w-7 sm:h-7 fill-current" 
        viewBox="0 0 24 24" 
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 012.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 01-1.25-4.38c0-4.54 3.7-8.24 8.25-8.24zm4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.02 2.59.12.17 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
      </svg>
    </a>

    <!-- Elegant Floating Tooltip Label (Desktop Hover) -->
    <div class="pointer-events-none absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 rounded-full bg-[#1d1d1f]/90 backdrop-blur-md text-white text-xs font-medium shadow-md opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 whitespace-nowrap hidden sm:flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
      <span>{tooltip}</span>
    </div>
  </aside>
)}
