---
// src/pages/admin/settings.astro
// Unified Dynamic Configuration Center: D1-backed Settings & Platform Infrastructure Health
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext, getRuntimeEnv } from '@utils/auth';
import { DEFAULT_CARRIERS, QUICK_REPLY_TEMPLATES } from '@utils/shipping';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings: settings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/settings',
  { requiredMenu: 'settings' }
);
if (redirectResponse) return redirectResponse;

const rootAdminEmails = getRuntimeEnv('ADMIN_EMAILS', cfEnv) || '';
const hasLogtoOidc = !!(getRuntimeEnv('LOGTO_APP_ID', cfEnv) && getRuntimeEnv('LOGTO_ENDPOINT', cfEnv));
const hasLogtoM2m = !!(getRuntimeEnv('LOGTO_M2M_APP_ID', cfEnv) && getRuntimeEnv('LOGTO_M2M_APP_SECRET', cfEnv));
const hasTurnstile = !!(getRuntimeEnv('TURNSTILE_SECRET_KEY', cfEnv) || getRuntimeEnv('PUBLIC_TURNSTILE_SITE_KEY', cfEnv) || getRuntimeEnv('TURNSTILE_SITE_KEY', cfEnv));
const hasResend = !!getRuntimeEnv('RESEND_API_KEY', cfEnv);
const hasSanity = !!((getRuntimeEnv('SANITY_TOKEN', cfEnv) || getRuntimeEnv('SANITY_API_TOKEN', cfEnv)) && getRuntimeEnv('SANITY_PROJECT_ID', cfEnv));

const pageTitle = 'Workspace Settings';
---

<AdminLayout
  title={pageTitle}
  currentTab="settings"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
>
  <!-- Page Header -->
  <AdminPageToolbar
    title="Workspace Settings"
    subtitle="Dynamic runtime configurations for brand identity, buyer concierge, RFQ dispatch rules, and access control."
    badge="Live D1 Sync"
    badgeColor="emerald"
    class="mb-5"
  >
    <div slot="actions" class="flex items-center gap-2.5">
      <button
        id="save-settings-btn-top"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Save Changes</span>
      </button>
    </div>
  </AdminPageToolbar>

  <!-- Infrastructure Health Status Grid -->
  <div class="mb-6 p-4 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f]">Platform Infrastructure Health</span>
        <span class="text-[10px] text-[#86868b]">Read-only status probes</span>
      </div>
      <div class="text-[11px] font-mono text-[#86868b] truncate max-w-xs" title={`Root Admin: ${rootAdminEmails}`}>
        Root Admin: <strong class="text-[#1d1d1f] font-semibold">{rootAdminEmails ? rootAdminEmails.split(',')[0] : 'Unset'}</strong>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 pt-1 text-xs">
      <!-- D1 -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">D1 Database</span>
        <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-md border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
        </span>
      </div>

      <!-- Logto OIDC -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">Logto OIDC</span>
        <span class:list={[
          'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
          hasLogtoOidc ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-amber-700 bg-amber-50 border-amber-200'
        ]}>
          <span class:list={['w-1.5 h-1.5 rounded-full', hasLogtoOidc ? 'bg-emerald-500' : 'bg-amber-500']}></span>
          {hasLogtoOidc ? 'Configured' : 'Missing'}
        </span>
      </div>

      <!-- Logto M2M -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">Logto M2M</span>
        <span class:list={[
          'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
          hasLogtoM2m ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-amber-700 bg-amber-50 border-amber-200'
        ]}>
          <span class:list={['w-1.5 h-1.5 rounded-full', hasLogtoM2m ? 'bg-emerald-500' : 'bg-amber-500']}></span>
          {hasLogtoM2m ? 'Configured' : 'Optional'}
        </span>
      </div>

      <!-- Turnstile -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">Turnstile</span>
        <span class:list={[
          'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
          hasTurnstile ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-amber-700 bg-amber-50 border-amber-200'
        ]}>
          <span class:list={['w-1.5 h-1.5 rounded-full', hasTurnstile ? 'bg-emerald-500' : 'bg-amber-500']}></span>
          {hasTurnstile ? 'Protected' : 'Unset'}
        </span>
      </div>

      <!-- Resend -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">Resend API</span>
        <span class:list={[
          'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
          hasResend ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-zinc-600 bg-zinc-100 border-zinc-200'
        ]}>
          <span class:list={['w-1.5 h-1.5 rounded-full', hasResend ? 'bg-emerald-500' : 'bg-zinc-400']}></span>
          {hasResend ? 'Enabled' : 'Disabled'}
        </span>
      </div>

      <!-- Sanity -->
      <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
        <span class="font-medium text-[#52525b]">Sanity CMS</span>
        <span class:list={[
          'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
          hasSanity ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-zinc-600 bg-zinc-100 border-zinc-200'
        ]}>
          <span class:list={['w-1.5 h-1.5 rounded-full', hasSanity ? 'bg-emerald-500' : 'bg-zinc-400']}></span>
          {hasSanity ? 'Connected' : 'Unset'}
        </span>
      </div>
    </div>
  </div>

  <!-- Settings Configuration Form -->
  <form id="settings-form" class="space-y-6">
    <!-- Section 1: Brand & Buyer Concierge -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">1. Brand Identity & Buyer Concierge</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Customizes client-facing brand titles, direct support emails, and VIP WhatsApp concierge.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Brand Display Name -->
        <div>
          <label for="brand_name" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Brand Display Name
          </label>
          <input
            type="text"
            id="brand_name"
            name="brand_name"
            value={settings.brand_name}
            placeholder="e.g. B2B ATELIER"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-medium"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Shown in browser titles, email notifications, and webhook alerts.</p>
        </div>

        <!-- Public Contact Email -->
        <div>
          <label for="contact_email" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Customer Support Email
          </label>
          <input
            type="email"
            id="contact_email"
            name="contact_email"
            value={settings.contact_email}
            placeholder="e.g. inquiry@yourbrand.com"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Displayed to buyers in account portal and order requisition receipts.</p>
        </div>

        <!-- WhatsApp Number -->
        <div>
          <label for="whatsapp_number" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            VIP Concierge WhatsApp
          </label>
          <input
            type="text"
            id="whatsapp_number"
            name="whatsapp_number"
            value={settings.whatsapp_number}
            placeholder="e.g. 8613800000000 (digits only with country code)"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Powers the 1-click WhatsApp button in buyer account portal.</p>
        </div>

        <!-- WhatsApp Prefill Message -->
        <div>
          <label for="whatsapp_prefill" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            WhatsApp Inquiry Prefill Text
          </label>
          <input
            type="text"
            id="whatsapp_prefill"
            name="whatsapp_prefill"
            value={settings.whatsapp_prefill}
            placeholder="Hello, I would like to consult on custom manufacturing..."
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Default message draft when a buyer initiates a WhatsApp consultation.</p>
        </div>
      </div>
    </div>

    <!-- Section 2: RFQ Notifications & Webhook -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">2. RFQ Inbound Notifications & Webhooks</h2>
          <p class="text-xs text-[#86868b] mt-0.5">Control automatic dispatch when buyers submit procurement or swatch inquiries.</p>
        </div>
      </div>

      <!-- Email Notifications Subsection -->
      <div class="space-y-3 pt-1">
        <div class="flex items-center justify-between">
          <label for="enable_email_notify" class="flex items-center gap-2.5 cursor-pointer">
            <input
              type="checkbox"
              id="enable_email_notify"
              name="enable_email_notify"
              checked={settings.enable_email_notify}
              class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f]"
            />
            <span class="text-xs font-bold text-[#1d1d1f]">Dispatch Email Notifications via Resend</span>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label for="resend_from_email" class="block text-xs font-medium text-[#52525b] mb-1">
              Sender Address (From)
            </label>
            <input
              type="text"
              id="resend_from_email"
              name="resend_from_email"
              value={settings.resend_from_email}
              placeholder="e.g. RFQ Alert <rfq@yourdomain.com>"
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
            />
          </div>

          <div>
            <label for="resend_to_emails" class="block text-xs font-medium text-[#52525b] mb-1">
              Recipient Email(s)
            </label>
            <input
              type="text"
              id="resend_to_emails"
              name="resend_to_emails"
              value={settings.resend_to_emails}
              placeholder="e.g. sales@domain.com, lead@domain.com"
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
            />
          </div>

          <div>
            <label for="resend_subject_prefix" class="block text-xs font-medium text-[#52525b] mb-1">
              Subject Prefix
            </label>
            <input
              type="text"
              id="resend_subject_prefix"
              name="resend_subject_prefix"
              value={settings.resend_subject_prefix}
              placeholder="e.g. [New B2B RFQ]"
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
            />
          </div>
        </div>
      </div>

      <!-- Webhook Dispatch Subsection -->
      <div class="border-t border-black/5 pt-4 space-y-3">
        <div class="flex items-center justify-between">
          <label for="enable_webhook_notify" class="flex items-center gap-2.5 cursor-pointer">
            <input
              type="checkbox"
              id="enable_webhook_notify"
              name="enable_webhook_notify"
              checked={settings.enable_webhook_notify}
              class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f]"
            />
            <span class="text-xs font-bold text-[#1d1d1f]">Dispatch Bot Webhooks (WeCom, DingTalk, Feishu, Slack)</span>
          </label>
        </div>

        <div>
          <label for="notification_webhook_url" class="block text-xs font-medium text-[#52525b] mb-1">
            Outbound Webhook HTTPS URL
          </label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="url"
              id="notification_webhook_url"
              name="notification_webhook_url"
              value={settings.notification_webhook_url}
              placeholder="https://qyapi.weixin.qq.com/... or https://oapi.dingtalk.com/..."
              class="flex-1 px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
            />
            <button
              id="test-webhook-btn"
              type="button"
              class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-white border border-black/15 hover:border-black/30 text-[#1d1d1f] hover:bg-[#f5f5f7] shadow-2xs active:scale-95 transition-all whitespace-nowrap cursor-pointer flex items-center justify-center gap-1.5"
            >
              <span>Test Connection</span>
            </button>
          </div>
          <p id="webhook-test-status" class="text-[11px] text-[#86868b] mt-1.5">
            Supports WeChat Work, DingTalk markdown cards, Feishu / Lark, and generic JSON webhooks. Must be HTTPS.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 3: Orders & Fulfillment Rules -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">3. Orders & Requisition Sheet Standards</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Configures order number generation, logistics carrier presets, and printable requisition sheets.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Order Serial Prefix -->
        <div>
          <label for="order_no_prefix" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Order Serial Prefix (2-8 Chars)
          </label>
          <input
            type="text"
            id="order_no_prefix"
            name="order_no_prefix"
            value={settings.order_no_prefix}
            placeholder="ORD"
            maxlength="8"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono font-bold uppercase"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Example generated order number: <code class="font-mono">{settings.order_no_prefix}-20261104-A1B2</code></p>
        </div>

        <!-- Shipping Carriers Presets -->
        <div>
          <label for="shipping_carriers" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Logistics Carriers Presets (Comma-separated)
          </label>
          <input
            type="text"
            id="shipping_carriers"
            name="shipping_carriers"
            value={settings.shipping_carriers}
            placeholder="DHL Express,FedEx,UPS,SF Express"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Carriers available in the order dispatch / fulfillment dialog.</p>
        </div>

        <!-- Print Sheet Title -->
        <div>
          <label for="print_sheet_title" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Printable Requisition Header Title
          </label>
          <input
            type="text"
            id="print_sheet_title"
            name="print_sheet_title"
            value={settings.print_sheet_title}
            placeholder="OFFICIAL B2B PROCUREMENT REQUISITION"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Header on the official PDF/Print procurement requisition document.</p>
        </div>

        <!-- Print Sheet Footer Disclaimer -->
        <div>
          <label for="print_sheet_footer" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Printable Requisition Footer / Disclaimer
          </label>
          <input
            type="text"
            id="print_sheet_footer"
            name="print_sheet_footer"
            value={settings.print_sheet_footer}
            placeholder="This document is an official B2B sample & procurement requisition sheet."
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Legal or terms notice at the bottom of printed requisition sheets.</p>
        </div>
      </div>
    </div>

    <!-- Section 4: Enterprise RBAC & Team Member Governance -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">4. Organization, Team & RBAC Governance</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Team members and role-based permissions have moved to their dedicated management consoles.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/admin/members"
          class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/20 transition-all flex items-start gap-3 group"
        >
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-base shrink-0 border border-blue-200">
            🧑‍💼
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-[#1d1d1f] group-hover:text-blue-600 transition-colors">Team Members</span>
              <span class="text-xs text-[#86868b]">→</span>
            </div>
            <p class="text-[11px] text-[#86868b] mt-0.5 leading-relaxed">
              Authorize staff, select from registered Logto accounts, assign roles, and view performance workloads.
            </p>
          </div>
        </a>

        <a
          href="/admin/roles"
          class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/20 transition-all flex items-start gap-3 group"
        >
          <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center text-base shrink-0 border border-purple-200">
            🔐
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-[#1d1d1f] group-hover:text-purple-600 transition-colors">Roles & Permissions</span>
              <span class="text-xs text-[#86868b]">→</span>
            </div>
            <p class="text-[11px] text-[#86868b] mt-0.5 leading-relaxed">
              Visual RBAC matrix: customize row-level DataScope, visible menus, and fine-grained action buttons.
            </p>
          </div>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 border-t border-black/5">
        <input type="hidden" id="co_admin_emails" name="co_admin_emails" value={settings.co_admin_emails} />

        <!-- Login Retention Days -->
        <div>
          <label for="login_retention_days" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Audit Log Retention (Days)
          </label>
          <input
            type="number"
            id="login_retention_days"
            name="login_retention_days"
            value={settings.login_retention_days}
            min="7"
            max="365"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono font-bold"
          />
          <p class="text-[11px] text-[#86868b] mt-1">Audit trail retention window (7 to 365 days).</p>
        </div>

        <!-- Turnstile Hostnames -->
        <div class="md:col-span-2">
          <label for="turnstile_hostnames" class="block text-xs font-semibold text-[#1d1d1f] mb-1">
            Turnstile Allowed Hostnames (Comma-separated)
          </label>
          <input
            type="text"
            id="turnstile_hostnames"
            name="turnstile_hostnames"
            value={settings.turnstile_hostnames}
            placeholder="e.g. yourdomain.com, www.yourdomain.com, localhost"
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono"
          />
          <p class="text-[11px] text-[#86868b] mt-1">
            Leave blank to accept requests from the current request hostname automatically.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 5: Universal Data Dictionary Engine Integration -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">5. Universal Data Dictionaries (Live Engine)</h2>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              3-Tier Caching Active
            </span>
          </div>
          <p class="text-xs text-[#86868b] mt-0.5">Shipping carriers, quick reply templates, customer tiers, and tags are dynamically configured without code redeployment.</p>
        </div>
        <a
          href="/admin/dicts"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs cursor-pointer shrink-0"
        >
          <span>Open Data Dictionaries Console</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <a
          href="/admin/dicts?group=shipping_carriers"
          class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/15 transition-all group block space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-[#1d1d1f] group-hover:text-blue-600 transition-colors">📦 Shipping Carriers</span>
            <span class="text-[11px] text-[#86868b]">Manage →</span>
          </div>
          <p class="text-[11px] text-[#52525b] leading-relaxed">Live carrier tracking URL templates (DHL, FedEx, UPS, SF, EMS) with query parameter placeholders.</p>
        </a>

        <a
          href="/admin/dicts?group=quick_replies"
          class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/15 transition-all group block space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-[#1d1d1f] group-hover:text-blue-600 transition-colors">💬 Quick Reply Templates</span>
            <span class="text-[11px] text-[#86868b]">Manage →</span>
          </div>
          <p class="text-[11px] text-[#52525b] leading-relaxed">English response chips for approval remarks, dispatch notifications, and rejection feedback.</p>
        </a>

        <a
          href="/admin/dicts?group=customer_tiers"
          class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/15 transition-all group block space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-[#1d1d1f] group-hover:text-blue-600 transition-colors">🏷️ Customer Tiers & Tags</span>
            <span class="text-[11px] text-[#86868b]">Manage →</span>
          </div>
          <p class="text-[11px] text-[#52525b] leading-relaxed">B2B client discount tiers (Regular, Wholesale, VIP, Partner) and CRM tag chips.</p>
        </a>
      </div>
    </div>

    <!-- Section 6: Diagnostics & Observability -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">6. Diagnostics & Observability Governance</h2>
          <p class="text-xs text-[#86868b] mt-0.5">Control D1 business error logging, logged-in user tracking, and retention thresholds.</p>
        </div>
        <a
          href="/admin/logs"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all text-[#1d1d1f]"
        >
          <span>Open Diagnostics Console</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
        <!-- Enable Error Logging -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex items-start gap-3">
          <input
            type="checkbox"
            id="enable_error_logging"
            name="enable_error_logging"
            checked={settings.enable_error_logging}
            class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f] mt-0.5 shrink-0"
          />
          <div>
            <label for="enable_error_logging" class="block text-xs font-bold text-[#1d1d1f] cursor-pointer">
              Enable D1 Error Logging
            </label>
            <p class="text-[11px] text-[#86868b] mt-0.5">
              Persist runtime errors, unhandled exceptions, and API anomalies into D1 database for in-dashboard diagnostics.
            </p>
          </div>
        </div>

        <!-- Log Authenticated Users -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex items-start gap-3">
          <input
            type="checkbox"
            id="log_authenticated_users"
            name="log_authenticated_users"
            checked={settings.log_authenticated_users}
            class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f] mt-0.5 shrink-0"
          />
          <div>
            <label for="log_authenticated_users" class="block text-xs font-bold text-[#1d1d1f] cursor-pointer">
              Log Authenticated Users
            </label>
            <p class="text-[11px] text-[#86868b] mt-0.5">
              Control whether activity and error records are logged for signed-in buyers and administrators (GDPR / Privacy).
            </p>
          </div>
        </div>

        <!-- Frontend Client Error Telemetry -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex items-start gap-3">
          <input
            type="checkbox"
            id="log_client_errors"
            name="log_client_errors"
            checked={settings.log_client_errors}
            class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f] mt-0.5 shrink-0"
          />
          <div>
            <label for="log_client_errors" class="block text-xs font-bold text-[#1d1d1f] cursor-pointer">
              Frontend Client Error Telemetry (前端异常监控)
            </label>
            <p class="text-[11px] text-[#86868b] mt-0.5">
              Capture unhandled browser exceptions (window.onerror & unhandledrejection) and report to D1 diagnostics. When disabled, client stops reporting and backend rejects telemetry.
            </p>
          </div>
        </div>

        <!-- Log Retention Days -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col justify-between">
          <div>
            <label for="log_retention_days" class="block text-xs font-bold text-[#1d1d1f] mb-1">
              Error Log Retention (Days)
            </label>
            <input
              type="number"
              id="log_retention_days"
              name="log_retention_days"
              value={settings.log_retention_days}
              min="1"
              max="365"
              class="w-full px-3 py-1.5 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] font-mono font-bold"
            />
          </div>
          <p class="text-[11px] text-[#86868b] mt-1">Automatic rolling prune threshold (1 to 365 days).</p>
        </div>

        <!-- Minimum Log Persistence Level -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col justify-between">
          <div>
            <label for="log_min_level" class="block text-xs font-bold text-[#1d1d1f] mb-1">
              Minimum Log Level to D1
            </label>
            <select
              id="log_min_level"
              name="log_min_level"
              class="w-full px-3 py-1.5 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] font-mono font-semibold"
            >
              <option value="debug" selected={settings.log_min_level === 'debug'}>debug (Verbose + SQL timings)</option>
              <option value="info" selected={settings.log_min_level === 'info'}>info (All completed requests & events)</option>
              <option value="warn" selected={settings.log_min_level === 'warn'}>warn (Default: Slow requests & warnings)</option>
              <option value="error" selected={settings.log_min_level === 'error'}>error (Errors & critical only)</option>
              <option value="critical" selected={settings.log_min_level === 'critical'}>critical (Critical incidents only)</option>
            </select>
          </div>
          <p class="text-[11px] text-[#86868b] mt-1">Controls D1 write volume. Info/Debug capture full request profiling.</p>
        </div>

        <!-- Slow Request Threshold -->
        <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col justify-between md:col-span-2">
          <div>
            <label for="slow_request_threshold_ms" class="block text-xs font-bold text-[#1d1d1f] mb-1">
              Slow Request Warning Threshold (ms)
            </label>
            <div class="flex items-center gap-2">
              <input
                type="number"
                id="slow_request_threshold_ms"
                name="slow_request_threshold_ms"
                value={settings.slow_request_threshold_ms || 1000}
                min="50"
                max="30000"
                step="50"
                class="w-36 px-3 py-1.5 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] font-mono font-bold"
              />
              <span class="text-xs text-[#86868b]">ms (Default: 1000ms)</span>
            </div>
          </div>
          <p class="text-[11px] text-[#86868b] mt-1">Requests exceeding this threshold are automatically captured as performance warnings even in warn/error mode.</p>
        </div>
      </div>
    </div>

    <!-- Bottom Save Toolbar -->
    <div class="sticky bottom-4 z-20 flex items-center justify-between p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-black/10 shadow-lg">
      <div class="text-xs text-[#86868b]">
        Changes take effect immediately across all edge nodes upon saving.
      </div>
      <button
        id="save-settings-btn-bottom"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-xs active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Save All Settings</span>
      </button>
    </div>
  </form>

  <!-- Client Script for Form Handling (Pure Vanilla JS - Zero TS Syntax) -->
  <script is:inline>
    (function() {
      var form = document.getElementById('settings-form');
      var saveTop = document.getElementById('save-settings-btn-top');
      var saveBottom = document.getElementById('save-settings-btn-bottom');
      var testBtn = document.getElementById('test-webhook-btn');
      var webhookStatus = document.getElementById('webhook-test-status');

      function showToast(message, isSuccess) {
        if (window.__showToast) window.__showToast(message, isSuccess);
      }

      function getFormUpdates() {
        if (!form) return {};
        var formData = new FormData(form);
        var updates = {
          brand_name: (formData.get('brand_name') || '').toString().trim(),
          contact_email: (formData.get('contact_email') || '').toString().trim(),
          whatsapp_number: (formData.get('whatsapp_number') || '').toString().trim(),
          whatsapp_prefill: (formData.get('whatsapp_prefill') || '').toString().trim(),
          enable_email_notify: form.querySelector('#enable_email_notify') ? form.querySelector('#enable_email_notify').checked : true,
          resend_from_email: (formData.get('resend_from_email') || '').toString().trim(),
          resend_to_emails: (formData.get('resend_to_emails') || '').toString().trim(),
          resend_subject_prefix: (formData.get('resend_subject_prefix') || '').toString().trim(),
          enable_webhook_notify: form.querySelector('#enable_webhook_notify') ? form.querySelector('#enable_webhook_notify').checked : true,
          notification_webhook_url: (formData.get('notification_webhook_url') || '').toString().trim(),
          order_no_prefix: (formData.get('order_no_prefix') || '').toString().trim().toUpperCase(),
          shipping_carriers: (formData.get('shipping_carriers') || '').toString().trim(),
          print_sheet_title: (formData.get('print_sheet_title') || '').toString().trim(),
          print_sheet_footer: (formData.get('print_sheet_footer') || '').toString().trim(),
          co_admin_emails: (formData.get('co_admin_emails') || '').toString().trim(),
          turnstile_hostnames: (formData.get('turnstile_hostnames') || '').toString().trim(),
          login_retention_days: parseInt(formData.get('login_retention_days') || '90', 10),
          enable_error_logging: form.querySelector('#enable_error_logging') ? form.querySelector('#enable_error_logging').checked : true,
          log_authenticated_users: form.querySelector('#log_authenticated_users') ? form.querySelector('#log_authenticated_users').checked : true,
          log_client_errors: form.querySelector('#log_client_errors') ? form.querySelector('#log_client_errors').checked : true,
          log_retention_days: parseInt(formData.get('log_retention_days') || '30', 10),
          log_min_level: (formData.get('log_min_level') || 'warn').toString().trim().toLowerCase(),
          slow_request_threshold_ms: parseInt(formData.get('slow_request_threshold_ms') || '1000', 10),
        };
        return updates;
      }

      async function saveSettings() {
        var updates = getFormUpdates();
        var buttons = [saveTop, saveBottom];
        buttons.forEach(function(b) {
          if (b) {
            b.disabled = true;
            b.classList.add('opacity-50', 'pointer-events-none');
          }
        });

        try {
          var res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', updates: updates }),
          });
          var data = await res.json();
          if (!res.ok || !data.success) {
            showToast(data.error || 'Failed to update settings.', false);
          } else {
            showToast('Settings saved successfully and synced to D1.', true);
          }
        } catch (err) {
          showToast('Network error while saving settings: ' + err.message, false);
        } finally {
          buttons.forEach(function(b) {
            if (b) {
              b.disabled = false;
              b.classList.remove('opacity-50', 'pointer-events-none');
            }
          });
        }
      }

      if (saveTop) saveTop.addEventListener('click', saveSettings);
      if (saveBottom) saveBottom.addEventListener('click', saveSettings);

      if (testBtn) {
        testBtn.addEventListener('click', async function() {
          var urlInput = document.getElementById('notification_webhook_url');
          var url = urlInput ? urlInput.value.trim() : '';
          if (!url) {
            showToast('Please provide a webhook URL before testing.', false);
            return;
          }

          testBtn.disabled = true;
          testBtn.textContent = 'Sending...';
          if (webhookStatus) {
            webhookStatus.textContent = 'Sending test payload to webhook...';
            webhookStatus.className = 'text-[11px] text-blue-600 mt-1.5 animate-pulse';
          }

          try {
            var res = await fetch('/api/admin/settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'test_webhook', url: url }),
            });
            var data = await res.json();
            if (res.ok && data.success) {
              showToast('Webhook reached successfully! Check your bot channel.', true);
              if (webhookStatus) {
                webhookStatus.textContent = '✔ Live Test Passed: ' + (data.message || 'HTTP 200 OK');
                webhookStatus.className = 'text-[11px] text-emerald-600 font-semibold mt-1.5';
              }
            } else {
              showToast(data.error || 'Webhook test failed.', false);
              if (webhookStatus) {
                webhookStatus.textContent = '✖ Test Failed: ' + (data.error || 'Connection error');
                webhookStatus.className = 'text-[11px] text-rose-600 font-semibold mt-1.5';
              }
            }
          } catch (err) {
            showToast('Test request failed: ' + err.message, false);
            if (webhookStatus) {
              webhookStatus.textContent = '✖ Request error: ' + err.message;
              webhookStatus.className = 'text-[11px] text-rose-600 font-semibold mt-1.5';
            }
          } finally {
            testBtn.disabled = false;
            testBtn.textContent = 'Test Connection';
          }
        });
      }
    })();
  </script>
</AdminLayout>

