    }).join('');

    const desktopTableHtml = `
      <div class="hidden md:block">
        <table id="orders-main-table" class="w-full text-left text-xs border-collapse table-fixed select-text">
          <thead class="sticky top-0 z-10 bg-[#fbfbfd]/95 backdrop-blur-xs border-b border-black/10 shadow-2xs">
            <tr id="orders-header-row"></tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            ${desktopRowsHtml}
          </tbody>
        </table>
      </div>
    `;

    container.innerHTML = mobileCardsHtml + desktopTableHtml;
    container.classList.remove('hidden');

    const ordersTable = document.getElementById('orders-main-table');
    const ordersHeaderRow = document.getElementById('orders-header-row');
    if (ordersTable && ordersHeaderRow) {
      tableSettings.renderHeader(ordersHeaderRow, ordersTable);
    }
  }

  async function fetchOrders(updateUrl = true) {
    selectedOrderIds.clear();
    const selectAllEl = document.getElementById('orders-select-all') as HTMLInputElement | null;
    if (selectAllEl) selectAllEl.checked = false;
    updateBatchBar();

    if (activeAbortController) {
      activeAbortController.abort();
    }
    activeAbortController = new AbortController();

    const skeleton = document.getElementById('orders-skeleton');
    const content = document.getElementById('orders-content');
    const paginationContainer = document.getElementById('pagination-container');

    let skeletonTimer: any = null;
    if (skeleton && content) {
      // If content is empty (cold start), show skeleton immediately.
      // If content is already populated (switching tabs), wait 80ms to avoid flicker on instant cache hits.
      if (content.classList.contains('hidden') || !content.innerHTML.trim()) {
        skeleton.classList.remove('hidden');
        content.classList.add('hidden');
      } else {
        skeletonTimer = setTimeout(() => {
          skeleton.classList.remove('hidden');
          content.classList.add('hidden');
        }, 80);
      }
    }
    if (paginationContainer) {
      paginationContainer.classList.add('hidden');
    }

    updateActiveVisuals();

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (currentStatus && currentStatus !== 'ALL') {
        url.searchParams.set('status', currentStatus);
      } else {
        url.searchParams.delete('status');
      }

      if (currentSearch) {
        url.searchParams.set('search', currentSearch);
      } else {
        url.searchParams.delete('search');
      }

      if (currentTimeWindow && currentTimeWindow !== 'ALL') {
        url.searchParams.set('timeWindow', currentTimeWindow);
      } else {
        url.searchParams.delete('timeWindow');
      }

      if (currentAssignedTo) {
        url.searchParams.set('assignedTo', currentAssignedTo);
      } else {
        url.searchParams.delete('assignedTo');
      }

      if (currentPage > 1) {
        url.searchParams.set('page', String(currentPage));
      } else {
        url.searchParams.delete('page');
      }

      window.history.pushState({ status: currentStatus, search: currentSearch, timeWindow: currentTimeWindow, assignedTo: currentAssignedTo, page: currentPage }, '', url.toString());
    }

    try {
      const qs = new URLSearchParams();
      if (currentStatus && currentStatus !== 'ALL') qs.set('status', currentStatus);
      if (currentSearch) qs.set('search', currentSearch);
      if (currentTimeWindow && currentTimeWindow !== 'ALL') qs.set('timeWindow', currentTimeWindow);
      if (currentAssignedTo) qs.set('assignedTo', currentAssignedTo);
      qs.set('page', String(currentPage));
      qs.set('limit', String(currentLimit));

      const cacheKey = `admin:orders:${currentStatus}:${currentSearch}:${currentTimeWindow}:${currentAssignedTo}:${currentPage}:${currentLimit}`;
      await clientCache.fetchWithCache(
        cacheKey,
        `/api/admin/orders?${qs.toString()}`,
        {
          mode: 'swr',
          init: { signal: activeAbortController.signal },
          onData: (data: any) => {
            if (skeletonTimer) clearTimeout(skeletonTimer);
            if (skeleton) skeleton.classList.add('hidden');
            renderStats(data.stats, data.total);
            renderOrders(data.orders || []);
            pagination.render(data.page || 1, data.totalPages || 1, data.total || 0, data.limit || 50);
          },
        }
      );
    } catch (err: any) {
      if (skeletonTimer) clearTimeout(skeletonTimer);
      if (err?.name === 'AbortError') return;
      console.error('[Orders] Fetch failed:', err);
      if (skeleton) skeleton.classList.add('hidden');
      if (content) {
        content.innerHTML = `
          <div class="py-16 text-center text-xs text-rose-600 space-y-2">
            <p>Failed to load orders (${escapeHtml(err.message)}).</p>
            <button type="button" id="retry-fetch-btn" class="px-3 py-1.5 rounded-lg bg-black text-white text-xs font-semibold cursor-pointer">
              Retry
            </button>
          </div>
        `;
        content.classList.remove('hidden');
        document.getElementById('retry-fetch-btn')?.addEventListener('click', () => fetchOrders(false));
      }
    }
  }

  async function loadOrderAuditTimeline(orderId: string) {
    const elDesktop = document.getElementById(`order-timeline-${orderId}`);
    const elMobile = document.getElementById(`order-timeline-m-${orderId}`);
    if (!elDesktop && !elMobile) return;
    if (elDesktop) elDesktop.innerHTML = `<p class="text-[11px] text-[#86868b] italic py-1">Loading audit logs...</p>`;
    if (elMobile) elMobile.innerHTML = `<p class="text-[10px] text-[#86868b] italic py-1">Loading...</p>`;
    try {
      const res = await fetch(`/api/admin/audit?targetId=${encodeURIComponent(orderId)}&limit=15`);
      const data = await res.json();
      if (res.ok && data.logs && data.logs.length > 0) {
        const html = data.logs.map((log: any) => {
          const date = log.created_at ? formatAdminTime(log.created_at, 'full') : '—';
          let diffText = '';
          try {
            const diff = log.diff_json ? JSON.parse(log.diff_json) : null;
            if (diff) {
              diffText = Object.keys(diff).map((k) => `${k}: ${JSON.stringify(diff[k].from)} → ${JSON.stringify(diff[k].to)}`).join(', ');
            }
          } catch {}
          return `
            <div class="p-2 rounded-xl bg-[#fafafa] border border-black/5 space-y-0.5">
              <div class="flex items-center justify-between text-[10px]">
                <span class="font-bold text-[#1d1d1f]">${escapeHtml(log.action)}</span>
                <span class="font-mono text-[#86868b]">${escapeHtml(date)}</span>
              </div>
              <div class="text-[10px] text-[#52525b] truncate">By: ${escapeHtml(log.admin_email)}</div>
              ${diffText ? `<div class="text-[9px] font-mono text-emerald-800 bg-emerald-50/60 p-1 rounded border border-emerald-100">${escapeHtml(diffText)}</div>` : ''}
            </div>
          `;
        }).join('');
        if (elDesktop) elDesktop.innerHTML = html;
        if (elMobile) elMobile.innerHTML = html;
      } else {
        const noRec = `<p class="text-[11px] text-[#86868b] italic py-1">No administrative status changes or audit logs recorded for this order yet.</p>`;
        if (elDesktop) elDesktop.innerHTML = noRec;
        if (elMobile) elMobile.innerHTML = noRec;
      }
    } catch (err: any) {
      const errMsg = `<p class="text-[11px] text-rose-600 py-1">Failed to load: ${escapeHtml(err.message || 'Error')}</p>`;
      if (elDesktop) elDesktop.innerHTML = errMsg;
      if (elMobile) elMobile.innerHTML = errMsg;
    }
  }

  // Event Delegation for Accordion and Action Modals
