{
    "name": "gwenvenni-web",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev --host 0.0.0.0 --ignore-lock",
        "start": "astro dev --host 0.0.0.0 --ignore-lock",
        "build": "astro build",
        "preview": "wrangler dev",
        "deploy": "astro build && wrangler deploy",
        "build:studio": "cd studio && npm run build",
        "deploy:studio": "cd studio && npm run build && npx wrangler deploy --config wrangler.jsonc",
        "astro": "astro",
        "create-project": "node ./sanity-export/create-project.js",
        "import": "node ./sanity-export/import.js",
        "export": "node ./sanity-export/export.js"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.4",
        "@nanostores/persistent": "^1.3.5",
        "@sanity/astro": "^3.5.1",
        "@sanity/client": "^7.27.0",
        "@sanity/validation": "^3.14.4",
        "@tailwindcss/vite": "^4.0.9",
        "astro": "^7.3.8",
        "astro-icon": "^1.1.0",
        "dotenv": "^16.4.7",
        "fs-extra": "^11.2.0",
        "marked": "^15.0.4",
        "nanostores": "^1.5.5",
        "tailwindcss": "^4.0.9",
        "ua-parser-js": "^2.0.10",
        "wrangler": "^4.150.0"
    },
    "devDependencies": {
        "@sanity/export": "^3.38.1",
        "@sanity/import": "^3.37.4",
        "configstore": "7.0.0",
        "daisyui": "^5.0.0",
        "vite": "^8.3.4"
    }
