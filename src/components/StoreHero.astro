---
// src/components/StoreHero.astro
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { SanityImageService } from '@utils/image';
import { DEFAULT_HERO, DEFAULT_FALLBACK_IMAGE } from '@data/defaults';
import { getLangFromUrl, getLocalizedPath, useTranslations, getLocalizedValue } from '@i18n';

interface Props {
  elementId?: string;
  sectionAnchor?: string;
  superTitle?: string;
  headline?: string;
  subline?: string;
  heroImage?: string;
  swatchSku?: string;
  showPrimaryButton?: boolean;
  primaryButtonText?: string;
  primaryButtonUrl?: string;
  showSecondaryButton?: boolean;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
}

const {
  elementId,
  sectionAnchor,
  superTitle: propSuperTitle,
  headline = DEFAULT_HERO.headline,
  subline = DEFAULT_HERO.subline,
  heroImage: propHeroImage,
  swatchSku,
  showPrimaryButton: propShowPrimary,
  primaryButtonText: propPrimaryText,
  primaryButtonUrl = DEFAULT_HERO.primaryButtonUrl,
  showSecondaryButton: propShowSecondary,
  secondaryButtonText = DEFAULT_HERO.secondaryButtonText,
  secondaryButtonUrl = DEFAULT_HERO.secondaryButtonUrl,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Safe text extractor: resolves Sanity multilingual object ({ en: '...' }) or string safely without throwing .trim errors
const toText = (val: any, fallback = ''): string => {
  if (val === null || val === undefined) return fallback;
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    const loc = getLocalizedValue(val, currentLang);
    return typeof loc === 'string' ? loc.trim() : (loc ? String(loc).trim() : fallback);
  }
  return String(val).trim();
};

const rfqSettings = await fetchRfqSettings();
const rawHeroImage = (typeof propHeroImage === 'string' ? propHeroImage.trim() : (propHeroImage?.asset?.url || DEFAULT_FALLBACK_IMAGE));
const heroImage = SanityImageService.hero(rawHeroImage, 1600);
const heroSrcSet = SanityImageService.srcSet(rawHeroImage, [480, 640, 800, 1200, 1600], { quality: 75 });
const primaryButtonText = toText(propPrimaryText) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));
const safeSecondaryText = toText(secondaryButtonText, DEFAULT_HERO.secondaryButtonText);
const resolvedSecondaryText = (safeSecondaryText && safeSecondaryText !== DEFAULT_HERO.secondaryButtonText) ? safeSecondaryText : t('hero.exploreLineSheets');

// Super Title handling: support custom text or clean default
const cleanSuperTitle = propSuperTitle !== undefined
  ? toText(propSuperTitle)
  : DEFAULT_HERO.superTitle;

// Headline parsing: support single-line or two-part contrast subtitle
// If headline contains a period + space or newline, split into primary and secondary.
// If it's a single sentence/line, render as ONE single line without forced <br> or unwanted fallback text.
const rawHeadline = toText(headline, DEFAULT_HERO.headline);
let headlinePrimary = rawHeadline;
let headlineSecondary = "";

if (rawHeadline.includes('\n')) {
  const parts = rawHeadline.split('\n');
  headlinePrimary = parts[0].trim();
  headlineSecondary = parts.slice(1).join(' ').trim();
} else {
  const match = rawHeadline.match(/^(.+?\.)\s+(.+)$/);
  if (match) {
    headlinePrimary = match[1].trim();
    headlineSecondary = match[2].trim();
  }
}

const isSwatchButton = (primaryButtonText || "").toLowerCase().includes("swatch") || primaryButtonUrl === "#inquiry";
const showPrimaryButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowPrimary,
  settingOverride: rfqSettings?.showHeroPrimaryButton,
  isSwatchAction: isSwatchButton,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: primaryButtonText,
});

const showSecondaryButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowSecondary,
  settingOverride: rfqSettings?.showHeroSecondaryButton,
  buttonText: resolvedSecondaryText,
});

const sectionId = elementId || sectionAnchor || 'hero';
---

<section id={sectionId} class="hero-section bg-canvas text-ink text-center">
  <!-- Narrow Rail (980px): Text Content Focus -->
  <div class="apple-rail-narrow">
    <!-- Category Super-title -->
    {cleanSuperTitle && (
      <p class="text-xs font-medium tracking-[0.16em] uppercase text-muted mb-3">
        {cleanSuperTitle}
      </p>
    )}

    <!-- Grand Editorial Serif Headline with Contrast Subtitle -->
    <h1 class="fluid-hero-title font-display font-medium text-ink">
      <span>{headlinePrimary}</span>
      {headlineSecondary && (
        <>
          <br class="hidden sm:inline" />
          <span class="text-muted font-normal sm:ml-0 ml-1.5">{headlineSecondary}</span>
        </>
      )}
    </h1>

    <!-- Subtitle Description -->
    {subline && (
      <p class="mt-4 sm:mt-5 text-[15px] sm:text-[17px] text-muted max-w-2xl mx-auto font-normal leading-relaxed">
        {subline}
      </p>
    )}

    <!-- Centered Action Buttons -->
    {(showPrimaryButton || showSecondaryButton) && (
      <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        {showPrimaryButton && (
          <a
            href={getLocalizedPath(primaryButtonUrl, currentLang)}
            data-swatch-sku={swatchSku}
            class="w-full sm:w-auto px-7 py-3 rounded-full bg-ink text-canvas text-sm font-medium hover:opacity-85 transition-opacity"
          >
            {primaryButtonText}
          </a>
        )}
        {showSecondaryButton && (
          <a
            href={getLocalizedPath(secondaryButtonUrl, currentLang)}
            class="w-full sm:w-auto px-6 py-3 rounded-full text-ink text-sm font-medium hover:bg-surface border border-hairline transition-colors inline-flex items-center justify-center gap-1.5"
          >
            <span>{resolvedSecondaryText}</span>
            <span aria-hidden="true">›</span>
          </a>
        )}
      </div>
    )}
  </div>

  <!-- Showcase Rail (up to 1520px): Macro Fabric Visual -->
  <div class="apple-rail-showcase hero-showcase-box relative mt-10 sm:mt-14 aspect-[16/10] sm:aspect-[16/9] max-h-[680px] w-full rounded-[var(--gv-radius-card)] overflow-hidden bg-surface border border-hairline group">
    <img
      src={heroImage}
      srcset={heroSrcSet || undefined}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 95vw, 1520px"
      width="1600"
      height="900"
      alt={headlinePrimary}
      class="hero-showcase-img w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</section>
