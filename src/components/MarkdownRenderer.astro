---
// src/components/MarkdownRenderer.astro
import { marked } from 'marked';

export interface Props {
  content?: string;
  className?: string;
}

const { content = '', className = '' } = Astro.props;

let htmlContent = '';
if (content && typeof content === 'string' && content.trim().length > 0) {
  try {
    const rawParsed = marked.parse(content, { gfm: true, breaks: true }) as string;
    // Lightweight defense against malicious script tags, iframes, inline event handlers, and javascript pseudo-protocols
    htmlContent = rawParsed
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
      .replace(/\s+on\w+\s*=\s*(?:'[^']*'|"[^"]*"|[^\s>]+)/gi, '')
      .replace(/(href|src)\s*=\s*["']?\s*javascript:[^"'>]*/gi, '$1="#"');
  } catch (err) {
    console.error('Error parsing markdown in MarkdownRenderer:', err);
    htmlContent = content;
  }
}
---

{htmlContent && (
  <div class:list={["markdown-renderer max-w-none text-[#424245] leading-relaxed", className]}>
    <div class="product-story-prose" set:html={htmlContent} />
  </div>
)}

<style>
  :global(.product-story-prose h1),
  :global(.product-story-prose h2),
  :global(.product-story-prose h3),
  :global(.product-story-prose h4) {
    color: #1d1d1f;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  :global(.product-story-prose h1) {
    font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.125rem);
    margin-top: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  :global(.product-story-prose h2) {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
    margin-top: clamp(1.25rem, 1rem + 0.8vw, 1.875rem);
    margin-bottom: 0.75rem;
    line-height: 1.25;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  :global(.product-story-prose h3) {
    font-size: clamp(1.125rem, 1.025rem + 0.5vw, 1.375rem);
    margin-top: clamp(1.125rem, 0.95rem + 0.6vw, 1.625rem);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  :global(.product-story-prose h4) {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    margin-top: clamp(1rem, 0.85rem + 0.5vw, 1.375rem);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  :global(.product-story-prose p) {
    margin-bottom: 1rem;
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: clamp(1.65, 1.6 + 0.3vw, 1.8);
  }
  :global(.product-story-prose blockquote) {
    margin: clamp(1.25rem, 1rem + 0.8vw, 1.75rem) 0;
    padding: clamp(0.875rem, 0.75rem + 0.5vw, 1.25rem) clamp(1rem, 0.875rem + 0.5vw, 1.5rem);
    background-color: #fbf9f5;
    border-left: 3px solid #1d1d1f;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: #1d1d1f;
    font-size: clamp(0.9rem, 0.875rem + 0.2vw, 1rem);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
  }
  :global(.product-story-prose ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }
  :global(.product-story-prose ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }
  :global(.product-story-prose li) {
    line-height: 1.6;
    padding-left: 0.25rem;
  }
  :global(.product-story-prose li strong) {
    color: #1d1d1f;
  }
  :global(.product-story-prose table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.8125rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.75rem;
    overflow: hidden;
    display: block;
    overflow-x: auto;
    background: #ffffff;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
  }
  :global(.product-story-prose th) {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  :global(.product-story-prose td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    font-family: var(--font-mono, monospace);
    color: #424245;
    white-space: nowrap;
  }
  :global(.product-story-prose tr:last-child td) {
    border-bottom: none;
  }
  :global(.product-story-prose tr:nth-child(even) td) {
    background-color: #fafafc;
  }
  :global(.product-story-prose img) {
    border-radius: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.03);
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
    object-fit: cover;
  }
  :global(.product-story-prose hr) {
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    margin: 2rem 0;
  }
  :global(.product-story-prose a) {
    color: #0066cc;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.product-story-prose code) {
    font-family: var(--font-mono, monospace);
    background-color: #f5f5f7;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    color: #1d1d1f;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
</style>
