---
// src/components/ManufacturingCapabilities.astro
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { DEFAULT_MANUFACTURING, DEFAULT_RFQ } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n';

interface Props {
  badge?: string;
  headline?: string;
  subline?: string;
  capabilities?: Array<{ title: string; description: string }>;
  actionButtonText?: string;
  actionButtonUrl?: string;
  showActionButton?: boolean;
}

const {
  badge = DEFAULT_MANUFACTURING.badge,
  headline = DEFAULT_MANUFACTURING.headline,
  subline = DEFAULT_MANUFACTURING.subline,
  capabilities = DEFAULT_MANUFACTURING.capabilities,
  actionButtonText: propActionText,
  actionButtonUrl = "#inquiry",
  swatchSku,
  showActionButton: propShowAction
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const rfqSettings = await fetchRfqSettings();
const actionButtonText = propActionText?.trim() || (currentLang !== 'en' ? t('hero.requestSwatch') : (rfqSettings?.heroSwatchBtnText?.trim() || DEFAULT_RFQ.heroSwatchBtnText));

const isSwatchAction = (actionButtonText || "").toLowerCase().includes("swatch") || actionButtonUrl === "#inquiry";
const showActionButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowAction,
  settingOverride: rfqSettings?.showManufacturingActionButton,
  isSwatchAction,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: actionButtonText,
});
// Helper to extract a prominent stat or badge from capability title
function extractStat(title: string, index: number) {
  const match = (title || "").match(/^([0-9]+[a-zA-Z+]*)/);
  if (match) return match[1];
  const defaults = ["350+", "72h", "100%", "ISO"];
  return defaults[index] || "✓";
}

function extractCleanTitle(title: string) {
  return (title || "").replace(/^([0-9]+[a-zA-Z+]*\s*)/, '').trim() || title;
}

const FOOTERS_BY_LANG: Record<string, string[]> = {
  de: [
    "Lonati Ein- & Doppelzylinder",
    "CAD bis Musterversand mit DHL Express",
    "Pantone-Färbung & Private-Label-Verpackung",
    "Sedex, BSCI & OEKO-TEX 100"
  ],
  fr: [
    "Monocylindre & double cylindre Lonati",
    "Du patronage CAO à l'envoi DHL Express",
    "Teinture Pantone & packaging sur mesure",
    "Certifié Sedex, BSCI & OEKO-TEX 100"
  ],
  es: [
    "Cilindros simples y dobles Lonati",
    "Del patronaje CAD al envío DHL Express",
    "Tintado Pantone y embalaje personalizado",
    "Certificado Sedex, BSCI y OEKO-TEX 100"
  ],
  en: [
    "Lonati Single & Double Cylinders",
    "CAD to Sample with DHL Express",
    "Pantone Dyeing & Custom Packaging",
    "Sedex, BSCI & OEKO-TEX 100"
  ]
};
const footers = FOOTERS_BY_LANG[currentLang] || FOOTERS_BY_LANG.en;
---

<section id="manufacturing" class="bg-white text-[#1d1d1f] border-t border-black/5 py-8 sm:py-10 lg:py-12">
  <div class="apple-rail-bento w-full">
    <div class="apple-rail-narrow text-center mb-4 sm:mb-5 lg:mb-6 space-y-1 sm:space-y-1.5">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#86868b]">{badge}</span>
      <h2 class="fluid-section-title font-semibold tracking-tight text-[#1d1d1f]">
        {headline}
      </h2>
      <p class="text-[#86868b] text-xs sm:text-sm lg:text-base font-normal leading-relaxed max-w-2xl mx-auto mt-1">
        {subline}
      </p>
    </div>

    <!-- Feature Cards: Horizontal Scroll on Mobile, Grid on Desktop -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 sm:gap-4 lg:gap-5 pb-3 pt-1 no-scrollbar md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-visible md:p-0">
      {capabilities.map((cap: any, idx: number) => (
        <div class="shrink-0 w-[78vw] max-w-[280px] snap-start md:w-full md:max-w-none md:shrink md:snap-align-none p-4.5 sm:p-5 rounded-2xl sm:rounded-3xl bg-[#f5f5f7] border border-black/5 hover:border-black/15 hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full group">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#1d1d1f] font-mono group-hover:text-black">
                {extractStat(cap.title, idx)}
              </span>
              <div class="w-8 h-8 rounded-xl bg-white border border-black/5 shadow-2xs flex items-center justify-center text-[#1d1d1f]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
            </div>
            <h3 class="mt-2.5 text-sm sm:text-base font-semibold text-[#1d1d1f]">{extractCleanTitle(cap.title)}</h3>
            <p class="mt-1 text-xs text-[#86868b] leading-relaxed line-clamp-3">
              {cap.description}
            </p>
          </div>
          <div class="mt-3.5 pt-2.5 border-t border-black/5 text-[11px] text-[#86868b] font-medium flex items-center justify-between">
            <span class="truncate">{footers[idx] || "Global Export Standard"}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Swipe Visual Hint -->
    <div class="flex md:hidden items-center justify-center gap-1.5 pt-2.5 text-[11px] font-medium text-[#86868b]">
      <span>{t('manufacturing.swipeHint')}</span>
      <span aria-hidden="true">→</span>
    </div>

    {showActionButton && (
      <div class="mt-5 sm:mt-6 lg:mt-7 text-center">
        <a
          href={getLocalizedPath(actionButtonUrl || "#inquiry", currentLang)}
          data-swatch-sku={swatchSku}
          class="inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full text-xs font-medium bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm group"
        >
          <span>{actionButtonText}</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    )}
  </div>
</section>
