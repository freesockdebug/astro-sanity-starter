                  <div class="space-y-0.5 border-x border-black/5 px-2">
                    <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400 block truncate">{t('pdp.quickSeamLabel')}</span>
                    <span class="font-semibold text-zinc-900 truncate block text-[11px]">{t('pdp.quickSeamValue')}</span>
                  </div>
                  <div class="space-y-0.5 pl-1">
                    <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400 block truncate">{t('pdp.quickSamplingLabel')}</span>
