---
// src/pages/products/[slug].astro
import Layout from '@layouts/Layout.astro';
import { AppleProductDetailSkeleton, Breadcrumbs } from '@components/index';
import { client } from '@utils/sanity-client';
import { PRODUCT_FIELDS, PRODUCT_CARD_FIELDS, ProductService, resolveProductMoq, getCurrencySymbol } from '@data/products';
import { CONFIG_QUERY_OBJ, SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { cleanBrandTitle } from '@utils/text';
import { SanityImageService } from '@utils/image';
import { DEFAULT_BRAND_TITLE, DEFAULT_FALLBACK_IMAGE, DEFAULT_RFQ, DEFAULT_PRODUCT_DETAIL } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue, getLocalizedPath } from '@i18n';
import MarkdownRenderer from '@components/MarkdownRenderer.astro';
import { getProductStory } from '@data/productStories';
import { SecurityService } from '@utils/security';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const { slug } = Astro.params;

// Scheme 2: Single Aggregated GROQ Query - combines 4 independent API calls into 1 single roundtrip
let batchData: any = null;
try {
  batchData = await client.fetch(
    `{
      "product": *[_type == "product" && slug.current == $slug][0] ${PRODUCT_FIELDS},
      "allProducts": *[_type == "product"] | order(_createdAt asc) { "slug": slug.current, title, shortTitle },
      "siteConfig": *[_type == "siteConfig"][0] ${CONFIG_QUERY_OBJ},
      "rfqSettings": *[_type == "rfqSettings"][0],
      "productStorySettings": *[_type == "productStorySettings"][0]
    }`,
    { slug }
  );
} catch (e) {
  console.error(`Failed to batch-fetch product data for ${slug}:`, e);
}

// Pre-populate service caches unconditionally so Layout and QuoteDrawer make 0 additional API requests
SiteConfigService.seed(batchData?.siteConfig);
RfqSettingsService.seed(batchData?.rfqSettings);

const currentProduct = batchData?.product;
if (!currentProduct) {
  return Astro.redirect(getLocalizedPath('/#collections', currentLang));
}

const allProducts = batchData?.allProducts || [];

// Ensure product has fallbacks for arrays and images
currentProduct.gallery = (currentProduct.gallery && currentProduct.gallery.length > 0)
  ? currentProduct.gallery
  : [{ src: currentProduct.mainImage || DEFAULT_FALLBACK_IMAGE, alt: getLocalizedValue(currentProduct.title, currentLang) || 'Product' }];
currentProduct.colors = currentProduct.colors || [];
currentProduct.pricingTiers = currentProduct.pricingTiers || [];
currentProduct.specifications = currentProduct.specifications || [];
currentProduct.mainImage = currentProduct.mainImage || currentProduct.gallery[0]?.src || DEFAULT_FALLBACK_IMAGE;

const resolvedMoq = resolveProductMoq(currentProduct.pricingTiers, currentProduct.moq);
const currencySymbol = getCurrencySymbol(currentProduct.currency);
const unitPairLabel = t('catalog.unitPair');

const siteConfig = batchData?.siteConfig;
const rfqSettings = batchData?.rfqSettings;
const rawBrandTitle = siteConfig?.header?.title || DEFAULT_BRAND_TITLE;
const brandTitle = cleanBrandTitle(rawBrandTitle);

const currentIndex = allProducts.findIndex((p: any) => p.slug === slug);
const validIndex = currentIndex >= 0 ? currentIndex : 0;
const prevIndex = (validIndex - 1 + allProducts.length) % (allProducts.length || 1);
const nextIndex = (validIndex + 1) % (allProducts.length || 1);

const prevProduct = allProducts[prevIndex] || currentProduct;
const nextProduct = allProducts[nextIndex] || currentProduct;

const currentProductTitle = getLocalizedValue(currentProduct.title, currentLang);
const currentProductShortTitle = getLocalizedValue(currentProduct.shortTitle, currentLang) || currentProductTitle;
const currentProductTagline = getLocalizedValue(currentProduct.tagline, currentLang);
const prevProductTitle = getLocalizedValue(prevProduct.shortTitle || prevProduct.title, currentLang);
const nextProductTitle = getLocalizedValue(nextProduct.shortTitle || nextProduct.title, currentLang);

const addToQuoteBtnText = getLocalizedValue(
  currentProduct.addToQuoteButtonText,
  currentLang,
  getLocalizedValue(rfqSettings?.btnAddToQuoteText, currentLang, t('pdp.addToQuote'))
);

// Amazon Sample Buying Link Resolution
const rawAmazonUrl = currentProduct.amazonUrl || (currentProduct.amazonAsin ? `https://www.amazon.com/dp/${currentProduct.amazonAsin.trim()}` : null);
const amazonSampleUrl = rawAmazonUrl || rfqSettings?.defaultAmazonStoreUrl || `https://www.amazon.com/s?k=${encodeURIComponent(currentProductTitle || DEFAULT_BRAND_TITLE)}`;
const sampleButtonText = getLocalizedValue(
  currentProduct.sampleButtonText,
  currentLang,
  getLocalizedValue(rfqSettings?.btnSampleAmazonText, currentLang, t('pdp.buySampleAmazon'))
);

const showAddToQuoteButton = rfqSettings?.showProductAddToQuoteButton ?? true;
const showBuySampleButton = rfqSettings?.showProductBuySampleButton ?? true;
const showSpecSheetButton = rfqSettings?.showProductSpecSheetButton ?? true;

// Editorial Story Resolution (Multilingual Markdown with luxurious Craftsmanship Fallback)
const productStorySettings = batchData?.productStorySettings;

const currentProductStoryBadge = getLocalizedValue(
  currentProduct.storyBadge,
  currentLang,
  getLocalizedValue(productStorySettings?.storyBadgeText, currentLang, t('pdp.storyBadge'))
);

const currentProductStoryHeading = getLocalizedValue(
  currentProduct.storyHeading,
  currentLang,
  getLocalizedValue(productStorySettings?.storyHeading, currentLang, t('pdp.storyHeading'))
);

const CREDENTIAL_THEME: Record<string, { color: string; path: string; strokeWidth?: string }> = {
  oekotex: {
    color: 'text-emerald-700',
    path: 'M5 13l4 4L19 7',
    strokeWidth: '2.2',
  },
  lonati: {
    color: 'text-amber-700',
    path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    strokeWidth: '2.2',
  },
  seamless: {
    color: 'text-zinc-900',
    path: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
    strokeWidth: '2.2',
  },
  gauge: {
    color: 'text-blue-700',
    path: 'M4 6h16M4 10h16M4 14h16M4 18h16',
    strokeWidth: '2',
  },
  fiber: {
    color: 'text-indigo-700',
    path: 'M13 10V3L4 14h7v7l9-11h-7z',
    strokeWidth: '2',
  },
};

const DEFAULT_CREDENTIALS_BY_LANG: Record<string, Array<{ iconType: string; title: string; description: string; tag: string }>> = {
  de: [
    {
      iconType: 'lonati',
      title: 'Italienische Lonati-Kalibrierung',
      description: 'Hochdichte Doppelzylinder-Nadelteilung für reibungsfreien dimensionalen Sitz.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Handgekettelte nahtlose Spitze',
      description: 'Echte 0,0 mm Nahtebene gegen Scheuern und Druckstellen im Schuh.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Strenge unabhängige Laborprüfung auf schädliche aromatische Amine und Allergene.',
      tag: 'Klasse I'
    }
  ],
  fr: [
    {
      iconType: 'lonati',
      title: 'Calibrage Italien Lonati',
      description: 'Densité d\'aiguilles haute jauge double cylindre sans frottement dimensionnel.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Finition Sans Couture Remaillée Main',
      description: 'Plan de couture 0,0 mm éliminant les irritations et points de pression.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Contrôle rigoureux en laboratoire indépendant contre les allergènes et amines.',
      tag: 'Classe I'
    }
  ],
  es: [
    {
      iconType: 'lonati',
      title: 'Calibración Italiana Lonati',
      description: 'Densidad de agujas de doble cilindro de alta galga sin fricción dimensional.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Acabado Remallado a Mano Sin Costuras',
      description: 'Plano de costura de 0,0 mm que elimina rozaduras y puntos de presión.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Riguroso análisis de laboratorio independiente para detectar aminas y alérgenos.',
      tag: 'Clase I'
    }
  ],
  en: [
    {
      iconType: 'lonati',
      title: 'Italian Lonati Calibration',
      description: 'High-gauge dual-cylinder needle density with zero-friction dimensional architecture.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Hand-Linked Seamless Finish',
      description: 'True 0.0 mm seam plane eliminating ridge chafing and shoe pressure points.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Rigorous independent lab screening for harmful aromatic amines and allergens.',
      tag: 'Class I'
    }
  ]
};

const defaultCredentials = DEFAULT_CREDENTIALS_BY_LANG[currentLang] || DEFAULT_CREDENTIALS_BY_LANG.en;

const rawCards = (productStorySettings?.credentials && productStorySettings.credentials.length > 0)
  ? productStorySettings.credentials
  : defaultCredentials;

const resolvedCredentials = rawCards.map((card: any) => {
  const icon = CREDENTIAL_THEME[card.iconType] || CREDENTIAL_THEME.lonati;
  return {
    iconType: card.iconType || 'lonati',
    title: getLocalizedValue(card.title, currentLang, card.title || 'Artisan Standard'),
    description: getLocalizedValue(card.description, currentLang, card.description || ''),
    tag: getLocalizedValue(card.tag, currentLang, card.tag || ''),
    customSvg: card.customSvg || '',
    accentColor: icon.color,
    iconPath: icon.path,
    strokeWidth: icon.strokeWidth || '2',
  };
});

const rawProductStory = getLocalizedValue(currentProduct.story, currentLang);
const generatedStory = getProductStory(
  {
    title: currentProductTitle,
    sku: currentProduct.sku,
    category: currentProduct.category?.slug || currentProduct.category?.title || (typeof currentProduct.category === 'string' ? currentProduct.category : ''),
    image: currentProduct.mainImage || currentProduct.gallery?.[0]?.src,
    secondaryImage: currentProduct.gallery?.[1]?.src || currentProduct.gallery?.[0]?.src || currentProduct.mainImage,
    composition: currentProduct.specifications?.[0]?.value,
    gauge: currentProduct.specifications?.[1]?.value,
    specifications: currentProduct.specifications,
  },
  currentLang
);

const storyMarkdown = (rawProductStory && typeof rawProductStory === 'string' && rawProductStory.trim().length > 0)
  ? rawProductStory
  : generatedStory;

const firstGalleryImg = currentProduct.gallery?.[0]?.src || currentProduct.mainImage;
const productHeroPreload = firstGalleryImg && typeof firstGalleryImg && (firstGalleryImg.includes('cdn.sanity.io') || firstGalleryImg.includes('/cdn-image/'))
  ? {
      src: SanityImageService.hero(firstGalleryImg, 1200),
      srcset: SanityImageService.srcSet(firstGalleryImg, [480, 800, 1200]),
      sizes: '(max-width: 1024px) 100vw, 800px',
    }
  : undefined;
const numericPrices = (currentProduct.pricingTiers || [])
  .map((tier: any) => {
    const raw = typeof tier?.price === 'string' ? tier.price.replace(/[^0-9.]/g, '') : String(tier?.price ?? '');
    return parseFloat(raw);
  })
  .filter((n: number) => !Number.isNaN(n) && n > 0);

const productStructuredData: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: currentProductTitle,
  description: currentProductTagline,
  sku: currentProduct.sku || slug,
  image: (currentProduct.gallery || [])
    .map((img: any) => img?.src)
    .filter(Boolean),
  brand: {
    '@type': 'Brand',
    name: brandTitle,
  },
  ...(numericPrices.length > 0
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: currentProduct.currency || 'USD',
          lowPrice: Math.min(...numericPrices).toFixed(2),
          highPrice: Math.max(...numericPrices).toFixed(2),
          offerCount: numericPrices.length,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<Layout
  title={currentProductTitle}
  description={currentProductTagline}
  image={currentProduct.mainImage}
  type="product"
  structuredData={productStructuredData}
  preloadHeroImage={productHeroPreload}
>
  <!-- Apple-Style Compact Sub-Navigation & Breadcrumbs with Prev / Next Switcher -->
  <Breadcrumbs currentTitle={currentProductShortTitle}>
    {allProducts.length > 1 && (
      <div slot="actions" class="flex items-center gap-1.5 shrink-0 text-xs font-medium font-sans">
        <a
          href={getLocalizedPath(`/products/${prevProduct.slug}`, currentLang)}
          data-pdp-nav-link
          class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
          title={`${t('pdp.prev')}: ${prevProductTitle}`}
        >
          <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="hidden sm:inline text-[11px]">{t('pdp.prev')}</span>
        </a>

        <span class="text-[11px] font-mono tabular-nums text-zinc-400 select-none px-0.5">
          {validIndex + 1} / {allProducts.length}
        </span>

        <a
          href={getLocalizedPath(`/products/${nextProduct.slug}`, currentLang)}
          data-pdp-nav-link
          class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
          title={`${t('pdp.next')}: ${nextProductTitle}`}
        >
          <span class="hidden sm:inline text-[11px]">{t('pdp.next')}</span>
          <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    )}
  </Breadcrumbs>

  <!-- Instant Perceived Performance Skeleton Overlay for Silhouette Navigation -->
  <AppleProductDetailSkeleton id="pdp-transition-skeleton" class="hidden" />

  <div id="pdp-live-content">
  <section id="product-overview" class="product-hero-overview w-full pt-3 pb-6 sm:pt-4 sm:pb-8 lg:pt-4 lg:pb-8 border-b border-black/5 bg-white overflow-visible scroll-mt-[var(--apple-header-offset)] flex flex-col justify-start">

        <!-- Center: 2-Column Showcase Grid -->
        <div class="apple-rail-bento w-full">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-8 items-start">
            
            <!-- LEFT: Apple-Style Multi-Image Carousel / Gallery (7 Cols for Balanced Ratio) -->
            <div class="product-gallery-col w-full min-w-0 lg:col-span-7 flex flex-col justify-start">
              <div class="flex flex-col lg:flex-row gap-2.5 sm:gap-3 lg:gap-3.5 items-start">
                
                <!-- Thumbnail Gallery (Desktop: Left Vertical Column; Mobile: Bottom Horizontal Scroll) -->
                <div class="order-2 lg:order-1 flex flex-row lg:flex-col gap-2 overflow-x-auto lg:overflow-y-auto no-scrollbar shrink-0 w-full lg:w-auto max-w-full pb-1 lg:pb-0 scrollbar-none justify-start lg:max-h-[min(72vh,700px)]">
                  {currentProduct.gallery.map((img: any, idx: number) => (
                    <button
                      type="button"
                      data-thumb-index={idx}
                      aria-label={`View image ${idx + 1}`}
                      class={`carousel-thumb shrink-0 w-14 h-14 sm:w-15 sm:h-15 lg:w-[68px] lg:h-[68px] xl:w-[74px] xl:h-[74px] rounded-xl overflow-hidden border-2 transition-all duration-200 cursor-pointer bg-[#fafafa] apple-skeleton-surface flex items-center justify-center ${idx === 0 ? 'border-zinc-950 scale-102 ring-2 ring-zinc-950/20' : 'border-zinc-200/80 hover:border-zinc-400 opacity-70 hover:opacity-100'}`}
                    >
                      <img
                        src={SanityImageService.thumbnail(img.src, 160)}
                        alt={img.alt || currentProductTitle}
                        class="pdp-gallery-img w-full h-full object-contain p-0.5"
                        loading="lazy"
                        decoding="async"
                        onload="this.parentElement && this.parentElement.classList.add('apple-img-loaded')"
                      />
                    </button>
                  ))}
                </div>

                <!-- Main Viewport Box with Controls (Strict Responsive Aspect Ratio: Fluid & Adaptive to Screen Height) -->
                <div class="order-1 lg:order-2 relative w-full max-w-full flex-1 min-w-0 aspect-square sm:aspect-square lg:aspect-square max-h-[min(72vh,700px)] rounded-2xl overflow-hidden bg-[#fafafa] border border-zinc-200/80 shadow-xs group flex items-center justify-center">
                  <!-- Carousel Images Track (Native Scroll Snap for Silky Mobile Touch Swipe & Desktop Fluidity) -->
                  <div 
                    id="carousel-track" 
                    class="w-full h-full flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth relative select-none touch-pan-x min-w-0 min-h-0"
                    style="scrollbar-width: none; -ms-overflow-style: none;"
                  >
                    {currentProduct.gallery.map((img: any, idx: number) => (
                      <div
                        class="carousel-slide shrink-0 w-full h-full snap-center relative overflow-hidden apple-skeleton-surface flex items-center justify-center min-w-0 min-h-0"
                        data-index={idx}
                      >
                        <img
                          src={SanityImageService.hero(img.src, 1200)}
                          srcset={SanityImageService.srcSet(img.src, [480, 800, 1200]) || undefined}
                          sizes="(max-width: 1024px) 100vw, 800px"
                          alt={img.alt || currentProductTitle}
                          class="pdp-gallery-img absolute inset-0 m-auto max-w-[calc(100%-0.75rem)] sm:max-w-[calc(100%-1.5rem)] max-h-[calc(100%-0.75rem)] sm:max-h-[calc(100%-1.5rem)] w-auto h-auto object-contain pointer-events-none select-none"
                          draggable="false"
                          loading={idx === 0 ? 'eager' : 'lazy'}
                          fetchpriority={idx === 0 ? 'high' : 'auto'}
                          decoding="async"
                          onload="this.parentElement && this.parentElement.classList.add('apple-img-loaded')"
                        />
                      </div>
                    ))}
                  </div>

                  <!-- Top Indicator Badges -->
                  <div class="absolute top-3 left-3 z-20 flex items-center gap-1.5 sm:gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-white/90 backdrop-blur-md text-zinc-900 border border-zinc-200/80 shadow-xs font-semibold">
                      SKU: {currentProduct.sku}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-zinc-900 text-white shadow-xs font-medium">
                      {resolvedMoq.formatted}
                    </span>
                  </div>

                  <!-- Counter Badge -->
                  <div class="absolute top-3 right-3 z-20 px-2 py-0.5 rounded-full text-[10px] font-mono bg-black/60 backdrop-blur-md text-white shadow-xs">
                    <span id="carousel-counter-curr">1</span> / <span id="carousel-counter-total">{currentProduct.gallery.length}</span>
                  </div>

                  <!-- Mobile Pagination Dots (Visual swipe indicator for touch devices) -->
                  {currentProduct.gallery.length > 1 && (
                    <div class="sm:hidden absolute bottom-2.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/35 backdrop-blur-md pointer-events-none">
                      {currentProduct.gallery.map((_: any, idx: number) => (
                        <span 
                          class={`carousel-dot h-1.5 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-white w-3' : 'bg-white/50 w-1.5'}`} 
                          data-dot-index={idx}
                        />
                      ))}
                    </div>
                  )}

                  <!-- Navigation Arrow Controls (Desktop only, hidden on mobile for clean touch experience) -->
                  {currentProduct.gallery.length > 1 && (
                    <>
                      <button
                        type="button"
                        id="carousel-prev"
                        aria-label={t('pdp.prev')}
                        class="hidden sm:flex absolute left-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-zinc-900 shadow-sm backdrop-blur-md items-center justify-center transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        id="carousel-next"
                        aria-label={t('pdp.next')}
                        class="hidden sm:flex absolute right-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-zinc-900 shadow-sm backdrop-blur-md items-center justify-center transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                        </svg>
                      </button>
                    </>
                  )}
                </div>

              </div>

              <p class="text-[10px] text-zinc-400 font-mono text-center lg:text-left mt-1.5 shrink-0">
                {getLocalizedValue(currentProduct.galleryHint, currentLang, t('pdp.galleryHint'))}
              </p>
            </div>

            <!-- RIGHT: Product Info, Tiered Wholesale Pricing & B2B Actions (5 Cols for Snug Symmetry) -->
            <div class="product-info-col w-full min-w-0 lg:col-span-5 flex flex-col justify-start space-y-3 sm:space-y-3.5 xl:space-y-4">
              <!-- Header Info -->
              <div class="space-y-1 xl:space-y-1.5 shrink-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-zinc-100 text-zinc-800 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>{getLocalizedValue(currentProduct.statusBadge, currentLang, t('pdp.statusBadge'))}</span>
                  </span>
                  {currentProduct.rating && (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-stone-100 text-stone-700 border border-stone-200/60">
                      {currentProduct.rating}
                    </span>
                  )}
                </div>
                <h1 class="text-xl sm:text-2xl xl:text-3xl font-bold tracking-tight text-zinc-950 leading-snug">
                  {currentProductTitle}
                </h1>
                <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed line-clamp-2 sm:line-clamp-none">
                  {currentProductTagline}
                </p>
              </div>

              <!-- Tiered Wholesale Pricing Matrix (Compact) -->
              <div class="pricing-tier-card p-3 sm:p-3.5 xl:p-4 rounded-xl xl:rounded-2xl bg-[#fbf9f5] border border-zinc-200/80 space-y-1.5 shrink-0">
                <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono uppercase tracking-wider">
                  <span>{t('pdp.wholesaleTiers')}</span>
                  <span>{t('pdp.unitPrice')}</span>
                </div>
                <div class="space-y-1 xl:space-y-1.5">
