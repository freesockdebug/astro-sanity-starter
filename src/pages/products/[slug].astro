                      <span class="text-zinc-950 font-bold font-mono text-xs sm:text-sm">
                        {tier.price}{tier.unit ? ` / ${unitPairLabel}` : ''}
                      </span>
                    </div>
                  ))}
                </div>
                <p class="text-[10px] text-zinc-400 font-mono pt-0.5">
                  {getLocalizedValue(currentProduct.priceNote, currentLang, t('pdp.priceNote'))}
