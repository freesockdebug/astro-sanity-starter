---
// src/components/AppleProductDetailSkeleton.astro
interface Props {
  id?: string;
  class?: string;
}

const {
  id = 'pdp-skeleton',
  class: className = '',
} = Astro.props;

const thumbItems = [0, 1, 2, 3, 4];
const tierItems = [0, 1, 2];
const specCards = [0, 1, 2, 3, 4, 5];
---

<div
  id={id}
  role="status"
  aria-label="Loading product specifications and media"
  aria-busy="true"
  class:list={['apple-pdp-skeleton w-full bg-white select-none pointer-events-none', className]}
>
  <!-- 1. First-Screen Hero Overview Skeleton (Matches 12-Col Bento Split below Layout Breadcrumbs) -->
  <section class="w-full pt-4 pb-8 sm:pt-6 sm:pb-10 lg:pt-6 lg:pb-12 border-b border-black/5 bg-white">
    <!-- Center 12-Column Split Grid Skeleton -->
    <div class="apple-rail-bento">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-8 items-start">
        <!-- LEFT 7 COLS: Vertical Thumbnail Rail + Main Gallery Viewport -->
        <div class="w-full min-w-0 lg:col-span-7 flex flex-col justify-start">
          <div class="flex flex-col lg:flex-row gap-2.5 sm:gap-3 lg:gap-3.5 items-start">
            <!-- Thumbnail Strip -->
            <div class="order-2 lg:order-1 flex flex-row lg:flex-col gap-2 shrink-0">
              {thumbItems.map((idx) => (
                <div
                  class:list={[
                    'shrink-0 w-14 h-14 sm:w-15 sm:h-15 lg:w-[68px] lg:h-[68px] xl:w-[74px] xl:h-[74px] rounded-xl apple-skeleton',
                    idx === 0 ? 'ring-2 ring-black/15' : 'opacity-75',
                  ]}
                ></div>
              ))}
            </div>

            <!-- Main Gallery Stage -->
            <div class="order-1 lg:order-2 relative w-full flex-1 aspect-square sm:aspect-[4/3] lg:aspect-[4/3] rounded-2xl overflow-hidden apple-skeleton border border-black/5">
              <!-- Top SKU & MOQ Pill Placeholders -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <div class="h-5 w-24 rounded-full bg-white/80"></div>
                <div class="h-5 w-20 rounded-full bg-black/15"></div>
              </div>
              <!-- Top-Right Counter Pill Placeholder -->
              <div class="absolute top-3 right-3 h-5 w-11 rounded-full bg-black/15"></div>
            </div>
          </div>
        </div>

        <!-- RIGHT 5 COLS: Product Header, Volume Tier Pricing Matrix, Color Swatches & CTA Buttons -->
        <div class="lg:col-span-5 flex flex-col justify-start space-y-3.5 sm:space-y-4 bg-[#f5f5f7]/60 rounded-2xl p-4 sm:p-5 border border-black/5">
          <div class="space-y-2.5">
            <!-- Category & Lead-Time Badges -->
            <div class="flex items-center justify-between gap-2">
              <div class="h-4 w-24 rounded-full apple-skeleton-warm"></div>
              <div class="h-4 w-28 rounded-full apple-skeleton-warm"></div>
            </div>

            <!-- Product Title & Tagline -->
            <div class="space-y-1.5 pt-1">
              <div class="h-6 sm:h-7 w-4/5 rounded-lg apple-skeleton-warm"></div>
              <div class="h-3.5 w-full rounded-md apple-skeleton-warm"></div>
              <div class="h-3.5 w-2/3 rounded-md apple-skeleton-warm"></div>
            </div>

            <!-- Tiered Bulk Pricing Card Skeleton -->
            <div class="rounded-xl bg-white p-3 border border-black/5 space-y-2.5 mt-2">
              <div class="flex items-center justify-between">
                <div class="h-3 w-28 rounded-sm apple-skeleton"></div>
                <div class="h-3 w-16 rounded-sm apple-skeleton"></div>
              </div>
              <div class="grid grid-cols-3 gap-2 pt-1">
                {tierItems.map(() => (
                  <div class="rounded-lg bg-[#f5f5f7] p-2.5 space-y-1.5 border border-black/[0.04]">
                    <div class="h-2.5 w-12 rounded-sm apple-skeleton-warm"></div>
                    <div class="h-5 w-16 rounded-md apple-skeleton-warm"></div>
                    <div class="h-2 w-10 rounded-sm apple-skeleton-warm"></div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Colorway Selector Swatches Skeleton -->
            <div class="space-y-2 pt-1">
              <div class="flex items-center justify-between">
                <div class="h-3 w-24 rounded-sm apple-skeleton-warm"></div>
                <div class="h-3 w-16 rounded-sm apple-skeleton-warm"></div>
              </div>
              <div class="flex items-center gap-2">
                {thumbItems.map(() => (
                  <div class="w-7 h-7 rounded-full apple-skeleton-warm border border-black/10"></div>
                ))}
              </div>
            </div>
          </div>

          <!-- Primary & Secondary Action Buttons Skeleton -->
          <div class="space-y-2 pt-2 border-t border-black/5">
            <div class="h-10 w-full rounded-full apple-skeleton-warm"></div>
            <div class="grid grid-cols-2 gap-2">
              <div class="h-9 w-full rounded-full apple-skeleton-warm"></div>
              <div class="h-9 w-full rounded-full apple-skeleton-warm"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Below-the-Fold Technical Specifications Bento Grid Skeleton -->
  <section class="py-8 sm:py-12 bg-[#f5f5f7]/50 border-b border-black/5">
    <div class="apple-rail-bento space-y-6">
      <div class="text-center space-y-2 max-w-lg mx-auto">
        <div class="h-3 w-24 rounded-full apple-skeleton mx-auto"></div>
        <div class="h-6 w-64 rounded-lg apple-skeleton mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
        {specCards.map(() => (
          <div class="rounded-2xl bg-white p-4 sm:p-5 border border-black/5 space-y-2">
            <div class="h-3 w-24 rounded-sm apple-skeleton"></div>
            <div class="h-4 w-3/4 rounded-md apple-skeleton"></div>
            <div class="h-3 w-1/2 rounded-sm apple-skeleton"></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>
