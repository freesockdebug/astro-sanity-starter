---
// src/pages/admin/members.astro
// Enterprise Team Member Management with Logto User Pool Integration (Saltline Compressed)
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext, getRuntimeEnv } from '@utils/auth';
import { listAdminMembers, listAdminRoles } from '@utils/db';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/members',
  { requiredMenu: 'members' }
);
if (redirectResponse) return redirectResponse;

const rootAdminEmailsRaw = getRuntimeEnv('ADMIN_EMAILS', cfEnv) || 'forhaisome@gmail.com';
const rootAdminEmails = rootAdminEmailsRaw.split(',').map((e: string) => e.trim().toLowerCase()).filter(Boolean);

const [members, roles] = await Promise.all([
  listAdminMembers().catch(() => []),
  listAdminRoles().catch(() => []),
]);
---

<AdminLayout
  title="Team Members Management"
  currentTab="members"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <AdminPageToolbar
      title="Team Members"
      subtitle={`· ${members.length + rootAdminEmails.length} staff accounts`}
      badge="Logto Connected"
      badgeColor="blue"
    >
      <div slot="actions" class="flex items-center gap-2">
        <button type="button" id="btn-open-add-dialog" class="adm-btn-primary h-8">
          <span>＋ Add Member</span>
        </button>
      </div>
    </AdminPageToolbar>

    <div class="flex-1 min-h-0 adm-card p-4 sm:p-5 overflow-y-auto">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse" id="members-table">
          <thead>
            <tr class="border-b border-black/10">
              <th class="adm-th pb-3">Team Member</th>
              <th class="adm-th pb-3">Logto Binding</th>
              <th class="adm-th pb-3">Assigned Role</th>
              <th class="adm-th pb-3">Data Scope</th>
              <th class="adm-th pb-3">Active Workload</th>
              <th class="adm-th pb-3">Last Active</th>
              <th class="adm-th pb-3">Status</th>
              <th class="adm-th pb-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            {rootAdminEmails.map((email: string) => (
              <tr class="bg-amber-50/30">
                <td class="adm-td">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-xs uppercase shrink-0">{email[0]}</div>
                    <div>
                      <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-[#1d1d1f]">{email.split('@')[0]}</span>
                        <span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-100 text-amber-900 font-bold uppercase">Root Env</span>
                      </div>
                      <span class="text-[#86868b] font-mono text-[11px]">{email}</span>
                    </div>
                  </div>
                </td>
                <td class="adm-td">
                  <span class="adm-badge bg-emerald-50 text-emerald-800 border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Logto Synced</span>
                </td>
                <td class="adm-td font-semibold text-amber-900">超级管理员 (Super Admin)</td>
                <td class="adm-td text-[#52525b]"><span class="px-2 py-0.5 rounded-md text-[10px] bg-black/5 font-mono">ALL (全量)</span></td>
                <td class="adm-td text-[#86868b] italic">Full Workspace Access</td>
                <td class="adm-td text-[#86868b]">Root Security Principal</td>
                <td class="adm-td"><span class="text-emerald-700 font-semibold">ACTIVE</span></td>
                <td class="adm-td text-right text-[#86868b] font-mono text-[11px]">Fixed Root</td>
              </tr>
            ))}

            {members.map((m: any) => (
              <tr class="hover:bg-[#fbfbfd] transition-colors">
                <td class="adm-td">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center font-bold text-xs uppercase shrink-0">{(m.name || m.email)[0]}</div>
                    <div>
                      <span class="font-semibold text-[#1d1d1f] block">{m.name || m.email.split('@')[0]}</span>
                      <span class="text-[#86868b] font-mono text-[11px] block">{m.email}</span>
                    </div>
                  </div>
                </td>
                <td class="adm-td">
                  {m.is_logto_synced ? (
                    <span class="adm-badge bg-emerald-50 text-emerald-800 border-emerald-200" title="Account has signed in via Logto"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Logto Synced</span>
                  ) : (
                    <span class="adm-badge bg-amber-50 text-amber-800 border-amber-200" title="Pre-authorized: will auto-bind on user's first Logto sign-in"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pending Logto Login</span>
                  )}
                </td>
                <td class="adm-td">
                  <select
                    class="select-member-role text-xs rounded-lg px-2 py-1 bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black font-semibold text-[#1d1d1f] cursor-pointer"
                    data-email={m.email}
                    data-status={m.status}
                    data-name={m.name}
                  >
                    {roles.map((r: any) => (
                      <option value={r.code} selected={m.role_code === r.code}>{r.name} ({r.code})</option>
                    ))}
                  </select>
                </td>
                <td class="adm-td"><span class="px-2 py-0.5 rounded-md text-[10px] bg-black/5 font-mono text-[#52525b]">{m.role?.data_scope || 'ALL'}</span></td>
                <td class="adm-td">
                  <div class="flex items-center gap-2">
                    <a href={`/admin/orders?assignedTo=${encodeURIComponent(m.email)}`} class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-blue-50 text-blue-800 border border-blue-200 hover:bg-blue-100 transition-colors" title="View orders assigned to this rep">📦 {m.assigned_orders || 0}</a>
                    <a href={`/admin/users?assignedTo=${encodeURIComponent(m.email)}`} class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-purple-50 text-purple-800 border border-purple-200 hover:bg-purple-100 transition-colors" title="View customers assigned to this rep">👥 {m.assigned_customers || 0}</a>
                  </div>
                </td>
                <td class="adm-td text-[#86868b] text-[11px]">
                  {m.last_login_at ? (
                    <div>
                      <span class="text-[#1d1d1f] block">{m.last_login_at.slice(0, 16)}</span>
                      {m.last_location && <span class="text-[10px]">📍 {m.last_location}</span>}
                    </div>
                  ) : (
                    <span class="italic text-zinc-400">Never signed in</span>
                  )}
                </td>
                <td class="adm-td">
                  <span class:list={['px-2 py-0.5 rounded-full text-[10px] font-bold border', m.status === 'ACTIVE' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-rose-50 text-rose-800 border-rose-200']}>{m.status}</span>
                </td>
                <td class="adm-td text-right space-x-2">
                  <button type="button" class="btn-toggle-status text-blue-600 hover:underline cursor-pointer" data-email={m.email} data-status={m.status === 'ACTIVE' ? 'DISABLED' : 'ACTIVE'} data-name={m.name} data-role={m.role_code}>
                    {m.status === 'ACTIVE' ? 'Disable' : 'Enable'}
                  </button>
                  <button type="button" class="btn-delete-member text-rose-600 hover:underline cursor-pointer" data-email={m.email}>Remove</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="modals">
    <dialog id="add-member-dialog" class="rounded-2xl p-0 shadow-2xl border border-black/10 backdrop:bg-black/40 max-w-md w-full mx-auto">
      <div class="p-5 space-y-4 bg-white">
        <div class="flex items-center justify-between pb-3 border-b border-black/5">
          <div>
            <h3 class="text-sm font-bold text-[#1d1d1f]">Add Team Member</h3>
            <p class="text-[11px] text-[#86868b] mt-0.5">Authorize a Logto user as an internal team member</p>
          </div>
          <button type="button" id="close-add-dialog" class="text-zinc-400 hover:text-black cursor-pointer text-base">✕</button>
        </div>

        <div class="flex items-center gap-1 bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5">
          <button type="button" id="tab-choose-logto" class="flex-1 py-1 rounded-lg text-xs font-semibold bg-white text-[#1d1d1f] shadow-2xs transition-all cursor-pointer">Select Logto User</button>
          <button type="button" id="tab-manual-email" class="flex-1 py-1 rounded-lg text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] transition-all cursor-pointer">Pre-authorize Email</button>
        </div>

        <div id="section-logto-picker" class="space-y-2">
          <label class="adm-label">Search Registered Logto Accounts</label>
          <input type="text" id="candidate-search-input" placeholder="Search by name or email..." class="adm-input" />
          <div id="candidates-loading" class="text-[11px] text-[#86868b] hidden">Loading accounts...</div>
          <div id="candidates-list" class="max-h-48 overflow-y-auto divide-y divide-black/5 border border-black/10 rounded-xl bg-white hidden"></div>
        </div>

        <div class="space-y-3">
          <div>
            <label class="adm-label">Staff Member Email *</label>
            <input type="email" id="input-member-email" placeholder="e.g. alice@gwenvenni.com" class="adm-input font-mono" />
          </div>
          <div>
            <label class="adm-label">Display Name</label>
            <input type="text" id="input-member-name" placeholder="e.g. Alice Wang - Europe Lead" class="adm-input" />
          </div>
          <div>
            <label class="adm-label">Assigned Role *</label>
            <select id="select-member-role" class="adm-input font-medium cursor-pointer">
              {roles.map((r: any) => (
                <option value={r.code}>{r.name} ({r.code}) - {r.data_scope}</option>
              ))}
            </select>
          </div>
        </div>

        <div id="add-member-error" class="hidden p-2.5 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200"></div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-black/5">
          <button type="button" id="cancel-add-dialog" class="adm-btn-secondary h-8">Cancel</button>
          <button type="button" id="submit-add-member" class="adm-btn-primary h-8">Authorize Member</button>
        </div>
      </div>
    </dialog>
  </Fragment>
</AdminLayout>

<script>
  import { $id, $val, escapeHtml } from '@utils/adminWorkbench';

  function initMembersPage() {
    const addDialog = $id<HTMLDialogElement>('add-member-dialog');
    if (!addDialog) return;

    const toast = (msg: string, ok = true) => (window as any).__showToast?.(msg, ok ? 'success' : 'error');
    const errorEl = $id('add-member-error');
    const candidatesLoading = $id('candidates-loading');
    const candidatesList = $id('candidates-list');
    const candidateInput = $id<HTMLInputElement>('candidate-search-input');

    const upsertMember = async (payload: { email: string; name?: string; roleCode?: string; status?: string }, successMsg: string) => {
      const res = await fetch('/api/admin/members', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data: any = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Operation failed');
      toast(successMsg);
      setTimeout(() => window.location.reload(), 400);
    };

    const loadCandidates = async (search: string) => {
      if (!candidatesList) return;
      candidatesLoading?.classList.remove('hidden');
      try {
        const res = await fetch(`/api/admin/members?candidates=true&search=${encodeURIComponent(search)}`);
        const data: any = await res.json();
        candidatesLoading?.classList.add('hidden');
        if (!res.ok || !data.candidates) return;
        if (!data.candidates.length) {
          candidatesList.innerHTML = `<div class="p-3 text-center text-xs text-[#86868b]">No Logto accounts found matching "${escapeHtml(search)}".</div>`;
          candidatesList.classList.remove('hidden');
          return;
        }
        candidatesList.innerHTML = data.candidates.map((c: any) => {
          const safeEmail = escapeHtml(c.email);
          const safeName = escapeHtml(c.name || c.email.split('@')[0]);
          const isMember = Boolean(c.is_member);
          return `<div class="candidate-row p-2.5 hover:bg-[#f5f5f7] cursor-pointer flex items-center justify-between transition-colors ${isMember ? 'opacity-50' : ''}" data-email="${safeEmail}" data-name="${escapeHtml(c.name || '')}">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-semibold text-xs text-[#1d1d1f]">${safeName}</span>
                ${isMember ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-black/5 text-[#86868b]">Already Member</span>' : ''}
              </div>
              <span class="text-[11px] font-mono text-[#86868b]">${safeEmail}</span>
            </div>
            <span class="text-[10px] text-[#86868b]">${c.last_login_at ? escapeHtml(c.last_login_at.slice(0, 10)) : 'No login'}</span>
          </div>`;
        }).join('');
        candidatesList.classList.remove('hidden');
      } catch {
        candidatesLoading?.classList.add('hidden');
      }
    };

    candidatesList?.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.candidate-row');
      if (!row) return;
      $val('input-member-email', row.dataset.email || '');
      $val('input-member-name', row.dataset.name || '');
      candidatesList.classList.add('hidden');
    });

    $id('btn-open-add-dialog')?.addEventListener('click', () => {
      errorEl?.classList.add('hidden');
      $val('input-member-email', '');
      $val('input-member-name', '');
      $val('candidate-search-input', '');
      loadCandidates('');
      addDialog.showModal();
    });

    const closeModal = () => addDialog.close();
    $id('close-add-dialog')?.addEventListener('click', closeModal);
    $id('cancel-add-dialog')?.addEventListener('click', closeModal);

    const tabChoose = $id('tab-choose-logto');
    const tabManual = $id('tab-manual-email');
    const pickerSec = $id('section-logto-picker');
    const setTab = (chooseLogto: boolean) => {
      if (tabChoose) tabChoose.className = chooseLogto ? 'flex-1 py-1 rounded-lg text-xs font-semibold bg-white text-[#1d1d1f] shadow-2xs transition-all cursor-pointer' : 'flex-1 py-1 rounded-lg text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] transition-all cursor-pointer';
      if (tabManual) tabManual.className = !chooseLogto ? 'flex-1 py-1 rounded-lg text-xs font-semibold bg-white text-[#1d1d1f] shadow-2xs transition-all cursor-pointer' : 'flex-1 py-1 rounded-lg text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] transition-all cursor-pointer';
      pickerSec?.classList.toggle('hidden', !chooseLogto);
    };
    tabChoose?.addEventListener('click', () => setTab(true));
    tabManual?.addEventListener('click', () => setTab(false));

    let debounceTimer: any = null;
    candidateInput?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => loadCandidates(candidateInput.value.trim()), 250);
    });

    $id('submit-add-member')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const email = $val('input-member-email').toLowerCase();
      if (!email || !email.includes('@')) {
        if (errorEl) { errorEl.textContent = 'Please enter a valid email address.'; errorEl.classList.remove('hidden'); }
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Saving...';
      try {
        await upsertMember({ email, name: $val('input-member-name'), roleCode: $val('select-member-role'), status: 'ACTIVE' }, `Member ${email} authorized successfully!`);
        closeModal();
      } catch (err: any) {
        if (errorEl) { errorEl.textContent = err.message || 'Network error'; errorEl.classList.remove('hidden'); }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Authorize Member';
      }
    });

    document.querySelectorAll<HTMLSelectElement>('.select-member-role').forEach((sel) => {
      sel.addEventListener('change', async () => {
        const email = sel.dataset.email;
        if (!email) return;
        sel.disabled = true;
        try {
          await upsertMember({ email, roleCode: sel.value, status: sel.dataset.status || 'ACTIVE', name: sel.dataset.name || '' }, `Role updated to ${sel.value}. Refreshing...`);
        } catch (err: any) {
          toast(err.message, false);
          sel.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-toggle-status').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email;
        if (!email) return;
        try {
          await upsertMember({ email, status: btn.dataset.status, roleCode: btn.dataset.role, name: btn.dataset.name || '' }, `Member status changed to ${btn.dataset.status}`);
        } catch (err: any) {
          toast(err.message, false);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-delete-member').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email;
        if (!email || !confirm(`Are you sure you want to remove team member ${email}?`)) return;
        try {
          const res = await fetch(`/api/admin/members/${encodeURIComponent(email)}`, { method: 'DELETE' });
          const data: any = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'Failed to remove member');
          toast(`Member ${email} removed.`);
          setTimeout(() => window.location.reload(), 400);
        } catch (err: any) {
          toast(err.message, false);
        }
      });
    });
  }

  initMembersPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('btn-open-add-dialog')) initMembersPage();
  });
</script>