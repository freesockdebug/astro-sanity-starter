---
// src/pages/index.astro
import Layout from '@layouts/Layout.astro';
import SockHero from '@components/hosiery/SockHero.astro';
import SockSpecMatrix from '@components/hosiery/SockSpecMatrix.astro';
import SockCollections from '@components/hosiery/SockCollections.astro';
import ManufacturingCapabilities from '@components/hosiery/ManufacturingCapabilities.astro';
import SwatchInquiry from '@components/hosiery/SwatchInquiry.astro';
import CustomSection from '@components/hosiery/CustomSection.astro';
import { client } from '@utils/sanity-client';
import { SECTIONS, IMAGE } from '@data/blocks';

export const prerender = false;

// Query live Homepage content from Sanity using shared SECTIONS and IMAGE blocks
let homeData = null;
try {
  homeData = await client.fetch(`*[_type == "page" && slug.current == "/"][0]{
    title,
    metaTitle,
    metaDescription,
    socialImage ${IMAGE},
    sections[]${SECTIONS}
  }`);
} catch (e) {
  console.error("Failed to fetch homeData from Sanity:", e);
}

const sections = homeData?.sections || [];

const componentMap: Record<string, any> = {
  heroSection: SockHero,
  featureMatrixSection: SockSpecMatrix,
  productShowcaseSection: SockCollections,
  manufacturingSection: ManufacturingCapabilities,
  inquirySection: SwatchInquiry,
  customSection: CustomSection,
  // Backward compatibility
  hosieryHeroSection: SockHero,
  hosierySpecSection: SockSpecMatrix,
  hosieryCollectionSection: SockCollections,
  hosieryManufacturingSection: ManufacturingCapabilities,
  hosieryInquirySection: SwatchInquiry,
};

const heroSection = sections.find((s: any) => s._type === 'heroSection' || s._type === 'hosieryHeroSection');
const metaTitle = homeData?.metaTitle || "Gwenvenni Luxury Atelier | 200-Needle Luxury B2B Wholesale";
const metaDescription = homeData?.metaDescription || "Specialized manufacturer of 200-needle luxury apparel, fine silks, cashmere, and seamless essentials. Low MOQ, rapid 48h swatch dispatch, and full OEM/ODM customization.";
const ogImage = homeData?.socialImage?.src || heroSection?.heroImage || "/images/hero-light.jpg";
---

<Layout title={metaTitle} description={metaDescription} image={ogImage} addTitleSuffix={false}>
  {sections.map((section: any) => {
    const Component = componentMap[section._type];
    return Component ? <Component {...section} /> : null;
  })}
</Layout>
