      },
    });

    const metricTotal = document.getElementById('metric-total');
    const metricErrors = document.getElementById('metric-errors');
    const metricWarns = document.getElementById('metric-warns');
    const metricSlow = document.getElementById('metric-slow');

    const detailModal = document.getElementById('log-detail-modal') as HTMLDialogElement | null;
    const modalLevelBadge = document.getElementById('modal-level-badge');
    const modalEventCode = document.getElementById('modal-event-code');
    const modalSource = document.getElementById('modal-source');
    const modalMessage = document.getElementById('modal-message');
    const modalTime = document.getElementById('modal-time');
    const modalRay = document.getElementById('modal-ray');
    const modalPath = document.getElementById('modal-path');
    const modalHttp = document.getElementById('modal-http');
    const modalLatency = document.getElementById('modal-latency');
    const modalUser = document.getElementById('modal-user');
    const modalIp = document.getElementById('modal-ip');
    const modalGeo = document.getElementById('modal-geo');
    const modalSpansContainer = document.getElementById('modal-spans-container');
    const modalSpansList = document.getElementById('modal-spans-list');
    const modalBreadcrumbsContainer = document.getElementById('modal-breadcrumbs-container');
    const modalBreadcrumbsList = document.getElementById('modal-breadcrumbs-list');
    const modalBreadcrumbsCount = document.getElementById('modal-breadcrumbs-count');
    const modalContext = document.getElementById('modal-context');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const closeModalBottomBtn = document.getElementById('close-modal-bottom-btn');

    const clearConfirmModal = document.getElementById('clear-confirm-modal') as HTMLDialogElement | null;
    const cancelClearBtn = document.getElementById('cancel-clear-btn');
    const confirmClearBtn = document.getElementById('confirm-clear-btn');

    function syncUrl(push = true) {
      syncUrlParams(
        { level: currentLevel, eventCode: currentEventCode, health: currentHealth, timeWindow: currentTimeWindow, search: currentSearch, sort: currentSort, page: currentPage },
        { sort: 'newest', page: 1 },
        push
      );
    }

    function renderLevelBadge(lvl: string) {
      const level = (lvl || 'error').toUpperCase();
      if (level === 'CRITICAL') {
        return '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-900 border border-purple-200">CRIT</span>';
      }
      if (level === 'ERROR') {
        return '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">ERR</span>';
      }
      if (level === 'WARN') {
        return '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">WARN</span>';
      }
      if (level === 'INFO') {
        return '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">INFO</span>';
      }
      return '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-zinc-100 text-zinc-600 border border-zinc-200">DBG</span>';
    }

    function renderMethodBadge(method: string | null | undefined) {
      if (!method) return '';
      const m = method.toUpperCase();
      let colorClass = 'bg-zinc-100 text-zinc-700 border-zinc-200';
      if (m === 'GET') colorClass = 'bg-sky-50 text-sky-700 border-sky-200';
      else if (m === 'POST') colorClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
      else if (m === 'PATCH' || m === 'PUT') colorClass = 'bg-amber-50 text-amber-700 border-amber-200';
      else if (m === 'DELETE') colorClass = 'bg-rose-50 text-rose-700 border-rose-200';
      else if (m === 'CLIENT') colorClass = 'bg-purple-50 text-purple-700 border-purple-200';

      return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold uppercase border ${colorClass}">${escapeHtml(m)}</span>`;
    }

    // Event-Aware SLA Latency Badges
    function renderEventAwareSla(log: any) {
      const code = log.error_code || '';
      const ms = log.latency_ms;

      // 1. Web Vitals
      if (code === 'WEB_VITALS') {
        let parsed: any = null;
        if (log.context_json) {
          try { parsed = JSON.parse(log.context_json); } catch {}
        }
        const rating = parsed?.rating || '';
        const wasHidden = Boolean(parsed?.wasHidden || rating === 'backgrounded');

        if (wasHidden) {
          return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-medium bg-zinc-100 text-zinc-600 border border-zinc-200" title="Backgrounded tab">💤 Tab Idle</span>`;
        }
        if (rating === 'good') {
          return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">🟢 Good (${ms ?? 0}ms)</span>`;
        }
        if (rating === 'needs-improvement') {
          return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-amber-50 text-amber-800 border border-amber-200">🟡 Fair (${ms ?? 0}ms)</span>`;
        }
        if (rating === 'poor') {
          return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">🔴 Poor (${ms ?? 0}ms)</span>`;
        }
        return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-zinc-100 text-zinc-700">${ms ?? 0}ms</span>`;
      }

      // 2. Client Navigation
      if (code === 'CLIENT_NAVIGATION') {
        return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">🧭 Nav</span>`;
      }

      // 3. Client Runtime Errors
      if (code.startsWith('CLIENT_')) {
        return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-medium bg-purple-50 text-purple-700 border border-purple-200">Browser</span>`;
      }

      // 4. Server API SLA Latency
      if (typeof ms === 'number' && !isNaN(ms)) {
        if (ms < 150) {
          return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">${ms}ms</span>`;
        }
        if (ms < 1000) {
          return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-50 text-amber-800 border border-amber-200">${ms}ms</span>`;
        }
        return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">${ms}ms</span>`;
      }

      return `<span class="text-[#86868b]">—</span>`;
    }

    function renderSpansMini(log: any) {
      if (!log.context_json) return '<span class="text-[#86868b]">—</span>';
      try {
        const parsed = JSON.parse(log.context_json);
        const spans = parsed?.spans || parsed?.context?.spans;
        if (!spans || typeof spans !== 'object' || Object.keys(spans).length === 0) {
          return '<span class="text-[#86868b]">—</span>';
        }
        return Object.entries(spans)
          .slice(0, 2)
          .map(([k, v]) => `
            <span class="inline-flex items-center gap-1 px-1 py-0.2 rounded text-[9px] font-mono bg-zinc-100 text-zinc-700 border border-black/5" title="${escapeHtml(k)}: ${v}ms">
              <span class="text-[#86868b]">${escapeHtml(k.slice(0, 6))}</span>
              <strong>${v}ms</strong>
            </span>
          `).join(' ');
      } catch {
        return '<span class="text-[#86868b]">—</span>';
      }
    }

    function renderBottlenecks(bottlenecks: any[]) {
      if (!bottlenecksBar || !topBottleneckSummary) return;

      if (!bottlenecks || bottlenecks.length === 0) {
        bottlenecksBar.classList.add('hidden');
        return;
      }

      bottlenecksBar.classList.remove('hidden');

      const top = bottlenecks[0];
      const topAvg = top.avg_latency || 0;
      topBottleneckSummary.innerHTML = `
        <button type="button" class="quick-filter-bottleneck hover:underline text-[#1d1d1f] font-semibold cursor-pointer" data-path="${escapeHtml(top.path)}">
          ${renderMethodBadge(top.method)} <span class="text-[#1d1d1f]">${escapeHtml(top.path)}</span>
        </button>
        <span class="text-[#86868b] ml-1.5 font-normal">· Avg <strong class="text-amber-700">${topAvg}ms</strong> · ${top.call_count} calls</span>
      `;

      if (bottlenecksGrid) {
        bottlenecksGrid.innerHTML = bottlenecks.map((item, idx) => {
          const safePath = escapeHtml(item.path);
          return `
            <button
              type="button"
              class="quick-filter-bottleneck p-2 rounded-lg bg-[#f5f5f7] hover:bg-[#1d1d1f] hover:text-white transition-all text-left border border-black/5 cursor-pointer group"
              data-path="${safePath}"
            >
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-[10px] font-mono text-[#86868b] group-hover:text-white/60">#${idx + 1}</span>
                ${renderMethodBadge(item.method)}
                <span class="font-mono text-xs font-semibold truncate text-[#1d1d1f] group-hover:text-white flex-1" title="${safePath}">
                  ${safePath}
                </span>
              </div>
              <div class="flex items-center justify-between text-[10px] font-mono text-[#86868b] group-hover:text-white/80">
                <span>Avg: <strong class="text-[#1d1d1f] group-hover:text-amber-400">${item.avg_latency || 0}ms</strong></span>
                <span>Max: ${item.max_latency || 0}ms</span>
                <span>${item.call_count || 0} calls</span>
              </div>
            </button>
          `;
        }).join('');
      }

      // Bind quick filter
      document.querySelectorAll('.quick-filter-bottleneck').forEach((btn) => {
        btn.addEventListener('click', () => {
          const path = btn.getAttribute('data-path');
          if (!path || !searchInput) return;
          searchInput.value = path;
          currentSearch = path;
          currentPage = 1;
          if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
          loadLogs();
        });
      });
    }

    function renderRows(logs: any[]) {
      if (!tableBody) return;

      if (!logs || logs.length === 0) {
        tableBody.innerHTML = '';
        if (tableScrollArea) tableScrollArea.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
      }

      if (emptyEl) emptyEl.classList.add('hidden');
      if (tableScrollArea) tableScrollArea.classList.remove('hidden');

      const isCompact = tableSettings.getDensity() === 'compact';
      const cellPad = isCompact ? 'py-1 px-2 text-[11px]' : 'py-2 px-2.5 text-xs';

      const visibleCols = tableSettings.getVisibleColumns();

      tableBody.innerHTML = logs.map((log) => {
        const safeSource = escapeHtml(log.source || 'system');
        const safeCode = log.error_code ? escapeHtml(log.error_code) : '';
        const safeMessage = escapeHtml(log.message || '');
        const safeUser = escapeHtml(log.user_email || log.user_id || 'Anonymous');
        const safeRay = escapeHtml(log.ray_id || '');
        const safePath = escapeHtml(log.path || '');
        const safeMethod = renderMethodBadge(log.method);
        const slaBadge = renderEventAwareSla(log);
        const spansBadge = renderSpansMini(log);
        const timeStr = formatAdminTime(log.created_at, 'short');
        const fullTimeStr = formatAdminTime(log.created_at, 'full');

        const statusBadge = log.method === 'CLIENT'
          ? `<span class="px-1 py-0.2 rounded text-[9px] font-mono bg-purple-50 text-purple-700">Client</span>`
          : (log.status_code ? `<span class="px-1 py-0.2 rounded text-[9px] font-mono ${log.status_code >= 400 ? 'bg-rose-50 text-rose-700 font-bold' : 'bg-emerald-50 text-emerald-700'}">${log.status_code}</span>` : '');

        const geoTokens = [];
        if (log.client_ip) geoTokens.push(log.client_ip);
        if (log.country) geoTokens.push(log.country);
        const clientGeo = geoTokens.length > 0 ? escapeHtml(geoTokens.join(' · ')) : '';

        const rowCells = visibleCols.map((col) => {
          switch (col.id) {
            case 'time':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono text-[#86868b] whitespace-nowrap truncate" title="${fullTimeStr}">${timeStr}</td>`;
            case 'level':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} whitespace-nowrap">${renderLevelBadge(log.level)}</td>`;
            case 'event':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono text-[10px] text-[#52525b] truncate" title="${safeCode}">${safeCode || '—'}</td>`;
            case 'method_status':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} whitespace-nowrap"><div class="flex items-center gap-1">${safeMethod} ${statusBadge}</div></td>`;
            case 'path':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono font-medium truncate text-[#1d1d1f]" title="${safePath}">${safePath || '—'}</td>`;
            case 'latency':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} whitespace-nowrap">${slaBadge}</td>`;
            case 'spans':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} whitespace-nowrap">${spansBadge}</td>`;
            case 'message':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} truncate font-medium text-[#1d1d1f]" title="${safeMessage}">${safeMessage}</td>`;
            case 'client_geo':
              return `<td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono text-[10px] text-[#52525b] truncate" title="${clientGeo}">${clientGeo || '—'}</td>`;
            case 'ray_id':
              return `
                <td style="width: ${col.defaultWidth}px;" class="${cellPad} whitespace-nowrap">
                  ${safeRay ? `
                    <button type="button" class="copy-ray-btn text-[10px] font-mono text-[#86868b] hover:text-black flex items-center gap-1 cursor-pointer" data-copy="${safeRay}" title="Copy CF Ray ID">
                      <span class="truncate max-w-[80px]">${safeRay}</span>
                      <span class="copy-icon">📋</span>
                    </button>
                  ` : '<span class="text-[#86868b]">—</span>'}
                </td>
              `;
            case 'action':
              return `
                <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-right whitespace-nowrap">
                  <button type="button" class="view-detail-btn px-2 py-0.5 rounded text-[11px] font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all cursor-pointer" data-id="${log.id}">
                    Detail
                  </button>
                </td>
              `;
            default:
              return `<td></td>`;
          }
        }).join('');

        return `<tr class="hover:bg-[#f5f5f7]/60 transition-colors">${rowCells}</tr>`;
      }).join('');

      // Bind events
      tableBody.querySelectorAll('.view-detail-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = Number(btn.getAttribute('data-id'));
          const log = logsList.find((l) => l.id === id);
          if (log) openDetailModal(log);
        });
      });

      tableBody.querySelectorAll('.copy-ray-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            (window as any).__showToast?.('Copied Ray ID', 'success', 1500);
            const icon = btn.querySelector('.copy-icon');
            if (icon) {
              icon.textContent = '✓';
              setTimeout(() => { icon.textContent = '📋'; }, 1500);
            }
          } catch {}
        });
      });
    }

    function openDetailModal(log: any) {
      if (!detailModal) return;

      if (modalLevelBadge) modalLevelBadge.innerHTML = renderLevelBadge(log.level);
      if (modalEventCode) {
        modalEventCode.textContent = log.error_code || 'EVENT';
        modalEventCode.classList.toggle('hidden', !log.error_code);
      }
      if (modalSource) modalSource.textContent = log.source || 'system';
      if (modalMessage) modalMessage.textContent = log.message || '';
      if (modalTime) modalTime.textContent = formatAdminTime(log.created_at, 'full');
      if (modalRay) modalRay.textContent = log.ray_id || '—';
      if (modalPath) modalPath.textContent = log.path || '—';
      if (modalHttp) {
        modalHttp.textContent = log.method === 'CLIENT'
          ? 'CLIENT · Browser Runtime'
          : `${log.method || 'GET'} · HTTP ${log.status_code || 200}`;
      }
      if (modalLatency) modalLatency.textContent = log.latency_ms ? `${log.latency_ms} ms` : '—';
      if (modalUser) modalUser.textContent = log.user_email || log.user_id || 'Anonymous';
      if (modalIp) modalIp.textContent = log.client_ip || '—';
      if (modalGeo) {
        const parts = [];
        if (log.country) parts.push(log.country);
        if (log.city) parts.push(log.city);
        modalGeo.textContent = parts.length > 0 ? parts.join(', ') : '—';
      }

      let parsedContext: any = null;
      if (log.context_json) {
        try { parsedContext = JSON.parse(log.context_json); } catch {}
      }

      const spans = parsedContext?.spans || parsedContext?.context?.spans;
      if (modalSpansContainer && modalSpansList) {
        if (spans && typeof spans === 'object' && Object.keys(spans).length > 0) {
          modalSpansContainer.classList.remove('hidden');
          modalSpansList.innerHTML = Object.entries(spans)
            .map(([k, v]) => `
              <div class="p-2 rounded-lg bg-white border border-black/5 flex items-center justify-between">
                <span class="text-[#86868b]">${escapeHtml(k)}</span>
                <strong class="text-[#1d1d1f] font-bold">${v} ms</strong>
              </div>
            `)
            .join('');
        } else {
          modalSpansContainer.classList.add('hidden');
          modalSpansList.innerHTML = '';
        }
      }

      const breadcrumbs = parsedContext?.breadcrumbs || parsedContext?.context?.breadcrumbs;
      if (modalBreadcrumbsContainer && modalBreadcrumbsList) {
        if (Array.isArray(breadcrumbs) && breadcrumbs.length > 0) {
          modalBreadcrumbsContainer.classList.remove('hidden');
          if (modalBreadcrumbsCount) modalBreadcrumbsCount.textContent = `${breadcrumbs.length} steps`;
          modalBreadcrumbsList.innerHTML = breadcrumbs.map((b: any, idx: number) => {
            const timeStr = b.ts ? formatAdminTime(b.ts, 'short') : '';
            const safeTrigger = escapeHtml(b.trigger || 'navigate');
            const safeFrom = escapeHtml(b.from || 'direct');
            const safeTo = escapeHtml(b.to || '/');
            const isLast = idx === breadcrumbs.length - 1;
            return `
              <div class="p-1.5 rounded-lg ${isLast ? 'bg-purple-100/70 border border-purple-300 font-semibold' : 'bg-white/80 border border-black/5'} flex items-center gap-2">
                <span class="text-[10px] text-purple-700 shrink-0">${timeStr}</span>
                <span class="px-1 py-0.2 rounded text-[9px] bg-purple-200/80 text-purple-900 uppercase shrink-0">${safeTrigger}</span>
                <span class="text-zinc-500 truncate max-w-[120px] sm:max-w-[160px]">${safeFrom}</span>
                <span class="text-purple-600">→</span>
                <span class="text-zinc-900 font-bold truncate flex-1">${safeTo}</span>
                ${isLast ? '<span class="text-[9px] text-rose-600 font-bold shrink-0 ml-auto">(Triggered)</span>' : ''}
              </div>
            `;
          }).join('');
        } else {
          modalBreadcrumbsContainer.classList.add('hidden');
          modalBreadcrumbsList.innerHTML = '';
        }
      }

      if (modalContext) {
        modalContext.textContent = parsedContext
          ? JSON.stringify(parsedContext, null, 2)
          : (log.context_json || 'No extra context recorded.');
      }

      detailModal.showModal();
    }

    if (closeModalBtn) closeModalBtn.addEventListener('click', () => detailModal?.close());
    if (closeModalBottomBtn) closeModalBottomBtn.addEventListener('click', () => detailModal?.close());

    async function loadLogs(updateUrl = true, pushUrl = true) {
      if (updateUrl) syncUrl(pushUrl);
      const cacheKey = `admin:logs:${currentLevel}:${currentEventCode}:${currentHealth}:${currentTimeWindow}:${currentSearch}:${currentSort}:${currentPage}`;
      try {
        const query = new URLSearchParams();
        if (currentLevel && currentLevel !== 'ALL') query.set('level', currentLevel);
        if (currentEventCode && currentEventCode !== 'ALL') query.set('eventCode', currentEventCode);
        if (currentHealth && currentHealth !== 'ALL') query.set('health', currentHealth);
        if (currentTimeWindow && currentTimeWindow !== 'ALL') query.set('timeWindow', currentTimeWindow);
        if (currentSearch) query.set('search', currentSearch);
        if (currentSort && currentSort !== 'newest') query.set('sort', currentSort);
        query.set('limit', String(limit));
        query.set('page', String(currentPage));

        await clientCache.fetchWithCache(
          cacheKey,
          `/api/admin/logs?${query.toString()}`,
          {
            mode: 'swr',
            onData: (data: any) => {
              if (!data?.success) return;
              logsList = data.logs || [];
              if (metricTotal) metricTotal.textContent = data.stats?.total ?? 0;
              if (metricErrors) metricErrors.textContent = data.stats?.errors ?? 0;
              if (metricWarns) metricWarns.textContent = data.stats?.warns ?? 0;
              if (metricSlow) metricSlow.textContent = data.stats?.slow ?? 0;

              renderBottlenecks(data.bottlenecks || []);

              if (skeletonEl) skeletonEl.classList.add('hidden');
              renderRows(logsList);
              pagination.render(data.page || currentPage, data.totalPages || 1, data.total ?? logsList.length, limit);
            },
          }
        );
      } catch (err) {
        console.error('Error fetching logs:', err);
        if (skeletonEl) skeletonEl.classList.add('hidden');
        if (tableScrollArea) tableScrollArea.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
      }
    }

    // CSV Export via adminWorkbench
    if (exportCsvBtn) {
      exportCsvBtn.addEventListener('click', () => {
        if (!logsList || logsList.length === 0) {
          (window as any).__showToast?.('No logs to export', 'info');
          return;
        }

        const exportCols = tableSettings.getVisibleColumns().filter((c) => c.id !== 'action');
        const headers = exportCols.map((c) => c.label);
        const rows = logsList.map((log: any) =>
          exportCols.map((col) => {
            switch (col.id) {
              case 'time':
                return formatAdminTime(log.created_at, 'full');
              case 'level':
                return log.level || '';
              case 'event':
                return log.error_code || '';
              case 'method_status':
                return `${log.method || ''} ${log.status_code || ''}`.trim();
              case 'path':
                return log.path || '';
              case 'latency':
                return log.latency_ms ?? '';
              case 'spans': {
                try {
                  const p = log.context_json ? JSON.parse(log.context_json) : null;
                  const s = p?.spans || p?.context?.spans;
                  return s ? JSON.stringify(s) : '';
                } catch {
                  return '';
                }
              }
              case 'message':
                return log.message || '';
              case 'client_geo':
                return [log.client_ip, log.country].filter(Boolean).join(' · ');
              case 'ray_id':
                return log.ray_id || '';
              default:
                return '';
            }
          })
        );

        exportToCsv(`diagnostics-logs-${new Date().toISOString().slice(0, 10)}`, headers, rows);
        (window as any).__showToast?.(`Exported ${logsList.length} logs to CSV`, 'success');
      });
    }

    // Auto Polling
    function toggleAutoPoll() {
      isAutoPolling = !isAutoPolling;
      if (isAutoPolling) {
        if (pollIndicator) {
          pollIndicator.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
        }
        if (pollLabel) pollLabel.textContent = 'Live: 10s';
        if (pollToggleBtn) {
          pollToggleBtn.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        }
        autoPollTimer = setInterval(() => {
          loadLogs(false);
        }, 10000);
        (window as any).__showToast?.('Auto-refresh every 10s enabled', 'info', 1500);
      } else {
        if (pollIndicator) {
          pollIndicator.className = 'w-1.5 h-1.5 rounded-full bg-zinc-400';
        }
        if (pollLabel) pollLabel.textContent = 'Live: Off';
        if (pollToggleBtn) {
          pollToggleBtn.classList.remove('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        }
        if (autoPollTimer) {
          clearInterval(autoPollTimer);
          autoPollTimer = null;
        }
      }
    }

    if (pollToggleBtn) pollToggleBtn.addEventListener('click', toggleAutoPoll);

    // Bottlenecks drawer expand/collapse
    if (toggleBottlenecksBtn && bottlenecksGrid && bottlenecksToggleText && bottlenecksToggleIcon) {
      toggleBottlenecksBtn.addEventListener('click', () => {
        const isHidden = bottlenecksGrid.classList.contains('hidden');
        if (isHidden) {
          bottlenecksGrid.classList.remove('hidden');
          bottlenecksToggleText.textContent = 'Collapse';
          bottlenecksToggleIcon.textContent = '▴';
        } else {
          bottlenecksGrid.classList.add('hidden');
          bottlenecksToggleText.textContent = 'Expand Top 8';
          bottlenecksToggleIcon.textContent = '▾';
        }
      });
    }

    // Metric capsule instant filters
    ([
      ['metric-capsule-total', () => { currentLevel = 'ALL'; currentEventCode = 'ALL'; currentHealth = 'ALL'; $val('filter-level-select', 'ALL'); $val('filter-event-select', 'ALL'); $val('filter-health-select', 'ALL'); }],
      ['metric-capsule-errors', () => { currentLevel = 'ERROR'; $val('filter-level-select', 'ERROR'); }],
      ['metric-capsule-warns', () => { currentLevel = 'WARN'; $val('filter-level-select', 'WARN'); }],
      ['metric-capsule-slow', () => { currentHealth = 'slow_only'; $val('filter-health-select', 'slow_only'); }],
    ] as const).forEach(([id, fn]) => {
      $id(id)?.addEventListener('click', () => { fn(); currentPage = 1; loadLogs(); });
    });

    // Filter selects
    ([
      ['filter-level-select', () => currentLevel, (v: string) => { currentLevel = v; }],
      ['filter-event-select', () => currentEventCode, (v: string) => { currentEventCode = v; }],
      ['filter-health-select', () => currentHealth, (v: string) => { currentHealth = v; }],
      ['filter-timewindow-select', () => currentTimeWindow, (v: string) => { currentTimeWindow = v; }],
      ['logs-sort-select', () => currentSort, (v: string) => { currentSort = v; }],
    ] as const).forEach(([id, getter, setter]) => {
      $val(id, getter());
      $id<HTMLSelectElement>(id)?.addEventListener('change', (e) => {
        setter((e.target as HTMLSelectElement).value);
        currentPage = 1;
        loadLogs();
      });
    });

    // Search, clear & refresh bindings via adminWorkbench
    bindSearchAndRefresh({
      searchInputId: 'logs-search-input',
      clearBtnId: 'clear-search-btn',
      refreshBtnId: 'refresh-logs-btn',
      debounceMs: 300,
      signal,
      onSearch: (val) => {
        currentSearch = val;
        currentPage = 1;
        loadLogs(true, false);
      },
      onRefresh: () => {
        loadLogs();
      },
    });

    // Clear logs modal
    if (clearLogsBtn && clearConfirmModal) {
      clearLogsBtn.addEventListener('click', () => {
        clearConfirmModal.showModal();
      });
    }

    if (cancelClearBtn && clearConfirmModal) {
      cancelClearBtn.addEventListener('click', () => {
        clearConfirmModal.close();
      });
    }

    if (confirmClearBtn && clearConfirmModal) {
      confirmClearBtn.addEventListener('click', async () => {
        confirmClearBtn.textContent = 'Clearing...';
        confirmClearBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch('/api/admin/logs', { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            (window as any).__showToast?.('All diagnostic logs cleared', 'info');
            await clientCache.invalidatePrefix('admin:logs:');
            clearConfirmModal.close();
            currentPage = 1;
            loadLogs();
          } else {
            console.error('Failed to clear logs:', data.error);
          }
        } catch (e) {
          console.error('Network failure clearing logs:', e);
        } finally {
          confirmClearBtn.textContent = 'Delete All';
          confirmClearBtn.removeAttribute('disabled');
          clearConfirmModal.close();
        }
      });
    }

    // Popstate handling
    window.addEventListener('popstate', () => {
      const url = new URL(window.location.href);
      currentLevel = url.searchParams.get('level') || 'ALL';
      currentEventCode = url.searchParams.get('eventCode') || 'ALL';
      currentHealth = url.searchParams.get('health') || 'ALL';
      currentTimeWindow = url.searchParams.get('timeWindow') || 'ALL';
      currentSearch = (url.searchParams.get('search') || '').trim();
      currentSort = url.searchParams.get('sort') || 'newest';
      currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));

      if (levelSelect) levelSelect.value = currentLevel;
      if (eventSelect) eventSelect.value = currentEventCode;
      if (healthSelect) healthSelect.value = currentHealth;
      if (timewindowSelect) timewindowSelect.value = currentTimeWindow;
      if (searchInput) searchInput.value = currentSearch;
      if (sortSelect) sortSelect.value = currentSort;
      if (clearSearchBtn) {
        if (currentSearch) clearSearchBtn.classList.remove('hidden');
        else clearSearchBtn.classList.add('hidden');
      }
      loadLogs(false);
    }, { signal });

    // Initial setup - echo search input to match initial URL parameters
    $val('logs-search-input', currentSearch);

    tableSettings.renderHeader();
    tableSettings.renderMenu();
    loadLogs(false);
  }

  initLogsPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('metric-capsule-total')) {
      initLogsPage();
    } else {
      pageAbort?.abort();
      pageAbort = null;
    }
  });
</script>
