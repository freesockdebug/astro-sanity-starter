---
// src/pages/admin/waf.astro
// Edge WAF Shield Console: Protection Modes, IP Blacklist/Whitelist, Auto-Ban Strikes & Live Intercept Telemetry
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import WafConditionBuilder from '@components/admin/WafConditionBuilder.astro';
import { requireAdminContext } from '@utils/auth';
import { hasPermission } from '@utils/rbac';
import {
  getSystemSettings,
  listErrorLogs,
  getWaf24hSummary,
  listWafRules,
  listWafIpAcl,
  type WafRuleMode,
} from '@db';
import {
  EdgeWafService,
  mergeActiveTimedBans,
  parseIpList,
  normalizeWafRuleConfig,
  DEFAULT_WAF_RULE_CONFIG,
} from '@utils/waf';
import { toIsoUtcString, formatUtcFallback } from '@utils/format';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/waf',
  { requiredMenu: 'waf' }
);
if (redirectResponse) return redirectResponse;

const canManage = hasPermission(adminContext, 'waf:manage');
const settings = systemSettings || (await getSystemSettings(cfEnv));

const [recentLogsRes, daySummary, dbRules, ipAcl] = await Promise.all([
  listErrorLogs({ source: 'EDGE_WAF', limit: 30, page: 1 }, cfEnv).catch(() => ({
    logs: [],
    total: 0,
    stats: { total: 0, debug: 0, info: 0, warns: 0, errors: 0, critical: 0, slow: 0 },
    bottlenecks: [],
  })),
  getWaf24hSummary(cfEnv).catch(() => ({ eventsCount: 0, totalHits: 0 })),
  listWafRules(cfEnv).catch(() => []),
  listWafIpAcl(cfEnv).catch(() => []),
]);

const activeModes: WafRuleMode[] = Array.isArray(settings?.waf_active_modes) ? settings.waf_active_modes : [];
const dbBlockedStr = ipAcl.filter((r) => r.list_type === 'BLACKLIST' && !r.expires_at).map((r) => r.ip_cidr).join('\n');
const dbAllowStr = ipAcl.filter((r) => r.list_type === 'WHITELIST' && !r.expires_at).map((r) => r.ip_cidr).join('\n');
const blockedIpsStr = dbBlockedStr || settings?.waf_blocked_ips || '';
const allowIpsStr = dbAllowStr || settings?.waf_allow_ips || '';
const ruleConfig = normalizeWafRuleConfig(settings?.waf_rule_config);
const blockedCount = parseIpList(blockedIpsStr).length;
const allowCount = parseIpList(allowIpsStr).length;

const nowMs = Date.now();
const activeBans = mergeActiveTimedBans(ipAcl, nowMs);
const localStats = EdgeWafService.getStrikeStats(nowMs);
const strikeStats = { activeBans: activeBans.length, trackedIps: Math.max(localStats.trackedIps, activeBans.length) };
const blocked24hCount = daySummary.totalHits || 0;
const blocked24hEvents = daySummary.eventsCount || 0;
const logs = recentLogsRes.logs || [];

const WAF_MODE_CARDS: Array<{
  mode: WafRuleMode;
  icon: string;
  title: string;
  desc: string;
  responseCode: string;
  tagClass: string;
}> = [
  {
    mode: 'block_malicious_ips',
    icon: '🛡️',
    title: 'Block Malicious IPs',
    desc: 'Blocks blacklisted IPs, probe paths, OWASP SQLi/XSS/LFI payloads & dynamically auto-bans repeat offenders.',
    responseCode: '403 Forbidden (WAF_MALICIOUS_IP / WAF_MALICIOUS_PAYLOAD)',
    tagClass: 'bg-rose-50 text-rose-700 border-rose-200/80',
  },
  {
    mode: 'strict_rate_limiting',
    icon: '⚡',
    title: 'Strict Rate Limiting',
    desc: 'Enforces sliding-window request caps across public write endpoints, standard APIs & SSR pages.',
    responseCode: `429 Too Many Requests (WAF_STRICT_RATE_LIMIT) + Retry-After: ${ruleConfig.rateLimit.windowSeconds}`,
    tagClass: 'bg-amber-50 text-amber-800 border-amber-200/80',
  },
  {
    mode: 'bot_challenge',
    icon: '🤖',
    title: 'Bot Challenge',
    desc: 'Granular filtering for scanners, CLI scripts, AI/SEO crawlers, custom UAs & RFQ browser fingerprints.',
    responseCode: '403 Forbidden (WAF_BOT_CHALLENGE)',
    tagClass: 'bg-indigo-50 text-indigo-700 border-indigo-200/80',
  },
];

const parseLogContext = (ctxJson?: string) => {
  if (!ctxJson) return {} as Record<string, any>;
  try {
    const raw = JSON.parse(ctxJson) || {};
    return raw.context && typeof raw.context === 'object' ? { ...raw.context, ...raw } : raw;
  } catch {
    return {};
  }
};

const modeBadgeLabel = (mode?: string) => {
  if (mode === 'block_malicious_ips') return { text: 'Block Malicious IPs', cls: 'adm-badge-err' };
  if (mode === 'strict_rate_limiting') return { text: 'Strict Rate Limiting', cls: 'adm-badge-warn' };
  if (mode === 'bot_challenge') return { text: 'Bot Challenge', cls: 'adm-badge-info' };
  return { text: 'Edge WAF', cls: 'adm-badge-neutral' };
};

const initialPayload = JSON.stringify({
  canManage,
  activeModes,
  blockedIps: blockedIpsStr,
  allowIps: allowIpsStr,
  ruleConfig,
  dbRules,
  ipAcl,
  defaultRuleConfig: DEFAULT_WAF_RULE_CONFIG,
}).replace(/</g, '\\u003c');
---

<AdminLayout
  title="Edge WAF Shield"
  currentTab="waf"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div id="waf-workbench-root" class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-3">
    <AdminPageToolbar
      title="Edge WAF Shield"
      subtitle="Transparent defense conditions, fine-grained rule thresholds, IP ACLs, auto-ban strike engine & live telemetry"
      badge={activeModes.length > 0 ? `${activeModes.length} / 3 Enforcing` : 'WAF Standby'}
      badgeColor={activeModes.length > 0 ? 'emerald' : 'amber'}
      iconKey="waf"
    >
      <div slot="actions" class="flex items-center gap-2">
        <button
          id="waf-refresh-btn"
          type="button"
          class="adm-btn-secondary"
          title="Refresh telemetry"
        >
          ↻ Refresh
        </button>
        {canManage && (
          <button
            id="waf-reset-btn"
            type="button"
            class="adm-btn-secondary"
            title="Restore recommended WAF sub-rules and thresholds"
          >
            Reset Defaults
          </button>
        )}
        {canManage && (
          <button
            id="waf-save-btn"
            type="button"
            class="adm-btn"
            title="Save WAF Rules (⌘S)"
          >
            <span>Save Rules</span>
            <kbd class="hidden sm:inline-block px-1 py-0.5 text-[9px] font-mono bg-white/15 rounded">⌘S</kbd>
          </button>
        )}
      </div>
    </AdminPageToolbar>

    <div class="flex-1 min-h-0 overflow-y-auto space-y-4 pr-0.5 text-xs">
      <!-- 1. Top KPI Summary Bar -->
      <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
        <div class="adm-card p-3.5 flex flex-col justify-between gap-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Active Protection Modes</span>
            <span
              id="kpi-modes-badge"
              class:list={[
                'adm-badge',
                activeModes.length > 0 ? 'adm-badge-ok' : 'adm-badge-warn',
              ]}
            >
              {activeModes.length > 0 ? 'ACTIVE' : 'WAF Standby'}
            </span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span id="kpi-modes-count" class="text-xl font-bold text-[#1d1d1f] tabular-nums">{activeModes.length} / 3</span>
            <span class="text-[11px] text-[#86868b]">Modes Active</span>
          </div>
        </div>

        <div class="adm-card p-3.5 flex flex-col justify-between gap-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">24h Blocked Attacks</span>
            <span class="adm-badge adm-badge-err">EDGE_WAF</span>
          </div>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span id="kpi-24h-blocked" class="text-xl font-bold text-[#1d1d1f] tabular-nums">{blocked24hCount}</span>
              <span class="text-[11px] text-[#86868b]">Intercepted Hits</span>
            </div>
            <div id="kpi-24h-events" class="text-[10px] text-[#86868b] mt-0.5">
              across {blocked24hEvents} {blocked24hEvents === 1 ? 'attack event' : 'attack events'} in 24h
            </div>
          </div>
        </div>

        <div class="adm-card p-3.5 flex flex-col justify-between gap-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Custom Blacklisted IPs</span>
            <span class="adm-badge adm-badge-neutral">ACL</span>
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <div>
              <span id="kpi-blocked-ips" class="text-xl font-bold text-[#1d1d1f] tabular-nums">{blockedCount}</span>
              <span class="text-[11px] text-[#86868b] ml-1">Blocked</span>
            </div>
            <span id="kpi-allow-ips" class="text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200/70 px-2 py-0.5 rounded-full">
              +{allowCount} Whitelisted
            </span>
          </div>
        </div>

        <div class="adm-card p-3.5 flex flex-col justify-between gap-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Auto-Ban Strike Engine</span>
            <span id="kpi-autoban-policy" class="adm-badge adm-badge-warn">
              {ruleConfig.malicious.enableAutoBan
                ? `${ruleConfig.malicious.strikeLimit} Strikes · ${ruleConfig.malicious.banDurationMinutes}m`
                : 'Auto-Ban Off'}
            </span>
          </div>
          <div class="flex items-center justify-between gap-2">
            <div class="text-[11px] text-[#1d1d1f]">
              <strong id="kpi-active-bans" class="text-lg font-bold tabular-nums">{strikeStats.activeBans}</strong>
              <span class="text-[#86868b] ml-1">banned · <span id="kpi-tracked-ips">{strikeStats.trackedIps}</span> tracked</span>
            </div>
            {canManage && (
              <button
                id="waf-clear-strikes-btn"
                type="button"
                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#f5f5f7] hover:bg-black/10 text-[#1d1d1f] border border-black/10 transition-colors cursor-pointer shrink-0"
              >
                Clear Auto-Ban Strikes
              </button>
            )}
          </div>
        </div>
      </section>

      <!-- Active Auto-Banned IP List (Single-IP Unban) -->
      <section
        id="waf-active-bans-bar"
        class:list={[
          'adm-card px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 bg-rose-50/40 border-rose-200/70',
          activeBans.length === 0 && 'hidden',
        ]}
      >
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-bold text-rose-800 uppercase tracking-wider">Active Timed Bans:</span>
          <div id="waf-active-bans-chips" class="flex flex-wrap items-center gap-1.5">
            {activeBans.map((ban) => (
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-white border border-rose-200 text-[11px] font-mono text-[#1d1d1f]">
                <span>{ban.ip}</span>
                <span class="text-[10px] text-[#86868b]">({ban.strikes} strikes · {ban.remainingMinutes}m left)</span>
                {canManage && (
                  <button
                    type="button"
                    data-unban-ip={ban.ip}
                    class="btn-unban-ip text-[10px] font-sans font-semibold text-rose-700 hover:text-rose-900 underline cursor-pointer ml-0.5"
                  >
                    Unban
                  </button>
                )}
              </span>
            ))}
          </div>
        </div>
      </section>

      <!-- 2. Three Protection Mode Cards (Condition Transparency + Fine-Grained Config) -->
      <section class="adm-card p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-xs sm:text-sm font-bold text-[#1d1d1f]">EdgeWafService Protection Modes & Fine-Grained Rules</h2>
            <p class="text-[11px] text-[#86868b]">
              Inspect exact matching patterns, toggle sub-conditions independently, or tune thresholds in <code class="font-mono text-[10px] bg-[#f5f5f7] px-1 py-0.5 rounded">waf_rule_config</code>.
            </p>
          </div>
          {!canManage && (
            <span class="adm-badge adm-badge-neutral">Read-Only (waf:read)</span>
          )}
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-3.5">
          {WAF_MODE_CARDS.map((card) => {
            const isEnabled = activeModes.includes(card.mode);
            return (
              <div
                data-waf-card={card.mode}
                class:list={[
                  'waf-mode-card rounded-2xl border p-4 flex flex-col justify-between gap-3 transition-all',
                  isEnabled ? 'bg-white border-black/20 shadow-xs ring-1 ring-black/5' : 'bg-[#fafafc] border-black/8',
                ]}
              >
                <!-- Layer 1: Mode Header & Master Switch -->
                <div class="space-y-2">
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="text-base shrink-0">{card.icon}</span>
                      <span class="font-bold text-xs text-[#1d1d1f] truncate">{card.title}</span>
                    </div>
                    <label class:list={['flex items-center gap-2 shrink-0', canManage ? 'cursor-pointer' : 'cursor-default']}>
                      <span
                        data-mode-badge={card.mode}
                        class:list={[
                          'adm-badge',
                          isEnabled ? 'adm-badge-ok' : 'adm-badge-neutral',
                        ]}
                      >
                        {isEnabled ? 'ENFORCING' : 'DISABLED'}
                      </span>
                      <input
                        id={`waf-mode-${card.mode}`}
                        type="checkbox"
                        name={`waf_mode_${card.mode}`}
                        value={card.mode}
                        checked={isEnabled}
                        disabled={!canManage}
                        autocomplete="off"
                        class="waf-mode-checkbox w-4 h-4 accent-[#1d1d1f] rounded cursor-pointer"
                      />
                    </label>
                  </div>
                  <p class="text-[11px] text-[#52525b] leading-relaxed">{card.desc}</p>
                  <div>
                    <span
                      data-rate-retry-pill={card.mode === 'strict_rate_limiting' ? 'true' : undefined}
                      class:list={['inline-block px-2 py-0.5 rounded-md border font-mono text-[10px] leading-snug', card.tagClass]}
                    >
                      {card.responseCode}
                    </span>
                  </div>
                </div>

                <!-- Layer 2: Fine-Grained Parameters -->
                <div class="pt-3 border-t border-black/5 space-y-2.5">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-[#86868b]">
                    Fine-Grained Parameters
                  </div>

                  {card.mode === 'block_malicious_ips' && (
                    <div class="space-y-2.5">
                      <div class="grid grid-cols-2 gap-2">
                        <label class="block space-y-1">
                          <span class="text-[10px] font-semibold text-[#52525b]">Strike Threshold (1–50)</span>
                          <input
                            id="waf-mal-strike-limit"
                            type="number"
                            min="1"
                            max="50"
                            value={ruleConfig.malicious.strikeLimit}
                            disabled={!canManage}
                            class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                          />
                        </label>
                        <label class="block space-y-1">
                          <span class="text-[10px] font-semibold text-[#52525b]">Auto-Ban Duration (min)</span>
                          <input
                            id="waf-mal-ban-minutes"
                            type="number"
                            min="1"
                            max="1440"
                            value={ruleConfig.malicious.banDurationMinutes}
                            disabled={!canManage}
                            class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                          />
                        </label>
                      </div>
                      <p class="text-[10px] text-[#86868b] leading-relaxed">
                        Custom path patterns, regexes &amp; strike weights are managed incrementally in <span class="font-semibold text-[#52525b]">WAF Dynamic Rules</span> below.
                      </p>
                    </div>
                  )}

                  {card.mode === 'strict_rate_limiting' && (
                    <div class="grid grid-cols-2 gap-2">
                      <label class="block space-y-1">
                        <span class="text-[10px] font-semibold text-[#52525b]">Window Seconds (10–3600)</span>
                        <input
                          id="waf-rl-window"
                          type="number"
                          min="10"
                          max="3600"
                          value={ruleConfig.rateLimit.windowSeconds}
                          disabled={!canManage}
                          class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                        />
                      </label>
                      <label class="block space-y-1">
                        <span class="text-[10px] font-semibold text-[#52525b]">Public Write Limit (1–500)</span>
                        <input
                          id="waf-rl-pub-write"
                          type="number"
                          min="1"
                          max="500"
                          value={ruleConfig.rateLimit.publicWriteLimit}
                          disabled={!canManage}
                          class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                        />
                      </label>
                      <label class="block space-y-1">
                        <span class="text-[10px] font-semibold text-[#52525b]">Standard API Limit (1–1000)</span>
                        <input
                          id="waf-rl-api"
                          type="number"
                          min="1"
                          max="1000"
                          value={ruleConfig.rateLimit.apiLimit}
                          disabled={!canManage}
                          class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                        />
                      </label>
                      <label class="block space-y-1">
                        <span class="text-[10px] font-semibold text-[#52525b]">SSR Page Limit (1–5000)</span>
                        <input
                          id="waf-rl-page"
                          type="number"
                          min="1"
                          max="5000"
                          value={ruleConfig.rateLimit.pageLimit}
                          disabled={!canManage}
                          class="adm-input waf-param-input font-mono text-[11px] py-1.5"
                        />
                      </label>
                    </div>
                  )}

                  {card.mode === 'bot_challenge' && (
                    <p class="text-[11px] text-[#86868b] leading-relaxed">
                      Granular Bot UA keywords, regex matchers &amp; strike weights are managed in the <span class="font-semibold text-[#52525b]">WAF Dynamic Rules Engine</span> below.
                    </p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- 2.5 Unified Logical Condition Rules (DB Preset + Custom) -->
      <WafConditionBuilder
        dbRules={dbRules}
        rules={ruleConfig.customRules}
        ruleConfig={ruleConfig}
        activeModes={activeModes}
        canManage={canManage}
      />

      <!-- 3. IP Blacklist & Whitelist -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-3">
        <div class="adm-card p-4 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <label for="waf-blocked-ips" class="font-bold text-xs text-[#1d1d1f]">
              Blocked Malicious IPs / CIDR Prefixes
            </label>
            <span class="text-[10px] font-mono text-[#86868b]">waf_blocked_ips</span>
          </div>
          <p class="text-[11px] text-[#86868b]">
            Comma or newline separated. Supports exact IPs, wildcards (<code class="font-mono">185.220.101.*</code>), and IPv4 CIDR (<code class="font-mono">45.155.205.0/24</code>).
          </p>
          <textarea
            id="waf-blocked-ips"
            rows="5"
            disabled={!canManage}
            placeholder="185.220.101.1&#10;45.155.205.*"
            class="adm-input font-mono text-[11px] leading-relaxed resize-y"
          >{blockedIpsStr}</textarea>
        </div>

        <div class="adm-card p-4 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <label for="waf-allow-ips" class="font-bold text-xs text-[#1d1d1f]">
              Trusted Whitelist IPs (Bypass All WAF Rules)
            </label>
            <span class="text-[10px] font-mono text-[#86868b]">waf_allow_ips</span>
          </div>
          <p class="text-[11px] text-[#86868b]">
            Highest priority allowlist. Office static IPs or load-test nodes listed here skip all WAF checks and rate limits.
          </p>
          <textarea
            id="waf-allow-ips"
            rows="5"
            disabled={!canManage}
            placeholder="203.0.113.10&#10;198.51.100.*"
            class="adm-input font-mono text-[11px] leading-relaxed resize-y"
          >{allowIpsStr}</textarea>
        </div>
      </section>

      <!-- 4. Live Intercept Telemetry Table -->
      <section class="adm-card overflow-hidden">
        <div class="px-4 py-3 border-b border-black/5 flex flex-wrap items-center justify-between gap-2 bg-[#fafafc]">
          <div>
            <h2 class="text-xs sm:text-sm font-bold text-[#1d1d1f]">Live Intercept Telemetry</h2>
            <p class="text-[11px] text-[#86868b]">Latest 30 blocked requests logged under <code class="font-mono text-[10px]">source = 'EDGE_WAF'</code>.</p>
          </div>
          <span class="text-[11px] font-mono text-[#86868b]" id="waf-logs-count">{logs.length} records</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead class="adm-thead">
              <tr>
                <th class="adm-th">Time</th>
                <th class="adm-th">Attacker IP & Geo</th>
                <th class="adm-th">Matched Mode</th>
                <th class="adm-th">Request Path</th>
                <th class="adm-th">Matched Sample</th>
                {canManage && <th class="adm-th text-right">Action</th>}
              </tr>
            </thead>
            <tbody id="waf-logs-tbody" class="divide-y divide-black/5">
              {logs.length === 0 ? (
                <tr>
                  <td colspan={canManage ? 6 : 5} class="px-4 py-8 text-center text-[#86868b]">
                    No intercepted attacks recorded yet.
                  </td>
                </tr>
              ) : (
                logs.map((log) => {
                  const ctx = parseLogContext(log.context_json);
                  const badge = modeBadgeLabel(ctx.mode);
                  const ipVal = (log.client_ip || '').trim();
                  const hitCount = Math.max(1, Number(log.hit_count || ctx.hitCount || 1));
                  const statusCode = Number(log.status_code || ctx.statusCode || 403);
                  const countCls = statusCode === 429
                    ? 'bg-amber-50 text-amber-800 border-amber-200/80'
                    : 'bg-rose-50 text-rose-700 border-rose-200/80';
                  const createdIso = toIsoUtcString(log.created_at);
                  const createdFallback = formatUtcFallback(log.created_at);
                  const lastIso = ctx.lastBlockedAt ? toIsoUtcString(ctx.lastBlockedAt) : '';
                  const lastFallback = ctx.lastBlockedAt ? formatUtcFallback(ctx.lastBlockedAt) : '';
                  return (
                    <tr class="hover:bg-[#fafafc] transition-colors">
                      <td class="adm-td whitespace-nowrap font-mono text-[11px] text-[#52525b]">
                        <div>
                          <time data-admin-time={createdIso} data-admin-time-mode="short" title={createdFallback}>
                            {createdFallback}
                          </time>
                        </div>
                        {lastIso && hitCount > 1 && (
                          <div class="text-[10px] text-[#86868b]">
                            <time
                              data-admin-time={lastIso}
                              data-admin-time-mode="short"
                              data-admin-time-prefix="Last: "
                              data-admin-time-title-prefix="Last hit: "
                              title={`Last hit: ${lastFallback}`}
                            >
                              Last: {lastFallback}
                            </time>
                          </div>
                        )}
                      </td>
                      <td class="adm-td whitespace-nowrap">
                        <div class="font-mono font-semibold text-[#1d1d1f]">{ipVal || 'unknown'}</div>
                        {log.country && (
                          <div class="text-[10px] text-[#86868b]">{log.country}{log.city ? ` · ${log.city}` : ''}</div>
                        )}
                      </td>
                      <td class="adm-td whitespace-nowrap">
                        <div class="inline-flex flex-wrap items-center gap-1">
                          <span class:list={['adm-badge', badge.cls]}>{badge.text}</span>
                          <span class:list={['px-1.5 py-0.5 rounded-md border font-mono text-[10px] font-semibold', countCls]}>
                            {statusCode} ×{hitCount}
                          </span>
                        </div>
                      </td>
                      <td class="adm-td font-mono text-[11px] text-[#1d1d1f] max-w-[220px] truncate" title={`${log.method || 'GET'} ${log.path || ''}`}>
                        <span class="font-bold text-[#52525b] mr-1">{log.method || 'GET'}</span>{log.path || '/'}
                      </td>
                      <td class="adm-td font-mono text-[11px] text-rose-700 max-w-[260px] truncate" title={ctx.matchedSample || log.message}>
                        {ctx.matchedSample || log.message}
                      </td>
                      {canManage && (
                        <td class="adm-td text-right whitespace-nowrap">
                          {ipVal ? (
                            <div class="inline-flex items-center gap-1">
                              <button
                                type="button"
                                class="btn-quick-block-ip px-2 py-1 rounded-lg text-[10px] font-semibold bg-amber-50 text-amber-800 hover:bg-amber-100 border border-amber-200/80 transition-colors cursor-pointer"
                                data-block-ip={ipVal}
                                data-block-ttl="1440"
                                title="Block IP in DB ACL for 24 hours immediately"
                              >
                                Ban 24h
                              </button>
                              <button
                                type="button"
                                class="btn-quick-block-ip px-2 py-1 rounded-lg text-[10px] font-semibold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200/80 transition-colors cursor-pointer"
                                data-block-ip={ipVal}
                                title="Permanently block IP in DB ACL immediately"
                              >
                                + Block
                              </button>
                            </div>
                          ) : (
                            <span class="text-[10px] text-[#86868b]">—</span>
                          )}
                        </td>
                      )}
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="waf-initial-data" set:html={initialPayload} />

  <script>
    import { escapeHtml, formatAdminTime, readJsonStore } from '@utils/adminWorkbench';

    let wafAbort: AbortController | null = null;

    function parseIpsClient(raw: string): string[] {
      return Array.from(
        new Set(
          (raw || '')
            .split(/[\s,;]+/)
            .map((s) => s.trim().toLowerCase())
            .filter(Boolean)
        )
      );
    }

    function initWafPage() {
      const root = document.getElementById('waf-workbench-root');
      if (!root) return;

      wafAbort?.abort();
      wafAbort = new AbortController();
      const { signal } = wafAbort;

      const initial = readJsonStore<{
        canManage?: boolean;
        activeModes?: string[];
        blockedIps?: string;
        allowIps?: string;
        ruleConfig?: Record<string, any>;
        dbRules?: any[];
        ipAcl?: any[];
        defaultRuleConfig?: Record<string, any>;
      }>('waf-initial-data', { canManage: false });
      const canManage = Boolean(initial.canManage);

      const showToast = (msg: string, ok: boolean) => {
        (window as any).__showToast?.(msg, ok);
      };

      const saveBtn = document.getElementById('waf-save-btn') as HTMLButtonElement | null;
      const resetBtn = document.getElementById('waf-reset-btn') as HTMLButtonElement | null;
      const refreshBtn = document.getElementById('waf-refresh-btn') as HTMLButtonElement | null;
      const clearStrikesBtn = document.getElementById('waf-clear-strikes-btn') as HTMLButtonElement | null;
      const blockedTextarea = document.getElementById('waf-blocked-ips') as HTMLTextAreaElement | null;
      const allowTextarea = document.getElementById('waf-allow-ips') as HTMLTextAreaElement | null;

      const clampInput = (id: string, fallback: number, min: number, max: number) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        const n = Number(el?.value);
        if (!Number.isFinite(n)) return fallback;
        return Math.min(max, Math.max(min, Math.round(n)));
      };

      const getCheckbox = (group: string, key: string) =>
        document.querySelector<HTMLInputElement>(`.waf-sub-checkbox[data-waf-group="${group}"][data-waf-key="${key}"]`);

      let dbRulesState: any[] = Array.isArray(initial.dbRules) ? initial.dbRules.map((r) => ({ ...r })) : [];
      let activeRuleFilter = 'all';

      const CUSTOM_FIELD_LABELS: Record<string, string> = {
        path: 'If Path',
        path_matches: 'If Path',
        header: 'If Request Header',
        header_contains: 'If Request Header',
        query: 'If Query String',
        query_contains: 'If Query String',
        payload_targets: 'If Payload + Headers',
        ua: 'If User-Agent',
        ua_contains: 'If User-Agent',
        method: 'If Method',
        ip: 'If Client IP',
        ip_matches: 'If Client IP',
        country: 'If Country',
        country_equals: 'If Country',
      };

      const applyRuleFilter = () => {
        document.querySelectorAll<HTMLElement>('.waf-unified-rule-row').forEach((row) => {
          const scope = row.dataset.ruleScope || 'custom';
          const visible = activeRuleFilter === 'all' || activeRuleFilter === scope;
          row.classList.toggle('hidden', !visible);
        });
        document.querySelectorAll<HTMLButtonElement>('.waf-filter-tab').forEach((tab) => {
          const isActive = (tab.dataset.ruleFilter || 'all') === activeRuleFilter;
          tab.classList.toggle('bg-white', isActive);
          tab.classList.toggle('text-[#1d1d1f]', isActive);
          tab.classList.toggle('font-semibold', isActive);
          tab.classList.toggle('shadow-2xs', isActive);
          tab.classList.toggle('text-[#52525b]', !isActive);
          tab.classList.toggle('font-medium', !isActive);
        });
      };

      const renderCustomRules = () => {
        const listEl = document.getElementById('waf-custom-rules-list');
        const countEl = document.getElementById('waf-custom-rules-count');
        const presetCount = Number(countEl?.dataset.presetCount || 17);
        const customRows = dbRulesState.filter((r) => r.is_system === 0);

        if (countEl) {
          countEl.textContent = `${presetCount + customRows.length} Rules (${presetCount} Preset · ${customRows.length} Custom)`;
        }
        const allTab = document.querySelector<HTMLButtonElement>('.waf-filter-tab[data-rule-filter="all"]');
        const customTab = document.querySelector<HTMLButtonElement>('.waf-filter-tab[data-rule-filter="custom"]');
        if (allTab) allTab.textContent = `All (${presetCount + customRows.length})`;
        if (customTab) customTab.textContent = `Custom (${customRows.length})`;

        // Sync preset checkboxes, opacity, priority & action badges from DB rules state when available
        const sysMap = new Map(dbRulesState.filter((r) => r.is_system === 1).map((r) => [r.id, r]));
        document.querySelectorAll<HTMLElement>('.waf-unified-rule-row[data-sys-rule-id]').forEach((row) => {
          const sysId = row.dataset.sysRuleId || '';
          const sysRule = sysMap.get(sysId);
          if (!sysRule) return;
          const isEnabled = sysRule.is_enabled !== 0;
          const cb = row.querySelector<HTMLInputElement>('.waf-sub-checkbox[data-sys-rule-id]');
          if (cb) {
            cb.checked = isEnabled;
            row.classList.toggle('opacity-55', !isEnabled);
          }
          const priEl = row.querySelector<HTMLElement>('[data-sys-priority]');
          if (priEl) priEl.textContent = `P${Number(sysRule.priority ?? 100)}`;
          const actionEl = row.querySelector<HTMLElement>('[data-sys-action-badge]');
          if (actionEl) {
            const act = sysRule.action;
            actionEl.className = `adm-badge ${
              act === 'rate_limit_429' || act === 'block_404' ? 'adm-badge-warn' : act === 'allow' ? 'adm-badge-ok' : act === 'log_only' ? 'adm-badge-info' : 'adm-badge-err'
            }`;
            actionEl.textContent =
              act === 'log_only'
                ? 'Shadow Log'
                : act === 'allow'
                  ? 'Allow'
                  : act === 'rate_limit_429'
                    ? '429 Throttle'
                    : act === 'block_404'
                      ? '404 Fast-Path'
                      : act === 'challenge_fingerprint'
                        ? 'Challenge'
                        : '403 Block';
          }
        });

        if (!listEl) return;

        if (!customRows.length) {
          listEl.innerHTML = activeRuleFilter === 'custom'
            ? `<div class="rounded-xl border border-dashed border-black/10 bg-[#fafafc] px-3 py-4 text-center text-[11px] text-[#86868b]">No custom database rules configured yet. Use the builder above to add incremental WAF rules.</div>`
            : '';
          applyRuleFilter();
          return;
        }

        listEl.innerHTML = customRows.map((rule) => {
          let conds: any[] = [];
          try {
            const parsed = JSON.parse(rule.conditions_json || '[]');
            if (Array.isArray(parsed)) conds = parsed;
          } catch {}
          let rl: any = {};
          try {
            rl = JSON.parse(rule.rate_limit_json || '{}') || {};
          } catch {}

          const condChips = conds.map((c, idx) => {
            const fieldLabel = CUSTOM_FIELD_LABELS[c.field] || c.field;
            const headerChip = c.headerName
              ? `<code class="ml-0.5 font-mono text-[10px]">[${escapeHtml(c.headerName)}]</code>`
              : '';
            const opLabel = escapeHtml(String(c.op || 'contains').replace(/_/g, ' '));
            const joinBadge = idx > 0 ? `<span class="text-[10px] font-bold text-[#86868b]">${escapeHtml(rule.match_mode || 'ALL')}</span>` : '';
            return `<span class="inline-flex items-center gap-1">${joinBadge}<span class="font-medium text-[#52525b]">${escapeHtml(fieldLabel)}${headerChip}</span><span class="font-mono text-[10px] text-[#52525b] bg-black/5 px-1 py-0.5 rounded">${opLabel}</span><code class="font-mono text-[10px] text-[#1d1d1f] bg-white border border-black/10 px-1.5 py-0.5 rounded break-all">"${escapeHtml(c.value || '')}"</code></span>`;
          }).join('');

          const actionCls = rule.action === 'rate_limit_429' || rule.action === 'block_404'
            ? 'adm-badge-warn'
            : rule.action === 'allow'
              ? 'adm-badge-ok'
              : rule.action === 'log_only'
                ? 'adm-badge-info'
                : 'adm-badge-err';
          const actionText = rule.action === 'rate_limit_429'
            ? `429 Throttle${rl.limit ? ` (${rl.limit} req)` : ''}`
            : rule.action === 'block_404'
              ? '404 Fast-Path'
              : rule.action === 'allow'
                ? 'Allow'
                : rule.action === 'log_only'
                  ? 'Shadow Log'
                  : '403 Block';
          const strikeChip = Number(rule.strike_weight || 0) > 0
            ? `<span class="px-1.5 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200/70 text-[10px] font-mono">+${Number(rule.strike_weight)} strike</span>`
            : '';
          const ttlChip = rule.expires_at
            ? `<span class="px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200/70 text-[10px] font-mono" title="Expires UTC: ${escapeHtml(rule.expires_at)}">TTL</span>`
            : '';
          const editBtn = canManage
            ? `<button type="button" data-edit-rule-id="${escapeHtml(rule.id)}" class="waf-rule-edit-btn px-2 py-0.5 rounded-lg text-[10px] font-semibold text-[#52525b] hover:text-[#1d1d1f] hover:bg-black/5 cursor-pointer">Edit</button>`
            : '';
          const deleteBtn = canManage
            ? `<button type="button" data-rule-id="${escapeHtml(rule.id)}" aria-label="Delete rule" title="Delete rule from DB" class="waf-custom-rule-delete w-6 h-6 rounded-lg text-xs font-bold text-[#86868b] hover:text-rose-700 hover:bg-rose-50 transition-colors cursor-pointer flex items-center justify-center">×</button>`
            : '';
          const isEnabled = rule.is_enabled !== 0;

          return `
            <div data-custom-rule-id="${escapeHtml(rule.id)}" data-rule-scope="custom" class="waf-unified-rule-row rounded-xl border border-black/8 bg-[#fafafc] px-3 py-2 flex flex-wrap items-center justify-between gap-2 transition-opacity ${isEnabled ? '' : 'opacity-55'}">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <input id="waf-cr-${escapeHtml(rule.id)}" type="checkbox" autocomplete="off" data-rule-id="${escapeHtml(rule.id)}" ${isEnabled ? 'checked' : ''} ${canManage ? '' : 'disabled'} aria-label="Toggle custom rule ${escapeHtml(rule.name || rule.id)}" class="waf-custom-rule-toggle w-3.5 h-3.5 accent-[#1d1d1f] rounded cursor-pointer shrink-0" />
                <span class="px-1.5 py-0.5 rounded-md border text-[10px] font-semibold bg-sky-50 text-sky-700 border-sky-200/80 shrink-0">P${Number(rule.priority ?? 50)}</span>
                <div class="flex flex-wrap items-center gap-1.5 text-[11px] min-w-0">
                  <span class="font-semibold text-[#1d1d1f]">${escapeHtml(rule.name || rule.id)}</span>
                  ${condChips}
                  ${strikeChip}
                  ${ttlChip}
                </div>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="adm-badge ${actionCls}">${actionText}</span>
                ${editBtn}
                ${deleteBtn}
              </div>
            </div>
          `;
        }).join('');
        applyRuleFilter();
      };

      const collectRuleConfig = () => ({
        malicious: {
          enableIpBlacklist: Boolean(getCheckbox('malicious', 'enableIpBlacklist')?.checked),
          enableAutoBan: Boolean(getCheckbox('malicious', 'enableAutoBan')?.checked),
          autoBanOnRateAbuse: Boolean(getCheckbox('malicious', 'autoBanOnRateAbuse')?.checked),
          strikeLimit: clampInput('waf-mal-strike-limit', 3, 1, 50),
          banDurationMinutes: clampInput('waf-mal-ban-minutes', 15, 1, 1440),
          enableProbePaths: Boolean(getCheckbox('malicious', 'enableProbePaths')?.checked),
          enablePathTraversal: Boolean(getCheckbox('malicious', 'enablePathTraversal')?.checked),
          enableXss: Boolean(getCheckbox('malicious', 'enableXss')?.checked),
          enableSqli: Boolean(getCheckbox('malicious', 'enableSqli')?.checked),
        },
        rateLimit: {
          windowSeconds: clampInput('waf-rl-window', 60, 10, 3600),
          publicWriteLimit: clampInput('waf-rl-pub-write', 5, 1, 500),
          apiLimit: clampInput('waf-rl-api', 30, 1, 1000),
          pageLimit: clampInput('waf-rl-page', 90, 1, 5000),
        },
        bot: {
          blockEmptyUa: Boolean(getCheckbox('bot', 'blockEmptyUa')?.checked),
          blockScannerTools: Boolean(getCheckbox('bot', 'blockScannerTools')?.checked),
          blockCliScrapers: Boolean(getCheckbox('bot', 'blockCliScrapers')?.checked),
          blockAiCrawlers: Boolean(getCheckbox('bot', 'blockAiCrawlers')?.checked),
          blockSeoBots: Boolean(getCheckbox('bot', 'blockSeoBots')?.checked),
          blockUaRotation: Boolean(getCheckbox('bot', 'blockUaRotation')?.checked),
          enforceQuoteFingerprint: Boolean(getCheckbox('bot', 'enforceQuoteFingerprint')?.checked),
        },
      });

      const applyRuleConfig = (cfg: any) => {
        if (!cfg || typeof cfg !== 'object') return;
        const setVal = (id: string, v: unknown) => {
          const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el && v !== undefined && v !== null) el.value = String(v);
        };
        if (cfg.malicious) {
          setVal('waf-mal-strike-limit', cfg.malicious.strikeLimit);
          setVal('waf-mal-ban-minutes', cfg.malicious.banDurationMinutes);
        }
        if (cfg.rateLimit) {
          setVal('waf-rl-window', cfg.rateLimit.windowSeconds);
          setVal('waf-rl-pub-write', cfg.rateLimit.publicWriteLimit);
          setVal('waf-rl-api', cfg.rateLimit.apiLimit);
          setVal('waf-rl-page', cfg.rateLimit.pageLimit);
        }
      };

      const applyServerState = (state: {
        activeModes?: string[];
        blockedIps?: string;
        allowIps?: string;
        ruleConfig?: Record<string, any>;
        dbRules?: any[];
      }) => {
        if (Array.isArray(state.activeModes)) {
          const modeSet = new Set(state.activeModes);
          document.querySelectorAll<HTMLInputElement>('.waf-mode-checkbox').forEach((cb) => {
            cb.checked = modeSet.has(cb.value);
          });
        }
        if (blockedTextarea && typeof state.blockedIps === 'string') {
          blockedTextarea.value = state.blockedIps;
        }
        if (allowTextarea && typeof state.allowIps === 'string') {
          allowTextarea.value = state.allowIps;
        }
        if (Array.isArray(state.dbRules)) {
          dbRulesState = state.dbRules.map((r: any) => ({ ...r }));
        }
        if (state.ruleConfig) {
          applyRuleConfig(state.ruleConfig);
        }
        if (Array.isArray(state.dbRules)) {
          renderCustomRules();
        }
      };

      let hasUnsavedChanges = false;
      const setDirty = (dirty: boolean) => {
        hasUnsavedChanges = dirty;
        (window as any).__adminHasUnsavedChanges = dirty;
        if (saveBtn) {
          saveBtn.classList.toggle('ring-2', dirty);
          saveBtn.classList.toggle('ring-amber-400', dirty);
        }
      };

      const syncModeCardsAndKpis = () => {
        const checkedModes: string[] = [];
        document.querySelectorAll<HTMLInputElement>('.waf-mode-checkbox').forEach((cb) => {
          const mode = cb.value;
          const card = document.querySelector<HTMLElement>(`[data-waf-card="${mode}"]`);
          const badge = document.querySelector<HTMLElement>(`[data-mode-badge="${mode}"]`);
          if (cb.checked) checkedModes.push(mode);

          if (card) {
            card.classList.toggle('bg-white', cb.checked);
            card.classList.toggle('border-black/20', cb.checked);
            card.classList.toggle('shadow-xs', cb.checked);
            card.classList.toggle('ring-1', cb.checked);
            card.classList.toggle('ring-black/5', cb.checked);
            card.classList.toggle('bg-[#fafafc]', !cb.checked);
            card.classList.toggle('border-black/8', !cb.checked);
          }
          if (badge) {
            badge.textContent = cb.checked ? 'ENFORCING' : 'DISABLED';
            badge.className = `adm-badge ${cb.checked ? 'adm-badge-ok' : 'adm-badge-neutral'}`;
          }
        });

        const modeCheckedSet = new Set(checkedModes);
        document.querySelectorAll<HTMLElement>('[data-preset-mode-pill]').forEach((pill) => {
          const mode = pill.dataset.presetModePill || '';
          pill.classList.toggle('hidden', modeCheckedSet.has(mode));
        });
        document.querySelectorAll<HTMLInputElement>('[data-rate-mode-sync]').forEach((rlCb) => {
          const mode = rlCb.dataset.rateModeSync || '';
          rlCb.checked = modeCheckedSet.has(mode);
        });

        document.querySelectorAll<HTMLInputElement>('.waf-sub-checkbox').forEach((cb) => {
          const group = cb.dataset.wafGroup;
          const key = cb.dataset.wafKey;
          const mode = group === 'malicious' ? 'block_malicious_ips' : 'bot_challenge';
          const row = document.querySelector<HTMLElement>(`[data-cond-row="${mode}:${key}"]`);
          row?.classList.toggle('opacity-55', !cb.checked);
        });

        const cfg = collectRuleConfig();
        const policyEl = document.getElementById('kpi-autoban-policy');
        if (policyEl) {
          policyEl.textContent = cfg.malicious.enableAutoBan
            ? `${cfg.malicious.strikeLimit} Strikes · ${cfg.malicious.banDurationMinutes}m`
            : 'Auto-Ban Off';
        }
        const autoBanExprEl = document.querySelector<HTMLElement>('[data-preset-dynamic="enableAutoBan"]');
        if (autoBanExprEl) {
          autoBanExprEl.textContent = `${cfg.malicious.strikeLimit} strikes → auto-ban IP for ${cfg.malicious.banDurationMinutes}m`;
        }

        (['publicWriteLimit', 'apiLimit', 'pageLimit'] as const).forEach((key) => {
          const badge = document.querySelector<HTMLElement>(`[data-rate-badge="${key}"]`);
          if (badge) {
            badge.textContent = `429 > ${cfg.rateLimit[key]} req/${cfg.rateLimit.windowSeconds}s`;
          }
        });
        const retryPill = document.querySelector<HTMLElement>('[data-rate-retry-pill]');
        if (retryPill) {
          retryPill.textContent = `429 Too Many Requests (WAF_STRICT_RATE_LIMIT) + Retry-After: ${cfg.rateLimit.windowSeconds}`;
        }

        const modesCountEl = document.getElementById('kpi-modes-count');
        const modesBadgeEl = document.getElementById('kpi-modes-badge');
        if (modesCountEl) modesCountEl.textContent = `${checkedModes.length} / 3`;
        if (modesBadgeEl) {
          modesBadgeEl.textContent = checkedModes.length > 0 ? 'ACTIVE' : 'WAF Standby';
          modesBadgeEl.className = `adm-badge ${checkedModes.length > 0 ? 'adm-badge-ok' : 'adm-badge-warn'}`;
        }

        const blockedEl = document.getElementById('kpi-blocked-ips');
        const allowEl = document.getElementById('kpi-allow-ips');
        if (blockedEl && blockedTextarea) {
          blockedEl.textContent = String(parseIpsClient(blockedTextarea.value).length);
        }
        if (allowEl && allowTextarea) {
          allowEl.textContent = `+${parseIpsClient(allowTextarea.value).length} Whitelisted`;
        }
      };

      let autoSaveTimer: ReturnType<typeof setTimeout> | null = null;
      let isSaving = false;
      let pendingSave = false;

      signal.addEventListener('abort', () => {
        if (autoSaveTimer) {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = null;
        }
      });

      const scheduleAutoSave = () => {
        if (autoSaveTimer) clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => {
          autoSaveTimer = null;
          void saveRules();
        }, 250);
      };

      document.querySelectorAll<HTMLInputElement>('.waf-mode-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          syncModeCardsAndKpis();
          setDirty(true);
          scheduleAutoSave();
        }, { signal });
      });

      document.querySelectorAll<HTMLInputElement>('.waf-sub-checkbox').forEach((cb) => {
        cb.addEventListener('change', async () => {
          const ruleId = cb.dataset.sysRuleId;
          if (!ruleId || !canManage) return;
          const nextChecked = cb.checked;
          cb.disabled = true;
          try {
            const { ok, data } = await postWafAction({ action: 'toggle_rule', ruleId, is_enabled: nextChecked });
            if (ok && Array.isArray(data.dbRules)) {
              dbRulesState = data.dbRules;
              renderCustomRules();
              syncModeCardsAndKpis();
              showToast(`Preset rule ${nextChecked ? 'enabled' : 'disabled'}.`, true);
            } else {
              cb.checked = !nextChecked;
              syncModeCardsAndKpis();
              showToast(data?.error || 'Failed to toggle preset rule.', false);
            }
          } catch (err: any) {
            cb.checked = !nextChecked;
            syncModeCardsAndKpis();
            showToast(`Toggle error: ${err.message}`, false);
          } finally {
            cb.disabled = false;
          }
        }, { signal });
      });

      // Unified Filter Tabs
      document.getElementById('waf-rule-filter-tabs')?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest?.('.waf-filter-tab') as HTMLButtonElement | null;
        if (!btn) return;
        activeRuleFilter = btn.dataset.ruleFilter || 'all';
        renderCustomRules();
      }, { signal });

      // Custom Logical Condition Builder Events
      const builderFieldEl = document.getElementById('waf-builder-field') as HTMLSelectElement | null;
      const builderOperatorEl = document.getElementById('waf-builder-operator') as HTMLSelectElement | null;
      const builderHeaderWrap = document.getElementById('waf-builder-header-wrap');
      const builderHeaderInput = document.getElementById('waf-builder-header-name') as HTMLInputElement | null;
      const builderValueWrap = document.getElementById('waf-builder-value-wrap');
      const builderValueInput = document.getElementById('waf-builder-value') as HTMLInputElement | null;
      const builderActionEl = document.getElementById('waf-builder-action') as HTMLSelectElement | null;
      const builderLimitWrap = document.getElementById('waf-builder-limit-wrap');
      const builderLimitInput = document.getElementById('waf-builder-limit') as HTMLInputElement | null;
      const builderAddBtn = document.getElementById('waf-builder-add-btn') as HTMLButtonElement | null;
      const customRulesListEl = document.getElementById('waf-custom-rules-list');

      const syncBuilderFieldUI = () => {
        if (!builderFieldEl) return;
        const field = builderFieldEl.value;
        const isHeader = field === 'header' || field === 'header_contains';
        const isRate = builderActionEl?.value === 'rate_limit_429';
        builderHeaderWrap?.classList.toggle('hidden', !isHeader);
        builderHeaderWrap?.classList.toggle('block', isHeader);
        builderLimitWrap?.classList.toggle('hidden', !isRate);
        builderLimitWrap?.classList.toggle('block', isRate);
        if (builderValueWrap) {
          const cols = 4 - (isHeader ? 2 : 0) - (isRate ? 1 : 0);
          builderValueWrap.classList.toggle('md:col-span-4', cols >= 4);
          builderValueWrap.classList.toggle('md:col-span-3', cols === 3);
          builderValueWrap.classList.toggle('md:col-span-2', cols === 2);
          builderValueWrap.classList.toggle('md:col-span-1', cols <= 1);
        }
        const selectedOpt = builderFieldEl.options[builderFieldEl.selectedIndex];
        const ph = selectedOpt?.getAttribute('data-placeholder');
        if (builderValueInput && ph) builderValueInput.placeholder = ph;
      };
      builderFieldEl?.addEventListener('change', syncBuilderFieldUI, { signal });
      builderActionEl?.addEventListener('change', syncBuilderFieldUI, { signal });
      syncBuilderFieldUI();

      document.getElementById('waf-cond2-toggle-btn')?.addEventListener('click', () => {
        document.getElementById('waf-builder-cond2-wrap')?.classList.toggle('hidden');
      }, { signal });

      const postWafAction = async (payload: Record<string, any>) => {
        const res = await fetch('/api/admin/waf', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        return { ok: res.ok && Boolean(data?.success), data };
      };

      const addCustomRuleFromBuilder = async () => {
        if (!canManage || !builderFieldEl || !builderOperatorEl || !builderValueInput || !builderActionEl) return;
        const field = builderFieldEl.value;
        const op = builderOperatorEl.value;
        const action = builderActionEl.value;
        let headerName = (field === 'header' || field === 'header_contains')
          ? (builderHeaderInput?.value || '').trim().toLowerCase().replace(/[^a-z0-9-]/g, '')
          : '';
        let value = builderValueInput.value.trim().slice(0, 256);

        if ((field === 'header' || field === 'header_contains') && !headerName && value.includes(':')) {
          const idx = value.indexOf(':');
          const prefix = value.slice(0, idx).trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
          const rest = value.slice(idx + 1).trim();
          if (prefix && rest) {
            headerName = prefix;
            value = rest;
          }
        }

        if (!value) {
          showToast('Please enter a pattern / value to match.', false);
          builderValueInput.focus();
          return;
        }

        const conditions: any[] = [{ field, op, ...(headerName ? { headerName } : {}), value }];
        const f2 = (document.getElementById('waf-builder-field2') as HTMLSelectElement | null)?.value;
        const op2 = (document.getElementById('waf-builder-operator2') as HTMLSelectElement | null)?.value;
        let v2 = ((document.getElementById('waf-builder-value2') as HTMLInputElement | null)?.value || '').trim();
        if (f2 && op2 && v2) {
          let h2 = '';
          if (f2 === 'header' && v2.includes(':')) {
            const idx2 = v2.indexOf(':');
            h2 = v2.slice(0, idx2).trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
            v2 = v2.slice(idx2 + 1).trim();
          }
          if (v2) conditions.push({ field: f2, op: op2, ...(h2 ? { headerName: h2 } : {}), value: v2 });
        }

        const parsedLimit = action === 'rate_limit_429'
          ? Math.min(5000, Math.max(1, Math.round(Number(builderLimitInput?.value || 20))))
          : undefined;
        const customName = ((document.getElementById('waf-builder-name') as HTMLInputElement | null)?.value || '').trim();
        const matchMode = (document.getElementById('waf-builder-match-mode') as HTMLSelectElement | null)?.value === 'ANY' ? 'ANY' : 'ALL';
        const priority = clampInput('waf-builder-priority', 50, 1, 999);
        const strikeWeight = clampInput('waf-builder-strike', 0, 0, 10);
        const ttlMins = Number((document.getElementById('waf-builder-ttl') as HTMLSelectElement | null)?.value || 0);
        const expiresAt = ttlMins > 0
          ? new Date(Date.now() + ttlMins * 60_000).toISOString().slice(0, 19).replace('T', ' ')
          : null;

        if (builderAddBtn) builderAddBtn.disabled = true;
        try {
          const { ok, data } = await postWafAction({
            action: 'upsert_rule',
            rule: {
              id: `cr_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 6)}`,
              category: 'custom',
              name: customName || `${CUSTOM_FIELD_LABELS[field] || field} ${op} "${value.slice(0, 28)}"`,
              is_system: 0,
              is_enabled: 1,
              priority,
              conditions,
              match_mode: matchMode,
              action,
              rate_limit: parsedLimit ? { limit: parsedLimit, key_by: 'ip' } : {},
              strike_weight: strikeWeight,
              expires_at: expiresAt,
            },
          });
          if (!ok) {
            showToast(data?.error || 'Failed to save rule.', false);
            return;
          }
          if (Array.isArray(data.dbRules)) {
            dbRulesState = data.dbRules;
          }
          builderValueInput.value = '';
          if (builderHeaderInput) builderHeaderInput.value = '';
          const nameEl = document.getElementById('waf-builder-name') as HTMLInputElement | null;
          if (nameEl) nameEl.value = '';
          const v2El = document.getElementById('waf-builder-value2') as HTMLInputElement | null;
          if (v2El) v2El.value = '';
          renderCustomRules();
          syncModeCardsAndKpis();
          showToast(data.message || 'Rule saved.', true);
        } catch (err: any) {
          showToast(`Save rule failed: ${err.message}`, false);
        } finally {
          if (builderAddBtn) builderAddBtn.disabled = false;
        }
      };

      // Rule Simulator (Dry-Run)
      const simToggleBtn = document.getElementById('waf-sim-toggle-btn');
      const simPanel = document.getElementById('waf-sim-panel');
      const simChevron = document.getElementById('waf-sim-chevron');
      const simRunBtn = document.getElementById('waf-sim-run-btn') as HTMLButtonElement | null;
      const simResultEl = document.getElementById('waf-sim-result');

      simToggleBtn?.addEventListener('click', () => {
        const isHidden = simPanel?.classList.toggle('hidden');
        if (simChevron) simChevron.textContent = isHidden ? '▸' : '▾';
      }, { signal });

      simRunBtn?.addEventListener('click', async () => {
        if (!simRunBtn || !simResultEl) return;
        const selectedModes = Array.from(document.querySelectorAll<HTMLInputElement>('.waf-mode-checkbox'))
          .filter((cb) => cb.checked)
          .map((cb) => cb.value);

        simRunBtn.disabled = true;
        try {
          const res = await fetch('/api/admin/waf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'simulate',
              waf_active_modes: selectedModes,
              waf_blocked_ips: blockedTextarea?.value || '',
              waf_allow_ips: allowTextarea?.value || '',
              waf_rule_config: collectRuleConfig(),
              sim: {
                method: (document.getElementById('waf-sim-method') as HTMLSelectElement | null)?.value || 'GET',
                pathname: (document.getElementById('waf-sim-path') as HTMLInputElement | null)?.value || '/',
                clientIp: (document.getElementById('waf-sim-ip') as HTMLInputElement | null)?.value || '',
                country: (document.getElementById('waf-sim-country') as HTMLInputElement | null)?.value || '',
                userAgent: (document.getElementById('waf-sim-ua') as HTMLInputElement | null)?.value || '',
                headerRaw: (document.getElementById('waf-sim-header') as HTMLInputElement | null)?.value || '',
              },
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            showToast(data.error || 'Simulation failed.', false);
            return;
          }
          const r = data.result;
          simResultEl.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-700', 'border-emerald-200', 'bg-rose-50', 'text-rose-700', 'border-rose-200', 'bg-amber-50', 'text-amber-800', 'border-amber-200');
          if (r.allowed) {
            if (r.shadowMatch) {
              simResultEl.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-200');
              simResultEl.textContent = `ALLOWED · SHADOW: ${r.shadowMatch.reason}`;
            } else {
              simResultEl.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
              simResultEl.textContent = 'ALLOWED (200 OK)';
            }
          } else {
            if (r.status === 429) {
              simResultEl.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-200');
            } else {
              simResultEl.classList.add('bg-rose-50', 'text-rose-700', 'border-rose-200');
            }
            simResultEl.textContent = `BLOCKED (${r.status}) · ${r.reason || r.code}`;
          }
        } catch (err: any) {
          showToast(`Simulate error: ${err.message}`, false);
        } finally {
          simRunBtn.disabled = false;
        }
      }, { signal });

      builderAddBtn?.addEventListener('click', addCustomRuleFromBuilder, { signal });
      [builderValueInput, builderHeaderInput].forEach((inp) => {
        inp?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            addCustomRuleFromBuilder();
          }
        }, { signal });
      });

      customRulesListEl?.addEventListener('change', async (e) => {
        const target = e.target as HTMLInputElement | null;
        if (!target || !target.classList.contains('waf-custom-rule-toggle') || !canManage) return;
        const ruleId = target.dataset.ruleId;
        if (!ruleId) return;
        target.disabled = true;
        try {
          const { ok, data } = await postWafAction({ action: 'toggle_rule', ruleId, is_enabled: target.checked });
          if (ok && Array.isArray(data.dbRules)) {
            dbRulesState = data.dbRules;
            renderCustomRules();
            showToast(`Rule ${target.checked ? 'enabled' : 'disabled'}.`, true);
          } else {
            target.checked = !target.checked;
            showToast(data?.error || 'Failed to toggle rule.', false);
          }
        } catch (err: any) {
          target.checked = !target.checked;
          showToast(`Toggle error: ${err.message}`, false);
        } finally {
          target.disabled = false;
        }
      }, { signal });

      customRulesListEl?.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement | null)?.closest?.('.waf-custom-rule-delete') as HTMLButtonElement | null;
        if (!btn || !canManage) return;
        const ruleId = btn.dataset.ruleId;
        if (!ruleId) return;
        btn.disabled = true;
        try {
          const { ok, data } = await postWafAction({ action: 'delete_rule', ruleId });
          if (ok && Array.isArray(data.dbRules)) {
            dbRulesState = data.dbRules;
            renderCustomRules();
            syncModeCardsAndKpis();
            showToast(data.message || 'Deleted rule from DB.', true);
          } else {
            showToast(data?.error || 'Failed to delete rule.', false);
          }
        } catch (err: any) {
          showToast(`Delete failed: ${err.message}`, false);
        } finally {
          btn.disabled = false;
        }
      }, { signal });

      // DB Rule Edit Dialog (supports editing built-in sys_* regexes/actions & custom rules)
      const editDialog = document.getElementById('waf-rule-edit-dialog') as HTMLDialogElement | null;
      const editIdEl = document.getElementById('waf-edit-id') as HTMLInputElement | null;
      const editTitleEl = document.getElementById('waf-edit-title');
      const editSubtitleEl = document.getElementById('waf-edit-subtitle');
      const editNameEl = document.getElementById('waf-edit-name') as HTMLInputElement | null;
      const editActionEl = document.getElementById('waf-edit-action') as HTMLSelectElement | null;
      const editPriorityEl = document.getElementById('waf-edit-priority') as HTMLInputElement | null;
      const editMatchModeEl = document.getElementById('waf-edit-match-mode') as HTMLSelectElement | null;
      const editStrikeEl = document.getElementById('waf-edit-strike') as HTMLInputElement | null;
      const editCategoryEl = document.getElementById('waf-edit-category') as HTMLSelectElement | null;
      const editExpiresEl = document.getElementById('waf-edit-expires') as HTMLSelectElement | null;
      const editConditionsEl = document.getElementById('waf-edit-conditions') as HTMLTextAreaElement | null;
      const editRateLimitEl = document.getElementById('waf-edit-ratelimit') as HTMLInputElement | null;

      document.getElementById('waf-condition-builder')?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest?.('.waf-rule-edit-btn') as HTMLButtonElement | null;
        if (!btn || !canManage || !editDialog) return;
        const ruleId = btn.dataset.editRuleId || '';
        const rule = dbRulesState.find((r) => r.id === ruleId);
        if (!rule) {
          showToast('Rule details unavailable; click Refresh first.', false);
          return;
        }
        if (editIdEl) editIdEl.value = rule.id;
        if (editTitleEl) editTitleEl.textContent = rule.is_system === 1 ? 'Edit System Preset Rule' : 'Edit Custom DB Rule';
        if (editSubtitleEl) editSubtitleEl.textContent = `id: ${rule.id} · category: ${rule.category}`;
        if (editNameEl) editNameEl.value = rule.name || '';
        if (editActionEl) editActionEl.value = rule.action || 'block_403';
        if (editPriorityEl) editPriorityEl.value = String(rule.priority ?? 100);
        if (editMatchModeEl) editMatchModeEl.value = rule.match_mode === 'ANY' ? 'ANY' : 'ALL';
        if (editStrikeEl) editStrikeEl.value = String(rule.strike_weight ?? 0);
        if (editCategoryEl) {
          editCategoryEl.value = rule.category || 'custom';
          editCategoryEl.disabled = rule.is_system === 1;
        }
        if (editExpiresEl) {
          const keepOpt = editExpiresEl.querySelector<HTMLOptionElement>('option[value="__keep__"]');
          if (keepOpt) keepOpt.classList.toggle('hidden', !rule.expires_at);
          editExpiresEl.value = rule.expires_at ? '__keep__' : '';
        }
        if (editConditionsEl) {
          try {
            editConditionsEl.value = JSON.stringify(JSON.parse(rule.conditions_json || '[]'), null, 2);
          } catch {
            editConditionsEl.value = rule.conditions_json || '[]';
          }
        }
        if (editRateLimitEl) editRateLimitEl.value = rule.rate_limit_json || '{}';
        editDialog.showModal();
      }, { signal });

      document.getElementById('waf-edit-close-btn')?.addEventListener('click', () => editDialog?.close(), { signal });
      document.getElementById('waf-edit-cancel-btn')?.addEventListener('click', () => editDialog?.close(), { signal });
      document.getElementById('waf-edit-save-btn')?.addEventListener('click', async () => {
        if (!editIdEl || !canManage) return;
        const ruleId = editIdEl.value;
        const prev = dbRulesState.find((r) => r.id === ruleId);
        if (!prev) return;
        const expVal = editExpiresEl?.value ?? '';
        const nextExpiresAt =
          expVal === '__keep__'
            ? (prev.expires_at ?? null)
            : Number(expVal) > 0
              ? new Date(Date.now() + Number(expVal) * 60_000).toISOString().slice(0, 19).replace('T', ' ')
              : null;
        try {
          const { ok, data } = await postWafAction({
            action: 'upsert_rule',
            rule: {
              id: prev.id,
              category: prev.is_system === 1 ? prev.category : (editCategoryEl?.value || prev.category),
              is_system: prev.is_system,
              is_enabled: prev.is_enabled,
              name: editNameEl?.value || prev.name,
              action: editActionEl?.value || prev.action,
              priority: Number(editPriorityEl?.value ?? prev.priority),
              match_mode: editMatchModeEl?.value === 'ANY' ? 'ANY' : 'ALL',
              strike_weight: Number(editStrikeEl?.value ?? prev.strike_weight ?? 0),
              conditions_json: editConditionsEl?.value || '[]',
              rate_limit_json: editRateLimitEl?.value || '{}',
              expires_at: nextExpiresAt,
            },
          });
          if (!ok) {
            showToast(data?.error || 'Validation failed.', false);
            return;
          }
          if (Array.isArray(data.dbRules)) {
            dbRulesState = data.dbRules;
            renderCustomRules();
          }
          editDialog?.close();
          showToast(data.message || 'Rule updated.', true);
        } catch (err: any) {
          showToast(`Save error: ${err.message}`, false);
        }
      }, { signal });

      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.waf-param-input').forEach((el) => {
        el.addEventListener('input', () => {
          syncModeCardsAndKpis();
          setDirty(true);
        }, { signal });
      });

      resetBtn?.addEventListener('click', () => {
        if (!canManage || !initial.defaultRuleConfig) return;
        applyRuleConfig(initial.defaultRuleConfig);
        syncModeCardsAndKpis();
        setDirty(true);
        showToast('Restored recommended WAF defaults (click Save Rules to apply).', true);
      }, { signal });

      blockedTextarea?.addEventListener('input', () => {
        syncModeCardsAndKpis();
        setDirty(true);
      }, { signal });

      allowTextarea?.addEventListener('input', () => {
        syncModeCardsAndKpis();
        setDirty(true);
      }, { signal });

      const bindQuickBlockButtons = () => {
        document.querySelectorAll<HTMLButtonElement>('.btn-quick-block-ip').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const ip = (btn.dataset.blockIp || '').trim();
            if (!ip || !canManage) return;
            const ttlMinutes = Number(btn.dataset.blockTtl || 0);
            btn.disabled = true;
            try {
              const { ok, data } = await postWafAction({
                action: 'block_ip_acl',
                ipAcl: {
                  ip_cidr: ip,
                  list_type: 'BLACKLIST',
                  reason: ttlMinutes > 0 ? `Blocked 24h from WAF telemetry` : `Blocked permanently from WAF telemetry`,
                  ttlMinutes: ttlMinutes > 0 ? ttlMinutes : null,
                },
              });
              if (!ok) {
                showToast(data?.error || 'Failed to block IP.', false);
                return;
              }
              if (blockedTextarea && typeof data.waf_blocked_ips === 'string' && !ttlMinutes) {
                blockedTextarea.value = data.waf_blocked_ips;
              }
              if (Array.isArray(data.activeBans)) {
                renderActiveBans(data.activeBans);
              }
              syncModeCardsAndKpis();
              showToast(ttlMinutes > 0 ? `Blocked ${ip} for 24h.` : `Permanently blocked ${ip}.`, true);
            } catch (err: any) {
              showToast(`Block IP failed: ${err.message}`, false);
            } finally {
              btn.disabled = false;
            }
          }, { signal });
        });
      };
      bindQuickBlockButtons();

      const renderTelemetryRows = (logs: any[]) => {
        const tbody = document.getElementById('waf-logs-tbody');
        const countEl = document.getElementById('waf-logs-count');
        if (countEl) countEl.textContent = `${logs.length} records`;
        if (!tbody) return;

        if (!logs || logs.length === 0) {
          tbody.innerHTML = `<tr><td colspan="${canManage ? 6 : 5}" class="px-4 py-8 text-center text-[#86868b]">No intercepted attacks recorded yet.</td></tr>`;
          return;
        }

        const badgeFor = (mode?: string) => {
          if (mode === 'block_malicious_ips') return ['Block Malicious IPs', 'adm-badge-err'];
          if (mode === 'strict_rate_limiting') return ['Strict Rate Limiting', 'adm-badge-warn'];
          if (mode === 'bot_challenge') return ['Bot Challenge', 'adm-badge-info'];
          return ['Edge WAF', 'adm-badge-neutral'];
        };

        tbody.innerHTML = logs.map((log) => {
          let ctx: Record<string, any> = {};
          try {
            const raw = JSON.parse(log.context_json || '{}') || {};
            ctx = raw.context && typeof raw.context === 'object' ? { ...raw.context, ...raw } : raw;
          } catch {}
          const [modeText, modeCls] = badgeFor(ctx.mode);
          const ipVal = (log.client_ip || '').trim();
          const hitCount = Math.max(1, Number(log.hit_count || ctx.hitCount || 1));
          const statusCode = Number(log.status_code || ctx.statusCode || 403);
          const countCls = statusCode === 429
            ? 'bg-amber-50 text-amber-800 border-amber-200/80'
            : 'bg-rose-50 text-rose-700 border-rose-200/80';
          const lastAt = ctx.lastBlockedAt ? formatAdminTime(ctx.lastBlockedAt, 'short') : '';
          const lastHtml = lastAt && hitCount > 1
            ? `<div class="text-[10px] text-[#86868b]" title="Last hit: ${escapeHtml(lastAt)}">Last: ${escapeHtml(lastAt)}</div>`
            : '';
          const countBadge = `<span class="px-1.5 py-0.5 rounded-md border font-mono text-[10px] font-semibold ${countCls}">${statusCode} ×${hitCount}</span>`;
          const geo = log.country ? `<div class="text-[10px] text-[#86868b]">${escapeHtml(log.country)}${log.city ? ` · ${escapeHtml(log.city)}` : ''}</div>` : '';
          const actionCell = canManage
            ? `<td class="adm-td text-right whitespace-nowrap">${
                ipVal
                  ? `<div class="inline-flex items-center gap-1"><button type="button" class="btn-quick-block-ip px-2 py-1 rounded-lg text-[10px] font-semibold bg-amber-50 text-amber-800 hover:bg-amber-100 border border-amber-200/80 transition-colors cursor-pointer" data-block-ip="${escapeHtml(ipVal)}" data-block-ttl="1440">Ban 24h</button><button type="button" class="btn-quick-block-ip px-2 py-1 rounded-lg text-[10px] font-semibold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200/80 transition-colors cursor-pointer" data-block-ip="${escapeHtml(ipVal)}">+ Block</button></div>`
                  : `<span class="text-[10px] text-[#86868b]">—</span>`
              }</td>`
            : '';
          return `
            <tr class="hover:bg-[#fafafc] transition-colors">
              <td class="adm-td whitespace-nowrap font-mono text-[11px] text-[#52525b]"><div>${escapeHtml(formatAdminTime(log.created_at, 'short'))}</div>${lastHtml}</td>
              <td class="adm-td whitespace-nowrap">
                <div class="font-mono font-semibold text-[#1d1d1f]">${escapeHtml(ipVal || 'unknown')}</div>
                ${geo}
              </td>
              <td class="adm-td whitespace-nowrap"><div class="inline-flex flex-wrap items-center gap-1"><span class="adm-badge ${modeCls}">${escapeHtml(modeText)}</span>${countBadge}</div></td>
              <td class="adm-td font-mono text-[11px] text-[#1d1d1f] max-w-[220px] truncate"><span class="font-bold text-[#52525b] mr-1">${escapeHtml(log.method || 'GET')}</span>${escapeHtml(log.path || '/')}</td>
              <td class="adm-td font-mono text-[11px] text-rose-700 max-w-[260px] truncate">${escapeHtml(ctx.matchedSample || log.message || '')}</td>
              ${actionCell}
            </tr>
          `;
        }).join('');

        bindQuickBlockButtons();
      };

      const refreshTelemetry = async () => {
        if (!refreshBtn) return;
        refreshBtn.classList.add('is-loading');
        try {
          const res = await fetch('/api/admin/waf');
          const data = await res.json();
          if (!res.ok || !data.success) {
            showToast(data.error || 'Failed to refresh WAF telemetry.', false);
            return;
          }
          const blocked24hEl = document.getElementById('kpi-24h-blocked');
          const blocked24hEventsEl = document.getElementById('kpi-24h-events');
          const activeBansEl = document.getElementById('kpi-active-bans');
          const trackedIpsEl = document.getElementById('kpi-tracked-ips');
          if (blocked24hEl) blocked24hEl.textContent = String(data.blocked24hCount ?? 0);
          if (blocked24hEventsEl) {
            const evCount = Number(data.blocked24hEvents ?? 0);
            blocked24hEventsEl.textContent = `across ${evCount} ${evCount === 1 ? 'attack event' : 'attack events'} in 24h`;
          }
          if (activeBansEl) activeBansEl.textContent = String(data.strikeStats?.activeBans ?? 0);
          if (trackedIpsEl) trackedIpsEl.textContent = String(data.strikeStats?.trackedIps ?? 0);
          renderActiveBans(data.activeBans || []);
          if (!hasUnsavedChanges) {
            applyServerState({
              activeModes: data.waf_active_modes,
              blockedIps: data.waf_blocked_ips,
              allowIps: data.waf_allow_ips,
              ruleConfig: data.waf_rule_config,
              dbRules: data.dbRules,
            });
            syncModeCardsAndKpis();
          }
          renderTelemetryRows(data.logs || []);
        } catch (err: any) {
          showToast(`Refresh failed: ${err.message}`, false);
        } finally {
          refreshBtn.classList.remove('is-loading');
        }
      };

      const renderActiveBans = (bans: any[]) => {
        const bar = document.getElementById('waf-active-bans-bar');
        const chips = document.getElementById('waf-active-bans-chips');
        if (!bar || !chips) return;
        bar.classList.toggle('hidden', !bans || bans.length === 0);
        if (!bans || bans.length === 0) {
          chips.innerHTML = '';
          return;
        }
        chips.innerHTML = bans.map((ban) => {
          const unbanBtn = canManage
            ? `<button type="button" data-unban-ip="${escapeHtml(ban.ip)}" class="btn-unban-ip text-[10px] font-sans font-semibold text-rose-700 hover:text-rose-900 underline cursor-pointer ml-0.5">Unban</button>`
            : '';
          return `
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-white border border-rose-200 text-[11px] font-mono text-[#1d1d1f]">
              <span>${escapeHtml(ban.ip)}</span>
              <span class="text-[10px] text-[#86868b]">(${Number(ban.strikes || 0)} strikes · ${Number(ban.remainingMinutes || 1)}m left)</span>
              ${unbanBtn}
            </span>
          `;
        }).join('');
      };

      document.getElementById('waf-active-bans-chips')?.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement | null)?.closest?.('.btn-unban-ip') as HTMLButtonElement | null;
        if (!btn || !canManage) return;
        const ip = btn.dataset.unbanIp || '';
        if (!ip) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/admin/waf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'unban_ip', ip }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            const activeBansEl = document.getElementById('kpi-active-bans');
            const trackedIpsEl = document.getElementById('kpi-tracked-ips');
            if (activeBansEl) activeBansEl.textContent = String(data.strikeStats?.activeBans ?? 0);
            if (trackedIpsEl) trackedIpsEl.textContent = String(data.strikeStats?.trackedIps ?? 0);
            renderActiveBans(data.activeBans || []);
            showToast(`Unbanned ${ip}.`, true);
          } else {
            showToast(data.error || 'Failed to unban IP.', false);
          }
        } catch (err: any) {
          showToast(`Unban failed: ${err.message}`, false);
        } finally {
          btn.disabled = false;
        }
      }, { signal });

      refreshBtn?.addEventListener('click', refreshTelemetry, { signal });

      clearStrikesBtn?.addEventListener('click', async () => {
        clearStrikesBtn.disabled = true;
        try {
          const res = await fetch('/api/admin/waf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'clear_strikes' }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            const activeBansEl = document.getElementById('kpi-active-bans');
            const trackedIpsEl = document.getElementById('kpi-tracked-ips');
            if (activeBansEl) activeBansEl.textContent = String(data.strikeStats?.activeBans ?? 0);
            if (trackedIpsEl) trackedIpsEl.textContent = String(data.strikeStats?.trackedIps ?? 0);
            renderActiveBans(data.activeBans || []);
            showToast('Auto-ban strikes cleared on this edge isolate.', true);
          } else {
            showToast(data.error || 'Failed to clear strikes.', false);
          }
        } catch (err: any) {
          showToast(`Clear strikes failed: ${err.message}`, false);
        } finally {
          clearStrikesBtn.disabled = false;
        }
      }, { signal });

      const saveRules = async () => {
        if (!canManage || !saveBtn) return;
        if (isSaving) {
          pendingSave = true;
          return;
        }
        if (autoSaveTimer) {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = null;
        }
        isSaving = true;
        pendingSave = false;

        const selectedModes = Array.from(document.querySelectorAll<HTMLInputElement>('.waf-mode-checkbox'))
          .filter((cb) => cb.checked)
          .map((cb) => cb.value);

        saveBtn.disabled = true;
        saveBtn.classList.add('is-loading');
        try {
          const res = await fetch('/api/admin/waf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_rules',
              waf_active_modes: selectedModes,
              waf_blocked_ips: blockedTextarea?.value || '',
              waf_allow_ips: allowTextarea?.value || '',
              waf_rule_config: collectRuleConfig(),
            }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            applyServerState({
              activeModes: data.settings?.waf_active_modes,
              blockedIps: data.settings?.waf_blocked_ips,
              allowIps: data.settings?.waf_allow_ips,
              ruleConfig: data.settings?.waf_rule_config,
              dbRules: data.dbRules,
            });
            syncModeCardsAndKpis();
            if (!pendingSave) {
              setDirty(false);
            }
            showToast('Edge WAF rules saved and audit-logged.', true);
          } else {
            showToast(data.error || 'Failed to save WAF rules.', false);
          }
        } catch (err: any) {
          showToast(`Save failed: ${err.message}`, false);
        } finally {
          isSaving = false;
          saveBtn.disabled = false;
          saveBtn.classList.remove('is-loading');
          if (pendingSave) {
            pendingSave = false;
            void saveRules();
          }
        }
      };

      saveBtn?.addEventListener('click', saveRules, { signal });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 's') {
          if (!document.getElementById('waf-workbench-root')) return;
          e.preventDefault();
          if (!e.repeat) saveRules();
        }
      }, { signal });

      // Reconcile DOM controls against SSR truth so browser form restoration never leaves stale checkmarks
      applyServerState(initial);
      syncModeCardsAndKpis();

      window.addEventListener('pageshow', (e) => {
        if (e.persisted && !hasUnsavedChanges) {
          applyServerState(initial);
          syncModeCardsAndKpis();
        }
      }, { signal });

      window.addEventListener('beforeunload', (e) => {
        if (hasUnsavedChanges) {
          e.preventDefault();
          e.returnValue = '';
        }
      }, { signal });
    }

    initWafPage();
    document.addEventListener('shell:page-load', initWafPage);
  </script>
</AdminLayout>
