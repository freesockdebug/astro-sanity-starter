---
// src/pages/admin/users.astro
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import AdminSearchInput from '@components/admin/AdminSearchInput.astro';
import AdminWorkbenchTableShell from '@components/admin/AdminWorkbenchTableShell.astro';
import TableColumnController from '@components/admin/TableColumnController.astro';
import TableFilter from '@components/admin/TableFilter.astro';
import { requireAdminContext } from '@utils/auth';
import { listActiveTeamMembersLite } from '@utils/db';
import { getDictItems } from '@utils/dicts';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/users',
  { requiredMenu: 'users' }
);
if (redirectResponse) return redirectResponse;

const [teamMembers, customerTiers, customerTags] = await Promise.all([
  listActiveTeamMembersLite().catch(() => []),
  getDictItems(cfEnv, 'customer_tiers', true).catch(() => []),
  getDictItems(cfEnv, 'customer_tags', true).catch(() => []),
]);

const canBlock = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('users:block'));
const canEditTier = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('users:edit_tier'));
const canAssign = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('users:assign'));

const initialSearch = Astro.url.searchParams.get('search') || '';
const initialTier = Astro.url.searchParams.get('tier') || 'ALL';
const initialStatus = Astro.url.searchParams.get('status') || 'ALL';
const initialTimeWindow = Astro.url.searchParams.get('timeWindow') || 'ALL';
const initialAssignedTo = Astro.url.searchParams.get('assignedTo') || '';
const initialPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

const pageTitle = 'Customer & Access Management';
---

<AdminLayout
  title={pageTitle}
  currentTab="users"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- 1. Single-Line Command Bar (Fixed Header) -->
    <AdminPageToolbar
      title="Customers"
      badge="Access"
      badgeColor="purple"
      class="flex-nowrap px-3 py-2 sm:px-4 sm:py-2.5 gap-2"
    >
      <div slot="metrics" class="flex items-center gap-1.5 sm:gap-2 min-w-0 flex-1 overflow-x-auto no-scrollbar">
        <!-- Scope Segmented Tabs -->
        <div class="flex items-center gap-0.5 bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 shrink-0" id="user-scope-container">
          <button
            type="button"
            data-scope=""
            class={`scope-tab px-2.5 py-1 rounded-lg text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
              !initialAssignedTo ? 'bg-white text-[#1d1d1f] shadow-2xs border border-black/10' : 'text-[#52525b] hover:text-[#1d1d1f] border border-transparent'
            }`}
          >
            All Buyers
          </button>
          <button
            type="button"
            data-scope="MINE"
            class={`scope-tab px-2.5 py-1 rounded-lg text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
              initialAssignedTo === 'MINE' ? 'bg-white text-[#1d1d1f] shadow-2xs border border-black/10' : 'text-[#52525b] hover:text-[#1d1d1f] border border-transparent'
            }`}
          >
            My Customers
          </button>
          <button
            type="button"
            data-scope="UNASSIGNED"
            class={`scope-tab px-2.5 py-1 rounded-lg text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
              initialAssignedTo === 'UNASSIGNED' ? 'bg-white text-[#1d1d1f] shadow-2xs border border-black/10' : 'text-[#52525b] hover:text-[#1d1d1f] border border-transparent'
            }`}
          >
            Public Pool
          </button>
        </div>

        <div class="h-4 w-px bg-black/10 hidden sm:block shrink-0"></div>

        <!-- Tier Tabs (Clickable Instant Filters) -->
        <div class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto pb-0.5 sm:pb-0 scrollbar-none" id="user-tabs-container">
          {[
            { key: 'ALL', label: 'All Buyers', isBlocked: false },
            { key: 'VIP', label: 'VIP', isBlocked: false },
            { key: 'PARTNER', label: 'Partners', isBlocked: false },
            { key: 'STANDARD', label: 'Standard', isBlocked: false },
            { key: 'BLOCKED', label: 'Blocked', isBlocked: true },
          ].map((tab) => {
            const isActive = (tab.isBlocked ? initialStatus === 'BLOCKED' : initialTier === tab.key);
            return (
              <button
                type="button"
                data-tab-type={tab.isBlocked ? 'blocked' : 'tier'}
                data-tab-key={tab.key}
                class={`user-tab px-2 xl:px-2.5 py-1 rounded-xl text-[11px] xl:text-xs font-medium whitespace-nowrap transition-all border shrink-0 flex items-center gap-1.5 cursor-pointer ${
                  isActive
                    ? 'bg-[#1d1d1f] text-white border-black shadow-xs font-semibold'
                    : 'bg-[#f5f5f7] text-[#52525b] border-black/5 hover:border-black/20 hover:text-black'
                }`}
              >
                <span>{tab.label}</span>
                <span data-tab-count={tab.key} class={`font-mono text-[10px] px-1.5 py-0.2 rounded-md ${isActive ? 'bg-white/20 text-white' : 'bg-black/5 text-[#1d1d1f]'}`}>
                  -
                </span>
              </button>
            );
          })}
        </div>

        <!-- Hidden container for JS selector compatibility -->
        <div class="hidden" id="users-metrics-container" aria-hidden="true">
          <span id="stat-total"></span>
          <span id="stat-vips"></span>
          <span id="stat-guest"></span>
          <span id="stat-blocked-card"><span id="stat-blocked"></span><span id="stat-blocked-label"></span></span>
        </div>
      </div>

      <div slot="actions" class="flex items-center gap-2 ml-auto shrink-0">
        <span class="hidden xl:inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-[#f5f5f7] border border-black/5 text-[11px] font-mono text-[#52525b]">
          Total: <strong id="total-users-count" class="text-[#1d1d1f] font-semibold">-</strong>
        </span>

        <!-- Quick Time Window Filter -->
        <TableFilter
          timeSelectId="users-timewindow-select"
          initialTimeWindow={initialTimeWindow}
        />

        <!-- Search Form -->
        <AdminSearchInput
          id="users-search-input"
          formId="users-search-form"
          clearBtnId="clear-users-search"
          initialValue={initialSearch}
          placeholder="Search email, company..."
          class="relative flex items-center w-36 md:w-40 lg:w-44 xl:w-56 2xl:w-64"
        />

        <!-- Export CSV Button -->
        <button
          id="btn-export-users-csv"
          type="button"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white border border-black/10 transition-all cursor-pointer shadow-2xs"
          title="Export current buyers list to CSV"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Export CSV</span>
        </button>

        <!-- Columns & Density Controller -->
        <TableColumnController
          controllerBtnId="users-columns-btn"
          controllerMenuId="users-columns-menu"
          columnsListId="users-columns-list"
          countBadgeId="users-columns-count"
          syncStatusId="users-columns-sync"
          resetBtnId="users-columns-reset"
          densityBtnId="users-density-btn"
          densityLabelId="users-density-label"
          showDensityToggle={true}
          class="hidden md:inline-flex"
        />
      </div>
    </AdminPageToolbar>

    <!-- 2. Independent Scrolling Users Container -->
    <AdminWorkbenchTableShell
      containerId="users-container"
      skeletonId="users-skeleton"
      contentId="users-content"
      contentHidden={true}
      paginationId="users-pagination-container"
      paginationHidden={true}
      summaryId="users-pagination-summary"
      prevId="users-pagination-prev"
      nextId="users-pagination-next"
      currentId="users-pagination-current"
    />
  </div>

  <!-- Slide-over Customer Detail Drawer -->
  <Fragment slot="modals">
    <div id="drawer-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden transition-opacity opacity-0"></div>
    <aside
      id="user-drawer"
      data-state="closed"
      class="fixed inset-x-0 bottom-0 sm:inset-y-0 sm:right-0 sm:left-auto z-50 w-full sm:w-[clamp(22rem,18rem+10vw,32rem)] max-h-[90vh] sm:max-h-screen rounded-t-3xl sm:rounded-none sm:rounded-l-2xl bg-white border-t sm:border-t-0 sm:border-l border-black/10 shadow-2xl flex flex-col user-physics-drawer"
      aria-label="Customer Profile Drawer"
    >
      <div class="pt-2.5 sm:hidden flex justify-center shrink-0">
        <div class="w-10 h-1 bg-black/15 rounded-full"></div>
      </div>

      <div class="px-5 py-3.5 sm:py-4 border-b border-black/5 flex items-center justify-between shrink-0">
        <div>
          <h3 class="text-sm font-semibold text-[#1d1d1f]">Customer Profile & Access</h3>
          <p class="text-[11px] text-[#86868b] mt-0.5">Tiering, internal remarks, and security flags</p>
        </div>
        <button id="close-drawer-btn" type="button" class="p-1 rounded-lg text-[#86868b] hover:text-black hover:bg-[#f5f5f7] transition-all text-base cursor-pointer">✕</button>
      </div>

      <form id="drawer-form" class="p-5 overflow-y-auto flex-1 space-y-5 text-xs text-[#1d1d1f]">
        <input type="hidden" id="drawer-user-id" />

        <!-- Identity Card -->
        <div class="p-3.5 rounded-2xl bg-[#f5f5f7] border border-black/5 space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-xs" id="drawer-user-name"></span>
            <span id="drawer-roles-badge" class="font-mono text-[10px] px-2 py-0.5 rounded bg-black/10 text-[#1d1d1f]"></span>
          </div>
          <p class="font-mono text-[11px] text-[#86868b]" id="drawer-user-email"></p>
          <p class="text-[11px] text-[#52525b]" id="drawer-user-company"></p>
        </div>

        <!-- Customer Tier Selection -->
        <div>
          <label class="block font-semibold mb-1.5 text-[11px] text-[#52525b]">Customer Tier (B2B Classification)</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            {customerTiers.map((t: any) => (
              <label class={`flex flex-col items-center justify-center p-2 rounded-xl border border-black/10 transition-all text-center ${canEditTier ? 'cursor-pointer hover:border-black/30 has-checked:border-black has-checked:bg-black/5' : 'opacity-60 cursor-not-allowed'}`}>
                <input type="radio" name="tier" value={t.item_key} class="sr-only" disabled={!canEditTier} />
                <span class="font-semibold text-xs text-[#1d1d1f]">{t.item_label}</span>
                <span class="text-[9px] text-[#86868b] truncate max-w-[80px]">{t.meta?.discount_label || t.item_key}</span>
              </label>
            ))}
          </div>
          {!canEditTier && <p class="text-[10px] text-[#86868b] mt-1">Requires users:edit_tier permission to change classification</p>}
        </div>

        <!-- Account Status (Risk & Block) -->
        <div>
          <label class="block font-semibold mb-1.5 text-[11px] text-[#52525b]">Account Status (Security Control)</label>
          <select
            id="drawer-status-select"
            name="status"
            disabled={!canBlock}
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-xs disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <option value="ACTIVE">ACTIVE (Normal Ordering & Inquiries)</option>
            <option value="BLOCKED">BLOCKED (Suspend Submission Privileges)</option>
          </select>
          {!canBlock && <p class="text-[10px] text-[#86868b] mt-1">Requires users:block permission to suspend accounts</p>}
        </div>

        <!-- Assigned Sales Rep -->
        <div>
          <label class="block font-semibold mb-1.5 text-[11px] text-[#52525b]">Assigned Sales Rep</label>
          <select
            id="drawer-assigned-select"
            name="assigned_to"
            disabled={!canAssign}
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-xs font-sans font-medium disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <option value="">-- Public Lead Pool (Unassigned) --</option>
            {teamMembers.map((m) => (
              <option value={m.email}>{m.name} ({m.email}) - {m.roleName}</option>
            ))}
          </select>
          {!canAssign && <p class="text-[10px] text-[#86868b] mt-1">Requires users:assign permission to transfer accounts</p>}
        </div>

        <!-- Internal Admin Notes -->
        <!-- Internal Admin Notes with Quick CRM Tags -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block font-semibold text-[11px] text-[#52525b]">Internal Admin Remarks (Private CRM)</label>
            <span class="text-[10px] text-[#86868b]">Click tag to append:</span>
          </div>
          {customerTags.length > 0 && (
            <div class="flex items-center gap-1.5 flex-wrap pb-2">
              {customerTags.map((t: any) => (
                <button
                  type="button"
                  class="btn-crm-tag px-2 py-0.5 rounded-lg text-[10px] font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all border border-black/5 cursor-pointer"
                  data-tag={`[#${t.item_label}]`}
                >
                  #{t.item_label}
                </button>
              ))}
            </div>
          )}
          <textarea
            id="drawer-notes-input"
            name="admin_notes"
            rows="3"
            placeholder="e.g. French Haute Couture buyer, prefers hand-beaded lace swatches, credit terms approved..."
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black resize-none text-xs placeholder:text-[#86868b]"
          ></textarea>
        </div>

        <!-- Recent Orders Timeline -->
        <div class="pt-2 border-t border-black/5 space-y-2">
          <div class="flex items-center justify-between">
            <label class="block font-semibold text-[11px] text-[#52525b]">Recent Orders (Latest 5)</label>
            <span id="drawer-orders-loading" class="text-[10px] text-[#86868b] hidden">Loading...</span>
          </div>
          <div id="drawer-recent-orders-list" class="space-y-2"></div>
          <a
            id="drawer-orders-link"
            href="#"
            class="inline-flex items-center justify-between w-full p-2.5 rounded-xl bg-[#f5f5f7] hover:bg-black/5 text-[#1d1d1f] font-medium transition-all text-xs"
          >
            <span>📦 View All Orders By This Customer</span>
            <span>→</span>
          </a>
        </div>

        <!-- Recent Login Activity Timeline -->
        <div class="pt-3 border-t border-black/5 space-y-2">
          <div class="flex items-center justify-between">
            <label class="block font-semibold text-[11px] text-[#52525b]">Login Security Footprint (Recent Sessions)</label>
            <span class="text-[10px] text-[#86868b]">{systemSettings?.login_retention_days || 90}-day Retention</span>
          </div>
          <div id="drawer-recent-logins-list" class="space-y-1.5 text-xs"></div>
        </div>

        <!-- Account Governance & Lifecycle Audit Timeline -->
        <div class="pt-3 border-t border-black/5 space-y-2">
          <div class="flex items-center justify-between">
            <label class="block font-semibold text-[11px] text-[#52525b]">Account Governance Timeline</label>
            <span id="drawer-audit-loading" class="text-[10px] text-[#86868b] hidden">Loading...</span>
          </div>
          <div id="drawer-audit-timeline-list" class="space-y-1.5 text-xs max-h-48 overflow-y-auto">
            <p class="text-[11px] text-[#86868b] italic">No audit records yet.</p>
          </div>
        </div>

        <!-- Error / Success Alert Bar -->
        <div id="drawer-feedback" class="hidden p-3 rounded-xl text-xs font-medium leading-relaxed"></div>
      </form>

      <div class="p-4 border-t border-black/5 flex items-center justify-end gap-2 bg-white shrink-0 pb-[max(1rem,env(safe-area-inset-bottom))]">
        <button
          type="button"
          id="cancel-drawer-btn"
          class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
        >
          Close
        </button>
        <button
          type="button"
          id="save-drawer-btn"
          class="h-9 px-5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all cursor-pointer"
        >
          Save Changes
        </button>
      </div>
    </aside>
  </Fragment>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';
  import {
    escapeHtml, formatAdminTime, createPaginationController,
    createWorkbenchFetcher, bindSearchAndRefresh, exportToCsv,
    $id, syncUrlParams, createSlideDrawer
  } from '@utils/adminWorkbench';
  import { useTableSettings, type ColumnConfig } from '@hooks/useTableSettings';

  let pageAbort: AbortController | null = null;

  function initUsersPage() {
    pageAbort?.abort();
    pageAbort = new AbortController();
    const { signal } = pageAbort;

    const DEFAULT_COLUMNS: ColumnConfig[] = [
    { id: 'profile', label: 'Customer Profile', defaultWidth: 240, minWidth: 160, visible: true, canHide: false },
    { id: 'company', label: 'Company & Location', defaultWidth: 180, minWidth: 120, visible: true, canHide: true },
    { id: 'assigned_to', label: 'Assigned Rep', defaultWidth: 140, minWidth: 100, visible: true, canHide: true },
    { id: 'tier_status', label: 'Tier & Status', defaultWidth: 150, minWidth: 120, visible: true, canHide: true },
    { id: 'orders', label: 'Orders & Inquiries', defaultWidth: 150, minWidth: 110, visible: true, canHide: true },
    { id: 'last_active', label: 'Last Active', defaultWidth: 160, minWidth: 120, visible: true, canHide: true },
    { id: 'action', label: 'Actions', defaultWidth: 120, minWidth: 100, visible: true, canHide: false, pinRight: true, align: 'right' },
  ];

  let currentUsersList: any[] = [];
  let currentSearch = '';
  let currentTier = 'ALL';
  let currentStatus = 'ALL';
  let currentTimeWindow = 'ALL';
  let currentAssignedTo = '';
  let currentPage = 1;
  let currentLimit = 30;
  let currentTotalPages = 1;
  let activeAbortController: AbortController | null = null;

  const tableSettings = useTableSettings({
    tableKey: 'users',
    defaultColumns: DEFAULT_COLUMNS,
    defaultDensity: 'cozy',
    controllerBtnEl: document.getElementById('users-columns-btn'),
    controllerMenuEl: document.getElementById('users-columns-menu'),
    columnsListEl: document.getElementById('users-columns-list'),
    countBadgeEl: document.getElementById('users-columns-count'),
    syncStatusEl: document.getElementById('users-columns-sync'),
    resetBtnEl: document.getElementById('users-columns-reset'),
    densityBtnEl: document.getElementById('users-density-btn'),
    densityLabelEl: document.getElementById('users-density-label'),
    onSettingsChange: () => {
      if (currentUsersList && currentUsersList.length > 0) renderUsers(currentUsersList);
    },
    onDensityChange: () => {
      if (currentUsersList && currentUsersList.length > 0) renderUsers(currentUsersList);
    },
  });

  const pagination = createPaginationController({
    containerId: 'users-pagination-container',
    summaryId: 'users-pagination-summary',
    prevId: 'users-pagination-prev',
    nextId: 'users-pagination-next',
    currentId: 'users-pagination-current',
    itemLabel: 'customers',
    onPageChange: (newPage) => {
      currentPage = newPage;
      loadUsers();
    },
  });

  function renderTierBadge(tier) {
    if (tier === 'VIP') {
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">VIP</span>`;
    }
    if (tier === 'PARTNER') {
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-50 text-purple-800 border border-purple-200">Partner</span>`;
    }
    return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#f5f5f7] text-[#52525b] border border-black/5">Standard</span>`;
  }

  function updateActiveVisuals() {
    // 1. Update blocked card state
    const blockedCard = document.getElementById('stat-blocked-card');
    const blockedLabel = document.getElementById('stat-blocked-label');
    if (blockedCard) {
      if (currentStatus === 'BLOCKED') {
        blockedCard.className = 'p-2 sm:p-4 rounded-xl sm:rounded-2xl border shadow-2xs transition-all block bg-rose-50 border-rose-300 ring-2 ring-rose-500/20 cursor-pointer';
        if (blockedLabel) blockedLabel.textContent = '✕';
      } else {
        blockedCard.className = 'p-2 sm:p-4 rounded-xl sm:rounded-2xl border shadow-2xs transition-all block bg-white border-black/5 hover:border-rose-200 cursor-pointer';
        if (blockedLabel) blockedLabel.textContent = 'Filter';
      }
    }

    // 2. Update tabs
    document.querySelectorAll('#user-tabs-container .user-tab').forEach((tab) => {
      const isBlockedTab = tab.getAttribute('data-tab-type') === 'blocked';
      const key = tab.getAttribute('data-tab-key');
      const countEl = tab.querySelector('[data-tab-count]');

      let isActive = false;
      if (isBlockedTab) {
        isActive = currentStatus === 'BLOCKED';
      } else {
        isActive = currentStatus !== 'BLOCKED' && currentTier === key;
      }

      if (isActive) {
        if (isBlockedTab) {
          tab.className = 'user-tab px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border flex items-center gap-1.5 bg-rose-700 text-white border-rose-800 shadow-2xs cursor-pointer';
          if (countEl) countEl.className = 'font-mono text-[10px] px-1.5 py-0.2 rounded-md bg-white/20 text-white';
        } else {
          tab.className = 'user-tab px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border flex items-center gap-1.5 bg-[#1d1d1f] text-white border-black shadow-2xs cursor-pointer';
          if (countEl) countEl.className = 'font-mono text-[10px] px-1.5 py-0.2 rounded-md bg-white/20 text-white';
        }
      } else {
        tab.className = 'user-tab px-3.5 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition-all border flex items-center gap-1.5 bg-white text-[#52525b] border-black/5 hover:border-black/20 cursor-pointer';
        if (countEl) {
          countEl.className = `font-mono text-[10px] px-1.5 py-0.2 rounded-md ${isBlockedTab ? 'bg-rose-50 text-rose-700' : 'bg-[#f5f5f7] text-[#1d1d1f]'}`;
        }
      }
    });

    // 3. Update scope pills
    document.querySelectorAll('#user-scope-container .scope-tab').forEach((tab) => {
      const scopeVal = tab.getAttribute('data-scope') || '';
      const isSelected = scopeVal === currentAssignedTo;
      if (isSelected) {
        tab.className = 'scope-tab px-2.5 py-1 rounded-lg text-xs font-semibold whitespace-nowrap bg-white text-[#1d1d1f] shadow-2xs border border-black/10 cursor-pointer';
      } else {
        tab.className = 'scope-tab px-2.5 py-1 rounded-lg text-xs font-medium whitespace-nowrap text-[#52525b] hover:text-[#1d1d1f] border border-transparent cursor-pointer';
      }
    });
  }

  function renderStats(stats, total) {
    if (!stats) return;
    const totalEl = document.getElementById('total-users-count');
    const statTotal = document.getElementById('stat-total');
    const statVips = document.getElementById('stat-vips');
    const statGuest = document.getElementById('stat-guest');
    const statBlocked = document.getElementById('stat-blocked');

    if (totalEl) totalEl.textContent = String(total ?? stats.all ?? 0);
    if (statTotal) statTotal.textContent = String(stats.all ?? 0);
    if (statVips) statVips.textContent = String((stats.vip || 0) + (stats.partner || 0));
    if (statGuest) statGuest.textContent = String(stats.unclaimedGuestOrders || 0);
    if (statBlocked) statBlocked.textContent = String(stats.blocked || 0);

    const mapping = {
      ALL: stats.all ?? 0,
      VIP: stats.vip ?? 0,
      PARTNER: stats.partner ?? 0,
      STANDARD: stats.standard ?? 0,
      BLOCKED: stats.blocked ?? 0,
    };
    Object.entries(mapping).forEach(([key, val]) => {
      const tabCount = document.querySelector(`[data-tab-count="${key}"]`);
      if (tabCount) tabCount.textContent = String(val);
    });
  }

  function renderUsers(users) {
    currentUsersList = users || [];
    const container = document.getElementById('users-content');
    if (!container) return;

    if (!users || users.length === 0) {
      container.innerHTML = `
        <div class="py-16 px-4 text-center">
          <div class="w-12 h-12 rounded-2xl bg-[#f5f5f7] flex items-center justify-center mx-auto mb-3 text-[#86868b]">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[#1d1d1f]">No Customers Found</h3>
          <p class="text-xs text-[#86868b] mt-1 max-w-sm mx-auto">
            ${currentSearch ? `No customers match query "${escapeHtml(currentSearch)}".` : 'Customer profiles will appear here once buyers sign in.'}
          </p>
        </div>
      `;
      container.classList.remove('hidden');
      return;
    }

    // 1. Mobile view
    const mobileHtml = `
      <div class="md:hidden divide-y divide-black/5">
        ${users.map((u) => {
          const safeId = escapeHtml(u.id);
          const safeEmail = escapeHtml(u.email);
          const safeName = escapeHtml(u.name || 'Unnamed Buyer');
          const safeCompany = escapeHtml(u.company || u.country || 'Independent Buyer');
          const totalOrders = Number(u.total_orders || 0);
          const pendingOrders = Number(u.pending_orders || 0);
          const isBlocked = u.status === 'BLOCKED';

          return `
            <div class="p-4 space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center font-bold text-xs uppercase shrink-0">
                    ${escapeHtml((u.name || u.email || 'B')[0])}
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="font-semibold text-xs text-[#1d1d1f]">${safeName}</span>
                      ${u.is_admin ? '<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">Admin</span>' : ''}
                    </div>
                    <span class="text-[#86868b] font-mono text-[11px] block">${safeEmail}</span>
                  </div>
                </div>

                <div class="flex items-center gap-1">
                  ${u.assigned_to ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-blue-50 text-blue-800 border border-blue-200/60">${escapeHtml(u.assigned_to.split('@')[0])}</span>` : `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200/80">Pool</span>`}
                  ${renderTierBadge(u.tier)}
                  ${isBlocked ? `<span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">BLOCKED</span>` : ''}
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-[#86868b] pt-1">
                <span>${safeCompany}</span>
                <a href="/admin/orders?search=${encodeURIComponent(u.email)}" class="font-semibold text-[#1d1d1f] hover:underline">
                  ${totalOrders} Orders ${pendingOrders > 0 ? `(${pendingOrders} pending)` : ''} →
                </a>
              </div>

              <div class="pt-2 flex items-center justify-end">
                <button
                  type="button"
                  class="action-open-drawer-btn w-full py-1.5 rounded-xl text-xs font-semibold bg-[#f5f5f7] text-[#1d1d1f] border border-black/5 hover:bg-black hover:text-white transition-all cursor-pointer text-center"
                  data-id="${safeId}"
                  data-email="${safeEmail}"
                  data-name="${safeName}"
                  data-company="${escapeHtml(u.company || '')}"
                  data-tier="${escapeHtml(u.tier || 'STANDARD')}"
                  data-status="${escapeHtml(u.status || 'ACTIVE')}"
                  data-notes="${escapeHtml(u.admin_notes || '')}"
                  data-assigned="${escapeHtml(u.assigned_to || '')}"
                  data-roles="${escapeHtml(u.logto_roles || '[]')}"
                >
                  Edit Profile & Remarks
                </button>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;

    // 2. Desktop table view
    const visibleCols = tableSettings.getVisibleColumns();
    const isCompact = tableSettings.getDensity() === 'compact';
    const cellPad = isCompact ? 'py-1.5 px-3' : 'py-3.5 px-4';

    const desktopRowsHtml = users.map((u) => {
      const safeId = escapeHtml(u.id);
      const safeEmail = escapeHtml(u.email);
      const safeName = escapeHtml(u.name || 'Unnamed Buyer');
      const safeCompany = escapeHtml(u.company || '—');
      const safeLocation = escapeHtml(u.country || u.phone || 'Direct Buyer');
      const totalOrders = Number(u.total_orders || 0);
      const pendingOrders = Number(u.pending_orders || 0);
      const isBlocked = u.status === 'BLOCKED';
      const lastActiveStr = formatAdminTime(u.last_login_at, 'full', 'Never');

      const cells = visibleCols.map((col) => {
        switch (col.id) {
          case 'profile':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center font-bold text-xs uppercase shrink-0">
                    ${escapeHtml((u.name || u.email || 'B')[0])}
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="font-semibold text-[#1d1d1f] truncate">${safeName}</span>
                      ${u.is_admin ? '<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200 shrink-0">Admin</span>' : ''}
                    </div>
                    <span class="text-[#86868b] font-mono text-[11px] block truncate">${safeEmail}</span>
                  </div>
                </div>
              </td>
            `;
          case 'company':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <span class="font-medium text-[#1d1d1f] block truncate">${safeCompany}</span>
                <span class="text-[11px] text-[#86868b] block truncate">${safeLocation}</span>
              </td>
            `;
          case 'assigned_to':
            if (u.assigned_to) {
              const rep = escapeHtml(u.assigned_to.split('@')[0]);
              return `
                <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200/60" title="${escapeHtml(u.assigned_to)}">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    ${rep}
                  </span>
                </td>
              `;
            }
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200/80">
                  Pool
                </span>
              </td>
            `;
          case 'tier_status':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <div class="flex items-center gap-1.5 flex-wrap">
                  ${renderTierBadge(u.tier)}
                  ${isBlocked
                    ? `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">BLOCKED</span>`
                    : `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">ACTIVE</span>`}
                </div>
              </td>
            `;
          case 'orders':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <a href="/admin/orders?search=${encodeURIComponent(u.email)}" class="inline-flex items-center gap-1.5 font-medium hover:text-blue-600 transition-colors group" title="Filter orders for this buyer">
                  <span>${totalOrders} Orders</span>
                  ${pendingOrders > 0 ? `<span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">${pendingOrders} pending</span>` : ''}
                  <span class="text-[#86868b] group-hover:text-blue-600">→</span>
                </a>
              </td>
            `;
          case 'last_active':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-[#86868b] text-[11px]">
                <span class="block text-[#1d1d1f] truncate">${lastActiveStr}</span>
                ${u.last_login_ip ? `<span class="text-[10px] text-[#86868b] font-mono block truncate">${escapeHtml(u.last_login_ip)} ${u.last_login_country ? `(${escapeHtml(u.last_login_country)})` : ''}</span>` : ''}
              </td>
            `;
          case 'action':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-right">
                <button
                  type="button"
                  class="action-open-drawer-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#f5f5f7] hover:bg-[#1d1d1f] hover:text-white transition-all cursor-pointer border border-black/5"
                  data-id="${safeId}"
                  data-email="${safeEmail}"
                  data-name="${safeName}"
                  data-company="${escapeHtml(u.company || '')}"
                  data-tier="${escapeHtml(u.tier || 'STANDARD')}"
                  data-status="${escapeHtml(u.status || 'ACTIVE')}"
                  data-notes="${escapeHtml(u.admin_notes || '')}"
                  data-assigned="${escapeHtml(u.assigned_to || '')}"
                  data-roles="${escapeHtml(u.logto_roles || '[]')}"
                >
                  Edit & Notes
                </button>
              </td>
            `;
          default:
            return `<td></td>`;
        }
      }).join('');

      return `
        <tr class="hover:bg-[#f5f5f7]/40 transition-colors">${cells}</tr>
      `;
    }).join('');

    const desktopHtml = `
      <div class="hidden md:block">
        <table id="users-main-table" class="w-full text-left text-xs text-[#1d1d1f] border-collapse table-fixed select-text">
          <thead class="sticky top-0 z-10 bg-[#fbfbfd]/95 backdrop-blur-xs border-b border-black/10 shadow-2xs">
            <tr id="users-header-row"></tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            ${desktopRowsHtml}
          </tbody>
        </table>
      </div>
    `;

    container.innerHTML = mobileHtml + desktopHtml;
    container.classList.remove('hidden');

    const usersTable = document.getElementById('users-main-table');
    const usersHeaderRow = document.getElementById('users-header-row');
    if (usersTable && usersHeaderRow) {
      tableSettings.renderHeader(usersHeaderRow, usersTable);
    }
  }

  const usersFetcher = createWorkbenchFetcher({
    skeletonEl: $id('users-skeleton'),
    contentEl: $id('users-content'),
    onData: (data: any) => {
      renderStats(data.stats, data.total);
      renderUsers(data.users || []);
      pagination.render(data.page || 1, data.totalPages || 1, data.total || 0, data.limit || 30);
    },
  });

  function loadUsers(updateUrl = true) {
    $id('users-pagination-container')?.classList.add('hidden');
    updateActiveVisuals();
    if (updateUrl) {
      syncUrlParams({ tier: currentTier, status: currentStatus, search: currentSearch, timeWindow: currentTimeWindow, assignedTo: currentAssignedTo, page: currentPage }, { page: 1 });
    }
    const qs = new URLSearchParams({ page: String(currentPage), limit: String(currentLimit) });
    if (currentTier !== 'ALL') qs.set('tier', currentTier);
    if (currentStatus !== 'ALL') qs.set('status', currentStatus);
    if (currentSearch) qs.set('search', currentSearch);
    if (currentTimeWindow !== 'ALL') qs.set('timeWindow', currentTimeWindow);
    if (currentAssignedTo) qs.set('assignedTo', currentAssignedTo);
    const cacheKey = `admin:users:${currentTier}:${currentStatus}:${currentTimeWindow}:${currentAssignedTo}:${currentSearch}:${currentPage}:${currentLimit}`;
    usersFetcher.fetch(`/api/admin/users?${qs}`, cacheKey);
  }

  // Event Delegation for Drawer & Tabs
  const backdrop = document.getElementById('drawer-backdrop');
  const drawer = document.getElementById('user-drawer');
  const closeBtn = document.getElementById('close-drawer-btn');
  const cancelBtn = document.getElementById('cancel-drawer-btn');
  const saveBtn = document.getElementById('save-drawer-btn');
  const feedbackEl = document.getElementById('drawer-feedback');

  const userIdInput = document.getElementById('drawer-user-id');
  const nameLabel = document.getElementById('drawer-user-name');
  const emailLabel = document.getElementById('drawer-user-email');
  const companyLabel = document.getElementById('drawer-user-company');
  const rolesBadge = document.getElementById('drawer-roles-badge');
  const statusSelect = document.getElementById('drawer-status-select');
  const notesInput = document.getElementById('drawer-notes-input');
  const ordersLink = document.getElementById('drawer-orders-link');
  const ordersListEl = document.getElementById('drawer-recent-orders-list');
  const ordersLoadingEl = document.getElementById('drawer-orders-loading');
  const loginsListEl = document.getElementById('drawer-recent-logins-list');

  let currentDrawerController = null;

  async function loadRecentDetails(userId) {
    if (!ordersListEl) return;
    if (currentDrawerController) currentDrawerController.abort();
    currentDrawerController = new AbortController();

    ordersListEl.innerHTML = '';
    if (loginsListEl) loginsListEl.innerHTML = '';
    ordersLoadingEl?.classList.remove('hidden');

    try {
      const data: any = await clientCache.fetchWithCache(
        `admin:user:${userId}`,
        `/api/admin/users/${userId}`,
        {
          mode: 'ttl',
          ttlMs: 2 * 60 * 1000,
          init: { signal: currentDrawerController.signal },
        }
      );
      const recentOrders = data.recentOrders || [];
      const recentLogins = data.recentLogins || [];

      if (recentOrders.length === 0) {
        ordersListEl.innerHTML = `<div class="p-3 rounded-xl bg-[#f5f5f7] text-[#86868b] text-[11px] text-center">No orders found for this customer.</div>`;
      } else {
        ordersListEl.innerHTML = recentOrders.map((order) => {
          let badgeHtml = '';
          switch (order.status) {
            case 'PENDING_APPROVAL':
              badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-50 text-amber-800 border border-amber-200">Pending</span>';
              break;
            case 'APPROVED':
              badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-50 text-blue-800 border border-blue-200">Approved</span>';
              break;
            case 'SHIPPED':
              badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">Shipped</span>';
              break;
            case 'REJECTED':
              badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">Rejected</span>';
              break;
            default:
              badgeHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-100 text-zinc-700">${escapeHtml(order.status)}</span>`;
          }
          const date = order.created_at ? formatAdminTime(order.created_at, 'full').slice(0, 10) : '—';
          return `
            <a href="/admin/orders?search=${encodeURIComponent(order.order_no || '')}" class="block p-2.5 rounded-xl border border-black/5 hover:border-black/20 hover:bg-[#fbfbfd] transition-all bg-white">
              <div class="flex items-center justify-between mb-1">
                <span class="font-mono font-semibold text-[#1d1d1f]">${escapeHtml(order.order_no || '')}</span>
                ${badgeHtml}
              </div>
              <div class="flex items-center justify-between text-[11px] text-[#86868b]">
                <span>${Number(order.total_quantity) || 0} pcs (${Number(order.total_styles) || 0} styles)</span>
                <span class="font-mono">${escapeHtml(date)}</span>
              </div>
            </a>
          `;
        }).join('');
      }

      if (loginsListEl) {
        if (recentLogins.length === 0) {
          loginsListEl.innerHTML = `<div class="p-2.5 rounded-xl bg-[#f5f5f7] text-[#86868b] text-[11px] text-center">No login sessions recorded yet.</div>`;
        } else {
          loginsListEl.innerHTML = recentLogins.map((login) => {
            const loc = [login.city, login.country].filter(Boolean).join(', ') || 'Global';
            const date = login.created_at ? formatAdminTime(login.created_at, 'full') : '—';
            return `
              <div class="p-2 rounded-xl bg-[#f5f5f7] flex items-center justify-between">
                <div>
                  <span class="font-mono font-medium text-[#1d1d1f] text-[11px] block">${escapeHtml(login.ip || '—')}</span>
                  <span class="text-[10px] text-[#86868b]">📍 ${escapeHtml(loc)}</span>
                </div>
                <span class="font-mono text-[10px] text-[#86868b]">${escapeHtml(date)}</span>
              </div>
            `;
          }).join('');
        }
      }

      // Load customer audit timeline
      const auditTimelineEl = document.getElementById('drawer-audit-timeline-list');
      const auditLoadingEl = document.getElementById('drawer-audit-loading');
      if (auditTimelineEl) {
        auditLoadingEl?.classList.remove('hidden');
        try {
          const auditRes = await fetch(`/api/admin/audit?targetId=${encodeURIComponent(userId)}&limit=15`);
          const auditData = await auditRes.json();
          auditLoadingEl?.classList.add('hidden');
          if (auditRes.ok && auditData.logs && auditData.logs.length > 0) {
            auditTimelineEl.innerHTML = auditData.logs.map((log) => {
              const date = log.created_at ? formatAdminTime(log.created_at, 'full') : '—';
              let diffText = '';
              try {
                const diff = log.diff_json ? JSON.parse(log.diff_json) : null;
                if (diff) {
                  diffText = Object.keys(diff).map((k) => `${k}: ${JSON.stringify(diff[k].from)} → ${JSON.stringify(diff[k].to)}`).join(', ');
                }
              } catch {}
              return `
                <div class="p-2 rounded-xl bg-[#fafafa] border border-black/5 space-y-0.5">
                  <div class="flex items-center justify-between text-[10px]">
                    <span class="font-bold text-[#1d1d1f]">${escapeHtml(log.action)}</span>
                    <span class="font-mono text-[#86868b]">${escapeHtml(date)}</span>
                  </div>
                  <div class="text-[10px] text-[#52525b] truncate">By: ${escapeHtml(log.admin_email)}</div>
                  ${diffText ? `<div class="text-[9px] font-mono text-emerald-800">${escapeHtml(diffText)}</div>` : ''}
                </div>
              `;
            }).join('');
          } else {
            auditTimelineEl.innerHTML = `<p class="text-[11px] text-[#86868b] italic">No administrative changes recorded for this buyer.</p>`;
          }
        } catch {
          auditLoadingEl?.classList.add('hidden');
          auditTimelineEl.innerHTML = `<p class="text-[11px] text-rose-600">Failed to load timeline.</p>`;
        }
      }
    } catch (err) {
      if (err.name !== 'AbortError') {
        if (ordersListEl) ordersListEl.innerHTML = `<div class="p-3 text-center text-xs text-rose-600">Failed to load details.</div>`;
      }
    } finally {
      ordersLoadingEl?.classList.add('hidden');
    }
  }

  const userDrawer = createSlideDrawer({
    drawerId: 'user-drawer',
    backdropId: 'drawer-backdrop',
    closeIds: ['close-drawer-btn', 'cancel-drawer-btn'],
    useDataState: true,
    lockBody: false,
    onClose: () => {
      if (feedbackEl) {
        feedbackEl.className = 'hidden';
        feedbackEl.textContent = '';
      }
    },
  });
  const showDrawer = userDrawer.open;
  const hideDrawer = userDrawer.close;

  document.getElementById('users-container')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.action-open-drawer-btn');
    if (!btn) return;

    const id = btn.getAttribute('data-id') || '';
    const email = btn.getAttribute('data-email') || '';
    const name = btn.getAttribute('data-name') || 'Unnamed Buyer';
    const company = btn.getAttribute('data-company') || '';
    const tier = btn.getAttribute('data-tier') || 'STANDARD';
    const status = btn.getAttribute('data-status') || 'ACTIVE';
    const notes = btn.getAttribute('data-notes') || '';
    const assigned = btn.getAttribute('data-assigned') || '';
    const rolesRaw = btn.getAttribute('data-roles') || '[]';

    if (userIdInput) userIdInput.value = id;
    if (nameLabel) nameLabel.textContent = name;
    if (emailLabel) emailLabel.textContent = email;
    if (companyLabel) companyLabel.textContent = company || 'No company specified';

    const assignedSelect = document.getElementById('drawer-assigned-select') as HTMLSelectElement | null;
    if (assignedSelect) assignedSelect.value = assigned;

    let rolesText = 'Logto: Buyer';
    try {
      const roles = JSON.parse(rolesRaw);
      if (roles.length > 0) rolesText = `Logto: ${roles.join(', ')}`;
    } catch {}
    if (rolesBadge) rolesBadge.textContent = rolesText;

    const tierRadio = document.querySelector(`input[name="tier"][value="${tier}"]`);
    if (tierRadio) tierRadio.checked = true;

    if (statusSelect) statusSelect.value = status;
    if (notesInput) notesInput.value = notes;
    if (ordersLink) ordersLink.href = `/admin/orders?search=${encodeURIComponent(email)}`;

    loadRecentDetails(id);
    showDrawer();
  });

  saveBtn?.addEventListener('click', async () => {
    const id = userIdInput?.value;
    if (!id) return;

    const tierInput = document.querySelector('input[name="tier"]:checked');
    const tier = tierInput?.value || 'STANDARD';
    const status = statusSelect?.value || 'ACTIVE';
    const adminNotes = notesInput?.value || '';
    const assignedSelect = document.getElementById('drawer-assigned-select') as HTMLSelectElement | null;
    const assignedTo = assignedSelect ? (assignedSelect.value.trim() || null) : undefined;

    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }

    try {
      const res = await fetch(`/api/admin/users/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier, status, adminNotes, assignedTo }),
      });

      const data = await res.json();
      if (res.ok) {
        await clientCache.del(`admin:user:${id}`);
        await clientCache.invalidatePrefix('admin:users:');
        (window as any).__showToast?.('Customer tier & status updated', 'success');
        hideDrawer();
        loadUsers(false);
      } else {
        if (feedbackEl) {
          feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
          feedbackEl.textContent = data.error || 'Failed to save changes';
        }
      }
    } catch (err) {
      if (feedbackEl) {
        feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
        feedbackEl.textContent = err.message || 'Network error';
      }
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    }
  });

  // Tab clicks
  document.getElementById('user-tabs-container')?.addEventListener('click', (e) => {
    const tab = e.target.closest('.user-tab');
    if (!tab) return;
    const isBlocked = tab.getAttribute('data-tab-type') === 'blocked';
    const key = tab.getAttribute('data-tab-key') || 'ALL';

    if (isBlocked) {
      currentStatus = 'BLOCKED';
      currentTier = 'ALL';
    } else {
      currentStatus = 'ALL';
      currentTier = key;
    }
    currentPage = 1;
    loadUsers();
  });

  // Blocked metric card click
  document.getElementById('stat-blocked-card')?.addEventListener('click', () => {
    if (currentStatus === 'BLOCKED') {
      currentStatus = 'ALL';
      currentTier = 'ALL';
    } else {
      currentStatus = 'BLOCKED';
      currentTier = 'ALL';
    }
    currentPage = 1;
    loadUsers();
  });

  // Search submission and clear
  const searchInput = $id<HTMLInputElement>('users-search-input');
  const clearBtn = $id('clear-users-search');
  bindSearchAndRefresh({
    searchInputId: 'users-search-input',
    clearBtnId: 'clear-users-search',
    formId: 'users-search-form',
    onSearch: (val) => { currentSearch = val; currentPage = 1; loadUsers(); },
    onRefresh: () => loadUsers(false),
  });

  // Scope filter clicks
  document.getElementById('user-scope-container')?.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest('.scope-tab');
    if (!tab) return;
    const scopeVal = tab.getAttribute('data-scope') || '';
    if (scopeVal === currentAssignedTo && currentPage === 1) return;
    currentAssignedTo = scopeVal;
    currentPage = 1;
    loadUsers();
  });

  // Browser back/forward navigation
  window.addEventListener('popstate', () => {
    const url = new URL(window.location.href);
    currentTier = url.searchParams.get('tier') || 'ALL';
    currentStatus = url.searchParams.get('status') || 'ALL';
    currentSearch = url.searchParams.get('search') || '';
    currentTimeWindow = url.searchParams.get('timeWindow') || 'ALL';
    currentAssignedTo = url.searchParams.get('assignedTo') || '';
    currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));

    if (searchInput) searchInput.value = currentSearch;
    const timeSelect = document.getElementById('users-timewindow-select') as HTMLSelectElement | null;
    if (timeSelect) timeSelect.value = currentTimeWindow;

    if (clearBtn) {
      if (currentSearch) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
    loadUsers(false);
  }, { signal });

  // Initial load
  tableSettings.renderMenu();
  const initialUrl = new URL(window.location.href);
  currentTier = initialUrl.searchParams.get('tier') || 'ALL';
  currentStatus = initialUrl.searchParams.get('status') || 'ALL';
  currentSearch = initialUrl.searchParams.get('search') || '';
  currentTimeWindow = initialUrl.searchParams.get('timeWindow') || 'ALL';
  currentAssignedTo = initialUrl.searchParams.get('assignedTo') || '';
  currentPage = Math.max(1, parseInt(initialUrl.searchParams.get('page') || '1', 10));

  const timeSelect = document.getElementById('users-timewindow-select') as HTMLSelectElement | null;
  if (timeSelect) {
    timeSelect.value = currentTimeWindow;
    timeSelect.addEventListener('change', () => {
      currentTimeWindow = timeSelect.value || 'ALL';
      currentPage = 1;
      loadUsers();
    });
  }

  // CRM Tag Quick Append Listener
  document.querySelectorAll('.btn-crm-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      if (!notesInput || !tag) return;
      const current = notesInput.value.trim();
      if (!current.includes(tag)) {
        notesInput.value = current ? `${current} ${tag}` : tag;
      }
    });
  });

  // Export Buyers CSV Listener
  $id('btn-export-users-csv')?.addEventListener('click', () => {
    if (!currentUsersList?.length) {
      (window as any).__showToast?.('No buyer records to export', 'error');
      return;
    }
    exportToCsv(
      `buyers_report_${new Date().toISOString().slice(0, 10)}.csv`,
      ['ID', 'Email', 'Name', 'Company', 'Tier', 'Status', 'Assigned Rep', 'Total Orders', 'CRM Notes', 'Created At'],
      currentUsersList.map((u) => [u.id, u.email, u.name || '', u.company_name || '', u.tier || 'STANDARD', u.status || 'ACTIVE', u.assigned_to || '', u.total_orders || 0, (u.admin_notes || '').replace(/[\n\r]+/g, ' '), u.created_at || ''])
    );
    (window as any).__showToast?.(`Exported ${currentUsersList.length} buyers to CSV`, 'success');
  });

    loadUsers(false);
  }

  initUsersPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('user-scope-container')) {
      initUsersPage();
    } else {
      pageAbort?.abort();
      pageAbort = null;
    }
  });
</script>

<style>
  .user-physics-drawer {
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    transform: translateY(100%);
  }
  @media (min-width: 640px) {
    .user-physics-drawer {
      transform: translateX(100%);
    }
  }
  .user-physics-drawer[data-state="open"] {
    transform: translate(0, 0) !important;
  }
</style>
