---
// src/pages/admin/logs.astro
// Unified System Diagnostics & Performance Profiling Workbench (App Shell + JSON Client Render)
import AdminLayout from '@layouts/AdminLayout.astro';
import { requireAdminContext } from '@utils/auth';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/logs',
  { skipPendingCount: true }
);
if (redirectResponse) return redirectResponse;

const initialLevel = Astro.url.searchParams.get('level') || 'ALL';
const initialSearch = (Astro.url.searchParams.get('search') || '').trim();
const initialSort = Astro.url.searchParams.get('sort') || 'newest';
const initialPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

const pageTitle = 'System Diagnostics & Logs';
---

<AdminLayout
  title={pageTitle}
  currentTab="logs"
  sessionEmail={sessionUser.email}
  pendingOrdersCount={pendingOrdersCount}
>
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-5 border-b border-black/5 gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1d1d1f]">System Diagnostics</h1>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Cloudflare D1 & Observability
        </span>
      </div>
      <p class="text-xs text-[#86868b] mt-0.5">
        Real-time edge execution logs, sub-step latency breakdown, slow query profiling, and business exception audit trail.
      </p>
    </div>

    <!-- Actions (Refresh & Clear Logs) -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <button
        id="refresh-logs-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-black/10 text-[#1d1d1f] hover:bg-[#f5f5f7] shadow-2xs active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Refresh</span>
      </button>

      <button
        id="clear-logs-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 shadow-2xs active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Clear Logs</span>
      </button>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 mb-5">
    <div class="p-3.5 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-1">
      <span class="text-[11px] font-medium text-[#86868b] uppercase tracking-wider block">Total Events</span>
      <span id="metric-total" class="text-xl sm:text-2xl font-bold font-mono text-[#1d1d1f]">-</span>
    </div>

    <div class="p-3.5 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-1">
      <span class="text-[11px] font-medium text-rose-600 uppercase tracking-wider block">Errors</span>
      <span id="metric-errors" class="text-xl sm:text-2xl font-bold font-mono text-rose-600">-</span>
    </div>

    <div class="p-3.5 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-1">
      <span class="text-[11px] font-medium text-amber-600 uppercase tracking-wider block">Warnings & Slow</span>
      <span id="metric-warns" class="text-xl sm:text-2xl font-bold font-mono text-amber-600">-</span>
    </div>

    <div class="p-3.5 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-1">
      <span class="text-[11px] font-medium text-blue-600 uppercase tracking-wider block">Info & Profiling</span>
      <span id="metric-info" class="text-xl sm:text-2xl font-bold font-mono text-blue-600">-</span>
    </div>

    <div class="p-3.5 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-1">
      <span class="text-[11px] font-medium text-purple-600 uppercase tracking-wider block">Critical</span>
      <span id="metric-critical" class="text-xl sm:text-2xl font-bold font-mono text-purple-600">-</span>
    </div>
  </div>

  <!-- Top Endpoint Bottlenecks Performance Board -->
  <div id="bottlenecks-card" class="hidden mb-5 p-4 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-3">
    <div class="flex items-center justify-between pb-2 border-b border-black/5">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-[#1d1d1f] tracking-tight">Endpoint Bottleneck Ranking</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full font-mono bg-amber-50 text-amber-800 border border-amber-200 font-semibold">
          Latency Profiling
        </span>
      </div>
      <span class="text-[11px] text-[#86868b]">Click any row to filter audit trail</span>
    </div>
    <div id="bottlenecks-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <!-- Populated via JavaScript -->
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="sticky top-14 lg:top-0 z-20 py-2.5 -my-2.5 bg-[#f5f5f7]/95 backdrop-blur-xs flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs mb-4">
    <!-- Level Tabs -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-none" id="level-tabs">
      {[
        { key: 'ALL', label: 'All Levels' },
        { key: 'DEBUG', label: 'Debug' },
        { key: 'INFO', label: 'Info' },
        { key: 'WARN', label: 'Warnings' },
        { key: 'ERROR', label: 'Errors' },
        { key: 'CRITICAL', label: 'Critical' },
      ].map((tab) => {
        const isActive = initialLevel === tab.key;
        return (
          <button
            type="button"
            data-level={tab.key}
            class={`level-tab-btn px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border cursor-pointer ${
              isActive
                ? 'bg-[#1d1d1f] text-white border-black shadow-xs font-semibold'
                : 'bg-white text-[#52525b] border-black/5 hover:border-black/20 hover:text-black'
            }`}
          >
            <span>{tab.label}</span>
          </button>
        );
      })}
    </div>

    <!-- Controls (Sort & Search) -->
    <div class="flex items-center gap-2 self-stretch md:self-auto">
      <!-- Sort Toggle -->
      <select
        id="logs-sort-select"
        class="h-8 px-2.5 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs font-medium text-[#1d1d1f] cursor-pointer"
      >
        <option value="newest" selected={initialSort === 'newest'}>⏱️ Newest First</option>
        <option value="slowest" selected={initialSort === 'slowest'}>🐢 Slowest Latency</option>
      </select>

      <!-- Search Input -->
      <div class="relative flex-1 md:w-64">
        <input
          type="text"
          id="logs-search-input"
          value={initialSearch}
          placeholder="Filter message, rayId, path, IP, country, email..."
          class="w-full h-8 pl-8 pr-7 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs text-[#1d1d1f]"
        />
        <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="button"
          id="clear-search-btn"
          class={`absolute right-2.5 top-2 text-xs text-[#86868b] hover:text-black cursor-pointer ${initialSearch ? '' : 'hidden'}`}
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <!-- Skeletons (0-CLS Shimmer) -->
  <div id="logs-skeleton" class="rounded-2xl bg-white border border-black/5 p-4 shadow-2xs space-y-3">
    {[1, 2, 3, 4, 5].map(() => (
      <div class="flex items-center justify-between py-2 border-b border-black/5 last:border-0 animate-pulse">
        <div class="flex items-center gap-3">
          <div class="h-6 w-16 bg-black/10 rounded-md"></div>
          <div class="space-y-1">
            <div class="h-4 w-48 bg-black/10 rounded-md"></div>
            <div class="h-3 w-32 bg-black/5 rounded-md"></div>
          </div>
        </div>
        <div class="h-4 w-24 bg-black/5 rounded-md"></div>
      </div>
    ))}
  </div>

  <!-- Main Log List Container -->
  <div id="logs-content" class="hidden rounded-2xl bg-white border border-black/5 shadow-2xs overflow-hidden">
    <!-- Populated by JavaScript -->
  </div>

  <!-- Pagination Container -->
  <div id="pagination-container" class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3 px-1 text-xs text-[#86868b] hidden">
    <div id="pagination-summary"></div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="pagination-prev"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border text-xs font-medium transition-all border-black/10 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] cursor-pointer disabled:border-transparent disabled:text-[#86868b]/40 disabled:pointer-events-none"
      >
        ← Previous
      </button>
      <span id="pagination-current" class="px-2 py-1 text-xs font-mono text-[#1d1d1f]">
        1 / 1
      </span>
      <button
        type="button"
        id="pagination-next"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border text-xs font-medium transition-all border-black/10 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] cursor-pointer disabled:border-transparent disabled:text-[#86868b]/40 disabled:pointer-events-none"
      >
        Next →
      </button>
    </div>
  </div>

  <!-- Empty State -->
  <div id="logs-empty" class="hidden rounded-2xl bg-white border border-black/5 p-12 text-center shadow-2xs">
    <div class="w-12 h-12 rounded-2xl bg-[#f5f5f7] flex items-center justify-center mx-auto mb-3 text-emerald-600">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-[#1d1d1f]">All Systems Nominal</h3>
    <p class="text-xs text-[#86868b] mt-1 max-w-sm mx-auto">
      No diagnostic errors or warnings found matching the active filter.
    </p>
  </div>

  <!-- Detail Dialog / Modal -->
  <dialog id="log-detail-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-5 rounded-3xl w-[calc(100vw-32px)] max-w-2xl mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
    <div class="space-y-4 text-xs text-[#1d1d1f]">
      <div class="flex items-center justify-between pb-2 border-b border-black/5">
        <div class="flex items-center gap-2">
          <span id="modal-level-badge"></span>
          <span id="modal-source" class="font-mono font-semibold text-xs text-[#1d1d1f]"></span>
        </div>
        <button id="close-modal-btn" type="button" class="text-base text-[#86868b] hover:text-black cursor-pointer">✕</button>
      </div>

      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold text-[#86868b] tracking-wider">Message</span>
        <p id="modal-message" class="text-xs font-semibold text-[#1d1d1f]"></p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-2 border-y border-black/5 text-[11px]">
        <div>
          <span class="text-[#86868b] block">Time</span>
          <strong id="modal-time" class="font-mono text-[#1d1d1f]"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">CF Ray ID</span>
          <strong id="modal-ray" class="font-mono text-[#1d1d1f] break-all"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">Request Path</span>
          <strong id="modal-path" class="font-mono text-[#1d1d1f] break-all"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">Method & Status</span>
          <strong id="modal-http" class="font-mono text-[#1d1d1f]"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">Total Latency</span>
          <strong id="modal-latency" class="font-mono text-[#1d1d1f]"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">User / Email</span>
          <strong id="modal-user" class="font-mono text-[#1d1d1f]"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">Client IP</span>
          <strong id="modal-ip" class="font-mono text-[#1d1d1f]"></strong>
        </div>
        <div>
          <span class="text-[#86868b] block">Country & City</span>
          <strong id="modal-geo" class="font-mono text-[#1d1d1f]"></strong>
        </div>
      </div>

      <!-- Sub-step Spans Breakdown Container -->
      <div id="modal-spans-container" class="hidden space-y-1.5 p-3 rounded-xl bg-[#f5f5f7] border border-black/5">
        <span class="text-[10px] uppercase font-bold text-[#86868b] tracking-wider block">Sub-step Timing Profiler</span>
        <div id="modal-spans-list" class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs font-mono"></div>
      </div>

      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold text-[#86868b] tracking-wider">Context & Stack Trace</span>
        <pre id="modal-context" class="p-3 rounded-xl bg-[#1d1d1f] text-emerald-400 font-mono text-[11px] overflow-x-auto max-h-64 whitespace-pre-wrap select-all"></pre>
      </div>

      <div class="pt-2 flex justify-end">
        <button
          type="button"
          id="close-modal-bottom-btn"
          class="h-9 px-4 rounded-xl text-xs font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </dialog>

  <!-- Clear Confirmation Dialog -->
  <dialog id="clear-confirm-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-6 rounded-3xl w-[calc(100vw-32px)] max-w-sm mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
    <div class="space-y-4 text-center">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-bold text-[#1d1d1f]">Clear Diagnostic Logs?</h3>
        <p class="text-xs text-[#86868b] mt-1">This will permanently delete all logged errors and warnings from D1. This action cannot be undone.</p>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="button"
          id="cancel-clear-btn"
          class="flex-1 py-2 rounded-xl text-xs font-medium bg-[#f5f5f7] hover:bg-black/5 text-[#1d1d1f] transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-clear-btn"
          class="flex-1 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-all cursor-pointer shadow-xs"
        >
          Delete All
        </button>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';

  (function () {
    let logsList: any[] = [];
    const urlParams = new URLSearchParams(window.location.search);
    let currentLevel = urlParams.get('level') || 'ALL';
    let currentSearch = (urlParams.get('search') || '').trim();
    let currentSort = urlParams.get('sort') || 'newest';
    let currentPage = Math.max(1, parseInt(urlParams.get('page') || '1', 10));
    let currentTotalPages = 1;
    const limit = 50;

    const skeletonEl = document.getElementById('logs-skeleton');
    const contentEl = document.getElementById('logs-content');
    const emptyEl = document.getElementById('logs-empty');
    const searchInput = document.getElementById('logs-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const sortSelect = document.getElementById('logs-sort-select') as HTMLSelectElement | null;
    const refreshBtn = document.getElementById('refresh-logs-btn');
    const clearLogsBtn = document.getElementById('clear-logs-btn');

    const bottlenecksCard = document.getElementById('bottlenecks-card');
    const bottlenecksList = document.getElementById('bottlenecks-list');

    const paginationContainer = document.getElementById('pagination-container');
    const paginationSummary = document.getElementById('pagination-summary');
    const paginationPrev = document.getElementById('pagination-prev') as HTMLButtonElement | null;
    const paginationNext = document.getElementById('pagination-next') as HTMLButtonElement | null;
    const paginationCurrent = document.getElementById('pagination-current');

    const metricTotal = document.getElementById('metric-total');
    const metricErrors = document.getElementById('metric-errors');
    const metricWarns = document.getElementById('metric-warns');
    const metricInfo = document.getElementById('metric-info');
    const metricCritical = document.getElementById('metric-critical');

    const detailModal = document.getElementById('log-detail-modal') as HTMLDialogElement | null;
    const modalLevelBadge = document.getElementById('modal-level-badge');
    const modalSource = document.getElementById('modal-source');
    const modalMessage = document.getElementById('modal-message');
    const modalTime = document.getElementById('modal-time');
    const modalRay = document.getElementById('modal-ray');
    const modalPath = document.getElementById('modal-path');
    const modalHttp = document.getElementById('modal-http');
    const modalLatency = document.getElementById('modal-latency');
    const modalUser = document.getElementById('modal-user');
    const modalIp = document.getElementById('modal-ip');
    const modalGeo = document.getElementById('modal-geo');
    const modalSpansContainer = document.getElementById('modal-spans-container');
    const modalSpansList = document.getElementById('modal-spans-list');
    const modalContext = document.getElementById('modal-context');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const closeModalBottomBtn = document.getElementById('close-modal-bottom-btn');

    const clearConfirmModal = document.getElementById('clear-confirm-modal') as HTMLDialogElement | null;
    const cancelClearBtn = document.getElementById('cancel-clear-btn');
    const confirmClearBtn = document.getElementById('confirm-clear-btn');

    function syncUrl(push = true) {
      const url = new URL(window.location.href);
      if (currentLevel && currentLevel !== 'ALL') url.searchParams.set('level', currentLevel);
      else url.searchParams.delete('level');

      if (currentSearch) url.searchParams.set('search', currentSearch);
      else url.searchParams.delete('search');

      if (currentSort && currentSort !== 'newest') url.searchParams.set('sort', currentSort);
      else url.searchParams.delete('sort');

      if (currentPage > 1) url.searchParams.set('page', String(currentPage));
      else url.searchParams.delete('page');

      if (url.toString() !== window.location.href) {
        if (push) {
          window.history.pushState({ level: currentLevel, search: currentSearch, sort: currentSort, page: currentPage }, '', url.toString());
        } else {
          window.history.replaceState({ level: currentLevel, search: currentSearch, sort: currentSort, page: currentPage }, '', url.toString());
        }
      }
    }

    function updateTabsUi() {
      document.querySelectorAll('.level-tab-btn').forEach((b) => {
        const isActive = b.getAttribute('data-level') === currentLevel;
        if (isActive) {
          b.className = 'level-tab-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all border cursor-pointer bg-[#1d1d1f] text-white border-black shadow-xs';
        } else {
          b.className = 'level-tab-btn px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border cursor-pointer bg-white text-[#52525b] border-black/5 hover:border-black/20 hover:text-black';
        }
      });
    }

    function escapeHtml(str: any) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatTime(dt: any) {
      if (!dt) return '—';
      let str = String(dt);
      if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(str)) {
        str = str.replace(' ', 'T') + 'Z';
      }
      const d = new Date(str);
      if (isNaN(d.getTime())) return String(dt);
      return d.toLocaleString(undefined, {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      });
    }

    function renderLevelBadge(lvl: string) {
      const level = (lvl || 'error').toUpperCase();
      if (level === 'CRITICAL') {
        return '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-100 text-purple-900 border border-purple-200">CRITICAL</span>';
      }
      if (level === 'ERROR') {
        return '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">ERROR</span>';
      }
      if (level === 'WARN') {
        return '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">WARN</span>';
      }
      if (level === 'INFO') {
        return '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">INFO</span>';
      }
      return '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-zinc-100 text-zinc-600 border border-zinc-200">DEBUG</span>';
    }

    function renderLatencyBadge(ms: number | null | undefined) {
      if (ms === null || ms === undefined || isNaN(ms)) return '';
      if (ms < 100) {
        return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">${ms}ms</span>`;
      }
      if (ms < 500) {
        return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">${ms}ms</span>`;
      }
      if (ms < 1000) {
        return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-50 text-amber-800 border border-amber-200">${ms}ms</span>`;
      }
      return `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">${ms}ms</span>`;
    }

    function renderMethodBadge(method: string | null | undefined) {
      if (!method) return '';
      const m = method.toUpperCase();
      let colorClass = 'bg-zinc-100 text-zinc-700 border-zinc-200';
      if (m === 'GET') colorClass = 'bg-sky-50 text-sky-700 border-sky-200';
      else if (m === 'POST') colorClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
      else if (m === 'PATCH' || m === 'PUT') colorClass = 'bg-amber-50 text-amber-700 border-amber-200';
      else if (m === 'DELETE') colorClass = 'bg-rose-50 text-rose-700 border-rose-200';
      else if (m === 'CLIENT') colorClass = 'bg-purple-50 text-purple-700 border-purple-200';

      return `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold uppercase border ${colorClass}">${escapeHtml(m)}</span>`;
    }

    function renderBottlenecks(bottlenecks: any[]) {
      if (!bottlenecksCard || !bottlenecksList) return;
      if (!bottlenecks || bottlenecks.length === 0) {
        bottlenecksCard.classList.add('hidden');
        return;
      }

      bottlenecksCard.classList.remove('hidden');
      bottlenecksList.innerHTML = bottlenecks.map((item, idx) => {
        const safePath = escapeHtml(item.path);
        const avg = item.avg_latency || 0;
        const max = item.max_latency || 0;
        const calls = item.call_count || 0;
        return `
          <button
            type="button"
            class="bottleneck-item p-2.5 rounded-xl bg-[#f5f5f7]/80 hover:bg-[#1d1d1f] hover:text-white transition-all text-left border border-black/5 cursor-pointer group"
            data-path="${safePath}"
          >
            <div class="flex items-center justify-between gap-1 mb-1">
              <div class="flex items-center gap-1.5 truncate">
                <span class="text-[10px] font-mono text-[#86868b] group-hover:text-white/60">#${idx + 1}</span>
                ${renderMethodBadge(item.method)}
                <span class="font-mono text-xs font-semibold truncate text-[#1d1d1f] group-hover:text-white" title="${safePath}">
                  ${safePath}
                </span>
              </div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono mt-1 text-[#86868b] group-hover:text-white/80">
              <span>Avg: <strong class="text-[#1d1d1f] group-hover:text-amber-400 font-bold">${avg}ms</strong></span>
              <span>Max: <strong>${max}ms</strong></span>
              <span>${calls} calls</span>
            </div>
          </button>
        `;
      }).join('');

      bottlenecksList.querySelectorAll('.bottleneck-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const path = btn.getAttribute('data-path');
          if (!path || !searchInput) return;
          searchInput.value = path;
          currentSearch = path;
          currentPage = 1;
          if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
          loadLogs();
        });
      });
    }

    function renderPagination(page: number, totalPages: number, total: number) {
      if (!paginationContainer || totalPages <= 1) {
        if (paginationContainer) paginationContainer.classList.add('hidden');
        return;
      }

      paginationContainer.classList.remove('hidden');
      currentTotalPages = totalPages;

      const start = (page - 1) * limit + 1;
      const end = Math.min(page * limit, total);
      if (paginationSummary) {
        paginationSummary.innerHTML = `Showing <strong class="text-[#1d1d1f] font-mono">${start}–${end}</strong> of <strong class="text-[#1d1d1f] font-mono">${total}</strong> logs`;
      }

      if (paginationPrev) {
        paginationPrev.disabled = page <= 1;
      }
      if (paginationNext) {
        paginationNext.disabled = page >= totalPages;
      }
      if (paginationCurrent) {
        paginationCurrent.textContent = `${page} / ${totalPages}`;
      }
    }

    function renderRows(logs: any[]) {
      if (!contentEl) return;

      if (!logs || logs.length === 0) {
        contentEl.classList.add('hidden');
        if (paginationContainer) paginationContainer.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
      }

      if (emptyEl) emptyEl.classList.add('hidden');

      const html = `
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-[#1d1d1f]">
            <thead class="bg-[#f5f5f7]/60 text-[#86868b] font-medium border-b border-black/5">
              <tr>
                <th class="py-3 px-4">Level & Latency</th>
                <th class="py-3 px-4">Endpoint & Status</th>
                <th class="py-3 px-4">Message & Source</th>
                <th class="py-3 px-4">User / Ray ID</th>
                <th class="py-3 px-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-black/5">
              ${logs.map((log) => {
                const safeSource = escapeHtml(log.source || 'system');
                const safeCode = log.error_code ? escapeHtml(log.error_code) : '';
                const safeMessage = escapeHtml(log.message || '');
                const safeUser = escapeHtml(log.user_email || log.user_id || 'Anonymous');
                const safeRay = escapeHtml(log.ray_id || '');
                const safePath = escapeHtml(log.path || '');
                const safeMethod = log.method ? renderMethodBadge(log.method) : '';
                const latencyBadge = renderLatencyBadge(log.latency_ms);
                const statusBadge = log.method === 'CLIENT'
                  ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-medium bg-purple-50 text-purple-700">Browser</span>`
                  : (log.status_code ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono ${log.status_code >= 400 ? 'bg-rose-50 text-rose-700 font-bold' : 'bg-emerald-50 text-emerald-700'}">${log.status_code}</span>` : '');
                const timeStr = formatTime(log.created_at);

                const geoTokens = [];
                if (log.client_ip) geoTokens.push(log.client_ip);
                if (log.country) geoTokens.push(log.country);
                if (log.city) geoTokens.push(log.city);
                const clientGeo = geoTokens.length > 0 ? escapeHtml(geoTokens.join(' · ')) : '';

                return `
                  <tr class="hover:bg-[#f5f5f7]/40 transition-colors">
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        ${renderLevelBadge(log.level)}
                        ${latencyBadge}
                        <span class="text-[11px] font-mono text-[#86868b]">${timeStr}</span>
                      </div>
                    </td>

                    <td class="py-3 px-4 max-w-[200px] sm:max-w-xs">
                      <div class="flex items-center gap-1.5 truncate">
                        ${safeMethod}
                        ${statusBadge}
                        <span class="font-mono text-xs font-semibold truncate text-[#1d1d1f]" title="${safePath}">
                          ${safePath || '—'}
                        </span>
                      </div>
                      ${safeCode ? `<span class="text-[10px] font-mono text-[#86868b] block mt-0.5">${safeCode}</span>` : ''}
                    </td>

                    <td class="py-3 px-4 max-w-xs sm:max-w-md">
                      <span class="truncate block font-medium text-[#1d1d1f]" title="${safeMessage}">${safeMessage}</span>
                      <span class="text-[10px] font-mono text-[#86868b] truncate block mt-0.5">${safeSource}</span>
                    </td>

                    <td class="py-3 px-4 whitespace-nowrap text-[11px]">
                      <span class="text-[#1d1d1f] block font-mono truncate max-w-[140px] font-medium">${safeUser}</span>
                      ${clientGeo ? `
                        <span class="text-[10px] font-mono text-[#52525b] block mt-0.5 truncate max-w-[150px]" title="${clientGeo}">
                          🌐 ${clientGeo}
                        </span>
                      ` : ''}
                      ${safeRay ? `
                        <button
                          type="button"
                          class="copy-ray-btn text-[10px] font-mono text-[#86868b] hover:text-black flex items-center gap-1 cursor-pointer"
                          data-copy="${safeRay}"
                          title="Copy CF Ray ID"
                        >
                          <span class="truncate max-w-[100px]">${safeRay}</span>
                          <span class="copy-icon">📋</span>
                        </button>
                      ` : ''}
                    </td>

                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <button
                        type="button"
                        class="view-detail-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all cursor-pointer"
                        data-id="${log.id}"
                      >
                        Details
                      </button>
                    </td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      `;

      contentEl.innerHTML = html;
      contentEl.classList.remove('hidden');

      // Bind detail button events
      contentEl.querySelectorAll('.view-detail-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = Number(btn.getAttribute('data-id'));
          const log = logsList.find((l) => l.id === id);
          if (!log) return;
          openDetailModal(log);
        });
      });

      // Bind copy rayId events
      contentEl.querySelectorAll('.copy-ray-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const icon = btn.querySelector('.copy-icon');
            if (icon) {
              icon.textContent = '✓';
              setTimeout(() => { icon.textContent = '📋'; }, 1500);
            }
          } catch {}
        });
      });
    }

    function openDetailModal(log: any) {
      if (!detailModal) return;

      if (modalLevelBadge) modalLevelBadge.innerHTML = renderLevelBadge(log.level);
      if (modalSource) modalSource.textContent = log.source || 'system';
      if (modalMessage) modalMessage.textContent = log.message || '';
      if (modalTime) modalTime.textContent = formatTime(log.created_at);
      if (modalRay) modalRay.textContent = log.ray_id || '—';
      if (modalPath) modalPath.textContent = log.path || '—';
      if (modalHttp) {
        modalHttp.textContent = log.method === 'CLIENT'
          ? 'CLIENT · Browser Runtime'
          : `${log.method || 'GET'} · HTTP ${log.status_code || 200}`;
      }
      if (modalLatency) modalLatency.textContent = log.latency_ms ? `${log.latency_ms} ms` : '—';
      if (modalUser) modalUser.textContent = log.user_email || log.user_id || 'Anonymous';
      if (modalIp) modalIp.textContent = log.client_ip || '—';
      if (modalGeo) {
        const parts = [];
        if (log.country) parts.push(log.country);
        if (log.city) parts.push(log.city);
        modalGeo.textContent = parts.length > 0 ? parts.join(', ') : '—';
      }

      // Parse context and sub-spans breakdown
      let parsedContext: any = null;
      if (log.context_json) {
        try {
          parsedContext = JSON.parse(log.context_json);
        } catch {}
      }

      const spans = parsedContext?.spans || parsedContext?.context?.spans;
      if (modalSpansContainer && modalSpansList) {
        if (spans && typeof spans === 'object' && Object.keys(spans).length > 0) {
          modalSpansContainer.classList.remove('hidden');
          modalSpansList.innerHTML = Object.entries(spans)
            .map(([k, v]) => `
              <div class="p-2 rounded-lg bg-white border border-black/5 flex items-center justify-between">
                <span class="text-[#86868b]">${escapeHtml(k)}</span>
                <strong class="text-[#1d1d1f] font-bold">${v} ms</strong>
              </div>
            `)
            .join('');
        } else {
          modalSpansContainer.classList.add('hidden');
          modalSpansList.innerHTML = '';
        }
      }

      if (modalContext) {
        let formatted = 'No extra context recorded.';
        if (parsedContext) {
          formatted = JSON.stringify(parsedContext, null, 2);
        } else if (log.context_json) {
          formatted = log.context_json;
        }
        modalContext.textContent = formatted;
      }

      detailModal.showModal();
    }

    if (closeModalBtn) closeModalBtn.addEventListener('click', () => detailModal && detailModal.close());
    if (closeModalBottomBtn) closeModalBottomBtn.addEventListener('click', () => detailModal && detailModal.close());

    async function loadLogs(updateUrl = true) {
      if (updateUrl) syncUrl(true);
      const cacheKey = `admin:logs:${currentLevel}:${currentSearch}:${currentSort}:${currentPage}`;
      try {
        const query = new URLSearchParams();
        if (currentLevel && currentLevel !== 'ALL') query.set('level', currentLevel);
        if (currentSearch) query.set('search', currentSearch);
        if (currentSort && currentSort !== 'newest') query.set('sort', currentSort);
        query.set('limit', String(limit));
        query.set('page', String(currentPage));

        await clientCache.fetchWithCache(
          cacheKey,
          `/api/admin/logs?${query.toString()}`,
          {
            mode: 'swr',
            onData: (data: any) => {
              if (!data?.success) return;
              logsList = data.logs || [];
              if (metricTotal) metricTotal.textContent = data.stats?.total ?? 0;
              if (metricErrors) metricErrors.textContent = data.stats?.errors ?? 0;
              if (metricWarns) metricWarns.textContent = data.stats?.warns ?? 0;
              if (metricInfo) metricInfo.textContent = (data.stats?.info ?? 0) + (data.stats?.debug ?? 0);
              if (metricCritical) metricCritical.textContent = data.stats?.critical ?? 0;

              renderBottlenecks(data.bottlenecks || []);

              if (skeletonEl) skeletonEl.classList.add('hidden');
              renderRows(logsList);
              renderPagination(data.page || currentPage, data.totalPages || 1, data.total ?? logsList.length);
            },
          }
        );
      } catch (err) {
        console.error('Error fetching logs:', err);
        if (skeletonEl) skeletonEl.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
      }
    }

    // Sort select handler
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        currentPage = 1;
        loadLogs();
      });
    }

    // Pagination events
    if (paginationPrev) {
      paginationPrev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadLogs();
        }
      });
    }

    if (paginationNext) {
      paginationNext.addEventListener('click', () => {
        if (currentPage < currentTotalPages) {
          currentPage++;
          loadLogs();
        }
      });
    }

    // Level tabs
    document.querySelectorAll('.level-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lvl = btn.getAttribute('data-level');
        if (!lvl || lvl === currentLevel) return;
        currentLevel = lvl;
        currentPage = 1;
        updateTabsUi();
        loadLogs();
      });
    });

    // Search input
    let searchTimer: any = null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        if (clearSearchBtn) {
          if (currentSearch) clearSearchBtn.classList.remove('hidden');
          else clearSearchBtn.classList.add('hidden');
        }
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          loadLogs();
        }, 300);
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearch = '';
        currentPage = 1;
        clearSearchBtn.classList.add('hidden');
        loadLogs();
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        loadLogs();
      });
    }

    // Clear logs modal logic
    if (clearLogsBtn && clearConfirmModal) {
      clearLogsBtn.addEventListener('click', () => {
        clearConfirmModal.showModal();
      });
    }

    if (cancelClearBtn && clearConfirmModal) {
      cancelClearBtn.addEventListener('click', () => {
        clearConfirmModal.close();
      });
    }

    if (confirmClearBtn && clearConfirmModal) {
      confirmClearBtn.addEventListener('click', async () => {
        confirmClearBtn.textContent = 'Clearing...';
        confirmClearBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch('/api/admin/logs', { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            await clientCache.invalidatePrefix('admin:logs:');
            clearConfirmModal.close();
            currentPage = 1;
            loadLogs();
          } else {
            console.error('Failed to clear logs:', data.error);
          }
        } catch (e) {
          console.error('Network failure clearing logs:', e);
        } finally {
          confirmClearBtn.textContent = 'Delete All';
          confirmClearBtn.removeAttribute('disabled');
          clearConfirmModal.close();
        }
      });
    }

    // Popstate handling
    window.addEventListener('popstate', () => {
      const url = new URL(window.location.href);
      currentLevel = url.searchParams.get('level') || 'ALL';
      currentSearch = (url.searchParams.get('search') || '').trim();
      currentSort = url.searchParams.get('sort') || 'newest';
      currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));

      if (searchInput) searchInput.value = currentSearch;
      if (sortSelect) sortSelect.value = currentSort;
      if (clearSearchBtn) {
        if (currentSearch) clearSearchBtn.classList.remove('hidden');
        else clearSearchBtn.classList.add('hidden');
      }
      updateTabsUi();
      loadLogs(false);
    });

    // Initial load
    updateTabsUi();
    loadLogs(false);
  })();
</script>
