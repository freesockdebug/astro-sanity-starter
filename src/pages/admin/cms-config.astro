---
// src/pages/admin/cms-config.astro
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext } from '@utils/auth';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/cms-config',
  { requiredMenu: 'cms_config' }
);
if (redirectResponse) return redirectResponse;

const canWrite = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cms:write'));

const tabs = [
  ['site', '1. Navigation & Brand (siteConfig)'],
  ['catalog', '2. Product Hall (catalogSettings)'],
  ['story', '3. Craft Badges (productStorySettings)'],
  ['rfq', '4. RFQ Quote Drawer (rfqSettings)'],
] as const;

const rfqToggles = [
  ['rfq-toggle-swatch-kit', 'showSwatchKitButton', 'Show "Request Swatch Kit" button (Master Toggle)', false],
  ['rfq-toggle-nav-action', 'showNavActionButton', 'Show RFQ cart button in Navbar', false],
  ['rfq-toggle-card-quote', 'showCardQuoteButton', 'Show "Quote" button on Product Cards', true],
  ['rfq-toggle-hero-secondary', 'showHeroSecondaryButton', 'Show secondary CTA button in Hero', true],
  ['rfq-toggle-product-buy-sample', 'showProductBuySampleButton', 'Show "Buy Sample on Amazon" on detail page', true],
  ['rfq-toggle-product-add-quote', 'showProductAddToQuoteButton', 'Show "Add to Quote Basket" on detail page', true],
  ['rfq-toggle-product-spec-sheet', 'showProductSpecSheetButton', 'Show "Download Spec Sheet PDF" on detail page', true],
] as const;

const rfqCopyFields = [
  ['rfq-title-en', 'Drawer Header Title (EN)'],
  ['rfq-empty-en', 'Empty Cart Message (EN)'],
  ['rfq-btn-en', 'Add to Quote Button Text (EN)'],
  ['rfq-submit-en', 'Submit Inquiry Button Text (EN)'],
] as const;

const catalogFields = [
  ['cat-title-en', 'Banner Title (EN)'],
  ['cat-title-de', 'Banner Title (DE)'],
  ['cat-sub-en', 'Banner Subtitle (EN)'],
  ['cat-sub-de', 'Banner Subtitle (DE)'],
] as const;

const inpCls = 'w-full px-3 py-2 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs';
---

<AdminLayout
  title="CMS Site Configuration"
  currentTab="cms_config"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <AdminPageToolbar
      title="CMS Global Content Config"
      subtitle="Manage navigation, product catalog headers, artisan story badges and B2B RFQ cart"
    >
      <div slot="actions" class="flex items-center gap-2">
        {canWrite && (
          <button type="button" id="btn-save-current-config" class="h-8 px-4 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
            <span>Save Configuration</span>
          </button>
        )}
      </div>
    </AdminPageToolbar>

    <div class="flex-1 min-h-0 bg-white border border-black/5 rounded-2xl shadow-2xs flex flex-col overflow-hidden">
      <div class="px-4 border-b border-black/5 flex gap-4 text-xs font-semibold shrink-0 bg-[#fafafc]">
        {tabs.map(([id, label], i) => (
          <button type="button" class={`cfg-tab-btn py-3 border-b-2 cursor-pointer ${i === 0 ? 'border-black text-[#1d1d1f]' : 'border-transparent text-[#86868b] hover:text-black'}`} data-tab={id}>
            {label}
          </button>
        ))}
      </div>

      <div class="flex-1 overflow-y-auto p-4 sm:p-6 text-xs">
        <!-- PANE 1: siteConfig -->
        <div id="pane-site" class="cfg-pane space-y-5 max-w-3xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold mb-1">Brand Name *</label>
              <input type="text" id="site-brand-name" class={inpCls} />
            </div>
            <div>
              <label class="block font-semibold mb-1">Header Tagline</label>
              <input type="text" id="site-tagline" class={inpCls} />
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#1d1d1f] block">Header Navigation Links</span>
                <span class="text-[10px] text-[#86868b]">Top navigation items displayed across the store</span>
              </div>
              <button type="button" id="btn-add-nav-item" class="px-2.5 py-1 rounded-lg bg-white border border-black/10 hover:border-black text-[11px] font-semibold cursor-pointer shadow-2xs">＋ Add Link</button>
            </div>
            <div id="nav-items-container" class="space-y-2"></div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <label class="block font-bold text-xs text-[#1d1d1f]">Footer & Copyright Text</label>
            <input type="text" id="site-copyright" placeholder="© 2026 Gwen & Venni Atelier. All rights reserved." class={inpCls} />
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <span class="font-bold text-xs text-[#1d1d1f] block">Instant Communication & Webhook Notifications</span>
            <div class="space-y-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="site-enable-whatsapp" class="rounded accent-black" />
                <span class="font-semibold text-xs text-[#1d1d1f]">Enable Floating WhatsApp Bubble</span>
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pl-6">
                <div>
                  <label class="block font-semibold mb-1 text-[11px]">WhatsApp Phone Number</label>
                  <input type="text" id="site-whatsapp-number" placeholder="+1 (555) 019-2834" class={`${inpCls} font-mono`} />
                </div>
                <div>
                  <label class="block font-semibold mb-1 text-[11px]">Default Inquiry Greeting Message</label>
                  <input type="text" id="site-whatsapp-prefill" placeholder="Hello Gwen & Venni team..." class={inpCls} />
                </div>
              </div>
            </div>
            <div class="border-t border-black/5 pt-3 space-y-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="site-enable-webhook" class="rounded accent-black" />
                <span class="font-semibold text-xs text-[#1d1d1f]">Enable Inquiry Notification Webhook</span>
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pl-6">
                <div>
                  <label class="block font-semibold mb-1 text-[11px]">Robot Webhook URL (Slack, DingTalk, Feishu, etc.)</label>
                  <input type="url" id="site-webhook-url" placeholder="https://hooks.slack.com/services/..." class={`${inpCls} font-mono`} />
                </div>
                <div>
                  <label class="block font-semibold mb-1 text-[11px]">Inquiry Alert Recipient Email</label>
                  <input type="email" id="site-recipient-email" placeholder="wholesale@gwenvenni.com" class={inpCls} />
                </div>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <span class="font-bold text-xs text-[#1d1d1f] block">Performance & Cloudflare Edge CDN</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-center gap-2 pt-2">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="site-enable-image-proxy" class="rounded accent-black" />
                  <span class="font-semibold text-xs text-[#1d1d1f]">Enable Cloudflare Image Proxy (/cdn-image)</span>
                </label>
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[11px]">HTML Edge Cache TTL (Seconds)</label>
                <select id="site-edge-cache-ttl" class={inpCls}>
                  {[
                    [0, '0s (Direct bypass / No cache)'],
                    [60, '60s (1 minute - Testing)'],
                    [300, '300s (5 minutes - Recommended Gold Standard)'],
                    [900, '900s (15 minutes)'],
                    [1800, '1800s (30 minutes)'],
                    [3600, '3600s (1 hour)'],
                    [86400, '86400s (24 hours)'],
                  ].map(([val, label]) => <option value={String(val)}>{label}</option>)}
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- PANE 2: catalogSettings -->
        <div id="pane-catalog" class="cfg-pane hidden space-y-5 max-w-3xl">
          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <span class="font-bold text-xs text-[#1d1d1f] block">/products Catalog Header Banner</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {catalogFields.map(([id, label]) => (
                <div>
                  <label class="block font-semibold mb-1">{label}</label>
                  <input type="text" id={id} class={inpCls} />
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- PANE 3: productStorySettings -->
        <div id="pane-story" class="cfg-pane hidden space-y-5 max-w-3xl">
          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <span class="font-bold text-xs text-[#1d1d1f] block">Sidebar Story Header (Global Defaults)</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold mb-1">Badge Text (EN)</label>
                <input type="text" id="story-badge-text" placeholder="CRAFTSMANSHIP & STORY" class={inpCls} />
              </div>
              <div>
                <label class="block font-semibold mb-1">Story Heading (EN)</label>
                <input type="text" id="story-heading" placeholder="The Story Behind the Silhouette" class={inpCls} />
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#1d1d1f] block">Universal Craft & Quality Credential Cards</span>
                <span class="text-[10px] text-[#86868b]">Prominent credibility badges shown in the sticky sidebar (credentials[])</span>
              </div>
              <button type="button" id="btn-add-badge" class="px-2.5 py-1 rounded-lg bg-white border border-black/10 hover:border-black text-[11px] font-semibold cursor-pointer shadow-2xs">＋ Add Credential Card</button>
            </div>
            <div id="story-badges-container" class="space-y-2"></div>
          </div>
        </div>

        <!-- PANE 4: rfqSettings -->
        <div id="pane-rfq" class="cfg-pane hidden space-y-5 max-w-3xl">
          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <span class="font-bold text-xs text-[#1d1d1f] block">B2B Quote Cart & RFQ Drawer Copy</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {rfqCopyFields.map(([id, label]) => (
                <div>
                  <label class="block font-semibold mb-1">{label}</label>
                  <input type="text" id={id} class={inpCls} />
                </div>
              ))}
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <div>
              <span class="font-bold text-xs text-[#1d1d1f] block">Global Master Button Visibility Toggles</span>
              <span class="text-[10px] text-[#86868b]">Control visibility of call-to-action buttons across the entire website</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
              {rfqToggles.map(([id, prop, label, defVal], idx) => (
                <label class={`flex items-center gap-2 cursor-pointer ${idx === rfqToggles.length - 1 ? 'sm:col-span-2' : ''}`}>
                  <input type="checkbox" id={id} data-rfq-prop={prop} data-rfq-def={String(defVal)} class="rounded accent-black" />
                  <span class="text-xs text-[#1d1d1f]">{label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#fafafc] border border-black/5 space-y-3">
            <div>
              <span class="font-bold text-xs text-[#1d1d1f] block">Official Swatch Kit Defaults & Amazon Store</span>
              <span class="text-[10px] text-[#86868b]">Default item added when buyers click sample/swatch requests</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block font-semibold mb-1 text-[11px]">Swatch Kit SKU</label>
                <input type="text" id="rfq-swatch-sku" placeholder="SWATCH-KIT" class={`${inpCls} font-mono`} />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[11px]">Swatch Kit Title (EN)</label>
                <input type="text" id="rfq-swatch-title" placeholder="Curated Fabric Swatch Kit" class={inpCls} />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[11px]">Default Amazon Store URL</label>
                <input type="url" id="rfq-amazon-store-url" placeholder="https://www.amazon.com/stores/..." class={inpCls} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { escapeHtml, getFallbackEn, setLocaleVal, $val, $chk } from '@utils/adminWorkbench';

  const getLocaleVal = getFallbackEn;
  const makeLocaleVal = (str: string, orig?: any) => setLocaleVal(orig, str, 'en');

  function initCmsConfig() {
    let activeTab = 'site';
    let configs: any = {
      siteConfig: { _type: 'siteConfig', nav: [] },
      catalogSettings: { _type: 'catalogSettings' },
      productStorySettings: { _type: 'productStorySettings', badges: [] },
      rfqSettings: { _type: 'rfqSettings' },
    };

    const tabBtns = document.querySelectorAll('.cfg-tab-btn');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTab = btn.getAttribute('data-tab') || 'site';
        tabBtns.forEach((b) => {
          b.classList.toggle('border-black', b === btn);
          b.classList.toggle('text-[#1d1d1f]', b === btn);
          b.classList.toggle('border-transparent', b !== btn);
          b.classList.toggle('text-[#86868b]', b !== btn);
        });
        document.querySelectorAll('.cfg-pane').forEach((p) => p.classList.add('hidden'));
        document.getElementById(`pane-${activeTab}`)?.classList.remove('hidden');
      });
    });

    async function loadConfigs() {
      try {
        const res = await fetch('/api/admin/cms/config');
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to load configs');
        configs = data.configs;

        const s = configs.siteConfig || {};
        $val('site-brand-name', s.header?.title || s.brandName || 'Gwen & Venni');
        $val('site-tagline', getLocaleVal(s.header?.subtitle) || s.tagline || '');
        $val('site-copyright', getLocaleVal(s.footer?.text) || s.copyright || '');
        $chk('site-enable-whatsapp', Boolean(s.enableWhatsApp));
        $val('site-whatsapp-number', s.whatsAppNumber || '');
        $val('site-whatsapp-prefill', getLocaleVal(s.whatsAppPrefillText) || '');
        $chk('site-enable-webhook', Boolean(s.enableNotificationWebhook));
        $val('site-webhook-url', s.notificationWebhookUrl || '');
        $val('site-recipient-email', s.notificationRecipientEmail || '');
        $chk('site-enable-image-proxy', s.enableImageProxy !== undefined ? Boolean(s.enableImageProxy) : true);
        $val('site-edge-cache-ttl', String(s.edgeCacheTtl ?? 300));
        renderNavItems();

        const c = configs.catalogSettings || {};
        $val('cat-title-en', c.title?.en || '');
        $val('cat-title-de', c.title?.de || '');
        $val('cat-sub-en', c.subtitle?.en || '');
        $val('cat-sub-de', c.subtitle?.de || '');

        const st = configs.productStorySettings || {};
        $val('story-badge-text', getLocaleVal(st.storyBadgeText) || 'CRAFTSMANSHIP & STORY');
        $val('story-heading', getLocaleVal(st.storyHeading) || 'The Story Behind the Silhouette');
        renderStoryBadges();

        const r = configs.rfqSettings || {};
        $val('rfq-title-en', getLocaleVal(r.drawerTitle) || '');
        $val('rfq-empty-en', getLocaleVal(r.drawerEmptyTitle) || getLocaleVal(r.emptyCartNotice) || '');
        $val('rfq-btn-en', getLocaleVal(r.btnAddToQuoteText) || getLocaleVal(r.addToQuoteBtn) || '');
        $val('rfq-submit-en', getLocaleVal(r.drawerSubmitButtonText) || getLocaleVal(r.submitInquiryBtn) || '');
        document.querySelectorAll<HTMLInputElement>('[data-rfq-prop]').forEach((el) => {
          const prop = el.dataset.rfqProp!;
          const def = el.dataset.rfqDef === 'true';
          el.checked = r[prop] !== undefined ? Boolean(r[prop]) : def;
        });
        $val('rfq-swatch-sku', r.swatchKitSku || 'SWATCH-KIT');
        $val('rfq-swatch-title', getLocaleVal(r.swatchKitTitle) || '');
        $val('rfq-amazon-store-url', r.defaultAmazonStoreUrl || '');
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    }

    function renderNavItems() {
      const container = document.getElementById('nav-items-container');
      if (!container) return;
      const nav = configs.siteConfig.header?.navLinks || configs.siteConfig.nav || [];
      container.innerHTML = nav.length === 0
        ? `<div class="py-2 text-[#86868b] text-[11px]">No custom navigation links.</div>`
        : nav.map((item: any, idx: number) => `
          <div class="flex items-center gap-2">
            <input type="text" class="nav-label w-1/3 px-2.5 py-1.5 rounded-xl bg-white border border-black/10 text-xs" placeholder="Label" value="${escapeHtml(getLocaleVal(item.label) || '')}" />
            <input type="text" class="nav-href flex-1 px-2.5 py-1.5 rounded-xl bg-white border border-black/10 font-mono text-xs" placeholder="/products" value="${escapeHtml(item.url || item.href || '')}" />
            <button type="button" class="btn-del-nav text-[#86868b] hover:text-rose-600 p-1" data-idx="${idx}">✕</button>
          </div>
        `).join('');
      container.querySelectorAll('.btn-del-nav').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          configs.siteConfig.header?.navLinks?.splice(idx, 1);
          configs.siteConfig.nav?.splice(idx, 1);
          renderNavItems();
        });
      });
    }

    document.getElementById('btn-add-nav-item')?.addEventListener('click', () => {
      ((configs.siteConfig.header ||= {}).navLinks ||= []).push({
        _key: crypto.randomUUID().slice(0, 8),
        _type: 'actionLink',
        label: { en: 'New Link' },
        url: '/custom',
      });
      renderNavItems();
    });

    function renderStoryBadges() {
      const container = document.getElementById('story-badges-container');
      if (!container) return;
      const badges = configs.productStorySettings.credentials || configs.productStorySettings.badges || [];
      const icons = [['lonati', '⚙️ Lonati'], ['seamless', '🪡 Seamless'], ['oekotex', '🌿 OEKO-TEX'], ['gauge', '📐 High-Gauge'], ['fiber', '🧵 Natural Fibers'], ['custom', '✨ Custom']];
      container.innerHTML = badges.length === 0
        ? `<div class="py-2 text-[#86868b] text-[11px]">No credential cards configured.</div>`
        : badges.map((b: any, idx: number) => `
          <div class="p-2.5 rounded-xl bg-white border border-black/5 flex flex-col sm:flex-row items-start sm:items-center gap-2">
            <select class="badge-icon-type px-2 py-1 rounded-lg bg-[#f5f5f7] border border-black/10 text-xs shrink-0">
              ${icons.map(([v, l]) => `<option value="${v}" ${b.iconType === v ? 'selected' : ''}>${l}</option>`).join('')}
            </select>
            <input type="text" class="badge-title flex-1 px-2.5 py-1 rounded-lg bg-[#f5f5f7] border border-black/10 text-xs" placeholder="Card Title" value="${escapeHtml(getLocaleVal(b.title) || '')}" />
            <input type="text" class="badge-desc flex-1 px-2.5 py-1 rounded-lg bg-[#f5f5f7] border border-black/10 text-xs" placeholder="Detail Description" value="${escapeHtml(getLocaleVal(b.description) || '')}" />
            <button type="button" class="btn-del-badge text-[#86868b] hover:text-rose-600 p-1 self-end sm:self-center" data-idx="${idx}">✕</button>
          </div>
        `).join('');
      container.querySelectorAll('.btn-del-badge').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          configs.productStorySettings.credentials?.splice(idx, 1);
          configs.productStorySettings.badges?.splice(idx, 1);
          renderStoryBadges();
        });
      });
    }

    document.getElementById('btn-add-badge')?.addEventListener('click', () => {
      (configs.productStorySettings.credentials ||= []).push({
        _key: crypto.randomUUID().slice(0, 8),
        iconType: 'lonati',
        title: { en: 'Italian Lonati Calibration' },
        description: { en: '200-needle precision cylinder engineering' },
      });
      renderStoryBadges();
    });

    document.getElementById('btn-save-current-config')?.addEventListener('click', async () => {
      let targetDocType = 'siteConfig';
      let targetPayload: any = {};

      if (activeTab === 'site') {
        targetDocType = 'siteConfig';
        const brand = $val('site-brand-name') || 'Gwen & Venni';
        const tagline = $val('site-tagline');
        const copyright = $val('site-copyright');
        const labels = document.querySelectorAll<HTMLInputElement>('#nav-items-container .nav-label');
        const hrefs = document.querySelectorAll<HTMLInputElement>('#nav-items-container .nav-href');
        const navLinks = Array.from(labels).map((lInput, idx) => ({
          _key: crypto.randomUUID().slice(0, 8),
          _type: 'actionLink',
          label: makeLocaleVal(lInput.value.trim()),
          url: hrefs[idx]?.value.trim() || '/',
        }));

        const s = configs.siteConfig;
        s.header = { ...(s.header || {}), title: brand, subtitle: makeLocaleVal(tagline, s.header?.subtitle), navLinks };
        s.footer = { ...(s.footer || {}), text: makeLocaleVal(copyright, s.footer?.text) };
        s.enableWhatsApp = $chk('site-enable-whatsapp');
        s.whatsAppNumber = $val('site-whatsapp-number');
        s.whatsAppPrefillText = makeLocaleVal($val('site-whatsapp-prefill'), s.whatsAppPrefillText);
        s.enableNotificationWebhook = $chk('site-enable-webhook');
        s.notificationWebhookUrl = $val('site-webhook-url');
        s.notificationRecipientEmail = $val('site-recipient-email');
        s.enableImageProxy = $chk('site-enable-image-proxy');
        s.edgeCacheTtl = parseInt($val('site-edge-cache-ttl') || '300', 10);
        s.brandName = brand;
        s.tagline = tagline;
        s.copyright = copyright;
        s.nav = navLinks.map((l) => ({ label: l.label, href: l.url }));
        targetPayload = s;
      } else if (activeTab === 'catalog') {
        targetDocType = 'catalogSettings';
        configs.catalogSettings.title = { en: $val('cat-title-en'), de: $val('cat-title-de') };
        configs.catalogSettings.subtitle = { en: $val('cat-sub-en'), de: $val('cat-sub-de') };
        targetPayload = configs.catalogSettings;
      } else if (activeTab === 'story') {
        targetDocType = 'productStorySettings';
        const st = configs.productStorySettings;
        st.storyBadgeText = makeLocaleVal($val('story-badge-text'), st.storyBadgeText);
        st.storyHeading = makeLocaleVal($val('story-heading'), st.storyHeading);
        const iconSelects = document.querySelectorAll<HTMLSelectElement>('#story-badges-container .badge-icon-type');
        const titles = document.querySelectorAll<HTMLInputElement>('#story-badges-container .badge-title');
        const descs = document.querySelectorAll<HTMLInputElement>('#story-badges-container .badge-desc');
        const credentials = Array.from(titles).map((tInput, idx) => ({
          _key: crypto.randomUUID().slice(0, 8),
          iconType: iconSelects[idx]?.value || 'lonati',
          title: makeLocaleVal(tInput.value.trim() || 'Standard'),
          description: { _type: 'localeText', en: descs[idx]?.value.trim() || '' },
        }));
        st.credentials = credentials;
        st.badges = credentials.map((c) => ({ icon: c.iconType, title: c.title }));
        targetPayload = st;
      } else if (activeTab === 'rfq') {
        targetDocType = 'rfqSettings';
        const r = configs.rfqSettings;
        r.drawerTitle = makeLocaleVal($val('rfq-title-en'), r.drawerTitle);
        r.drawerEmptyTitle = makeLocaleVal($val('rfq-empty-en'), r.drawerEmptyTitle);
        r.btnAddToQuoteText = makeLocaleVal($val('rfq-btn-en'), r.btnAddToQuoteText);
        r.drawerSubmitButtonText = makeLocaleVal($val('rfq-submit-en'), r.drawerSubmitButtonText);
        document.querySelectorAll<HTMLInputElement>('[data-rfq-prop]').forEach((el) => {
          r[el.dataset.rfqProp!] = el.checked;
        });
        r.swatchKitSku = $val('rfq-swatch-sku') || 'SWATCH-KIT';
        r.swatchKitTitle = makeLocaleVal($val('rfq-swatch-title'), r.swatchKitTitle);
        r.defaultAmazonStoreUrl = $val('rfq-amazon-store-url') || undefined;
        r.emptyCartNotice = r.drawerEmptyTitle;
        r.addToQuoteBtn = r.btnAddToQuoteText;
        r.submitInquiryBtn = r.drawerSubmitButtonText;
        targetPayload = r;
      }

      targetPayload._type = targetDocType;
      (window as any).__showToast?.(`Saving ${targetDocType}...`, 'info');
      try {
        const res = await fetch('/api/admin/cms/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ document: targetPayload }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save config');
        (window as any).__showToast?.(`Saved ${targetDocType} & refreshed caches!`, 'success');
        if (activeTab === 'site' && typeof configs.siteConfig.enableImageProxy === 'boolean') {
          (window as any).__ENABLE_IMAGE_PROXY__ = configs.siteConfig.enableImageProxy;
        }
        loadConfigs();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    });

    loadConfigs();
  }

  initCmsConfig();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('btn-save-current-config')) initCmsConfig();
  });
</script>
