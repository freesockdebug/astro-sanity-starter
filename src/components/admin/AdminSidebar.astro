---
// src/components/admin/AdminSidebar.astro
// Unified 240px B2B Vertical Sidebar for Admin Console with Configuration-Driven RBAC Trimming
import { ADMIN_MENU_GROUPS, type AdminMenuItem } from '@config/adminNavigation';

interface Props {
  currentTab: string;
  sessionEmail: string;
  pendingOrdersCount?: number;
  adminName?: string;
  roleName?: string;
  roleCode?: string;
  menus?: string[];
  dataScope?: string;
}

const {
  currentTab,
  pendingOrdersCount = 0,
  menus,
} = Astro.props;

const menuSet = Array.isArray(menus) ? new Set(menus) : typeof menus === 'string' ? new Set([menus]) : null;
const canShow = (key: string) => !menuSet || menuSet.has(key);

// SVG Icon definitions corresponding to menu keys
const MENU_SVGS: Record<string, string> = {
  dashboard: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  orders: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  products: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  pages: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  cms_config: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
  cache: 'M13 10V3L4 14h7v7l9-11h-7z',
  members: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  roles: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  dicts: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
  logins: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  logs: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
};
---

<!-- Mobile Drawer Backdrop Overlay -->
<div
  id="admin-sidebar-backdrop"
  class="fixed inset-0 bg-black/40 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Vertical Sidebar Shell: Fixed on Mobile (Slide-over), Sticky on Desktop -->
<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-[clamp(14rem,11rem+4vw,17.5rem)] bg-white border-r border-black/10 flex flex-col transform -translate-x-full lg:translate-x-0 lg:static lg:h-screen lg:sticky lg:top-0 transition-transform duration-300 ease-in-out shrink-0 selection:bg-zinc-900 selection:text-white"
  aria-label="Admin Navigation Sidebar"
>
  <!-- Top Brand & Status Section -->
  <div class="p-5 border-b border-black/5 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-[#1d1d1f] text-white flex items-center justify-center font-bold text-xs tracking-wider shadow-xs shrink-0">
        B2B
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold tracking-tight text-[#1d1d1f] truncate">B2B Workspace</span>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            D1
          </span>
        </div>
        <p class="text-[10px] text-[#86868b] uppercase tracking-wider font-medium truncate">Admin Console</p>
      </div>
    </div>

    <!-- Mobile Close Drawer Button -->
    <button
      id="admin-close-sidebar-btn"
      type="button"
      class="p-1.5 rounded-lg text-[#86868b] hover:text-black hover:bg-[#f5f5f7] lg:hidden transition-all text-sm"
      aria-label="Close sidebar"
    >
      ✕
    </button>
  </div>

  <!-- Navigation Groups: Fully Driven by ADMIN_MENU_GROUPS Configuration -->
  <nav class="flex-1 overflow-y-auto px-3.5 py-5 space-y-6 text-xs" aria-label="Admin Sections">
    {ADMIN_MENU_GROUPS.map((group) => {
      const visibleItems = group.items.filter((item) => canShow(item.key));
      if (visibleItems.length === 0) return null;

      return (
        <div class="space-y-1">
          <div class="px-2.5 pb-1 text-[10px] font-bold uppercase tracking-wider text-[#86868b]">
            {group.groupTitle}
          </div>

          {visibleItems.map((item: AdminMenuItem) => {
            const isActive = currentTab === item.key;
            const svgPath = MENU_SVGS[item.key];

            return (
              <a
                href={item.href}
                data-shell-nav="admin"
                data-tab-key={item.key}
                data-tab-title={item.label}
                class:list={[
                  'flex items-center justify-between px-3 py-2.5 rounded-xl font-medium transition-all group',
                  isActive
                    ? 'bg-[#1d1d1f] text-white shadow-xs font-semibold'
                    : 'text-[#52525b] hover:text-black hover:bg-black/5',
                ]}
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  {svgPath ? (
                    <svg class="w-4 h-4 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={svgPath} />
                    </svg>
                  ) : (
                    <span class="text-sm select-none shrink-0">{item.icon}</span>
                  )}
                  <span class="truncate">{item.label}</span>
                </div>

                {item.showPendingBadge && pendingOrdersCount > 0 && (
                  <span class="font-mono text-[10px] px-1.5 py-0.2 rounded-md font-bold shrink-0 transition-colors group-[.bg-\[\#1d1d1f\]]:bg-amber-400 group-[.bg-\[\#1d1d1f\]]:text-amber-950 bg-amber-100 text-amber-900">
                    {pendingOrdersCount}
                  </span>
                )}
              </a>
            );
          })}
        </div>
      );
    })}
  </nav>
</aside>
