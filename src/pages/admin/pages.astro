---
// src/pages/admin/pages.astro
// Native Cloudflare SSR Modular Page Builder & Visual Canvas (1:1 Native Sanity Studio Port)
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import MediaLibraryModal from '@components/admin/MediaLibraryModal.astro';
import { requireAdminContext } from '@utils/auth';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/pages',
  { requiredMenu: 'pages' }
);
if (redirectResponse) return redirectResponse;

const canWrite = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cms:write'));
const canDelete = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cms:delete'));

const pageTitle = 'Pages & Modular Visual Builder';
---

<AdminLayout
  title={pageTitle}
  currentTab="pages"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- Top Action Bar -->
    <AdminPageToolbar
      title="Pages & Sections Builder"
      subtitle="· Compose modular landing pages & live responsive preview"
    >
      <div slot="actions" class="flex items-center gap-2">
        {canWrite && (
          <button
            type="button"
            id="btn-create-page"
            class="h-8 px-3.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer"
          >
            <span>＋ Create Page</span>
          </button>
        )}
      </div>
    </AdminPageToolbar>

    <!-- Split-Pane Workspace: Left Pages Directory (300px) | Right Builder & Canvas -->
    <div class="flex-1 min-h-0 flex flex-col lg:flex-row gap-3 overflow-hidden">
      <!-- Left: Pages Directory -->
      <div class="w-full lg:w-80 shrink-0 bg-white border border-black/5 rounded-2xl shadow-2xs flex flex-col overflow-hidden">
        <div class="p-3 border-b border-black/5 bg-[#fafafc] flex items-center justify-between">
          <span class="text-xs font-bold text-[#1d1d1f]">Site Pages Directory</span>
          <span id="pages-count-badge" class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-[#f5f5f7] border border-black/5">0</span>
        </div>
        <div id="pages-list" class="flex-1 overflow-y-auto divide-y divide-black/5 p-1.5 space-y-1">
          <div class="py-12 text-center text-[#86868b] text-xs">Loading pages...</div>
        </div>
      </div>

      <!-- Right: Modular Block Builder & Live Responsive Canvas -->
      <div class="flex-1 min-h-0 bg-white border border-black/5 rounded-2xl shadow-2xs flex flex-col overflow-hidden">
        <!-- Editor Sub-Header: Mode, Device & Multi-Language Switcher -->
        <div class="p-3 border-b border-black/5 flex flex-wrap items-center justify-between gap-3 bg-[#fafafc] shrink-0">
          <div class="flex items-center gap-2">
            <span id="current-page-badge" class="font-mono font-bold text-xs px-2.5 py-1 rounded-lg bg-[#1d1d1f] text-white shadow-2xs">
              Select a Page
            </span>
            <div class="flex items-center bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" id="btn-mode-builder" class="px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer">
                Blocks Form
              </button>
              <button type="button" id="btn-mode-canvas" class="px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer">
                Live Canvas
              </button>
            </div>
          </div>

          <!-- Multi-Language Tab Switcher (EN / DE / FR / ES) -->
          <div class="flex items-center gap-2">
            <div id="lang-switcher" class="flex items-center bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer" data-lang="en">
                🇬🇧 EN
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="de">
                🇩🇪 DE
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="fr">
                🇫🇷 FR
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="es">
                🇪🇸 ES
              </button>
            </div>

            <!-- Responsive Viewport Switcher -->
            <div id="device-switcher" class="hidden flex items-center gap-1.5 bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer" data-width="100%">
                🖥️ Desktop
              </button>
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-width="1280px">
                💻 1280px
              </button>
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-width="390px">
                📱 Mobile
              </button>
            </div>

            {canWrite && (
              <button
                type="button"
                id="btn-save-page"
                class="h-8 px-4 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs cursor-pointer flex items-center gap-1.5"
              >
                <span>Save & Publish Page</span>
              </button>
            )}
          </div>
        </div>

        <!-- Mode A: Blocks Editor Pane -->
        <div id="builder-pane" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 text-xs">
          <!-- Page Meta Form (URL & SEO) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <div class="flex items-center justify-between border-b border-black/5 pb-2">
              <span class="font-bold text-xs text-[#1d1d1f] flex items-center gap-1.5">
                <span>🌐</span> 1. Page URL & SEO Metadata
              </span>
              <span id="seo-lang-indicator" class="text-[10px] font-mono text-[#86868b]">Editing Language: EN</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">Page Title * (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-title-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">URL Path Slug *</label>
                <input type="text" id="page-slug-input" placeholder="/ or /about" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black font-mono text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">SEO Meta Title (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-metatitle-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">SEO Meta Description (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-metadesc-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 text-xs" />
              </div>
            </div>

            <!-- Social Share Image & Suffix Toggle -->
            <div class="pt-3 border-t border-black/5 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
              <div class="flex items-center gap-3">
                <div id="social-image-preview" class="w-16 h-16 rounded-xl bg-white border border-black/10 flex items-center justify-center overflow-hidden shrink-0 shadow-2xs">
                  <span class="text-[9px] text-[#86868b]">No Image</span>
                </div>
                <div class="space-y-1">
                  <label class="block font-semibold text-[11px] text-[#1d1d1f]">Social Sharing Image (socialImage)</label>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      id="btn-choose-social-image"
                      class="px-2.5 py-1 rounded-lg bg-[#1d1d1f] text-white text-[11px] font-semibold cursor-pointer shadow-2xs hover:bg-black"
                    >
                      📁 From Media Library
                    </button>
                    <button
                      type="button"
                      id="btn-remove-social-image"
                      class="px-2 py-1 rounded-lg text-rose-600 hover:bg-rose-50 text-[11px] cursor-pointer hidden"
                    >
                      ✕ Remove
                    </button>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <input type="checkbox" id="page-add-suffix-input" class="rounded border-black/20 text-[#1d1d1f] focus:ring-0 cursor-pointer" />
                <label for="page-add-suffix-input" class="font-medium text-xs text-[#1d1d1f] cursor-pointer">
                  Append site title suffix automatically (addTitleSuffix)
                </label>
              </div>
            </div>
          </div>

          <!-- Modular Sections Array -->
          <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="font-bold text-xs text-[#1d1d1f] block">2. Modular Page Sections (Sections Stream)</span>
                <span class="text-[10px] text-[#86868b]">Drag handle ⠿ to reorder · 1:1 Isolated dedicated forms with zero field bleed</span>
              </div>
              <div class="flex items-center gap-2">
                <select id="select-new-section" class="h-8 px-2.5 rounded-xl bg-[#f5f5f7] border border-black/10 text-xs cursor-pointer font-medium">
                  <option value="heroSection">🌟 主视觉首屏 (heroSection)</option>
                  <option value="productShowcaseSection">🗂️ 精选产品展廊 (productShowcaseSection)</option>
                  <option value="featureMatrixSection">📐 核心工艺矩阵 (featureMatrixSection)</option>
                  <option value="manufacturingSection">🏭 制造实力工坊 (manufacturingSection)</option>
                  <option value="inquirySection">📩 商务咨询与转化 (inquirySection)</option>
                  <option value="customSection">🎨 自由积木排版 (customSection)</option>
                </select>
                <button
                  type="button"
                  id="btn-add-section"
                  class="h-8 px-3.5 rounded-xl bg-[#1d1d1f] text-white hover:bg-black text-xs font-semibold shadow-2xs cursor-pointer flex items-center gap-1"
                >
                  <span>＋ Add Section</span>
                </button>
              </div>
            </div>

            <!-- Sections Container -->
            <div id="sections-container" class="space-y-3">
              <div class="p-8 text-center text-[#86868b] border border-dashed border-black/10 rounded-2xl">
                No page selected or page has no sections. Select a page from the left to start editing.
              </div>
            </div>
          </div>
        </div>

        <!-- Mode B: Live Responsive Canvas Pane -->
        <div id="canvas-pane" class="hidden flex-1 min-h-0 bg-[#f5f5f7] flex items-center justify-center p-3 overflow-hidden">
          <div id="canvas-wrapper" class="w-full h-full bg-white rounded-2xl shadow-xl overflow-hidden border border-black/10 transition-all duration-300">
            <iframe id="live-preview-frame" src="/" class="w-full h-full border-0"></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Global Cloud Media Library Modal -->
    <MediaLibraryModal />
  </div>
</AdminLayout>

<script>
  import {
    escapeHtml,
    getLocaleVal,
    getFallbackEn,
    setLocaleVal,
    renderSchemaFields,
    syncSchemaFieldsFromDom,
    type FieldSpec,
  } from '@utils/adminWorkbench';

  function initPagesWorkbench() {
    const listEl = document.getElementById('pages-list');
    if (!listEl || (listEl as any).__initialized) return;
    (listEl as any).__initialized = true;

    let currentPages: any[] = [];
    let activePageDoc: any = null;
    let catalogProducts: any[] = [];
    let currentLang = 'en'; // 'en' | 'de' | 'fr' | 'es'
    let draggedSectionIdx: number | null = null;
    // Bug 3 Fix: Store collapse state using unique section _key (string)
    let collapsedSections: Set<string> = new Set();

    // Multi-Language string helpers imported from @utils/adminWorkbench

    // View Mode Switcher
    const btnModeBuilder = document.getElementById('btn-mode-builder');
    const btnModeCanvas = document.getElementById('btn-mode-canvas');
    const builderPane = document.getElementById('builder-pane');
    const canvasPane = document.getElementById('canvas-pane');
    const deviceSwitcher = document.getElementById('device-switcher');
    const previewFrame = document.getElementById('live-preview-frame') as HTMLIFrameElement | null;
    const canvasWrapper = document.getElementById('canvas-wrapper');

    btnModeBuilder?.addEventListener('click', () => {
      btnModeBuilder.className = 'px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
      if (btnModeCanvas) btnModeCanvas.className = 'px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
      builderPane?.classList.remove('hidden');
      canvasPane?.classList.add('hidden');
      deviceSwitcher?.classList.add('hidden');
    });

    btnModeCanvas?.addEventListener('click', () => {
      btnModeCanvas.className = 'px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
      if (btnModeBuilder) btnModeBuilder.className = 'px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
      canvasPane?.classList.remove('hidden');
      builderPane?.classList.add('hidden');
      deviceSwitcher?.classList.remove('hidden');

      const slug = activePageDoc?.slug?.current || '/';
      const cleanSlug = slug === '/' ? '' : (slug.startsWith('/') ? slug : `/${slug}`);
      const langPrefix = currentLang === 'en' ? '' : `/${currentLang}`;
      if (previewFrame) previewFrame.src = `${langPrefix}${cleanSlug}` || '/';
    });

    // Device Switcher
    document.querySelectorAll('.btn-device').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.btn-device').forEach((b) => {
          b.className = 'btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
        });
        btn.className = 'btn-device px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
        const width = btn.getAttribute('data-width') || '100%';
        if (canvasWrapper) canvasWrapper.style.width = width;
      });
    });

    // Language Tab Switcher
    document.querySelectorAll('.btn-lang').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang');
        if (!targetLang || targetLang === currentLang) return;

        // 1. Sync current DOM inputs to memory for currentLang
        syncMetaFromDom();
        syncSectionsFromDom();

        // 2. Switch language
        currentLang = targetLang;
        document.querySelectorAll('.btn-lang').forEach((b) => {
          b.className = 'btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
        });
        btn.className = 'btn-lang px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';

        document.querySelectorAll('.current-lang-label').forEach((el) => {
          el.textContent = currentLang.toUpperCase();
        });
        const seoLang = document.getElementById('seo-lang-indicator');
        if (seoLang) seoLang.textContent = `Editing Language: ${currentLang.toUpperCase()}`;

        // 3. Re-render forms with new language values
        populateMetaInputs();
        renderSections();
        (window as any).__showToast?.(`Switched editing language to ${currentLang.toUpperCase()}`, 'info');
      });
    });

    // Load Catalog Products for Product Showcase Section
    async function loadCatalogProducts() {
      try {
        const res = await fetch('/api/admin/cms/products');
        const data = await res.json();
        if (res.ok && data.success) {
          catalogProducts = data.products || [];
        }
      } catch (e) {
        console.warn('Failed to load products for picker:', e);
      }
    }

    // Load Site Pages
    async function loadPages() {
      try {
        const res = await fetch('/api/admin/cms/pages');
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to fetch pages');

        currentPages = data.pages || [];
        const badge = document.getElementById('pages-count-badge');
        if (badge) badge.textContent = String(currentPages.length);

        renderPagesList();

        if (!activePageDoc && currentPages.length > 0) {
          const home = currentPages.find((p: any) => p.slug?.current === '/' || p.slug?.current === '' || p.slug?.current === 'home') || currentPages[0];
          selectPage(home._id);
        }
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    }

    function renderPagesList() {
      const list = document.getElementById('pages-list');
      if (!list) return;

      list.innerHTML = currentPages.map((p: any) => {
        const slug = p.slug?.current || '/';
        const isHome = slug === '/' || slug === '' || slug === 'home';
        const isSelected = activePageDoc?._id === p._id;

        return `
          <div
            class="p-2.5 rounded-xl cursor-pointer transition-all page-list-item ${isSelected ? 'bg-[#1d1d1f] text-white shadow-2xs' : 'hover:bg-[#f5f5f7] text-[#1d1d1f]'}"
            data-id="${p._id}"
          >
            <div class="flex items-center justify-between gap-1.5 mb-1">
              <span class="font-semibold text-xs truncate">${escapeHtml(getFallbackEn(p.title) || (isHome ? 'Homepage' : 'Untitled Page'))}</span>
              ${isHome ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold ${isSelected ? 'bg-white/20 text-white' : 'bg-amber-100 text-amber-900'}">Home</span>` : ''}
            </div>
            <div class="flex items-center justify-between text-[10px] ${isSelected ? 'text-white/70' : 'text-[#86868b]'} font-mono">
              <span>${escapeHtml(slug)}</span>
              <span>${p.sectionCount || 0} sections</span>
            </div>
          </div>
        `;
      }).join('');

      list.querySelectorAll('.page-list-item').forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-id');
          if (id) selectPage(id);
        });
      });
    }

    async function selectPage(id: string) {
      try {
        const res = await fetch(`/api/admin/cms/pages?id=${encodeURIComponent(id)}`);
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to load page');

        activePageDoc = data.page;
        if (!activePageDoc.sections) activePageDoc.sections = [];

        // Ensure every section has a unique _key for stable collapse and drag state
        activePageDoc.sections.forEach((sec: any) => {
          if (!sec._key) sec._key = crypto.randomUUID().slice(0, 8);
        });

        collapsedSections.clear();

        renderPagesList();

        const badge = document.getElementById('current-page-badge');
        if (badge) badge.textContent = getFallbackEn(activePageDoc.title) || activePageDoc.slug?.current || 'Page';

        populateMetaInputs();
        renderSocialImagePreview();
        renderSections();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    }

    function populateMetaInputs() {
      if (!activePageDoc) return;
      const titleInput = document.getElementById('page-title-input') as HTMLInputElement | null;
      const slugInput = document.getElementById('page-slug-input') as HTMLInputElement | null;
      const metaTitleInput = document.getElementById('page-metatitle-input') as HTMLInputElement | null;
      const metaDescInput = document.getElementById('page-metadesc-input') as HTMLInputElement | null;
      const suffixInput = document.getElementById('page-add-suffix-input') as HTMLInputElement | null;

      if (titleInput) {
        titleInput.value = getLocaleVal(activePageDoc.title, currentLang);
        titleInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.title)})` : 'Enter page title...';
      }
      if (slugInput) {
        slugInput.value = activePageDoc.slug?.current || '/';
      }
      if (metaTitleInput) {
        metaTitleInput.value = getLocaleVal(activePageDoc.metaTitle, currentLang);
        metaTitleInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.metaTitle)})` : 'SEO Page Title...';
      }
      if (metaDescInput) {
        metaDescInput.value = getLocaleVal(activePageDoc.metaDescription, currentLang);
        metaDescInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.metaDescription)})` : 'SEO Meta Description...';
      }
      if (suffixInput) {
        suffixInput.checked = activePageDoc.addTitleSuffix !== false;
      }
    }

    function renderSocialImagePreview() {
      const el = document.getElementById('social-image-preview');
      const btnRemove = document.getElementById('btn-remove-social-image');
      if (!el) return;

      const imgUrl = (window as any).resolveSanityRefUrl?.(activePageDoc?.socialImage) ||
        activePageDoc?.socialImage?.asset?.url || '';

      if (imgUrl) {
        el.innerHTML = `<img src="${escapeHtml(imgUrl)}" class="w-full h-full object-cover" />`;
        btnRemove?.classList.remove('hidden');
      } else {
        el.innerHTML = `<span class="text-[9px] text-[#86868b]">No Image</span>`;
        btnRemove?.classList.add('hidden');
      }
    }

    document.getElementById('btn-choose-social-image')?.addEventListener('click', () => {
      (window as any).__openMediaLibrary?.({
        mode: 'single',
        title: 'Choose Social Sharing Preview Image (socialImage)',
        onSelect: (selectedAssets: any[]) => {
          if (!selectedAssets || selectedAssets.length === 0) return;
          const asset = selectedAssets[0];
          activePageDoc.socialImage = {
            _type: 'image',
            asset: {
              _type: 'reference',
              _ref: asset._id,
            },
          };
          renderSocialImagePreview();
          (window as any).__showToast?.('Updated social sharing image', 'success');
        },
      });
    });

    document.getElementById('btn-remove-social-image')?.addEventListener('click', () => {
      activePageDoc.socialImage = null;
      renderSocialImagePreview();
    });

    function syncMetaFromDom() {
      if (!activePageDoc) return;
      const titleInput = document.getElementById('page-title-input') as HTMLInputElement | null;
      const slugInput = document.getElementById('page-slug-input') as HTMLInputElement | null;
      const metaTitleInput = document.getElementById('page-metatitle-input') as HTMLInputElement | null;
      const metaDescInput = document.getElementById('page-metadesc-input') as HTMLInputElement | null;
      const suffixInput = document.getElementById('page-add-suffix-input') as HTMLInputElement | null;

      // Bug 2 Fix: Unconditional assignment when DOM element exists so clearing fields works
      if (titleInput) activePageDoc.title = setLocaleVal(activePageDoc.title, titleInput.value.trim(), currentLang);
      if (metaTitleInput) activePageDoc.metaTitle = setLocaleVal(activePageDoc.metaTitle, metaTitleInput.value.trim(), currentLang);
      if (metaDescInput) activePageDoc.metaDescription = setLocaleVal(activePageDoc.metaDescription, metaDescInput.value.trim(), currentLang);
      if (slugInput) activePageDoc.slug = { _type: 'slug', current: slugInput.value.trim() || '/' };
      if (suffixInput) activePageDoc.addTitleSuffix = suffixInput.checked;
    }

    // Default 4-Language Initial Values for New Sections
    function getSectionInitialValues(type: string) {
      const baseKey = crypto.randomUUID().slice(0, 8);
