# Cloudflare Pages / Workers Assets Caching Policies

# 1. Vite / Astro Hashed Production Chunks (Immutable 1-Year Cache)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Local Built-in WebP Images & Product Graphics (30-Day Browser Cache, 1-Year CDN Cache)
/images/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000, immutable

# 3. Favicon Assets (7-Day Browser Cache, 30-Day CDN Cache)
/favicon.ico
  Cache-Control: public, max-age=604800, s-maxage=2592000

/favicon.svg
  Cache-Control: public, max-age=604800, s-maxage=2592000
