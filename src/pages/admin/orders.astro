  // 3. Ship modal
  const shipModal = document.getElementById('ship-modal');
  const shipForm = document.getElementById('ship-form');
  const shipErrorEl = document.getElementById('ship-error');
  const closeShipModal = document.getElementById('close-ship-modal');
  const cancelShipBtn = document.getElementById('cancel-ship-btn');

  const shipCarrierSelect = document.getElementById('ship-carrier-select') as HTMLSelectElement | null;
  const shipTrackingInput = document.getElementById('ship-tracking-number') as HTMLInputElement | null;
  const shipTrackingPreview = document.getElementById('carrier-tracking-preview');

  function updateShipTrackingPreview() {
    if (!shipTrackingPreview) return;
    const trackingNo = shipTrackingInput?.value?.trim();
    if (!trackingNo) {
      shipTrackingPreview.textContent = '';
      return;
    }
    const selectedOpt = shipCarrierSelect?.options[shipCarrierSelect.selectedIndex];
    const urlTpl = selectedOpt?.getAttribute('data-url-template') || '';
    const carrierName = shipCarrierSelect?.value || '';
    const resolved = resolveTrackingUrl(carrierName, trackingNo, urlTpl);
    shipTrackingPreview.innerHTML = `Track URL: <a href="${escapeHtml(resolved)}" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold">${escapeHtml(resolved)} ↗</a>`;
  }

  shipCarrierSelect?.addEventListener('change', updateShipTrackingPreview);
  shipTrackingInput?.addEventListener('input', updateShipTrackingPreview);

  const hideShipModal = () => {
    clearError(shipErrorEl);
    if (shipTrackingPreview) shipTrackingPreview.textContent = '';
    (shipModal as HTMLDialogElement)?.close();
  };
  closeShipModal?.addEventListener('click', hideShipModal);
  cancelShipBtn?.addEventListener('click', hideShipModal);

  shipForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const orderId = document.getElementById('ship-order-id')?.value;
    if (!orderId) return;

    clearError(shipErrorEl);
    const formData = new FormData(shipForm);
    const carrier = formData.get('carrier')?.toString();
    const trackingNumber = formData.get('tracking_number')?.toString();
    const adminRemark = formData.get('admin_remark')?.toString();

    const submitBtn = document.getElementById('confirm-ship-btn');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'ship',
          carrier,
          trackingNumber,
          adminRemark,
        }),
      });

      if (res.ok) {
        hideShipModal();
        (window as any).__showToast?.('Shipment dispatched & tracking updated', 'success');
        await clientCache.invalidatePrefix('admin:orders');
        await clientCache.invalidatePrefix('buyer:orders');
        fetchOrders(false);
      } else {
        const data = await res.json();
        showError(shipErrorEl, data.error || 'Failed to dispatch shipment');
