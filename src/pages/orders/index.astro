---
// src/pages/orders/index.astro
import Layout from '@layouts/Layout.astro';
import BuyerLayout from '@layouts/BuyerLayout.astro';
import { getBuyerContext } from '@utils/auth';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@i18n';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { sessionUser, dbUser, systemSettings, redirectResponse } = await getBuyerContext(Astro, cfEnv);
if (redirectResponse) return redirectResponse;

const initialStatus = Astro.url.searchParams.get('status') || 'ALL';
const initialSearch = (Astro.url.searchParams.get('search') || '').trim();
const initialView = Astro.url.searchParams.get('view') || 'my';

const printSheetTitle = systemSettings?.print_sheet_title || 'OFFICIAL B2B PROCUREMENT REQUISITION';
const printSheetFooter = systemSettings?.print_sheet_footer || 'B2B Sample & Procurement Requisition Sheet';

const pageTitle = t('orders.metaTitle');
const pageDesc = t('orders.metaDesc');

const i18nClient = {
  myOrders: t('orders.myOrders'),
  allPlatformOrders: t('orders.allPlatformOrders'),
  totalOrders: t('orders.totalOrders'),
  autoClaimActive: t('orders.autoClaimActive'),
  claimedSuccess: t('orders.claimedSuccess'),
  tabAll: t('orders.tabAll'),
  tabPending: t('orders.tabPending'),
  tabApproved: t('orders.tabApproved'),
  tabShipped: t('orders.tabShipped'),
  tabRejected: t('orders.tabRejected'),
  searchPlaceholder: t('orders.searchPlaceholder'),
  noMatching: t('orders.noMatching'),
  noMatchingDesc: t('orders.noMatchingDesc'),
  noOrders: t('orders.noOrders'),
  noOrdersDesc: t('orders.noOrdersDesc'),
  clearFilters: t('orders.clearFilters'),
  exploreStyles: t('orders.exploreStyles'),
  copy: t('orders.copy'),
  submitted: t('orders.submitted'),
  statusPending: t('orders.statusPending'),
  statusApproved: t('orders.statusApproved'),
  statusShipped: t('orders.statusShipped'),
  statusRejected: t('orders.statusRejected'),
  carrierTracking: t('orders.carrierTracking'),
  shippedAt: t('orders.shippedAt'),
  carrier: t('orders.carrier'),
  trackingNo: t('orders.trackingNo'),
  copyTracking: t('orders.copyTracking'),
  note: t('orders.note'),
  rejectionReason: t('orders.rejectionReason') || 'Order Inquiry Closed',
  destination: t('orders.destination'),
  worldwide: t('orders.worldwide'),
  totalQuantity: t('orders.totalQuantity'),
  pcs: t('orders.pcs'),
  standardSpec: t('orders.standardSpec'),
  recently: t('orders.recently'),
  stepSubmitted: t('orders.stepSubmitted'),
  stepInReview: t('orders.stepInReview'),
  stepApproved: t('orders.stepApproved'),
  stepDispatched: t('orders.stepDispatched'),
  stepDelivered: t('orders.stepDelivered'),
  actionReorder: t('orders.actionReorder'),
  actionPrint: t('orders.actionPrint'),
  actionTrack: t('orders.actionTrack'),
};
---

{sessionUser ? (
  <BuyerLayout
    title={pageTitle}
    description={pageDesc}
    currentTab="orders"
    sessionUser={sessionUser}
    dbUser={dbUser}
    systemSettings={systemSettings}
  >
    <div class="space-y-6">
      
      <!-- Admin View Mode Switcher / Buyer Meta Banner -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        {sessionUser.isAdmin ? (
          <div class="flex items-center gap-1.5 p-1 bg-white rounded-xl border border-black/5 shadow-2xs self-start sm:self-auto">
            <button
              type="button"
              id="view-my-btn"
              data-view="my"
              class={`px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer ${
                initialView !== 'all'
                  ? 'bg-[#1d1d1f] text-white shadow-xs'
                  : 'text-[#86868b] hover:text-black'
              }`}
            >
              <span>{t('orders.myOrders')}</span>
              <span id="my-count-badge" class="ml-1 font-mono text-[11px] tabular-nums"></span>
            </button>
            <button
              type="button"
              id="view-all-btn"
              data-view="all"
              class={`px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer ${
                initialView === 'all'
                  ? 'bg-[#1d1d1f] text-white shadow-xs'
                  : 'text-[#86868b] hover:text-black'
              }`}
            >
              <span>{t('orders.allPlatformOrders')}</span>
              <span id="all-count-badge" class="ml-1 font-mono text-[11px] tabular-nums"></span>
            </button>
          </div>
        ) : (
          <div class="flex items-center gap-2 text-[#86868b]">
            <span>{t('orders.totalOrders')}: <strong id="orders-total-count" class="text-[#1d1d1f] font-mono tabular-nums">...</strong></span>
            <span>·</span>
            <span class="text-emerald-700 font-medium">{t('orders.autoClaimActive')}</span>
          </div>
        )}
      </div>

      <!-- Auto-Claim Notification Banner if claimed -->
      <div id="auto-claim-banner" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl p-3 flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>{t('orders.claimedSuccess')}</span>
      </div>

      <!-- Filter & Search Bar: Sticky under mobile 56px topbar (top-14) and desktop top (lg:top-0) -->
      <div class="sticky top-14 lg:top-0 z-20 py-2.5 -my-2.5 bg-[#f5f5f7]/95 backdrop-blur-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <!-- Status Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none" id="status-tabs-container">
          {[
            { key: 'ALL', label: t('orders.tabAll') },
            { key: 'PENDING_APPROVAL', label: t('orders.tabPending') },
            { key: 'APPROVED', label: t('orders.tabApproved') },
            { key: 'SHIPPED', label: t('orders.tabShipped') },
            { key: 'REJECTED', label: t('orders.tabRejected') },
          ].map((tab) => {
            const isActive = initialStatus === tab.key;
            return (
              <button
                type="button"
                data-status-tab={tab.key}
                class={`status-tab-btn px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border cursor-pointer ${
                  isActive
                    ? 'bg-[#1d1d1f] text-white border-black shadow-xs'
                    : 'bg-white text-[#52525b] border-black/5 hover:border-black/20 hover:text-black'
                }`}
              >
                <span>{tab.label}</span>
                <span class={`tab-count ml-1 font-mono text-[11px] tabular-nums ${isActive ? 'text-white/80' : 'text-[#86868b]'}`} data-status-count={tab.key}>
                  (-)
                </span>
              </button>
            );
          })}
        </div>

        <!-- Search Input -->
        <div class="relative sm:w-64">
          <input
            type="text"
            id="orders-search-input"
            value={initialSearch}
            placeholder={t('orders.searchPlaceholder')}
            class="w-full pl-8 pr-7 py-1.5 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs"
          />
          <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            type="button"
            id="clear-search-btn"
            class={`absolute right-2.5 top-2 text-xs text-[#86868b] hover:text-black cursor-pointer ${initialSearch ? '' : 'hidden'}`}
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Skeleton Placeholder (0-CLS Shimmer) -->
      <div id="orders-skeleton" class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,32rem),1fr))] gap-[clamp(1rem,0.5rem+1vw,1.5rem)] items-start">
        {[1, 2, 3, 4].map(() => (
          <div class="bg-white rounded-2xl border border-black/5 p-5 space-y-4 shadow-sm animate-pulse">
            <div class="flex items-center justify-between pb-3.5 border-b border-black/5">
              <div class="space-y-1.5">
                <div class="h-4 w-32 bg-black/10 rounded-md"></div>
                <div class="h-3 w-24 bg-black/5 rounded-md"></div>
              </div>
              <div class="h-6 w-20 bg-black/10 rounded-full"></div>
            </div>
            <div class="h-14 bg-black/5 rounded-xl"></div>
            <div class="space-y-2.5 py-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-black/10 rounded-lg shrink-0"></div>
                  <div class="space-y-1">
                    <div class="h-3.5 w-36 bg-black/10 rounded-md"></div>
                    <div class="h-2.5 w-24 bg-black/5 rounded-md"></div>
                  </div>
                </div>
                <div class="h-3.5 w-12 bg-black/10 rounded-md"></div>
              </div>
            </div>
            <div class="pt-3 border-t border-black/5 flex items-center justify-between">
              <div class="h-3 w-28 bg-black/5 rounded-md"></div>
              <div class="flex gap-2">
                <div class="h-7 w-20 bg-black/10 rounded-xl"></div>
                <div class="h-7 w-16 bg-black/5 rounded-xl"></div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State Container -->
      <div id="orders-empty" class="hidden bg-white rounded-2xl border border-black/5 p-12 text-center shadow-sm">
        <div class="w-12 h-12 mx-auto rounded-full bg-[#f5f5f7] flex items-center justify-center text-[#86868b] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 id="empty-title" class="text-base font-semibold mb-1">
          {t('orders.noOrders')}
        </h3>
        <p id="empty-desc" class="text-xs text-[#86868b] max-w-sm mx-auto mb-5">
          {t('orders.noOrdersDesc')}
        </p>
        <div id="empty-action-container">
          <button
            type="button"
            id="empty-clear-btn"
            class="hidden inline-flex items-center px-4 py-2 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all cursor-pointer"
          >
            {t('orders.clearFilters')}
          </button>
          <a
            id="empty-explore-btn"
            href={getLocalizedPath('/products', currentLang)}
            class="inline-flex items-center px-5 py-2 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all"
          >
            {t('orders.exploreStyles')}
          </a>
        </div>
      </div>

      <!-- Orders List Container -->
      <div id="orders-grid" class="hidden grid grid-cols-[repeat(auto-fit,minmax(min(100%,32rem),1fr))] gap-[clamp(1rem,0.5rem+1vw,1.5rem)] items-start"></div>

    </div>
  </BuyerLayout>
) : (
  <Layout title={pageTitle} description={pageDesc}>
    <main class="min-h-screen bg-[#f5f5f7] pt-24 pb-20 text-[#1d1d1f]">
      <div class="max-w-[90rem] mx-auto px-[clamp(1rem,0.4rem+2.5vw,3rem)]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-black/5 gap-4">
          <div>
            <nav class="flex items-center gap-2 text-xs text-[#86868b] mb-1">
              <a href={getLocalizedPath('/', currentLang)} class="hover:text-black transition-colors">{t('nav.home')}</a>
              <span>/</span>
              <span class="text-[#1d1d1f] font-medium">{t('orders.breadcrumb')}</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
              {t('orders.title')}
            </h1>
          </div>
        </div>

        <div class="mt-12 bg-white rounded-2xl border border-black/5 p-8 sm:p-12 text-center max-w-xl mx-auto shadow-sm">
          <div class="w-16 h-16 mx-auto rounded-full bg-[#f5f5f7] flex items-center justify-center text-[#1d1d1f] mb-4">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold mb-2">{t('orders.unauthHeading')}</h2>
          <p class="text-sm text-[#86868b] max-w-md mx-auto mb-6 leading-relaxed">
            {t('orders.unauthDesc')}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href={`/api/auth/login?returnUrl=${encodeURIComponent(Astro.url.pathname)}`}
              id="orders-signin-btn"
              class="w-full sm:w-auto px-6 py-2.5 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm cursor-pointer text-center inline-flex items-center justify-center gap-1.5"
            >
              {t('orders.signInBtn')}
            </a>
            <a
              href={getLocalizedPath('/products', currentLang)}
              class="w-full sm:w-auto px-6 py-2.5 rounded-full text-xs font-medium text-[#1d1d1f] bg-[#f5f5f7] hover:bg-black/10 transition-all text-center"
            >
              {t('orders.browseCollections')}
            </a>
          </div>
        </div>
      </div>
    </main>
  </Layout>
)}

<script id="orders-app-data" type="application/json" set:html={JSON.stringify({
  i18n: i18nClient,
  lang: currentLang,
  isAdmin: !!sessionUser?.isAdmin,
  printSheetTitle,
  printSheetFooter,
})} />

<style>
  @media print {
    body {
      background: white !important;
    }
    header, nav, footer, #apple-nav, #apple-footer, .print\:hidden, .order-actions {
      display: none !important;
    }
    main {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    .order-card-container {
      border: 1px solid #d4d4d8 !important;
      box-shadow: none !important;
      break-inside: avoid;
      page-break-inside: avoid;
      margin-bottom: 2rem !important;
      width: 100% !important;
    }
  }
</style>

<script>
  import { clientCache } from '@utils/clientCache';

  (function () {
    const dataEl = document.getElementById('orders-app-data');
    if (!dataEl) return;

    let appData = {};
    try {
      appData = JSON.parse(dataEl.textContent || '{}');
    } catch (e) {
      console.error('Failed to parse app data', e);
    }

    const i18n = appData.i18n || {};
    const currentLang = appData.lang || 'en';
    const isAdmin = !!appData.isAdmin;
    const printSheetTitle = appData.printSheetTitle || 'OFFICIAL B2B PROCUREMENT REQUISITION';
    const printSheetFooter = appData.printSheetFooter || 'B2B Sample & Procurement Requisition Sheet';

    // State
    let ordersList = [];
    let stats = { all: 0, pending: 0, approved: 0, shipped: 0, rejected: 0 };
    let currentStatus = getParam('status') || 'ALL';
    let currentSearch = (getParam('search') || '').trim();
    let currentView = getParam('view') || 'my';

    // DOM Elements
    const skeletonEl = document.getElementById('orders-skeleton');
    const gridEl = document.getElementById('orders-grid');
    const emptyEl = document.getElementById('orders-empty');
    const emptyTitleEl = document.getElementById('empty-title');
    const emptyDescEl = document.getElementById('empty-desc');
    const emptyClearBtn = document.getElementById('empty-clear-btn');
    const emptyExploreBtn = document.getElementById('empty-explore-btn');
    const searchInput = document.getElementById('orders-search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const claimBanner = document.getElementById('auto-claim-banner');
    const totalCountEl = document.getElementById('orders-total-count');
    const myCountBadge = document.getElementById('my-count-badge');
    const allCountBadge = document.getElementById('all-count-badge');
    const viewMyBtn = document.getElementById('view-my-btn');
    const viewAllBtn = document.getElementById('view-all-btn');

    function getParam(key) {
      const urlParams = new URLSearchParams(window.location.search);
      return urlParams.get(key);
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatLocalTime(datetime) {
      if (!datetime) return '';
      const d = new Date(datetime);
      if (isNaN(d.getTime())) return String(datetime);
      return d.toLocaleString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }

    function updateUrlState() {
      const params = new URLSearchParams();
      if (currentStatus && currentStatus !== 'ALL') {
        params.set('status', currentStatus);
      }
      if (currentSearch) {
        params.set('search', currentSearch);
      }
      if (isAdmin && currentView === 'all') {
        params.set('view', 'all');
      }
      const newQuery = params.toString();
      const newUrl = window.location.pathname + (newQuery ? '?' + newQuery : '');
      window.history.pushState({}, '', newUrl);
    }

    function updateTabCounts() {
      const countMap = {
        ALL: stats.all,
        PENDING_APPROVAL: stats.pending,
        APPROVED: stats.approved,
        SHIPPED: stats.shipped,
        REJECTED: stats.rejected,
      };

      document.querySelectorAll('.status-tab-btn').forEach((btn) => {
        const statusKey = btn.getAttribute('data-status-tab');
        const countSpan = btn.querySelector('.tab-count');
        const count = countMap[statusKey] !== undefined ? countMap[statusKey] : 0;
        if (countSpan) {
          countSpan.textContent = `(${count})`;
        }

        const isActive = statusKey === currentStatus;
        if (isActive) {
          btn.className = 'status-tab-btn px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border cursor-pointer bg-[#1d1d1f] text-white border-black shadow-xs';
          if (countSpan) countSpan.className = 'tab-count ml-1 font-mono text-[11px] tabular-nums text-white/80';
        } else {
          btn.className = 'status-tab-btn px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border cursor-pointer bg-white text-[#52525b] border-black/5 hover:border-black/20 hover:text-black';
          if (countSpan) countSpan.className = 'tab-count ml-1 font-mono text-[11px] tabular-nums text-[#86868b]';
        }
      });
    }

    function renderOrderStepper(order) {
      const status = order.status;
      const isApproved = status === 'APPROVED';
      const isShipped = status === 'SHIPPED';
      const isRejected = status === 'REJECTED';
      const adminRemark = order.admin_remark;

      if (isRejected) {
        return `
          <div class="bg-rose-50 border border-rose-200 rounded-xl p-3 flex items-center gap-2.5 text-xs text-rose-800">
            <svg class="w-4 h-4 shrink-0 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <span class="font-semibold">${escapeHtml(i18n.rejectionReason || 'Order Inquiry Closed')}</span>
              ${adminRemark ? `<span class="ml-1 text-rose-700">· ${escapeHtml(adminRemark)}</span>` : ''}
            </div>
          </div>
        `;
      }

      const progressWidth = isShipped ? '66.67%' : (isApproved ? '33.33%' : '0%');
      const step2Done = isApproved || isShipped;

      return `
        <div class="py-2.5 px-3 bg-[#fbfbfd] rounded-xl border border-black/5">
          <div class="relative flex items-center justify-between">
            <div class="absolute left-6 right-6 top-1/2 -translate-y-1/2 h-0.5 bg-black/10 -z-0">
              <div class="h-full bg-emerald-500 transition-all duration-300" style="width: ${progressWidth};"></div>
            </div>

            <div class="relative z-10 flex flex-col items-center">
              <div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold shadow-2xs">✓</div>
              <span class="text-[10px] font-medium text-[#1d1d1f] mt-1.5 whitespace-nowrap">${escapeHtml(i18n.stepSubmitted || 'Submitted')}</span>
            </div>

            <div class="relative z-10 flex flex-col items-center">
              <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold shadow-2xs transition-all ${
                step2Done ? 'bg-emerald-500 text-white' : 'bg-amber-400 text-white ring-4 ring-amber-100 animate-pulse'
              }">
                ${step2Done ? '✓' : '2'}
              </div>
              <span class="text-[10px] mt-1.5 whitespace-nowrap ${
                step2Done ? 'font-medium text-[#1d1d1f]' : 'font-semibold text-amber-700'
              }">
                ${escapeHtml(step2Done ? (i18n.stepApproved || 'Approved') : (i18n.stepInReview || 'In Review'))}
              </span>
            </div>

            <div class="relative z-10 flex flex-col items-center">
              <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold shadow-2xs transition-all ${
                isShipped ? 'bg-emerald-500 text-white ring-4 ring-emerald-100' : 'bg-white border-2 border-black/20 text-[#86868b]'
              }">
                ${isShipped ? '✓' : '3'}
              </div>
              <span class="text-[10px] mt-1.5 whitespace-nowrap ${
                isShipped ? 'font-semibold text-emerald-700' : 'text-[#86868b]'
              }">
                ${escapeHtml(i18n.stepDispatched || 'Dispatched')}
              </span>
            </div>

            <div class="relative z-10 flex flex-col items-center">
              <div class="w-6 h-6 rounded-full bg-white border-2 border-black/20 text-[#86868b] flex items-center justify-center text-[10px] font-bold shadow-2xs">4</div>
              <span class="text-[10px] text-[#86868b] mt-1.5 whitespace-nowrap">${escapeHtml(i18n.stepDelivered || 'Delivered')}</span>
            </div>
          </div>
        </div>
      `;
    }

    function renderStatusBadge(status) {
      if (status === 'PENDING_APPROVAL') {
        return `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            ${escapeHtml(i18n.statusPending || 'Pending Approval')}
          </span>
        `;
      }
      if (status === 'APPROVED') {
        return `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800 border border-blue-200">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            ${escapeHtml(i18n.statusApproved || 'Approved')}
          </span>
        `;
      }
      if (status === 'SHIPPED') {
        return `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            ${escapeHtml(i18n.statusShipped || 'Shipped')}
          </span>
        `;
      }
      if (status === 'REJECTED') {
        return `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
            <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
            ${escapeHtml(i18n.statusRejected || 'Rejected')}
          </span>
        `;
      }
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">${escapeHtml(status)}</span>`;
    }

    function renderOrderCard(order) {
      const isShipped = order.status === 'SHIPPED';
      const items = order.items || [];
      const safeOrderNo = escapeHtml(order.order_no);
      const safeTracking = escapeHtml(order.tracking_number || '');
      const safeCarrier = escapeHtml(order.carrier || 'Standard Express');
      const safeCompany = escapeHtml(order.company_name || order.buyer_email || '');
      const safeContact = escapeHtml(order.contact_name || order.buyer_email || '');
      const safeDestination = escapeHtml(order.destination_country || i18n.worldwide || 'Worldwide');
      const safeNotes = escapeHtml(order.customer_notes || '');

      const itemsHtml = items.map((item) => {
        const itemTitle = escapeHtml(item.title);
        const itemSku = escapeHtml(item.sku || '');
        const itemVariant = escapeHtml(item.variant || i18n.standardSpec || 'Standard Spec');
        const itemQty = Number(item.quantity || 1);
        const itemImg = escapeHtml(item.resolved_image || '/images/hero-light.webp');
        const itemUrl = item.product_url ? escapeHtml(item.product_url) : null;

        return `
          <div
            class="order-item-row py-2.5 flex items-center justify-between text-xs gap-3"
            data-product-id="${escapeHtml(item.product_id || '')}"
            data-sku="${itemSku}"
            data-title="${itemTitle}"
            data-variant="${itemVariant}"
            data-quantity="${itemQty}"
            data-image="${itemImg}"
          >
            <div class="flex items-center gap-3 min-w-0">
              ${itemUrl ? `
                <a href="${itemUrl}" target="_blank" rel="noopener noreferrer" class="shrink-0 group block" title="View ${itemTitle}">
                  <img src="${itemImg}" alt="${itemTitle}" class="w-10 h-10 rounded-lg object-cover bg-[#f5f5f7] border border-black/5 group-hover:border-black/30 transition-all shrink-0" loading="lazy" />
                </a>
              ` : `
                <img src="${itemImg}" alt="${itemTitle}" class="w-10 h-10 rounded-lg object-cover bg-[#f5f5f7] border border-black/5 shrink-0" loading="lazy" />
              `}
              <div class="min-w-0">
                ${itemUrl ? `
                  <a href="${itemUrl}" target="_blank" rel="noopener noreferrer" class="font-medium text-[#1d1d1f] hover:text-black hover:underline truncate block inline-flex items-center gap-1 group">
                    <span class="truncate">${itemTitle}</span>
                    <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity shrink-0 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ` : `
                  <p class="font-medium text-[#1d1d1f] truncate">${itemTitle}</p>
                `}
                <p class="text-[11px] text-[#86868b] truncate font-mono">
                  ${itemSku ? `${itemSku} · ` : ''}${itemVariant}
                </p>
              </div>
            </div>
            <div class="font-mono tabular-nums font-semibold text-right shrink-0">
              ${itemQty} ${escapeHtml(i18n.pcs || 'pcs')}
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.5rem)] space-y-4 shadow-sm transition-all hover:shadow-md order-card-container">
          
          <!-- Print Sheet Header -->
          <div class="hidden print:block border-b border-black/20 pb-4 mb-4">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold font-mono tracking-tight text-[#1d1d1f]">${escapeHtml(printSheetTitle)}</h2>
                <p class="text-[10px] text-zinc-500 font-sans">${escapeHtml(printSheetFooter)} · ${escapeHtml(window.location.hostname)}</p>
              </div>
              <div class="text-right text-[11px] font-mono text-zinc-600">
                <p class="font-bold text-[#1d1d1f]">${safeOrderNo}</p>
                <p>Date: ${formatLocalTime(order.created_at)}</p>
              </div>
            </div>
            <div class="mt-3 pt-2 border-t border-black/10 grid grid-cols-2 text-xs">
              <div>
                <p class="text-[11px] text-zinc-500">Buyer Company: <strong class="text-[#1d1d1f] font-sans">${safeCompany}</strong></p>
                <p class="text-[11px] text-zinc-500">Contact / Email: <strong class="text-[#1d1d1f] font-sans">${safeContact}</strong></p>
              </div>
              <div class="text-right">
                <p class="text-[11px] text-zinc-500">Destination: <strong class="text-[#1d1d1f] font-sans">${safeDestination}</strong></p>
                <p class="text-[11px] text-zinc-500">Total Quantity: <strong class="text-[#1d1d1f] font-mono">${order.total_quantity || 0} ${escapeHtml(i18n.pcs || 'pcs')}</strong></p>
              </div>
            </div>
          </div>

          <!-- Order Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3.5 border-b border-black/5 text-xs">
            <div>
              <div class="flex items-center gap-2.5">
                <span class="font-mono font-semibold text-sm tracking-tight text-[#1d1d1f]">${safeOrderNo}</span>
                <button
                  type="button"
                  class="copy-btn text-[#86868b] hover:text-black transition-colors cursor-pointer"
                  data-copy="${safeOrderNo}"
                  title="${escapeHtml(i18n.copy || 'Copy')}"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>
              <p class="text-[#86868b] text-[11px] font-mono mt-0.5">
                ${escapeHtml(i18n.submitted || 'Submitted')}: ${formatLocalTime(order.created_at)}
              </p>
            </div>
            <div>${renderStatusBadge(order.status)}</div>
          </div>

          <!-- Progress Stepper -->
          ${renderOrderStepper(order)}

          <!-- Shipping Logistics (if Shipped) -->
          ${isShipped ? `
            <div class="bg-[#f5f5f7] rounded-xl p-3.5 border border-black/5 text-xs space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-[#1d1d1f]">${escapeHtml(i18n.carrierTracking || 'Carrier & Tracking Information')}:</span>
                <span class="text-[#86868b] font-mono text-[11px]">
                  ${escapeHtml(i18n.shippedAt || 'Shipped at')}: ${order.shipped_at ? formatLocalTime(order.shipped_at) : escapeHtml(i18n.recently || 'Recently')}
                </span>
              </div>
              <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
                <div class="flex items-center gap-4">
                  <div>
                    <span class="text-[#86868b]">${escapeHtml(i18n.carrier || 'Carrier')}:</span>
                    <strong class="text-[#1d1d1f]">${safeCarrier}</strong>
                  </div>
                  ${order.tracking_number ? `
                    <div class="flex items-center gap-1.5">
                      <span class="text-[#86868b]">${escapeHtml(i18n.trackingNo || 'Tracking No')}:</span>
                      <span class="font-mono font-semibold text-[#1d1d1f]">${safeTracking}</span>
                      <button
                        type="button"
                        class="copy-btn text-[#86868b] hover:text-black transition-colors cursor-pointer"
                        data-copy="${safeTracking}"
                        title="${escapeHtml(i18n.copyTracking || 'Copy Tracking Number')}"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                  ` : ''}
                </div>
                ${order.tracking_number ? `
                  <a
                    href="https://t.17track.net/en#nums=${encodeURIComponent(order.tracking_number)}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-blue-600 hover:text-blue-800 hover:underline print:hidden"
                  >
                    <span>Track on 17TRACK</span>
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ` : ''}
              </div>
              ${order.admin_remark ? `
                <p class="text-[11px] text-[#52525b] border-t border-black/5 pt-1 mt-1">
                  ${escapeHtml(i18n.note || 'Note')}: ${escapeHtml(order.admin_remark)}
                </p>
              ` : ''}
            </div>
          ` : ''}

          <!-- Items Table -->
          <div class="divide-y divide-black/5">
            ${itemsHtml || `<div class="py-2 text-center text-[11px] text-[#86868b]">No item details recorded.</div>`}
          </div>

          <!-- Footer Summary & Actions -->
          <div class="pt-3.5 border-t border-black/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-3 text-[11px] text-[#86868b] flex-wrap">
              <span>${escapeHtml(i18n.destination || 'Destination')}: <strong class="text-[#1d1d1f]">${safeDestination}</strong></span>
              <span>·</span>
              <span>${escapeHtml(i18n.totalQuantity || 'Total Quantity')}: <strong class="text-[#1d1d1f] font-mono tabular-nums">${order.total_quantity || 0} ${escapeHtml(i18n.pcs || 'pcs')}</strong></span>
              ${safeNotes ? `
                <span>·</span>
                <span class="truncate max-w-[200px] text-zinc-500 italic" title="${safeNotes}">"${safeNotes}"</span>
              ` : ''}
            </div>

            <!-- Actions: Reorder, Print, Track -->
            <div class="flex items-center gap-2 flex-wrap order-actions print:hidden shrink-0">
              ${isShipped && order.tracking_number ? `
                <a
                  href="https://t.17track.net/en#nums=${encodeURIComponent(order.tracking_number)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 transition-all shadow-2xs"
                >
                  <span>${escapeHtml(i18n.actionTrack || 'Track Parcel')}</span>
                  <svg class="w-3 h-3 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ` : ''}

              <button
                type="button"
                class="reorder-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs cursor-pointer active:scale-95"
              >
                <span>${escapeHtml(i18n.actionReorder || '↻ Reorder Items')}</span>
              </button>

              <button
                type="button"
                class="print-order-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] bg-white hover:bg-[#f5f5f7] border border-black/10 transition-all shadow-2xs cursor-pointer active:scale-95"
              >
                <span>${escapeHtml(i18n.actionPrint || '🖨️ Print Sheet')}</span>
              </button>
            </div>
          </div>

          <!-- Print Sign-off Line -->
          <div class="hidden print:flex items-center justify-between pt-8 text-xs text-zinc-600 border-t border-black/15 mt-6 font-mono">
            <div>Authorized Signature: _______________________</div>
            <div>Date: _______________________</div>
          </div>

        </div>
      `;
    }

    function applyFilter() {
      if (!gridEl || !emptyEl) return;

      const q = currentSearch.toLowerCase();
      const filtered = ordersList.filter((o) => {
        // Status filter
        if (currentStatus !== 'ALL' && o.status !== currentStatus) {
          return false;
        }
        // Search filter
        if (q) {
          const matchNo = (o.order_no || '').toLowerCase().includes(q);
          const matchEmail = (o.buyer_email || '').toLowerCase().includes(q);
          const matchCompany = (o.company_name || '').toLowerCase().includes(q);
          const matchCountry = (o.destination_country || '').toLowerCase().includes(q);
          const matchNotes = (o.customer_notes || '').toLowerCase().includes(q);
          const matchItems = (o.items || []).some((item) =>
            (item.title || '').toLowerCase().includes(q) || (item.sku || '').toLowerCase().includes(q)
          );
          if (!matchNo && !matchEmail && !matchCompany && !matchCountry && !matchNotes && !matchItems) {
            return false;
          }
        }
        return true;
      });

      if (filtered.length === 0) {
        gridEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');

        const isFiltered = currentSearch || currentStatus !== 'ALL';
        if (emptyTitleEl) emptyTitleEl.textContent = isFiltered ? (i18n.noMatching || 'No Matching Orders') : (i18n.noOrders || 'No Orders Found');
        if (emptyDescEl) emptyDescEl.textContent = isFiltered ? (i18n.noMatchingDesc || 'Try clearing your filters or search keywords.') : (i18n.noOrdersDesc || "You haven't submitted any RFQ or procurement orders with this account yet.");
        
        if (emptyClearBtn) {
          if (isFiltered) {
            emptyClearBtn.classList.remove('hidden');
          } else {
            emptyClearBtn.classList.add('hidden');
          }
        }
        if (emptyExploreBtn) {
          if (isFiltered) {
            emptyExploreBtn.classList.add('hidden');
          } else {
            emptyExploreBtn.classList.remove('hidden');
          }
        }
      } else {
        emptyEl.classList.add('hidden');
        gridEl.innerHTML = filtered.map(renderOrderCard).join('');
        gridEl.classList.remove('hidden');
        bindCardEvents();
      }
    }

    function bindCardEvents() {
      // Copy buttons
      gridEl.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span style="color:#10b981;font-size:10px;">✓</span>';
            setTimeout(() => {
              btn.innerHTML = originalHtml;
            }, 1500);
          } catch (err) {
            // ignore
          }
        });
      });

      // Reorder buttons
      gridEl.querySelectorAll('.reorder-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            const card = btn.closest('.order-card-container');
            if (!card) return;
            const itemRows = card.querySelectorAll('.order-item-row');
            if (!itemRows.length) return;

            itemRows.forEach((row) => {
              if (window.addToQuote) {
                window.addToQuote({
                  id: row.dataset.productId || row.dataset.sku || 'reorder-item',
                  title: row.dataset.title || 'Reorder Item',
                  sku: row.dataset.sku || '',
                  imageUrl: row.dataset.image || '',
                  variant: row.dataset.variant || 'Standard Spec',
                  quantity: parseInt(row.dataset.quantity || '1', 10) || 1,
                });
              }
            });

            if (window.openQuoteDrawer) {
              window.openQuoteDrawer();
            }
          } catch (e) {
            console.warn('Reorder failed:', e);
          }
        });
      });

      // Print order sheet
      gridEl.querySelectorAll('.print-order-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.order-card-container');
          const allCards = document.querySelectorAll('.order-card-container');
          if (card) {
            allCards.forEach((c) => {
              if (c !== card) c.classList.add('print:hidden');
            });
          }
          window.print();
          if (card) {
            allCards.forEach((c) => c.classList.remove('print:hidden'));
          }
        });
      });
    }

    async function loadOrders() {
      const cacheKey = `buyer:orders:${currentView}:${currentLang}`;
      const query = new URLSearchParams();
      if (isAdmin && currentView === 'all') {
        query.set('view', 'all');
      }
      query.set('lang', currentLang);

      try {
        await clientCache.fetchWithCache(
          cacheKey,
          `/api/orders?${query.toString()}`,
          {
            mode: 'swr',
            onData: (data: any) => {
              if (!data?.success) return;
              ordersList = data.orders || [];
              stats = data.stats || {
                all: ordersList.length,
                pending: ordersList.filter((o: any) => o.status === 'PENDING_APPROVAL').length,
                approved: ordersList.filter((o: any) => o.status === 'APPROVED').length,
                shipped: ordersList.filter((o: any) => o.status === 'SHIPPED').length,
                rejected: ordersList.filter((o: any) => o.status === 'REJECTED').length,
              };

              if (totalCountEl) totalCountEl.textContent = stats.all;
              if (myCountBadge && data.counts?.my !== undefined) myCountBadge.textContent = `(${data.counts.my})`;
              if (allCountBadge && data.counts?.all !== undefined) allCountBadge.textContent = `(${data.counts.all})`;

              if (claimBanner && data.claimedCount > 0) {
                claimBanner.classList.remove('hidden');
              }

              updateTabCounts();
              if (skeletonEl) skeletonEl.classList.add('hidden');
              applyFilter();
            },
          }
        );
      } catch (err) {
        console.error('Error fetching orders:', err);
        if (skeletonEl) skeletonEl.classList.add('hidden');
        if (emptyEl) {
          emptyEl.classList.remove('hidden');
          if (emptyTitleEl) emptyTitleEl.textContent = 'Unable to Load Orders';
          if (emptyDescEl) emptyDescEl.textContent = 'Please check your connection and refresh the page.';
        }
      }
    }

    // Event Listeners: Tabs
    document.querySelectorAll('.status-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const status = btn.getAttribute('data-status-tab');
        if (!status) return;
        currentStatus = status;
        updateTabCounts();
        updateUrlState();
        applyFilter();
      });
    });

    // Event Listeners: Search
    let searchDebounceTimer = null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearch = searchInput.value.trim();
        if (clearSearchBtn) {
          if (currentSearch) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          updateUrlState();
          applyFilter();
        }, 150);
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearch = '';
        clearSearchBtn.classList.add('hidden');
        updateUrlState();
        applyFilter();
      });
    }

    if (emptyClearBtn) {
      emptyClearBtn.addEventListener('click', () => {
        currentStatus = 'ALL';
        currentSearch = '';
        if (searchInput) searchInput.value = '';
        if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
        updateTabCounts();
        updateUrlState();
        applyFilter();
      });
    }

    // Event Listeners: Admin View Switcher
    if (viewMyBtn) {
      viewMyBtn.addEventListener('click', () => {
        if (currentView === 'my') return;
        currentView = 'my';
        viewMyBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-[#1d1d1f] text-white shadow-xs';
        if (viewAllBtn) viewAllBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#86868b] hover:text-black';
        updateUrlState();
        loadOrders();
      });
    }

    if (viewAllBtn) {
      viewAllBtn.addEventListener('click', () => {
        if (currentView === 'all') return;
        currentView = 'all';
        viewAllBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-[#1d1d1f] text-white shadow-xs';
        if (viewMyBtn) viewMyBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#86868b] hover:text-black';
        updateUrlState();
        loadOrders();
      });
    }

    // History popstate
    window.addEventListener('popstate', () => {
      const prevView = currentView;
      currentStatus = getParam('status') || 'ALL';
      currentSearch = (getParam('search') || '').trim();
      currentView = getParam('view') || 'my';
      if (searchInput) searchInput.value = currentSearch;
      if (clearSearchBtn) {
        if (currentSearch) clearSearchBtn.classList.remove('hidden');
        else clearSearchBtn.classList.add('hidden');
      }
      if (viewMyBtn && viewAllBtn) {
        if (currentView === 'all') {
          viewAllBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-[#1d1d1f] text-white shadow-xs';
          viewMyBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#86868b] hover:text-black';
        } else {
          viewMyBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-[#1d1d1f] text-white shadow-xs';
          viewAllBtn.className = 'px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#86868b] hover:text-black';
        }
      }
      updateTabCounts();
      if (prevView !== currentView) {
        loadOrders();
      } else {
        applyFilter();
      }
    });

    // Initial Load
    loadOrders();
  })();
</script>
