---
// src/pages/admin/orders.astro
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminSearchInput from '@components/admin/AdminSearchInput.astro';
import AdminWorkbenchTableShell from '@components/admin/AdminWorkbenchTableShell.astro';
import TableColumnController from '@components/admin/TableColumnController.astro';
import { requireAdminContext } from '@utils/auth';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, systemSettings, redirectResponse } = await requireAdminContext(Astro, cfEnv, '/admin/orders', { skipPendingCount: true });
if (redirectResponse) return redirectResponse;

const defaultCarriers = ['DHL Express', 'FedEx International', 'UPS Worldwide', 'SF Express', 'Air Freight', 'Other'];
const carrierOptions = systemSettings?.shipping_carriers
  ? systemSettings.shipping_carriers.split(',').map((c: string) => c.trim()).filter(Boolean)
  : defaultCarriers;

const initialStatus = Astro.url.searchParams.get('status') || 'ALL';
const initialSearch = Astro.url.searchParams.get('search') || '';
const initialPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

const pageTitle = 'B2B Admin Fulfillment Workspace';
---

<AdminLayout
  title={pageTitle}
  currentTab="orders"
  sessionEmail={sessionUser.email}
  pendingOrdersCount={0}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- 1. Single-Line Command Bar (Fixed Header) -->
    <header class="shrink-0 bg-white border border-black/5 rounded-2xl px-3 py-2 sm:px-4 sm:py-2.5 shadow-2xs flex flex-wrap md:flex-nowrap items-center justify-between gap-2">
      <!-- Left: Title & Status Filter Capsules -->
      <div class="flex items-center gap-1.5 sm:gap-2 min-w-0 flex-1 overflow-x-auto no-scrollbar">
        <div class="flex items-center gap-1.5 shrink-0">
          <h1 class="text-sm sm:text-base font-bold tracking-tight text-[#1d1d1f]">Orders</h1>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">
            Fulfillment
          </span>
        </div>

        <div class="h-4 w-px bg-black/10 hidden sm:block shrink-0"></div>

        <!-- Status Segmented Pills (Clickable Instant Filters) -->
        <div class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto pb-0.5 sm:pb-0 scrollbar-none" id="status-tabs-container">
          {[
            { key: 'ALL', label: 'All', badgeBg: 'bg-zinc-100 text-zinc-800' },
            { key: 'PENDING_APPROVAL', label: 'Pending', badgeBg: 'bg-amber-100 text-amber-900' },
            { key: 'APPROVED', label: 'Approved', badgeBg: 'bg-blue-100 text-blue-900' },
            { key: 'SHIPPED', label: 'Shipped', badgeBg: 'bg-emerald-100 text-emerald-900' },
            { key: 'REJECTED', label: 'Rejected', badgeBg: 'bg-zinc-100 text-zinc-700' },
          ].map((tab) => {
            const isActive = initialStatus === tab.key;
            return (
              <a
                href={tab.key === 'ALL' ? '/admin/orders' : `/admin/orders?status=${tab.key}`}
                data-tab-status={tab.key}
                class={`status-tab px-2 xl:px-2.5 py-1 rounded-xl text-[11px] xl:text-xs font-medium whitespace-nowrap transition-all border shrink-0 flex items-center gap-1.5 cursor-pointer ${
                  isActive
                    ? 'bg-[#1d1d1f] text-white border-black shadow-xs font-semibold'
                    : 'bg-[#f5f5f7] text-[#52525b] border-black/5 hover:border-black/20 hover:text-black'
                }`}
              >
                <span>{tab.label}</span>
                <span data-tab-field={tab.key} class={`font-mono text-[10px] px-1.5 py-0.2 rounded-md ${isActive ? 'bg-white/20 text-white' : 'bg-black/5 text-[#1d1d1f]'}`}>
                  -
                </span>
              </a>
            );
          })}
        </div>

        <!-- Hidden container for JS selector compatibility -->
        <div class="hidden" id="stats-cards-container" aria-hidden="true">
          <span class="stat-card" data-status="ALL"><span data-stat-field="all"></span></span>
          <span class="stat-card" data-status="PENDING_APPROVAL"><span data-stat-field="pending"></span></span>
          <span class="stat-card" data-status="APPROVED"><span data-stat-field="approved"></span></span>
          <span class="stat-card" data-status="SHIPPED"><span data-stat-field="shipped"></span></span>
          <span class="stat-card" data-status="REJECTED"><span data-stat-field="rejected"></span></span>
        </div>
      </div>

      <!-- Right: Search Form & Total Counter -->
      <div class="flex items-center gap-2 ml-auto shrink-0">
        <span class="hidden xl:inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-[#f5f5f7] border border-black/5 text-[11px] font-mono text-[#52525b]">
          Total: <strong id="total-orders-count" class="text-[#1d1d1f] font-semibold">-</strong>
        </span>

        <!-- Search Form -->
        <AdminSearchInput
          id="orders-search-input"
          formId="orders-search-form"
          clearBtnId="clear-search-btn"
          initialValue={initialSearch}
          placeholder="Order No, email, company..."
          class="relative flex items-center w-36 md:w-40 lg:w-44 xl:w-56 2xl:w-64"
        />

        <!-- Columns & Density Controller -->
        <TableColumnController
          controllerBtnId="orders-columns-btn"
          controllerMenuId="orders-columns-menu"
          columnsListId="orders-columns-list"
          countBadgeId="orders-columns-count"
          syncStatusId="orders-columns-sync"
          resetBtnId="orders-columns-reset"
          densityBtnId="orders-density-btn"
          densityLabelId="orders-density-label"
          showDensityToggle={true}
          class="hidden md:inline-flex"
        />
      </div>
    </header>

    <!-- 2. Independent Scrolling Orders Table Container -->
    <AdminWorkbenchTableShell
      containerId="orders-container"
      skeletonId="orders-skeleton"
      contentId="orders-content"
      contentHidden={true}
      paginationId="pagination-container"
      paginationHidden={true}
      summaryId="pagination-summary"
      prevId="pagination-prev"
      nextId="pagination-next"
      currentId="pagination-current"
    />
  </div>

  <!-- Unified Apple-Grade Modals: Approve, Reject, Ship -->
  <Fragment slot="modals">
    <!-- 1. Approve Confirmation Modal -->
    <dialog id="approve-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl w-[calc(100vw-32px)] max-w-sm mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
      <div class="space-y-4 text-xs text-[#1d1d1f]">
        <div class="flex items-center justify-between pb-1">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100/80">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <button id="close-approve-modal" type="button" class="text-base text-[#86868b] hover:text-black cursor-pointer">✕</button>
        </div>

        <div>
          <h3 class="text-base font-bold text-[#1d1d1f]">Approve B2B Order</h3>
          <p class="text-xs text-[#86868b] mt-1 leading-relaxed">
            Are you sure you want to approve order <strong id="approve-modal-order-no" class="font-mono text-[#1d1d1f]"></strong>? This transitions the order to <span class="text-blue-600 font-medium">Approved (To Ship)</span> status.
          </p>
        </div>

        <input type="hidden" id="approve-order-id" />
        <div id="approve-error" class="hidden text-rose-600 bg-rose-50 border border-rose-100 rounded-xl p-2.5 text-xs font-medium leading-relaxed"></div>

        <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
          <button
            type="button"
            id="cancel-approve-btn"
            class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-approve-btn"
            class="h-9 px-5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-2xs shadow-emerald-700/20 active:scale-95 transition-all cursor-pointer"
          >
            Confirm Approval
          </button>
        </div>
      </div>
    </dialog>

    <!-- 2. Reject Confirmation Modal -->
    <dialog id="reject-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl w-[calc(100vw-32px)] max-w-sm mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
      <div class="space-y-4 text-xs text-[#1d1d1f]">
        <div class="flex items-center justify-between pb-1">
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center border border-rose-100/80">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <button id="close-reject-modal" type="button" class="text-base text-[#86868b] hover:text-black cursor-pointer">✕</button>
        </div>

        <div>
          <h3 class="text-base font-bold text-[#1d1d1f]">Reject Order</h3>
          <p class="text-xs text-[#86868b] mt-1 leading-relaxed">
            Decline order <strong id="reject-modal-order-no" class="font-mono text-[#1d1d1f]"></strong>. Please provide a clear remark explaining the rejection.
          </p>
        </div>

        <input type="hidden" id="reject-order-id" />
        <div>
          <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Rejection Reason / Internal Note</label>
          <textarea
            id="reject-reason-input"
            rows="3"
            placeholder="e.g. MOQ requirements not met, out of stock yarn, duplicate order..."
            class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black resize-none text-xs"
          ></textarea>
        </div>

        <div id="reject-error" class="hidden text-rose-600 bg-rose-50 border border-rose-100 rounded-xl p-2.5 text-xs font-medium leading-relaxed"></div>

        <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
          <button
            type="button"
            id="cancel-reject-btn"
            class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-reject-btn"
            class="h-9 px-5 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white shadow-2xs shadow-rose-700/20 active:scale-95 transition-all cursor-pointer"
          >
            Confirm Rejection
          </button>
        </div>
      </div>
    </dialog>

    <!-- 3. Fulfillment / Shipping Dispatch Modal -->
    <dialog id="ship-modal" class="backdrop:bg-black/50 backdrop:backdrop-blur-sm p-4 rounded-3xl w-[calc(100vw-32px)] max-w-md mx-auto my-auto border border-black/10 shadow-2xl bg-white focus:outline-none">
      <div class="space-y-4 text-xs text-[#1d1d1f]">
        <div class="flex items-center justify-between pb-1">
          <div class="w-10 h-10 rounded-xl bg-[#1d1d1f] text-white flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <button id="close-ship-modal" type="button" class="text-base text-[#86868b] hover:text-black cursor-pointer">✕</button>
        </div>

        <div>
          <h3 class="text-base font-bold text-[#1d1d1f]">Dispatch Shipment</h3>
          <p class="text-xs text-[#86868b] mt-1 leading-relaxed">
            Record carrier logistics and tracking waybill for order <strong id="ship-modal-order-no" class="font-mono text-[#1d1d1f]"></strong>.
          </p>
        </div>

        <form id="ship-form" class="space-y-3">
          <input type="hidden" id="ship-order-id" name="order_id" />

          <div>
            <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Logistics Carrier / Freight Provider</label>
            <select
              id="ship-carrier-select"
              name="carrier"
              required
              class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-xs"
            >
              {carrierOptions.map((c: string) => (
                <option value={c}>{c}</option>
              ))}
              {!carrierOptions.includes('Other') && <option value="Other">Other / Custom Carrier</option>}
            </select>
          </div>

          <div>
            <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Waybill / Tracking Number</label>
            <input
              type="text"
              id="ship-tracking-number"
              name="tracking_number"
              required
              placeholder="e.g. 78349281923"
              class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black font-mono text-xs"
            />
          </div>

          <div>
            <label class="block font-medium mb-1 text-[11px] text-[#52525b]">Dispatch Notes / Admin Remarks (Optional)</label>
            <textarea
              id="ship-remark"
              name="admin_remark"
              rows="2"
              placeholder="e.g. Packed in 2 export cartons, estimated arrival Nov 12."
              class="w-full px-3 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black resize-none text-xs"
            ></textarea>
          </div>

          <div id="ship-error" class="hidden text-rose-600 bg-rose-50 border border-rose-100 rounded-xl px-3 py-2 text-[11px] font-medium leading-relaxed"></div>

          <div class="pt-2 flex items-center justify-end gap-2 border-t border-black/5">
            <button
              type="button"
              id="cancel-ship-btn"
              class="h-9 px-4 rounded-xl text-xs font-medium text-[#52525b] hover:bg-[#f5f5f7] border border-black/5 transition-all cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="confirm-ship-btn"
              class="h-9 px-5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all cursor-pointer"
            >
              Confirm Shipment
            </button>
          </div>
        </form>
      </div>
    </dialog>
  </Fragment>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';
  import { escapeHtml, formatAdminTime, createPaginationController } from '@utils/adminWorkbench';
  import { useTableSettings, type ColumnConfig } from '@hooks/useTableSettings';

  const DEFAULT_COLUMNS: ColumnConfig[] = [
    { id: 'order_no', label: 'Order No / Date', defaultWidth: 160, minWidth: 120, visible: true, canHide: false },
    { id: 'buyer', label: 'Buyer / Company', defaultWidth: 200, minWidth: 140, visible: true, canHide: true },
    { id: 'destination', label: 'Destination', defaultWidth: 130, minWidth: 100, visible: true, canHide: true },
    { id: 'qty', label: 'Styles / Qty', defaultWidth: 120, minWidth: 90, visible: true, canHide: true, align: 'right' },
    { id: 'status', label: 'Status', defaultWidth: 140, minWidth: 100, visible: true, canHide: true },
    { id: 'action', label: 'Fulfillment Actions', defaultWidth: 220, minWidth: 160, visible: true, canHide: false, pinRight: true, align: 'right' },
  ];

  let currentOrdersList: any[] = [];
  let currentStatus = 'ALL';
  let currentSearch = '';
  let currentPage = 1;
  let currentLimit = 50;
  let currentTotalPages = 1;
  let activeAbortController: AbortController | null = null;

  const tableSettings = useTableSettings({
    tableKey: 'orders',
    defaultColumns: DEFAULT_COLUMNS,
    defaultDensity: 'cozy',
    controllerBtnEl: document.getElementById('orders-columns-btn'),
    controllerMenuEl: document.getElementById('orders-columns-menu'),
    columnsListEl: document.getElementById('orders-columns-list'),
    countBadgeEl: document.getElementById('orders-columns-count'),
    syncStatusEl: document.getElementById('orders-columns-sync'),
    resetBtnEl: document.getElementById('orders-columns-reset'),
    densityBtnEl: document.getElementById('orders-density-btn'),
    densityLabelEl: document.getElementById('orders-density-label'),
    onSettingsChange: () => {
      if (currentOrdersList && currentOrdersList.length > 0) renderOrders(currentOrdersList);
    },
    onDensityChange: () => {
      if (currentOrdersList && currentOrdersList.length > 0) renderOrders(currentOrdersList);
    },
  });

  const pagination = createPaginationController({
    containerId: 'pagination-container',
    summaryId: 'pagination-summary',
    prevId: 'pagination-prev',
    nextId: 'pagination-next',
    currentId: 'pagination-current',
    itemLabel: 'orders',
    onPageChange: (newPage) => {
      currentPage = newPage;
      fetchOrders();
    },
  });

  const showError = (el, msg) => {
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  };
  const clearError = (el) => {
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  };

  function updateActiveVisuals() {
    // 1. Update stats cards
    document.querySelectorAll('#stats-cards-container .stat-card').forEach((card) => {
      const cardStatus = card.getAttribute('data-status');
      const isSelected = cardStatus === currentStatus;
      const countEl = card.querySelector('[data-stat-field]');

      if (isSelected) {
        if (cardStatus === 'ALL') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-[#1d1d1f] text-white border-black shadow-xs cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-white';
        } else if (cardStatus === 'PENDING_APPROVAL') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-amber-600 text-white border-amber-700 shadow-xs cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-white';
        } else if (cardStatus === 'APPROVED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-blue-600 text-white border-blue-700 shadow-xs cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-white';
        } else if (cardStatus === 'SHIPPED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-emerald-600 text-white border-emerald-700 shadow-xs cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-white';
        } else if (cardStatus === 'REJECTED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-zinc-700 text-white border-zinc-800 shadow-xs cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-white';
        }
      } else {
        if (cardStatus === 'ALL') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-white text-[#1d1d1f] border-black/5 hover:border-black/20 cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-[#1d1d1f]';
        } else if (cardStatus === 'PENDING_APPROVAL') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-white text-amber-900 border-black/5 hover:border-amber-300 cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-amber-600';
        } else if (cardStatus === 'APPROVED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-white text-blue-900 border-black/5 hover:border-blue-300 cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-blue-600';
        } else if (cardStatus === 'SHIPPED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-white text-emerald-900 border-black/5 hover:border-emerald-300 cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-emerald-600';
        } else if (cardStatus === 'REJECTED') {
          card.className = 'stat-card p-3.5 rounded-xl border text-xs transition-all bg-white text-zinc-700 border-black/5 hover:border-zinc-300 cursor-pointer';
          if (countEl) countEl.className = 'text-lg font-bold font-mono tabular-nums text-[#1d1d1f]';
        }
      }
    });

    // 2. Update status pills
    document.querySelectorAll('#status-tabs-container .status-tab').forEach((tab) => {
      const tabStatus = tab.getAttribute('data-tab-status');
      const isSelected = tabStatus === currentStatus;
      const countEl = tab.querySelector('[data-tab-field]');

      if (isSelected) {
        let activeClass = 'bg-[#1d1d1f] text-white border-black';
        if (tabStatus === 'PENDING_APPROVAL') activeClass = 'bg-amber-600 text-white border-amber-700';
        if (tabStatus === 'APPROVED') activeClass = 'bg-blue-600 text-white border-blue-700';
        if (tabStatus === 'SHIPPED') activeClass = 'bg-emerald-600 text-white border-emerald-700';
        if (tabStatus === 'REJECTED') activeClass = 'bg-zinc-700 text-white border-zinc-800';

        tab.className = `status-tab px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border shrink-0 flex items-center gap-1.5 ${activeClass} shadow-2xs cursor-pointer`;
        if (countEl) countEl.className = 'font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-white/20 text-white';
      } else {
        tab.className = 'status-tab px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition-all border shrink-0 flex items-center gap-1.5 bg-white text-[#52525b] border-black/5 hover:border-black/20 cursor-pointer';
        if (countEl) countEl.className = 'font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-[#f5f5f7] text-[#1d1d1f]';
      }
    });
  }

  function renderStats(stats, total) {
    if (!stats) return;
    const totalEl = document.getElementById('total-orders-count');
    if (totalEl) totalEl.textContent = String(total ?? stats.all ?? 0);

    const mapping = {
      all: stats.all ?? 0,
      pending: stats.pending ?? 0,
      approved: stats.approved ?? 0,
      shipped: stats.shipped ?? 0,
      rejected: stats.rejected ?? 0,
    };

    Object.entries(mapping).forEach(([key, val]) => {
      const cardEl = document.querySelector(`[data-stat-field="${key}"]`);
      if (cardEl) cardEl.textContent = String(val);

      const upperKey = key === 'all' ? 'ALL' : (key === 'pending' ? 'PENDING_APPROVAL' : (key === 'approved' ? 'APPROVED' : (key === 'shipped' ? 'SHIPPED' : 'REJECTED')));
      const tabEl = document.querySelector(`[data-tab-field="${upperKey}"]`);
      if (tabEl) tabEl.textContent = String(val);
    });
  }

  function renderStatusBadge(status) {
    if (status === 'PENDING_APPROVAL') {
      return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Pending Approval
      </span>`;
    }
    if (status === 'APPROVED') {
      return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        Approved
      </span>`;
    }
    if (status === 'SHIPPED') {
      return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Shipped
      </span>`;
    }
    if (status === 'REJECTED') {
      return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
        Rejected
      </span>`;
    }
    return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">${escapeHtml(status)}</span>`;
  }

  function renderActionButtons(order, isMobile = false) {
    const isPending = order.status === 'PENDING_APPROVAL';
    const isApproved = order.status === 'APPROVED';
    const isShipped = order.status === 'SHIPPED';
    const isRejected = order.status === 'REJECTED';
    const safeId = escapeHtml(order.id);
    const safeNo = escapeHtml(order.order_no);

    if (isPending) {
      return `
        <button
          type="button"
          class="action-approve-btn h-8 ${isMobile ? 'px-3' : 'px-3'} rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-2xs shadow-emerald-700/20 inline-flex items-center gap-1 transition-all active:scale-95 cursor-pointer"
          data-id="${safeId}"
          data-no="${safeNo}"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Approve</span>
        </button>
        <button
          type="button"
          class="action-reject-btn h-8 ${isMobile ? 'px-2.5' : 'px-3'} rounded-lg text-xs font-medium bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 hover:border-rose-300 shadow-2xs inline-flex items-center gap-1 transition-all active:scale-95 cursor-pointer"
          data-id="${safeId}"
          data-no="${safeNo}"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>Reject</span>
        </button>
      `;
    }

    if (isApproved) {
      return `
        <button
          type="button"
          class="action-ship-btn h-8 ${isMobile ? 'px-3' : 'px-3.5'} rounded-lg text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white shadow-2xs inline-flex items-center gap-1 transition-all active:scale-95 cursor-pointer"
          data-id="${safeId}"
          data-no="${safeNo}"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
          <span>Fulfill & Ship</span>
        </button>
      `;
    }

    if (isShipped) {
      const trackingOrCarrier = escapeHtml(order.tracking_number || order.carrier || 'Shipped');
      return `
        <div class="h-8 inline-flex items-center gap-1 px-2.5 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-mono font-medium truncate max-w-[150px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span class="truncate">${trackingOrCarrier}</span>
        </div>
      `;
    }

    if (isRejected) {
      return `
        <span class="h-8 inline-flex items-center px-2.5 rounded-lg bg-zinc-100 text-zinc-500 text-[10px] font-medium border border-zinc-200">
          Rejected
        </span>
      `;
    }

    return '';
  }

  function renderOrderItems(items, isMobile = false) {
    if (!items || items.length === 0) {
      return `<div class="py-2 text-center text-[11px] text-[#86868b]">No item details recorded.</div>`;
    }

    return items.map((item) => {
      const itemTitle = escapeHtml(item.title);
      const itemSku = escapeHtml(item.sku || '');
      const itemVariant = escapeHtml(item.variant || 'Standard Spec');
      const itemQty = Number(item.quantity || 0);
      const imgSrc = escapeHtml(item.resolved_image || '/images/hero-light.webp');
      const productUrl = item.product_url ? escapeHtml(item.product_url) : null;

      const imgHtml = productUrl
        ? `<a href="${productUrl}" target="_blank" rel="noopener noreferrer" class="shrink-0 group block" title="View ${itemTitle}">
            <img src="${imgSrc}" alt="${itemTitle}" class="${isMobile ? 'w-9 h-9' : 'w-11 h-11'} rounded-md object-cover bg-white border border-black/5 shrink-0" loading="lazy" />
          </a>`
        : `<img src="${imgSrc}" alt="${itemTitle}" class="${isMobile ? 'w-9 h-9' : 'w-11 h-11'} rounded-md object-cover bg-white border border-black/5 shrink-0" loading="lazy" />`;

      const titleHtml = productUrl
        ? `<a href="${productUrl}" target="_blank" rel="noopener noreferrer" class="font-medium text-[#1d1d1f] hover:underline truncate block ${isMobile ? 'text-[11px]' : 'text-xs'}">
            ${itemTitle}
          </a>`
        : `<p class="font-medium text-[#1d1d1f] truncate ${isMobile ? 'text-[11px]' : 'text-xs'}">${itemTitle}</p>`;

      return `
        <div class="py-2.5 first:pt-0 last:pb-0 flex items-center justify-between gap-2.5 text-xs">
          <div class="flex items-center gap-2.5 min-w-0">
            ${imgHtml}
            <div class="min-w-0">
              ${titleHtml}
              <div class="flex items-center gap-2 text-[10px] text-[#86868b] truncate font-mono mt-0.5">
                ${itemSku ? `<span class="bg-[#f5f5f7] px-1 py-0.5 rounded text-[10px] text-[#52525b] border border-black/5">${itemSku}</span>` : ''}
                <span class="truncate">${itemVariant}</span>
              </div>
            </div>
          </div>
          <div class="font-mono font-semibold text-xs tabular-nums shrink-0 text-right">
            ${itemQty} pcs
          </div>
        </div>
      `;
    }).join('');
  }

  function renderOrders(orders) {
    currentOrdersList = orders || [];
    const container = document.getElementById('orders-content');
    if (!container) return;

    if (!orders || orders.length === 0) {
      container.innerHTML = `
        <div class="py-16 text-center text-xs text-[#86868b]">
          No orders matching the current filter.
        </div>
      `;
      container.classList.remove('hidden');
      return;
    }

    // Preserve expanded detail rows across column reorder, resize, or density toggle
    const expandedDesktopIds = new Set(
      Array.from(document.querySelectorAll('tr.order-detail-row:not(.hidden)')).map((el) => el.id)
    );
    const expandedMobileIds = new Set(
      Array.from(document.querySelectorAll('div[id^="detail-m-"]:not(.hidden)')).map((el) => el.id)
    );

    // 1. Mobile Cards Layout (< md)
    const mobileCardsHtml = `
      <div class="block md:hidden divide-y divide-black/5">
        ${orders.map((order) => {
          const safeId = escapeHtml(order.id);
          const safeNo = escapeHtml(order.order_no);
          const safeEmail = escapeHtml(order.buyer_email || '');
          const safeCompany = escapeHtml(order.company_name || order.contact_name || 'Independent Buyer');
          const safeCountry = escapeHtml(order.destination_country || 'Worldwide');
          const dateStr = formatAdminTime(order.created_at, 'full');
          const itemCount = order.items?.length || 0;
          const totalQty = Number(order.total_quantity || 0);
          const totalStyles = Number(order.total_styles || 0);
