---
// src/components/SEO.astro
import type { CustomImage, Page, SiteConfig } from 'types';
type TwitterCardType = 'summary' | 'summary_large_image' | 'app' | 'player';
import { SanityImageService } from '@utils/image';
import { cleanBrandTitle } from '@utils/format';
import {
  DEFAULT_BRAND_TITLE,
  DEFAULT_FALLBACK_IMAGE,
  DEFAULT_META_DESCRIPTION,
  DEFAULT_META_TITLE,
} from '@data/defaults';
import {
  getLangFromUrl,
  getLocalizedValue,
  LANGUAGES,
  normalizeCanonicalUrl,
  resolveSiteOrigin,
  type SupportedLocale,
} from '@i18n';

export interface Props {
  title?: string | Record<string, string>;
  addTitleSuffix?: boolean;
  description?: string | Record<string, string>;
  image?: CustomImage | string | { asset?: { url?: string }; src?: string; alt?: string };
  canonicalUrl?: string | URL;
  type?: 'website' | 'article' | 'product';
  twitterCard?: TwitterCardType;
  noindex?: boolean;
  nofollow?: boolean;
  page?: Partial<Page>;
  siteConfig?: SiteConfig | null;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title: propTitle,
  addTitleSuffix: propAddTitleSuffix,
  description: propDescription,
  image: propImage,
  canonicalUrl: propCanonicalUrl,
  type = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
  nofollow = false,
  page,
  siteConfig,
  structuredData,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);

// 1. Resolve localized Title & Site Title Suffix from Sanity Page / SiteConfig
const rawTitle = propTitle ?? page?.metaTitle ?? page?.title ?? DEFAULT_META_TITLE;
const baseTitle =
  (typeof rawTitle === 'object' && rawTitle !== null
    ? getLocalizedValue(rawTitle, currentLang)
    : rawTitle) || DEFAULT_META_TITLE;

const shouldAddSuffix = propAddTitleSuffix ?? page?.addTitleSuffix ?? true;
const rawTitleSuffix =
  siteConfig?.titleSuffix && shouldAddSuffix !== false ? siteConfig.titleSuffix : undefined;
const titleSuffix = rawTitleSuffix
  ? typeof rawTitleSuffix === 'object'
    ? getLocalizedValue(rawTitleSuffix, currentLang)
    : rawTitleSuffix
  : undefined;

const resolvedTitle = [baseTitle, titleSuffix].filter(Boolean).join(' | ');

// 2. Resolve localized Meta Description from Sanity Page / Props
const rawDescription =
  propDescription ?? page?.metaDescription ?? DEFAULT_META_DESCRIPTION;
const resolvedDescription =
  (typeof rawDescription === 'object' && rawDescription !== null
    ? getLocalizedValue(rawDescription, currentLang)
    : rawDescription) || DEFAULT_META_DESCRIPTION;

// 3. Resolve Canonical URL & Base Origin (strips query params & non-root trailing slashes)
const baseOrigin = resolveSiteOrigin(Astro.url, Astro.site);
const resolvedCanonical = normalizeCanonicalUrl(
  propCanonicalUrl || Astro.url.pathname,
  baseOrigin
);

// 4. Resolve Open Graph & Twitter Image from Sanity socialImage / Props
const rawImage = propImage ?? page?.socialImage ?? DEFAULT_FALLBACK_IMAGE;
const rawImageSrc =
  typeof rawImage === 'string'
    ? rawImage
    : rawImage?.src || (rawImage as any)?.asset?.url || DEFAULT_FALLBACK_IMAGE;
const rawImageAlt =
  typeof rawImage === 'object' && rawImage !== null && 'alt' in rawImage && rawImage.alt
    ? String(rawImage.alt)
    : resolvedTitle;
const imageDimensions =
  typeof rawImage === 'object' && rawImage !== null && 'dimensions' in rawImage
    ? rawImage.dimensions
    : undefined;

const transformedImageSrc = SanityImageService.hero(rawImageSrc || DEFAULT_FALLBACK_IMAGE, 1200);
const resolvedImageUrl = transformedImageSrc.startsWith('http')
  ? transformedImageSrc
  : new URL(
      transformedImageSrc.startsWith('/') ? transformedImageSrc : `/${transformedImageSrc}`,
      baseOrigin
    ).toString();

// 5. Resolve Brand / Site Name & Locale
const rawBrandName = siteConfig?.header?.title
  ? typeof siteConfig.header.title === 'object'
    ? getLocalizedValue(siteConfig.header.title, currentLang)
    : siteConfig.header.title
  : DEFAULT_BRAND_TITLE;
const siteName = cleanBrandTitle(rawBrandName || DEFAULT_BRAND_TITLE);

const OG_LOCALE_MAP: Record<SupportedLocale, string> = {
  en: 'en_US',
  de: 'de_DE',
  fr: 'fr_FR',
  es: 'es_ES',
};
const ogLocale = OG_LOCALE_MAP[currentLang] || 'en_US';
const ogAlternateLocales = (Object.keys(LANGUAGES) as SupportedLocale[])
  .filter((loc) => loc !== currentLang)
  .map((loc) => OG_LOCALE_MAP[loc]);
const resolvedImageWidth = String(imageDimensions?.width || 1200);
const resolvedImageHeight = String(imageDimensions?.height || 630);
const robotsContent = (noindex || nofollow)
  ? `${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`
  : '';
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={resolvedCanonical} />
{robotsContent && <meta name="robots" content={robotsContent} />}

<meta property="og:title" content={resolvedTitle} />
<meta property="og:type" content={type} />
<meta property="og:image" content={resolvedImageUrl} />
{resolvedImageUrl.startsWith('https') && <meta property="og:image:secure_url" content={resolvedImageUrl} />}
<meta property="og:image:alt" content={rawImageAlt} />
<meta property="og:image:width" content={resolvedImageWidth} />
<meta property="og:image:height" content={resolvedImageHeight} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{ogAlternateLocales.map((alt) => <meta property="og:locale:alternate" content={alt} />)}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={resolvedImageUrl} />
<meta name="twitter:image:alt" content={rawImageAlt} />
<meta property="twitter:url" content={resolvedCanonical} />

{structuredData && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
)}
