---
// src/pages/admin/logins.astro
// Admin Security Audit: 90-Day Login History & IP/Device Tracker
import AdminLayout from '@layouts/AdminLayout.astro';
import { requireAdminContext } from '@utils/auth';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, pendingOrdersCount, systemSettings, redirectResponse } = await requireAdminContext(Astro, cfEnv, '/admin/logins');
if (redirectResponse) return redirectResponse;

const retentionDays = systemSettings?.login_retention_days || 90;
const initialSearch = Astro.url.searchParams.get('search')?.trim() || '';

const pageTitle = 'Login Audit Logs';
---

<AdminLayout
  title={pageTitle}
  currentTab="logins"
  sessionEmail={sessionUser.email}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- 1. Single-Line Command Bar (Fixed Header) -->
    <header class="shrink-0 bg-white border border-black/5 rounded-2xl px-3 py-2 sm:px-4 sm:py-2.5 shadow-2xs flex flex-wrap items-center justify-between gap-2.5">
      <!-- Left: Title & Metric Capsules -->
      <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
        <div class="flex items-center gap-1.5 shrink-0">
          <h1 class="text-sm sm:text-base font-bold tracking-tight text-[#1d1d1f]">Login Audit</h1>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            {retentionDays}d
          </span>
        </div>

        <div class="h-4 w-px bg-black/10 hidden sm:block shrink-0"></div>

        <!-- Metric Capsules -->
        <div class="flex items-center gap-1 sm:gap-1.5 flex-wrap">
          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-[#f5f5f7] text-[#52525b] border border-black/5 flex items-center gap-1">
            <span>Sessions</span>
            <strong id="metric-sessions" class="text-[#1d1d1f] font-bold">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-[#f5f5f7] text-[#52525b] border border-black/5 flex items-center gap-1">
            <span>Accounts</span>
            <strong id="metric-accounts" class="text-[#1d1d1f] font-bold">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-blue-50/80 text-blue-800 border border-blue-200/80 flex items-center gap-1">
            <span>IPs</span>
            <strong id="metric-ips" class="font-bold text-blue-700">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-purple-50/80 text-purple-800 border border-purple-200/80 flex items-center gap-1">
            <span>Countries</span>
            <strong id="metric-countries" class="font-bold text-purple-700">-</strong>
          </span>
        </div>
      </div>

      <!-- Right: Search Form & Log Counter -->
      <div class="flex items-center gap-2 ml-auto shrink-0">
        <span id="log-count-summary" class="hidden md:inline font-mono text-[11px] text-[#86868b]">(Loading...)</span>

        <!-- Search Form -->
        <div class="relative flex items-center w-48 sm:w-64">
          <input
            type="text"
            id="logins-search-input"
            value={initialSearch}
            placeholder="Search email, IP, city..."
            class="w-full pl-7 pr-6 py-1 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f]"
          />
          <svg class="w-3.5 h-3.5 text-[#86868b] absolute left-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            type="button"
            id="clear-logins-search"
            class={`absolute right-2 text-xs text-[#86868b] hover:text-black cursor-pointer ${initialSearch ? '' : 'hidden'}`}
            title="Clear search"
          >
            ✕
          </button>
        </div>
      </div>
    </header>

    <!-- 2. Independent Scrolling Container -->
    <div id="logins-container" class="flex-1 min-h-0 min-w-0 bg-white rounded-2xl border border-black/5 shadow-2xs flex flex-col overflow-hidden relative">
      <!-- Skeleton loader -->
      <div id="logins-skeleton" class="p-6 space-y-4 animate-pulse">
        <div class="h-6 bg-[#f5f5f7] rounded-xl w-1/4"></div>
        <div class="space-y-3">
          <div class="h-10 bg-[#f5f5f7] rounded-xl"></div>
          <div class="h-10 bg-[#f5f5f7] rounded-xl"></div>
          <div class="h-10 bg-[#f5f5f7] rounded-xl"></div>
          <div class="h-10 bg-[#f5f5f7] rounded-xl"></div>
          <div class="h-10 bg-[#f5f5f7] rounded-xl"></div>
        </div>
      </div>

      <!-- Content injected here with Independent Scroll -->
      <div id="logins-content" class="flex-1 min-h-0 overflow-auto scrollbar-thin hidden"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';

  let allLogins = [];
  let currentSearch = '';

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatDateTime(iso) {
    if (!iso) return '-';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    const pad = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }

  function updateMetrics(logins) {
    const sessionsEl = document.getElementById('metric-sessions');
    const accountsEl = document.getElementById('metric-accounts');
    const ipsEl = document.getElementById('metric-ips');
    const countriesEl = document.getElementById('metric-countries');

    if (sessionsEl) sessionsEl.textContent = String(logins.length);
    if (accountsEl) {
      const uniqueUsers = new Set(logins.map((l) => (l.email || '').toLowerCase())).size;
      accountsEl.textContent = String(uniqueUsers);
    }
    if (ipsEl) {
      const uniqueIps = new Set(logins.map((l) => l.ip).filter(Boolean)).size;
      ipsEl.textContent = String(uniqueIps);
    }
    if (countriesEl) {
      const uniqueCountries = new Set(logins.map((l) => l.country).filter(Boolean)).size;
      countriesEl.textContent = String(uniqueCountries || 1);
    }
  }

  function renderTable(displayLogins) {
    const content = document.getElementById('logins-content');
    const summary = document.getElementById('log-count-summary');
    if (!content) return;

    if (summary) {
      summary.textContent = `(${displayLogins.length} of ${allLogins.length} events)`;
    }

    if (displayLogins.length === 0) {
      content.innerHTML = `
        <div class="py-16 text-center text-xs text-[#86868b]">
          ${currentSearch ? `No login events matching "${escapeHtml(currentSearch)}".` : 'No login activity recorded yet.'}
        </div>
      `;
      content.classList.remove('hidden');
      return;
    }

    // 1. Mobile Cards Layout (< md)
    const mobileCardsHtml = `
      <div class="block md:hidden divide-y divide-black/5">
        ${displayLogins.map((entry) => {
          const locationStr = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global');
          const safeEmail = escapeHtml(entry.email || '');
          const safeUserId = escapeHtml(entry.user_id || '');
          const safeIp = escapeHtml(entry.ip || '—');
          const safeAgent = escapeHtml(entry.user_agent || 'Unknown Device');
          const dateStr = formatDateTime(entry.created_at);

          return `
            <div class="p-3.5 space-y-2 bg-white text-xs">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <span class="font-semibold text-[#1d1d1f] truncate block">${safeEmail}</span>
                  <span class="font-mono text-[10px] text-[#86868b] truncate block" title="${safeUserId}">${safeUserId}</span>
                </div>
                <span class="text-[11px] text-[#86868b] shrink-0 font-mono">
                  ${dateStr}
                </span>
              </div>
              <div class="p-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 space-y-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-mono font-medium text-[#1d1d1f]">${safeIp}</span>
                  <span class="text-[#52525b]">📍 ${locationStr}</span>
                </div>
                <p class="text-[10px] text-[#86868b] truncate" title="${safeAgent}">
                  ${safeAgent}
                </p>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;

    // 2. Desktop High-Density Table (>= md)
    const desktopTableHtml = `
      <div class="hidden md:block">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="sticky top-0 z-10 bg-[#fafafa]/95 backdrop-blur-xs shadow-2xs">
            <tr class="border-b border-black/10 text-[#86868b] font-medium text-[11px]">
              <th class="py-3 px-4">User Email & ID</th>
              <th class="py-3 px-4">IP Address</th>
              <th class="py-3 px-4">Location</th>
              <th class="py-3 px-4">Client User-Agent</th>
              <th class="py-3 px-4 text-right">Login Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            ${displayLogins.map((entry) => {
              const locationStr = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global / Edge');
              const safeEmail = escapeHtml(entry.email || '');
              const safeUserId = escapeHtml(entry.user_id || '');
              const safeIp = escapeHtml(entry.ip || '');
              const safeAgent = escapeHtml(entry.user_agent || 'Unknown Client');
              const dateStr = formatDateTime(entry.created_at);

              return `
                <tr class="hover:bg-[#f5f5f7]/60 transition-colors">
                  <td class="py-3 px-4">
                    <div class="font-medium text-[#1d1d1f]">${safeEmail}</div>
                    <div class="text-[10px] font-mono text-[#86868b] truncate max-w-[200px]" title="${safeUserId}">
                      ${safeUserId}
                    </div>
                  </td>
                  <td class="py-3 px-4 font-mono text-[11px] text-[#1d1d1f]">
                    ${safeIp ? `<span class="px-2 py-0.5 rounded bg-[#f5f5f7] border border-black/5">${safeIp}</span>` : `<span class="text-[#86868b]">—</span>`}
                  </td>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] bg-zinc-100 text-[#1d1d1f] border border-black/5">
                      📍 ${locationStr}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-[11px] text-[#52525b] max-w-xs truncate" title="${safeAgent}">
                    ${safeAgent}
                  </td>
                  <td class="py-3 px-4 text-right whitespace-nowrap font-mono text-[11px]">
                    ${dateStr}
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    `;

    content.innerHTML = mobileCardsHtml + desktopTableHtml;
    content.classList.remove('hidden');
  }

  function filterAndRender() {
    const searchLower = currentSearch.toLowerCase();
    const filtered = searchLower
      ? allLogins.filter((l) =>
          (l.email || '').toLowerCase().includes(searchLower) ||
          (l.user_id || '').toLowerCase().includes(searchLower) ||
          (l.ip || '').toLowerCase().includes(searchLower) ||
          (l.city || '').toLowerCase().includes(searchLower) ||
          (l.country || '').toLowerCase().includes(searchLower)
        )
      : allLogins;

    renderTable(filtered);
  }

  async function loadLogins() {
    const skeleton = document.getElementById('logins-skeleton');
    const content = document.getElementById('logins-content');

    try {
      await clientCache.fetchWithCache('admin:logins:150', '/api/admin/logins?limit=150', {
        mode: 'swr',
        onData: (data: any) => {
          allLogins = data.logins || [];
          if (skeleton) skeleton.classList.add('hidden');
          updateMetrics(allLogins);
          filterAndRender();
        },
      });
    } catch (err) {
      console.error('Failed to load logins:', err);
      if (skeleton) skeleton.classList.add('hidden');
      if (content) {
        content.innerHTML = `
          <div class="py-16 text-center text-xs text-rose-600">
            Failed to load login audit logs. <button type="button" id="retry-logins-btn" class="underline ml-1 cursor-pointer">Retry</button>
          </div>
        `;
        content.classList.remove('hidden');
        document.getElementById('retry-logins-btn')?.addEventListener('click', loadLogins);
      }
    }
  }

  // 0ms instant client-side search filtering
  const searchInput = document.getElementById('logins-search-input');
  const clearBtn = document.getElementById('clear-logins-search');

  searchInput?.addEventListener('input', () => {
    currentSearch = searchInput.value.trim();
    if (clearBtn) {
      if (currentSearch) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }

    const url = new URL(window.location.href);
    if (currentSearch) url.searchParams.set('search', currentSearch);
    else url.searchParams.delete('search');
    window.history.replaceState({}, '', url.toString());

    filterAndRender();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    clearBtn.classList.add('hidden');

    const url = new URL(window.location.href);
    url.searchParams.delete('search');
    window.history.replaceState({}, '', url.toString());

    filterAndRender();
  });

  // Initial load
  const initialUrl = new URL(window.location.href);
  currentSearch = initialUrl.searchParams.get('search')?.trim() || '';
  loadLogins();
</script>
