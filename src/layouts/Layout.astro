---
import { type SiteConfig, type CustomImage } from 'types';
import { AppleNav, AppleFooter, QuoteDrawer, WhatsAppWidget } from '@components';
import { fetchData } from '@data/siteConfig';
import { SanityImageService } from '@utils/image';

import '../styles/globals.css';

interface Props {
    title: string;
    addTitleSuffix?: boolean;
    description?: string;
    image?: CustomImage | string;
    bodyClass?: string;
    mainClass?: string;
}

const { addTitleSuffix, description, image, bodyClass, mainClass } = Astro.props;

const configData: SiteConfig = (await fetchData()) || {};
SanityImageService.setStudioProxyConfig(configData?.enableImageProxy);
const titleSuffix = configData.titleSuffix && addTitleSuffix !== false ? configData.titleSuffix : undefined;
const title = [Astro.props.title, titleSuffix].filter(Boolean).join(' | ');

const rawImageSrc = typeof image === 'string' ? image : image?.src;
const imageSrc = rawImageSrc ? SanityImageService.hero(rawImageSrc, 1200) : undefined;
const resolvedImage = imageSrc
    ? { src: imageSrc.startsWith('http') || imageSrc.startsWith('/') ? imageSrc : new URL(imageSrc, Astro.site || Astro.url).toString() }
    : undefined;
const canonicalURL = Astro.site ? new URL(Astro.request.url, Astro.site) : Astro.url;

/**
 * Enforce some standard canonical URL formatting across the site.
 */
function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}
---

<!doctype html>
<html lang="en" data-theme="light" class="scroll-smooth">
    <head>
        <!-- High Priority Global Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

        <!-- Low Priority Global Metadata -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="alternate icon" href="/favicon.ico" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Page Metadata -->
        <link rel="canonical" href={formatCanonicalURL(canonicalURL)} />
        {description && <meta name="description" content={description} />}

        <!-- Open Graph / Facebook -->
        <meta property="og:url" content={formatCanonicalURL(canonicalURL)} />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        {resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}

        <!-- X/Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={formatCanonicalURL(canonicalURL)} />
        <meta property="twitter:title" content={title} />
        {description && <meta property="twitter:description" content={description} />}
        {resolvedImage?.src && <meta property="twitter:image" content={resolvedImage.src} />}
    </head>
    <body class={bodyClass || "bg-white text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white"}>
        <AppleNav config={configData} />
        <main class={mainClass}>
            <slot />
        </main>
        <AppleFooter config={configData} />
        <QuoteDrawer />

        <!-- 1. WhatsApp Instant Live Chat Widget (Controlled from Sanity Studio) -->
        {configData?.enableWhatsApp && configData?.whatsAppNumber && (
            <WhatsAppWidget
                phoneNumber={configData.whatsAppNumber}
                prefillText={configData.whatsAppPrefillText}
                tooltip={configData.whatsAppTooltip}
            />
        )}

        <!-- 2. Cloudflare Web Analytics (0-Cookie, GDPR-compliant privacy analytics) -->
        {configData?.cloudflareAnalyticsToken && (
            <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${configData.cloudflareAnalyticsToken}"}`}></script>
        )}
    </body>
</html>
