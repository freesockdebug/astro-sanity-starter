---
// src/pages/admin/logins.astro
// Admin Security Audit: 90-Day Login History & Operation Diff Tracker (Saltline Compressed)
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import AdminSearchInput from '@components/admin/AdminSearchInput.astro';
import AdminWorkbenchTableShell from '@components/admin/AdminWorkbenchTableShell.astro';
import TableColumnController from '@components/admin/TableColumnController.astro';
import TableFilter from '@components/admin/TableFilter.astro';
import { requireAdminContext } from '@utils/auth';
import { getDictItems } from '@utils/dicts';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/logins',
  { requiredMenu: 'logins' }
);
if (redirectResponse) return redirectResponse;

const auditActions = await getDictItems(cfEnv, 'audit_actions', true).catch(() => []);
const retentionDays = systemSettings?.login_retention_days || 90;
const initialSearch = Astro.url.searchParams.get('search')?.trim() || '';
const initialTimeWindow = Astro.url.searchParams.get('timeWindow') || 'ALL';

const METRIC_CAPSULES: [string, string, string, string][] = [
  ['metric-sessions', 'Sessions', 'bg-[#f5f5f7] text-[#52525b] border-black/5', 'text-[#1d1d1f]'],
  ['metric-accounts', 'Accounts', 'bg-[#f5f5f7] text-[#52525b] border-black/5', 'text-[#1d1d1f]'],
  ['metric-ips', 'IPs', 'bg-blue-50/80 text-blue-800 border-blue-200/80', 'text-blue-700'],
  ['metric-countries', 'Countries', 'bg-purple-50/80 text-purple-800 border-purple-200/80', 'text-purple-700'],
];
---

<AdminLayout
  title="Login Audit Logs"
  currentTab="logins"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <AdminPageToolbar title="Audit Center" badge={`${retentionDays}d`} badgeColor="emerald" class="flex-nowrap px-3 py-2 sm:px-4 sm:py-2.5 gap-2">
      <div slot="metrics" class="flex items-center gap-1.5 sm:gap-2 min-w-0 flex-1 overflow-x-auto no-scrollbar">
        <div class="flex items-center gap-1 shrink-0 p-0.5 bg-[#f5f5f7] rounded-xl border border-black/5">
          <button type="button" id="tab-btn-logins" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer">Logins</button>
          <button type="button" id="tab-btn-audit" class="px-2.5 py-1 rounded-lg text-[11px] font-medium text-[#52525b] hover:text-black transition-all cursor-pointer">Operation Diff</button>
        </div>
        <div class="h-4 w-px bg-black/10 hidden sm:block shrink-0"></div>
        <div id="logins-metrics-container" class="flex items-center gap-1 sm:gap-1.5 shrink-0 overflow-x-auto no-scrollbar">
          {METRIC_CAPSULES.map(([id, label, wrapCls, valCls]) => (
            <span class={`px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium border flex items-center gap-1 shrink-0 whitespace-nowrap ${wrapCls}`}>
              <span>{label}</span>
              <strong id={id} class={`font-bold ${valCls}`}>-</strong>
            </span>
          ))}
        </div>
      </div>

      <div slot="actions" class="flex items-center gap-2 ml-auto shrink-0">
        <span id="log-count-summary" class="hidden xl:inline font-mono text-[11px] text-[#86868b]">(Loading...)</span>
        <TableFilter timeSelectId="logins-timewindow-select" initialTimeWindow={initialTimeWindow} />
        <AdminSearchInput
          id="logins-search-input"
          clearBtnId="clear-logins-search"
          initialValue={initialSearch}
          placeholder="Search email, IP, city..."
          class="relative flex items-center w-36 md:w-40 lg:w-44 xl:w-56 2xl:w-64"
        />
        <TableColumnController
          controllerBtnId="logins-columns-btn"
          controllerMenuId="logins-columns-menu"
          columnsListId="logins-columns-list"
          countBadgeId="logins-columns-count"
          syncStatusId="logins-columns-sync"
          resetBtnId="logins-columns-reset"
          densityBtnId="logins-density-btn"
          densityLabelId="logins-density-label"
          showDensityToggle={true}
          class="hidden md:inline-flex"
        />
      </div>
    </AdminPageToolbar>

    <AdminWorkbenchTableShell
      containerId="logins-container"
      skeletonId="logins-skeleton"
      contentId="logins-content"
      contentHidden={true}
      showPagination={false}
    />

    <div id="audit-diff-container" class="hidden flex-1 min-h-0 adm-card overflow-hidden flex flex-col">
      <div class="px-3.5 py-2.5 bg-[#fafafa] border-b border-black/5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-[#1d1d1f]">Administrative Operation Diff Logs</span>
          <span class="text-[10px] text-[#86868b]">Indexed audit events</span>
        </div>
        <div class="flex items-center gap-2">
          <label class="text-[11px] text-[#86868b] font-medium hidden sm:inline">Action Filter:</label>
          <select id="audit-action-filter" class="px-2.5 py-1 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black font-semibold text-[#1d1d1f]">
            <option value="">All Actions ({auditActions.length} types)</option>
            {auditActions.map((a) => (
              <option value={a.item_key}>{a.item_label} ({a.item_key})</option>
            ))}
          </select>
        </div>
      </div>
      <div class="flex-1 overflow-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="sticky top-0 bg-[#fbfbfd] border-b border-black/5 z-10">
            <tr>
              <th class="adm-th">Timestamp</th>
              <th class="adm-th">Administrator</th>
              <th class="adm-th">Action</th>
              <th class="adm-th">Target</th>
              <th class="adm-th">Field Changes / Diff</th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-black/5 font-sans text-xs">
            <tr><td colspan="5" class="py-12 text-center text-[#86868b]">Loading operation audit logs...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';
  import { $id, $txt, escapeHtml, formatAdminTime, syncUrlParams, bindSearchAndRefresh } from '@utils/adminWorkbench';
  import { useTableSettings, type ColumnConfig } from '@hooks/useTableSettings';

  let pageAbort: AbortController | null = null;

  function initLoginsPage() {
    if (!$id('logins-container')) return;
    pageAbort?.abort();
    pageAbort = new AbortController();
    const { signal } = pageAbort;

    const DEFAULT_COLUMNS: ColumnConfig[] = [
      { id: 'user', label: 'User Email & ID', defaultWidth: 220, minWidth: 160, visible: true, canHide: false },
      { id: 'ip', label: 'IP Address', defaultWidth: 140, minWidth: 100, visible: true, canHide: true },
      { id: 'location', label: 'Location', defaultWidth: 150, minWidth: 110, visible: true, canHide: true },
      { id: 'user_agent', label: 'Client User-Agent', defaultWidth: 260, minWidth: 160, visible: true, canHide: true },
      { id: 'timestamp', label: 'Login Timestamp', defaultWidth: 160, minWidth: 120, visible: true, canHide: false, pinRight: true, align: 'right' },
    ];

    let allLogins: any[] = [];
    const initialUrl = new URL(window.location.href);
    let currentSearch = initialUrl.searchParams.get('search')?.trim() || '';
    let currentTimeWindow = initialUrl.searchParams.get('timeWindow') || 'ALL';

    const tableSettings = useTableSettings({
      tableKey: 'logins',
      defaultColumns: DEFAULT_COLUMNS,
      defaultDensity: 'cozy',
      controllerBtnEl: $id('logins-columns-btn'),
      controllerMenuEl: $id('logins-columns-menu'),
      columnsListEl: $id('logins-columns-list'),
      countBadgeEl: $id('logins-columns-count'),
      syncStatusEl: $id('logins-columns-sync'),
      resetBtnEl: $id('logins-columns-reset'),
      densityBtnEl: $id('logins-density-btn'),
      densityLabelEl: $id('logins-density-label'),
      onSettingsChange: () => { if (allLogins.length) filterAndRender(); },
      onDensityChange: () => { if (allLogins.length) filterAndRender(); },
    });

    function updateMetrics(logins: any[]) {
      $txt('metric-sessions', logins.length);
      $txt('metric-accounts', new Set(logins.map((l) => (l.email || '').toLowerCase())).size);
      $txt('metric-ips', new Set(logins.map((l) => l.ip).filter(Boolean)).size);
      $txt('metric-countries', new Set(logins.map((l) => l.country).filter(Boolean)).size || 1);
    }

    function renderTable(displayLogins: any[]) {
      const content = $id('logins-content');
      if (!content) return;
      $txt('log-count-summary', `(${displayLogins.length} of ${allLogins.length} events)`);

      if (!displayLogins.length) {
        content.innerHTML = `<div class="py-16 text-center text-xs text-[#86868b]">${currentSearch ? `No login events matching "${escapeHtml(currentSearch)}".` : 'No login activity recorded yet.'}</div>`;
        content.classList.remove('hidden');
        return;
      }

      const mobileCardsHtml = `<div class="block md:hidden divide-y divide-black/5">${displayLogins.map((entry) => {
        const loc = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global');
        const safeEmail = escapeHtml(entry.email || '');
        const safeId = escapeHtml(entry.user_id || '');
        const safeIp = escapeHtml(entry.ip || '—');
        const safeUa = escapeHtml(entry.user_agent || 'Unknown Device');
        return `<div class="p-3.5 space-y-2 bg-white text-xs">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <span class="font-semibold text-[#1d1d1f] truncate block">${safeEmail}</span>
              <span class="font-mono text-[10px] text-[#86868b] truncate block" title="${safeId}">${safeId}</span>
            </div>
            <span class="text-[11px] text-[#86868b] shrink-0 font-mono">${formatAdminTime(entry.created_at, 'full')}</span>
          </div>
          <div class="p-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 space-y-1">
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-mono font-medium text-[#1d1d1f]">${safeIp}</span>
              <span class="text-[#52525b]">📍 ${loc}</span>
            </div>
            <p class="text-[10px] text-[#86868b] truncate" title="${safeUa}">${safeUa}</p>
          </div>
        </div>`;
      }).join('')}</div>`;

      const visibleCols = tableSettings.getVisibleColumns();
      const cellPad = tableSettings.getDensity() === 'compact' ? 'py-1.5 px-3' : 'py-3 px-4';

      const desktopRowsHtml = displayLogins.map((entry) => {
        const loc = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global / Edge');
        const safeEmail = escapeHtml(entry.email || '');
        const safeId = escapeHtml(entry.user_id || '');
        const safeIp = escapeHtml(entry.ip || '');
        const safeUa = escapeHtml(entry.user_agent || 'Unknown Client');
        const dateStr = formatAdminTime(entry.created_at, 'full');

        const cells = visibleCols.map((col) => {
          const w = `style="width: ${col.defaultWidth}px;"`;
          if (col.id === 'user') return `<td ${w} class="${cellPad}"><div class="font-medium text-[#1d1d1f] truncate">${safeEmail}</div><div class="text-[10px] font-mono text-[#86868b] truncate max-w-[200px]" title="${safeId}">${safeId}</div></td>`;
          if (col.id === 'ip') return `<td ${w} class="${cellPad} font-mono text-[11px] text-[#1d1d1f]">${safeIp ? `<span class="px-2 py-0.5 rounded bg-[#f5f5f7] border border-black/5">${safeIp}</span>` : '<span class="text-[#86868b]">—</span>'}</td>`;
          if (col.id === 'location') return `<td ${w} class="${cellPad}"><span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] bg-zinc-100 text-[#1d1d1f] border border-black/5 truncate max-w-[140px]">📍 ${loc}</span></td>`;
          if (col.id === 'user_agent') return `<td ${w} class="${cellPad} text-[11px] text-[#52525b] truncate max-w-xs" title="${safeUa}">${safeUa}</td>`;
          if (col.id === 'timestamp') return `<td ${w} class="${cellPad} text-right whitespace-nowrap font-mono text-[11px]">${dateStr}</td>`;
          return '<td></td>';
        }).join('');
        return `<tr class="hover:bg-[#f5f5f7]/60 transition-colors">${cells}</tr>`;
      }).join('');

      content.innerHTML = `${mobileCardsHtml}<div class="hidden md:block"><table id="logins-main-table" class="w-full text-left text-xs border-collapse table-fixed select-text"><thead class="sticky top-0 z-10 bg-[#fafafa]/95 backdrop-blur-xs shadow-2xs border-b border-black/10"><tr id="logins-header-row"></tr></thead><tbody class="divide-y divide-black/5">${desktopRowsHtml}</tbody></table></div>`;
      content.classList.remove('hidden');

      const loginsTable = $id<HTMLTableElement>('logins-main-table');
      const loginsHeaderRow = $id<HTMLTableRowElement>('logins-header-row');
      if (loginsTable && loginsHeaderRow) tableSettings.renderHeader(loginsHeaderRow, loginsTable);
    }

    function filterAndRender() {
      const q = currentSearch.toLowerCase();
      const now = Date.now();
      const winMap: Record<string, number> = { '24h': 864e5, '7d': 6048e5, '30d': 2592e6 };
      const windowMs = winMap[currentTimeWindow] || 0;

      const filtered = allLogins.filter((l) => {
        if (windowMs > 0 && l.created_at) {
          const raw = String(l.created_at).trim();
          const t = new Date(raw.endsWith('Z') ? raw : `${raw.replace(' ', 'T')}Z`).getTime();
          if (!isNaN(t) && now - t > windowMs) return false;
        }
        return !q || [l.email, l.user_id, l.ip, l.city, l.country].some((v) => (v || '').toLowerCase().includes(q));
      });
      updateMetrics(filtered);
      renderTable(filtered);
    }

    async function loadLogins() {
      const skeleton = $id('logins-skeleton');
      const content = $id('logins-content');
      try {
        await clientCache.fetchWithCache('admin:logins:150', '/api/admin/logins?limit=150', {
          mode: 'swr',
          onData: (data: any) => {
            allLogins = data.logins || [];
            skeleton?.classList.add('hidden');
            filterAndRender();
          },
        });
      } catch (err: any) {
        skeleton?.classList.add('hidden');
        if (content) {
          content.innerHTML = `<div class="py-16 text-center text-xs text-rose-600">Failed to load login audit logs (${escapeHtml(err?.message || '')}). <button type="button" id="retry-logins-btn" class="underline ml-1 cursor-pointer">Retry</button></div>`;
          content.classList.remove('hidden');
          $id('retry-logins-btn')?.addEventListener('click', loadLogins);
        }
      }
    }

    bindSearchAndRefresh({
      searchInputId: 'logins-search-input',
      clearBtnId: 'clear-logins-search',
      debounceMs: 0,
      onSearch: (val) => {
        currentSearch = val;
        syncUrlParams({ search: currentSearch, timeWindow: currentTimeWindow }, { timeWindow: 'ALL' }, false);
        filterAndRender();
      },
      onRefresh: loadLogins,
    });

    const timeSelect = $id<HTMLSelectElement>('logins-timewindow-select');
    if (timeSelect) {
      timeSelect.value = currentTimeWindow;
      timeSelect.addEventListener('change', () => {
        currentTimeWindow = timeSelect.value || 'ALL';
        syncUrlParams({ search: currentSearch, timeWindow: currentTimeWindow }, { timeWindow: 'ALL' }, false);
        filterAndRender();
      });
    }

    window.addEventListener('popstate', () => {
      const u = new URL(window.location.href);
      currentSearch = u.searchParams.get('search')?.trim() || '';
      currentTimeWindow = u.searchParams.get('timeWindow') || 'ALL';
      const inp = $id<HTMLInputElement>('logins-search-input');
      if (inp) inp.value = currentSearch;
      $id('clear-logins-search')?.classList.toggle('hidden', !currentSearch);
      if (timeSelect) timeSelect.value = currentTimeWindow;
      filterAndRender();
    }, { signal });

    // Mode Switcher: Logins vs Operation Audit Diff
    let auditLogsLoaded = false;
    const tabBtnLogins = $id('tab-btn-logins');
    const tabBtnAudit = $id('tab-btn-audit');
    const loginsShell = $id('logins-container');
    const auditDiffContainer = $id('audit-diff-container');
    const metricsContainer = $id('logins-metrics-container');
    const auditActionFilter = $id<HTMLSelectElement>('audit-action-filter');

    const loadAuditLogs = async () => {
      const tbody = $id('audit-table-body');
      if (!tbody) return;
      const actionVal = auditActionFilter?.value || '';
      try {
        const res = await fetch(`/api/admin/audit?limit=100${actionVal ? `&action=${encodeURIComponent(actionVal)}` : ''}`);
        const data: any = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Error');
        const logs: any[] = data.logs || [];
        if (!logs.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-[#86868b]">No admin operations found for this action filter.</td></tr>';
          return;
        }
        tbody.innerHTML = logs.map((log) => {
          let diffHtml = '<span class="text-[10px] text-[#86868b]">-</span>';
          try {
            const diff = log.diff_json ? JSON.parse(log.diff_json) : null;
            if (diff && Object.keys(diff).length) {
              diffHtml = Object.entries(diff).map(([k, v]: [string, any]) => `<span class="inline-block mr-2 text-[10px]"><span class="text-[#86868b]">${escapeHtml(k)}:</span> <span class="text-rose-700 line-through">${escapeHtml(JSON.stringify(v?.before ?? '∅'))}</span> → <span class="text-emerald-700 font-semibold">${escapeHtml(JSON.stringify(v?.after ?? '∅'))}</span></span>`).join('');
            } else if (log.after_json) {
              diffHtml = `<span class="text-[10px] text-[#52525b] font-mono">${escapeHtml(String(log.after_json).slice(0, 120))}</span>`;
            }
          } catch {}
          const act = String(log.action || '');
          const badgeCls = /DELETE|BLOCK|REJECT/.test(act)
            ? 'bg-rose-50 text-rose-700 border-rose-200'
            : /CREATE|APPROVE|SHIP|UPSERT/.test(act)
            ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
            : 'bg-slate-100 text-slate-800 border-slate-200';
          return `<tr class="hover:bg-[#fbfbfd]">
            <td class="adm-td font-mono text-[11px] text-[#86868b] whitespace-nowrap">${formatAdminTime(log.created_at, 'full')}</td>
            <td class="adm-td font-medium text-[#1d1d1f]">${escapeHtml(log.admin_email)}</td>
            <td class="adm-td"><span class="px-2 py-0.5 rounded-md border text-[10px] font-mono font-bold ${badgeCls}">${escapeHtml(act)}</span></td>
            <td class="adm-td font-mono text-[11px] text-[#52525b]">${escapeHtml(log.target_type || '')}${log.target_id ? `:${escapeHtml(log.target_id)}` : ''}</td>
            <td class="adm-td max-w-md truncate">${diffHtml}</td>
          </tr>`;
        }).join('');
      } catch (e: any) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-600">Failed to load audit logs: ${escapeHtml(e.message)}</td></tr>`;
      }
    };

    const setMode = (isAudit: boolean) => {
      if (tabBtnLogins) tabBtnLogins.className = isAudit ? 'px-2.5 py-1 rounded-lg text-[11px] font-medium text-[#52525b] hover:text-black transition-all cursor-pointer' : 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer';
      if (tabBtnAudit) tabBtnAudit.className = !isAudit ? 'px-2.5 py-1 rounded-lg text-[11px] font-medium text-[#52525b] hover:text-black transition-all cursor-pointer' : 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer';
      loginsShell?.classList.toggle('hidden', isAudit);
      metricsContainer?.classList.toggle('hidden', isAudit);
      auditDiffContainer?.classList.toggle('hidden', !isAudit);
      if (isAudit && !auditLogsLoaded) {
        auditLogsLoaded = true;
        loadAuditLogs();
      }
    };

    tabBtnLogins?.addEventListener('click', () => setMode(false));
    tabBtnAudit?.addEventListener('click', () => setMode(true));
    auditActionFilter?.addEventListener('change', loadAuditLogs);

    tableSettings.renderMenu();
    loadLogins();
  }

  initLoginsPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('logins-container')) initLoginsPage();
  });
</script>