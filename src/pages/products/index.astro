---
// src/pages/products/index.astro
import Layout from '@layouts/Layout.astro';
import { AppleProductGridSkeleton } from '@components/index';
import { client } from '@utils/sanity-client';
import { PRODUCT_CARD_FIELDS, CATEGORY_FIELDS, ProductService, fetchCatalogCategories } from '@data/products';
import { CONFIG_QUERY_OBJ, SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { SanityImageService } from '@utils/image';
import { DEFAULT_CATALOG, DEFAULT_RFQ } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue, getLocalizedPath } from '@i18n';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Scheme 2: Single Aggregated GROQ Query - combines 5 independent API calls into 1 single roundtrip
let batchData: any = null;
try {
  batchData = await client.fetch(`{
    "products": *[_type == "product"] | order(_createdAt asc) ${PRODUCT_CARD_FIELDS},
    "categories": *[_type == "category"] | order(order asc, _createdAt asc) ${CATEGORY_FIELDS},
    "siteConfig": *[_type == "siteConfig"][0] ${CONFIG_QUERY_OBJ},
    "rfqSettings": *[_type == "rfqSettings"][0],
    "catalogSettings": *[_type == "catalogSettings"][0]
  }`);
} catch (e) {
  console.error("Failed to batch-fetch catalog data from Sanity:", e);
}

// Pre-populate service caches unconditionally so Layout, QuoteDrawer, and Filter tabs make 0 additional API requests
SiteConfigService.seed(batchData?.siteConfig);
RfqSettingsService.seed(batchData?.rfqSettings);
ProductService.seed({
  products: batchData?.products || [],
  categories: batchData?.categories || [],
  catalogSettings: batchData?.catalogSettings || null
});

const mergedProducts = (batchData?.products || []).map((p: any) => ProductService.normalize(p, 480));
const siteConfig = batchData?.siteConfig;
const rfqSettings = batchData?.rfqSettings;
const catalogSettings = batchData?.catalogSettings;

const cardQuoteText = getLocalizedValue(rfqSettings?.cardQuoteBtnText, currentLang, t('catalog.cardQuoteBtn'));
const allLabel = getLocalizedValue(catalogSettings?.allSilhouettesLabel, currentLang, t('catalog.allSilhouettes'));
const unitPairLabel = t('catalog.unitPair');

// 2. Resolve aggregated categories & counts via data service layer (instantly from memory)
const CATEGORIES = await fetchCatalogCategories(mergedProducts, allLabel);

const BATCH_SIZE = 20;
const minimalProducts = mergedProducts.map((p: any) => {
  const locTitle = getLocalizedValue(p.title, currentLang);
  const locShortTitle = getLocalizedValue(p.shortTitle, currentLang) || locTitle;
  return {
    id: p.id,
    slug: p.slug,
    title: locTitle,
    shortTitle: locShortTitle,
    category: p.category,
    image: p.image,
    colors: p.colors,
    leadTime: p.leadTime,
    composition: getLocalizedValue(p.composition, currentLang),
    price: p.price,
    currency: p.currency,
    currencySymbol: p.currencySymbol || '$',
    moq: p.moq,
    unit: p.unit || 'Pairs',
    sku: p.sku,
    tagline: getLocalizedValue(p.tagline, currentLang),
    gauge: p.gauge
  };
});
const initialProducts = minimalProducts.slice(0, BATCH_SIZE);
const catalogJson = JSON.stringify(minimalProducts);

const firstCardImg = mergedProducts[0]?.image;
const catalogHeroPreload = firstCardImg && typeof firstCardImg === 'string' && (firstCardImg.includes('cdn.sanity.io') || firstCardImg.includes('/cdn-image/'))
  ? {
      src: SanityImageService.thumbnail(firstCardImg, 480),
      srcset: SanityImageService.srcSet(firstCardImg, [240, 480]),
      sizes: '(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px',
    }
  : undefined;
---

<Layout
  title={getLocalizedValue(catalogSettings?.metaTitle, currentLang, t('catalog.title'))}
  description={getLocalizedValue(catalogSettings?.metaDescription, currentLang, t('catalog.subtitle'))}
  image={mergedProducts[0]?.image}
  preloadHeroImage={catalogHeroPreload}
>
  <!-- Main Catalog Container with Wide Responsive Boundaries (Compact Bottom Spacing) -->
  <main class="catalog-container min-h-screen bg-white text-[#1d1d1f] pt-14 sm:pt-18 pb-6 sm:pb-8 border-t border-black/5">
    
    <!-- 1. Catalog Hero Header (Apple Rail Narrow) -->
    <section class="catalog-hero-header apple-rail-narrow text-center mb-6 sm:mb-9 space-y-1.5 sm:space-y-2.5">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f5f5f7] border border-black/5 text-[11px] font-semibold text-[#52525b] uppercase tracking-wider">
        <span>{getLocalizedValue(catalogSettings?.badgeText, currentLang, t('catalog.badge'))}</span>
      </div>
      <h1 class="fluid-section-title font-semibold tracking-tight text-[#1d1d1f]">
        {getLocalizedValue(catalogSettings?.title, currentLang, t('catalog.title'))}
      </h1>
      <p class="text-xs sm:text-sm text-[#52525b] max-w-xl mx-auto font-normal leading-relaxed">
        {getLocalizedValue(catalogSettings?.subtitle, currentLang, t('catalog.subtitle'))}
      </p>
    </section>

    <!-- 2. Sticky Control Toolbar: Search & Category Filter Rail -->
    <div class="catalog-sticky-toolbar sticky top-12 z-40 bg-white/95 backdrop-blur-md border-y border-black/5 py-2.5 mb-6 transition-shadow shadow-xs">
      <div class="apple-rail-wide flex flex-col md:flex-row md:items-center justify-between gap-3">
        
        <!-- Category Filter Tabs (Horizontal Swipe on Mobile) -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" id="category-filter-rail">
          {CATEGORIES.map((cat) => (
            <button
              type="button"
              data-category-id={cat.id}
              class={`category-tab-btn shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all cursor-pointer flex items-center gap-1.5 ${
                cat.id === 'all'
                  ? 'bg-[#1d1d1f] text-white shadow-sm'
                  : 'bg-[#f5f5f7] text-[#1d1d1f] hover:bg-[#e8e8ed] border border-black/5'
              }`}
            >
              <span>{getLocalizedValue(cat.label, currentLang)}</span>
              <span class={`text-[10px] px-1.5 py-0.2 rounded-full font-mono ${
                cat.id === 'all' ? 'bg-white/20 text-white' : 'bg-black/5 text-[#404040]'
              }`}>
                {cat.count}
              </span>
            </button>
          ))}
        </div>

        <!-- Search Bar, Sorting Dropdown & Compact Count Indicator -->
        <div class="flex items-center gap-2 shrink-0">
          <!-- Live Count Capsule: Consolidated into toolbar to eliminate extra vertical row -->
          <div class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#f5f5f7] border border-black/5 text-[11px] font-mono text-[#71717a] shrink-0">
            <span>{t('catalog.showing')}</span>
            <span id="displayed-count-label" class="font-semibold text-[#18181b]">{Math.min(initialProducts.length, mergedProducts.length)}</span>
            <span>{t('catalog.of')}</span>
            <span id="total-count-label" class="font-semibold text-[#18181b]">{mergedProducts.length}</span>
            <span class="hidden md:inline">{t('catalog.styles')}</span>
          </div>

          <!-- Realtime Search Input -->
          <div class="relative flex-1 md:w-48 lg:w-52">
            <label for="catalog-search-input" class="sr-only">{t('catalog.searchPlaceholder')}</label>
            <svg class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[#52525b] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="catalog-search-input"
              aria-label={t('catalog.searchPlaceholder')}
              placeholder={getLocalizedValue(catalogSettings?.searchPlaceholder, currentLang, t('catalog.searchPlaceholder'))}
              class="w-full pl-8 pr-7 py-1.5 text-xs rounded-full bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b] transition-all"
            />
            <button
              type="button"
              id="catalog-search-clear"
              aria-label={t('rfq.clearAll')}
              class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-[#52525b] hover:text-black text-xs"
              title={t('rfq.clearAll')}
            >
              ✕
            </button>
          </div>

          <!-- Sort Select -->
          <label for="catalog-sort-select" class="sr-only">{t('catalog.sortFeatured')}</label>
          <select
            id="catalog-sort-select"
            aria-label={t('catalog.sortFeatured')}
            class="px-2.5 py-1.5 text-xs rounded-full bg-[#f5f5f7] border border-black/10 text-[#1d1d1f] focus:outline-none focus:border-black cursor-pointer font-medium"
          >
            <option value="featured">{t('catalog.sortFeatured')}</option>
            <option value="moq-asc">{t('catalog.sortMoq')}</option>
            <option value="title-asc">{t('catalog.sortTitle')}</option>
          </select>

          <!-- Active Category Indicator Hook (Preserved for reactive script compatibility) -->
          <span id="active-category-indicator" class="hidden text-[11px] font-medium text-[#18181b]">
            {allLabel}
          </span>
        </div>
      </div>
    </div>

    <!-- 3. Product Catalog Grid Area: Adaptive Column System -->
    <div class="apple-rail-wide">

      <!-- Card Grid Responsive Column Breakpoints:
           - 移动端手机 (<640px): 2 列 (grid-cols-2)
           - 平板设备 (640px~1023px): 3~4 列 (sm:grid-cols-3 md:grid-cols-4)
           - 普通电脑/矮屏 (1024px~1279px): 5 列 (lg:grid-cols-5)
           - 中大尺寸电脑 (1280px~1759px，含1536px): 6 列 (xl:grid-cols-6)
           - 超大外接显示器 (>=1760px): 7 列 (由 globals.css 权威保证，防止类名层叠优先级错位)
      -->
      <div
        id="products-grid"
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5 sm:gap-3.5 lg:gap-x-4 lg:gap-y-5 min-h-[50vh]"
      >
        {initialProducts.map((item: any, idx: number) => (
          <div class="group shrink-0 h-full rounded-2xl bg-white border border-black/8 hover:border-black/20 hover:shadow-lg transition-all duration-300 p-2 sm:p-2.5 flex flex-col justify-between" data-product-id={item.id}>
            <div class="flex-1 min-h-0 flex flex-col">
              <!-- 1. Taobao Shelf Image Box: 1:1 Aspect Ratio on top with Apple Progressive Skeleton Shimmer -->
              <a
                href={getLocalizedPath(`/products/${item.slug}`, currentLang)}
                class="apple-img-wrapper block relative w-full aspect-square rounded-xl overflow-hidden bg-[#f5f5f7] apple-skeleton-surface my-0 group-hover:opacity-95 transition-all shrink-0"
              >
                <img
                  src={item.image}
                  srcset={SanityImageService.srcSet(item.image, [240, 480]) || undefined}
                  sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                  alt={getLocalizedValue(item.title, currentLang)}
                  class="catalog-card-img w-full h-full object-cover transform transition-all duration-500 group-hover:scale-105"
                  loading={idx < 4 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                  decoding="async"
                  width="240"
                  height="240"
                  onload="this.parentElement && this.parentElement.classList.add('apple-img-loaded')"
                />
                <div class="absolute top-1.5 left-1.5 z-10 px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-[9px] font-medium text-white tracking-tight">
                  {item.category ? item.category.toUpperCase() : 'OEM'}
                </div>
              </a>

              <!-- 2. Taobao Colorway / Mini Swatch Row -->
              <div class="shrink-0 flex items-center justify-between pt-2 pb-1 px-0.5">
                <div class="flex items-center gap-1">
                  {(item.colors || []).slice(0, 4).map((hex: string) => (
                    <span class="w-3.5 h-3.5 flex items-center justify-center rounded-full hover:scale-125 transition-transform" title={`Color: ${hex}`}>
                      <span class="w-2.5 h-2.5 rounded-full border border-black/15 shadow-2xs block" style={`background-color: ${hex}`}></span>
                    </span>
                  ))}
                </div>
                <span class="text-[10px] text-[#52525b] font-mono">{item.leadTime || '15-20d'}</span>
              </div>

              <!-- 3. Taobao Title: Strict 2-line clamp with fixed 36px height (18px line-height) -->
              <div class="shrink-0 h-[36px] mt-0.5 px-0.5">
                <a href={getLocalizedPath(`/products/${item.slug}`, currentLang)} class="block">
                  <h3 class="text-xs font-medium text-[#1d1d1f] group-hover:text-[#ff5000] transition-colors line-clamp-2 leading-[18px]" title={getLocalizedValue(item.title, currentLang)}>
                    {getLocalizedValue(item.shortTitle || item.title, currentLang)}
                  </h3>
                </a>
              </div>

              <!-- 4. Composition subtitle -->
              <p class="text-[10px] text-[#52525b] px-0.5 mt-1 line-clamp-1 truncate">{item.composition || 'Premium Knit'}</p>
            </div>

            <!-- 5. Wholesale Price & Action Bottom Row -->
            <div class="shrink-0 mt-2.5 pt-2 border-t border-black/5 flex items-center justify-between px-0.5">
              <div class="flex flex-col">
                <div class="flex items-baseline gap-0.5 text-[#1d1d1f] font-semibold leading-none">
                  <span class="text-[10px] font-mono">{item.currencySymbol || item.currency || '$'}</span>
                  <span class="text-sm font-mono tracking-tight font-bold">{item.price}</span>
                  <span class="text-[9px] text-[#52525b] font-normal ml-0.5">/{unitPairLabel}</span>
                </div>
                <span class="text-[9px] text-[#52525b] font-mono mt-0.5">{t('catalog.moqPrefix')} {item.moq}</span>
              </div>

              <button
                type="button"
                class="btn-catalog-quote px-2.5 py-1 rounded-full text-[10px] font-medium bg-[#1d1d1f] hover:bg-[#ff5000] text-white transition-all cursor-pointer flex items-center gap-1 shadow-2xs shrink-0"
                data-id={item.id}
                data-title={item.shortTitle || item.title}
                data-sku={item.sku || item.id}
                data-image={item.image}
                data-moq={item.moq || '200 Pairs'}
                data-variant={item.composition || 'Standard Spec'}
              >
                <span>+</span>
                <span>{cardQuoteText}</span>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Apple Design Language Filter / Sort Transition Skeleton Grid -->
      <AppleProductGridSkeleton id="catalog-filter-skeleton" count={12} class="hidden min-h-[50vh]" />

      <!-- Zero Results Empty State -->
      <div id="catalog-empty-state" class="hidden py-20 text-center space-y-3">
        <div class="w-12 h-12 rounded-full bg-[#f5f5f7] text-[#86868b] flex items-center justify-center mx-auto border border-black/5">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#1d1d1f]">{getLocalizedValue(catalogSettings?.emptyStateHeading, currentLang, t('catalog.emptyHeading'))}</h3>
        <p class="text-xs text-[#86868b] max-w-sm mx-auto">
          {getLocalizedValue(catalogSettings?.emptyStateText, currentLang, t('catalog.emptyText'))}
        </p>
        <button
          type="button"
          id="catalog-reset-btn"
          class="px-4 py-1.5 rounded-full text-xs font-medium bg-[#1d1d1f] text-white hover:bg-black transition-all cursor-pointer"
        >
          {t('catalog.resetFilters')}
        </button>
      </div>

      <!-- 4. Infinite Scroll Sentinel & Apple Skeleton Next-Batch Loader -->
      <div id="catalog-load-trigger" class="w-full min-h-[56px] py-4 flex flex-col items-center justify-center">
        <!-- Apple Skeleton Row while fetching next infinite-scroll batch -->
        <div id="catalog-loading-spinner" class="hidden w-full flex-col items-center gap-3">
          <AppleProductGridSkeleton count={6} class="w-full" />
          <span class="text-[11px] text-[#86868b] font-medium tracking-tight">{t('catalog.loadingMore')}</span>
        </div>

        <!-- End-of-List Divider (Compact padding) -->
        <div id="catalog-all-loaded-notice" class="hidden items-center justify-center gap-3 text-xs text-[#86868b] select-none">
          <span class="w-10 sm:w-16 h-px bg-black/10"></span>
          <span class="font-normal tracking-wide">{getLocalizedValue(catalogSettings?.endOfCatalogText, currentLang, t('catalog.endOfList'))}</span>
          <span class="w-10 sm:w-16 h-px bg-black/10"></span>
        </div>
      </div>
    </div>
  </main>

  <!-- Lightweight compact catalog data in standard application/json (avoids Astro define:vars double escaping) -->
  <script type="application/json" id="catalog-products-data" set:html={catalogJson}></script>
</Layout>

<script define:vars={{ cardQuoteText, currentLang, moqPrefix: t('catalog.moqPrefix'), unitPairLabel }}>
  // Catalog State Management
  const catalogDataEl = document.getElementById('catalog-products-data');
  const allProducts = catalogDataEl ? JSON.parse(catalogDataEl.textContent || '[]') : [];
  const BATCH_SIZE = 20; // 4 full rows on 5-col desktop grid, 5 full rows on 4-col tablet grid
  let currentCategory = 'all';
  let searchQuery = '';
  let currentSort = 'featured';
  let displayedCount = 0;
  let filteredList = [];

  const gridContainer = document.getElementById('products-grid');
  const filterSkeleton = document.getElementById('catalog-filter-skeleton');
  const emptyState = document.getElementById('catalog-empty-state');
  const allLoadedNotice = document.getElementById('catalog-all-loaded-notice');
  const loadingSpinner = document.getElementById('catalog-loading-spinner');
  const displayedCountLabel = document.getElementById('displayed-count-label');
  const totalCountLabel = document.getElementById('total-count-label');
  const activeCategoryIndicator = document.getElementById('active-category-indicator');
  const searchInput = document.getElementById('catalog-search-input');
  const searchClearBtn = document.getElementById('catalog-search-clear');
  const sortSelect = document.getElementById('catalog-sort-select');
  const loadTriggerSentinel = document.getElementById('catalog-load-trigger');
  let skeletonTimer = null;

  function hydrateCompletedImages(scope) {
    const root = scope || document;
    const imgs = root.querySelectorAll('.catalog-card-img');
    imgs.forEach((img) => {
      if (img.complete && img.parentElement) {
        img.parentElement.classList.add('apple-img-loaded');
      }
    });
  }

  // Filter & Sort Logic (Immutable source, defensive parsing, clean priority)
  function updateFilteredProducts(withSkeletonTransition) {
    let result = allProducts.filter((item) => {
      // 1. Category filter
      const matchesCategory = currentCategory === 'all' || item.category === currentCategory;
      if (!matchesCategory) return false;

      // 2. Search query filter: filter(Boolean) prevents matching literal "undefined" string
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const searchable = [
          item.title,
          item.shortTitle,
          item.sku,
          item.tagline,
          item.composition,
          item.gauge
        ].filter(Boolean).join(' ').toLowerCase();
        return searchable.includes(q);
      }
      return true;
    });

    // 3. Sorting (Defensive parsing prevents runtime errors on null/non-string moq)
    if (currentSort === 'moq-asc') {
      result.sort((a, b) => {
        const numA = (a.moq ? parseInt(String(a.moq).replace(/\D/g, ''), 10) : 0) || 9999;
        const numB = (b.moq ? parseInt(String(b.moq).replace(/\D/g, ''), 10) : 0) || 9999;
        return numA - numB;
      });
    } else if (currentSort === 'title-asc') {
      result.sort((a, b) => {
        const titleA = (a.shortTitle || a.title || '').trim();
        const titleB = (b.shortTitle || b.title || '').trim();
        return titleA.localeCompare(titleB);
      });
    }
    // When currentSort === 'featured', result naturally retains Sanity's curated default order

    filteredList = result;

    // Reset pagination
    displayedCount = 0;
    if (gridContainer) gridContainer.innerHTML = '';

    if (withSkeletonTransition && filterSkeleton && gridContainer) {
      clearTimeout(skeletonTimer);
      gridContainer.classList.add('hidden');
      if (emptyState) emptyState.classList.add('hidden');
      filterSkeleton.classList.remove('hidden');
      skeletonTimer = setTimeout(() => {
        filterSkeleton.classList.add('hidden');
        renderNextBatch();
      }, 140);
    } else {
      if (filterSkeleton) filterSkeleton.classList.add('hidden');
      renderNextBatch();
    }
  }

  // Create Product Card HTML matching Taobao Shelf Layout (Image-Top, 2-line title, Price/MOQ block)
  function createCardElement(item) {
    const card = document.createElement('div');
    card.className = "group shrink-0 h-full rounded-2xl bg-white border border-black/8 hover:border-black/20 hover:shadow-lg transition-all duration-300 p-2 sm:p-2.5 flex flex-col justify-between";

    const productUrlPrefix = currentLang && currentLang !== 'en' ? `/${currentLang}/products/` : '/products/';

    const colorDots = (item.colors || [])
      .slice(0, 4)
      .map(
        (hex) => `
        <span class="w-3.5 h-3.5 flex items-center justify-center rounded-full hover:scale-125 transition-transform" title="Color: ${hex}">
          <span class="w-2.5 h-2.5 rounded-full border border-black/15 shadow-2xs block" style="background-color: ${hex}"></span>
        </span>`
      )
      .join('');

    card.innerHTML = `
      <div class="flex-1 min-h-0 flex flex-col">
        <!-- 1. Taobao Shelf Image Box: 1:1 Aspect Ratio on top with Apple Progressive Skeleton Shimmer -->
        <a
          href="${productUrlPrefix}${item.slug}"
          class="apple-img-wrapper block relative w-full aspect-square rounded-xl overflow-hidden bg-[#f5f5f7] apple-skeleton-surface my-0 group-hover:opacity-95 transition-all shrink-0"
        >
          <img
            src="${item.image}"
            alt="${item.title}"
            class="catalog-card-img w-full h-full object-cover transform transition-all duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
            width="240"
            height="240"
            onload="this.parentElement && this.parentElement.classList.add('apple-img-loaded')"
          />
          <div class="absolute top-1.5 left-1.5 z-10 px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-[9px] font-medium text-white tracking-tight">
            ${item.category ? item.category.toUpperCase() : 'OEM'}
          </div>
        </a>

        <!-- 2. Taobao Colorway / Mini Swatch Row -->
        <div class="shrink-0 flex items-center justify-between pt-2 pb-1 px-0.5">
          <div class="flex items-center gap-1">
            ${colorDots}
          </div>
          <span class="text-[10px] text-[#52525b] font-mono">${item.leadTime || '15-20d'}</span>
        </div>

        <!-- 3. Taobao Title: Strict 2-line clamp with fixed 36px height (18px line-height) -->
        <div class="shrink-0 h-[36px] mt-0.5 px-0.5">
          <a href="${productUrlPrefix}${item.slug}" class="block">
            <h3 class="text-xs font-medium text-[#1d1d1f] group-hover:text-[#ff5000] transition-colors line-clamp-2 leading-[18px]" title="${item.title}">
              ${item.shortTitle || item.title}
            </h3>
          </a>
        </div>

        <!-- 4. Composition subtitle -->
        <p class="text-[10px] text-[#52525b] px-0.5 mt-1 line-clamp-1 truncate">${item.composition || 'Premium Knit'}</p>
      </div>

      <!-- 5. Wholesale Price & Action Bottom Row -->
      <div class="shrink-0 mt-2.5 pt-2 border-t border-black/5 flex items-center justify-between px-0.5">
        <div class="flex flex-col">
          <div class="flex items-baseline gap-0.5 text-[#1d1d1f] font-semibold leading-none">
            <span class="text-[10px] font-mono">${item.currencySymbol || item.currency || '$'}</span>
            <span class="text-sm font-mono tracking-tight font-bold">${item.price}</span>
            <span class="text-[9px] text-[#52525b] font-normal ml-0.5">/${unitPairLabel}</span>
          </div>
          <span class="text-[9px] text-[#52525b] font-mono mt-0.5">${moqPrefix} ${item.moq}</span>
        </div>

        <button
          type="button"
          class="btn-catalog-quote px-2.5 py-1 rounded-full text-[10px] font-medium bg-[#1d1d1f] hover:bg-[#ff5000] text-white transition-all cursor-pointer flex items-center gap-1 shadow-2xs shrink-0"
          data-id="${item.id}"
          data-title="${item.shortTitle || item.title}"
          data-sku="${item.sku || item.id}"
          data-image="${item.image}"
          data-moq="${item.moq || '200 Pairs'}"
          data-variant="${item.composition || 'Standard Spec'}"
        >
          <span>+</span>
          <span>${cardQuoteText}</span>
        </button>
      </div>
    `;

    hydrateCompletedImages(card);
    return card;
  }

  // Global Event Delegation for Product Catalog Quote Buttons
  document.addEventListener('click', (e) => {
    const target = e.target;
    const quoteBtn = target && target.closest ? target.closest('.btn-catalog-quote') : null;
    if (!quoteBtn) return;

    e.preventDefault();
    e.stopPropagation();

    const rawMoq = quoteBtn.dataset.moq || '200 Pairs';
    const moqNum = parseInt(rawMoq.replace(/\D/g, ''), 10) || 200;
    const quoteItem = {
      id: quoteBtn.dataset.id || 'product',
      title: quoteBtn.dataset.title || 'Product',
      sku: quoteBtn.dataset.sku || 'SKU',
      imageUrl: quoteBtn.dataset.image || '',
      moq: rawMoq,
      variant: quoteBtn.dataset.variant || 'Standard Spec',
      quantity: moqNum,
    };

    if (typeof window !== 'undefined' && window.addToQuoteAndOpen) {
      window.addToQuoteAndOpen(quoteItem);
    } else if (typeof window !== 'undefined' && window.addToQuote) {
      window.addToQuote(quoteItem);
      if (window.openQuoteDrawer) window.openQuoteDrawer();
    } else {
      window.__quoteQueue = window.__quoteQueue || [];
      window.__quoteQueue.push(quoteItem);
      if (typeof window !== 'undefined' && window.openQuoteDrawer) {
        window.openQuoteDrawer();
      } else {
        const toggle = document.getElementById('quote-drawer-toggle');
        if (toggle) toggle.checked = true;
      }
    }
  });

  function bindQuoteButtons(scope) {
    // Kept as no-op for backward compatibility with existing callers
  }

  // Render next slice of batch items
  function renderNextBatch() {
    if (!gridContainer) return;

    const totalFiltered = filteredList.length;
    if (totalCountLabel) totalCountLabel.textContent = String(totalFiltered);

    if (totalFiltered === 0) {
      gridContainer.classList.add('hidden');
      if (emptyState) emptyState.classList.remove('hidden');
      if (allLoadedNotice) {
        allLoadedNotice.classList.add('hidden');
        allLoadedNotice.classList.remove('flex');
      }
      if (displayedCountLabel) displayedCountLabel.textContent = '0';
      return;
    }

    gridContainer.classList.remove('hidden');
    if (emptyState) emptyState.classList.add('hidden');

    const nextBatch = filteredList.slice(displayedCount, displayedCount + BATCH_SIZE);
    nextBatch.forEach((item) => {
      const card = createCardElement(item);
      gridContainer.appendChild(card);
    });

    displayedCount += nextBatch.length;
    if (displayedCountLabel) displayedCountLabel.textContent = String(displayedCount);

    // Update End of Catalog Notice and Spinner visibility
    if (displayedCount >= totalFiltered) {
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (allLoadedNotice) {
        allLoadedNotice.classList.remove('hidden');
        allLoadedNotice.classList.add('flex');
      }
    } else {
      if (allLoadedNotice) {
        allLoadedNotice.classList.add('hidden');
        allLoadedNotice.classList.remove('flex');
      }
      if (loadingSpinner) {
        loadingSpinner.classList.remove('hidden');
        loadingSpinner.classList.add('flex');
      }
    }
  }

  // IntersectionObserver for seamless Infinite Scroll lazy-loading
  if ('IntersectionObserver' in window && loadTriggerSentinel) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && displayedCount < filteredList.length) {
          renderNextBatch();
        }
      });
    }, { rootMargin: '400px' });
    observer.observe(loadTriggerSentinel);
  }

  // Category Tab Click Handler
  const tabButtons = document.querySelectorAll('.category-tab-btn');
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-category-id') || 'all';
      currentCategory = targetCat;

      // Update Active visual style
      tabButtons.forEach((b) => {
        const isCurrent = b === btn;
        b.className = `category-tab-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium transition-all cursor-pointer flex items-center gap-1.5 ${
          isCurrent
            ? 'bg-[#1d1d1f] text-white shadow-sm'
            : 'bg-[#f5f5f7] text-[#1d1d1f] hover:bg-[#e8e8ed] border border-black/5'
        }`;
        const badge = b.querySelector('span:last-child');
        if (badge) {
          badge.className = `text-[10px] px-1.5 py-0.2 rounded-full font-mono ${
            isCurrent ? 'bg-white/20 text-white' : 'bg-black/5 text-[#86868b]'
          }`;
        }
      });

      if (activeCategoryIndicator) {
        activeCategoryIndicator.textContent = btn.querySelector('span:first-child')?.textContent || 'All Silhouettes';
      }

      // Sync URL parameter without page reload
      const url = new URL(window.location.href);
      if (targetCat === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', targetCat);
      }
      window.history.replaceState({}, '', url.toString());

      updateFilteredProducts(true);
    });
  });

  // Search input with debounce
  let searchDebounceTimer;
  searchInput?.addEventListener('input', (e) => {
    clearTimeout(searchDebounceTimer);
    const val = (e.target).value.trim();
    if (searchClearBtn) {
      searchClearBtn.classList.toggle('hidden', val.length === 0);
    }
    searchDebounceTimer = setTimeout(() => {
      searchQuery = val;
      updateFilteredProducts(false);
    }, 250);
  });

  // Clear search
  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      (searchInput).value = '';
      searchQuery = '';
      searchClearBtn.classList.add('hidden');
      updateFilteredProducts(false);
    }
  });

  // Reset all filters
  document.getElementById('catalog-reset-btn')?.addEventListener('click', () => {
    currentCategory = 'all';
    searchQuery = '';
    if (searchInput) (searchInput).value = '';
    if (searchClearBtn) searchClearBtn.classList.add('hidden');
    const allTab = document.querySelector('[data-category-id="all"]');
    if (allTab) (allTab).click();
  });

  // Sort dropdown
  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target).value;
    updateFilteredProducts(true);
  });

  // Handle URL deep linking (e.g. /products?category=silk)
  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    if (cat && cat !== 'all') {
      const matchBtn = document.querySelector(`[data-category-id="${cat}"]`);
      if (matchBtn) {
        matchBtn.click();
        return;
      }
    }
    // Default initial view: seamlessly hydrate SSR-rendered cards without clearing DOM!
    filteredList = allProducts.slice();
    displayedCount = Math.min(BATCH_SIZE, filteredList.length);
    if (totalCountLabel) totalCountLabel.textContent = String(filteredList.length);
    if (displayedCountLabel) displayedCountLabel.textContent = String(displayedCount);
    if (gridContainer) {
      bindQuoteButtons(gridContainer);
      hydrateCompletedImages(gridContainer);
    }
    if (displayedCount >= filteredList.length) {
      if (allLoadedNotice) {
        allLoadedNotice.classList.remove('hidden');
        allLoadedNotice.classList.add('flex');
      }
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
    } else {
      if (loadingSpinner) {
        loadingSpinner.classList.remove('hidden');
        loadingSpinner.classList.add('flex');
      }
    }
  }

  // Initial Boot
  initFromUrl();
</script>
