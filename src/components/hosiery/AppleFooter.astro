---
// src/components/hosiery/AppleFooter.astro
import { fetchData } from '@data/siteConfig';
import { fetchRfqSettings } from '@data/rfqSettings';

const config = Astro.props.config ?? await fetchData();
const rfqSettings = await fetchRfqSettings();
const header = config?.header;
const footer = config?.footer;

const rawBrandTitle = header?.title || "Gwenvenni";
const brandTitle = rawBrandTitle.split(/\s*\|\s*/)[0].trim();
const rawFooterText = footer?.text || "© 2026 Gwenvenni Co., Ltd. All rights reserved.";
const footerBio = footer?.description || "Specialized manufacturer of 200-needle luxury women's hosiery, silk crew socks, and seamless second-skin tights for global fashion labels.";
const statusBadge = footer?.statusBadge || "Sample Room: 48h Global Dispatch Active";

function cleanEnglishLabel(text: string) {
  if (!text) return "";
  // Strip out Chinese characters and brackets like "(款式系列)" or "（款式系列）"
  return text.replace(/[\(（][^\)）]*[\u4e00-\u9fa5]+[^\)）]*[\)）]/g, "").replace(/[\u4e00-\u9fa5]+/g, "").trim();
}

const cleanFooterText = cleanEnglishLabel(rawFooterText) || "© 2026 Gwenvenni Co., Ltd. All rights reserved.";

const defaultColumns = [
  {
    title: brandTitle,
    links: [
      { label: "Overview", url: "/" },
      { label: "Hero Weave", url: "#hero" },
      { label: "Technical Architecture", url: "#specs" },
      { label: "Ready-to-Order", url: "#collections" }
    ]
  },
  {
    title: "Hosiery Lines",
    links: [
      { label: "Double Ruffle Lace", url: "/products/gwenvenni-double-ruffle-lace-socks" },
      { label: "Mulberry Silk Loafers", url: "#collections" },
      { label: "Ribbed Cashmere Crews", url: "#collections" },
      { label: "15D Seamless Tights", url: "#collections" }
    ]
  },
  {
    title: "B2B Services",
    links: [
      { label: "Wholesale Quote (RFQ)", url: "#" },
      { label: "Custom Pantone Dyeing", url: "#manufacturing" },
      { label: "Private Label Packaging", url: "#manufacturing" },
      { label: "Rapid 72h Prototyping", url: "#manufacturing" }
    ]
  },
  {
    title: "Certifications",
    links: [
      { label: "OEKO-TEX Standard 100", url: "#specs" },
      { label: "CPSIA Certified Safe", url: "#specs" },
      { label: "GOTS Organic Cotton", url: "#specs" },
      { label: "ISO 9001:2015", url: "#specs" }
    ]
  },
  {
    title: "Direct Inquiries",
    links: [
      { label: "Order Swatch Kit", url: "#inquiry" },
      { label: "Request OEM Quote", url: "#inquiry" },
      { label: "Factory Audit Tour", url: "#manufacturing" },
      { label: "contact@gwenvenni.com", url: "mailto:contact@gwenvenni.com" }
    ]
  }
];

const rawColumns = (footer?.columns && footer.columns.length > 0) ? footer.columns : defaultColumns;
const columns = rawColumns.map((col: any) => ({
  ...col,
  title: cleanEnglishLabel(col.title),
  links: col.links?.map((l: any) => ({
    ...l,
    label: cleanEnglishLabel(l.label)
  }))
}));

const defaultLegalLinks = [
  { label: "Privacy Policy", url: "#" },
  { label: "Supply Agreement", url: "#" },
  { label: "Export Compliance", url: "#" }
];

const rawLegalLinks = (footer?.legalLinks && footer.legalLinks.length > 0) ? footer.legalLinks : defaultLegalLinks;
const legalLinks = rawLegalLinks.map((l: any) => ({
  ...l,
  label: cleanEnglishLabel(l.label)
}));
---

<footer class="bg-[#f5f5f7] text-[#86868b] py-6 sm:py-8 border-t border-black/10 text-[11px] sm:text-[12px] leading-normal font-normal">
  <div class="apple-rail-footer space-y-4 sm:space-y-5">
    <!-- Apple-style Footnote / Status Bar -->
    <div class="pb-3 border-b border-black/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] text-[#86868b]">
      <p class="max-w-2xl leading-relaxed text-[#6e6e73]">
        {footerBio}
      </p>
      <div class="flex items-center gap-1.5 flex-shrink-0 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span class="text-[#1d1d1f] font-mono text-[11px]">{statusBadge}</span>
      </div>
    </div>

    <!-- Apple Directory: Mobile Accordion (Tap to Expand), Desktop 5-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-5 md:gap-x-6 md:gap-y-4 pt-1 border-t border-black/10 md:border-none">
      {columns.map((col: any) => (
        <details class="apple-footer-col group border-b border-black/10 md:border-none py-2.5 md:py-0">
          <summary class="font-semibold text-[#1d1d1f] tracking-tight flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none md:cursor-default py-0.5 md:py-0">
            <span>{col.title}</span>
            <span class="md:hidden text-[#86868b] transition-transform duration-200 group-open:rotate-180 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <ul class="pt-2 pb-1 space-y-1.5 md:space-y-1 text-[#424245] md:pt-1.5">
            {col.links?.map((link: any) => (
              <li>
                <a
                  href={link.url || "#"}
                  data-swatch-sku={(link.url === '#inquiry' || (link.label || '').toLowerCase().includes('swatch')) ? rfqSettings?.swatchKitSku : undefined}
                  class="hover:text-[#1d1d1f] hover:underline transition-colors block py-0.5 md:py-0"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <!-- Apple Bottom Legal Bar: Clean Inline Separation with subtle pipes -->
    <div class="pt-3 border-t border-black/10 flex flex-col md:flex-row md:items-center justify-between gap-2 text-[11px] text-[#86868b]">
      <div>
        {cleanFooterText}
      </div>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[#424245]">
        {legalLinks.map((link: any, idx: number) => (
          <div class="inline-flex items-center gap-2.5">
            {idx > 0 && <span class="text-black/15 select-none font-normal">|</span>}
            <a href={link.url || "#"} class="hover:text-[#1d1d1f] hover:underline transition-colors">
              {link.label}
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterAccordions() {
    const isDesktop = window.innerWidth >= 768;
    const allDetails = document.querySelectorAll<HTMLDetailsElement>('details.apple-footer-col');
    allDetails.forEach(details => {
      if (isDesktop) {
        details.open = true;
      } else {
        if (!details.dataset.userToggled) {
          details.open = false;
        }
      }
    });
  }

  document.querySelectorAll<HTMLDetailsElement>('details.apple-footer-col summary').forEach(summary => {
    summary.addEventListener('click', () => {
      const details = summary.closest('details');
      if (details) {
        details.dataset.userToggled = 'true';
      }
    });
  });

  setupFooterAccordions();
  window.addEventListener('resize', setupFooterAccordions);
</script>
