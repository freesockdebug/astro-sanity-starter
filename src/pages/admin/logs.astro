        loadLogs();
      },
    });

    const tableSettings = useTableSettings({
      tableKey: 'logs',
      defaultColumns: DEFAULT_COLUMNS,
      defaultDensity: 'cozy',
      tableEl: logsMainTable,
      headerRowEl: tableHeaderRow,
      controllerBtnEl: columnsMenuBtn,
      controllerMenuEl: columnsMenuPanel,
      columnsListEl: columnsCheckboxList,
      countBadgeEl: columnsCountLabel,
      syncStatusEl: document.getElementById('columns-sync-status'),
      resetBtnEl: resetColumnsBtn,
      densityBtnEl: densityToggleBtn,
      densityLabelEl: densityLabel,
      onSettingsChange: () => {
        if (logsList && logsList.length > 0) renderRows(logsList);
      },
      onDensityChange: () => {
