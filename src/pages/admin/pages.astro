    // Add Section button
    document.getElementById('btn-add-section')?.addEventListener('click', () => {
      if (!activePageDoc) {
        (window as any).__showToast?.('Please select a page first', 'warning');
        return;
      }
      syncSectionsFromDom();
      const select = document.getElementById('select-new-section') as HTMLSelectElement;
      const type = select?.value || 'heroSection';
      const newSec = getSectionInitialValues(type);
      activePageDoc.sections.push(newSec);
      renderSections();
      (window as any).__showToast?.(`Added new ${type} section with multi-language copy`, 'success');
    });

    // Resolve Section Thumbnail for Header
    function getSectionThumbnail(sec: any): string {
      if (sec._type === 'heroSection' && sec.heroImage) {
        return (window as any).resolveSanityRefUrl?.(sec.heroImage);
      }
      if (sec._type === 'featureMatrixSection' && sec.macroImage) {
        return (window as any).resolveSanityRefUrl?.(sec.macroImage);
      }
      if (sec._type === 'customSection' && sec.blocks) {
        const mediaB = sec.blocks.find((b: any) => b._type === 'mediaBlock' && b.image);
        if (mediaB) return (window as any).resolveSanityRefUrl?.(mediaB.image);
      }
      return '';
    }

    // Render Section Card Header Preview Info
    function getSectionSummary(sec: any): { title: string; subtitle: string } {
      const adminName = sec.adminLabel || '';
      const headline = getLocaleVal(sec.headline || sec.title || sec.superTitle, currentLang);
      const title = adminName || headline || 'Untitled Section';

      let subtitle = '';
      switch (sec._type) {
        case 'heroSection':
          subtitle = `Buttons: ${sec.showPrimaryButton ? 'Primary On' : 'Off'} · ${sec.showSecondaryButton ? 'Secondary On' : 'Off'}`;
          break;
        case 'productShowcaseSection':
          subtitle = `Showcase: ${sec.products?.length || 0} products selected`;
          break;
        case 'featureMatrixSection':
          subtitle = `Bento: 5 spec cards configured`;
          break;
        case 'manufacturingSection':
          subtitle = `Capabilities: ${sec.capabilities?.length || 0} power items`;
          break;
        case 'inquirySection':
          subtitle = `Categories: ${sec.categories?.join(', ') || 'Default'}`;
          break;
        case 'customSection':
          subtitle = `Preset: ${sec.preset || 'custom'} · ${sec.blocks?.length || 0} blocks`;
          break;
        default:
          subtitle = sec._type;
      }

      return { title, subtitle };
    }

    // Render Modular Sections Container (Pure Rendering)
    function renderSections() {
      const container = document.getElementById('sections-container');
      if (!container) return;

      const sections = activePageDoc?.sections || [];
      if (sections.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center text-[#86868b] border border-dashed border-black/10 rounded-2xl space-y-2 bg-[#fafafc]">
            <p class="font-medium text-xs text-[#1d1d1f]">This page has no sections yet.</p>
            <p class="text-[11px]">Select a block type from the dropdown above and click "＋ Add Section".</p>
          </div>
        `;
        return;
      }

      const typeMeta: Record<string, { label: string; badgeClass: string; icon: string }> = {
        heroSection: { label: '主视觉首屏 · heroSection', badgeClass: 'bg-amber-100 text-amber-900 border-amber-200', icon: '🌟' },
        productShowcaseSection: { label: '精选产品展廊 · productShowcase', badgeClass: 'bg-blue-100 text-blue-900 border-blue-200', icon: '🗂️' },
        featureMatrixSection: { label: '核心工艺矩阵 · featureMatrix', badgeClass: 'bg-indigo-100 text-indigo-900 border-indigo-200', icon: '📐' },
        manufacturingSection: { label: '制造实力工坊 · manufacturing', badgeClass: 'bg-emerald-100 text-emerald-900 border-emerald-200', icon: '🏭' },
        inquirySection: { label: '商务咨询转化 · inquirySection', badgeClass: 'bg-rose-100 text-rose-900 border-rose-200', icon: '📩' },
        customSection: { label: '自由积木排版 · customSection', badgeClass: 'bg-purple-100 text-purple-900 border-purple-200', icon: '🎨' },
      };

      container.innerHTML = sections.map((sec: any, idx: number) => {
        const type = sec._type || 'customSection';
        const meta = typeMeta[type] || { label: type, badgeClass: 'bg-gray-100 text-gray-900 border-gray-200', icon: '📄' };
        const summary = getSectionSummary(sec);
        const thumbUrl = getSectionThumbnail(sec);
        // Bug 3 Fix: Stable collapse state based on sec._key
        const secKey = sec._key || String(idx);
        const isCollapsed = collapsedSections.has(secKey);

        return `
          <div
            class="section-card rounded-2xl bg-[#fafafc] border border-black/10 shadow-2xs overflow-hidden transition-all select-none"
            data-idx="${idx}"
            data-key="${escapeHtml(secKey)}"
            data-type="${type}"
          >
            <!-- Card Header -->
            <div class="p-3 sm:px-4 bg-white border-b border-black/5 flex items-center justify-between gap-3 cursor-pointer select-none card-header-row hover:bg-[#fafafc]">
              <div class="flex items-center gap-2.5 min-w-0">
                <!-- Drag Handle -->
                <div class="drag-handle p-1 text-[#86868b] hover:text-[#1d1d1f] cursor-grab active:cursor-grabbing text-xs" title="Drag to reorder">
                  ⠿
                </div>
                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono font-bold bg-[#f5f5f7] border border-black/5 text-[#52525b]">
                  #${idx + 1}
                </span>

                <!-- Thumbnail Preview (if present) -->
                ${thumbUrl ? `
                  <img src="${escapeHtml(thumbUrl)}?w=80&h=80&fit=crop" class="w-9 h-9 rounded-lg object-cover border border-black/10 shrink-0" />
                ` : ''}

                <!-- Titles and Status Summary -->
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border ${meta.badgeClass} flex items-center gap-1">
                      <span>${meta.icon}</span>
                      <span>${meta.label}</span>
                    </span>
                    <h4 class="font-bold text-xs text-[#1d1d1f] truncate">${escapeHtml(summary.title)}</h4>
                  </div>
                  <p class="text-[10px] text-[#86868b] truncate mt-0.5">${escapeHtml(summary.subtitle)}</p>
                </div>
              </div>

              <!-- Card Actions -->
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" class="btn-sec-up p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Move Up">▲</button>
                <button type="button" class="btn-sec-down p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Move Down">▼</button>
                <button type="button" class="btn-sec-copy p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Duplicate Section">📋</button>
                <button type="button" class="btn-sec-del p-1 rounded-md text-[#86868b] hover:text-rose-600 hover:bg-rose-50" data-idx="${idx}" title="Delete Section">✕</button>
                <button type="button" class="btn-sec-toggle p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5 ml-1" data-key="${escapeHtml(secKey)}" title="Expand / Collapse">
                  ${isCollapsed ? '▾' : '▴'}
                </button>
              </div>
            </div>

            <!-- Card Body (Dedicated Form per _type) -->
            <div class="section-card-body p-4 sm:p-5 space-y-4 ${isCollapsed ? 'hidden' : ''}">
              ${renderSectionForm(sec, idx)}
            </div>
          </div>
        `;
      }).join('');

      attachSectionEvents();
    }

