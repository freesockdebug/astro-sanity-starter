---
// src/pages/admin/logins.astro
// Admin Security Audit: 90-Day Login History & IP/Device Tracker
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import AdminSearchInput from '@components/admin/AdminSearchInput.astro';
import AdminWorkbenchTableShell from '@components/admin/AdminWorkbenchTableShell.astro';
import TableColumnController from '@components/admin/TableColumnController.astro';
import TableFilter from '@components/admin/TableFilter.astro';
import { requireAdminContext } from '@utils/auth';
import { getDictItems } from '@utils/dicts';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/logins',
  { requiredMenu: 'logins' }
);
if (redirectResponse) return redirectResponse;

const auditActions = await getDictItems(cfEnv, 'audit_actions', true).catch(() => []);
const retentionDays = systemSettings?.login_retention_days || 90;
const initialSearch = Astro.url.searchParams.get('search')?.trim() || '';
const initialTimeWindow = Astro.url.searchParams.get('timeWindow') || 'ALL';

const pageTitle = 'Login Audit Logs';
---

<AdminLayout
  title={pageTitle}
  currentTab="logins"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- 1. Single-Line Command Bar (Fixed Header) -->
    <AdminPageToolbar
      title="Audit Center"
      badge={`${retentionDays}d`}
      badgeColor="emerald"
      class="flex-nowrap px-3 py-2 sm:px-4 sm:py-2.5 gap-2"
    >
      <div slot="metrics" class="flex items-center gap-1.5 sm:gap-2 min-w-0 flex-1 overflow-x-auto no-scrollbar">
        <!-- Mode Tabs: Login Sessions vs Operation Audit Diff -->
        <div class="flex items-center gap-1 shrink-0 p-0.5 bg-[#f5f5f7] rounded-xl border border-black/5">
          <button
            type="button"
            id="tab-btn-logins"
            class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer"
          >
            Logins
          </button>
          <button
            type="button"
            id="tab-btn-audit"
            class="px-2.5 py-1 rounded-lg text-[11px] font-medium text-[#52525b] hover:text-black transition-all cursor-pointer"
          >
            Operation Diff
          </button>
        </div>

        <div class="h-4 w-px bg-black/10 hidden sm:block shrink-0"></div>

        <!-- Metric Capsules -->
        <div id="logins-metrics-container" class="flex items-center gap-1 sm:gap-1.5 shrink-0 overflow-x-auto no-scrollbar">
          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-[#f5f5f7] text-[#52525b] border border-black/5 flex items-center gap-1 shrink-0 whitespace-nowrap">
            <span>Sessions</span>
            <strong id="metric-sessions" class="text-[#1d1d1f] font-bold">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-[#f5f5f7] text-[#52525b] border border-black/5 flex items-center gap-1 shrink-0 whitespace-nowrap">
            <span>Accounts</span>
            <strong id="metric-accounts" class="text-[#1d1d1f] font-bold">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-blue-50/80 text-blue-800 border border-blue-200/80 flex items-center gap-1 shrink-0 whitespace-nowrap">
            <span>IPs</span>
            <strong id="metric-ips" class="font-bold text-blue-700">-</strong>
          </span>

          <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-medium bg-purple-50/80 text-purple-800 border border-purple-200/80 flex items-center gap-1 shrink-0 whitespace-nowrap">
            <span>Countries</span>
            <strong id="metric-countries" class="font-bold text-purple-700">-</strong>
          </span>
        </div>
      </div>

      <div slot="actions" class="flex items-center gap-2 ml-auto shrink-0">
        <span id="log-count-summary" class="hidden xl:inline font-mono text-[11px] text-[#86868b]">(Loading...)</span>

        <!-- Quick Time Window Filter -->
        <TableFilter
          timeSelectId="logins-timewindow-select"
          initialTimeWindow={initialTimeWindow}
        />

        <AdminSearchInput
          id="logins-search-input"
          clearBtnId="clear-logins-search"
          initialValue={initialSearch}
          placeholder="Search email, IP, city..."
          class="relative flex items-center w-36 md:w-40 lg:w-44 xl:w-56 2xl:w-64"
        />

        <!-- Columns & Density Controller -->
        <TableColumnController
          controllerBtnId="logins-columns-btn"
          controllerMenuId="logins-columns-menu"
          columnsListId="logins-columns-list"
          countBadgeId="logins-columns-count"
          syncStatusId="logins-columns-sync"
          resetBtnId="logins-columns-reset"
          densityBtnId="logins-density-btn"
          densityLabelId="logins-density-label"
          showDensityToggle={true}
          class="hidden md:inline-flex"
        />
      </div>
    </AdminPageToolbar>

    <!-- 2. Independent Scrolling Container -->
    <AdminWorkbenchTableShell
      containerId="logins-container"
      skeletonId="logins-skeleton"
      contentId="logins-content"
      contentHidden={true}
      showPagination={false}
    />

    <!-- 3. Operation Audit Diff Container (Toggled) -->
    <div id="audit-diff-container" class="hidden flex-1 min-h-0 bg-white border border-black/5 rounded-2xl shadow-2xs overflow-hidden flex flex-col">
      <div class="px-3.5 py-2.5 bg-[#fafafa] border-b border-black/5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-[#1d1d1f]">Administrative Operation Diff Logs</span>
          <span class="text-[10px] text-[#86868b]">Indexed audit events</span>
        </div>
        <div class="flex items-center gap-2">
          <label class="text-[11px] text-[#86868b] font-medium hidden sm:inline">Action Filter:</label>
          <select id="audit-action-filter" class="px-2.5 py-1 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black font-semibold text-[#1d1d1f]">
            <option value="">All Actions ({auditActions.length} types)</option>
            {auditActions.map((a) => (
              <option value={a.item_key}>{a.item_label} ({a.item_key})</option>
            ))}
          </select>
        </div>
      </div>
      <div class="flex-1 overflow-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="sticky top-0 bg-[#fbfbfd] border-b border-black/5 text-[#52525b] font-medium z-10 text-[11px]">
            <tr>
              <th class="py-2.5 px-3">Timestamp</th>
              <th class="py-2.5 px-3">Administrator</th>
              <th class="py-2.5 px-3">Action</th>
              <th class="py-2.5 px-3">Target</th>
              <th class="py-2.5 px-3">Field Changes / Diff</th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-black/5 font-sans text-xs">
            <tr><td colspan="5" class="py-12 text-center text-[#86868b]">Loading operation audit logs...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { clientCache } from '@utils/clientCache';
  import { escapeHtml, formatAdminTime } from '@utils/adminWorkbench';
  import { useTableSettings, type ColumnConfig } from '@hooks/useTableSettings';

  function initLoginsPage() {
    const DEFAULT_COLUMNS: ColumnConfig[] = [
    { id: 'user', label: 'User Email & ID', defaultWidth: 220, minWidth: 160, visible: true, canHide: false },
    { id: 'ip', label: 'IP Address', defaultWidth: 140, minWidth: 100, visible: true, canHide: true },
    { id: 'location', label: 'Location', defaultWidth: 150, minWidth: 110, visible: true, canHide: true },
    { id: 'user_agent', label: 'Client User-Agent', defaultWidth: 260, minWidth: 160, visible: true, canHide: true },
    { id: 'timestamp', label: 'Login Timestamp', defaultWidth: 160, minWidth: 120, visible: true, canHide: false, pinRight: true, align: 'right' },
  ];

  let allLogins: any[] = [];
  let currentSearch = '';
  let currentTimeWindow = 'ALL';

  const tableSettings = useTableSettings({
    tableKey: 'logins',
    defaultColumns: DEFAULT_COLUMNS,
    defaultDensity: 'cozy',
    controllerBtnEl: document.getElementById('logins-columns-btn'),
    controllerMenuEl: document.getElementById('logins-columns-menu'),
    columnsListEl: document.getElementById('logins-columns-list'),
    countBadgeEl: document.getElementById('logins-columns-count'),
    syncStatusEl: document.getElementById('logins-columns-sync'),
    resetBtnEl: document.getElementById('logins-columns-reset'),
    densityBtnEl: document.getElementById('logins-density-btn'),
    densityLabelEl: document.getElementById('logins-density-label'),
    onSettingsChange: () => {
      if (allLogins && allLogins.length > 0) filterAndRender();
    },
    onDensityChange: () => {
      if (allLogins && allLogins.length > 0) filterAndRender();
    },
  });

  function updateMetrics(logins: any[]) {
    const sessionsEl = document.getElementById('metric-sessions');
    const accountsEl = document.getElementById('metric-accounts');
    const ipsEl = document.getElementById('metric-ips');
    const countriesEl = document.getElementById('metric-countries');

    if (sessionsEl) sessionsEl.textContent = String(logins.length);
    if (accountsEl) {
      const uniqueUsers = new Set(logins.map((l) => (l.email || '').toLowerCase())).size;
      accountsEl.textContent = String(uniqueUsers);
    }
    if (ipsEl) {
      const uniqueIps = new Set(logins.map((l) => l.ip).filter(Boolean)).size;
      ipsEl.textContent = String(uniqueIps);
    }
    if (countriesEl) {
      const uniqueCountries = new Set(logins.map((l) => l.country).filter(Boolean)).size;
      countriesEl.textContent = String(uniqueCountries || 1);
    }
  }

  function renderTable(displayLogins: any[]) {
    const content = document.getElementById('logins-content');
    const summary = document.getElementById('log-count-summary');
    if (!content) return;

    if (summary) {
      summary.textContent = `(${displayLogins.length} of ${allLogins.length} events)`;
    }

    if (displayLogins.length === 0) {
      content.innerHTML = `
        <div class="py-16 text-center text-xs text-[#86868b]">
          ${currentSearch ? `No login events matching "${escapeHtml(currentSearch)}".` : 'No login activity recorded yet.'}
        </div>
      `;
      content.classList.remove('hidden');
      return;
    }

    // 1. Mobile Cards Layout (< md)
    const mobileCardsHtml = `
      <div class="block md:hidden divide-y divide-black/5">
        ${displayLogins.map((entry) => {
          const locationStr = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global');
          const safeEmail = escapeHtml(entry.email || '');
          const safeUserId = escapeHtml(entry.user_id || '');
          const safeIp = escapeHtml(entry.ip || '—');
          const safeAgent = escapeHtml(entry.user_agent || 'Unknown Device');
          const dateStr = formatAdminTime(entry.created_at, 'full');

          return `
            <div class="p-3.5 space-y-2 bg-white text-xs">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <span class="font-semibold text-[#1d1d1f] truncate block">${safeEmail}</span>
                  <span class="font-mono text-[10px] text-[#86868b] truncate block" title="${safeUserId}">${safeUserId}</span>
                </div>
                <span class="text-[11px] text-[#86868b] shrink-0 font-mono">
                  ${dateStr}
                </span>
              </div>
              <div class="p-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 space-y-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-mono font-medium text-[#1d1d1f]">${safeIp}</span>
                  <span class="text-[#52525b]">📍 ${locationStr}</span>
                </div>
                <p class="text-[10px] text-[#86868b] truncate" title="${safeAgent}">
                  ${safeAgent}
                </p>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;

    // 2. Desktop High-Density Table (>= md)
    const visibleCols = tableSettings.getVisibleColumns();
    const isCompact = tableSettings.getDensity() === 'compact';
    const cellPad = isCompact ? 'py-1.5 px-3' : 'py-3 px-4';

    const desktopRowsHtml = displayLogins.map((entry) => {
      const locationStr = escapeHtml([entry.city, entry.country].filter(Boolean).join(', ') || 'Global / Edge');
      const safeEmail = escapeHtml(entry.email || '');
      const safeUserId = escapeHtml(entry.user_id || '');
      const safeIp = escapeHtml(entry.ip || '');
      const safeAgent = escapeHtml(entry.user_agent || 'Unknown Client');
      const dateStr = formatAdminTime(entry.created_at, 'full');

      const cells = visibleCols.map((col) => {
        switch (col.id) {
          case 'user':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <div class="font-medium text-[#1d1d1f] truncate">${safeEmail}</div>
                <div class="text-[10px] font-mono text-[#86868b] truncate max-w-[200px]" title="${safeUserId}">
                  ${safeUserId}
                </div>
              </td>
            `;
          case 'ip':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono text-[11px] text-[#1d1d1f]">
                ${safeIp ? `<span class="px-2 py-0.5 rounded bg-[#f5f5f7] border border-black/5">${safeIp}</span>` : `<span class="text-[#86868b]">—</span>`}
              </td>
            `;
          case 'location':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] bg-zinc-100 text-[#1d1d1f] border border-black/5 truncate max-w-[140px]">
                  📍 ${locationStr}
                </span>
              </td>
            `;
          case 'user_agent':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-[11px] text-[#52525b] truncate max-w-xs" title="${safeAgent}">
                ${safeAgent}
              </td>
            `;
          case 'timestamp':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-right whitespace-nowrap font-mono text-[11px]">
                ${dateStr}
              </td>
            `;
          default:
            return `<td></td>`;
        }
      }).join('');

      return `<tr class="hover:bg-[#f5f5f7]/60 transition-colors">${cells}</tr>`;
    }).join('');

    const desktopTableHtml = `
      <div class="hidden md:block">
        <table id="logins-main-table" class="w-full text-left text-xs border-collapse table-fixed select-text">
          <thead class="sticky top-0 z-10 bg-[#fafafa]/95 backdrop-blur-xs shadow-2xs border-b border-black/10">
            <tr id="logins-header-row"></tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            ${desktopRowsHtml}
          </tbody>
        </table>
      </div>
    `;

    content.innerHTML = mobileCardsHtml + desktopTableHtml;
    content.classList.remove('hidden');

    const loginsTable = document.getElementById('logins-main-table');
    const loginsHeaderRow = document.getElementById('logins-header-row');
    if (loginsTable && loginsHeaderRow) {
      tableSettings.renderHeader(loginsHeaderRow, loginsTable);
    }
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    if (currentSearch) url.searchParams.set('search', currentSearch);
    else url.searchParams.delete('search');

    if (currentTimeWindow && currentTimeWindow !== 'ALL') url.searchParams.set('timeWindow', currentTimeWindow);
    else url.searchParams.delete('timeWindow');

    window.history.replaceState({}, '', url.toString());
  }

  function filterAndRender() {
    const searchLower = currentSearch.toLowerCase();
    const now = Date.now();
    let windowMs = 0;
    if (currentTimeWindow === '24h') windowMs = 24 * 60 * 60 * 1000;
    else if (currentTimeWindow === '7d') windowMs = 7 * 24 * 60 * 60 * 1000;
    else if (currentTimeWindow === '30d') windowMs = 30 * 24 * 60 * 60 * 1000;

    const filtered = allLogins.filter((l) => {
      if (windowMs > 0 && l.created_at) {
        const raw = String(l.created_at).trim();
        const utcStr = raw.endsWith('Z') ? raw : `${raw.replace(' ', 'T')}Z`;
        const itemTime = new Date(utcStr).getTime();
        if (!isNaN(itemTime) && now - itemTime > windowMs) return false;
      }
      if (!searchLower) return true;
      return (
        (l.email || '').toLowerCase().includes(searchLower) ||
        (l.user_id || '').toLowerCase().includes(searchLower) ||
        (l.ip || '').toLowerCase().includes(searchLower) ||
        (l.city || '').toLowerCase().includes(searchLower) ||
        (l.country || '').toLowerCase().includes(searchLower)
      );
    });

    updateMetrics(filtered);
    renderTable(filtered);
  }

  async function loadLogins() {
    const skeleton = document.getElementById('logins-skeleton');
    const content = document.getElementById('logins-content');

    try {
      await clientCache.fetchWithCache('admin:logins:150', '/api/admin/logins?limit=150', {
        mode: 'swr',
        onData: (data: any) => {
          allLogins = data.logins || [];
          if (skeleton) skeleton.classList.add('hidden');
          updateMetrics(allLogins);
          filterAndRender();
        },
      });
    } catch (err: any) {
      console.error('Failed to load logins:', err);
      if (skeleton) skeleton.classList.add('hidden');
      if (content) {
        content.innerHTML = `
          <div class="py-16 text-center text-xs text-rose-600">
            Failed to load login audit logs (${escapeHtml(err?.message || '')}). <button type="button" id="retry-logins-btn" class="underline ml-1 cursor-pointer">Retry</button>
          </div>
        `;
        content.classList.remove('hidden');
        document.getElementById('retry-logins-btn')?.addEventListener('click', loadLogins);
      }
    }
  }

  // 0ms instant client-side search filtering
  const searchInput = document.getElementById('logins-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-logins-search');

  searchInput?.addEventListener('input', () => {
    currentSearch = searchInput.value.trim();
    if (clearBtn) {
      if (currentSearch) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
    syncUrl();
    filterAndRender();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    clearBtn.classList.add('hidden');
    syncUrl();
    filterAndRender();
  });

  // Browser navigation support
  window.addEventListener('popstate', () => {
    const url = new URL(window.location.href);
    currentSearch = url.searchParams.get('search')?.trim() || '';
    currentTimeWindow = url.searchParams.get('timeWindow') || 'ALL';
    if (searchInput) searchInput.value = currentSearch;
    if (clearBtn) {
      if (currentSearch) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
    const timeSelect = document.getElementById('logins-timewindow-select') as HTMLSelectElement | null;
    if (timeSelect) timeSelect.value = currentTimeWindow;
    filterAndRender();
  });

  // Initial load
  tableSettings.renderMenu();
  const initialUrl = new URL(window.location.href);
  currentSearch = initialUrl.searchParams.get('search')?.trim() || '';
  currentTimeWindow = initialUrl.searchParams.get('timeWindow') || 'ALL';

  const timeSelect = document.getElementById('logins-timewindow-select') as HTMLSelectElement | null;
  if (timeSelect) {
    timeSelect.value = currentTimeWindow;
    timeSelect.addEventListener('change', () => {
      currentTimeWindow = timeSelect.value || 'ALL';
      syncUrl();
      filterAndRender();
    });
  }

  loadLogins();

  // Mode Switcher: Logins vs Operation Audit Diff
  let auditLogsLoaded = false;
  const tabBtnLogins = document.getElementById('tab-btn-logins');
  const tabBtnAudit = document.getElementById('tab-btn-audit');
  const loginsShell = document.getElementById('logins-container');
  const auditDiffContainer = document.getElementById('audit-diff-container');
  const metricsContainer = document.getElementById('logins-metrics-container');

  var auditActionFilter = document.getElementById('audit-action-filter') as HTMLSelectElement | null;
  auditActionFilter?.addEventListener('change', () => {
    loadAuditLogs();
  });

  async function loadAuditLogs() {
    const tbody = document.getElementById('audit-table-body');
    if (!tbody) return;
    const actionVal = auditActionFilter ? auditActionFilter.value : '';
    const query = actionVal ? `?limit=100&action=${encodeURIComponent(actionVal)}` : '?limit=100';

    try {
      const res = await fetch(`/api/admin/audit${query}`);
      const data = await res.json();
      if (!res.ok || !data.success) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-600">Failed to load audit logs: ${escapeHtml(data.error || '')}</td></tr>`;
        return;
      }
      if (!data.logs || data.logs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-[#86868b]">No admin operations found for this action filter.</td></tr>`;
        return;
      }
      tbody.innerHTML = data.logs.map((log: any) => {
        let diffHtml = '';
        try {
          const diff = log.diff_json ? JSON.parse(log.diff_json) : null;
          if (diff && Object.keys(diff).length > 0) {
            diffHtml = Object.entries(diff).map(([k, v]: [string, any]) => {
              const oldVal = v?.before !== undefined ? JSON.stringify(v.before) : '∅';
              const newVal = v?.after !== undefined ? JSON.stringify(v.after) : '∅';
              return `<span class="inline-block mr-2 text-[10px]"><span class="text-[#86868b]">${escapeHtml(k)}:</span> <span class="text-rose-700 line-through">${escapeHtml(oldVal)}</span> → <span class="text-emerald-700 font-semibold">${escapeHtml(newVal)}</span></span>`;
            }).join('');
          } else if (log.after_json) {
            diffHtml = `<span class="text-[10px] text-[#52525b] font-mono">${escapeHtml(log.after_json).slice(0, 120)}</span>`;
          }
        } catch {
          diffHtml = `<span class="text-[10px] text-[#86868b]">-</span>`;
        }

        const act = String(log.action || '');
        let actionBadgeColor = 'bg-slate-100 text-slate-800 border-slate-200';
        if (act.includes('DELETE') || act.includes('BLOCK') || act.includes('REJECT')) {
          actionBadgeColor = 'bg-rose-50 text-rose-800 border-rose-200';
        } else if (act.includes('APPROVE') || act.includes('SHIP')) {
          actionBadgeColor = 'bg-emerald-50 text-emerald-800 border-emerald-200';
        } else if (act.includes('ASSIGN') || act.includes('MEMBER')) {
          actionBadgeColor = 'bg-blue-50 text-blue-800 border-blue-200';
        } else if (act.includes('ROLE') || act.includes('TIER')) {
          actionBadgeColor = 'bg-purple-50 text-purple-800 border-purple-200';
        }

        return `
          <tr class="hover:bg-[#fbfbfd]">
            <td class="py-2.5 px-3 font-mono text-[10px] text-[#86868b] whitespace-nowrap">${formatAdminTime(log.created_at, 'full')}</td>
            <td class="py-2.5 px-3 font-medium text-[#1d1d1f] whitespace-nowrap">${escapeHtml(log.admin_email)}</td>
            <td class="py-2.5 px-3 whitespace-nowrap">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border ${actionBadgeColor}">${escapeHtml(log.action)}</span>
            </td>
            <td class="py-2.5 px-3 whitespace-nowrap font-mono text-[11px] text-[#52525b]">${escapeHtml(log.target_type)} <span class="text-black font-semibold">#${escapeHtml(log.target_id || '')}</span></td>
            <td class="py-2.5 px-3">${diffHtml || '<span class="text-[#86868b] text-[10px]">-</span>'}</td>
          </tr>
        `;
      }).join('');
      auditLogsLoaded = true;
    } catch (e: any) {
      tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-600">Network error: ${escapeHtml(e?.message || '')}</td></tr>`;
    }
  }

  tabBtnLogins?.addEventListener('click', () => {
    tabBtnLogins.className = 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer';
    tabBtnAudit?.classList.remove('bg-[#1d1d1f]', 'text-white', 'shadow-2xs', 'font-semibold');
    tabBtnAudit?.classList.add('text-[#52525b]', 'font-medium');
    loginsShell?.classList.remove('hidden');
    auditDiffContainer?.classList.add('hidden');
    if (metricsContainer) metricsContainer.classList.remove('hidden');
  });

  tabBtnAudit?.addEventListener('click', () => {
    tabBtnAudit.className = 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#1d1d1f] text-white shadow-2xs transition-all cursor-pointer';
    tabBtnLogins?.classList.remove('bg-[#1d1d1f]', 'text-white', 'shadow-2xs', 'font-semibold');
    tabBtnLogins?.classList.add('text-[#52525b]', 'font-medium');
    loginsShell?.classList.add('hidden');
    auditDiffContainer?.classList.remove('hidden');
    if (metricsContainer) metricsContainer.classList.add('hidden');
    if (!auditLogsLoaded) loadAuditLogs();
  });
}

initLoginsPage();
document.addEventListener('shell:page-load', () => {
  if (document.getElementById('tab-btn-logins')) {
    initLoginsPage();
  }
});
</script>
