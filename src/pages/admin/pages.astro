---
// src/pages/admin/pages.astro
// Native Cloudflare SSR Modular Page Builder & Visual Canvas (1:1 Native Sanity Studio Port)
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import MediaLibraryModal from '@components/admin/MediaLibraryModal.astro';
import { requireAdminContext } from '@utils/auth';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/pages',
  { requiredMenu: 'pages' }
);
if (redirectResponse) return redirectResponse;

const canWrite = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cms:write'));
const canDelete = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cms:delete'));

const pageTitle = 'Pages & Modular Visual Builder';
---

<AdminLayout
  title={pageTitle}
  currentTab="pages"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-2">
    <!-- Top Action Bar -->
    <AdminPageToolbar
      title="Pages & Sections Builder"
      subtitle="· Compose modular landing pages & live responsive preview"
    >
      <div slot="actions" class="flex items-center gap-2">
        {canWrite && (
          <button
            type="button"
            id="btn-create-page"
            class="adm-btn-primary"
          >
            <span>＋ Create Page</span>
          </button>
        )}
      </div>
    </AdminPageToolbar>

    <!-- Split-Pane Workspace: Left Pages Directory (300px) | Right Builder & Canvas -->
    <div class="flex-1 min-h-0 flex flex-col lg:flex-row gap-3 overflow-hidden">
      <!-- Left: Pages Directory -->
      <div class="w-full lg:w-80 shrink-0 bg-white border border-black/5 rounded-2xl shadow-2xs flex flex-col overflow-hidden">
        <div class="p-3 border-b border-black/5 bg-[#fafafc] flex items-center justify-between">
          <span class="text-xs font-bold text-[#1d1d1f]">Site Pages Directory</span>
          <span id="pages-count-badge" class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-[#f5f5f7] border border-black/5">0</span>
        </div>
        <div id="pages-list" class="flex-1 overflow-y-auto divide-y divide-black/5 p-1.5 space-y-1">
          <div class="py-12 text-center text-[#86868b] text-xs">Loading pages...</div>
        </div>
      </div>

      <!-- Right: Modular Block Builder & Live Responsive Canvas -->
      <div class="flex-1 min-h-0 bg-white border border-black/5 rounded-2xl shadow-2xs flex flex-col overflow-hidden">
        <!-- Editor Sub-Header: Mode, Device & Multi-Language Switcher -->
        <div class="p-3 border-b border-black/5 flex flex-wrap items-center justify-between gap-3 bg-[#fafafc] shrink-0">
          <div class="flex items-center gap-2">
            <span id="current-page-badge" class="font-mono font-bold text-xs px-2.5 py-1 rounded-lg bg-[#1d1d1f] text-white shadow-2xs">
              Select a Page
            </span>
            <div class="flex items-center bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" id="btn-mode-builder" class="px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer">
                Blocks Form
              </button>
              <button type="button" id="btn-mode-canvas" class="px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer">
                Live Canvas
              </button>
            </div>
          </div>

          <!-- Multi-Language Tab Switcher (EN / DE / FR / ES) -->
          <div class="flex items-center gap-2">
            <div id="lang-switcher" class="flex items-center bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer" data-lang="en">
                🇬🇧 EN
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="de">
                🇩🇪 DE
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="fr">
                🇫🇷 FR
              </button>
              <button type="button" class="btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-lang="es">
                🇪🇸 ES
              </button>
            </div>

            <!-- Responsive Viewport Switcher -->
            <div id="device-switcher" class="hidden flex items-center gap-1.5 bg-[#f5f5f7] p-0.5 rounded-xl border border-black/5 text-xs">
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer" data-width="100%">
                🖥️ Desktop
              </button>
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-width="1280px">
                💻 1280px
              </button>
              <button type="button" class="btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer" data-width="390px">
                📱 Mobile
              </button>
            </div>

            {canWrite && (
              <button
                type="button"
                id="btn-save-page"
                class="adm-btn-primary px-4"
              >
                <span>Save & Publish Page</span>
              </button>
            )}
          </div>
        </div>

        <!-- Mode A: Blocks Editor Pane -->
        <div id="builder-pane" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 text-xs">
          <!-- Page Meta Form (URL & SEO) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#fafafc] border border-black/5 space-y-4">
            <div class="flex items-center justify-between border-b border-black/5 pb-2">
              <span class="font-bold text-xs text-[#1d1d1f] flex items-center gap-1.5">
                <span>🌐</span> 1. Page URL & SEO Metadata
              </span>
              <span id="seo-lang-indicator" class="text-[10px] font-mono text-[#86868b]">Editing Language: EN</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">Page Title * (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-title-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">URL Path Slug *</label>
                <input type="text" id="page-slug-input" placeholder="/ or /about" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black font-mono text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">SEO Meta Title (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-metatitle-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 text-xs" />
              </div>
              <div>
                <label class="block font-semibold mb-1 text-[#1d1d1f]">SEO Meta Description (<span class="current-lang-label">EN</span>)</label>
                <input type="text" id="page-metadesc-input" class="w-full px-3 py-2 rounded-xl bg-white border border-black/10 text-xs" />
              </div>
            </div>

            <!-- Social Share Image & Suffix Toggle -->
            <div class="pt-3 border-t border-black/5 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
              <div class="flex items-center gap-3">
                <div id="social-image-preview" class="w-16 h-16 rounded-xl bg-white border border-black/10 flex items-center justify-center overflow-hidden shrink-0 shadow-2xs">
                  <span class="text-[9px] text-[#86868b]">No Image</span>
                </div>
                <div class="space-y-1">
                  <label class="block font-semibold text-[11px] text-[#1d1d1f]">Social Sharing Image (socialImage)</label>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      id="btn-choose-social-image"
                      class="px-2.5 py-1 rounded-lg bg-[#1d1d1f] text-white text-[11px] font-semibold cursor-pointer shadow-2xs hover:bg-black"
                    >
                      📁 From Media Library
                    </button>
                    <button
                      type="button"
                      id="btn-remove-social-image"
                      class="px-2 py-1 rounded-lg text-rose-600 hover:bg-rose-50 text-[11px] cursor-pointer hidden"
                    >
                      ✕ Remove
                    </button>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <input type="checkbox" id="page-add-suffix-input" class="rounded border-black/20 text-[#1d1d1f] focus:ring-0 cursor-pointer" />
                <label for="page-add-suffix-input" class="font-medium text-xs text-[#1d1d1f] cursor-pointer">
                  Append site title suffix automatically (addTitleSuffix)
                </label>
              </div>
            </div>
          </div>

          <!-- Modular Sections Array -->
          <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="font-bold text-xs text-[#1d1d1f] block">2. Modular Page Sections (Sections Stream)</span>
                <span class="text-[10px] text-[#86868b]">Drag handle ⠿ to reorder · 1:1 Isolated dedicated forms with zero field bleed</span>
              </div>
              <div class="flex items-center gap-2">
                <select id="select-new-section" class="adm-select">
                  <option value="heroSection">Hero Banner (heroSection)</option>
                  <option value="productShowcaseSection">Product Showcase (productShowcaseSection)</option>
                  <option value="featureMatrixSection">Spec Matrix (featureMatrixSection)</option>
                  <option value="manufacturingSection">Manufacturing (manufacturingSection)</option>
                  <option value="inquirySection">Sample Inquiry (inquirySection)</option>
                  <option value="customSection">Custom Layout (customSection)</option>
                </select>
                <button
                  type="button"
                  id="btn-add-section"
                  class="adm-btn-primary"
                >
                  <span>+ Add Section</span>
                </button>
              </div>
            </div>

            <!-- Sections Container -->
            <div id="sections-container" class="space-y-3">
              <div class="p-8 text-center text-[#86868b] border border-dashed border-black/10 rounded-2xl">
                No page selected or page has no sections. Select a page from the left to start editing.
              </div>
            </div>
          </div>
        </div>

        <!-- Mode B: Live Responsive Canvas Pane -->
        <div id="canvas-pane" class="hidden flex-1 min-h-0 bg-[#f5f5f7] flex items-center justify-center p-3 overflow-hidden">
          <div id="canvas-wrapper" class="w-full h-full bg-white rounded-2xl shadow-xl overflow-hidden border border-black/10 transition-all duration-300">
            <iframe id="live-preview-frame" src="/" class="w-full h-full border-0"></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Global Cloud Media Library Modal -->
    <MediaLibraryModal />
  </div>
</AdminLayout>

<script>
  import { DEFAULT_BRAND_TITLE } from '@data/defaults';
  import {
    escapeHtml,
    getLocaleVal,
    getFallbackEn,
    setLocaleVal,
    renderSchemaFields,
    syncSchemaFieldsFromDom,
  } from '@utils/adminWorkbench';
  import {
    SECTION_TYPE_META,
    getSectionInitialValues,
    SECTION_FIELD_SPECS,
    CAPABILITY_FIELDS,
    BLOCK_FIELD_SPECS,
  } from '@utils/adminPageSchemas';

  function initPagesWorkbench() {
    const listEl = document.getElementById('pages-list');
    if (!listEl || (listEl as any).__initialized) return;
    (listEl as any).__initialized = true;

    let currentPages: any[] = [];
    let activePageDoc: any = null;
    let catalogProducts: any[] = [];
    let currentLang = 'en'; // 'en' | 'de' | 'fr' | 'es'
    let draggedSectionIdx: number | null = null;
    // Bug 3 Fix: Store collapse state using unique section _key (string)
    let collapsedSections: Set<string> = new Set();

    // Multi-Language string helpers imported from @utils/adminWorkbench

    // View Mode Switcher
    const btnModeBuilder = document.getElementById('btn-mode-builder');
    const btnModeCanvas = document.getElementById('btn-mode-canvas');
    const builderPane = document.getElementById('builder-pane');
    const canvasPane = document.getElementById('canvas-pane');
    const deviceSwitcher = document.getElementById('device-switcher');
    const previewFrame = document.getElementById('live-preview-frame') as HTMLIFrameElement | null;
    const canvasWrapper = document.getElementById('canvas-wrapper');

    btnModeBuilder?.addEventListener('click', () => {
      btnModeBuilder.className = 'px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
      if (btnModeCanvas) btnModeCanvas.className = 'px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
      builderPane?.classList.remove('hidden');
      canvasPane?.classList.add('hidden');
      deviceSwitcher?.classList.add('hidden');
    });

    btnModeCanvas?.addEventListener('click', () => {
      btnModeCanvas.className = 'px-3 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
      if (btnModeBuilder) btnModeBuilder.className = 'px-3 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
      canvasPane?.classList.remove('hidden');
      builderPane?.classList.add('hidden');
      deviceSwitcher?.classList.remove('hidden');

      const slug = activePageDoc?.slug?.current || '/';
      const cleanSlug = slug === '/' ? '' : (slug.startsWith('/') ? slug : `/${slug}`);
      const langPrefix = currentLang === 'en' ? '' : `/${currentLang}`;
      if (previewFrame) previewFrame.src = `${langPrefix}${cleanSlug}` || '/';
    });

    // Device Switcher
    document.querySelectorAll('.btn-device').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.btn-device').forEach((b) => {
          b.className = 'btn-device px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
        });
        btn.className = 'btn-device px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';
        const width = btn.getAttribute('data-width') || '100%';
        if (canvasWrapper) canvasWrapper.style.width = width;
      });
    });

    // Language Tab Switcher
    document.querySelectorAll('.btn-lang').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang');
        if (!targetLang || targetLang === currentLang) return;

        // 1. Sync current DOM inputs to memory for currentLang
        syncMetaFromDom();
        syncSectionsFromDom();

        // 2. Switch language
        currentLang = targetLang;
        document.querySelectorAll('.btn-lang').forEach((b) => {
          b.className = 'btn-lang px-2.5 py-1 rounded-lg font-medium text-[#52525b] hover:text-[#1d1d1f] cursor-pointer';
        });
        btn.className = 'btn-lang px-2.5 py-1 rounded-lg font-semibold bg-white text-[#1d1d1f] shadow-2xs cursor-pointer';

        document.querySelectorAll('.current-lang-label').forEach((el) => {
          el.textContent = currentLang.toUpperCase();
        });
        const seoLang = document.getElementById('seo-lang-indicator');
        if (seoLang) seoLang.textContent = `Editing Language: ${currentLang.toUpperCase()}`;

        // 3. Re-render forms with new language values
        renderPagesList();
        const badge = document.getElementById('current-page-badge');
        if (badge && activePageDoc) {
          badge.textContent = getLocaleVal(activePageDoc.title, currentLang) || getFallbackEn(activePageDoc.title) || activePageDoc.slug?.current || 'Page';
        }
        populateMetaInputs();
        renderSections();
        if (previewFrame && !canvasPane?.classList.contains('hidden')) {
          const slug = activePageDoc?.slug?.current || '/';
          const cleanSlug = slug === '/' ? '' : (slug.startsWith('/') ? slug : `/${slug}`);
          const langPrefix = currentLang === 'en' ? '' : `/${currentLang}`;
          previewFrame.src = `${langPrefix}${cleanSlug}` || '/';
        }
        (window as any).__showToast?.(`Switched editing language to ${currentLang.toUpperCase()}`, 'info');
      });
    });

    // Load Catalog Products for Product Showcase Section
    async function loadCatalogProducts() {
      try {
        const res = await fetch('/api/admin/cms/products');
        const data = await res.json();
        if (res.ok && data.success) {
          catalogProducts = data.products || [];
        }
      } catch (e) {
        console.warn('Failed to load products for picker:', e);
      }
    }

    // Load Site Pages
    async function loadPages() {
      try {
        const res = await fetch('/api/admin/cms/pages');
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to fetch pages');

        currentPages = data.pages || [];
        const badge = document.getElementById('pages-count-badge');
        if (badge) badge.textContent = String(currentPages.length);

        renderPagesList();

        if (!activePageDoc && currentPages.length > 0) {
          const home = currentPages.find((p: any) => p.slug?.current === '/' || p.slug?.current === '' || p.slug?.current === 'home') || currentPages[0];
          selectPage(home._id);
        }
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    }

    function renderPagesList() {
      const list = document.getElementById('pages-list');
      if (!list) return;

      list.innerHTML = currentPages.map((p: any) => {
        const slug = p.slug?.current || '/';
        const isHome = slug === '/' || slug === '' || slug === 'home';
        const isSelected = activePageDoc?._id === p._id;

        return `
          <div
            class="p-2.5 rounded-xl cursor-pointer transition-all page-list-item ${isSelected ? 'bg-[#1d1d1f] text-white shadow-2xs' : 'hover:bg-[#f5f5f7] text-[#1d1d1f]'}"
            data-id="${p._id}"
          >
            <div class="flex items-center justify-between gap-1.5 mb-1">
              <span class="font-semibold text-xs truncate">${escapeHtml(getLocaleVal(p.title, currentLang) || getFallbackEn(p.title) || (isHome ? 'Homepage' : 'Untitled Page'))}</span>
              ${isHome ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold ${isSelected ? 'bg-white/20 text-white' : 'bg-amber-100 text-amber-900'}">Home</span>` : ''}
            </div>
            <div class="flex items-center justify-between text-[10px] ${isSelected ? 'text-white/70' : 'text-[#86868b]'} font-mono">
              <span>${escapeHtml(slug)}</span>
              <span>${p.sectionCount || 0} sections</span>
            </div>
          </div>
        `;
      }).join('');

      list.querySelectorAll('.page-list-item').forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-id');
          if (id) selectPage(id);
        });
      });
    }

    async function selectPage(id: string) {
      try {
        const res = await fetch(`/api/admin/cms/pages?id=${encodeURIComponent(id)}`);
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to load page');

        activePageDoc = data.page;
        if (!activePageDoc.sections) activePageDoc.sections = [];

        // Ensure every section has a unique _key for stable collapse and drag state
        activePageDoc.sections.forEach((sec: any) => {
          if (!sec._key) sec._key = crypto.randomUUID().slice(0, 8);
        });

        collapsedSections.clear();

        renderPagesList();

        const badge = document.getElementById('current-page-badge');
        if (badge) badge.textContent = getLocaleVal(activePageDoc.title, currentLang) || getFallbackEn(activePageDoc.title) || activePageDoc.slug?.current || 'Page';

        populateMetaInputs();
        renderSocialImagePreview();
        renderSections();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    }

    function populateMetaInputs() {
      if (!activePageDoc) return;
      const titleInput = document.getElementById('page-title-input') as HTMLInputElement | null;
      const slugInput = document.getElementById('page-slug-input') as HTMLInputElement | null;
      const metaTitleInput = document.getElementById('page-metatitle-input') as HTMLInputElement | null;
      const metaDescInput = document.getElementById('page-metadesc-input') as HTMLInputElement | null;
      const suffixInput = document.getElementById('page-add-suffix-input') as HTMLInputElement | null;

      if (titleInput) {
        titleInput.value = getLocaleVal(activePageDoc.title, currentLang);
        titleInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.title)})` : 'Enter page title...';
      }
      if (slugInput) {
        slugInput.value = activePageDoc.slug?.current || '/';
      }
      if (metaTitleInput) {
        metaTitleInput.value = getLocaleVal(activePageDoc.metaTitle, currentLang);
        metaTitleInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.metaTitle)})` : 'SEO Page Title...';
      }
      if (metaDescInput) {
        metaDescInput.value = getLocaleVal(activePageDoc.metaDescription, currentLang);
        metaDescInput.placeholder = currentLang !== 'en' ? `(EN: ${getFallbackEn(activePageDoc.metaDescription)})` : 'SEO Meta Description...';
      }
      if (suffixInput) {
        suffixInput.checked = activePageDoc.addTitleSuffix !== false;
      }
    }

    function renderSocialImagePreview() {
      const el = document.getElementById('social-image-preview');
      const btnRemove = document.getElementById('btn-remove-social-image');
      if (!el) return;

      const imgUrl = (window as any).resolveSanityRefUrl?.(activePageDoc?.socialImage) ||
        activePageDoc?.socialImage?.asset?.url || '';

      if (imgUrl) {
        el.innerHTML = `<img src="${escapeHtml(imgUrl)}" class="w-full h-full object-cover" />`;
        btnRemove?.classList.remove('hidden');
      } else {
        el.innerHTML = `<span class="text-[9px] text-[#86868b]">No Image</span>`;
        btnRemove?.classList.add('hidden');
      }
    }

    document.getElementById('btn-choose-social-image')?.addEventListener('click', () => {
      (window as any).__openMediaLibrary?.({
        mode: 'single',
        title: 'Choose Social Sharing Preview Image (socialImage)',
        onSelect: (selectedAssets: any[]) => {
          if (!selectedAssets || selectedAssets.length === 0) return;
          const asset = selectedAssets[0];
          activePageDoc.socialImage = {
            _type: 'image',
            asset: {
              _type: 'reference',
              _ref: asset._id,
            },
          };
          renderSocialImagePreview();
          (window as any).__showToast?.('Updated social sharing image', 'success');
        },
      });
    });

    document.getElementById('btn-remove-social-image')?.addEventListener('click', () => {
      activePageDoc.socialImage = null;
      renderSocialImagePreview();
    });

    function syncMetaFromDom() {
      if (!activePageDoc) return;
      const titleInput = document.getElementById('page-title-input') as HTMLInputElement | null;
      const slugInput = document.getElementById('page-slug-input') as HTMLInputElement | null;
      const metaTitleInput = document.getElementById('page-metatitle-input') as HTMLInputElement | null;
      const metaDescInput = document.getElementById('page-metadesc-input') as HTMLInputElement | null;
      const suffixInput = document.getElementById('page-add-suffix-input') as HTMLInputElement | null;

      // Bug 2 Fix: Unconditional assignment when DOM element exists so clearing fields works
      if (titleInput) activePageDoc.title = setLocaleVal(activePageDoc.title, titleInput.value.trim(), currentLang);
      if (metaTitleInput) activePageDoc.metaTitle = setLocaleVal(activePageDoc.metaTitle, metaTitleInput.value.trim(), currentLang);
      if (metaDescInput) activePageDoc.metaDescription = setLocaleVal(activePageDoc.metaDescription, metaDescInput.value.trim(), currentLang);
      if (slugInput) activePageDoc.slug = { _type: 'slug', current: slugInput.value.trim() || '/' };
      if (suffixInput) activePageDoc.addTitleSuffix = suffixInput.checked;
    }

    // Add Section button (initial values imported from @utils/adminPageSchemas)
    document.getElementById('btn-add-section')?.addEventListener('click', () => {
      if (!activePageDoc) {
        (window as any).__showToast?.('Please select a page first', 'warning');
        return;
      }
      syncSectionsFromDom();
      const select = document.getElementById('select-new-section') as HTMLSelectElement;
      const type = select?.value || 'heroSection';
      const newSec = getSectionInitialValues(type);
      activePageDoc.sections.push(newSec);
      renderSections();
      (window as any).__showToast?.(`Added new ${type} section with multi-language copy`, 'success');
    });

    // Resolve Section Thumbnail for Header
    function getSectionThumbnail(sec: any): string {
      if (sec._type === 'heroSection' && sec.heroImage) {
        return (window as any).resolveSanityRefUrl?.(sec.heroImage);
      }
      if (sec._type === 'featureMatrixSection' && sec.macroImage) {
        return (window as any).resolveSanityRefUrl?.(sec.macroImage);
      }
      if (sec._type === 'customSection' && sec.blocks) {
        const mediaB = sec.blocks.find((b: any) => b._type === 'mediaBlock' && b.image);
        if (mediaB) return (window as any).resolveSanityRefUrl?.(mediaB.image);
      }
      return '';
    }

    // Render Section Card Header Preview Info
    function getSectionSummary(sec: any): { title: string; subtitle: string } {
      const adminName = sec.adminLabel || '';
      const headline = getLocaleVal(sec.headline || sec.title || sec.superTitle, currentLang);
      const title = adminName || headline || 'Untitled Section';

      let subtitle = '';
      switch (sec._type) {
        case 'heroSection':
          subtitle = `Buttons: ${sec.showPrimaryButton ? 'Primary On' : 'Off'} · ${sec.showSecondaryButton ? 'Secondary On' : 'Off'}`;
          break;
        case 'productShowcaseSection':
          subtitle = `Showcase: ${sec.products?.length || 0} products selected`;
          break;
        case 'featureMatrixSection':
          subtitle = `Bento: 5 spec cards configured`;
          break;
        case 'manufacturingSection':
          subtitle = `Capabilities: ${sec.capabilities?.length || 0} power items`;
          break;
        case 'inquirySection':
          subtitle = `Categories: ${sec.categories?.join(', ') || 'Default'}`;
          break;
        case 'customSection':
          subtitle = `Preset: ${sec.preset || 'custom'} · ${sec.blocks?.length || 0} blocks`;
          break;
        default:
          subtitle = sec._type;
      }

      return { title, subtitle };
    }

    // Render Modular Sections Container (Pure Rendering)
    function renderSections() {
      const container = document.getElementById('sections-container');
      if (!container) return;

      const sections = activePageDoc?.sections || [];
      if (sections.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center text-[#86868b] border border-dashed border-black/10 rounded-2xl space-y-2 bg-[#fafafc]">
            <p class="font-medium text-xs text-[#1d1d1f]">This page has no sections yet.</p>
            <p class="text-[11px]">Select a block type from the dropdown above and click "＋ Add Section".</p>
          </div>
        `;
        return;
      }

      container.innerHTML = sections.map((sec: any, idx: number) => {
        const type = sec._type || 'customSection';
        const meta = SECTION_TYPE_META[type] || { label: type, badgeClass: 'bg-gray-100 text-gray-900 border-gray-200' };
        const summary = getSectionSummary(sec);
        const thumbUrl = getSectionThumbnail(sec);
        // Bug 3 Fix: Stable collapse state based on sec._key
        const secKey = sec._key || String(idx);
        const isCollapsed = collapsedSections.has(secKey);

        return `
          <div
            class="section-card rounded-2xl bg-[#fafafc] border border-black/10 shadow-2xs overflow-hidden transition-all select-none"
            data-idx="${idx}"
            data-key="${escapeHtml(secKey)}"
            data-type="${type}"
          >
            <!-- Card Header -->
            <div class="p-3 sm:px-4 bg-white border-b border-black/5 flex items-center justify-between gap-3 cursor-pointer select-none card-header-row hover:bg-[#fafafc]">
              <div class="flex items-center gap-2.5 min-w-0">
                <!-- Drag Handle -->
                <div class="drag-handle p-1 text-[#86868b] hover:text-[#1d1d1f] cursor-grab active:cursor-grabbing text-xs" title="Drag to reorder">
                  ⠿
                </div>
                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono font-bold bg-[#f5f5f7] border border-black/5 text-[#52525b]">
                  #${idx + 1}
                </span>

                <!-- Thumbnail Preview (if present) -->
                ${thumbUrl ? `
                  <img src="${escapeHtml(thumbUrl)}?w=80&h=80&fit=crop" class="w-9 h-9 rounded-lg object-cover border border-black/10 shrink-0" />
                ` : ''}

                <!-- Titles and Status Summary -->
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border ${meta.badgeClass}">
                      ${meta.label}
                    </span>
                    <h4 class="font-bold text-xs text-[#1d1d1f] truncate">${escapeHtml(summary.title)}</h4>
                  </div>
                  <p class="text-[10px] text-[#86868b] truncate mt-0.5">${escapeHtml(summary.subtitle)}</p>
                </div>
              </div>

              <!-- Card Actions -->
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" class="btn-sec-up p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Move Up">▲</button>
                <button type="button" class="btn-sec-down p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Move Down">▼</button>
                <button type="button" class="btn-sec-copy p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5" data-idx="${idx}" title="Duplicate Section">📋</button>
                <button type="button" class="btn-sec-del p-1 rounded-md text-[#86868b] hover:text-rose-600 hover:bg-rose-50" data-idx="${idx}" title="Delete Section">✕</button>
                <button type="button" class="btn-sec-toggle p-1 rounded-md text-[#86868b] hover:text-black hover:bg-black/5 ml-1" data-key="${escapeHtml(secKey)}" title="Expand / Collapse">
                  ${isCollapsed ? '▾' : '▴'}
                </button>
              </div>
            </div>

            <!-- Card Body (Dedicated Form per _type) -->
            <div class="section-card-body p-4 sm:p-5 space-y-4 ${isCollapsed ? 'hidden' : ''}">
              ${renderSectionForm(sec, idx)}
            </div>
          </div>
        `;
      }).join('');

      attachSectionEvents();
    }

    // Section schemas (SECTION_FIELD_SPECS, CAPABILITY_FIELDS, BLOCK_FIELD_SPECS) imported from @utils/adminPageSchemas

    function renderImagePickerRow(label: string, sublabel: string, target: string, imgUrl: string, idx: number): string {
      return `
        <div class="p-3 rounded-xl bg-white border border-black/10 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-lg bg-[#f5f5f7] border border-black/10 overflow-hidden flex items-center justify-center shrink-0">
              ${imgUrl ? `<img src="${escapeHtml(imgUrl)}" class="w-full h-full object-cover" />` : `<span class="text-[9px] text-[#86868b]">No Image</span>`}
            </div>
            <div>
              <span class="block font-semibold text-xs text-[#1d1d1f]">${escapeHtml(label)}</span>
              ${sublabel ? `<span class="text-[10px] text-[#86868b]">${escapeHtml(sublabel)}</span>` : ''}
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="btn-sec-choose-image adm-btn" data-target="${escapeHtml(target)}" data-idx="${idx}">
              📁 From Media Library
            </button>
            ${imgUrl ? `<button type="button" class="btn-sec-clear-image px-2 py-1.5 rounded-xl text-rose-600 hover:bg-rose-50 text-xs cursor-pointer" data-target="${escapeHtml(target)}" data-idx="${idx}">✕</button>` : ''}
          </div>
        </div>
      `;
    }

    function renderSectionForm(sec: any, idx: number): string {
      const type = sec._type;
      const specs = SECTION_FIELD_SPECS[type];
      if (!specs) {
        return `<div class="p-4 text-xs text-[#86868b]">Unknown section type: ${escapeHtml(type)}</div>`;
      }

      const fieldsHtml = `<div data-sec-fields>${renderSchemaFields(specs, sec, currentLang)}</div>`;

      if (type === 'heroSection') {
        const heroImgUrl = (window as any).resolveSanityRefUrl?.(sec.heroImage) || '';
        return `<div class="space-y-4">${fieldsHtml}${renderImagePickerRow('Hero Cover Image (首屏大图)', 'Select high-res visual from cloud media library', 'heroImage', heroImgUrl, idx)}</div>`;
      }

      if (type === 'featureMatrixSection') {
        const macroImgUrl = (window as any).resolveSanityRefUrl?.(sec.macroImage) || '';
        return `<div class="space-y-4">${fieldsHtml}${renderImagePickerRow('Macro Feature Image (macroImage)', 'Select macro yarn/fabric detail visual', 'macroImage', macroImgUrl, idx)}</div>`;
      }

      if (type === 'productShowcaseSection') {
        const selectedRefs: any[] = sec.products || [];
        return `
          <div class="space-y-4">
            ${fieldsHtml}
            <div class="p-3.5 rounded-xl bg-white border border-black/10 space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <span class="block font-bold text-xs text-[#1d1d1f]">🧦 Showcase Products (已选展示款式: ${selectedRefs.length})</span>
                  <span class="text-[10px] text-[#86868b]">Drag or click arrows to reorder items inside this showcase block</span>
                </div>
                <select class="picker-add-product adm-select" data-idx="${idx}">
                  <option value="">＋ Add Product to Showcase...</option>
                  ${catalogProducts.map((p) => `<option value="${p._id}">${escapeHtml(p.sku || '')} · ${escapeHtml(getFallbackEn(p.title))}</option>`).join('')}
                </select>
              </div>
              <div class="space-y-1.5 max-h-56 overflow-y-auto divide-y divide-black/5 bg-[#fafafc] p-2 rounded-xl border border-black/5">
                ${selectedRefs.length === 0
                  ? `<div class="py-4 text-center text-[#86868b] text-[11px]">No products added to this showcase. Select one above.</div>`
                  : selectedRefs.map((refItem: any, pIdx: number) => {
                      const refId = refItem._ref || refItem._id;
                      const prod = catalogProducts.find((p) => p._id === refId);
                      const thumb = prod ? (window as any).resolveSanityRefUrl?.(prod.mainImage) || prod.mainImageUrl : '';
                      const title = prod ? getFallbackEn(prod.title) : refId;
                      const sku = prod?.sku || '';
                      return `
                        <div class="flex items-center justify-between p-1.5 rounded-lg bg-white border border-black/5 gap-2">
                          <div class="flex items-center gap-2 min-w-0">
                            <span class="text-[10px] font-mono text-[#86868b]">#${pIdx + 1}</span>
                            ${thumb ? `<img src="${escapeHtml(thumb)}?w=60&h=60&fit=crop" class="w-6 h-6 rounded object-cover border border-black/10 shrink-0" />` : ''}
                            <span class="font-bold text-xs truncate text-[#1d1d1f]">${escapeHtml(title)}</span>
                            ${sku ? `<span class="px-1.5 py-0.2 rounded text-[9px] font-mono bg-[#f5f5f7] text-[#52525b]">${escapeHtml(sku)}</span>` : ''}
                          </div>
                          <div class="flex items-center gap-1 shrink-0">
                            <button type="button" class="btn-prod-up adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-prod-idx="${pIdx}">▲</button>
                            <button type="button" class="btn-prod-down adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-prod-idx="${pIdx}">▼</button>
                            <button type="button" class="btn-prod-del p-1 text-[10px] hover:bg-rose-50 text-rose-600 rounded" data-sec-idx="${idx}" data-prod-idx="${pIdx}">✕</button>
                          </div>
                        </div>`;
                    }).join('')}
              </div>
            </div>
          </div>`;
      }

      if (type === 'manufacturingSection') {
        const caps = sec.capabilities || [];
        return `
          <div class="space-y-4">
            ${fieldsHtml}
            <div class="p-3.5 rounded-xl bg-white border border-black/10 space-y-3">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-[#1d1d1f]">🏭 Manufacturing Capabilities (${caps.length} items)</span>
                <button type="button" class="btn-add-capability adm-btn" data-idx="${idx}">＋ Add Capability Card</button>
              </div>
              <div class="space-y-2">
                ${caps.map((cap: any, cIdx: number) => `
                  <div class="adm-subcard space-y-2" data-cap-row="${cIdx}">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-mono text-[#86868b]">#${cIdx + 1} Capability Card</span>
                      <div class="flex items-center gap-1">
                        <button type="button" class="btn-cap-up adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-cap-idx="${cIdx}">▲</button>
                        <button type="button" class="btn-cap-down adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-cap-idx="${cIdx}">▼</button>
                        <button type="button" class="btn-del-capability text-rose-600 text-xs hover:bg-rose-50 px-1.5 py-0.5 rounded ml-1" data-sec-idx="${idx}" data-cap-idx="${cIdx}">✕</button>
                      </div>
                    </div>
                    ${renderSchemaFields(CAPABILITY_FIELDS, cap, currentLang)}
                  </div>
                `).join('')}
              </div>
            </div>
          </div>`;
      }

      if (type === 'customSection') {
        const blocks = sec.blocks || [];
        return `
          <div class="space-y-4">
            ${fieldsHtml}
            <div class="p-3.5 rounded-xl bg-white border border-black/10 space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <span class="block font-bold text-xs text-[#1d1d1f]">🧱 Content Blocks Stream (${blocks.length} blocks)</span>
                  <span class="text-[10px] text-[#86868b]">Compose headings, media, button groups, metrics, or quotes</span>
                </div>
                <select class="picker-add-block adm-select" data-idx="${idx}">
                  <option value="">＋ Add Content Block...</option>
                  <option value="headingBlock">✍️ Heading & Text (headingBlock)</option>
                  <option value="mediaBlock">🖼️ Image & Media (mediaBlock)</option>
                  <option value="buttonGroupBlock">🔘 Action Buttons (buttonGroupBlock)</option>
                  <option value="metricGridBlock">📊 Metrics Grid (metricGridBlock)</option>
                  <option value="quoteBlock">💬 Client Quote (quoteBlock)</option>
                  <option value="dividerBlock">➖ Divider & Spacing (dividerBlock)</option>
                </select>
              </div>
              <div class="space-y-2">
                ${blocks.map((b: any, bIdx: number) => {
                  const bType = b._type || 'block';
                  const bSpecs = BLOCK_FIELD_SPECS[bType] || BLOCK_FIELD_SPECS.default;
                  const mediaPicker = bType === 'mediaBlock' ? `
                    <div class="flex items-center justify-between p-2 rounded bg-white border border-black/10">
                      <div class="flex items-center gap-2">
                        <div class="w-10 h-10 rounded bg-[#f5f5f7] overflow-hidden flex items-center justify-center shrink-0">
                          ${b.image ? `<img src="${escapeHtml((window as any).resolveSanityRefUrl?.(b.image))}" class="w-full h-full object-cover" />` : `<span class="text-[8px] text-[#86868b]">No Img</span>`}
                        </div>
                        <span class="text-xs font-semibold">Primary Media Image</span>
                      </div>
                      <button type="button" class="btn-choose-block-image adm-btn" data-sec-idx="${idx}" data-block-idx="${bIdx}">📁 Choose</button>
                    </div>` : '';
                  return `
                    <div class="adm-subcard space-y-2 block-card" data-sec-idx="${idx}" data-block-idx="${bIdx}" data-block-type="${bType}">
                      <div class="flex items-center justify-between border-b border-black/5 pb-1.5">
                        <span class="font-bold text-[11px] text-[#1d1d1f]">#${bIdx + 1} ${escapeHtml(bType)}</span>
                        <div class="flex items-center gap-1">
                          <button type="button" class="btn-block-up adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-block-idx="${bIdx}">▲</button>
                          <button type="button" class="btn-block-down adm-icon-btn text-[10px]" data-sec-idx="${idx}" data-block-idx="${bIdx}">▼</button>
                          <button type="button" class="btn-del-block text-rose-600 text-xs hover:bg-rose-50 px-1.5 py-0.5 rounded ml-1" data-sec-idx="${idx}" data-block-idx="${bIdx}">✕</button>
                        </div>
                      </div>
                      ${mediaPicker}
                      ${renderSchemaFields(bSpecs, b, currentLang)}
                    </div>`;
                }).join('')}
              </div>
            </div>
          </div>`;
      }

      return `<div class="space-y-4">${fieldsHtml}</div>`;
    }

    // Attach Event Listeners to Section Card Elements
    function attachSectionEvents() {
      const container = document.getElementById('sections-container');
      if (!container) return;

      // Bug 3 Fix: Collapse / Expand toggle using unique key
      container.querySelectorAll('.btn-sec-toggle').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const key = btn.getAttribute('data-key');
          if (!key) return;
          if (collapsedSections.has(key)) {
            collapsedSections.delete(key);
          } else {
            collapsedSections.add(key);
          }
          renderSections();
        });
      });

      // Card Header click to toggle
      container.querySelectorAll('.card-header-row').forEach((header) => {
        header.addEventListener('click', (e: any) => {
          if (e.target.closest('button') || e.target.closest('.drag-handle')) return;
          syncSectionsFromDom();
          const card = header.closest('.section-card');
          const key = card?.getAttribute('data-key');
          if (!key) return;
          if (collapsedSections.has(key)) {
            collapsedSections.delete(key);
          } else {
            collapsedSections.add(key);
          }
          renderSections();
        });
      });

      // Move Up
      container.querySelectorAll('.btn-sec-up').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx > 0) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx - 1, 0, item);
            renderSections();
          }
        });
      });

      // Move Down
      container.querySelectorAll('.btn-sec-down').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx < activePageDoc.sections.length - 1) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx + 1, 0, item);
            renderSections();
          }
        });
      });

      // Duplicate Section
      container.querySelectorAll('.btn-sec-copy').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const cloned = JSON.parse(JSON.stringify(activePageDoc.sections[idx]));
          cloned._key = crypto.randomUUID().slice(0, 8);
          if (cloned.adminLabel) cloned.adminLabel = `${cloned.adminLabel} (Copy)`;
          activePageDoc.sections.splice(idx + 1, 0, cloned);
          renderSections();
          (window as any).__showToast?.('Section duplicated', 'success');
        });
      });

      // Delete Section
      container.querySelectorAll('.btn-sec-del').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          activePageDoc.sections.splice(idx, 1);
          renderSections();
        });
      });

      // HTML5 Drag and Drop Reorder
      const cards = container.querySelectorAll('.section-card');
      cards.forEach((card) => {
        const handle = card.querySelector('.drag-handle');
        handle?.addEventListener('mouseenter', () => card.setAttribute('draggable', 'true'));
        handle?.addEventListener('mouseleave', () => card.removeAttribute('draggable'));

        card.addEventListener('dragstart', (e: any) => {
          draggedSectionIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          e.dataTransfer.effectAllowed = 'move';
          card.classList.add('opacity-40');
        });

        card.addEventListener('dragend', () => {
          draggedSectionIdx = null;
          card.classList.remove('opacity-40');
          cards.forEach((c) => c.classList.remove('ring-2', 'ring-black'));
        });

        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer!.dropEffect = 'move';
          card.classList.add('ring-2', 'ring-black');
        });

        card.addEventListener('dragleave', () => {
          card.classList.remove('ring-2', 'ring-black');
        });

        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('ring-2', 'ring-black');
          syncSectionsFromDom();
          const targetIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          if (draggedSectionIdx !== null && draggedSectionIdx !== targetIdx) {
            const item = activePageDoc.sections.splice(draggedSectionIdx, 1)[0];
            activePageDoc.sections.splice(targetIdx, 0, item);
            renderSections();
          }
        });
      });

      // Section Image Picker (heroImage, macroImage)
      container.querySelectorAll('.btn-sec-choose-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: `Select Image for ${target}`,
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              const asset = assets[0];
              activePageDoc.sections[idx][target] = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: asset._id,
                },
              };
              renderSections();
              (window as any).__showToast?.('Updated section image', 'success');
            },
          });
        });
      });

      container.querySelectorAll('.btn-sec-clear-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          activePageDoc.sections[idx][target] = null;
          renderSections();
        });
      });

      // Product Showcase Picker Add
      container.querySelectorAll('.picker-add-product').forEach((select: any) => {
        select.addEventListener('change', () => {
          syncSectionsFromDom();
          const idx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const prodId = select.value;
          if (!prodId) return;
          if (!activePageDoc.sections[idx].products) activePageDoc.sections[idx].products = [];
          activePageDoc.sections[idx].products.push({
            _key: crypto.randomUUID().slice(0, 8),
            _type: 'reference',
            _ref: prodId,
          });
          renderSections();
          (window as any).__showToast?.('Added product to showcase', 'success');
        });
      });

      // Product Showcase Reorder & Delete
      container.querySelectorAll('.btn-prod-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          if (pIdx > 0) {
            const item = activePageDoc.sections[sIdx].products.splice(pIdx, 1)[0];
            activePageDoc.sections[sIdx].products.splice(pIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].products;
          if (pIdx < list.length - 1) {
            const item = list.splice(pIdx, 1)[0];
            list.splice(pIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-del').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          activePageDoc.sections[sIdx].products.splice(pIdx, 1);
          renderSections();
        });
      });

      // Manufacturing Add Capability
      container.querySelectorAll('.btn-add-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (!activePageDoc.sections[sIdx].capabilities) activePageDoc.sections[sIdx].capabilities = [];
          activePageDoc.sections[sIdx].capabilities.push({
            _key: crypto.randomUUID().slice(0, 8),
            title: { _type: 'localeString', en: 'New Manufacturing Capability' },
            description: { _type: 'localeText', en: 'High capacity apparel fabrication line.' },
          });
          renderSections();
        });
      });

      // Manufacturing Move Up/Down & Delete Capability
      container.querySelectorAll('.btn-cap-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          if (cIdx > 0) {
            const item = activePageDoc.sections[sIdx].capabilities.splice(cIdx, 1)[0];
            activePageDoc.sections[sIdx].capabilities.splice(cIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-cap-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].capabilities;
          if (cIdx < list.length - 1) {
            const item = list.splice(cIdx, 1)[0];
            list.splice(cIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-del-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          activePageDoc.sections[sIdx].capabilities.splice(cIdx, 1);
          renderSections();
        });
      });

      // Custom Section Add Block
      container.querySelectorAll('.picker-add-block').forEach((select: any) => {
        select.addEventListener('change', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const blockType = select.value;
          if (!blockType) return;
          if (!activePageDoc.sections[sIdx].blocks) activePageDoc.sections[sIdx].blocks = [];

          let newBlock: any = { _key: crypto.randomUUID().slice(0, 8), _type: blockType };
          if (blockType === 'headingBlock') {
            newBlock.headline = 'New Section Heading';
            newBlock.subtitle = 'Supporting paragraph text.';
            newBlock.align = 'center';
          }
          activePageDoc.sections[sIdx].blocks.push(newBlock);
          renderSections();
        });
      });

      // Custom Section Block Reorder & Delete
      container.querySelectorAll('.btn-block-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          if (bIdx > 0) {
            const item = activePageDoc.sections[sIdx].blocks.splice(bIdx, 1)[0];
            activePageDoc.sections[sIdx].blocks.splice(bIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-block-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].blocks;
          if (bIdx < list.length - 1) {
            const item = list.splice(bIdx, 1)[0];
            list.splice(bIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-del-block').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          activePageDoc.sections[sIdx].blocks.splice(bIdx, 1);
          renderSections();
        });
      });

      // Custom Section Choose MediaBlock Image
      container.querySelectorAll('.btn-choose-block-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          syncSectionsFromDom();
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: 'Select Media Block Image',
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              activePageDoc.sections[sIdx].blocks[bIdx].image = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: assets[0]._id,
                },
              };
              renderSections();
            },
          });
        });
      });
    }

    // Read Form Values from DOM back into activePageDoc.sections
    // Bug 2 Fix: Unconditional assignment when input element exists in DOM (allows clearing text to "")
    function syncSectionsFromDom() {
      if (!activePageDoc?.sections) return;
      document.querySelectorAll<HTMLElement>('.section-card').forEach((card, idx) => {
        const key = card.getAttribute('data-key');
        const sec = (key && activePageDoc.sections.find((s: any) => s._key === key)) || activePageDoc.sections[idx];
        if (!sec) return;

        const secScope = card.querySelector('[data-sec-fields]') || card;
        syncSchemaFieldsFromDom(secScope, sec, currentLang);

        if (sec._type === 'manufacturingSection' && sec.capabilities) {
          sec.capabilities.forEach((cap: any, cIdx: number) => {
            const row = card.querySelector(`[data-cap-row="${cIdx}"]`);
            if (row) syncSchemaFieldsFromDom(row, cap, currentLang);
          });
        } else if (sec._type === 'customSection' && sec.blocks) {
          sec.blocks.forEach((b: any, bIdx: number) => {
            const bCard = card.querySelector(`.block-card[data-block-idx="${bIdx}"]`);
            if (bCard) syncSchemaFieldsFromDom(bCard, b, currentLang);
          });
        }
      });
    }

    // Save & Publish Page to Sanity CMS
    document.getElementById('btn-save-page')?.addEventListener('click', async () => {
      if (!activePageDoc) {
        (window as any).__showToast?.('No page loaded', 'error');
        return;
      }

      syncMetaFromDom();
      syncSectionsFromDom();

      (window as any).__showToast?.('Saving page & synchronizing KV/Edge cache...', 'info');

      try {
        const payload = { document: activePageDoc };
        const res = await fetch('/api/admin/cms/pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save page');

        (window as any).__showToast?.('Page saved & published successfully!', 'success');
        loadPages();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    });

    // Create New Page
    document.getElementById('btn-create-page')?.addEventListener('click', async () => {
      const promptRes = await (window as any).__admPrompt?.({
        title: 'Create New Landing Page',
        message: 'Define page display title and URL route slug.',
        confirmText: 'Create Page',
        fields: [
          { key: 'title', label: 'Page Title', placeholder: 'e.g. Cashmere Collection 2026', required: true },
          { key: 'slug', label: 'URL Slug', placeholder: 'e.g. /cashmere-collection', required: true },
        ],
      });
      const titlePrompt = promptRes?.title?.trim();
      const slugPrompt = promptRes?.slug?.trim();
      if (!titlePrompt || !slugPrompt) return;

      const cleanSlug = slugPrompt.startsWith('/') ? slugPrompt : `/${slugPrompt}`;

      activePageDoc = {
        _type: 'page',
        title: { _type: 'localeString', en: titlePrompt.trim() },
        slug: { _type: 'slug', current: cleanSlug },
        metaTitle: { _type: 'localeString', en: `${titlePrompt.trim()} | ${DEFAULT_BRAND_TITLE}` },
        metaDescription: { _type: 'localeText', en: 'B2B Wholesale & Luxury Apparel Manufacturing' },
        addTitleSuffix: true,
        sections: [getSectionInitialValues('heroSection')],
      };

      currentPages.push(activePageDoc);
      renderPagesList();
      populateMetaInputs();
      renderSocialImagePreview();
      renderSections();
      (window as any).__showToast?.('Created draft page. Click Save to publish.', 'info');
    });

    // Initialize
    loadCatalogProducts();
    loadPages();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagesWorkbench);
  } else {
    initPagesWorkbench();
  }

  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('pages-list')) {
      initPagesWorkbench();
    }
  });
</script>
