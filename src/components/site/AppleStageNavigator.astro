---
// src/components/site/AppleStageNavigator.astro
/**
 * Apple-style Minimalist Vertical Stage Navigator
 * Positioned cleanly along the right flank of the page content block.
 */
interface Props {
  stages?: Array<{
    id: string;
    num: string;
    label: string;
  }>;
}

const defaultStages = [
  { id: 'hero', num: '01', label: 'Overview' },
  { id: 'specs', num: '02', label: 'Specification' },
  { id: 'collections', num: '03', label: 'Silhouettes' },
  { id: 'manufacturing', num: '04', label: 'Infrastructure' },
  { id: 'inquiry', num: '05', label: 'Sample Request' }
];

const { stages = defaultStages } = Astro.props;
---

<nav
  id="apple-stage-nav"
  aria-label="Section presentation navigator"
  class="apple-stage-nav-dock select-none transition-opacity duration-300 opacity-0 pointer-events-none z-40"
>
  <!-- Minimalist Vertical Rail: White frosted capsule on desktop, transparent minimal dots on small screens -->
  <div class="stage-nav-pill flex flex-col items-center gap-3.5 py-3.5 px-1.5 rounded-full bg-white/80 backdrop-blur-2xl border border-black/8 shadow-[0_8px_30px_rgba(0,0,0,0.12)] transition-all duration-300">
    {stages.map((stage, idx) => (
      <button
        type="button"
        data-stage-target={stage.id}
        class={`stage-dot group relative flex items-center justify-center p-1 cursor-pointer focus:outline-hidden ${idx === 0 ? 'is-active' : ''}`}
        aria-label={`Go to stage ${stage.num}: ${stage.label}`}
      >
        <!-- Left Floating Label Tooltip (Reveals on desktop hover, hidden on touch devices) -->
        <div class="stage-tooltip hidden lg:flex absolute right-full mr-3.5 px-3 py-1 rounded-full text-[11px] font-medium tracking-tight bg-zinc-950/90 backdrop-blur-xl text-white border border-white/10 shadow-xl whitespace-nowrap opacity-0 translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 items-center gap-1.5">
          <span class="font-mono text-[9px] text-zinc-400">{stage.num}</span>
          <span>{stage.label}</span>
          <span class="absolute -right-1 top-1/2 -translate-y-1/2 w-2 h-2 bg-zinc-950/90 rotate-45 border-r border-t border-white/10"></span>
        </div>

        <!-- The Iconic Apple Capsule / Dot Indicator -->
        <span class="indicator-bar block w-1.5 h-1.5 rounded-full bg-zinc-900/30 group-hover:bg-zinc-900 group-hover:scale-125 transition-all duration-300"></span>
      </button>
    ))}
  </div>
</nav>

<style>
  /* Positioned seamlessly along the right flank of the central content block */
  .apple-stage-nav-dock {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    max-width: calc(100vw - 0.75rem);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Common Indicator Styling */
  .stage-dot .indicator-bar {
    width: 6px;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 9999px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Active Indicator (Common): Stretches to sleek capsule and turns dark */
  .stage-dot.is-active .indicator-bar {
    height: 1.5rem; /* 24px on desktop */
    width: 6px;
    background-color: #18181b !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3) !important;
  }

  /* Scheme B: Small screens & Mobile (< 1024px) - Strip white pill and keep ultra-minimal dots */
  @media (max-width: 1023px) {
    .apple-stage-nav-dock {
      right: max(0.375rem, env(safe-area-inset-right)) !important;
      left: auto !important;
      max-width: 20px !important;
    }

    .stage-nav-pill {
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      gap: 0.5rem !important;
    }

    .stage-dot {
      padding: 3px !important;
    }

    .stage-dot .indicator-bar {
      width: 5px !important;
      height: 5px !important;
      background-color: rgba(0, 0, 0, 0.25) !important;
      box-shadow: 0 0 1px rgba(255, 255, 255, 0.9) !important;
    }

    /* Mobile Active: Stretches to 18px black capsule with clean shadow */
    .stage-dot.is-active .indicator-bar {
      height: 18px !important;
      width: 5px !important;
      background-color: #000000 !important;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.6) !important;
    }
  }

  /* Desktop Screens (1024px+): Default fallback right margin (exact center axis) before JS dynamic centering */
  @media (min-width: 1024px) {
    .apple-stage-nav-dock {
      right: max(1rem, calc((100vw - 1360px) / 4 - 14px));
      left: auto;
    }
  }

  /* Active Tooltip: Subtle glow when active on hover */
  .stage-dot.is-active .stage-tooltip {
    border-color: rgba(255, 255, 255, 0.25) !important;
  }
</style>

<script>
  import { alignElementToRightGutter } from '@utils/device';

  function setupAppleStageNav() {
    const nav = document.getElementById('apple-stage-nav');
    if (!nav) return;

    // Enable snap scroll behavior on html element
    document.documentElement.classList.add('apple-snap-active');

    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-dot'));
    const stageIds = dots.map((d) => d.dataset.stageTarget).filter(Boolean) as string[];

    let currentIndex = -1;
    const stageMeta: Array<{ id: string; num: string; label: string; element: HTMLElement | null }> = stageIds.map((id, idx) => {
      const el = document.getElementById(id);
      const dot = dots[idx];
      const text = dot?.querySelector('.stage-tooltip span:nth-child(2)')?.textContent || id;
      return {
        id,
        num: String(idx + 1).padStart(2, '0'),
        label: text,
        element: el
      };
    });

    function updateActiveState(index: number) {
      if (index < 0 || index >= stageMeta.length || index === currentIndex) return;
      currentIndex = index;

      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });

      // Update URL quietly without triggering scroll jumps
      const targetId = stageMeta[index].id;
      if (window.location.hash !== `#${targetId}`) {
        history.replaceState(null, '', `#${targetId}`);
      }
    }

    function scrollToStage(index: number) {
      if (index < 0 || index >= stageMeta.length) return;
      const target = stageMeta[index].element;
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        updateActiveState(index);
      }
    }

    // Dot click listeners
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        scrollToStage(idx);
      });
    });

    // Industry Standard Focal Line ScrollSpy: 100% reliable tracking on mobile & desktop
    let scrollRafId = 0;
    function syncActiveStageOnScroll() {
      // Focus line at 38% from top of viewport
      const focalLine = window.innerHeight * 0.38;
      let activeIdx = -1;

      // 1. Check if at top
      if (window.scrollY < 80) {
        activeIdx = 0;
      }
      // 2. Check if reached bottom of page
      else if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 80) {
        activeIdx = stageMeta.length - 1;
      }
      // 3. Scan which section encompasses the focal reading line
      else {
        for (let i = 0; i < stageMeta.length; i++) {
          const el = stageMeta[i].element;
          if (!el) continue;
          const rect = el.getBoundingClientRect();
          if (rect.top <= focalLine && rect.bottom > focalLine) {
            activeIdx = i;
            break;
          }
        }
      }

      if (activeIdx !== -1) {
        updateActiveState(activeIdx);
      }
    }

    function onScrollThrottled() {
      if (scrollRafId) return;
      scrollRafId = requestAnimationFrame(() => {
        syncActiveStageOnScroll();
        scrollRafId = 0;
      });
    }

    window.addEventListener('scroll', onScrollThrottled, { passive: true });

    // Hide indicator when reaching footer so it doesn't overlap copyright links
    const footer = document.querySelector('footer');
    if (footer) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            nav.classList.add('opacity-0', 'pointer-events-none');
          } else {
            nav.classList.remove('opacity-0', 'pointer-events-none');
          }
        },
        { threshold: 0.15 }
      );
      footerObserver.observe(footer);
    }

    // Dynamically align the floating navigator precisely to the horizontal center axis of right gutter
    function alignToContentFlank() {
      alignElementToRightGutter(nav);
    }

    // Initialize first active stage based on URL hash or initial scroll position
    const currentHash = window.location.hash.replace('#', '');
    const initialIndex = stageMeta.findIndex((s) => s.id === currentHash);
    if (initialIndex !== -1) {
      updateActiveState(initialIndex);
    } else {
      syncActiveStageOnScroll();
    }

    alignToContentFlank();
    window.addEventListener('resize', alignToContentFlank, { passive: true });
    window.addEventListener('load', alignToContentFlank, { passive: true });

    // Smooth entry fade-in with progressive alignment passes
    setTimeout(alignToContentFlank, 50);
    setTimeout(() => {
      alignToContentFlank();
      syncActiveStageOnScroll();
      nav.classList.remove('opacity-0', 'pointer-events-none');
    }, 150);
  }

  // Support direct load & Astro page-load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAppleStageNav);
  } else {
    setupAppleStageNav();
  }
  document.addEventListener('astro:page-load', setupAppleStageNav);
</script>
