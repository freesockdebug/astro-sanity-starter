---
// src/components/hosiery/SockCollections.astro
const collections = [
  {
    id: "silk-loafer",
    title: "Mulberry Silk Loafer Sock",
    tagline: "Invisible Comfort for Luxury Footwear",
    image: "/images/sock-silk-loafer.jpg",
    composition: "88% Grade 6A Mulberry Silk, 12% Spandex",
    gauge: "200-Needle Ultra-Thin",
    moq: "200 Pairs",
    features: ["360° Non-Slip Silicone Heel", "Breathable Mesh Sole", "Deep Cut Invisible Fit"],
    colors: ["#f5edd8", "#1c1917", "#e7e5e4"]
  },
  {
    id: "cashmere-crew",
    title: "Ribbed Cashmere-Silk Crew",
    tagline: "The Everyday Signature Slouch",
    image: "/images/sock-cashmere-crew.jpg",
    composition: "70% Inner Mongolian Cashmere, 30% Silk",
    gauge: "176-Needle Derby Rib",
    moq: "150 Pairs",
    features: ["Zero-Pressure Ribbed Welt", "Hand-Linked Seamless Toe", "Cloud-Soft Brushed Loft"],
    colors: ["#d6d3d1", "#78716c", "#a8a29e", "#e7e5e4"]
  },
  {
    id: "sheer-tights",
    title: "15D Invisible Sheer Tights",
    tagline: "Second-Skin Compression & Durability",
    image: "/images/hero-light.jpg",
    composition: "80% Italian Bi-Component Nylon, 20% Elastane",
    gauge: "400-Needle Seamless Circular",
    moq: "300 Pairs",
    features: ["Run-Resistant Fusion Yarn", "Ergonomic Control Top", "Cotton Hygiene Gusset"],
    colors: ["#18181b", "#d4b996", "#a18262"]
  },
  {
    id: "merino-slouch",
    title: "Superfine 18.5µ Merino Boot Sock",
    tagline: "All-Day Thermal Temperature Regulation",
    image: "/images/spec-light.jpg",
    composition: "85% Australian Merino Wool, 15% Nylon",
    gauge: "144-Needle Terry Loop",
    moq: "200 Pairs",
    features: ["Natural Odor Neutralization", "Cushioned Arch Support", "Pre-Shrunk Machine Washable"],
    colors: ["#44403c", "#a8a29e", "#f5f5f4"]
  }
];

import { fetchAllProducts } from '@data/products';
import { fetchData as fetchSiteConfig } from '@data/siteConfig';
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { SanityImageService } from '@utils/image';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  swatchSku?: string;
  showActionButton?: boolean;
  actionButtonText?: string;
  actionButtonUrl?: string;
  showCardQuoteButton?: boolean;
  cardDetailsButtonText?: string;
  cardQuoteButtonText?: string;
  products?: any[];
}

const {
  badge = "Capsule Catalog 2026",
  title = "Ready-to-Order Line Sheets",
  subtitle = "Proprietary silhouettes developed for white-labeling, brand customization, and low-MOQ rapid wholesale reordering.",
  swatchSku,
  showActionButton: propShowAction,
  actionButtonText: propActionText,
  actionButtonUrl = "#inquiry",
  showCardQuoteButton: propShowCardQuote,
  cardDetailsButtonText = "View Gallery & Specs",
  cardQuoteButtonText,
  products: propProducts
} = Astro.props;

const siteConfig = await fetchSiteConfig();
const rfqSettings = await fetchRfqSettings();
const actionButtonText = propActionText?.trim() || rfqSettings?.heroSwatchBtnText?.trim() || "Request Swatch Kit";
const resolvedCardQuoteText = cardQuoteButtonText || rfqSettings?.cardQuoteBtnText || "Quote";

// Only display products added to this section in Sanity Studio; unadded products are not displayed
const rawProducts = propProducts !== undefined ? (propProducts || []) : await fetchAllProducts();
const hasSanityProducts = rawProducts && rawProducts.length > 0;
const sanityProducts = hasSanityProducts ? rawProducts : [];

function resolveTitle(item: any) {
  if (item?.shortTitle && item.shortTitle.trim()) {
    return item.shortTitle.trim();
  }
  const title = item?.title || "Curated Knit";
  const cleaned = title.replace(/\([^)]*\)/g, '').trim();
  return cleaned || title;
}

const activeCollections = hasSanityProducts
  ? sanityProducts.map((p: any) => ({
      id: p.slug || p._id,
      title: resolveTitle(p),
      fullTitle: p.title,
      tagline: p.tagline,
      image: SanityImageService.thumbnail(p.mainImage || (p.gallery && p.gallery[0]?.src) || "/images/hero-light.jpg", 700),
      composition: (p.specifications && p.specifications[0]?.value) || "Luxury Knit Blend",
      gauge: (p.specifications && p.specifications[1]?.value) || "200-Needle Fine Knit",
      moq: p.moq || "200 Pairs",
      colors: p.colors?.map((c: any) => c.hex) || ["#1c1917", "#e7e5e4"]
    }))
  : collections.map((c: any) => ({
      ...c,
      title: resolveTitle(c),
      fullTitle: c.title
    }));

const isSwatchAction = (actionButtonText || "").toLowerCase().includes("swatch") || actionButtonUrl === "#inquiry";
const showHeaderActionButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowAction,
  settingOverride: rfqSettings?.showCollectionsHeaderButton,
  isSwatchAction,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: actionButtonText,
});

const showCardQuoteButton = propShowCardQuote !== undefined
  ? Boolean(propShowCardQuote)
  : (rfqSettings?.showCardQuoteButton ?? true);
---

<section id="collections" class="bg-white text-[#1d1d1f] border-t border-black/5 py-6 sm:py-8 lg:py-4 lg:h-[calc(100svh-44px)] lg:max-h-[860px] lg:min-h-[560px] flex flex-col justify-between overflow-hidden">
  <div class="apple-rail-bento w-full flex-1 flex flex-col justify-between min-h-0">
    <!-- Section Header (Centered & Compact) -->
    <div class="apple-rail-narrow text-center mb-2 sm:mb-3 lg:mb-3 space-y-0.5 sm:space-y-1 shrink-0">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#86868b] block">{badge}</span>
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold tracking-tight text-[#1d1d1f]">
        {title}
      </h2>
      <p class="text-xs sm:text-[13px] text-[#86868b] max-w-xl mx-auto font-normal leading-relaxed line-clamp-1 sm:line-clamp-2">
        {subtitle}
      </p>
      <div class="pt-1 flex items-center justify-center gap-3">
        {showHeaderActionButton && (
          <a
            href={actionButtonUrl}
            data-swatch-sku={swatchSku}
            class="px-4 py-1.5 rounded-full text-xs font-medium bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm inline-flex items-center gap-1.5"
          >
            <span>{actionButtonText}</span>
            <span aria-hidden="true">›</span>
          </a>
        )}
        <!-- Desktop Carousel Navigation Buttons -->
        <div id="collections-arrows-container" class="hidden sm:inline-flex items-center gap-1.5">
          <button
            id="collections-prev-btn"
            type="button"
            aria-label="Previous products"
            class="w-7 h-7 rounded-full bg-[#f5f5f7] hover:bg-[#e8e8ed] text-[#1d1d1f] flex items-center justify-center transition-all border border-black/5 cursor-pointer shadow-2xs disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            id="collections-next-btn"
            type="button"
            aria-label="Next products"
            class="w-7 h-7 rounded-full bg-[#f5f5f7] hover:bg-[#e8e8ed] text-[#1d1d1f] flex items-center justify-center transition-all border border-black/5 cursor-pointer shadow-2xs disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Collection Shelf: Flex-1 Vertically Auto-Fitted Shelf (Never Overshoots Screen) -->
    <div
      id="collections-shelf"
      class="flex-1 min-h-0 flex overflow-x-auto snap-x snap-mandatory gap-4 sm:gap-5 pb-2 pt-1 no-scrollbar scroll-smooth items-stretch lg:items-center"
    >
      {activeCollections.map((item: any) => (
        <div class="group shrink-0 w-[78vw] max-w-[300px] sm:w-[310px] lg:w-[320px] xl:w-[340px] h-auto lg:h-full lg:max-h-[490px] snap-start rounded-2xl sm:rounded-3xl bg-[#f5f5f7] border border-black/5 hover:border-black/15 hover:shadow-xl transition-all duration-300 p-4 sm:p-5 flex flex-col justify-between">
          <div class="flex-1 min-h-0 flex flex-col">
            <!-- Card Header: Title & Specs Subtitle (Standardized height to align across all cards) -->
            <div class="shrink-0 h-[44px] flex flex-col justify-center">
              <a href={`/products/${item.id}`} class="block">
                <h3 class="text-base sm:text-lg font-semibold text-[#1d1d1f] tracking-tight group-hover:text-black transition-colors line-clamp-1 leading-snug">
                  {item.title}
                </h3>
              </a>
              <p class="text-xs text-[#86868b] mt-0.5 line-clamp-1">{item.composition}</p>
            </div>

            <!-- Card Image Box: Strict 1:1 square on mobile to prevent height variance; flex-1 auto-fit on desktop -->
            <a
              href={`/products/${item.id}`}
              class="block relative w-full aspect-square lg:aspect-auto lg:flex-1 lg:min-h-0 rounded-xl sm:rounded-2xl overflow-hidden bg-white shadow-inner my-2.5 group-hover:shadow-md transition-shadow shrink-0 lg:shrink"
            >
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </a>

            <!-- Color Palette Dots & Gauge / MOQ Spec -->
            <div class="shrink-0 flex items-center justify-between pt-0.5">
              <div class="flex items-center gap-1 -ml-1">
                {item.colors.map((colorHex: string) => (
                  <span
                    class="w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-full hover:scale-110 active:scale-95 transition-transform cursor-pointer select-none"
                    title={`Color: ${colorHex}`}
                  >
                    <span
                      class="w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full border border-black/15 shadow-2xs block"
                      style={`background-color: ${colorHex}`}
                    ></span>
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-1.5">
                {item.gauge && (
                  <span class="hidden sm:inline-block text-[10px] font-mono text-[#86868b] bg-white px-2 py-0.5 rounded-md border border-black/5">
                    {item.gauge}
                  </span>
                )}
                <span class="text-[10px] sm:text-[11px] font-mono font-medium text-[#1d1d1f]">MOQ {item.moq}</span>
              </div>
            </div>
          </div>

          <!-- Bottom Action: Refined Apple Clean Pill -->
          <div class="shrink-0 mt-3 pt-2.5 border-t border-black/5 flex items-center justify-between">
            <a
              href={`/products/${item.id}`}
              class="text-xs font-semibold text-[#1d1d1f] hover:underline inline-flex items-center gap-1"
            >
              <span>{cardDetailsButtonText}</span>
              <span aria-hidden="true">›</span>
            </a>
            {showCardQuoteButton && (
              <button
                type="button"
                class="btn-card-add-quote px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[11px] font-medium bg-white hover:bg-[#1d1d1f] hover:text-white text-[#1d1d1f] border border-black/10 transition-all cursor-pointer flex items-center gap-1 shadow-2xs"
                data-id={item.id}
                data-title={item.title}
                data-image={item.image}
                data-moq={item.moq}
                title="Add to Quote Basket (RFQ)"
              >
                <span aria-hidden="true">+</span>
                <span>{resolvedCardQuoteText}</span>
              </button>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Swipe / Scroll Visual Hint -->
    <div id="collections-scroll-hint" class="shrink-0 flex items-center justify-center gap-1.5 pt-1 text-[11px] font-medium text-[#86868b]">
      <span class="sm:hidden">Swipe to explore all silhouettes</span>
      <span class="hidden sm:inline">Scroll horizontally or use arrows to explore all silhouettes</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</section>

<script>
  import { addToQuote } from '../../stores/quoteCart';

  // Desktop horizontal shelf scroll arrows & dynamic centering
  const shelf = document.getElementById('collections-shelf');
  const arrowsContainer = document.getElementById('collections-arrows-container');
  const scrollHint = document.getElementById('collections-scroll-hint');
  const prevBtn = document.getElementById('collections-prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('collections-next-btn') as HTMLButtonElement | null;

  function updateArrowStates() {
    if (!shelf || !prevBtn || !nextBtn) return;
    const { scrollLeft, scrollWidth, clientWidth } = shelf;
    prevBtn.disabled = scrollLeft <= 10;
    nextBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 10;
  }

  function checkShelfOverflow() {
    if (!shelf) return;
    const children = Array.from(shelf.children) as HTMLElement[];
    if (children.length === 0) return;

    let totalWidth = 0;
    children.forEach((child) => {
      totalWidth += child.offsetWidth;
    });

    const gap = parseFloat(window.getComputedStyle(shelf).gap || '24') || 24;
    totalWidth += (children.length - 1) * gap;

    // Compare total products width against container client width
    const isOverflowing = totalWidth > shelf.clientWidth + 2;

    if (isOverflowing) {
      shelf.classList.remove('justify-center');
      shelf.classList.add('justify-start');
      if (arrowsContainer) arrowsContainer.style.display = '';
      if (scrollHint) scrollHint.style.display = '';
      updateArrowStates();
    } else {
      shelf.classList.remove('justify-start');
      shelf.classList.add('justify-center');
      if (arrowsContainer) arrowsContainer.style.display = 'none';
      if (scrollHint) scrollHint.style.display = 'none';
    }
  }

  // Initial check & reactive resize observer
  checkShelfOverflow();

  if (typeof ResizeObserver !== 'undefined' && shelf) {
    const ro = new ResizeObserver(() => {
      checkShelfOverflow();
    });
    ro.observe(shelf);
  } else {
    window.addEventListener('resize', checkShelfOverflow, { passive: true });
  }

  shelf?.addEventListener('scroll', updateArrowStates, { passive: true });

  prevBtn?.addEventListener('click', () => {
    shelf?.scrollBy({ left: -400, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    shelf?.scrollBy({ left: 400, behavior: 'smooth' });
  });

  document.querySelectorAll('.btn-card-add-quote').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.getAttribute('data-id') || '';
      const title = btn.getAttribute('data-title') || '';
      const imageUrl = btn.getAttribute('data-image') || '';
      const rawMoq = btn.getAttribute('data-moq') || '200';
      const moqNum = parseInt(rawMoq.replace(/\D/g, ''), 10) || 200;

      addToQuote({
        id,
        title,
        sku: 'CAPSULE',
        imageUrl,
        variant: 'Curated Sample',
        quantity: moqNum,
        moq: rawMoq,
      });

      if ((window as any).openQuoteDrawer) {
        (window as any).openQuoteDrawer();
      }
    });
  });
</script>
