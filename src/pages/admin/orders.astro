                    Pool
                  </span>
                  ${(canClaim || canAssign) ? `
                    <button
                      type="button"
                      class="btn-claim-order-row px-1.5 py-0.5 rounded text-[10px] font-semibold bg-[#1d1d1f] text-white hover:bg-black active:scale-95 transition-all shadow-2xs cursor-pointer"
