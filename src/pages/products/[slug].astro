---
// src/pages/products/[slug].astro
import Layout from '@layouts/Layout.astro';
import { AppleProductDetailSkeleton, Breadcrumbs } from '@components/index';
import { ProductService, resolveProductMoq, getCurrencySymbol } from '@data/products';
import { SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { cleanBrandTitle } from '@utils/format';
import { SanityImageService } from '@utils/image';
import { DEFAULT_BRAND_TITLE, DEFAULT_FALLBACK_IMAGE, DEFAULT_RFQ, DEFAULT_PRODUCT_DETAIL } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue, getLocalizedPath } from '@i18n';
import MarkdownRenderer from '@components/MarkdownRenderer.astro';
import SectionBoundary from '@components/SectionBoundary.astro';
import { getProductStory } from '@data/productStories';
import { SecurityService } from '@utils/security';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const { slug } = Astro.params;

// Resolve cached product list first (L1 memory -> L2 KV) to avoid uncached Sanity lookups for invalid/bot slugs
const allProductsRaw = await ProductService.getAll();
const allProducts = allProductsRaw || [];
if (!slug || (allProducts.length > 0 && !allProducts.some((p: any) => p.slug === slug))) {
  return Astro.redirect(getLocalizedPath('/products', currentLang));
}

// Multi-tier cached resolution: fetch current product & story settings concurrently with shared CMS services
const [currentProduct, siteConfig, rfqSettings, productStorySettings] = await Promise.all([
  ProductService.getBySlug(slug),
  SiteConfigService.getConfig(),
  RfqSettingsService.getSettings(),
  ProductService.getProductStorySettings(),
]);

if (!currentProduct) {
  return Astro.redirect(getLocalizedPath('/products', currentLang));
}

// Ensure product has fallbacks for arrays and images
currentProduct.gallery = (currentProduct.gallery && currentProduct.gallery.length > 0)
  ? currentProduct.gallery
  : [{ src: currentProduct.mainImage || DEFAULT_FALLBACK_IMAGE, alt: getLocalizedValue(currentProduct.title, currentLang) || 'Product' }];
currentProduct.colors = currentProduct.colors || [];
currentProduct.pricingTiers = currentProduct.pricingTiers || [];
currentProduct.specifications = currentProduct.specifications || [];
currentProduct.mainImage = currentProduct.mainImage || currentProduct.gallery[0]?.src || DEFAULT_FALLBACK_IMAGE;

const resolvedMoq = resolveProductMoq(currentProduct.pricingTiers, currentProduct.moq);
const currencySymbol = getCurrencySymbol(currentProduct.currency);
const unitPairLabel = t('catalog.unitPair');

const rawBrandTitle = siteConfig?.header?.title || DEFAULT_BRAND_TITLE;
const brandTitle = cleanBrandTitle(rawBrandTitle);

const currentIndex = allProducts.findIndex((p: any) => p.slug === slug);
const validIndex = currentIndex >= 0 ? currentIndex : 0;
const prevIndex = (validIndex - 1 + allProducts.length) % (allProducts.length || 1);
const nextIndex = (validIndex + 1) % (allProducts.length || 1);

const prevProduct = allProducts[prevIndex] || currentProduct;
const nextProduct = allProducts[nextIndex] || currentProduct;

const currentProductTitle = getLocalizedValue(currentProduct.title, currentLang);
const currentProductShortTitle = getLocalizedValue(currentProduct.shortTitle, currentLang) || currentProductTitle;
const currentProductTagline = getLocalizedValue(currentProduct.tagline, currentLang);
const prevProductTitle = getLocalizedValue(prevProduct.shortTitle || prevProduct.title, currentLang);
const nextProductTitle = getLocalizedValue(nextProduct.shortTitle || nextProduct.title, currentLang);

const addToQuoteBtnText = getLocalizedValue(
  currentProduct.addToQuoteButtonText,
  currentLang,
  getLocalizedValue(rfqSettings?.btnAddToQuoteText, currentLang, t('pdp.addToQuote'))
);

// Amazon Sample Buying Link Resolution
const rawAmazonUrl = currentProduct.amazonUrl || (currentProduct.amazonAsin ? `https://www.amazon.com/dp/${currentProduct.amazonAsin.trim()}` : null);
const amazonSampleUrl = rawAmazonUrl || rfqSettings?.defaultAmazonStoreUrl || `https://www.amazon.com/s?k=${encodeURIComponent(currentProductTitle || DEFAULT_BRAND_TITLE)}`;
const sampleButtonText = getLocalizedValue(
  currentProduct.sampleButtonText,
  currentLang,
  getLocalizedValue(rfqSettings?.btnSampleAmazonText, currentLang, t('pdp.buySampleAmazon'))
);

const showAddToQuoteButton = rfqSettings?.showProductAddToQuoteButton ?? true;
const showBuySampleButton = rfqSettings?.showProductBuySampleButton ?? true;
const showSpecSheetButton = rfqSettings?.showProductSpecSheetButton ?? true;

// Editorial Story Resolution (Multilingual Markdown with luxurious Craftsmanship Fallback)
const currentProductStoryBadge = getLocalizedValue(
  currentProduct.storyBadge,
  currentLang,
  getLocalizedValue(productStorySettings?.storyBadgeText, currentLang, t('pdp.storyBadge'))
);

const currentProductStoryHeading = getLocalizedValue(
  currentProduct.storyHeading,
  currentLang,
  getLocalizedValue(productStorySettings?.storyHeading, currentLang, t('pdp.storyHeading'))
);

const CREDENTIAL_THEME: Record<string, { color: string; path: string; strokeWidth?: string }> = {
  oekotex: {
    color: 'text-emerald-700',
    path: 'M5 13l4 4L19 7',
    strokeWidth: '2.2',
  },
  lonati: {
    color: 'text-amber-700',
    path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    strokeWidth: '2.2',
  },
  seamless: {
    color: 'text-zinc-900',
    path: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
    strokeWidth: '2.2',
  },
  gauge: {
    color: 'text-blue-700',
    path: 'M4 6h16M4 10h16M4 14h16M4 18h16',
    strokeWidth: '2',
  },
  fiber: {
    color: 'text-indigo-700',
    path: 'M13 10V3L4 14h7v7l9-11h-7z',
    strokeWidth: '2',
  },
};

const DEFAULT_CREDENTIALS_BY_LANG: Record<string, Array<{ iconType: string; title: string; description: string; tag: string }>> = {
  de: [
    {
      iconType: 'lonati',
      title: 'Italienische Lonati-Kalibrierung',
      description: 'Hochdichte Doppelzylinder-Nadelteilung für reibungsfreien dimensionalen Sitz.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Handgekettelte nahtlose Spitze',
      description: 'Echte 0,0 mm Nahtebene gegen Scheuern und Druckstellen im Schuh.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Strenge unabhängige Laborprüfung auf schädliche aromatische Amine und Allergene.',
      tag: 'Klasse I'
    }
  ],
  fr: [
    {
      iconType: 'lonati',
      title: 'Calibrage Italien Lonati',
      description: 'Densité d\'aiguilles haute jauge double cylindre sans frottement dimensionnel.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Finition Sans Couture Remaillée Main',
      description: 'Plan de couture 0,0 mm éliminant les irritations et points de pression.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Contrôle rigoureux en laboratoire indépendant contre les allergènes et amines.',
      tag: 'Classe I'
    }
  ],
  es: [
    {
      iconType: 'lonati',
      title: 'Calibración Italiana Lonati',
      description: 'Densidad de agujas de doble cilindro de alta galga sin fricción dimensional.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Acabado Remallado a Mano Sin Costuras',
      description: 'Plano de costura de 0,0 mm que elimina rozaduras y puntos de presión.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Riguroso análisis de laboratorio independiente para detectar aminas y alérgenos.',
      tag: 'Clase I'
    }
  ],
  en: [
    {
      iconType: 'lonati',
      title: 'Italian Lonati Calibration',
      description: 'High-gauge dual-cylinder needle density with zero-friction dimensional architecture.',
      tag: '200N'
    },
    {
      iconType: 'seamless',
      title: 'Hand-Linked Seamless Finish',
      description: 'True 0.0 mm seam plane eliminating ridge chafing and shoe pressure points.',
      tag: '0.0 mm'
    },
    {
      iconType: 'oekotex',
      title: 'OEKO-TEX® Standard 100',
      description: 'Rigorous independent lab screening for harmful aromatic amines and allergens.',
      tag: 'Class I'
    }
  ]
};

const defaultCredentials = DEFAULT_CREDENTIALS_BY_LANG[currentLang] || DEFAULT_CREDENTIALS_BY_LANG.en;

const rawCards = (productStorySettings?.credentials && productStorySettings.credentials.length > 0)
  ? productStorySettings.credentials
  : defaultCredentials;

const resolvedCredentials = rawCards.map((card: any) => {
  const icon = CREDENTIAL_THEME[card.iconType] || CREDENTIAL_THEME.lonati;
  return {
    iconType: card.iconType || 'lonati',
    title: getLocalizedValue(card.title, currentLang, card.title || 'Artisan Standard'),
    description: getLocalizedValue(card.description, currentLang, card.description || ''),
    tag: getLocalizedValue(card.tag, currentLang, card.tag || ''),
    customSvg: card.customSvg || '',
    accentColor: icon.color,
    iconPath: icon.path,
    strokeWidth: icon.strokeWidth || '2',
  };
});

const localizedSpecs = (currentProduct.specifications || [])
  .map((spec: any) => ({
    label: getLocalizedValue(spec?.label || spec?.name, currentLang, ''),
    value: getLocalizedValue(spec?.value, currentLang, ''),
  }))
  .filter((s: { label: string; value: string }) => s.label && s.value);

const quickSpecs = [
  {
    label: localizedSpecs[0]?.label || t('pdp.composition'),
    value: localizedSpecs[0]?.value || 'Combed Cotton Blend',
  },
  {
    label: localizedSpecs[1]?.label || t('pdp.quickGaugeLabel'),
    value: localizedSpecs[1]?.value || t('pdp.quickGaugeValue'),
  },
  {
    label: localizedSpecs[2]?.label || t('pdp.quickSeamLabel'),
    value: localizedSpecs[2]?.value || t('pdp.quickSeamValue'),
  },
];

const rawProductStory = getLocalizedValue(currentProduct.story, currentLang);
const generatedStory = getProductStory(
  {
    title: currentProductTitle,
    sku: currentProduct.sku,
    category: currentProduct.category?.slug || currentProduct.category?.title || (typeof currentProduct.category === 'string' ? currentProduct.category : ''),
    image: currentProduct.mainImage || currentProduct.gallery?.[0]?.src,
    secondaryImage: currentProduct.gallery?.[1]?.src || currentProduct.gallery?.[0]?.src || currentProduct.mainImage,
    composition: currentProduct.specifications?.[0]?.value,
    gauge: currentProduct.specifications?.[1]?.value,
    specifications: currentProduct.specifications,
  },
  currentLang
);

const storyMarkdown = (rawProductStory && typeof rawProductStory === 'string' && rawProductStory.trim().length > 0)
  ? rawProductStory
  : generatedStory;

const firstGalleryImg = currentProduct.gallery?.[0]?.src || currentProduct.mainImage;
const productHeroPreload = firstGalleryImg && typeof firstGalleryImg && (firstGalleryImg.includes('cdn.sanity.io') || firstGalleryImg.includes('/cdn-image/'))
  ? {
      src: SanityImageService.hero(firstGalleryImg, 1200),
      srcset: SanityImageService.srcSet(firstGalleryImg, [480, 800, 1200]),
      sizes: '(max-width: 1024px) 100vw, 800px',
    }
  : undefined;
const numericPrices = (currentProduct.pricingTiers || [])
  .map((tier: any) => {
    const raw = typeof tier?.price === 'string' ? tier.price.replace(/[^0-9.]/g, '') : String(tier?.price ?? '');
    return parseFloat(raw);
  })
  .filter((n: number) => !Number.isNaN(n) && n > 0);

const productStructuredData: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: currentProductTitle,
  description: currentProductTagline,
  sku: currentProduct.sku || slug,
  image: (currentProduct.gallery || [])
    .map((img: any) => img?.src)
    .filter(Boolean),
  brand: {
    '@type': 'Brand',
    name: brandTitle,
  },
  ...(numericPrices.length > 0
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: currentProduct.currency || 'USD',
          lowPrice: Math.min(...numericPrices).toFixed(2),
          highPrice: Math.max(...numericPrices).toFixed(2),
          offerCount: numericPrices.length,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<Layout
  title={currentProductTitle}
  description={currentProductTagline}
  image={currentProduct.mainImage}
  type="product"
  structuredData={productStructuredData}
  preloadHeroImage={productHeroPreload}
>
  <!-- Apple-Style Compact Sub-Navigation & Breadcrumbs with Prev / Next Switcher -->
  <Breadcrumbs currentTitle={currentProductShortTitle}>
    {allProducts.length > 1 && (
      <div slot="actions" class="flex items-center gap-1.5 shrink-0 text-xs font-medium font-sans">
        <a
          href={getLocalizedPath(`/products/${prevProduct.slug}`, currentLang)}
          data-pdp-nav-link
          class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
          title={`${t('pdp.prev')}: ${prevProductTitle}`}
        >
          <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="hidden sm:inline text-[11px]">{t('pdp.prev')}</span>
        </a>

        <span class="text-[11px] font-mono tabular-nums text-zinc-400 select-none px-0.5">
          {validIndex + 1} / {allProducts.length}
        </span>

        <a
          href={getLocalizedPath(`/products/${nextProduct.slug}`, currentLang)}
          data-pdp-nav-link
          class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
          title={`${t('pdp.next')}: ${nextProductTitle}`}
        >
          <span class="hidden sm:inline text-[11px]">{t('pdp.next')}</span>
          <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    )}
  </Breadcrumbs>

  <!-- Instant Perceived Performance Skeleton Overlay for Silhouette Navigation -->
  <AppleProductDetailSkeleton id="pdp-transition-skeleton" class="hidden" />

  <div id="pdp-live-content" class="bg-[#fdfcfb]">
  <section id="product-overview" class="product-hero-overview w-full py-6 sm:py-10 lg:py-12 border-b border-stone-200/70 bg-[#fdfcfb] overflow-visible scroll-mt-[var(--apple-header-offset)]">

        <!-- Center: 2-Column Editorial Showcase Grid -->
        <div class="apple-rail-bento w-full">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-14 items-start">
            
            <!-- LEFT: Sticky Editorial Gallery Canvas (7 Cols) -->
            <div class="product-gallery-col w-full min-w-0 lg:col-span-7 lg:sticky lg:top-[calc(var(--apple-header-offset)+1.5rem)] flex flex-col space-y-3">
              
              <!-- Main Viewport Box (Clean Photography Canvas with Warm Stone Studio Backdrop) -->
              <div class="relative w-full max-w-full min-w-0 aspect-[4/3] sm:aspect-[16/13] lg:aspect-[5/4] max-h-[600px] rounded-2xl overflow-hidden bg-[#f6f3ee] border border-stone-200/60 group flex items-center justify-center">
                <!-- Carousel Images Track (Native Scroll Snap for Silky Mobile Touch Swipe & Desktop Fluidity) -->
                <div 
                  id="carousel-track" 
                  class="w-full h-full flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth relative select-none touch-pan-x min-w-0 min-h-0"
                  style="scrollbar-width: none; -ms-overflow-style: none;"
                >
                  {currentProduct.gallery.map((img: any, idx: number) => (
                    <div
                      class="carousel-slide shrink-0 w-full h-full snap-center relative overflow-hidden apple-skeleton-surface flex items-center justify-center min-w-0 min-h-0"
                      data-index={idx}
                    >
                      <img
                        src={SanityImageService.hero(img.src, 1200)}
                        srcset={SanityImageService.srcSet(img.src, [480, 800, 1200]) || undefined}
                        sizes="(max-width: 1024px) 100vw, 800px"
                        alt={img.alt || currentProductTitle}
                        class="pdp-gallery-img absolute inset-0 m-auto max-w-[calc(100%-2rem)] max-h-[calc(100%-2rem)] w-auto h-auto object-contain pointer-events-none select-none transition-transform duration-700 group-hover:scale-[1.02]"
                        draggable="false"
                        loading={idx === 0 ? 'eager' : 'lazy'}
                        fetchpriority={idx === 0 ? 'high' : 'auto'}
                        decoding="async"
                        onload="this.parentElement && (this.parentElement.classList.add('apple-img-loaded'), this.parentElement.classList.remove('is-shimmer-active'), window.__unobserveAppleShimmer && window.__unobserveAppleShimmer(this.parentElement))"
                      />
                    </div>
                  ))}
                </div>

                <!-- Minimal Counter Badge -->
                <div class="absolute bottom-3.5 right-3.5 z-20 px-2.5 py-0.5 rounded-full text-[10px] font-mono tracking-widest bg-stone-900/55 backdrop-blur-md text-stone-100">
                  <span id="carousel-counter-curr">1</span> / <span id="carousel-counter-total">{currentProduct.gallery.length}</span>
                </div>

                <!-- Mobile Pagination Dots (Visual swipe indicator for touch devices) -->
                {currentProduct.gallery.length > 1 && (
                  <div class="sm:hidden absolute bottom-3.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-stone-900/40 backdrop-blur-md pointer-events-none">
                    {currentProduct.gallery.map((_: any, idx: number) => (
                      <span 
                        class={`carousel-dot h-1.5 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-white w-3' : 'bg-white/50 w-1.5'}`} 
                        data-dot-index={idx}
                      />
                    ))}
                  </div>
                )}

                <!-- Navigation Arrow Controls (Desktop only, hidden on mobile for clean touch experience) -->
                {currentProduct.gallery.length > 1 && (
                  <>
                    <button
                      type="button"
                      id="carousel-prev"
                      aria-label={t('pdp.prev')}
                      class="hidden sm:flex absolute left-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-[#fdfcfb]/85 hover:bg-[#fdfcfb] text-[#1c1917] border border-stone-200/70 shadow-sm backdrop-blur-md items-center justify-center transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                      </svg>
                    </button>

                    <button
                      type="button"
                      id="carousel-next"
                      aria-label={t('pdp.next')}
                      class="hidden sm:flex absolute right-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-[#fdfcfb]/85 hover:bg-[#fdfcfb] text-[#1c1917] border border-stone-200/70 shadow-sm backdrop-blur-md items-center justify-center transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </button>
                  </>
                )}
              </div>

              <!-- Refined Thumbnail Strip -->
              <div class="flex flex-row gap-2.5 overflow-x-auto no-scrollbar shrink-0 w-full max-w-full pb-0.5 scrollbar-none justify-start">
                {currentProduct.gallery.map((img: any, idx: number) => (
                  <button
                    type="button"
                    data-thumb-index={idx}
                    aria-label={`View image ${idx + 1}`}
                    class={`carousel-thumb shrink-0 w-13 h-13 sm:w-14 sm:h-14 lg:w-16 lg:h-16 rounded-xl overflow-hidden border transition-all duration-200 cursor-pointer bg-[#f6f3ee] apple-skeleton-surface flex items-center justify-center ${idx === 0 ? 'border-stone-900 opacity-100 shadow-xs' : 'border-transparent opacity-55 hover:opacity-90'}`}
                  >
                    <img
                      src={SanityImageService.thumbnail(img.src, 160)}
                      alt={img.alt || currentProductTitle}
                      class="pdp-gallery-img w-full h-full object-contain p-1"
                      loading="lazy"
                      decoding="async"
                      onload="this.parentElement && (this.parentElement.classList.add('apple-img-loaded'), this.parentElement.classList.remove('is-shimmer-active'), window.__unobserveAppleShimmer && window.__unobserveAppleShimmer(this.parentElement))"
                    />
                  </button>
                ))}
              </div>

              <p class="text-[11px] text-stone-400 font-mono text-center lg:text-left shrink-0">
                {getLocalizedValue(currentProduct.galleryHint, currentLang, t('pdp.galleryHint'))}
              </p>
            </div>

            <!-- RIGHT: Hairline Architectural Product Details (5 Cols) -->
            <div class="product-info-col w-full min-w-0 lg:col-span-5 flex flex-col divide-y divide-stone-200/75">
              <!-- Block A: Eyebrow, Title & Tagline -->
              <div class="pb-5 space-y-2.5">
                <div class="flex items-center gap-2.5 flex-wrap text-[10px] font-mono uppercase tracking-[0.12em] text-stone-500">
                  <span class="text-[#1c1917] font-semibold">SKU · {currentProduct.sku}</span>
                  <span class="text-stone-300">/</span>
                  <span>MOQ {resolvedMoq.formatted}</span>
                  <span class="text-stone-300">/</span>
                  <span class="inline-flex items-center gap-1.5 text-stone-700 normal-case tracking-normal font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>{getLocalizedValue(currentProduct.statusBadge, currentLang, t('pdp.statusBadge'))}</span>
                  </span>
                  {currentProduct.rating && (
                    <span class="px-2 py-0.5 rounded-full bg-[#f6f3ee] text-stone-700 border border-stone-200/70 normal-case tracking-normal">
                      {currentProduct.rating}
                    </span>
                  )}
                </div>
                <h1 class="text-2xl sm:text-3xl xl:text-[32px] font-semibold tracking-[-0.02em] text-[#1c1917] leading-[1.18]">
                  {currentProductTitle}
                </h1>
                <p class="text-xs sm:text-[13.5px] text-stone-600 font-normal leading-relaxed">
                  {currentProductTagline}
                </p>
              </div>

              <!-- Block B: Horizontal Tiered Wholesale Pricing Matrix -->
              <div class="py-5 space-y-2.5">
                <div class="flex items-center justify-between text-[10px] text-stone-400 font-mono uppercase tracking-[0.14em]">
                  <span>{t('pdp.wholesaleTiers')}</span>
                  <span>{t('pdp.unitPrice')}</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                  {currentProduct.pricingTiers.map((tier: any, tierIdx: number) => {
                    const isBestTier = tierIdx === currentProduct.pricingTiers.length - 1 && currentProduct.pricingTiers.length > 1;
                    return (
                      <div class={`p-3 rounded-xl border transition-colors flex flex-col justify-between gap-1.5 ${isBestTier ? 'bg-[#f6f3ee] border-stone-300/90' : 'bg-white/80 border-stone-200/70'}`}>
                        <span class="text-[11px] font-mono text-stone-500 block leading-tight">
                          {tier.range}{tier.unit && !tier.range.toLowerCase().includes(tier.unit.toLowerCase()) ? ` ${tier.unit}` : ''}
                        </span>
                        <div class="flex items-baseline gap-0.5 flex-wrap">
                          <span class="text-base sm:text-lg font-semibold font-mono tabular-nums text-[#1c1917]">
                            {tier.price}
                          </span>
                          {tier.unit && (
                            <span class="text-[11px] font-normal text-stone-400 font-mono">
                              /{unitPairLabel}
                            </span>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
                <p class="text-[10px] text-stone-400 font-mono pt-0.5">
                  {getLocalizedValue(currentProduct.priceNote, currentLang, t('pdp.priceNote'))}
                </p>
              </div>

              <!-- Block C: Loro Piana Double-Ring Circular Yarn Swatches -->
              <div class="py-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono text-stone-400 uppercase tracking-[0.14em] block">
                    {getLocalizedValue(currentProduct.paletteTitle, currentLang, t('pdp.paletteTitle'))}
                  </span>
                  <span id="selected-color-name" class="text-xs font-medium text-[#1c1917]">
                    {getLocalizedValue(currentProduct.colors[0]?.name, currentLang) || "Default"}
                  </span>
                </div>
                <div class="flex items-center gap-3 flex-wrap pt-0.5">
                  {currentProduct.colors.map((c: any, cIdx: number) => {
                    const colorName = getLocalizedValue(c.name, currentLang);
                    return (
                      <button
                        type="button"
                        title={colorName}
                        aria-label={colorName}
                        class={`color-variant-btn w-7 h-7 rounded-full transition-all cursor-pointer flex items-center justify-center ${
                          cIdx === 0
                            ? 'ring-1 ring-[#1c1917] ring-offset-2 ring-offset-[#fdfcfb] scale-105'
                            : 'opacity-80 hover:opacity-100 hover:scale-105'
                        }`}
                        data-color={colorName}
                        data-hex={c.hex}
                      >
                        <span
                          class="w-full h-full rounded-full border border-black/15 shadow-[inset_0_1px_2px_rgba(255,255,255,0.35),inset_0_-1px_2px_rgba(0,0,0,0.15)] block"
                          style={`background-color: ${c.hex}`}
                        ></span>
                      </button>
                    );
                  })}
                </div>
              </div>

              <!-- Block D: Dynamic 3-Column Architectural Quick Specs -->
              <div class="py-4">
                <div class="grid grid-cols-3 gap-3">
                  {quickSpecs.map((spec, sIdx) => (
                    <div class={`space-y-0.5 min-w-0 ${sIdx === 1 ? 'border-x border-stone-200/75 px-3' : sIdx === 2 ? 'pl-1' : ''}`}>
                      <span class="text-[10px] font-mono uppercase tracking-[0.12em] text-stone-400 block truncate">
                        {spec.label}
                      </span>
                      <span class="text-xs font-medium text-[#1c1917] truncate block mt-0.5" title={spec.value}>
                        {spec.value}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Block E: B2B Dual-Track RFQ Action Buttons & Guarantee Strip -->
              <div class="pt-5 space-y-3">
                {(showAddToQuoteButton || showBuySampleButton || showSpecSheetButton) && (
                <div class="space-y-2.5">
                  {(showAddToQuoteButton || showBuySampleButton) && (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <!-- Track 1: Multi-Item Quote Basket -->
                    {showAddToQuoteButton && (
                    <button
                      type="button"
                      id="btn-add-quote"
                      class="w-full py-3 rounded-full text-xs sm:text-sm font-medium tracking-wide bg-[#1c1917] hover:bg-black text-[#fdfcfb] group flex items-center justify-center gap-2 shadow-sm hover:shadow-md transition-all cursor-pointer"
                      data-id={currentProduct.slug}
                      data-title={currentProductShortTitle}
                      data-sku={currentProduct.sku || "SKU"}
                      data-image={SanityImageService.thumbnail(currentProduct.gallery[0]?.src || DEFAULT_FALLBACK_IMAGE, 200)}
                      data-moq={resolvedMoq.formatted}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                      </svg>
                      <span>{addToQuoteBtnText}</span>
                    </button>
                    )}

                    <!-- Track 2: Buy Sample Directly on Amazon (ASIN Link) -->
                    {showBuySampleButton && (
                    <a
                      href={amazonSampleUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      id="btn-amazon-sample"
                      class="w-full py-3 rounded-full text-xs sm:text-sm font-medium bg-[#f6f3ee] hover:bg-[#efeae1] text-[#1c1917] border border-stone-300/80 flex items-center justify-center gap-1.5 transition-all shadow-2xs group cursor-pointer"
                      title={sampleButtonText}
                    >
                      <svg class="w-4 h-4 text-[#232f3e] group-hover:text-[#ff9900] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.93 17.09c-2.83 2.08-6.94 3.19-10.51 3.19-4.99 0-9.48-1.92-12.87-5.13-.27-.25-.03-.6.29-.42 3.65 2.11 8.08 3.38 12.58 3.38 3.17 0 6.64-.72 9.81-2.22.48-.23.95.35.7.7v-.5zM16.8 15.65c-.36-.46-2.38-.22-3.3-.11-.28.03-.32-.2-.07-.37 1.63-1.14 4.3-.81 4.6.21.3 1.01-1.28 3.39-2.83 4.61-.24.19-.47.09-.36-.16.36-.8 1.48-3.09 1.96-4.18z"/>
                        <path d="M13.9 9.38c0 1.67-.32 2.97-.97 3.91-.65.94-1.57 1.41-2.76 1.41-1.07 0-1.92-.38-2.56-1.13-.64-.75-.96-1.83-.96-3.23 0-1.57.34-2.83 1.02-3.77.68-.94 1.63-1.41 2.84-1.41 1.05 0 1.88.38 2.5 1.13.44.53.73 1.34.87 2.42.04.22.06.44.06.67zm-2.07.12c0-.98-.14-1.74-.43-2.28-.29-.54-.73-.81-1.32-.81-.59 0-1.03.27-1.32.81-.29.54-.44 1.3-.44 2.28 0 .97.15 1.73.44 2.27.29.54.73.81 1.32.81.59 0 1.03.27 1.32.81 .29-.54.43-1.3.43-2.27z"/>
                      </svg>
                      <span>{sampleButtonText}</span>
                      <svg class="w-3.5 h-3.5 text-stone-500 group-hover:text-[#1c1917] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                    )}
                  </div>
                  )}

                  <!-- Tech Pack / Spec Sheet Link -->
                  {showSpecSheetButton && (
                  <div class="flex items-center justify-between text-xs pt-0.5 px-0.5 text-stone-500">
                    <button
                      type="button"
                      id="btn-download-spec"
                      class="hover:text-[#1c1917] flex items-center gap-1.5 underline underline-offset-4 decoration-stone-300 hover:decoration-[#1c1917] transition-colors cursor-pointer text-[11px]"
                      data-sku={currentProduct.sku}
                      data-title={currentProductTitle}
                      data-spec-title={`${t('pdp.specTitlePrefix')} ${currentProductTitle}`}
                      data-variant={t('pdp.specVariant')}
                      data-moq={t('pdp.specMoq')}
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span>{getLocalizedValue(currentProduct.secondaryButtonText, currentLang, t('pdp.downloadSpecSheet'))}</span>
                    </button>
                  </div>
                  )}
                </div>
                )}

                <!-- Lead Time & Guarantee Badges -->
                <div class="grid grid-cols-2 gap-3 pt-2 text-[11px] text-stone-600">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <svg class="w-3.5 h-3.5 text-[#1c1917] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="truncate">{getLocalizedValue(currentProduct.leadTime, currentLang)}</span>
                  </div>
                  <div class="flex items-center gap-1.5 min-w-0">
                    <svg class="w-3.5 h-3.5 text-[#1c1917] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span class="truncate">{getLocalizedValue(currentProduct.supportBadge, currentLang, t('pdp.supportBadge'))}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 1.5: Editorial Craftsmanship & Product Story (Responsive Editorial Dual-Column Architecture) -->
      {storyMarkdown && (
      <section id="product-story" class="w-full py-10 sm:py-12 lg:py-16 bg-white border-t border-black/5 scroll-mt-[var(--apple-header-offset)]">
        <div id="specs" class="relative -top-[var(--apple-header-offset)] invisible" aria-hidden="true"></div>
        <div class="apple-rail-bento">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-start">
            
            <!-- LEFT COLUMN: Sticky Brand Editorial Anchor & Artisan Verification Cards (Mathematically aligned to dynamic header stack) -->
            <div class="lg:col-span-4 lg:sticky lg:top-[calc(var(--apple-header-offset)+1.5rem)] text-left space-y-5 lg:pr-2">
              <div class="space-y-2.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider bg-zinc-100 text-zinc-800 font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                  <span>{currentProductStoryBadge}</span>
                </span>
                <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#1d1d1f] leading-snug">
                  {currentProductStoryHeading}
                </h2>
                <p class="text-xs text-zinc-500 font-mono tracking-wide leading-relaxed">
                  {getLocalizedValue(currentProduct.title, currentLang, 'GwenVenni Bespoke Line')}
                </p>
              </div>

              <!-- Artisan Credential Indicators (Desktop High-Value Anchor) -->
              <div class="hidden lg:flex flex-col gap-2.5 pt-4 border-t border-black/5">
                {resolvedCredentials.map((card: any) => (
                  <div class="p-3 rounded-xl bg-[#fafafc] border border-black/5 text-[11px] text-zinc-700 flex items-start gap-2.5 hover:border-black/10 transition-colors">
                    <div class={`w-5 h-5 rounded-md bg-white border border-black/10 flex items-center justify-center shrink-0 ${card.accentColor} mt-0.5 shadow-2xs`}>
                      {card.customSvg ? (
                        <Fragment set:html={SecurityService.sanitizeSvg(card.customSvg)} />
                      ) : (
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={card.strokeWidth} d={card.iconPath} />
                        </svg>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-zinc-900 block font-mono text-[11px] leading-tight truncate">{card.title}</span>
                        {card.tag && (
                          <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-medium bg-zinc-200/70 text-zinc-700 shrink-0">{card.tag}</span>
                        )}
                      </div>
                      {card.description && (
                        <span class="text-zinc-500 text-[10px] leading-tight block mt-0.5">{card.description}</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- RIGHT COLUMN: Swiss/Loro Piana Technical Specification Ledger & Editorial Narrative (8 cols) -->
            <div class="lg:col-span-8 w-full min-w-0 text-left space-y-10">
              {localizedSpecs.length > 0 && (
              <div class="space-y-4">
                <div class="space-y-1">
                  <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-stone-400 block">
                    {t('pdp.specsBadge')}
                  </span>
                  <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-[#1c1917]">
                    {t('pdp.specs')}
                  </h3>
                </div>
                <div class="divide-y divide-stone-200/80 border-y border-stone-200/90">
                  {localizedSpecs.map((spec: { label: string; value: string }) => (
                    <div class="flex items-baseline gap-4 py-3">
                      <span class="w-2/5 sm:w-1/3 shrink-0 text-[11px] font-mono uppercase tracking-[0.1em] text-stone-500">
                        {spec.label}
                      </span>
                      <span class="flex-1 text-xs sm:text-sm font-medium text-[#1c1917]">
                        {spec.value}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
              )}

              <SectionBoundary sectionName="productStory">
                <MarkdownRenderer content={storyMarkdown} />
              </SectionBoundary>
            </div>

          </div>
        </div>
      </section>
      )}

      <!-- Bottom Style Navigation Cards (Previous / Next Silhouette) -->
      {allProducts.length > 1 && (
      <section class="w-full py-8 sm:py-10 bg-[#fbf9f5]/50 border-t border-black/5">
        <div class="apple-rail-bento">
          <div class="grid grid-cols-2 gap-2.5 sm:gap-4 items-stretch">
            <!-- Previous Product Card -->
            <a
              href={getLocalizedPath(`/products/${prevProduct.slug}`, currentLang)}
              data-pdp-nav-link
              class="group p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-[#f5f5f7] hover:bg-stone-100 border border-black/5 hover:border-black/15 transition-all flex items-center justify-between gap-2 sm:gap-3 text-left shadow-2xs hover:shadow-xs min-w-0"
            >
              <div class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1">
                <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white border border-black/10 flex items-center justify-center shrink-0 text-zinc-700 group-hover:text-black group-hover:-translate-x-0.5 transition-transform shadow-2xs">
                  <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block truncate">
                    <span class="sm:hidden">{t('pdp.prev')}</span>
                    <span class="hidden sm:inline">{t('pdp.prevSilhouette')}</span>
                  </span>
                  <span class="text-xs sm:text-sm font-semibold text-zinc-900 truncate block group-hover:underline">
                    {prevProductTitle}
                  </span>
                </div>
              </div>
            </a>

            <!-- Next Product Card -->
            <a
              href={getLocalizedPath(`/products/${nextProduct.slug}`, currentLang)}
              data-pdp-nav-link
              class="group p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-[#f5f5f7] hover:bg-stone-100 border border-black/5 hover:border-black/15 transition-all flex items-center justify-between gap-2 sm:gap-3 text-right shadow-2xs hover:shadow-xs min-w-0"
            >
              <div class="min-w-0 flex-1">
                <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block truncate">
                  <span class="sm:hidden">{t('pdp.next')}</span>
                  <span class="hidden sm:inline">{t('pdp.nextSilhouette')}</span>
                </span>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 truncate block group-hover:underline">
                  {nextProductTitle}
                </span>
              </div>
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white border border-black/10 flex items-center justify-center shrink-0 text-zinc-700 group-hover:text-black group-hover:translate-x-0.5 transition-transform shadow-2xs">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          </div>
        </div>
      </section>
      )}
  </div>

  <script>
      import { useIntersectionShimmer } from '@utils/useIntersectionShimmer';

      const galleryShimmer = useIntersectionShimmer('.product-gallery-col .apple-skeleton-surface', {
        rootMargin: '160px 160px',
      });

      // Mark already-cached gallery images as loaded to stop progressive Apple shimmer
      const syncCompletedGalleryImages = () => {
        document.querySelectorAll('.pdp-gallery-img').forEach((img) => {
          const htmlImg = img as HTMLImageElement;
          if (htmlImg.complete && htmlImg.parentElement) {
            htmlImg.parentElement.classList.add('apple-img-loaded');
            htmlImg.parentElement.classList.remove('is-shimmer-active');
            galleryShimmer.unobserve(htmlImg.parentElement);
          }
        });
      };
      syncCompletedGalleryImages();
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(syncCompletedGalleryImages, { timeout: 500 });
      } else {
        setTimeout(syncCompletedGalleryImages, 120);
      }

      // Instant Apple Product Detail Skeleton reveal when switching between Prev/Next silhouettes
      const pdpSkeleton = document.getElementById('pdp-transition-skeleton');
      const pdpLiveContent = document.getElementById('pdp-live-content');
      document.querySelectorAll('[data-pdp-nav-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const mouseEvent = e as MouseEvent;
          if (mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.altKey) return;
          if (pdpSkeleton && pdpLiveContent) {
            pdpLiveContent.classList.add('hidden');
            pdpSkeleton.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
          }
        });
      });

      let currentSlide = 0;
      const track = document.getElementById('carousel-track');
      const slides = document.querySelectorAll('.carousel-slide');
      const thumbs = document.querySelectorAll('.carousel-thumb');
      const dots = document.querySelectorAll('.carousel-dot');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      const counterCurr = document.getElementById('carousel-counter-curr');
      let scrollTimer;

      function updateUI(index) {
        currentSlide = index;

        thumbs.forEach((thumb, i) => {
          if (i === currentSlide) {
            thumb.classList.add('border-stone-900', 'opacity-100', 'shadow-xs');
            thumb.classList.remove('border-transparent', 'opacity-55');
            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
          } else {
            thumb.classList.remove('border-stone-900', 'opacity-100', 'shadow-xs');
            thumb.classList.add('border-transparent', 'opacity-55');
          }
        });

        dots.forEach((dot, i) => {
          if (i === currentSlide) {
            dot.classList.add('bg-white', 'w-3');
            dot.classList.remove('bg-white/50', 'w-1.5');
          } else {
            dot.classList.remove('bg-white', 'w-3');
            dot.classList.add('bg-white/50', 'w-1.5');
          }
        });

        if (counterCurr) {
          counterCurr.textContent = String(currentSlide + 1);
        }
      }

      function scrollToSlide(index) {
        if (!track || !slides.length) return;
        currentSlide = (index + slides.length) % slides.length;
        const target = slides[currentSlide];
        if (target) {
          track.scrollTo({
            left: target.offsetLeft,
            behavior: 'smooth'
          });
        }
        updateUI(currentSlide);
      }

      // 手势滑动监听（触屏左右滑动、触摸惯性滚动与缩略图/点阵实时同步）
      if (track) {
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => {
            const scrollLeft = track.scrollLeft;
            const slideWidth = track.clientWidth || 1;
            const newIndex = Math.round(scrollLeft / slideWidth);
            if (newIndex >= 0 && newIndex < slides.length && newIndex !== currentSlide) {
              updateUI(newIndex);
            }
          }, 50);
        }, { passive: true });
      }

      if (prevBtn) prevBtn.addEventListener('click', () => scrollToSlide(currentSlide - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => scrollToSlide(currentSlide + 1));

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const idx = Number(thumb.getAttribute('data-thumb-index'));
          if (!isNaN(idx)) scrollToSlide(idx);
        });
      });

      // B2B Dual-Track RFQ Handlers
      import { addToQuote } from '../../stores/quoteCart';

      const firstColorBtn = document.querySelector('.color-variant-btn');
      let selectedVariant = firstColorBtn?.dataset.color || 'Standard';
      const colorBtns = document.querySelectorAll('.color-variant-btn');
      const selectedColorLabel = document.getElementById('selected-color-name');

      colorBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const col = btn.getAttribute('data-color') || '';
          selectedVariant = col;
          if (selectedColorLabel) selectedColorLabel.textContent = col;
          colorBtns.forEach((b) => {
            b.classList.remove('ring-1', 'ring-[#1c1917]', 'ring-offset-2', 'ring-offset-[#fdfcfb]', 'scale-105');
            b.classList.add('opacity-80');
          });
          btn.classList.add('ring-1', 'ring-[#1c1917]', 'ring-offset-2', 'ring-offset-[#fdfcfb]', 'scale-105');
          btn.classList.remove('opacity-80');
        });
      });

      // Track 1: Add to Multi-Item Quote Basket
      const addQuoteBtn = document.getElementById('btn-add-quote');
      if (addQuoteBtn) {
        addQuoteBtn.addEventListener('click', () => {
          const id = addQuoteBtn.dataset.id || 'product';
          const title = addQuoteBtn.dataset.title || 'Product';
          const sku = addQuoteBtn.dataset.sku || 'SKU';
          const imageUrl = addQuoteBtn.dataset.image || '/images/hero-light.webp';
          const rawMoq = addQuoteBtn.dataset.moq || '200 Pairs';
          const moqNum = parseInt(rawMoq.replace(/\D/g, ''), 10) || 200;

          addToQuote({
            id,
            title,
            sku,
            imageUrl,
            variant: selectedVariant,
            quantity: moqNum,
            moq: rawMoq,
          });
          if (typeof window !== 'undefined' && window.openQuoteDrawer) {
            window.openQuoteDrawer();
          }
        });
      }

      // Download Spec Sheet (PDF): Adds dossier to quote cart
      const specBtn = document.getElementById('btn-download-spec');
      if (specBtn) {
        specBtn.addEventListener('click', () => {
          const sku = specBtn.dataset.sku || 'SPEC';
          const title = specBtn.dataset.title || 'Product';
          const specTitle = specBtn.dataset.specTitle || `Tech Pack & Spec Sheet (PDF): ${title}`;
          const variant = specBtn.dataset.variant || 'Official Engineering PDF Dossier';
          const moq = specBtn.dataset.moq || 'Direct Dispatch';
          addToQuote({
            id: `spec-${sku.toLowerCase()}`,
            title: specTitle,
            sku: sku,
            imageUrl: '/images/spec-light.webp',
            variant: variant,
            quantity: 1,
            moq: moq,
          });
          if (typeof window !== 'undefined' && window.openQuoteDrawer) {
            window.openQuoteDrawer();
          }
        });
      }
    </script>

