{
  "name": "gwenvenni-web",
  "version": "0.0.1",
  "scripts": {
    "dev": "node ./astro-cli.mjs dev --host 0.0.0.0 --port 3000",
    "start": "node ./astro-cli.mjs dev --host 0.0.0.0 --port 3000",
    "build": "node ./astro-cli.mjs build && node scripts/ensure-asset-aliases.cjs",
    "check": "npx tsx scripts/check-preflight.ts",
    "check:full": "npx tsx scripts/check-preflight.ts --full",
    "check:cf": "npx tsc --noEmit",
    "preview": "node ./astro-cli.mjs preview --host 0.0.0.0 --port 3000",
    "preview:cf": "wrangler dev",
    "deploy": "node ./astro-cli.mjs build && node scripts/ensure-asset-aliases.cjs && wrangler deploy",
    "build:studio": "cd studio && npm run build",
    "deploy:studio": "cd studio && npm run build && npx wrangler deploy --config wrangler.jsonc",
    "astro": "node ./astro-cli.mjs",
    "create-project": "node ./sanity-export/create-project.js",
    "import": "node ./sanity-export/import.js",
    "export": "node ./sanity-export/export.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@nanostores/persistent": "^1.3.5",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.9.0",
    "@sanity/validation": "^6.20.0",
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^7.3.8",
    "astro-icon": "^1.1.0",
    "astro-seo": "^1.2.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.2.0",
    "marked": "^15.0.4",
    "nanostores": "^1.5.5",
    "tailwindcss": "^4.0.9",
    "ua-parser-js": "^2.0.10",
    "wrangler": "^4.151.3"
  },
  "devDependencies": {
    "@sanity/export": "^3.38.1",
    "@sanity/import": "^3.37.4",
    "@types/node": "^22.0.0",
    "configstore": "7.0.0",
    "daisyui": "^5.0.0",
    "typescript": "5.8.2",
    "vite": "^8.3.4"
  }
}
