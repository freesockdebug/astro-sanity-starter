---
// src/pages/account.astro
import Layout from '@layouts/Layout.astro';
import { getSessionFromRequest, getRuntimeEnv } from '@utils/auth';
import { getUserByIdOrEmail, getUserLoginHistory } from '@utils/db';
import { getLangFromUrl, getLocalizedPath } from '@i18n';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, max-age=0, must-revalidate');

const currentLang = getLangFromUrl(Astro.url);
const sessionUser = await getSessionFromRequest(Astro, cfEnv);

if (!sessionUser) {
  return Astro.redirect(`/api/auth/login?returnUrl=/account`);
}

const dbUser = await getUserByIdOrEmail(sessionUser.id, sessionUser.email);
const loginHistory = await getUserLoginHistory(sessionUser.id, 20);

const logtoEndpoint = getRuntimeEnv('LOGTO_ENDPOINT', cfEnv);
const pageTitle = 'Account & Security Settings | GwenVenni Atelier';
const pageDesc = 'Manage your B2B atelier profile, authentication credentials, and inspect security login sessions.';
---

<Layout title={pageTitle} description={pageDesc}>
  <main class="min-h-screen bg-[#f5f5f7] pt-24 pb-20 text-[#1d1d1f]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">

      <!-- Breadcrumb & Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-black/5 gap-4">
        <div>
          <nav class="flex items-center gap-2 text-xs text-[#86868b] mb-1">
            <a href={getLocalizedPath('/', currentLang)} class="hover:text-black transition-colors">Home</a>
            <span>/</span>
            <span class="text-[#1d1d1f] font-medium">Account & Security</span>
          </nav>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
            Client Profile & Security
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/orders"
            class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-black/10 hover:border-black/30 text-[#1d1d1f] transition-all shadow-2xs inline-flex items-center gap-1.5"
          >
            <span>📦 Order Center</span>
          </a>
          {sessionUser.isAdmin && (
            <a
              href="/admin/users"
              class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs"
            >
              Admin Workspace
            </a>
          )}
          <a
            href="/api/auth/logout"
            class="px-3.5 py-1.5 rounded-full text-xs font-medium text-[#86868b] hover:text-black hover:bg-black/5 transition-all"
          >
            Sign Out
          </a>
        </div>
      </div>

      <!-- Identity Summary Badge -->
      <div class="bg-white rounded-2xl border border-black/5 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center font-bold text-sm uppercase shrink-0">
            {(dbUser?.name || sessionUser.name || sessionUser.email)[0]}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-semibold text-sm text-[#1d1d1f]">{dbUser?.name || sessionUser.name || 'B2B Client'}</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 text-amber-900 border border-amber-200">
                {dbUser?.tier || 'STANDARD'} TIER
              </span>
            </div>
            <span class="text-xs text-[#86868b] font-mono block mt-0.5">{sessionUser.email}</span>
          </div>
        </div>

        <div class="text-left sm:text-right text-[11px] text-[#86868b]">
          <span>Member ID: <strong class="font-mono text-[#1d1d1f]">{sessionUser.id.slice(0, 16)}...</strong></span>
          <span class="block">Identity Protected by <strong class="text-[#1d1d1f]">Logto OIDC Cloud</strong></span>
        </div>
      </div>

      <!-- Section 1: Profile Maintenance -->
      <div class="bg-white rounded-2xl border border-black/5 p-6 shadow-2xs space-y-4">
        <div>
          <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">B2B Client Information</h2>
          <p class="text-[11px] text-[#86868b] mt-0.5">
            Keep your couture house, delivery destination, and contact details up to date for faster quote verification.
          </p>
        </div>

        <form id="profile-form" class="space-y-4 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="profile-name" class="block font-semibold mb-1 text-[11px] text-[#52525b]">Contact Name</label>
              <input
                type="text"
                id="profile-name"
                name="name"
                value={dbUser?.name || sessionUser.name || ''}
                placeholder="e.g. Eleanor Vance"
                class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
              />
            </div>

            <div>
              <label for="profile-email" class="block font-semibold mb-1 text-[11px] text-[#52525b]">Work Email (Read-only)</label>
              <input
                type="email"
                id="profile-email"
                value={sessionUser.email}
                disabled
                class="w-full px-3.5 py-2 rounded-xl bg-black/5 border border-black/10 text-[#86868b] font-mono cursor-not-allowed"
              />
            </div>

            <div>
              <label for="profile-company" class="block font-semibold mb-1 text-[11px] text-[#52525b]">Company / Atelier Name</label>
              <input
                type="text"
                id="profile-company"
                name="company"
                value={dbUser?.company || ''}
                placeholder="e.g. Maison de Haute Couture Paris"
                class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
              />
            </div>

            <div>
              <label for="profile-country" class="block font-semibold mb-1 text-[11px] text-[#52525b]">Destination Country / Region</label>
              <input
                type="text"
                id="profile-country"
                name="country"
                value={dbUser?.country || ''}
                placeholder="e.g. France, Germany, United States"
                class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="profile-phone" class="block font-semibold mb-1 text-[11px] text-[#52525b]">Phone / WhatsApp (For Expedited Delivery Updates)</label>
              <input
                type="text"
                id="profile-phone"
                name="phone"
                value={dbUser?.phone || ''}
                placeholder="e.g. +33 6 12 34 56 78"
                class="w-full px-3.5 py-2 rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black transition-all"
              />
            </div>
          </div>

          <div id="profile-feedback" class="hidden p-3 rounded-xl text-xs font-medium"></div>

          <div class="flex items-center justify-end pt-2">
            <button
              type="submit"
              id="save-profile-btn"
              class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs active:scale-95 cursor-pointer"
            >
              Save Profile Changes
            </button>
          </div>
        </form>
      </div>

      <!-- Section 2: Security & Password Management -->
      <div class="bg-white rounded-2xl border border-black/5 p-6 shadow-2xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">Password & Security Credentials</h2>
            <p class="text-[11px] text-[#86868b] mt-0.5">
              Your authentication credentials are encrypted and governed by Logto OpenID Connect protocols.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Logto Cloud Active
          </span>
        </div>

        <div class="p-4 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="font-semibold text-xs text-[#1d1d1f] block">Account Password</span>
            <p class="text-[11px] text-[#86868b] max-w-lg leading-relaxed">
              Update your account credentials securely. Your new password will be synced with Logto Identity Cloud immediately.
            </p>
          </div>

          <button
            type="button"
            id="btn-open-password-modal"
            class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs text-center shrink-0 inline-flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>Change Password</span>
          </button>
        </div>
      </div>

      <!-- Section 3: Login History & Security Audit -->
      <div class="bg-white rounded-2xl border border-black/5 p-6 shadow-2xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-sm font-semibold tracking-tight text-[#1d1d1f]">Login Activity & Security Sessions</h2>
            <p class="text-[11px] text-[#86868b] mt-0.5">
              Review recent sign-ins to ensure your atelier account has not been accessed without authorization.
            </p>
          </div>
          <span class="text-[11px] text-[#86868b] font-mono">Retention: 90 Days</span>
        </div>

        {loginHistory.length === 0 ? (
          <div class="p-6 rounded-xl bg-[#f5f5f7] text-center text-xs text-[#86868b]">
            No historical login sessions recorded yet. New sessions will appear here automatically.
          </div>
        ) : (
          <div class="overflow-x-auto rounded-xl border border-black/5">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#f5f5f7] text-[#86868b] font-medium border-b border-black/5">
                <tr>
                  <th class="py-2.5 px-3.5">Sign-in Date & Time</th>
                  <th class="py-2.5 px-3.5">IP Address</th>
                  <th class="py-2.5 px-3.5">Location</th>
                  <th class="py-2.5 px-3.5">Device & Browser</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-black/5 bg-white">
                {loginHistory.map((item, idx) => {
                  const isLatest = idx === 0;
                  const dateStr = item.created_at || '';
                  const locationStr = [item.city, item.country].filter(Boolean).join(', ') || 'Global';
                  
                  // Clean simplified device summary
                  let deviceSummary = 'Desktop Web';
                  if (/mobile|iphone|android/i.test(item.user_agent)) deviceSummary = 'Mobile Device';
                  else if (/macintosh|mac os/i.test(item.user_agent)) deviceSummary = 'macOS Browser';
                  else if (/windows/i.test(item.user_agent)) deviceSummary = 'Windows PC';

                  return (
                    <tr class="hover:bg-[#fbfbfd] transition-colors">
                      <td class="py-3 px-3.5 font-mono text-[11px]">
                        <span class="text-[#1d1d1f] font-semibold">{dateStr}</span>
                        {isLatest && (
                          <span class="ml-1.5 px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800">
                            Current
                          </span>
                        )}
                      </td>
                      <td class="py-3 px-3.5 font-mono text-[#52525b] text-[11px]">
                        {item.ip || '—'}
                      </td>
                      <td class="py-3 px-3.5 text-[#52525b]">
                        {locationStr}
                      </td>
                      <td class="py-3 px-3.5 text-[#86868b] text-[11px] max-w-[200px] truncate" title={item.user_agent}>
                        {deviceSummary}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

        <div class="p-3 rounded-xl bg-[#f5f5f7] text-[11px] text-[#86868b] flex items-start gap-2">
          <svg class="w-4 h-4 shrink-0 text-[#86868b] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>
            Notice any unfamiliar IP or location? We recommend immediately changing your password in Logto to revoke all external active sessions.
          </span>
        </div>
      </div>

    </div>
  </main>

  <!-- Change Password Modal Dialog (修改密码弹窗) -->
  <div
    id="password-modal"
    class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div
      id="password-modal-card"
      class="bg-white rounded-2xl border border-black/10 shadow-2xl max-w-md w-full p-6 space-y-5 transform scale-95 transition-transform duration-200"
    >
      <div class="flex items-center justify-between border-b border-black/5 pb-3">
        <div>
          <h3 id="modal-title" class="text-sm font-semibold text-[#1d1d1f]">Update Account Password</h3>
          <p class="text-[11px] text-[#86868b] mt-0.5">Set a new password for <span class="font-mono text-[#1d1d1f]">{user.email}</span></p>
        </div>
        <button
          type="button"
          id="btn-close-password-modal"
          class="text-[#86868b] hover:text-[#1d1d1f] p-1.5 rounded-lg hover:bg-[#f5f5f7] transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-change-password" class="space-y-4">
        <div id="password-alert" class="hidden p-3 rounded-xl text-xs leading-relaxed"></div>

        <div class="space-y-1.5">
          <label for="input-new-password" class="block text-[11px] font-semibold text-[#1d1d1f] uppercase tracking-wider">
            New Password <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <input
              type="password"
              id="input-new-password"
              name="password"
              required
              minlength="8"
              placeholder="At least 8 characters"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-black/15 bg-white text-[#1d1d1f] focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-10"
            />
            <button
              type="button"
              class="btn-toggle-pwd absolute right-2.5 top-1/2 -translate-y-1/2 text-[#86868b] hover:text-[#1d1d1f] p-1 cursor-pointer"
              data-target="input-new-password"
              title="Toggle visibility"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
          <span class="text-[10px] text-[#86868b] block">Must be at least 8 characters long</span>
        </div>

        <div class="space-y-1.5">
          <label for="input-confirm-password" class="block text-[11px] font-semibold text-[#1d1d1f] uppercase tracking-wider">
            Confirm New Password <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <input
              type="password"
              id="input-confirm-password"
              name="confirmPassword"
              required
              minlength="8"
              placeholder="Re-enter your new password"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-black/15 bg-white text-[#1d1d1f] focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-10"
            />
            <button
              type="button"
              class="btn-toggle-pwd absolute right-2.5 top-1/2 -translate-y-1/2 text-[#86868b] hover:text-[#1d1d1f] p-1 cursor-pointer"
              data-target="input-confirm-password"
              title="Toggle visibility"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-black/5">
          <button
            type="button"
            id="btn-cancel-password"
            class="px-4 py-2 rounded-xl text-xs font-medium text-[#86868b] hover:text-[#1d1d1f] hover:bg-[#f5f5f7] transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="btn-submit-password"
            class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
          >
            <span id="btn-submit-password-text">Save New Password</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Profile update handling
  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;
  const feedbackEl = document.getElementById('profile-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!saveBtn) return;

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      company: formData.get('company'),
      country: formData.get('country'),
      phone: formData.get('phone'),
    };

    try {
      const res = await fetch('/api/user/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (res.ok) {
        if (feedbackEl) {
          feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          feedbackEl.textContent = '✓ Profile details updated successfully.';
        }
        setTimeout(() => {
          if (feedbackEl) feedbackEl.className = 'hidden';
        }, 3000);
      } else {
        if (feedbackEl) {
          feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
          feedbackEl.textContent = data.error || 'Failed to update profile';
        }
      }
    } catch (err: any) {
      if (feedbackEl) {
        feedbackEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
        feedbackEl.textContent = err.message || 'Network error';
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Profile Changes';
    }
  });

  // Password change modal handling
  const modal = document.getElementById('password-modal');
  const modalCard = document.getElementById('password-modal-card');
  const btnOpenModal = document.getElementById('btn-open-password-modal');
  const btnCloseModal = document.getElementById('btn-close-password-modal');
  const btnCancelModal = document.getElementById('btn-cancel-password');
  const formPassword = document.getElementById('form-change-password') as HTMLFormElement | null;
  const alertEl = document.getElementById('password-alert');
  const submitBtn = document.getElementById('btn-submit-password') as HTMLButtonElement | null;
  const submitBtnText = document.getElementById('btn-submit-password-text');

  function openPasswordModal() {
    if (!modal || !modalCard) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalCard.classList.remove('scale-95');
    modalCard.classList.add('scale-100');
    if (alertEl) alertEl.className = 'hidden';
    const firstInput = document.getElementById('input-new-password') as HTMLInputElement | null;
    firstInput?.focus();
  }

  function closePasswordModal() {
    if (!modal || !modalCard) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalCard.classList.remove('scale-100');
    modalCard.classList.add('scale-95');
    formPassword?.reset();
    if (alertEl) alertEl.className = 'hidden';
  }

  btnOpenModal?.addEventListener('click', openPasswordModal);
  btnCloseModal?.addEventListener('click', closePasswordModal);
  btnCancelModal?.addEventListener('click', closePasswordModal);

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePasswordModal();
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      closePasswordModal();
    }
  });

  // Toggle password visibility buttons
  document.querySelectorAll('.btn-toggle-pwd').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  });

  // Password submission handler
  formPassword?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitBtnText || !alertEl) return;

    const inputPwd = (document.getElementById('input-new-password') as HTMLInputElement)?.value || '';
    const inputConfirm = (document.getElementById('input-confirm-password') as HTMLInputElement)?.value || '';

    if (inputPwd.length < 8) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = 'Password must be at least 8 characters long.';
      return;
    }

    if (inputPwd !== inputConfirm) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = 'Passwords do not match. Please verify and re-type.';
      return;
    }

    submitBtn.disabled = true;
    submitBtnText.textContent = 'Updating...';

    try {
      const res = await fetch('/api/user/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: inputPwd, confirmPassword: inputConfirm }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        alertEl.textContent = '✓ ' + (data.message || 'Password updated successfully!');
        setTimeout(() => {
          closePasswordModal();
        }, 1500);
      } else {
        alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
        alertEl.textContent = data.error || 'Failed to update password.';
      }
    } catch (err: any) {
      alertEl.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = err.message || 'Network communication error.';
    } finally {
      submitBtn.disabled = false;
      submitBtnText.textContent = 'Save New Password';
    }
  });
</script>

