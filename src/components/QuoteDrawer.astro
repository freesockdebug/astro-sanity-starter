---
// src/components/QuoteDrawer.astro
import { fetchRfqSettings } from '@data/rfqSettings';
import { DEFAULT_RFQ } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue } from '@i18n';
import { SecurityService } from '@utils/security';

interface Props {
  settings?: any;
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { settings } = Astro.props;
const rfqSettings = settings ?? (await fetchRfqSettings());

const drawerTitle = getLocalizedValue(rfqSettings?.drawerTitle, currentLang, t('rfq.drawerTitle'));
const drawerSubtitle = getLocalizedValue(rfqSettings?.drawerSubtitle, currentLang, t('rfq.drawerSubtitle'));
const drawerStatus = getLocalizedValue(rfqSettings?.drawerStatus, currentLang, t('rfq.statusText'));
const drawerEmptyTitle = getLocalizedValue(rfqSettings?.drawerEmptyTitle, currentLang, t('rfq.emptyTitle'));
const drawerEmptyDesc = getLocalizedValue(rfqSettings?.drawerEmptyDesc, currentLang, t('rfq.emptyMessage'));
const submitButtonText = getLocalizedValue(rfqSettings?.drawerSubmitButtonText, currentLang, t('rfq.submitQuote'));
const successFeedbackMessage = getLocalizedValue(rfqSettings?.drawerSuccessMessage, currentLang, t('rfq.successMessage'));
const swatchKitSku = rfqSettings?.swatchKitSku || DEFAULT_RFQ.swatchKitSku;
const swatchKitTitle = getLocalizedValue(rfqSettings?.swatchKitTitle, currentLang, t('rfq.swatchKitTitle'));
const swatchKitDesc = getLocalizedValue(rfqSettings?.swatchKitDesc, currentLang, t('rfq.swatchKitSubtitle'));
const swatchKitImageUrl = rfqSettings?.swatchKitImage?.asset?.url || rfqSettings?.swatchKitImageUrl || DEFAULT_RFQ.swatchKitImageUrl;
const swatchKitMoq = rfqSettings?.swatchKitMoq || DEFAULT_RFQ.swatchKitMoq;

const isProdHostname = Astro.url.hostname.endsWith('gwenvenni.com');
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  (isProdHostname ? '0x4AAAAAAFXbqPn5Jkh6bMhV' : '1x00000000000000000000AA');

const reqCountryCode = SecurityService.resolveCountry(Astro.request);
let visitorCountry = '';
if (reqCountryCode) {
  try {
    visitorCountry = new Intl.DisplayNames([currentLang, 'en'], { type: 'region' }).of(reqCountryCode) || reqCountryCode;
  } catch {
    visitorCountry = reqCountryCode;
  }
}
---



<div
  id="quote-drawer-root"
  class="drawer drawer-end z-50"
  data-swatch-sku={swatchKitSku}
  data-swatch-title={swatchKitTitle}
  data-swatch-desc={swatchKitDesc}
  data-swatch-image={swatchKitImageUrl}
  data-swatch-moq={swatchKitMoq}
  data-remove-text={t('rfq.remove')}
  data-confirm-clear={t('rfq.confirmClear')}
  data-submitting-text={t('rfq.submitting')}
  data-security-error={t('rfq.securityCheckError')}
  data-network-error={t('rfq.networkError')}
  data-empty-error={t('rfq.emptyMessage')}
  data-visitor-country={visitorCountry}
>
  <input id="quote-drawer-toggle" type="checkbox" class="drawer-toggle" aria-label={drawerTitle} />
  
  <div class="drawer-side">
    <!-- Click backdrop to close -->
    <label for="quote-drawer-toggle" aria-label="close sidebar" class="drawer-overlay bg-black/40 backdrop-blur-xs"></label>
    
    <div class="bg-white text-[#1d1d1f] min-h-full w-full max-w-md sm:max-w-lg p-5 sm:p-6 pb-[max(1.25rem,env(safe-area-inset-bottom))] flex flex-col justify-between shadow-2xl overflow-y-auto">
      
      <!-- Top Section: Header & Items List -->
      <div class="space-y-4">
        <!-- Drawer Header -->
        <div class="flex items-center justify-between pb-3.5 border-b border-black/10">
          <div class="flex items-center gap-2">
            <h3 class="text-base sm:text-lg font-semibold tracking-tight text-[#1d1d1f]">
              {drawerTitle}
            </h3>
            <span id="quote-badge-count" class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#1d1d1f] text-white">
              0
            </span>
          </div>
          
          <div class="flex items-center gap-3">
            <button
              id="btn-clear-cart"
              type="button"
              class="text-xs text-[#86868b] hover:text-rose-600 transition-colors hidden cursor-pointer"
            >
              {t('rfq.clearAll')}
            </button>
            <label
              for="quote-drawer-toggle"
              class="w-7 h-7 rounded-full bg-[#f5f5f7] hover:bg-black/10 flex items-center justify-center text-[#1d1d1f] cursor-pointer transition-colors"
              aria-label="Close quote drawer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </label>
          </div>
        </div>

        <!-- Items Container -->
        <div id="quote-items-container" class="space-y-3 max-h-[36vh] overflow-y-auto pr-1">
          <!-- Dynamically populated from quoteCart nanostore -->
        </div>

        <!-- Empty Basket Placeholder -->
        <div id="quote-empty-state" class="py-10 text-center space-y-2">
          <div class="w-12 h-12 mx-auto rounded-2xl bg-[#f5f5f7] flex items-center justify-center text-[#86868b]">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-[#1d1d1f]">{drawerEmptyTitle}</p>
          <p class="text-xs text-[#86868b] max-w-xs mx-auto leading-relaxed">
            {drawerEmptyDesc}
          </p>
        </div>
      </div>

      <!-- Bottom Section: Buyer Info Form -->
      <div id="quote-form-section" class="border-t border-black/10 pt-4 mt-4 space-y-3">
        <div class="flex items-center justify-between text-xs text-[#52525b]">
          <span>{drawerSubtitle}</span>
          <span class="text-emerald-700 font-medium">{drawerStatus}</span>
        </div>
        <div id="quote-user-auth-status" class="hidden text-[11px] text-emerald-700 font-medium bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200"></div>

        <form id="rfq-form" class="space-y-2.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input
              type="text"
              name="company"
              required
              aria-label={t('rfq.companyPlaceholder')}
              placeholder={t('rfq.companyPlaceholder')}
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b]"
            />
            <input
              type="text"
              name="buyer_name"
              aria-label={t('rfq.buyerNamePlaceholder')}
              placeholder={t('rfq.buyerNamePlaceholder')}
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b]"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input
              type="email"
              name="email"
              required
              aria-label={t('rfq.emailPlaceholder')}
              placeholder={t('rfq.emailPlaceholder')}
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b]"
            />
            <input
              type="text"
              name="whatsapp"
              aria-label={t('rfq.phonePlaceholder')}
              placeholder={t('rfq.phonePlaceholder')}
              class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b]"
            />
          </div>

          <input
            type="text"
            name="destination"
            value={visitorCountry || undefined}
            aria-label={t('rfq.destinationPlaceholder')}
            placeholder={t('rfq.destinationPlaceholder')}
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b]"
          />

          <textarea
            name="message"
            rows="2"
            aria-label={t('rfq.requirementsPlaceholder')}
            placeholder={t('rfq.requirementsPlaceholder')}
            class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] placeholder:text-[#52525b] resize-none"
          ></textarea>

          <!-- Turnstile Container (Canonical Action: quote_cart) -->
          {turnstileSiteKey && (
            <div
              class="cf-turnstile my-1.5"
              data-sitekey={turnstileSiteKey}
              data-action="quote_cart"
              data-theme="light"
              data-size="flexible"
              data-error-callback="onTurnstileError"
            ></div>
          )}

          <button
            type="submit"
            id="rfq-submit-btn"
            data-default-text={submitButtonText}
            data-success-message={successFeedbackMessage}
            class="w-full py-2.5 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer disabled:opacity-50"
          >
            <span id="rfq-submit-text">{submitButtonText}</span>
            <svg id="rfq-submit-icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- Feedback Alert Box -->
        <div id="rfq-alert" class="hidden p-3 rounded-xl text-xs transition-all"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { quoteCart, addToQuote, removeFromQuote, updateQuoteQuantity, clearQuote } from '@stores/quoteCart';

  // Prevent cross-origin Turnstile script from throwing uncaught Script error. on domain/network mismatch
  (window as any).onTurnstileError = () => {
    return true;
  };

  // Lazy-load Turnstile on demand to eliminate ~700KB initial page load payload
  function ensureTurnstileLoaded() {
    if (typeof window === 'undefined' || document.getElementById('cf-turnstile-script')) return;
    const script = document.createElement('script');
    script.id = 'cf-turnstile-script';
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    script.crossOrigin = 'anonymous';
    document.head.appendChild(script);
  }

  // Auto-fill visitor country via SSR cache or Cloudflare /api/geo
  function autoFillVisitorCountry() {
    const destInput = document.querySelector('#quote-drawer-root input[name="destination"]') as HTMLInputElement | null;
    if (!destInput || destInput.value.trim()) return;

    const root = document.getElementById('quote-drawer-root');
    const ssrCountry = root?.getAttribute('data-visitor-country');
    if (ssrCountry && !destInput.value.trim()) {
      destInput.value = ssrCountry;
      return;
    }

    fetch('/api/geo')
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data?.countryName && destInput && !destInput.value.trim()) {
          destInput.value = data.countryName;
        }
      })
      .catch(() => {});
  }

  let currentAuthUser: any = null;

  async function checkDrawerAuth() {
    try {
      const res = await fetch('/api/auth/me');
      const data = await res.json();
      if (data && data.authenticated && data.user) {
        currentAuthUser = data.user;
        const emailInput = document.querySelector('#quote-drawer-root input[name="email"]') as HTMLInputElement | null;
        const nameInput = document.querySelector('#quote-drawer-root input[name="buyer_name"]') as HTMLInputElement | null;
        if (emailInput && !emailInput.value.trim()) {
          emailInput.value = data.user.email;
        }
        if (nameInput && !nameInput.value.trim() && data.user.name) {
          nameInput.value = data.user.name;
        }
        const userStatusLabel = document.getElementById('quote-user-auth-status');
        if (userStatusLabel) {
          userStatusLabel.textContent = `✓ Signed in: ${data.user.email}`;
          userStatusLabel.classList.remove('hidden');
        }
      }
    } catch {
      // non-blocking
    }
  }

  // Expose global drawer opener
  (window as any).openQuoteDrawer = () => {
    ensureTurnstileLoaded();
    autoFillVisitorCountry();
    checkDrawerAuth();
    const toggle = document.getElementById('quote-drawer-toggle') as HTMLInputElement | null;
    if (toggle) toggle.checked = true;
  };

  // Expose global quote dispatchers for inline page scripts
  (window as any).addToQuote = (item: any) => {
    addToQuote(item);
  };

  (window as any).addToQuoteAndOpen = (item: any) => {
    addToQuote(item);
    (window as any).openQuoteDrawer();
  };

  // Drain any quote items queued before drawer hydrated
  if (Array.isArray((window as any).__quoteQueue) && (window as any).__quoteQueue.length > 0) {
    (window as any).__quoteQueue.forEach((item: any) => {
      addToQuote(item);
    });
    (window as any).__quoteQueue = [];
    (window as any).openQuoteDrawer();
  }

  const drawerToggle = document.getElementById('quote-drawer-toggle') as HTMLInputElement | null;
  if (drawerToggle) {
    drawerToggle.addEventListener('change', () => {
      if (drawerToggle.checked) {
        ensureTurnstileLoaded();
        autoFillVisitorCountry();
      }
    });
  }

  // Auto-populate visitor country in background upon hydration
  autoFillVisitorCountry();

  const rfqFormElement = document.getElementById('rfq-form');
  if (rfqFormElement) {
    rfqFormElement.addEventListener('focusin', () => ensureTurnstileLoaded(), { once: true });
  }

  (window as any).closeQuoteDrawer = () => {
    const toggle = document.getElementById('quote-drawer-toggle') as HTMLInputElement | null;
    if (toggle) toggle.checked = false;
  };

  // Expose global Swatch Kit Request handler
  (window as any).requestSwatchKit = (customItem?: any) => {
    const root = document.getElementById('quote-drawer-root');
    const defaultSku = root?.dataset.swatchSku || 'SWATCH-KIT';
    const defaultTitle = root?.dataset.swatchTitle || 'Physical Yarn & Fabric Swatch Dossier';
    const defaultDesc = root?.dataset.swatchDesc || 'Complimentary for verified fashion labels & retail buyers';
    const defaultImage = root?.dataset.swatchImage || '/images/products/gv-ruffle-detail.webp';
    const defaultMoq = root?.dataset.swatchMoq || '1 Set (Free for Verified Buyers)';

    const rawSku = (customItem?.sku || defaultSku).trim();
    const itemSku = rawSku;
    const itemTitle = (customItem?.title || defaultTitle).trim();
    const itemDesc = (customItem?.variant || defaultDesc).trim();
    const itemImage = (customItem?.imageUrl || defaultImage).trim();
    const itemMoq = (customItem?.moq || defaultMoq).trim();
    const itemId = customItem?.id || `swatch-${itemSku.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;

    // Replace any existing swatch item in quote basket so it immediately reflects the latest SKU
    const current = quoteCart.get() || [];
    const withoutOldSwatch = current.filter((i) => !i.id.startsWith('swatch-') && i.id !== 'swatch-kit-sample');

    quoteCart.set([
      ...withoutOldSwatch,
      {
        id: itemId,
        title: itemTitle,
        sku: itemSku,
        imageUrl: itemImage,
        variant: itemDesc,
        quantity: 1,
        moq: itemMoq,
      }
    ]);

    (window as any).openQuoteDrawer();
  };

  // Auto-sync any existing generic swatch item in localStorage with current CMS SKU on init
  try {
    const rootEl = document.getElementById('quote-drawer-root');
    const activeSku = (rootEl?.dataset.swatchSku || 'SWATCH-KIT').trim();

    const currentCart = quoteCart.get() || [];
    let shouldSync = false;
    const syncedCart = currentCart.map((item) => {
      if ((item.id === 'swatch-kit-sample' || item.id.startsWith('swatch-')) && item.sku !== activeSku) {
        shouldSync = true;
        return {
          ...item,
          id: `swatch-${activeSku.toLowerCase().replace(/[^a-z0-9]/g, '-')}`,
          sku: activeSku,
        };
      }
      return item;
    });
    if (shouldSync) {
      quoteCart.set(syncedCart);
    }
  } catch {}

  // Intercept all legacy "#inquiry" links and buttons to trigger the unified Quote Drawer
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>(
      'a[href="#inquiry"], a[href$="/#inquiry"], [data-open-swatch-kit], [data-open-quote-drawer]'
    );
    if (!target) return;

    e.preventDefault();
    if (target.matches('[data-open-quote-drawer]')) {
      (window as any).openQuoteDrawer();
    } else {
      const customSku = target.getAttribute('data-swatch-sku') || target.dataset.swatchSku;
      const customTitle = target.getAttribute('data-swatch-title') || target.dataset.swatchTitle;
      const customDesc = target.getAttribute('data-swatch-desc') || target.dataset.swatchDesc;
      const customImage = target.getAttribute('data-swatch-image') || target.dataset.swatchImage;
      const customMoq = target.getAttribute('data-swatch-moq') || target.dataset.swatchMoq;

      (window as any).requestSwatchKit({
        sku: customSku,
        title: customTitle,
        variant: customDesc,
        imageUrl: customImage,
        moq: customMoq
      });
    }
  });

  const rootEl = document.getElementById('quote-drawer-root');
  const container = document.getElementById('quote-items-container');
  const emptyState = document.getElementById('quote-empty-state');
  const badgeCount = document.getElementById('quote-badge-count');
  const btnClear = document.getElementById('btn-clear-cart');
  const formSection = document.getElementById('quote-form-section');
  const rfqForm = document.getElementById('rfq-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('rfq-submit-text');
  const alertBox = document.getElementById('rfq-alert');

  function escapeHtml(val: unknown): string {
    return String(val ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderCart() {
    const items = quoteCart.get() || [];
    const totalCount = items.reduce((sum, i) => sum + i.quantity, 0);

    // Update Badges across page
    if (badgeCount) badgeCount.textContent = totalCount.toString();
    const navBadges = document.querySelectorAll('.nav-quote-badge');
    navBadges.forEach((el) => {
      el.textContent = totalCount.toString();
      if (totalCount > 0) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    if (!container || !emptyState || !btnClear || !formSection) return;

    if (items.length === 0) {
      container.innerHTML = '';
      emptyState.classList.remove('hidden');
      btnClear.classList.add('hidden');
      const submit = formSection.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      return;
    }

    emptyState.classList.add('hidden');
    btnClear.classList.remove('hidden');
    const submit = formSection.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submit) submit.disabled = false;

    const removeText = escapeHtml(rootEl?.dataset.removeText || 'Remove');

    container.innerHTML = items
      .map((item) => {
        const safeId = escapeHtml(item.id);
        const safeTitle = escapeHtml(item.title);
        const safeSku = item.sku ? escapeHtml(item.sku) : '';
        const safeVariant = escapeHtml(item.variant || 'Standard');
        const rawAttrVariant = escapeHtml(item.variant || '');
        const safeImgSrc = escapeHtml(
          (item.imageUrl || '/images/hero-light.webp').replace('https://cdn.sanity.io', '/cdn-image')
        );
        const safeQty = Number(item.quantity) || 0;

        return `
      <div class="flex items-center gap-3 p-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 text-xs">
        <img
          src="${safeImgSrc}"
          alt="${safeTitle}"
          class="w-12 h-12 rounded-lg object-cover bg-white border border-black/5 shrink-0"
        />
        <div class="flex-1 min-w-0">
          <h4 class="font-semibold text-[#1d1d1f] truncate">${safeTitle}</h4>
          <p class="text-[11px] text-[#86868b] truncate mt-0.5">
            ${safeSku ? `<span class="font-mono">${safeSku}</span> · ` : ''}${safeVariant}
          </p>
          <div class="flex items-center justify-between mt-1.5">
            <div class="flex items-center border border-black/15 rounded-md bg-white overflow-hidden text-[11px]">
              <button
                type="button"
                data-action="dec"
                data-id="${safeId}"
                data-variant="${rawAttrVariant}"
                class="px-2 py-0.5 hover:bg-black/5 transition-colors text-[#1d1d1f]"
              >−</button>
              <span class="px-2 font-mono font-medium">${safeQty}</span>
              <button
                type="button"
                data-action="inc"
                data-id="${safeId}"
                data-variant="${rawAttrVariant}"
                class="px-2 py-0.5 hover:bg-black/5 transition-colors text-[#1d1d1f]"
              >+</button>
            </div>
            <button
              type="button"
              data-action="remove"
              data-id="${safeId}"
              data-variant="${rawAttrVariant}"
              class="text-[11px] text-[#86868b] hover:text-rose-600 transition-colors"
            >
              ${removeText}
            </button>
          </div>
        </div>
      </div>`;
      })
      .join('');
  }

  // Subscribe to changes
  quoteCart.subscribe(() => {
    renderCart();
  });

  // Handle Cart item actions (Delegation)
  container?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('button');
    if (!target) return;
    const action = target.dataset.action;
    const id = target.dataset.id;
    const variant = target.dataset.variant || '';
    if (!id) return;

    const items = quoteCart.get() || [];
    const item = items.find((i) => i.id === id && i.variant === variant);

    if (!item) return;

    const isSingleSample = item.quantity < 50 || id.startsWith('swatch-') || id === 'swatch-kit-sample' || id.startsWith('spec-');
    const step = isSingleSample ? 1 : 50;

    if (action === 'remove') {
      removeFromQuote(id, variant);
    } else if (action === 'inc') {
      updateQuoteQuantity(id, variant, item.quantity + step);
    } else if (action === 'dec') {
      updateQuoteQuantity(id, variant, item.quantity - step);
    }
  });

  let clearConfirmTimer: ReturnType<typeof setTimeout> | null = null;
  btnClear?.addEventListener('click', () => {
    if (!btnClear) return;
    if (btnClear.dataset.confirming === 'true') {
      if (clearConfirmTimer) clearTimeout(clearConfirmTimer);
      btnClear.dataset.confirming = 'false';
      btnClear.textContent = btnClear.dataset.originalText || 'Clear all';
      clearQuote();
      return;
    }
    btnClear.dataset.originalText = btnClear.textContent || 'Clear all';
    btnClear.dataset.confirming = 'true';
    btnClear.textContent = rootEl?.dataset.confirmClear || 'Confirm?';
    clearConfirmTimer = setTimeout(() => {
      if (btnClear) {
        btnClear.dataset.confirming = 'false';
        btnClear.textContent = btnClear.dataset.originalText || 'Clear all';
      }
    }, 3000);
  });

  // Handle Form Submission
  rfqForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const items = quoteCart.get() || [];
    if (items.length === 0) {
      if (alertBox) {
        alertBox.className = 'p-3 rounded-xl text-xs bg-amber-50 text-amber-800 border border-amber-200 block';
        alertBox.textContent = rootEl?.dataset.emptyError || 'Your quote basket is empty.';
      }
      return;
    }

    const formData = new FormData(rfqForm);
    const turnstileToken = formData.get('cf-turnstile-response')?.toString() || '';
    if (!turnstileToken) {
      if (alertBox) {
        alertBox.className = 'p-3 rounded-xl text-xs bg-amber-50 text-amber-800 border border-amber-200 block';
        alertBox.textContent = rootEl?.dataset.securityError || 'Please complete the security check below.';
      }
      return;
    }

    const payload = {
      buyerInfo: {
        company: formData.get('company'),
        name: formData.get('buyer_name'),
        email: formData.get('email'),
        whatsapp: formData.get('whatsapp'),
        destination: formData.get('destination'),
        message: formData.get('message'),
      },
      items,
      turnstileToken,
      inquiryType: 'quote_cart',
    };

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = rootEl?.dataset.submittingText || 'Submitting Official RFQ...';
    }

    try {
      const res = await fetch('/api/submit-quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        const orderNo = data.orderNo || 'Recorded';
        if (alertBox) {
          alertBox.className = 'p-3.5 rounded-xl text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 block space-y-2';
          alertBox.innerHTML = `
            <div class="font-semibold text-emerald-900">✓ Official RFQ & Order Received!</div>
            <div class="text-[11px]">Official Order No: <strong class="font-mono">${escapeHtml(orderNo)}</strong></div>
            <div class="pt-1">
              ${
                currentAuthUser
                  ? `<a href="/orders" class="inline-block text-center w-full py-1.5 px-3 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all">Track in My Orders →</a>`
                  : `<button type="button" onclick="window.openAuthLogin && window.openAuthLogin('/orders')" class="inline-block text-center w-full py-1.5 px-3 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all cursor-pointer">Sign In with this email to Track Order →</button>`
              }
            </div>
          `;
        }
        rfqForm.reset();
        clearQuote();

        // Hide Turnstile container on success so it does not re-verify or distract
        const turnstileContainer = rfqForm.querySelector('.cf-turnstile') as HTMLElement;
        if (turnstileContainer) turnstileContainer.style.display = 'none';
      } else {
        throw new Error(data.error || 'Submission failed');
      }
    } catch (err: any) {
      if (alertBox) {
        alertBox.className = 'p-3 rounded-xl text-xs bg-rose-50 text-rose-800 border border-rose-200 block';
        alertBox.textContent = err.message || rootEl?.dataset.networkError || 'Network error occurred.';
      }
      // Only reset Turnstile on submission failure so user can re-verify and retry
      if (typeof (window as any).turnstile !== 'undefined') {
        try {
          (window as any).turnstile.reset();
        } catch {
          // ignore
        }
      }
    } finally {
      if (submitBtn && submitText) {
        submitBtn.disabled = false;
        submitText.textContent = submitBtn.dataset.defaultText || 'Submit Official RFQ';
      }
    }
  });
</script>
