---
// src/components/SwatchInquiry.astro
import { fetchRfqSettings } from '@data/rfqSettings';
import { DEFAULT_SWATCH_INQUIRY } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedValue } from '@i18n';

interface Props {
  badge?: string;
  headline?: string;
  subline?: string;
  buttonText?: string;
  swatchSku?: string;
  categories?: string[];
  showSection?: boolean;
  showButton?: boolean;
}

const {
  badge = DEFAULT_SWATCH_INQUIRY.badge,
  headline = DEFAULT_SWATCH_INQUIRY.headline,
  subline = DEFAULT_SWATCH_INQUIRY.subline,
  buttonText: propButtonText,
  swatchSku,
  categories = DEFAULT_SWATCH_INQUIRY.categories,
  showSection: propShowSection,
  showButton: propShowButton,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Safe text extractor: resolves Sanity multilingual object ({ en: '...' }) or string safely without throwing .trim errors
const toText = (val: any, fallback = ''): string => {
  if (val === null || val === undefined) return fallback;
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    const loc = getLocalizedValue(val, currentLang);
    return typeof loc === 'string' ? loc.trim() : (loc ? String(loc).trim() : fallback);
  }
  return String(val).trim();
};

const safeBadge = toText(badge, DEFAULT_SWATCH_INQUIRY.badge);
const safeHeadline = toText(headline, DEFAULT_SWATCH_INQUIRY.headline);
const safeSubline = toText(subline, DEFAULT_SWATCH_INQUIRY.subline);

const rfqSettings = await fetchRfqSettings();
const showInquirySection = propShowSection !== undefined ? propShowSection : (rfqSettings?.showInquirySection ?? true);
const showSwatchButton = propShowButton !== undefined ? Boolean(propShowButton) : true;
const displayButtonText = toText(propButtonText) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));

const I18N_COPY: Record<string, { tagText: string; tagSubtitle: string; verified: string; included: string; note: string }> = {
  de: {
    tagText: 'Physisches Muster-Dossier',
    tagSubtitle: 'Kuratierte Garnringe, Stoffmuster & DHL-Expressversand',
    verified: 'Kostenlos für verifizierte Marken',
    included: 'Im Muster-Dossier enthalten:',
    note: 'Prioritätsprüfung für Modemarken & Einkaufsbüros'
  },
  fr: {
    tagText: 'Dossier d’Échantillons Physiques',
    tagSubtitle: 'Nuanciers de fils, échantillons de tissus et envoi DHL Express',
    verified: 'Offert aux marques vérifiées',
    included: 'Inclus dans le dossier d’échantillons :',
    note: 'Traitement prioritaire pour marques de mode et bureaux d’achat'
  },
  es: {
    tagText: 'Dossier de Muestras Físicas',
    tagSubtitle: 'Anillas de hilo, muestrarios de tejido y envío por DHL Express',
    verified: 'Gratis para marcas verificadas',
    included: 'Incluido en el dossier de muestras:',
    note: 'Gestión prioritaria para marcas de moda y oficinas de compras'
  },
  en: {
    tagText: 'Physical Sample Dossier',
    tagSubtitle: 'Curated Yarn Rings, Fabric Swatches & DHL Air Dispatch',
    verified: 'Free for Verified Brands',
    included: 'Included in Sample Dossier:',
    note: 'Priority Handling for Fashion Labels & Buying Offices'
  }
};
const copy = I18N_COPY[currentLang] || I18N_COPY.en;
---

{showInquirySection && (
<section id="inquiry" class="bg-white text-[#1d1d1f] border-t border-black/5 py-8 sm:py-10 lg:py-12">
  <div class="apple-rail-bento w-full">
    <div class="max-w-5xl mx-auto bg-[#f5f5f7] rounded-2xl sm:rounded-3xl border border-black/5 overflow-hidden shadow-xs grid grid-cols-1 md:grid-cols-12 items-stretch">
      
      <!-- Left Side (5 Cols): Physical Swatch Kit & Fabric Macro Visual Presentation -->
      <div class="md:col-span-5 relative min-h-[200px] sm:min-h-[220px] md:min-h-full bg-stone-100 overflow-hidden group">
        <picture>
          <source srcset="/images/products/gv-ruffle-detail.webp" type="image/webp" />
          <img
            src="/images/products/gv-ruffle-detail.webp"
            alt="Curated Swatch Kit & Fabric Dossier"
            class="absolute inset-0 w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
            width="800"
            height="509"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent flex flex-col justify-end p-4 sm:p-5 text-white">
          <span class="text-[10px] font-mono tracking-widest uppercase text-white/80">{copy.tagText}</span>
          <p class="text-xs sm:text-sm font-semibold mt-0.5 text-white">
            {copy.tagSubtitle}
          </p>
        </div>
      </div>

      <!-- Right Side (7 Cols): Tight, Content-Rich Details & Action (No Empty Space) -->
      <div class="md:col-span-7 p-5 sm:p-6 lg:p-7 flex flex-col justify-center gap-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#86868b]">{safeBadge}</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-mono">
              48h Express
            </span>
            <span class="hidden sm:inline-block text-[10px] text-zinc-400 font-mono">· {copy.verified}</span>
          </div>
          
          <h2 class="text-lg sm:text-xl lg:text-2xl font-semibold tracking-tight text-[#1d1d1f] mt-1">
            {safeHeadline}
          </h2>
          <p class="text-xs sm:text-[13px] text-[#86868b] font-normal leading-relaxed mt-1">
            {safeSubline}
          </p>
        </div>

        <!-- Included Fabric Silhouettes Pills (Snug & Compact) -->
        <div class="pt-2 border-t border-black/5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block mb-1.5">
            {copy.included}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {categories.map((cat: string) => (
              <span class="px-2.5 py-1 rounded-full bg-white text-zinc-800 text-[11px] font-medium border border-black/5 shadow-2xs">
                ✓ {cat}
              </span>
            ))}
          </div>
        </div>

        <!-- Action Row (Snug, No Gap) -->
        <div class="pt-2 border-t border-black/5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
          {showSwatchButton && (
            <button
              type="button"
              data-open-swatch-kit
              data-swatch-sku={swatchSku}
              class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm hover:shadow-md cursor-pointer inline-flex items-center justify-center gap-2 shrink-0"
            >
              <span>{displayButtonText}</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          )}
          <p class="text-[11px] text-[#86868b]">
            {copy.note}
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
)}
