---
import { type SiteConfig, type CustomImage, type Page } from 'types';
import { AppleNav, AppleFooter, QuoteDrawer, WhatsAppWidget, SEO } from '@components';
import SectionBoundary from '@components/SectionBoundary.astro';
import { fetchData } from '@data/siteConfig';
import { SanityImageService } from '@utils/image';
import { getHreflangAlternates, getLangFromUrl, getLocalizedValue, useTranslations } from '@i18n';
import type { TwitterCardType } from 'astro-seo';
import { getSystemSettings } from '@utils/db';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

import '../styles/globals.css';

interface Props {
    title?: string;
    addTitleSuffix?: boolean;
    description?: string;
    image?: CustomImage | string;
    canonicalUrl?: string | URL;
    type?: 'website' | 'article' | 'product';
    twitterCard?: TwitterCardType;
    noindex?: boolean;
    nofollow?: boolean;
    page?: Partial<Page>;
    structuredData?: Record<string, any> | Record<string, any>[];
    bodyClass?: string;
    mainClass?: string;
    preloadHeroImage?: boolean | { src: string; srcset?: string; sizes?: string };
    bare?: boolean;
}

const {
    title,
    addTitleSuffix,
    description,
    image,
    canonicalUrl,
    type,
    twitterCard,
    noindex,
    nofollow,
    page,
    structuredData,
    bodyClass,
    mainClass,
    preloadHeroImage,
    bare = false,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const hreflangAlternates = getHreflangAlternates(Astro.url, Astro.site);
const configData: SiteConfig = bare ? ({} as SiteConfig) : ((await fetchData()) || {});
if (!bare) {
    SanityImageService.setStudioProxyConfig(configData?.enableImageProxy);
}

const rawImage = image ?? page?.socialImage;
const rawImageSrc = typeof rawImage === 'string' ? rawImage : rawImage?.src;
const imageSrc = rawImageSrc ? SanityImageService.hero(rawImageSrc, 1200) : undefined;
const resolvedImage = imageSrc
    ? { src: imageSrc.startsWith('http') || imageSrc.startsWith('/') ? imageSrc : new URL(imageSrc, Astro.site || Astro.url).toString() }
    : undefined;

const systemSettings = await getSystemSettings(cfEnv).catch(() => null);
const enableClientLogs = systemSettings ? Boolean(systemSettings.log_client_errors) : true;
---

<!doctype html>
<html lang={currentLang} data-theme="light" class="scroll-smooth">
    <head>
        <!-- High Priority Global Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <!-- Reusable Sanity & Astro SEO Component (Title, Canonical, OpenGraph, Twitter Cards) -->
        <SEO
            title={title}
            addTitleSuffix={addTitleSuffix}
            description={description}
            image={image}
            canonicalUrl={canonicalUrl}
            type={type}
            twitterCard={twitterCard}
            noindex={noindex || bare}
            nofollow={nofollow || bare}
            page={page}
            siteConfig={configData}
            structuredData={structuredData}
        />

        <!-- Automatic Google SEO Multilingual Hreflang Interlinking Tags (en, de, fr, es + x-default) -->
        {hreflangAlternates.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}

        <!-- High-priority Responsive LCP Image Preload (Avoids downloading mismatched 1200px on mobile) -->
        {preloadHeroImage && (
            typeof preloadHeroImage === 'object' ? (
                <link
                    rel="preload"
                    as="image"
                    href={preloadHeroImage.src}
                    imagesrcset={preloadHeroImage.srcset}
                    imagesizes={preloadHeroImage.sizes}
                    fetchpriority="high"
                />
            ) : (
                resolvedImage?.src && (
                    <link rel="preload" as="image" href={resolvedImage.src} fetchpriority="high" />
                )
            )
        )}

        <!-- Low Priority Global Metadata -->
        <link rel="icon" type="image/svg+xml" href={configData?.favicon?.src || "/favicon.svg"} />
        <link rel="alternate icon" href="/favicon.ico" />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body class={bodyClass || "bg-white text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white"}>
        {!bare && (
            <SectionBoundary sectionName="AppleNav">
                <AppleNav config={configData} />
            </SectionBoundary>
        )}
        <main class={mainClass}>
            <slot />
        </main>
        {!bare && (
            <SectionBoundary sectionName="AppleFooter">
                <AppleFooter config={configData} />
            </SectionBoundary>
        )}
        {!bare && (
            <SectionBoundary sectionName="QuoteDrawer">
                <QuoteDrawer />
            </SectionBoundary>
        )}

        <!-- 1. WhatsApp Instant Live Chat Widget (Controlled from Sanity Studio) -->
        {!bare && configData?.enableWhatsApp && configData?.whatsAppNumber && (
            <SectionBoundary sectionName="WhatsAppWidget">
                <WhatsAppWidget
                    phoneNumber={configData.whatsAppNumber}
                    prefillText={getLocalizedValue(configData.whatsAppPrefillText, currentLang, t('whatsapp.prefill'))}
                    tooltip={getLocalizedValue(configData.whatsAppTooltip, currentLang, t('whatsapp.tooltip'))}
                />
            </SectionBoundary>
        )}

        <!-- 2. Idle + Viewport Shimmer Hook: Pooled IntersectionObserver with idle scheduling -->
        <script>
            import { useIntersectionShimmer } from '@utils/useIntersectionShimmer';

            const shimmerController = useIntersectionShimmer(
                '.apple-skeleton, .apple-skeleton-warm, .apple-skeleton-surface, .apple-shimmer-wave',
                { rootMargin: '160px 160px', deferUntilIdle: true }
            );

            // Expose global handles for inline onload triggers, dynamic components & define:vars scripts
            const win = window as any;
            win.__shimmerController = shimmerController;
            win.__observeAppleShimmer = (target?: any, scope?: ParentNode) => shimmerController.observe(target || document, scope);
            win.__unobserveAppleShimmer = (el?: any) => shimmerController.unobserve(el);
        </script>

        <!-- 3. Client-side Global Runtime Resilience Boundary (Centered Apple Aesthetic) -->
        <div
          id="global-runtime-fallback"
          role="alert"
          aria-live="assertive"
          class="fixed inset-x-0 bottom-6 z-50 hidden px-4 pointer-events-none flex justify-center"
        >
          <div class="pointer-events-auto max-w-md w-full bg-white/95 backdrop-blur-xl border border-black/10 rounded-2xl shadow-xl p-5 text-center space-y-3">
            <div class="w-9 h-9 rounded-full bg-[#f5f5f7] border border-black/8 text-[#1d1d1f] flex items-center justify-center mx-auto">
              <svg class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="text-xs sm:text-sm font-semibold tracking-tight text-[#1d1d1f]">
                Something went wrong in this view
              </p>
              <p id="global-runtime-msg" class="text-[11px] text-[#86868b] line-clamp-2 break-all max-w-xs mx-auto"></p>
            </div>
            <div class="flex items-center justify-center gap-2 pt-1">
              <button
                type="button"
                id="global-runtime-retry-btn"
                class="px-4 py-1.5 rounded-full bg-[#1d1d1f] text-white text-xs font-semibold hover:bg-black active:scale-95 transition-all cursor-pointer"
              >
                Try Again
              </button>
              <button
                type="button"
                id="global-runtime-dismiss-btn"
                class="px-3.5 py-1.5 rounded-full bg-[#f5f5f7] text-[#52525b] hover:text-[#1d1d1f] hover:bg-[#e8e8ed] border border-black/5 text-xs font-medium transition-all cursor-pointer"
              >
                Dismiss
              </button>
            </div>
          </div>
        </div>

        <script is:inline define:vars={{ enableClientLogs }}>
          (function () {
            var isTelemetryEnabled = typeof enableClientLogs === 'boolean' ? enableClientLogs : true;
            var hasActiveError = false;
            var reportCount = 0;
            var MAX_REPORTS = 5;
            var reportedSignatures = {};

            var box = document.getElementById('global-runtime-fallback');
            var textEl = document.getElementById('global-runtime-msg');
            var retryBtn = document.getElementById('global-runtime-retry-btn');
            var dismissBtn = document.getElementById('global-runtime-dismiss-btn');

            function resetErrorBoundary() {
              hasActiveError = false;
              if (textEl) textEl.textContent = '';
              if (box) box.classList.add('hidden');
            }

            if (dismissBtn) {
              dismissBtn.addEventListener('click', resetErrorBoundary);
            }

            if (retryBtn) {
              retryBtn.addEventListener('click', function () {
                resetErrorBoundary();
                if (window.__observeAppleShimmer) {
                  try { window.__observeAppleShimmer(document); } catch (e) {}
                }
              });
            }

            function shouldIgnore(msgStr, srcStr) {
              if (!msgStr) return true;
              if (
                msgStr.indexOf('ResizeObserver') !== -1 ||
                msgStr === 'Script error.' ||
                msgStr.indexOf('AbortError') !== -1
              ) {
                return true;
              }
              if (srcStr) {
                if (
                  srcStr.indexOf('chrome-extension://') === 0 ||
                  srcStr.indexOf('moz-extension://') === 0 ||
                  srcStr.indexOf('safari-extension://') === 0
                ) {
                  return true;
                }
                if (srcStr.indexOf(location.origin) !== 0 && srcStr.indexOf('/') !== 0) {
                  return true;
                }
              }
              return false;
            }

            function sendErrorToBackend(payload) {
              // 1. Governance check: when client logging is disabled in settings, do not send
              if (!isTelemetryEnabled) return;
              // 2. Loop protection: avoid recursion when viewing admin logs
              if (location.pathname.indexOf('/admin/logs') === 0) return;
              // 3. Per-page rate limit: max 5 reports
              if (reportCount >= MAX_REPORTS) return;

              var sig = [payload.type, payload.message, payload.source || '', payload.lineno || 0].join(':');
              if (reportedSignatures[sig]) return;
              reportedSignatures[sig] = true;
              reportCount++;

              try {
                var json = JSON.stringify(payload);
                if (navigator.sendBeacon) {
                  var blob = new Blob([json], { type: 'application/json' });
                  navigator.sendBeacon('/api/client-error', blob);
                } else if (window.fetch) {
                  fetch('/api/client-error', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: json,
                    keepalive: true,
                  }).catch(function () {});
                }
              } catch (e) {}
            }

            function handleRuntimeError(type, message, source, lineno, colno, errorObj) {
              var msgStr = String(message || (errorObj && errorObj.message) || '');
              var srcStr = source ? String(source) : '';
              if (shouldIgnore(msgStr, srcStr)) return;

              var stackStr = errorObj && errorObj.stack ? String(errorObj.stack) : '';

              // 1. Report asynchronously to backend Logger -> D1
              sendErrorToBackend({
                type: type,
                message: msgStr.slice(0, 500),
                source: srcStr.slice(0, 300),
                lineno: typeof lineno === 'number' ? lineno : undefined,
                colno: typeof colno === 'number' ? colno : undefined,
                stack: stackStr.slice(0, 1500),
                path: location.pathname,
                href: location.href,
                viewport: window.innerWidth + 'x' + window.innerHeight,
              });

              // 2. Show non-intrusive fallback banner once
              if (hasActiveError) return;
              hasActiveError = true;
              console.warn('[ClientBoundary] Caught runtime exception:', msgStr, srcStr);
              if (textEl) textEl.textContent = msgStr;
              if (box) box.classList.remove('hidden');
            }

            // 1. Global window.onerror handler
            var prevOnError = window.onerror;
            window.onerror = function (message, source, lineno, colno, error) {
              handleRuntimeError('onerror', message, source, lineno, colno, error);
              if (typeof prevOnError === 'function') {
                return prevOnError.apply(this, arguments);
              }
              return false;
            };

            // 2. Global unhandledrejection handler
            window.addEventListener('unhandledrejection', function (event) {
              var reason = event.reason;
              var msg = reason && (reason.message || String(reason));
              var errObj = reason instanceof Error ? reason : null;
              handleRuntimeError('unhandledrejection', msg, location.pathname, undefined, undefined, errObj);
            });

            // 3. Expose imperative helper for caught client exceptions
            window.__reportClientError = function (error, customSource) {
              var msg = error && (error.message || String(error));
              handleRuntimeError('manual', msg, customSource || location.pathname, undefined, undefined, error);
            };
          })();
        </script>
    </body>
</html>
