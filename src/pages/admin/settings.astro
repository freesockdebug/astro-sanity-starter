---
// src/pages/admin/settings.astro
// Unified Dynamic Configuration Center: D1-backed Settings & Platform Infrastructure Health
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext, getRuntimeEnv } from '@utils/auth';
import { sanitizeAdminSettings } from '@utils/security';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, systemSettings: rawSettings, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/settings',
  { requiredMenu: 'settings' }
);
if (redirectResponse) return redirectResponse;

const rootAdminEmails = getRuntimeEnv('ADMIN_EMAILS', cfEnv) || '';
const hasLogtoOidc = !!(getRuntimeEnv('LOGTO_APP_ID', cfEnv) && getRuntimeEnv('LOGTO_ENDPOINT', cfEnv));
const hasLogtoM2m = !!(getRuntimeEnv('LOGTO_M2M_APP_ID', cfEnv) && getRuntimeEnv('LOGTO_M2M_APP_SECRET', cfEnv));
const hasTurnstile = !!(rawSettings.turnstile_secret_key || rawSettings.turnstile_site_key || getRuntimeEnv('TURNSTILE_SECRET_KEY', cfEnv) || getRuntimeEnv('PUBLIC_TURNSTILE_SITE_KEY', cfEnv) || getRuntimeEnv('TURNSTILE_SITE_KEY', cfEnv));
const hasResend = !!(rawSettings.resend_api_key || getRuntimeEnv('RESEND_API_KEY', cfEnv));
const hasSanity = !!((getRuntimeEnv('SANITY_TOKEN', cfEnv) || getRuntimeEnv('SANITY_API_TOKEN', cfEnv)) && getRuntimeEnv('SANITY_PROJECT_ID', cfEnv));
const hasCloudflareCdn = !!(rawSettings.cloudflare_api_token || getRuntimeEnv('CLOUDFLARE_API_TOKEN', cfEnv));
const settings = sanitizeAdminSettings(rawSettings);

const healthProbes = [
  { label: 'D1 Database', ok: true, on: 'Active', off: 'Inactive', warn: false },
  { label: 'Logto OIDC', ok: hasLogtoOidc, on: 'Configured', off: 'Missing', warn: true },
  { label: 'Logto M2M', ok: hasLogtoM2m, on: 'Configured', off: 'Optional', warn: true },
  { label: 'Turnstile', ok: hasTurnstile, on: 'Protected', off: 'Unset', warn: true },
  { label: 'Resend API', ok: hasResend, on: 'Enabled', off: 'Disabled', warn: false },
  { label: 'Sanity CMS', ok: hasSanity, on: 'Connected', off: 'Unset', warn: false },
  { label: 'Edge Purge', ok: hasCloudflareCdn, on: 'Active', off: 'Unset', warn: false },
];

type SettingField = {
  key: keyof typeof settings;
  label: string;
  type?: 'text' | 'email' | 'url' | 'password' | 'number' | 'select' | 'checkbox';
  placeholder?: string;
  help?: string;
  span?: number;
  mono?: boolean;
  extraClass?: string;
  min?: number;
  max?: number;
  step?: number;
  maxlength?: number;
  unit?: string;
  options?: { value: string; label: string }[];
  boxed?: boolean;
};

const s1Fields: SettingField[] = [
  { key: 'brand_name', label: 'Brand Display Name', placeholder: 'e.g. B2B ATELIER', help: 'Shown in browser titles, email notifications, and webhook alerts.', extraClass: 'font-medium' },
  { key: 'contact_email', label: 'Customer Support Email', type: 'email', placeholder: 'e.g. inquiry@yourbrand.com', help: 'Displayed to buyers in account portal and order requisition receipts.', mono: true },
  { key: 'whatsapp_number', label: 'VIP Concierge WhatsApp', placeholder: 'e.g. 8613800000000 (digits only with country code)', help: 'Powers the 1-click WhatsApp button in buyer account portal.', mono: true },
  { key: 'whatsapp_prefill', label: 'WhatsApp Inquiry Prefill Text', placeholder: 'Hello, I would like to consult on custom manufacturing...', help: 'Default message draft when a buyer initiates a WhatsApp consultation.' },
  { key: 'app_url', label: 'Website Canonical Public URL', type: 'url', span: 2, placeholder: 'https://gwenvenni.com', help: 'Used for absolute canonical links, sitemaps, and email link generation.', mono: true },
];

const s2EmailFields: SettingField[] = [
  { key: 'resend_from_email', label: 'Sender Address (From)', placeholder: 'e.g. RFQ Alert <rfq@yourdomain.com>', mono: true },
  { key: 'resend_to_emails', label: 'Recipient Email(s)', placeholder: 'e.g. sales@domain.com, lead@domain.com', mono: true },
  { key: 'resend_subject_prefix', label: 'Subject Prefix', placeholder: 'e.g. [New B2B RFQ]', mono: true },
];

const s3Fields: SettingField[] = [
  { key: 'order_no_prefix', label: 'Order Serial Prefix (2-8 Chars)', placeholder: 'ORD', maxlength: 8, mono: true, extraClass: 'font-bold uppercase', help: `Example generated order number: ${settings.order_no_prefix}-20261104-A1B2` },
  { key: 'shipping_carriers', label: 'Logistics Carriers Presets (Comma-separated)', placeholder: 'DHL Express,FedEx,UPS,SF Express', mono: true, help: 'Carriers available in the order dispatch / fulfillment dialog.' },
  { key: 'print_sheet_title', label: 'Printable Requisition Header Title', placeholder: 'OFFICIAL B2B PROCUREMENT REQUISITION', mono: true, help: 'Header on the official PDF/Print procurement requisition document.' },
  { key: 'print_sheet_footer', label: 'Printable Requisition Footer / Disclaimer', placeholder: 'This document is an official B2B sample & procurement requisition sheet.', help: 'Legal or terms notice at the bottom of printed requisition sheets.' },
];

const s4Fields: SettingField[] = [
  { key: 'login_retention_days', label: 'Audit Log Retention (Days)', type: 'number', min: 7, max: 365, mono: true, extraClass: 'font-bold', help: 'Audit trail retention window (7 to 365 days).' },
  { key: 'turnstile_hostnames', label: 'Turnstile Allowed Hostnames (Comma-separated)', span: 2, placeholder: 'e.g. yourdomain.com, www.yourdomain.com, localhost', mono: true, help: 'Leave blank to accept requests from the current request hostname automatically.' },
  { key: 'turnstile_site_key', label: 'Turnstile Site Key (Client-side)', placeholder: 'e.g. 0x4AAAAAA...', mono: true, help: 'Public challenge key rendered in the buyer quote basket drawer.' },
  { key: 'turnstile_secret_key', label: 'Turnstile Secret Key (Server-side)', type: 'password', span: 2, placeholder: 'e.g. 0x4AAAAAA... (leave unchanged or enter new key)', mono: true, help: 'Private key used by /api/submit-quote to verify challenges with Cloudflare.' },
];

const s6Fields: SettingField[] = [
  { key: 'enable_error_logging', label: 'Enable D1 Error Logging', type: 'checkbox', boxed: true, help: 'Persist runtime errors, unhandled exceptions, and API anomalies into D1 database for in-dashboard diagnostics.' },
  { key: 'log_authenticated_users', label: 'Log Authenticated Users', type: 'checkbox', boxed: true, help: 'Control whether activity and error records are logged for signed-in buyers and administrators (GDPR / Privacy).' },
  { key: 'log_client_errors', label: 'Frontend Client Error Telemetry (前端异常监控)', type: 'checkbox', boxed: true, help: 'Capture unhandled browser exceptions (window.onerror & unhandledrejection) and report to D1 diagnostics. When disabled, client stops reporting and backend rejects telemetry.' },
  { key: 'log_retention_days', label: 'Error Log Retention (Days)', type: 'number', min: 1, max: 365, boxed: true, mono: true, extraClass: 'font-bold', help: 'Automatic rolling prune threshold (1 to 365 days).' },
  {
    key: 'log_min_level',
    label: 'Minimum Log Level to D1',
    type: 'select',
    boxed: true,
    mono: true,
    extraClass: 'font-semibold',
    help: 'Controls D1 write volume. Info/Debug capture full request profiling.',
    options: [
      { value: 'debug', label: 'debug (Verbose + SQL timings)' },
      { value: 'info', label: 'info (All completed requests & events)' },
      { value: 'warn', label: 'warn (Default: Slow requests & warnings)' },
      { value: 'error', label: 'error (Errors & critical only)' },
      { value: 'critical', label: 'critical (Critical incidents only)' },
    ],
  },
  { key: 'slow_request_threshold_ms', label: 'Slow Request Warning Threshold (ms)', type: 'number', min: 50, max: 30000, step: 50, span: 2, boxed: true, mono: true, extraClass: 'font-bold', unit: 'ms (Default: 1000ms)', help: 'Requests exceeding this threshold are automatically captured as performance warnings even in warn/error mode.' },
];

const s7Fields: SettingField[] = [
  { key: 'revalidate_secret', label: 'Revalidation Webhook Secret', type: 'password', placeholder: 'e.g. my-secret-revalidate-token', mono: true, help: 'Shared secret for Sanity Webhook or manual /api/revalidate calls.' },
  { key: 'cloudflare_zone_id', label: 'Cloudflare Zone ID', placeholder: 'e.g. 023e105f4ecef8ad9ca31a8372d0c353', mono: true, help: 'Found on Cloudflare dashboard Overview tab for your domain.' },
  { key: 'cloudflare_api_token', label: 'Cloudflare Purge API Token', type: 'password', placeholder: 'Bearer token with Cache:Purge permission', mono: true, help: 'API Token with Zone.Cache Purge permissions.' },
];

const dictLinks = [
  { href: '/admin/dicts?group=shipping_carriers', title: '📦 Shipping Carriers', desc: 'Live carrier tracking URL templates (DHL, FedEx, UPS, SF, EMS) with query parameter placeholders.' },
  { href: '/admin/dicts?group=quick_replies', title: '💬 Quick Reply Templates', desc: 'English response chips for approval remarks, dispatch notifications, and rejection feedback.' },
  { href: '/admin/dicts?group=customer_tiers', title: '🏷️ Customer Tiers & Tags', desc: 'B2B client discount tiers (Regular, Wholesale, VIP, Partner) and CRM tag chips.' },
];

const inputCls = (f: SettingField, bg = 'bg-[#f5f5f7]') =>
  `w-full px-3 ${f.boxed ? 'py-1.5' : 'py-2'} text-xs rounded-xl ${bg} border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all ${f.mono ? 'font-mono' : ''} ${f.extraClass || ''}`;
---

<AdminLayout
  title="Workspace Settings"
  currentTab="settings"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
>
  <AdminPageToolbar
    title="Workspace Settings"
    subtitle="Dynamic runtime configurations for brand identity, buyer concierge, RFQ dispatch rules, and access control."
    badge="Live D1 Sync"
    badgeColor="emerald"
    class="mb-5"
  >
    <div slot="actions" class="flex items-center gap-2.5">
      <button id="save-settings-btn-top" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        <span>Save Changes</span>
      </button>
    </div>
  </AdminPageToolbar>

  <!-- Infrastructure Health Status Grid -->
  <div class="mb-6 p-4 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f]">Platform Infrastructure Health</span>
        <span class="text-[10px] text-[#86868b]">Read-only status probes</span>
      </div>
      <div class="text-[11px] font-mono text-[#86868b] truncate max-w-xs" title={`Root Admin: ${rootAdminEmails}`}>
        Root Admin: <strong class="text-[#1d1d1f] font-semibold">{rootAdminEmails ? rootAdminEmails.split(',')[0] : 'Unset'}</strong>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 min-[1760px]:grid-cols-7 gap-2 pt-1 text-xs">
      {healthProbes.map((p) => (
        <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between">
          <span class="font-medium text-[#52525b]">{p.label}</span>
          <span class:list={[
            'inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-md border',
            p.ok ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : p.warn ? 'text-amber-700 bg-amber-50 border-amber-200' : 'text-zinc-600 bg-zinc-100 border-zinc-200',
          ]}>
            <span class:list={['w-1.5 h-1.5 rounded-full', p.ok ? 'bg-emerald-500' : p.warn ? 'bg-amber-500' : 'bg-zinc-400']}></span>
            {p.ok ? p.on : p.off}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Settings Configuration Form -->
  <form id="settings-form" class="space-y-6">
    <!-- Section 1: Brand & Buyer Concierge -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">1. Brand Identity & Buyer Concierge</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Customizes client-facing brand titles, direct support emails, and VIP WhatsApp concierge.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {s1Fields.map((f) => (
          <div class={f.span === 2 ? 'md:col-span-2' : ''}>
            <label for={f.key} class="block text-xs font-semibold text-[#1d1d1f] mb-1">{f.label}</label>
            <input type={f.type || 'text'} id={f.key} name={f.key} value={String(settings[f.key] ?? '')} placeholder={f.placeholder} class={inputCls(f)} />
            {f.help && <p class="text-[11px] text-[#86868b] mt-1">{f.help}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- Section 2: RFQ Notifications & Webhook -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">2. RFQ Inbound Notifications & Webhooks</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Control automatic dispatch when buyers submit procurement or swatch inquiries.</p>
      </div>

      <div class="space-y-3 pt-1">
        <label for="enable_email_notify" class="flex items-center gap-2.5 cursor-pointer">
          <input type="checkbox" id="enable_email_notify" name="enable_email_notify" checked={Boolean(settings.enable_email_notify)} class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f]" />
          <span class="text-xs font-bold text-[#1d1d1f]">Dispatch Email Notifications via Resend</span>
        </label>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {s2EmailFields.map((f) => (
            <div>
              <label for={f.key} class="block text-xs font-medium text-[#52525b] mb-1">{f.label}</label>
              <input type="text" id={f.key} name={f.key} value={String(settings[f.key] ?? '')} placeholder={f.placeholder} class={inputCls(f)} />
            </div>
          ))}
        </div>
        <div class="pt-2">
          <label for="resend_api_key" class="block text-xs font-semibold text-[#1d1d1f] mb-1">Resend API Key (re_...)</label>
          <input type="password" id="resend_api_key" name="resend_api_key" value={settings.resend_api_key} placeholder="re_xxxxxxxxxxxxxxxxx (leave unchanged or enter new key)" autocomplete="new-password" class="w-full px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono" />
          <p class="text-[11px] text-[#86868b] mt-1">Overrides the <code>RESEND_API_KEY</code> environment variable if provided.</p>
        </div>
      </div>

      <div class="border-t border-black/5 pt-4 space-y-3">
        <label for="enable_webhook_notify" class="flex items-center gap-2.5 cursor-pointer">
          <input type="checkbox" id="enable_webhook_notify" name="enable_webhook_notify" checked={Boolean(settings.enable_webhook_notify)} class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f]" />
          <span class="text-xs font-bold text-[#1d1d1f]">Dispatch Bot Webhooks (WeCom, DingTalk, Feishu, Slack)</span>
        </label>
        <div>
          <label for="notification_webhook_url" class="block text-xs font-medium text-[#52525b] mb-1">Outbound Webhook HTTPS URL</label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="url" id="notification_webhook_url" name="notification_webhook_url" value={settings.notification_webhook_url} placeholder="https://qyapi.weixin.qq.com/... or https://oapi.dingtalk.com/..." class="flex-1 px-3 py-2 text-xs rounded-xl bg-[#f5f5f7] border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] focus:bg-white transition-all font-mono" />
            <button id="test-webhook-btn" type="button" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-white border border-black/15 hover:border-black/30 text-[#1d1d1f] hover:bg-[#f5f5f7] shadow-2xs active:scale-95 transition-all whitespace-nowrap cursor-pointer flex items-center justify-center gap-1.5">
              <span>Test Connection</span>
            </button>
          </div>
          <p id="webhook-test-status" class="text-[11px] text-[#86868b] mt-1.5">Supports WeChat Work, DingTalk markdown cards, Feishu / Lark, and generic JSON webhooks. Must be HTTPS.</p>
        </div>
      </div>
    </div>

    <!-- Section 3: Orders & Fulfillment Rules -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">3. Orders & Requisition Sheet Standards</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Configures order number generation, logistics carrier presets, and printable requisition sheets.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {s3Fields.map((f) => (
          <div>
            <label for={f.key} class="block text-xs font-semibold text-[#1d1d1f] mb-1">{f.label}</label>
            <input type="text" id={f.key} name={f.key} value={String(settings[f.key] ?? '')} placeholder={f.placeholder} maxlength={f.maxlength} class={inputCls(f)} />
            {f.help && <p class="text-[11px] text-[#86868b] mt-1">{f.help}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- Section 4: Enterprise RBAC & Team Member Governance -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">4. Organization, Team & RBAC Governance</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Team members and role-based permissions have moved to their dedicated management consoles.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/admin/members" class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/20 transition-all flex items-start gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-base shrink-0 border border-blue-200">🧑‍💼</div>
          <div>
            <div class="flex items-center gap-1.5"><span class="text-xs font-bold text-[#1d1d1f] group-hover:text-blue-600 transition-colors">Team Members</span><span class="text-xs text-[#86868b]">→</span></div>
            <p class="text-[11px] text-[#86868b] mt-0.5 leading-relaxed">Authorize staff, select from registered Logto accounts, assign roles, and view performance workloads.</p>
          </div>
        </a>
        <a href="/admin/roles" class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/20 transition-all flex items-start gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center text-base shrink-0 border border-purple-200">🔐</div>
          <div>
            <div class="flex items-center gap-1.5"><span class="text-xs font-bold text-[#1d1d1f] group-hover:text-purple-600 transition-colors">Roles & Permissions</span><span class="text-xs text-[#86868b]">→</span></div>
            <p class="text-[11px] text-[#86868b] mt-0.5 leading-relaxed">Visual RBAC matrix: customize row-level DataScope, visible menus, and fine-grained action buttons.</p>
          </div>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 border-t border-black/5">
        <input type="hidden" id="co_admin_emails" name="co_admin_emails" value={settings.co_admin_emails} />
        {s4Fields.map((f) => (
          <div class={f.span === 2 ? 'md:col-span-2' : ''}>
            <label for={f.key} class="block text-xs font-semibold text-[#1d1d1f] mb-1">{f.label}</label>
            <input type={f.type || 'text'} id={f.key} name={f.key} value={String(settings[f.key] ?? '')} min={f.min} max={f.max} placeholder={f.placeholder} autocomplete={f.type === 'password' ? 'new-password' : undefined} class={inputCls(f)} />
            {f.help && <p class="text-[11px] text-[#86868b] mt-1">{f.help}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- Section 5: Universal Data Dictionary Engine Integration -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">5. Universal Data Dictionaries (Live Engine)</h2>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>3-Tier Caching Active
            </span>
          </div>
          <p class="text-xs text-[#86868b] mt-0.5">Shipping carriers, quick reply templates, customer tiers, and tags are dynamically configured without code redeployment.</p>
        </div>
        <a href="/admin/dicts" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] hover:bg-black text-white transition-all shadow-2xs cursor-pointer shrink-0">
          <span>Open Data Dictionaries Console</span><span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {dictLinks.map((d) => (
          <a href={d.href} class="p-4 rounded-xl border border-black/5 bg-[#fbfbfd] hover:bg-[#f5f5f7] hover:border-black/15 transition-all group block space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-[#1d1d1f] group-hover:text-blue-600 transition-colors">{d.title}</span>
              <span class="text-[11px] text-[#86868b]">Manage →</span>
            </div>
            <p class="text-[11px] text-[#52525b] leading-relaxed">{d.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Section 6: Diagnostics & Observability -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">6. Diagnostics & Observability Governance</h2>
          <p class="text-xs text-[#86868b] mt-0.5">Control D1 business error logging, logged-in user tracking, and retention thresholds.</p>
        </div>
        <a href="/admin/logs" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold bg-[#f5f5f7] hover:bg-black hover:text-white transition-all text-[#1d1d1f]">
          <span>Open Diagnostics Console</span><span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
        {s6Fields.map((f) =>
          f.type === 'checkbox' ? (
            <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex items-start gap-3">
              <input type="checkbox" id={f.key} name={f.key} checked={Boolean(settings[f.key])} class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f] mt-0.5 shrink-0" />
              <div>
                <label for={f.key} class="block text-xs font-bold text-[#1d1d1f] cursor-pointer">{f.label}</label>
                <p class="text-[11px] text-[#86868b] mt-0.5">{f.help}</p>
              </div>
            </div>
          ) : (
            <div class={`p-3.5 rounded-xl bg-[#f5f5f7] border border-black/5 flex flex-col justify-between ${f.span === 2 ? 'md:col-span-2' : ''}`}>
              <div>
                <label for={f.key} class="block text-xs font-bold text-[#1d1d1f] mb-1">{f.label}</label>
                {f.type === 'select' ? (
                  <select id={f.key} name={f.key} class={inputCls(f, 'bg-white')}>
                    {(f.options || []).map((opt) => (
                      <option value={opt.value} selected={settings[f.key] === opt.value}>{opt.label}</option>
                    ))}
                  </select>
                ) : f.unit ? (
                  <div class="flex items-center gap-2">
                    <input type="number" id={f.key} name={f.key} value={String(settings[f.key] ?? 1000)} min={f.min} max={f.max} step={f.step} class="w-36 px-3 py-1.5 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] font-mono font-bold" />
                    <span class="text-xs text-[#86868b]">{f.unit}</span>
                  </div>
                ) : (
                  <input type={f.type || 'text'} id={f.key} name={f.key} value={String(settings[f.key] ?? '')} min={f.min} max={f.max} class={inputCls(f, 'bg-white')} />
                )}
              </div>
              {f.help && <p class="text-[11px] text-[#86868b] mt-1">{f.help}</p>}
            </div>
          )
        )}
      </div>
    </div>

    <!-- Section 7: Edge CDN & Cache Invalidation -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3">
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">7. Edge CDN Purge & Cache Invalidation</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Configure automated Cloudflare global CDN cache purging upon content updates.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {s7Fields.map((f) => (
          <div>
            <label for={f.key} class="block text-xs font-semibold text-[#1d1d1f] mb-1">{f.label}</label>
            <input type={f.type || 'text'} id={f.key} name={f.key} value={String(settings[f.key] ?? '')} placeholder={f.placeholder} autocomplete={f.type === 'password' ? 'new-password' : undefined} class={inputCls(f)} />
            {f.help && <p class="text-[11px] text-[#86868b] mt-1">{f.help}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Save Toolbar -->
    <div class="sticky bottom-4 z-20 flex items-center justify-between p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-black/10 shadow-lg">
      <div class="text-xs text-[#86868b]">Changes take effect immediately across all edge nodes upon saving.</div>
      <button id="save-settings-btn-bottom" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-xs active:scale-95 transition-all cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        <span>Save All Settings</span>
      </button>
    </div>
  </form>

  <!-- Client Script for Form Handling (Pure Vanilla JS - Zero TS Syntax) -->
  <script>
    function initSettingsPage() {
      const form = document.getElementById('settings-form') as HTMLFormElement | null;
      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const saveTop = document.getElementById('save-settings-btn-top') as HTMLButtonElement | null;
      const saveBottom = document.getElementById('save-settings-btn-bottom') as HTMLButtonElement | null;
      const testBtn = document.getElementById('test-webhook-btn') as HTMLButtonElement | null;
      const webhookStatus = document.getElementById('webhook-test-status');

      function showToast(message: string, isSuccess: boolean) {
        (window as any).__showToast?.(message, isSuccess);
      }

      function getFormUpdates() {
        if (!form) return {};
        const updates: Record<string, any> = {};
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[name]').forEach((el) => {
          const key = el.name;
          if (!key) return;
          if ((el as HTMLInputElement).type === 'checkbox') {
            updates[key] = (el as HTMLInputElement).checked;
          } else if ((el as HTMLInputElement).type === 'number') {
            const def = key === 'login_retention_days' ? '90' : key === 'log_retention_days' ? '30' : '1000';
            updates[key] = parseInt(el.value || def, 10);
          } else {
            let val = (el.value || '').toString().trim();
            if (key === 'order_no_prefix') val = val.toUpperCase();
            if (key === 'log_min_level') val = (val || 'warn').toLowerCase();
            updates[key] = val;
          }
        });
        return updates;
      }

      async function saveSettings() {
        const updates = getFormUpdates();
        const buttons = [saveTop, saveBottom];
        buttons.forEach((b) => {
          if (b) { b.disabled = true; b.classList.add('opacity-50', 'pointer-events-none'); }
        });
        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', updates }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            showToast(data.error || 'Failed to update settings.', false);
          } else {
            showToast('Settings saved successfully and synced to D1.', true);
          }
        } catch (err: any) {
          showToast('Network error while saving settings: ' + err.message, false);
        } finally {
          buttons.forEach((b) => {
            if (b) { b.disabled = false; b.classList.remove('opacity-50', 'pointer-events-none'); }
          });
        }
      }

      saveTop?.addEventListener('click', saveSettings);
      saveBottom?.addEventListener('click', saveSettings);

      testBtn?.addEventListener('click', async () => {
        const urlInput = document.getElementById('notification_webhook_url') as HTMLInputElement | null;
        const url = urlInput ? urlInput.value.trim() : '';
        if (!url) { showToast('Please provide a webhook URL before testing.', false); return; }

        testBtn.disabled = true;
        testBtn.textContent = 'Sending...';
        if (webhookStatus) {
          webhookStatus.textContent = 'Sending test payload to webhook...';
          webhookStatus.className = 'text-[11px] text-blue-600 mt-1.5 animate-pulse';
        }
        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'test_webhook', url }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast('Webhook reached successfully! Check your bot channel.', true);
            if (webhookStatus) {
              webhookStatus.textContent = '✔ Live Test Passed: ' + (data.message || 'HTTP 200 OK');
              webhookStatus.className = 'text-[11px] text-emerald-600 font-semibold mt-1.5';
            }
          } else {
            showToast(data.error || 'Webhook test failed.', false);
            if (webhookStatus) {
              webhookStatus.textContent = '✖ Test Failed: ' + (data.error || 'Connection error');
              webhookStatus.className = 'text-[11px] text-rose-600 font-semibold mt-1.5';
            }
          }
        } catch (err: any) {
          showToast('Test request failed: ' + err.message, false);
          if (webhookStatus) {
            webhookStatus.textContent = '✖ Request error: ' + err.message;
            webhookStatus.className = 'text-[11px] text-rose-600 font-semibold mt-1.5';
          }
        } finally {
          testBtn.disabled = false;
          testBtn.textContent = 'Test Connection';
        }
      });
    }

    initSettingsPage();
    document.addEventListener('shell:page-load', initSettingsPage);
  </script>
</AdminLayout>
