                  <span class="text-[10px] text-[#86868b] font-mono block mt-0.5">${dateStr}</span>
                </div>
                <div class="shrink-0">
                  ${renderStatusBadge(order.status)}
                </div>
              </div>

              <div class="bg-[#fbfbfd] p-2.5 rounded-xl border border-black/5 text-xs space-y-1">
                <div class="flex items-center justify-between text-[11px] gap-2">
                  <span class="font-medium text-[#1d1d1f] truncate">${safeCompany}</span>
                  <span class="text-[#86868b] shrink-0 font-mono text-[10px]">${safeCountry}</span>
                </div>
                <div class="flex items-center justify-between text-[11px] text-[#86868b] gap-2 font-mono">
