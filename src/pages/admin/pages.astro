                <option value="subtle" ${sec.theme === 'subtle' ? 'selected' : ''}>🔘 浅灰微质感 (Subtle Gray)</option>
                <option value="dark" ${sec.theme === 'dark' ? 'selected' : ''}>⚫ 极夜深黑 (Onyx Black)</option>
                <option value="gradient-dark" ${sec.theme === 'gradient-dark' ? 'selected' : ''}>🌌 极夜冷光微渐变 (Obsidian Gradient)</option>
              </select>
            </div>
          </div>

          <!-- Blocks Stream Builder -->
          <div class="p-3.5 rounded-xl bg-white border border-black/10 space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="block font-bold text-xs text-[#1d1d1f]">🧱 Content Blocks Stream (${blocks.length} blocks)</span>
                <span class="text-[10px] text-[#86868b]">Add headings, media, metrics, button groups or testimonials</span>
              </div>
              <div class="flex items-center gap-2">
                <select class="picker-add-block h-7 px-2 rounded-lg bg-[#f5f5f7] border border-black/10 text-xs" data-idx="${idx}">
                  <option value="">＋ Add Content Block...</option>
                  <option value="headingBlock">✍️ Heading & Text (headingBlock)</option>
                  <option value="mediaBlock">🖼️ Image & Media (mediaBlock)</option>
                  <option value="buttonGroupBlock">🔘 Action Buttons (buttonGroupBlock)</option>
                  <option value="metricGridBlock">📊 Metrics Grid (metricGridBlock)</option>
                  <option value="quoteBlock">💬 Client Quote (quoteBlock)</option>
                </select>
              </div>
            </div>

            <!-- Block Cards -->
            <div class="space-y-2">
              ${blocks.map((b: any, bIdx: number) => `
                <div class="p-3 rounded-xl bg-[#fafafc] border border-black/5 space-y-2">
                  <div class="flex items-center justify-between border-b border-black/5 pb-1.5">
                    <span class="font-bold text-[11px] text-[#1d1d1f]">#${bIdx + 1} ${escapeHtml(b._type || 'block')}</span>
                    <button type="button" class="btn-del-block text-rose-600 text-xs hover:bg-rose-50 px-1.5 py-0.5 rounded" data-sec-idx="${idx}" data-block-idx="${bIdx}">✕ Remove</button>
                  </div>
                  ${b._type === 'headingBlock' ? `
                    <input type="text" class="w-full px-2 py-1 rounded bg-white border border-black/10 text-xs font-bold field-block-headline" data-sec-idx="${idx}" data-block-idx="${bIdx}" placeholder="Headline" value="${escapeHtml(b.headline || '')}" />
                    <textarea rows="2" class="w-full p-2 rounded bg-white border border-black/10 text-xs field-block-subtitle" data-sec-idx="${idx}" data-block-idx="${bIdx}" placeholder="Subtitle / Text">${escapeHtml(b.subtitle || '')}</textarea>
                  ` : b._type === 'mediaBlock' ? `
                    <div class="flex items-center justify-between p-2 rounded bg-white border border-black/10">
                      <div class="flex items-center gap-2">
                        <div class="w-10 h-10 rounded bg-[#f5f5f7] overflow-hidden flex items-center justify-center">
                          ${b.image ? `<img src="${escapeHtml((window as any).resolveSanityRefUrl?.(b.image))}" class="w-full h-full object-cover" />` : `<span class="text-[8px] text-[#86868b]">No Img</span>`}
                        </div>
                        <span class="text-xs font-semibold">Media Image</span>
                      </div>
                      <button type="button" class="btn-choose-block-image px-2.5 py-1 rounded bg-[#1d1d1f] text-white text-xs font-semibold" data-sec-idx="${idx}" data-block-idx="${bIdx}">📁 Choose</button>
                    </div>
                  ` : `
                    <input type="text" class="w-full px-2 py-1 rounded bg-white border border-black/10 text-xs field-block-generic" data-sec-idx="${idx}" data-block-idx="${bIdx}" value="${escapeHtml(b.headline || b.quote || b.badge || '')}" placeholder="Block Content" />
                  `}
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    // Attach Event Listeners to Section Card Elements
    function attachSectionEvents() {
      const container = document.getElementById('sections-container');
      if (!container) return;

      // Collapse / Expand toggle
      container.querySelectorAll('.btn-sec-toggle').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (collapsedSections.has(idx)) {
            collapsedSections.delete(idx);
          } else {
            collapsedSections.add(idx);
          }
          renderSections();
        });
      });

      // Card Header click to toggle
      container.querySelectorAll('.card-header-row').forEach((header) => {
        header.addEventListener('click', (e: any) => {
          if (e.target.closest('button') || e.target.closest('.drag-handle')) return;
          const card = header.closest('.section-card');
          const idx = parseInt(card?.getAttribute('data-idx') || '0', 10);
          if (collapsedSections.has(idx)) {
            collapsedSections.delete(idx);
          } else {
            collapsedSections.add(idx);
          }
          renderSections();
        });
      });

      // Move Up
      container.querySelectorAll('.btn-sec-up').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx > 0) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx - 1, 0, item);
            renderSections();
          }
        });
      });

      // Move Down
      container.querySelectorAll('.btn-sec-down').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (idx < activePageDoc.sections.length - 1) {
            const item = activePageDoc.sections.splice(idx, 1)[0];
            activePageDoc.sections.splice(idx + 1, 0, item);
            renderSections();
          }
        });
      });

      // Duplicate Section
      container.querySelectorAll('.btn-sec-copy').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const cloned = JSON.parse(JSON.stringify(activePageDoc.sections[idx]));
          cloned._key = crypto.randomUUID().slice(0, 8);
          if (cloned.adminLabel) cloned.adminLabel = `${cloned.adminLabel} (Copy)`;
          activePageDoc.sections.splice(idx + 1, 0, cloned);
          renderSections();
          (window as any).__showToast?.('Section duplicated', 'success');
        });
      });

      // Delete Section
      container.querySelectorAll('.btn-sec-del').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          syncSectionsFromDom();
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          activePageDoc.sections.splice(idx, 1);
          renderSections();
        });
      });

      // HTML5 Drag and Drop Reorder
      const cards = container.querySelectorAll('.section-card');
      cards.forEach((card) => {
        const handle = card.querySelector('.drag-handle');
        handle?.addEventListener('mouseenter', () => card.setAttribute('draggable', 'true'));
        handle?.addEventListener('mouseleave', () => card.removeAttribute('draggable'));

        card.addEventListener('dragstart', (e: any) => {
          draggedSectionIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          e.dataTransfer.effectAllowed = 'move';
          card.classList.add('opacity-40');
        });

        card.addEventListener('dragend', () => {
          draggedSectionIdx = null;
          card.classList.remove('opacity-40');
          cards.forEach((c) => c.classList.remove('ring-2', 'ring-black'));
        });

        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer!.dropEffect = 'move';
          card.classList.add('ring-2', 'ring-black');
        });

        card.addEventListener('dragleave', () => {
          card.classList.remove('ring-2', 'ring-black');
        });

        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('ring-2', 'ring-black');
          const targetIdx = parseInt(card.getAttribute('data-idx') || '0', 10);
          if (draggedSectionIdx !== null && draggedSectionIdx !== targetIdx) {
            syncSectionsFromDom();
            const item = activePageDoc.sections.splice(draggedSectionIdx, 1)[0];
            activePageDoc.sections.splice(targetIdx, 0, item);
            renderSections();
          }
        });
      });

      // Section Image Picker (heroImage, macroImage)
      container.querySelectorAll('.btn-sec-choose-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: `Select Image for ${target}`,
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              const asset = assets[0];
              activePageDoc.sections[idx][target] = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: asset._id,
                  url: asset.url,
                },
              };
              renderSections();
              (window as any).__showToast?.('Updated section image', 'success');
            },
          });
        });
      });

      container.querySelectorAll('.btn-sec-clear-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          const target = btn.getAttribute('data-target') || 'heroImage';
          activePageDoc.sections[idx][target] = null;
          renderSections();
        });
      });

      // Product Showcase Picker Add
      container.querySelectorAll('.picker-add-product').forEach((select: any) => {
        select.addEventListener('change', () => {
          const idx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const prodId = select.value;
          if (!prodId) return;
          if (!activePageDoc.sections[idx].products) activePageDoc.sections[idx].products = [];
          activePageDoc.sections[idx].products.push({
            _key: crypto.randomUUID().slice(0, 8),
            _type: 'reference',
            _ref: prodId,
          });
          renderSections();
          (window as any).__showToast?.('Added product to showcase', 'success');
        });
      });

      // Product Showcase Reorder & Delete
      container.querySelectorAll('.btn-prod-up').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          if (pIdx > 0) {
            const item = activePageDoc.sections[sIdx].products.splice(pIdx, 1)[0];
            activePageDoc.sections[sIdx].products.splice(pIdx - 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-down').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          const list = activePageDoc.sections[sIdx].products;
          if (pIdx < list.length - 1) {
            const item = list.splice(pIdx, 1)[0];
            list.splice(pIdx + 1, 0, item);
            renderSections();
          }
        });
      });

      container.querySelectorAll('.btn-prod-del').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const pIdx = parseInt(btn.getAttribute('data-prod-idx') || '0', 10);
          activePageDoc.sections[sIdx].products.splice(pIdx, 1);
          renderSections();
        });
      });

      // Manufacturing Add Capability
      container.querySelectorAll('.btn-add-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-idx') || '0', 10);
          if (!activePageDoc.sections[sIdx].capabilities) activePageDoc.sections[sIdx].capabilities = [];
          activePageDoc.sections[sIdx].capabilities.push({
            _key: crypto.randomUUID().slice(0, 8),
            title: { _type: 'localeString', en: 'New Manufacturing Capability' },
            description: { _type: 'localeText', en: 'High capacity apparel fabrication line.' },
          });
          renderSections();
        });
      });

      // Manufacturing Delete Capability
      container.querySelectorAll('.btn-del-capability').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const cIdx = parseInt(btn.getAttribute('data-cap-idx') || '0', 10);
          activePageDoc.sections[sIdx].capabilities.splice(cIdx, 1);
          renderSections();
        });
      });

      // Custom Section Add Block
      container.querySelectorAll('.picker-add-block').forEach((select: any) => {
        select.addEventListener('change', () => {
          const sIdx = parseInt(select.getAttribute('data-idx') || '0', 10);
          const blockType = select.value;
          if (!blockType) return;
          if (!activePageDoc.sections[sIdx].blocks) activePageDoc.sections[sIdx].blocks = [];

          let newBlock: any = { _key: crypto.randomUUID().slice(0, 8), _type: blockType };
          if (blockType === 'headingBlock') {
            newBlock.headline = 'New Section Heading';
            newBlock.subtitle = 'Supporting paragraph text.';
          }
          activePageDoc.sections[sIdx].blocks.push(newBlock);
          renderSections();
        });
      });

      container.querySelectorAll('.btn-del-block').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          activePageDoc.sections[sIdx].blocks.splice(bIdx, 1);
          renderSections();
        });
      });

      // Custom Section Choose MediaBlock Image
      container.querySelectorAll('.btn-choose-block-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sIdx = parseInt(btn.getAttribute('data-sec-idx') || '0', 10);
          const bIdx = parseInt(btn.getAttribute('data-block-idx') || '0', 10);
          (window as any).__openMediaLibrary?.({
            mode: 'single',
            title: 'Select Media Block Image',
            onSelect: (assets: any[]) => {
              if (!assets || assets.length === 0) return;
              activePageDoc.sections[sIdx].blocks[bIdx].image = {
                _type: 'image',
                asset: {
                  _type: 'reference',
                  _ref: assets[0]._id,
                  url: assets[0].url,
                },
              };
              renderSections();
            },
          });
        });
      });
    }

    // Read Form Values from DOM back into activePageDoc.sections
    function syncSectionsFromDom() {
      if (!activePageDoc || !activePageDoc.sections) return;
      const cards = document.querySelectorAll('.section-card');

      cards.forEach((card, idx) => {
        const sec = activePageDoc.sections[idx];
        if (!sec) return;

        // Common Admin Label
        const adminLabelInput = card.querySelector('.field-admin-label') as HTMLInputElement | null;
        if (adminLabelInput) sec.adminLabel = adminLabelInput.value.trim();

        // Type specific synchronization
        switch (sec._type) {
          case 'heroSection': {
            const superInput = card.querySelector('.field-super-title') as HTMLInputElement | null;
            const headlineInput = card.querySelector('.field-headline') as HTMLInputElement | null;
            const sublineInput = card.querySelector('.field-subline') as HTMLTextAreaElement | null;
            if (superInput && superInput.value.trim()) sec.superTitle = setLocaleVal(sec.superTitle, superInput.value.trim());
            if (headlineInput && headlineInput.value.trim()) sec.headline = setLocaleVal(sec.headline, headlineInput.value.trim());
            if (sublineInput && sublineInput.value.trim()) sec.subline = setLocaleVal(sec.subline, sublineInput.value.trim());

            sec.showPrimaryButton = (card.querySelector('.field-primary-btn-show') as HTMLInputElement)?.checked;
            const pBtnText = (card.querySelector('.field-primary-btn-text') as HTMLInputElement)?.value.trim();
            if (pBtnText) sec.primaryButtonText = setLocaleVal(sec.primaryButtonText, pBtnText);
            sec.primaryButtonUrl = (card.querySelector('.field-primary-btn-url') as HTMLInputElement)?.value.trim();
            sec.swatchSku = (card.querySelector('.field-primary-btn-sku') as HTMLInputElement)?.value.trim();

            sec.showSecondaryButton = (card.querySelector('.field-secondary-btn-show') as HTMLInputElement)?.checked;
            const sBtnText = (card.querySelector('.field-secondary-btn-text') as HTMLInputElement)?.value.trim();
            if (sBtnText) sec.secondaryButtonText = setLocaleVal(sec.secondaryButtonText, sBtnText);
            sec.secondaryButtonUrl = (card.querySelector('.field-secondary-btn-url') as HTMLInputElement)?.value.trim();
            break;
          }

          case 'productShowcaseSection': {
            const badgeInput = card.querySelector('.field-badge') as HTMLInputElement | null;
            const titleInput = card.querySelector('.field-title') as HTMLInputElement | null;
            const subInput = card.querySelector('.field-subtitle') as HTMLTextAreaElement | null;
            if (badgeInput && badgeInput.value.trim()) sec.badge = setLocaleVal(sec.badge, badgeInput.value.trim());
            if (titleInput && titleInput.value.trim()) sec.title = setLocaleVal(sec.title, titleInput.value.trim());
            if (subInput && subInput.value.trim()) sec.subtitle = setLocaleVal(sec.subtitle, subInput.value.trim());
            break;
          }

          case 'featureMatrixSection': {
            const badgeInput = card.querySelector('.field-badge') as HTMLInputElement | null;
            const titleInput = card.querySelector('.field-title') as HTMLInputElement | null;
            const descInput = card.querySelector('.field-description') as HTMLTextAreaElement | null;
            if (badgeInput && badgeInput.value.trim()) sec.badge = setLocaleVal(sec.badge, badgeInput.value.trim());
            if (titleInput && titleInput.value.trim()) sec.title = setLocaleVal(sec.title, titleInput.value.trim());
            if (descInput && descInput.value.trim()) sec.description = setLocaleVal(sec.description, descInput.value.trim());

            const b1Tag = (card.querySelector('.field-bento1-tag') as HTMLInputElement)?.value.trim();
            const b1Title = (card.querySelector('.field-bento1-title') as HTMLInputElement)?.value.trim();
            const b1Desc = (card.querySelector('.field-bento1-desc') as HTMLTextAreaElement)?.value.trim();
            if (b1Tag) sec.bento1Tag = setLocaleVal(sec.bento1Tag, b1Tag);
            if (b1Title) sec.bento1Title = setLocaleVal(sec.bento1Title, b1Title);
            if (b1Desc) sec.bento1Description = setLocaleVal(sec.bento1Description, b1Desc);

            const b2Title = (card.querySelector('.field-bento2-title') as HTMLInputElement)?.value.trim();
            const b2Desc = (card.querySelector('.field-bento2-desc') as HTMLTextAreaElement)?.value.trim();
            if (b2Title) sec.bento2Title = setLocaleVal(sec.bento2Title, b2Title);
            if (b2Desc) sec.bento2Description = setLocaleVal(sec.bento2Description, b2Desc);

            const b3Title = (card.querySelector('.field-bento3-title') as HTMLInputElement)?.value.trim();
            const b3Desc = (card.querySelector('.field-bento3-desc') as HTMLTextAreaElement)?.value.trim();
            if (b3Title) sec.bento3Title = setLocaleVal(sec.bento3Title, b3Title);
            if (b3Desc) sec.bento3Description = setLocaleVal(sec.bento3Description, b3Desc);

            const b4Title = (card.querySelector('.field-bento4-title') as HTMLInputElement)?.value.trim();
            const b4Desc = (card.querySelector('.field-bento4-desc') as HTMLTextAreaElement)?.value.trim();
            if (b4Title) sec.bento4Title = setLocaleVal(sec.bento4Title, b4Title);
            if (b4Desc) sec.bento4Description = setLocaleVal(sec.bento4Description, b4Desc);

            const b5Title = (card.querySelector('.field-bento5-title') as HTMLInputElement)?.value.trim();
            const b5Desc = (card.querySelector('.field-bento5-desc') as HTMLTextAreaElement)?.value.trim();
            if (b5Title) sec.bento5Title = setLocaleVal(sec.bento5Title, b5Title);
            if (b5Desc) sec.bento5Description = setLocaleVal(sec.bento5Description, b5Desc);
            break;
          }

          case 'manufacturingSection': {
            const headlineInput = card.querySelector('.field-headline') as HTMLInputElement | null;
            const sublineInput = card.querySelector('.field-subline') as HTMLTextAreaElement | null;
            if (headlineInput && headlineInput.value.trim()) sec.headline = setLocaleVal(sec.headline, headlineInput.value.trim());
            if (sublineInput && sublineInput.value.trim()) sec.subline = setLocaleVal(sec.subline, sublineInput.value.trim());

            // Capabilities items
            if (sec.capabilities) {
              sec.capabilities.forEach((cap: any, cIdx: number) => {
                const cTitle = (card.querySelector(`.field-cap-title[data-cap-idx="${cIdx}"]`) as HTMLInputElement)?.value.trim();
                const cDesc = (card.querySelector(`.field-cap-desc[data-cap-idx="${cIdx}"]`) as HTMLTextAreaElement)?.value.trim();
                if (cTitle) cap.title = setLocaleVal(cap.title, cTitle);
                if (cDesc) cap.description = setLocaleVal(cap.description, cDesc);
              });
            }
            break;
          }

          case 'inquirySection': {
            const headlineInput = card.querySelector('.field-headline') as HTMLInputElement | null;
            const sublineInput = card.querySelector('.field-subline') as HTMLTextAreaElement | null;
            const catsInput = card.querySelector('.field-inquiry-cats') as HTMLInputElement | null;
            if (headlineInput && headlineInput.value.trim()) sec.headline = setLocaleVal(sec.headline, headlineInput.value.trim());
            if (sublineInput && sublineInput.value.trim()) sec.subline = setLocaleVal(sec.subline, sublineInput.value.trim());
            if (catsInput) {
              sec.categories = catsInput.value.split(',').map((c) => c.trim()).filter(Boolean);
            }
            break;
          }

          case 'customSection': {
            const presetSelect = card.querySelector('.field-preset') as HTMLSelectElement | null;
            const themeSelect = card.querySelector('.field-theme') as HTMLSelectElement | null;
            if (presetSelect) sec.preset = presetSelect.value;
            if (themeSelect) sec.theme = themeSelect.value;

            if (sec.blocks) {
              sec.blocks.forEach((b: any, bIdx: number) => {
                if (b._type === 'headingBlock') {
                  const hVal = (card.querySelector(`.field-block-headline[data-block-idx="${bIdx}"]`) as HTMLInputElement)?.value;
                  const sVal = (card.querySelector(`.field-block-subtitle[data-block-idx="${bIdx}"]`) as HTMLTextAreaElement)?.value;
                  if (hVal !== undefined) b.headline = hVal;
                  if (sVal !== undefined) b.subtitle = sVal;
                }
              });
            }
            break;
          }
        }
      });
    }

    // Save & Publish Page to Sanity CMS
    document.getElementById('btn-save-page')?.addEventListener('click', async () => {
      if (!activePageDoc) {
        (window as any).__showToast?.('No page loaded', 'error');
        return;
      }

      syncMetaFromDom();
      syncSectionsFromDom();

      (window as any).__showToast?.('Saving page & synchronizing KV/Edge cache...', 'info');

      try {
        const payload = { document: activePageDoc };
        const res = await fetch('/api/admin/cms/pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save page');

        (window as any).__showToast?.('Page saved & published successfully!', 'success');
        loadPages();
      } catch (e: any) {
        (window as any).__showToast?.(e.message, 'error');
      }
    });

    // Create New Page
    document.getElementById('btn-create-page')?.addEventListener('click', () => {
      const titlePrompt = prompt('Enter new page title:');
      if (!titlePrompt || !titlePrompt.trim()) return;

      const slugPrompt = prompt('Enter URL slug (e.g. /custom-line or custom-line):', titlePrompt.toLowerCase().replace(/\s+/g, '-'));
      if (!slugPrompt) return;

      const cleanSlug = slugPrompt.startsWith('/') ? slugPrompt : `/${slugPrompt}`;

      activePageDoc = {
        _type: 'page',
        title: { _type: 'localeString', en: titlePrompt.trim() },
        slug: { _type: 'slug', current: cleanSlug },
        metaTitle: { _type: 'localeString', en: `${titlePrompt.trim()} | Gwen & Venni Luxury Apparel` },
        metaDescription: { _type: 'localeText', en: 'B2B Wholesale & Luxury Apparel Manufacturing' },
        addTitleSuffix: true,
        sections: [getSectionInitialValues('heroSection')],
      };

      currentPages.push(activePageDoc);
      renderPagesList();
      populateMetaInputs();
      renderSocialImagePreview();
      renderSections();
      (window as any).__showToast?.('Created draft page. Click Save to publish.', 'info');
    });

    // Initialize
    loadCatalogProducts();
    loadPages();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagesWorkbench);
  } else {
    initPagesWorkbench();
