---
// src/pages/admin/cache.astro
// Edge & KV Cache Manager: Per-URL L1/L2/L3 Stats, Cache Strategy Policy & Granular Purge
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext } from '@utils/auth';
import '@data/products';
import '@data/page';
import '@data/siteConfig';
import '@data/rfqSettings';
import { getSystemSettings } from '@db';
import '@utils/dicts';
import { getGlobalCacheStatsSnapshot } from '@utils/cache';
import { getRouteRevisions } from '@utils/cmsSync';
import { toIsoUtcString, formatUtcFallback } from '@utils/format';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/cache',
  { requiredMenu: 'cache' }
);
if (redirectResponse) return redirectResponse;

const canPurge = Boolean(adminContext?.isRootAdmin || adminContext?.permissions?.includes('*') || adminContext?.permissions?.includes('cache:purge'));
const [statsSnapshot, routeRevisions, sysSettings] = await Promise.all([
  Promise.resolve(getGlobalCacheStatsSnapshot()),
  getRouteRevisions(cfEnv).catch(() => ({} as Record<string, number>)),
  getSystemSettings(cfEnv).catch(() => null),
]);
const revEntries = Object.entries(routeRevisions).filter(([, ts]) => typeof ts === 'number').sort(([a], [b]) => a.localeCompare(b));
const urlStats = statsSnapshot.urlStats || [];
const urlStatsEnabled = sysSettings?.enable_url_cache_stats ?? true;

const policyFields = [
  {
    key: 'edge_html_cache_ttl_sec',
    label: 'L0 Edge HTML 页面缓存时长 (秒)',
    value: sysSettings?.edge_html_cache_ttl_sec ?? 300,
    min: 0,
    max: 86400,
    step: 30,
    hint: '正常 200 HTML 在边缘 caches.default & CDN 的缓存时长，默认 300 秒（0 关闭）。',
  },
  {
    key: 'l1_heartbeat_interval_sec',
    label: '跨节点 L1 版本心跳间隔 (秒)',
    value: sysSettings?.l1_heartbeat_interval_sec ?? 30,
    min: 0,
    max: 3600,
    step: 5,
    hint: '默认 30 秒，范围 5~3600（设 0 表示仅手动 Purge，不轮询）。',
  },
  {
    key: 'user_status_cache_ttl_sec',
    label: '用户账号状态 L1 缓存 (秒)',
    value: sysSettings?.user_status_cache_ttl_sec ?? 30,
    min: 5,
    max: 600,
    step: 5,
    hint: '控制用户封禁/等级状态在 L1 内存的保留时长，默认 30 秒（5~600）。',
  },
  {
    key: 'admin_order_stats_ttl_sec',
    label: '后台订单角标与统计 L1 缓存 (秒)',
    value: sysSettings?.admin_order_stats_ttl_sec ?? 30,
    min: 5,
    max: 300,
    step: 5,
    hint: '控制侧边栏待审角标与仪表盘统计 L1 缓存时长，默认 30 秒（5~300）。',
  },
  {
    key: 'l1_negative_cache_ttl_sec',
    label: '动态路由 L1 负缓存时长 (秒)',
    value: sysSettings?.l1_negative_cache_ttl_sec ?? 60,
    min: 10,
    max: 600,
    step: 10,
    hint: '不存在的商品/页面在 L1 记忆 404 的时长，默认 60 秒（10~600）。',
  },
  {
    key: 'edge_404_cache_ttl_sec',
    label: 'Edge 404 页面缓存时长 (秒)',
    value: sysSettings?.edge_404_cache_ttl_sec ?? 300,
    min: 0,
    max: 86400,
    step: 30,
    hint: '404 HTML 在边缘 caches.default 的缓存时长，默认 300 秒（0 关闭）。',
  },
  {
    key: 'waf_legacy_404_ttl_sec',
    label: '废弃路径 WAF 404 缓存 (秒)',
    value: sysSettings?.waf_legacy_404_ttl_sec ?? 3600,
    min: 0,
    max: 86400,
    step: 60,
    hint: 'WAF 拦截废弃路径（如 /product-tag/*）的 CDN 缓存时长，默认 3600 秒。',
  },
];

const QUICK_PARTITIONS: Array<{ scope: string; icon: string; title: string; desc: string; primary?: boolean }> = [
  { scope: 'all', icon: '⚡', title: 'Purge Everything', desc: 'Clears all CMS products, pages, dictionaries, settings, WAF & edge HTML routes.', primary: true },
  { scope: 'products', icon: '🛍️', title: 'Products & Catalog', desc: 'Clears product lists, category trees, and individual product details.' },
  { scope: 'pages', icon: '📄', title: 'Pages & Builder', desc: 'Clears Homepage, about, contact, and section builder caches.' },
  { scope: 'dicts', icon: '🏷️', title: 'Data Dictionaries', desc: 'Re-aggregates sys:dicts:all & dict groups into Edge KV.' },
  { scope: 'waf', icon: '🛡️', title: 'WAF & Security Rules', desc: 'Recompiles WAF rules & IP ACL into Edge KV.' },
  { scope: 'settings', icon: '⚙️', title: 'Settings & Config', desc: 'Refreshes system settings, SiteConfig & RFQ Settings.' },
  { scope: 'rbac', icon: '🔐', title: 'RBAC & Team Roles', desc: 'Clears admin roles, members & permission L1 caches.' },
  { scope: 'orders', icon: '📦', title: 'Orders, Users & Logs', desc: 'Clears pending orders badge, dashboard stats & log caches.' },
];

const QUICK_PATHS = ['/', '/products', '/about', '/contact', '/private-label'];
const pageTitle = 'Edge & KV Cache Console';
---

<AdminLayout
  title={pageTitle}
  currentTab="cache"
  sessionEmail={sessionUser?.email || ''}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
  fullscreenWorkbench={true}
>
  <div id="cache-workbench-root" data-can-purge={canPurge ? '1' : '0'} class="flex-1 flex flex-col min-h-0 min-w-0 h-full overflow-hidden space-y-3">
    <AdminPageToolbar
      title="Edge & KV Cache Manager"
      subtitle="Per-URL L1/L2/L3 hit statistics, cache duration & sync policy, and route invalidation"
    >
      <div slot="actions" class="flex items-center gap-2">
        <button id="cache-refresh-stats-btn" type="button" class="adm-btn-secondary text-xs py-1.5 px-3">
          Refresh Stats
        </button>
        {canPurge && (
          <button id="cache-reset-stats-btn" type="button" class="adm-btn-secondary text-xs py-1.5 px-3">
            Reset Counters
          </button>
        )}
      </div>
    </AdminPageToolbar>

    <div class="flex-1 min-h-0 overflow-y-auto space-y-4 pr-0.5 text-xs">
      <!-- 1. Per-URL L1 / L2 / L3 Trigger Statistics -->
      <section class="adm-card overflow-hidden">
        <div class="px-4 py-3 border-b border-black/5 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-xs sm:text-sm font-bold text-[#1d1d1f]">URL 访问 L1 / L2 / L3 触发统计</h2>
            <p class="text-[11px] text-[#86868b]">统计当前 Isolate 内同一 URL 每次访问累计触发的 L1（内存）、L2（KV）、L3（源站/DB）次数。</p>
          </div>
          <div class="flex items-center gap-2">
            <span id="url-stats-status-badge" class:list={['adm-badge', urlStatsEnabled ? 'adm-badge-ok' : 'adm-badge-neutral']}>
              {urlStatsEnabled ? '统计已启用' : '统计已关闭'}
            </span>
            <span id="url-stats-count" class="adm-badge adm-badge-neutral">{urlStats.length} URLs</span>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead class="bg-[#fafafc] border-b border-black/5 text-[10px] font-bold uppercase tracking-wider text-[#86868b]">
              <tr>
                <th class="px-4 py-2.5">URL Path</th>
                <th class="px-3 py-2.5 text-right">Requests</th>
                <th class="px-3 py-2.5 text-right text-emerald-700">L1 Triggers</th>
                <th class="px-3 py-2.5 text-right text-sky-700">L2 Triggers</th>
                <th class="px-3 py-2.5 text-right text-amber-700">L3 Triggers</th>
                <th class="px-4 py-2.5 text-right">Last Seen</th>
              </tr>
            </thead>
            <tbody id="url-stats-tbody" class="divide-y divide-black/5 text-[11px]">
              {urlStats.length === 0 ? (
                <tr>
                  <td colspan="6" class="px-4 py-6 text-center text-[#86868b]">
                    暂无 URL 访问统计，访问前台或后台页面后点击 Refresh Stats 查看。
                  </td>
                </tr>
              ) : (
                urlStats.map((u) => {
                  const iso = u.lastAt ? toIsoUtcString(new Date(u.lastAt).toISOString()) : '';
                  const fb = u.lastAt ? formatUtcFallback(new Date(u.lastAt).toISOString()) : '';
                  return (
                    <tr class="hover:bg-[#fafafc] transition-colors">
                      <td class="px-4 py-2 font-mono font-semibold text-[#1d1d1f]">{u.url}</td>
                      <td class="px-3 py-2 font-mono text-right text-[#1d1d1f]">{u.requests}</td>
                      <td class="px-3 py-2 font-mono text-right font-semibold text-emerald-700">{u.l1Triggers}</td>
                      <td class="px-3 py-2 font-mono text-right font-semibold text-sky-700">{u.l2Triggers}</td>
                      <td class="px-3 py-2 font-mono text-right font-semibold text-amber-700">{u.l3Triggers}</td>
                      <td class="px-4 py-2 font-mono text-right text-[#86868b] whitespace-nowrap">
                        {iso ? <time data-admin-time={iso} data-admin-time-mode="short" title={fb}>{fb}</time> : '—'}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 2. Cache Duration & Sync Policy -->
      <section class="adm-card p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-black/5 pb-3">
          <div>
            <h2 class="text-xs sm:text-sm font-bold text-[#1d1d1f]">缓存时长与同步策略</h2>
            <p class="text-[11px] text-[#86868b]">统一管理跨节点 L1 心跳间隔、D1 状态缓存时长、负缓存及边缘 404 缓存时长（CMS 内容与配置保持永不过期 + 写穿透同步）。</p>
          </div>
          {canPurge && (
            <button id="save-cache-policy-btn" type="button" class="adm-btn h-auto px-4 py-1.5 text-xs">
              保存策略
            </button>
          )}
        </div>

        <form id="cache-policy-form" class="space-y-3">
          <label class="flex items-start gap-3 p-3 rounded-xl bg-[#f5f5f7] border border-black/5 cursor-pointer">
            <input
              type="checkbox"
              name="enable_url_cache_stats"
              checked={urlStatsEnabled}
              disabled={!canPurge}
              class="w-4 h-4 rounded text-black focus:ring-black accent-[#1d1d1f] mt-0.5 shrink-0"
            />
            <div>
              <span class="block text-xs font-bold text-[#1d1d1f]">启用 URL 访问 L1 / L2 / L3 触发统计</span>
              <span class="block text-[10px] text-[#86868b] mt-0.5">开启后会在每个非静态请求结束时按 URL 累加 L1/L2/L3 触发次数；关闭后跳过统计写入（0 内存开销）。</span>
            </div>
          </label>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            {policyFields.map((f) => (
              <label class="block p-3 rounded-xl bg-[#f5f5f7] border border-black/5 space-y-1.5">
                <span class="block text-xs font-bold text-[#1d1d1f]">{f.label}</span>
                <input
                  type="number"
                  name={f.key}
                  value={f.value}
                  min={f.min}
                  max={f.max}
                  step={f.step}
                  disabled={!canPurge}
                  class="w-full px-3 py-1.5 text-xs rounded-lg bg-white border border-black/10 font-mono font-bold text-[#1d1d1f] focus:outline-none focus:border-black"
                />
                <span class="block text-[10px] text-[#86868b] leading-snug">{f.hint}</span>
              </label>
            ))}
          </div>
        </form>
      </section>

      <!-- 3. Targeted Path Purge & Active Route Revisions -->
      <section class="adm-card p-4 space-y-3">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
          <div class="lg:col-span-6 space-y-2.5">
            <div>
              <h3 class="font-bold text-xs text-[#1d1d1f]">Targeted URL Path Invalidation</h3>
              <p class="text-[11px] text-[#86868b]">Purge a specific product or page URL, bump its revision key, and clear Edge HTML + CDN cache.</p>
            </div>
            <form id="path-purge-form" class="flex items-center gap-2">
              <input
                type="text"
                id="target-path-input"
                placeholder="e.g. /products/silk-merino-crew-socks or /about"
                class="adm-input flex-1 font-mono text-xs py-1.5"
                required
              />
              <button type="submit" class="adm-btn h-auto px-4 py-1.5 shrink-0" disabled={!canPurge}>
                Purge Path
              </button>
            </form>
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="text-[10px] text-[#86868b]">Quick paths:</span>
              {QUICK_PATHS.map((qp) => (
                <button
                  type="button"
                  data-quick-path={qp}
                  class="btn-quick-path px-2 py-0.5 rounded-md bg-[#f5f5f7] hover:bg-black/10 border border-black/8 font-mono text-[10px] text-[#1d1d1f] cursor-pointer"
                >
                  {qp}
                </button>
              ))}
            </div>
          </div>

          <div class="lg:col-span-6 space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-xs text-[#1d1d1f]">Active Route Revisions (<code class="font-mono text-[10px]">cms:route_revs</code>)</h3>
              <span id="route-revisions-count" class="adm-badge adm-badge-neutral">{revEntries.length} routes</span>
            </div>
            <div id="route-revisions-list" class="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto p-2.5 rounded-xl bg-[#fafafc] border border-black/8">
              {revEntries.length === 0 ? (
                <span class="text-[11px] text-[#86868b]">No route revisions bumped yet (using baseline v0).</span>
              ) : (
                revEntries.map(([routePath, rev]) => (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-black/10 font-mono text-[10px]">
                    <span class="text-[#1d1d1f]">{routePath}</span>
                    <span class="text-emerald-700 font-bold">v{rev}</span>
                  </span>
                ))
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Quick Partition Purge -->
      <section class="space-y-3">
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-[#1d1d1f]">One-Click Cache Invalidation Partitions</h2>
          <p class="text-[11px] text-[#86868b]">Select a domain scope to batch-refresh L1 memory and Cloudflare Edge KV</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {QUICK_PARTITIONS.map((card) => (
            <div class="p-3.5 rounded-2xl border border-black/10 bg-white hover:border-black/20 transition-all flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-base">{card.icon}</span>
                  <span class="font-bold text-xs text-[#1d1d1f]">{card.title}</span>
                </div>
                <p class="text-[11px] text-[#86868b] leading-relaxed">{card.desc}</p>
              </div>
              <button
                type="button"
                class:list={[
                  'btn-purge w-full h-auto py-1.5',
                  card.primary ? 'adm-btn' : 'adm-btn-secondary bg-[#fafafc] border-black/10 hover:border-black',
                ]}
                data-scope={card.scope}
                disabled={!canPurge}
              >
                {card.primary ? 'Purge All Caches' : `Purge ${card.scope}`}
              </button>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</AdminLayout>

<script>
  import { escapeHtml, formatAdminTime } from '@utils/adminWorkbench';

  let cacheAbort: AbortController | null = null;

  function renderUrlStats(snapshot: any, routeRevisions?: Record<string, number>) {
    const urlStats = Array.isArray(snapshot?.urlStats) ? snapshot.urlStats : [];
    const countEl = document.getElementById('url-stats-count');
    if (countEl) countEl.textContent = `${urlStats.length} URLs`;

    const tbody = document.getElementById('url-stats-tbody');
    if (tbody) {
      if (urlStats.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-6 text-center text-[#86868b]">暂无 URL 访问统计，访问前台或后台页面后点击 Refresh Stats 查看。</td></tr>`;
      } else {
        tbody.innerHTML = urlStats.map((u: any) => {
          const lastText = u.lastAt ? formatAdminTime(new Date(u.lastAt).toISOString(), 'short') : '—';
          return `
            <tr class="hover:bg-[#fafafc] transition-colors">
              <td class="px-4 py-2 font-mono font-semibold text-[#1d1d1f]">${escapeHtml(String(u.url || '/'))}</td>
              <td class="px-3 py-2 font-mono text-right text-[#1d1d1f]">${Number(u.requests || 0)}</td>
              <td class="px-3 py-2 font-mono text-right font-semibold text-emerald-700">${Number(u.l1Triggers || 0)}</td>
              <td class="px-3 py-2 font-mono text-right font-semibold text-sky-700">${Number(u.l2Triggers || 0)}</td>
              <td class="px-3 py-2 font-mono text-right font-semibold text-amber-700">${Number(u.l3Triggers || 0)}</td>
              <td class="px-4 py-2 font-mono text-right text-[#86868b] whitespace-nowrap">${escapeHtml(lastText)}</td>
            </tr>
          `;
        }).join('');
      }
    }

    if (routeRevisions && typeof routeRevisions === 'object') {
      const entries = Object.entries(routeRevisions).filter(([, ts]) => typeof ts === 'number').sort(([a], [b]) => a.localeCompare(b));
      const revCount = document.getElementById('route-revisions-count');
      if (revCount) revCount.textContent = `${entries.length} routes`;
      const revList = document.getElementById('route-revisions-list');
      if (revList) {
        revList.innerHTML = entries.length === 0
          ? `<span class="text-[11px] text-[#86868b]">No route revisions bumped yet (using baseline v0).</span>`
          : entries.map(([rp, rv]) => `
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-black/10 font-mono text-[10px]">
                <span class="text-[#1d1d1f]">${escapeHtml(rp)}</span>
                <span class="text-emerald-700 font-bold">v${Number(rv || 0)}</span>
              </span>
            `).join('');
      }
    }
  }

  async function refreshStats() {
    try {
      const res = await fetch('/api/admin/cache/purge');
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to load cache stats');
      renderUrlStats(data.statsSnapshot, data.routeRevisions);
      (window as any).__showToast?.('Refreshed URL cache stats.', 'success');
    } catch (err: any) {
      (window as any).__showToast?.(err.message, 'error');
    }
  }

  async function executePurge(payload: { scope: string; path?: string; updates?: Record<string, number | boolean> }) {
    try {
      const res = await fetch('/api/admin/cache/purge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Cache action failed');
      if (data.statsSnapshot) {
        renderUrlStats(data.statsSnapshot, data.routeRevisions);
      }
      if (data.cachePolicy && typeof data.cachePolicy.enable_url_cache_stats === 'boolean') {
        const badge = document.getElementById('url-stats-status-badge');
        if (badge) {
          badge.className = `adm-badge ${data.cachePolicy.enable_url_cache_stats ? 'adm-badge-ok' : 'adm-badge-neutral'}`;
          badge.textContent = data.cachePolicy.enable_url_cache_stats ? '统计已启用' : '统计已关闭';
        }
      }
      (window as any).__showToast?.(data.message, 'success');
    } catch (err: any) {
      (window as any).__showToast?.(err.message, 'error');
    }
  }

  function initCachePage() {
    const root = document.getElementById('cache-workbench-root');
    if (!root) return;

    cacheAbort?.abort();
    cacheAbort = new AbortController();
    const { signal } = cacheAbort;

    document.getElementById('cache-refresh-stats-btn')?.addEventListener('click', refreshStats, { signal });
    document.getElementById('cache-reset-stats-btn')?.addEventListener('click', () => executePurge({ scope: 'reset_stats' }), { signal });

    document.getElementById('save-cache-policy-btn')?.addEventListener('click', () => {
      const form = document.getElementById('cache-policy-form') as HTMLFormElement | null;
      if (!form) return;
      const updates: Record<string, number | boolean> = {};
      form.querySelectorAll<HTMLInputElement>('input[name]').forEach((input) => {
        updates[input.name] = input.type === 'checkbox' ? input.checked : parseInt(input.value, 10);
      });
      void executePurge({ scope: 'save_policy', updates });
    }, { signal });

    document.querySelectorAll('.btn-purge').forEach((btn) => {
      btn.addEventListener('click', () => {
        const scope = btn.getAttribute('data-scope') || 'all';
        void executePurge({ scope });
      }, { signal });
    });

    const pathInput = document.getElementById('target-path-input') as HTMLInputElement | null;
    document.querySelectorAll('.btn-quick-path').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (pathInput) {
          pathInput.value = btn.getAttribute('data-quick-path') || '/';
          pathInput.focus();
        }
      }, { signal });
    });

    document.getElementById('path-purge-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const path = pathInput?.value.trim();
      if (path) void executePurge({ scope: 'path', path });
    }, { signal });
  }

  initCachePage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('cache-workbench-root')) {
      initCachePage();
    }
  });
</script>
