              <div id="detail-m-${safeId}" class="${isMobileExpanded ? '' : 'hidden '}pt-2 border-t border-black/5 space-y-2.5">
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between text-[11px] font-semibold text-[#1d1d1f]">
                    <span>Ordered Styles</span>
                    <span class="font-mono text-[#86868b]">${totalQty} pcs total</span>
                  </div>
                  <div class="divide-y divide-black/5 bg-[#fbfbfd] rounded-xl border border-black/5 p-2.5">
                    ${renderOrderItems(order.items, true)}
                  </div>
                </div>

                <div class="bg-[#fbfbfd] rounded-xl border border-black/5 p-2.5 text-[11px] space-y-1.5">
                  ${order.contact_name ? `<div class="flex items-center justify-between"><span class="text-[#86868b]">Contact:</span><span class="font-medium text-[#1d1d1f]">${escapeHtml(order.contact_name)}</span></div>` : ''}
                  ${order.whatsapp ? `<div class="flex items-center justify-between"><span class="text-[#86868b]">WhatsApp:</span><a href="https://wa.me/${String(order.whatsapp).replace(/[^0-9]/g, '')}" target="_blank" rel="noopener noreferrer" class="font-mono text-emerald-700 hover:underline">${escapeHtml(order.whatsapp)}</a></div>` : ''}
                  ${order.customer_notes ? `<div class="pt-1 border-t border-black/5 text-[#52525b] italic">"${escapeHtml(order.customer_notes)}"</div>` : ''}
                  ${order.admin_remark ? `<div class="pt-1 border-t border-black/5 text-rose-700">Remark: ${escapeHtml(order.admin_remark)}</div>` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;

    // 2. Desktop Table Layout (>= md)
    const visibleCols = tableSettings.getVisibleColumns();
    const isCompact = tableSettings.getDensity() === 'compact';
    const cellPad = isCompact ? 'py-1.5 px-3' : 'py-3.5 px-4';

    const desktopRowsHtml = orders.map((order) => {
      const safeId = escapeHtml(order.id);
      const safeNo = escapeHtml(order.order_no);
      const safeEmail = escapeHtml(order.buyer_email || '');
      const safeCompany = escapeHtml(order.company_name || order.contact_name || 'Independent Buyer');
      const safeCountry = escapeHtml(order.destination_country || 'Unspecified');
      const dateStr = formatAdminTime(order.created_at, 'full');
      const totalQty = Number(order.total_quantity || 0);
      const totalStyles = Number(order.total_styles || 0);
      const itemCount = order.items?.length || 0;
      const isDesktopExpanded = expandedDesktopIds.has(`detail-${safeId}`);

      const cells = visibleCols.map((col) => {
        switch (col.id) {
          case 'order_no':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} font-mono">
                <span class="font-semibold text-[#1d1d1f] block">${safeNo}</span>
                <span class="text-[11px] text-[#86868b] block">${dateStr}</span>
              </td>
            `;
          case 'buyer':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">
                <span class="font-medium text-[#1d1d1f] block truncate max-w-[180px]">${safeCompany}</span>
                <a href="/admin/users?search=${encodeURIComponent(order.buyer_email || '')}" class="text-[11px] text-[#86868b] hover:text-blue-600 hover:underline font-mono block truncate max-w-[180px] transition-colors" title="View customer profile">
                  ${safeEmail}
                </a>
              </td>
            `;
          case 'destination':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-[#52525b]">${safeCountry}</td>
            `;
          case 'qty':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-right font-mono tabular-nums">
                <span class="font-semibold text-[#1d1d1f]">${totalQty} pcs</span>
                <span class="text-[11px] text-[#86868b] block">${totalStyles} style(s)</span>
              </td>
            `;
          case 'status':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad}">${renderStatusBadge(order.status)}</td>
            `;
          case 'action':
            return `
              <td style="width: ${col.defaultWidth}px;" class="${cellPad} text-right">
                <div class="flex items-center justify-end gap-1.5 flex-wrap">
                  <button
                    type="button"
                    class="action-toggle-detail-btn h-8 px-2.5 rounded-lg text-xs font-medium text-[#1d1d1f] bg-white hover:bg-[#f5f5f7] border border-black/10 hover:border-black/30 shadow-2xs inline-flex items-center gap-1 transition-all cursor-pointer active:scale-95"
                    data-target="detail-${safeId}"
                    title="Toggle line items and customer details"
                  >
                    <span>Details</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron-icon" style="${isDesktopExpanded ? 'transform: rotate(180deg);' : ''}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  ${renderActionButtons(order, false)}
                </div>
              </td>
            `;
          default:
            return `<td></td>`;
        }
      }).join('');

      return `
        <tr class="hover:bg-[#fbfbfd] transition-colors">${cells}</tr>
        <tr id="detail-${safeId}" class="order-detail-row ${isDesktopExpanded ? '' : 'hidden '}bg-[#fafafa] border-b border-black/5">
          <td colspan="${visibleCols.length}" class="p-4 sm:p-6">
            <div class="space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-black/5 gap-2">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-semibold text-[#1d1d1f]">Order Breakdown:</span>
                  <span class="font-mono text-xs font-bold text-[#1d1d1f] bg-white px-2 py-0.5 rounded border border-black/5">${safeNo}</span>
                  <span class="text-[11px] text-[#86868b]">Type: <strong class="capitalize text-[#1d1d1f]">${escapeHtml(order.inquiry_type || 'Quote Cart')}</strong></span>
                </div>
                <div class="text-[11px] text-[#86868b] flex items-center gap-3">
                  <span>Submitted: <strong class="text-[#1d1d1f] font-mono font-semibold">${dateStr}</strong></span>
                  ${order.claimed_at ? `<span>· Claimed: <strong class="text-emerald-700 font-mono font-semibold">${formatAdminTime(order.claimed_at, 'full')}</strong></span>` : ''}
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <div class="lg:col-span-2 bg-white rounded-xl border border-black/5 p-4 space-y-3">
                  <div class="flex items-center justify-between border-b border-black/5 pb-2">
                    <h4 class="font-semibold text-xs text-[#1d1d1f]">Ordered Styles & Quantities (${itemCount})</h4>
                    <span class="font-mono text-xs font-bold text-[#1d1d1f]">${totalQty} pcs total</span>
                  </div>
                  <div class="divide-y divide-black/5 max-h-72 overflow-y-auto pr-1">
                    ${renderOrderItems(order.items, false)}
                  </div>
                </div>

                <div class="space-y-3">
                  <div class="bg-white rounded-xl border border-black/5 p-4 space-y-2.5 text-xs">
                    <h4 class="font-semibold text-xs text-[#1d1d1f] border-b border-black/5 pb-1.5">Buyer & Delivery Details</h4>
                    <div>
                      <span class="text-[11px] text-[#86868b] block">Contact / Company:</span>
                      <p class="font-medium text-[#1d1d1f]">${escapeHtml(order.contact_name || 'Anonymous')}${order.company_name ? ` · ${escapeHtml(order.company_name)}` : ''}</p>
                    </div>
                    <div>
                      <span class="text-[11px] text-[#86868b] block">Email:</span>
                      <div class="flex items-center gap-2 flex-wrap">
                        <a href="mailto:${safeEmail}" class="font-mono text-[#1d1d1f] hover:underline font-medium break-all">${safeEmail}</a>
                        <a href="/admin/users?search=${encodeURIComponent(order.buyer_email || '')}" class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-md bg-black/5 hover:bg-black/10 text-[#1d1d1f] transition-all" title="Open customer profile in admin">
                          <span>👥 Customer</span>
                          <span>→</span>
                        </a>
                      </div>
                    </div>
                    ${order.whatsapp ? `<div><span class="text-[11px] text-[#86868b] block">WhatsApp:</span><a href="https://wa.me/${String(order.whatsapp).replace(/[^0-9]/g, '')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono font-medium text-emerald-700 hover:text-emerald-800 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200 text-[11px] mt-0.5">${escapeHtml(order.whatsapp)}</a></div>` : ''}
                    <div>
                      <span class="text-[11px] text-[#86868b] block">Destination Country:</span>
                      <p class="font-medium text-[#1d1d1f]">${safeCountry}</p>
                    </div>
                  </div>

                  ${order.customer_notes ? `<div class="bg-amber-50/60 rounded-xl border border-amber-200/70 p-3.5 text-xs text-amber-950 space-y-1"><span class="text-[11px] font-semibold text-amber-900 block">Customer Procurement Notes:</span><p class="italic leading-relaxed whitespace-pre-wrap">${escapeHtml(order.customer_notes)}</p></div>` : ''}
                  ${order.status === 'SHIPPED' ? `<div class="bg-emerald-50/70 rounded-xl border border-emerald-200 p-3.5 text-xs text-emerald-950 space-y-1"><span class="text-[11px] font-semibold text-emerald-900 block">Fulfillment Dispatched:</span><p><strong>Carrier:</strong> ${escapeHtml(order.carrier || 'Standard')}</p>${order.tracking_number ? `<p class="font-mono"><strong>Waybill No:</strong> ${escapeHtml(order.tracking_number)}</p>` : ''}${order.admin_remark ? `<p class="text-[11px] text-emerald-800">Note: ${escapeHtml(order.admin_remark)}</p>` : ''}</div>` : ''}
