---
// src/pages/products/[slug].astro
import Layout from '@layouts/Layout.astro';
import { client } from '@utils/sanity-client';
import { PRODUCT_FIELDS, PRODUCT_CARD_FIELDS, ProductService } from '@data/products';
import { CONFIG_QUERY_OBJ, SiteConfigService } from '@data/siteConfig';
import { RfqSettingsService } from '@data/rfqSettings';
import { cleanBrandTitle } from '@utils/text';
import { SanityImageService } from '@utils/image';
import { DEFAULT_BRAND_TITLE, DEFAULT_FALLBACK_IMAGE, DEFAULT_RFQ, DEFAULT_PRODUCT_DETAIL } from '@data/defaults';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=86400, stale-while-revalidate=604800');

const { slug } = Astro.params;

// Scheme 2: Single Aggregated GROQ Query - combines 4 independent API calls into 1 single roundtrip
let batchData: any = null;
try {
  batchData = await client.fetch(
    `{
      "product": *[_type == "product" && slug.current == $slug][0] ${PRODUCT_FIELDS},
      "allProducts": *[_type == "product"] | order(_createdAt asc) ${PRODUCT_CARD_FIELDS},
      "siteConfig": *[_type == "siteConfig"][0] ${CONFIG_QUERY_OBJ},
      "rfqSettings": *[_type == "rfqSettings"][0]
    }`,
    { slug }
  );
} catch (e) {
  console.error(`Failed to batch-fetch product data for ${slug}:`, e);
}

// Pre-populate service caches so Layout, QuoteDrawer, and recommendations make 0 additional API requests
if (batchData?.siteConfig) SiteConfigService.seed(batchData.siteConfig);
if (batchData?.rfqSettings) RfqSettingsService.seed(batchData.rfqSettings);
if (batchData?.allProducts) ProductService.seed({ products: batchData.allProducts });

const currentProduct = batchData?.product;
if (!currentProduct) {
  return Astro.redirect('/#collections');
}

const allProducts = batchData?.allProducts || [];

// Ensure product has fallbacks for arrays and images
currentProduct.gallery = (currentProduct.gallery && currentProduct.gallery.length > 0)
  ? currentProduct.gallery
  : [{ src: currentProduct.mainImage || DEFAULT_FALLBACK_IMAGE, alt: currentProduct.title || 'Product' }];
currentProduct.colors = currentProduct.colors || [];
currentProduct.pricingTiers = currentProduct.pricingTiers || [];
currentProduct.specifications = currentProduct.specifications || [];
currentProduct.mainImage = currentProduct.mainImage || currentProduct.gallery[0]?.src || DEFAULT_FALLBACK_IMAGE;

const siteConfig = batchData?.siteConfig;
const rfqSettings = batchData?.rfqSettings;
const rawBrandTitle = siteConfig?.header?.title || DEFAULT_BRAND_TITLE;
const brandTitle = cleanBrandTitle(rawBrandTitle);

const navLinks = siteConfig?.header?.navLinks || [];
const collectionsLink = navLinks.find((l: any) => 
  l.url?.includes('#collections') || 
  l.url?.includes('collection') || 
  l.url?.includes('product')
);
const productsNavLabel = collectionsLink?.label || "Products";
const productsNavUrl = collectionsLink?.url || "/#collections";

const currentIndex = allProducts.findIndex((p: any) => p.slug === slug);
const validIndex = currentIndex >= 0 ? currentIndex : 0;
const prevIndex = (validIndex - 1 + allProducts.length) % (allProducts.length || 1);
const nextIndex = (validIndex + 1) % (allProducts.length || 1);

const prevProduct = allProducts[prevIndex] || currentProduct;
const nextProduct = allProducts[nextIndex] || currentProduct;

const addToQuoteBtnText = currentProduct.addToQuoteButtonText || rfqSettings?.btnAddToQuoteText || DEFAULT_RFQ.btnAddToQuoteText;

// Amazon Sample Buying Link Resolution
const rawAmazonUrl = currentProduct.amazonUrl || (currentProduct.amazonAsin ? `https://www.amazon.com/dp/${currentProduct.amazonAsin.trim()}` : null);
const amazonSampleUrl = rawAmazonUrl || rfqSettings?.defaultAmazonStoreUrl || `https://www.amazon.com/s?k=${encodeURIComponent(currentProduct.title || DEFAULT_BRAND_TITLE)}`;
const sampleButtonText = currentProduct.sampleButtonText || rfqSettings?.btnSampleAmazonText || DEFAULT_RFQ.btnSampleAmazonText;

const showAddToQuoteButton = rfqSettings?.showProductAddToQuoteButton ?? true;
const showBuySampleButton = rfqSettings?.showProductBuySampleButton ?? true;
const showSpecSheetButton = rfqSettings?.showProductSpecSheetButton ?? true;

const firstGalleryImg = currentProduct.gallery?.[0]?.src || currentProduct.mainImage;
const productHeroPreload = firstGalleryImg && typeof firstGalleryImg === 'string' && (firstGalleryImg.includes('cdn.sanity.io') || firstGalleryImg.includes('/cdn-image/'))
  ? {
      src: SanityImageService.hero(firstGalleryImg, 1200),
      srcset: SanityImageService.srcSet(firstGalleryImg, [480, 800, 1200]),
      sizes: '(max-width: 1024px) 100vw, 800px',
    }
  : undefined;
---

<Layout
  title={currentProduct.title}
  description={currentProduct.tagline}
  image={currentProduct.mainImage}
  mainClass="pt-12"
  preloadHeroImage={productHeroPreload}
>
  <section id="product-overview" class="product-hero-overview w-full lg:h-[calc(100svh-48px)] lg:max-h-[920px] lg:min-h-0 lg:flex lg:flex-col lg:justify-between py-1 sm:py-2 lg:py-2 border-b border-black/5 bg-white overflow-visible lg:overflow-hidden">
        <!-- Breadcrumb Navigation & Quick Prev/Next Style Switcher -->
        <div class="apple-rail-bento py-1 flex items-center justify-between gap-4 shrink-0">
          <nav class="flex items-center gap-2 text-[11px] text-zinc-500 font-mono min-w-0">
            <a href="/" class="hover:text-black shrink-0">{brandTitle}</a>
            <span class="shrink-0">/</span>
            <a href={productsNavUrl} class="hover:text-black shrink-0">{productsNavLabel}</a>
            <span class="shrink-0">/</span>
            <span class="text-zinc-900 font-semibold truncate">{currentProduct.shortTitle || currentProduct.title}</span>
          </nav>

          <!-- Apple-Style Compact Prev / Next Switcher -->
          {allProducts.length > 1 && (
            <div class="flex items-center gap-1.5 shrink-0 text-xs font-medium font-sans">
              <a
                href={`/products/${prevProduct.slug}`}
                class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
                title={`Previous: ${prevProduct.shortTitle || prevProduct.title}`}
              >
                <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                </svg>
                <span class="hidden sm:inline text-[11px]">Prev</span>
              </a>

              <span class="text-[11px] font-mono text-zinc-400 select-none px-0.5">
                {validIndex + 1} / {allProducts.length}
              </span>

              <a
                href={`/products/${nextProduct.slug}`}
                class="px-2.5 py-1 rounded-full border border-black/10 hover:border-black/25 bg-white text-[#1d1d1f] hover:bg-[#f5f5f7] transition-all flex items-center gap-1 shadow-2xs group"
                title={`Next: ${nextProduct.shortTitle || nextProduct.title}`}
              >
                <span class="hidden sm:inline text-[11px]">Next</span>
                <svg class="w-3 h-3 text-[#86868b] group-hover:text-black transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>

        <!-- Center: 2-Column Showcase Grid -->
        <div class="apple-rail-bento flex-1 min-h-0 flex flex-col justify-center my-auto py-0.5 sm:py-1">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 xl:gap-8 items-stretch h-full">
            
            <!-- LEFT: Apple-Style Multi-Image Carousel / Gallery (7 Cols for Balanced Ratio) -->
            <div class="product-gallery-col w-full min-w-0 lg:col-span-7 flex flex-col h-full justify-between">
              <div class="flex-1 min-h-0 flex flex-col lg:flex-row gap-2.5 sm:gap-3 lg:gap-3.5 items-stretch h-full">
                
                <!-- Thumbnail Gallery (Desktop: Left Vertical Column; Mobile: Bottom Horizontal Scroll) -->
                <div class="order-2 lg:order-1 flex flex-row lg:flex-col gap-2 overflow-x-auto lg:overflow-y-auto no-scrollbar shrink-0 w-full lg:w-auto max-w-full h-auto lg:h-full pb-1 lg:pb-0 scrollbar-none justify-start">
                  {currentProduct.gallery.map((img: any, idx: number) => (
                    <button
                      type="button"
                      data-thumb-index={idx}
                      aria-label={`View image ${idx + 1}`}
                      class={`carousel-thumb shrink-0 w-14 h-14 sm:w-15 sm:h-15 lg:w-[68px] lg:h-[68px] xl:w-[74px] xl:h-[74px] rounded-xl overflow-hidden border-2 transition-all duration-200 cursor-pointer bg-[#fafafa] flex items-center justify-center ${idx === 0 ? 'border-zinc-950 scale-102 ring-2 ring-zinc-950/20' : 'border-zinc-200/80 hover:border-zinc-400 opacity-70 hover:opacity-100'}`}
                    >
                      <img src={SanityImageService.thumbnail(img.src, 160)} alt={img.alt} class="w-full h-full object-contain p-0.5" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>

                <!-- Main Viewport Box with Controls (Fills full height on desktop, 100% full image with object-contain) -->
                <div class="order-1 lg:order-2 relative w-full flex-1 min-w-0 aspect-[4/3] lg:aspect-auto h-[360px] sm:h-[440px] lg:h-full rounded-2xl overflow-hidden bg-[#fafafa] border border-zinc-200/80 shadow-xs group flex items-center justify-center">
                  <!-- Carousel Images -->
                  <div id="carousel-track" class="w-full h-full relative">
                    {currentProduct.gallery.map((img: any, idx: number) => (
                      <img
                        src={SanityImageService.hero(img.src, 1200)}
                        srcset={SanityImageService.srcSet(img.src, [480, 800, 1200]) || undefined}
                        sizes="(max-width: 1024px) 100vw, 800px"
                        alt={img.alt}
                        class={`carousel-slide absolute inset-0 m-auto w-full h-full max-h-full max-w-full object-contain p-2 sm:p-4 transition-opacity duration-500 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
                        data-index={idx}
                        loading={idx === 0 ? 'eager' : 'lazy'}
                        fetchpriority={idx === 0 ? 'high' : 'auto'}
                        decoding="async"
                      />
                    ))}
                  </div>

                  <!-- Top Indicator Badges -->
                  <div class="absolute top-3 left-3 z-20 flex items-center gap-1.5 sm:gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-white/90 backdrop-blur-md text-zinc-900 border border-zinc-200/80 shadow-xs font-semibold">
                      SKU: {currentProduct.sku}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-zinc-900 text-white shadow-xs font-medium">
                      {currentProduct.moq}
                    </span>
                  </div>

                  <!-- Counter Badge -->
                  <div class="absolute top-3 right-3 z-20 px-2 py-0.5 rounded-full text-[10px] font-mono bg-black/60 backdrop-blur-md text-white shadow-xs">
                    <span id="carousel-counter-curr">1</span> / <span id="carousel-counter-total">{currentProduct.gallery.length}</span>
                  </div>

                  <!-- Navigation Arrow Controls -->
                  <button
                    type="button"
                    id="carousel-prev"
                    aria-label="Previous slide"
                    class="absolute left-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-zinc-900 shadow-sm backdrop-blur-md flex items-center justify-center transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>

                  <button
                    type="button"
                    id="carousel-next"
                    aria-label="Next slide"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-zinc-900 shadow-sm backdrop-blur-md flex items-center justify-center transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>

              </div>

              <p class="text-[10px] text-zinc-400 font-mono text-center lg:text-left mt-1.5 shrink-0">
                {currentProduct.galleryHint || DEFAULT_PRODUCT_DETAIL.galleryHint}
              </p>
            </div>

            <!-- RIGHT: Product Info, Tiered Wholesale Pricing & B2B Actions (5 Cols for Snug Symmetry) -->
            <div class="product-info-col w-full min-w-0 lg:col-span-5 h-full flex flex-col justify-between py-0.5 space-y-2 lg:space-y-0">
              <!-- Header Info -->
              <div class="space-y-1 xl:space-y-1.5 shrink-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-zinc-100 text-zinc-800 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>{currentProduct.statusBadge || DEFAULT_PRODUCT_DETAIL.statusBadge}</span>
                  </span>
                  {currentProduct.rating && (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-stone-100 text-stone-700 border border-stone-200/60">
                      {currentProduct.rating}
                    </span>
                  )}
                </div>
                <h1 class="text-xl sm:text-2xl xl:text-3xl font-bold tracking-tight text-zinc-950 leading-snug">
                  {currentProduct.title}
                </h1>
                <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed line-clamp-2 sm:line-clamp-none">
                  {currentProduct.tagline}
                </p>
              </div>

              <!-- Tiered Wholesale Pricing Matrix (Compact) -->
              <div class="pricing-tier-card p-3 sm:p-3.5 xl:p-4 rounded-xl xl:rounded-2xl bg-[#fbf9f5] border border-zinc-200/80 space-y-1.5 shrink-0">
                <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono uppercase tracking-wider">
                  <span>Wholesale FOB Tier</span>
                  <span>Unit Price</span>
                </div>
                <div class="space-y-1 xl:space-y-1.5">
                  {currentProduct.pricingTiers.map((tier: any) => (
                    <div class="flex items-center justify-between text-xs sm:text-sm py-0.5 border-b border-zinc-200/50 last:border-none">
                      <span class="text-zinc-700 font-medium">{tier.range}</span>
                      <span class="text-zinc-950 font-bold font-mono text-xs sm:text-sm">{tier.price}</span>
                    </div>
                  ))}
                </div>
                <p class="text-[10px] text-zinc-400 font-mono pt-0.5">
                  {currentProduct.priceNote || DEFAULT_PRODUCT_DETAIL.priceNote}
                </p>
              </div>

              <!-- Palette Selector & Quick Technical Specs Bar -->
              <div class="space-y-2 shrink-0">
                <!-- Available Color Swatches with interactive selection -->
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block">
                      {currentProduct.paletteTitle || DEFAULT_PRODUCT_DETAIL.paletteTitle}
                    </span>
                    <span id="selected-color-name" class="text-xs font-medium text-zinc-900">
                      {currentProduct.colors[0]?.name || "Default"}
                    </span>
                  </div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {currentProduct.colors.map((c: any, cIdx: number) => (
                      <button
                        type="button"
                        class={`color-variant-btn flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium transition-all cursor-pointer ${
                          cIdx === 0
                            ? 'border-zinc-950 bg-zinc-950 text-white shadow-xs'
                            : 'border-zinc-200 bg-white text-zinc-800 hover:border-zinc-400'
                        }`}
                        data-color={c.name}
                        data-hex={c.hex}
                      >
                        <span class="w-2.5 h-2.5 rounded-full border border-black/20" style={`background-color: ${c.hex}`}></span>
                        <span>{c.name}</span>
                      </button>
                    ))}
                  </div>
                </div>

                <!-- Quick Specs Micro Bento (High B2B credibility, compact) -->
                <div class="grid grid-cols-3 gap-1.5 py-1.5 px-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 text-[11px]">
                  <div class="space-y-0.5">
                    <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400 block truncate">Gauge</span>
                    <span class="font-semibold text-zinc-900 truncate block text-[11px]">200N Lonati</span>
                  </div>
                  <div class="space-y-0.5 border-x border-black/5 px-2">
                    <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400 block truncate">Toe Seam</span>
                    <span class="font-semibold text-zinc-900 truncate block text-[11px]">Hand-Linked</span>
                  </div>
                  <div class="space-y-0.5 pl-1">
                    <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400 block truncate">Sampling</span>
                    <span class="font-semibold text-zinc-900 truncate block text-[11px]">48h Dispatch</span>
                  </div>
                </div>
              </div>

              <!-- B2B Dual-Track RFQ Action Buttons -->
              {(showAddToQuoteButton || showBuySampleButton || showSpecSheetButton) && (
              <div class="space-y-1.5 pt-0.5 shrink-0">
                {(showAddToQuoteButton || showBuySampleButton) && (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-2">
                  <!-- Track 1: Multi-Item Quote Basket -->
                  {showAddToQuoteButton && (
                  <button
                    type="button"
                    id="btn-add-quote"
                    class="w-full py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-semibold bg-[#1d1d1f] hover:bg-black text-white group flex items-center justify-center gap-2 shadow-sm hover:shadow-md transition-all cursor-pointer"
                    data-id={currentProduct.slug}
                    data-title={currentProduct.shortTitle || currentProduct.title}
                    data-sku={currentProduct.sku || "SKU"}
                    data-image={SanityImageService.thumbnail(currentProduct.gallery[0]?.src || DEFAULT_FALLBACK_IMAGE, 200)}
                    data-moq={currentProduct.moq || DEFAULT_PRODUCT_DETAIL.fallbackMoq}
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span>{addToQuoteBtnText}</span>
                  </button>
                  )}

                  <!-- Track 2: Buy Sample Directly on Amazon (ASIN Link) -->
                  {showBuySampleButton && (
                  <a
                    href={amazonSampleUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    id="btn-amazon-sample"
                    class="w-full py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-semibold bg-[#f5f5f7] hover:bg-[#ff9900]/10 hover:border-[#ff9900]/40 text-[#1d1d1f] hover:text-[#111] border border-black/10 flex items-center justify-center gap-1.5 transition-all shadow-2xs group cursor-pointer"
                    title="Buy Sample directly on Amazon"
                  >
                    <svg class="w-4 h-4 text-[#232f3e] group-hover:text-[#ff9900] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M15.93 17.09c-2.83 2.08-6.94 3.19-10.51 3.19-4.99 0-9.48-1.92-12.87-5.13-.27-.25-.03-.6.29-.42 3.65 2.11 8.08 3.38 12.58 3.38 3.17 0 6.64-.72 9.81-2.22.48-.23.95.35.7.7v-.5zM16.8 15.65c-.36-.46-2.38-.22-3.3-.11-.28.03-.32-.2-.07-.37 1.63-1.14 4.3-.81 4.6.21.3 1.01-1.28 3.39-2.83 4.61-.24.19-.47.09-.36-.16.36-.8 1.48-3.09 1.96-4.18z"/>
                      <path d="M13.9 9.38c0 1.67-.32 2.97-.97 3.91-.65.94-1.57 1.41-2.76 1.41-1.07 0-1.92-.38-2.56-1.13-.64-.75-.96-1.83-.96-3.23 0-1.57.34-2.83 1.02-3.77.68-.94 1.63-1.41 2.84-1.41 1.05 0 1.88.38 2.5 1.13.44.53.73 1.34.87 2.42.04.22.06.44.06.67zm-2.07.12c0-.98-.14-1.74-.43-2.28-.29-.54-.73-.81-1.32-.81-.59 0-1.03.27-1.32.81-.29.54-.44 1.3-.44 2.28 0 .97.15 1.73.44 2.27.29.54.73.81 1.32.81.59 0 1.03-.27-1.32-.81.29-.54.43-1.3.43-2.27z"/>
                    </svg>
                    <span>{sampleButtonText}</span>
                    <svg class="w-3.5 h-3.5 text-[#86868b] group-hover:text-black group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  )}
                </div>
                )}

                <!-- Tech Pack / Spec Sheet Link -->
                {showSpecSheetButton && (
                <div class="flex items-center justify-between text-xs pt-0.5 px-0.5 text-zinc-500">
                  <button
                    type="button"
                    id="btn-download-spec"
                    class="hover:text-black flex items-center gap-1 underline underline-offset-2 transition-colors cursor-pointer text-[11px]"
                    data-sku={currentProduct.sku}
                    data-title={currentProduct.title}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Download Spec Sheet (PDF)</span>
                  </button>
                </div>
                )}
              </div>
              )}

              <!-- Lead Time & Guarantee Badges -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-zinc-100 text-[11px] text-zinc-600 shrink-0">
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-zinc-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="truncate">{currentProduct.leadTime}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-zinc-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span class="truncate">{currentProduct.supportBadge || DEFAULT_PRODUCT_DETAIL.supportBadge}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Specifications Breakdown & Product Navigation Container (Below Fold) -->
      <section id="specs" class="w-full py-8 sm:py-10 bg-[#fbf9f5]/50 border-t border-black/5">
        <div class="apple-rail-bento">
          <!-- Specifications Breakdown: 4-Column Bento Matrix (No dead space) -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 block">
                  {currentProduct.specsBadge || DEFAULT_PRODUCT_DETAIL.specsBadge}
                </span>
                <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-zinc-950 mt-0.5">
                  {currentProduct.specsHeading || DEFAULT_PRODUCT_DETAIL.specsHeading}
                </h2>
              </div>
              <span class="hidden sm:inline-block text-[11px] font-mono text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60">
                ✓ 100% Lonati Verified
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3">
              {currentProduct.specifications.map((spec: any) => (
                <div class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-[#f5f5f7] border border-black/5 hover:border-black/15 transition-all flex flex-col justify-between min-h-[88px]">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[#86868b] block">{spec.label}</span>
                  <span class="text-xs sm:text-[13px] font-semibold text-[#1d1d1f] mt-1.5 leading-snug line-clamp-3">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Style Navigation Cards (Previous / Next Silhouette) -->
          {allProducts.length > 1 && (
            <div class="mt-5 sm:mt-6 pt-4 border-t border-black/5">
              <div class="grid grid-cols-2 gap-2.5 sm:gap-4 items-stretch">
                <!-- Previous Product Card -->
                <a
                  href={`/products/${prevProduct.slug}`}
                  class="group p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-[#f5f5f7] hover:bg-stone-100 border border-black/5 hover:border-black/15 transition-all flex items-center justify-between gap-2 sm:gap-3 text-left shadow-2xs hover:shadow-xs min-w-0"
                >
                  <div class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white border border-black/10 flex items-center justify-center shrink-0 text-zinc-700 group-hover:text-black group-hover:-translate-x-0.5 transition-transform shadow-2xs">
                      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" />
                      </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block truncate">
                        <span class="sm:hidden">Previous</span>
                        <span class="hidden sm:inline">Previous Silhouette</span>
                      </span>
                      <span class="text-xs sm:text-sm font-semibold text-zinc-900 truncate block group-hover:underline">
                        {prevProduct.shortTitle || prevProduct.title}
                      </span>
                    </div>
                  </div>
                </a>

                <!-- Next Product Card -->
                <a
                  href={`/products/${nextProduct.slug}`}
                  class="group p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-[#f5f5f7] hover:bg-stone-100 border border-black/5 hover:border-black/15 transition-all flex items-center justify-between gap-2 sm:gap-3 text-right shadow-2xs hover:shadow-xs min-w-0"
                >
                  <div class="min-w-0 flex-1">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block truncate">
                      <span class="sm:hidden">Next</span>
                      <span class="hidden sm:inline">Next Silhouette</span>
                    </span>
                    <span class="text-xs sm:text-sm font-semibold text-zinc-900 truncate block group-hover:underline">
                      {nextProduct.shortTitle || nextProduct.title}
                    </span>
                  </div>
                  <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white border border-black/10 flex items-center justify-center shrink-0 text-zinc-700 group-hover:text-black group-hover:translate-x-0.5 transition-transform shadow-2xs">
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          )}
        </div>
      </section>

  <script>
      let currentSlide = 0;
      const slides = document.querySelectorAll<HTMLImageElement>('.carousel-slide');
      const thumbs = document.querySelectorAll<HTMLButtonElement>('.carousel-thumb');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      const counterCurr = document.getElementById('carousel-counter-curr');

      function showSlide(index: number) {
        if (!slides.length) return;
        currentSlide = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          if (i === currentSlide) {
            slide.classList.remove('opacity-0', 'pointer-events-none');
            slide.classList.add('opacity-100', 'z-10');
          } else {
            slide.classList.remove('opacity-100', 'z-10');
            slide.classList.add('opacity-0', 'pointer-events-none');
          }
        });

        thumbs.forEach((thumb, i) => {
          if (i === currentSlide) {
            thumb.classList.add('border-zinc-950', 'scale-102', 'ring-2', 'ring-zinc-950/20');
            thumb.classList.remove('border-zinc-200/80', 'opacity-70');
            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
          } else {
            thumb.classList.remove('border-zinc-950', 'scale-102', 'ring-2', 'ring-zinc-950/20');
            thumb.classList.add('border-zinc-200/80', 'opacity-70');
          }
        });

        if (counterCurr) {
          counterCurr.textContent = String(currentSlide + 1);
        }
      }

      if (prevBtn) prevBtn.addEventListener('click', () => showSlide(currentSlide - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showSlide(currentSlide + 1));

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const idx = Number(thumb.getAttribute('data-thumb-index'));
          if (!isNaN(idx)) showSlide(idx);
        });
      });

      // B2B Dual-Track RFQ Handlers
      import { addToQuote } from '../../stores/quoteCart';

      const firstColorBtn = document.querySelector<HTMLElement>('.color-variant-btn');
      let selectedVariant = firstColorBtn?.dataset.color || 'Standard';
      const colorBtns = document.querySelectorAll('.color-variant-btn');
      const selectedColorLabel = document.getElementById('selected-color-name');

      colorBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const col = btn.getAttribute('data-color') || '';
          selectedVariant = col;
          if (selectedColorLabel) selectedColorLabel.textContent = col;
          colorBtns.forEach((b) => {
            b.classList.remove('border-zinc-950', 'bg-zinc-950', 'text-white', 'shadow-xs');
            b.classList.add('border-zinc-200', 'bg-white', 'text-zinc-800');
          });
          btn.classList.add('border-zinc-950', 'bg-zinc-950', 'text-white', 'shadow-xs');
          btn.classList.remove('border-zinc-200', 'bg-white', 'text-zinc-800');
        });
      });

      // Track 1: Add to Multi-Item Quote Basket
      const addQuoteBtn = document.getElementById('btn-add-quote') as HTMLElement | null;
      if (addQuoteBtn) {
        addQuoteBtn.addEventListener('click', () => {
          const id = addQuoteBtn.dataset.id || 'product';
          const title = addQuoteBtn.dataset.title || 'Product';
          const sku = addQuoteBtn.dataset.sku || 'SKU';
          const imageUrl = addQuoteBtn.dataset.image || '/images/hero-light.webp';
          const rawMoq = addQuoteBtn.dataset.moq || '200 Pairs';
          const moqNum = parseInt(rawMoq.replace(/\D/g, ''), 10) || 200;

          addToQuote({
            id,
            title,
            sku,
            imageUrl,
            variant: selectedVariant,
            quantity: moqNum,
            moq: rawMoq,
          });
          if ((window as any).openQuoteDrawer) {
            (window as any).openQuoteDrawer();
          }
        });
      }

      // Download Spec Sheet (PDF): Adds dossier to quote cart
      const specBtn = document.getElementById('btn-download-spec') as HTMLElement | null;
      if (specBtn) {
        specBtn.addEventListener('click', () => {
          const sku = specBtn.dataset.sku || 'SPEC';
          const title = specBtn.dataset.title || 'Product';
          addToQuote({
            id: `spec-${sku.toLowerCase()}`,
            title: `Tech Pack & Spec Sheet (PDF): ${title}`,
            sku: sku,
            imageUrl: '/images/spec-light.webp',
            variant: 'Official Engineering PDF Dossier',
            quantity: 1,
            moq: 'Direct Dispatch',
          });
          if ((window as any).openQuoteDrawer) {
            (window as any).openQuoteDrawer();
          }
        });
      }
    </script>
</Layout>
