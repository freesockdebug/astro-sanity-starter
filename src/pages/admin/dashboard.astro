---
// src/pages/admin/dashboard.astro
// Executive Business Dashboard (MineAdmin Style High-Performance Overview)
import AdminLayout from '@layouts/AdminLayout.astro';
import { requireAdminContext } from '@utils/auth';
import { getDashboardStats } from '@utils/db';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/dashboard',
  { requiredMenu: 'dashboard' }
);
if (redirectResponse) return redirectResponse;

const stats = await getDashboardStats().catch(() => ({
  totalOrders: 0,
  orders7Days: 0,
  pendingReview: 0,
  overdueSla: 0,
  statusFunnel: { pending: 0, approved: 0, shipped: 0, rejected: 0 },
  topCountries: [],
  topSkus: [],
  repWorkloads: [],
}));

const total = stats.totalOrders || 1;
const pendingPct = Math.round((stats.statusFunnel.pending / total) * 100);
const approvedPct = Math.round((stats.statusFunnel.approved / total) * 100);
const shippedPct = Math.round((stats.statusFunnel.shipped / total) * 100);
const rejectedPct = Math.round((stats.statusFunnel.rejected / total) * 100);

const pageTitle = 'Business Overview';
---

<AdminLayout
  title={pageTitle}
  currentTab="dashboard"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
>
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-5 border-b border-black/5 gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1d1d1f]">Business Overview</h1>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Live D1 Edge Telemetry
        </span>
      </div>
      <p class="text-xs text-[#86868b] mt-0.5">
        Executive operational cockpit: global buyer inquiries, conversion funnel, SLA backlogs, and representative throughput.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/admin/orders"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black shadow-2xs active:scale-95 transition-all"
      >
        <span>View Orders Workbench</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <!-- Panel 1: Core KPI Metric Cards & SLA Overdue Alert -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Total Inquiries -->
    <div class="p-5 rounded-2xl bg-white border border-black/5 shadow-2xs flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-[#86868b] uppercase tracking-wider">Total RFQs</span>
        <span class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm font-bold">📦</span>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#1d1d1f] font-mono tracking-tight">
          {stats.totalOrders}
        </div>
        <p class="text-[11px] text-[#86868b] mt-1 flex items-center gap-1">
          <span>All-time commercial inquiries</span>
        </p>
      </div>
    </div>

    <!-- 7-Day New Volume -->
    <div class="p-5 rounded-2xl bg-white border border-black/5 shadow-2xs flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-[#86868b] uppercase tracking-wider">7-Day New Volume</span>
        <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">📈</span>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#1d1d1f] font-mono tracking-tight">
          {stats.orders7Days}
        </div>
        <p class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
          <span>Recent intake this week</span>
        </p>
      </div>
    </div>

    <!-- Pending Review Backlog -->
    <div class="p-5 rounded-2xl bg-white border border-black/5 shadow-2xs flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-[#86868b] uppercase tracking-wider">Review Backlog</span>
        <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-sm font-bold">⏳</span>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-900 font-mono tracking-tight">
          {stats.pendingReview}
        </div>
        <p class="text-[11px] text-[#86868b] mt-1">
          Awaiting factory review & dispatch
        </p>
      </div>
    </div>

    <!-- Urgent SLA Overdue Card (>24h) -->
    <a
      href="/admin/orders?status=PENDING_APPROVAL"
      class:list={[
        'p-5 rounded-2xl border shadow-2xs flex flex-col justify-between transition-all group cursor-pointer',
        stats.overdueSla > 0
          ? 'bg-rose-50/70 border-rose-200 hover:border-rose-400'
          : 'bg-white border-black/5'
      ]}
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-rose-800">SLA Breach Warning</span>
        <span class="w-8 h-8 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-sm font-bold">
          {stats.overdueSla > 0 ? '🔥' : '✔'}
        </span>
      </div>
      <div class="mt-3">
        <div class:list={['text-2xl sm:text-3xl font-extrabold font-mono tracking-tight', stats.overdueSla > 0 ? 'text-rose-700' : 'text-[#1d1d1f]']}>
          {stats.overdueSla}
        </div>
        <p class="text-[11px] text-rose-800 font-semibold mt-1 group-hover:underline">
          {stats.overdueSla > 0 ? '> 24h unattended orders (Take action →)' : 'No SLA breaches recorded'}
        </p>
      </div>
    </a>
  </div>

  <!-- Panel 2: B2B RFQ Conversion Funnel -->
  <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs mb-6 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-black/5 pb-3">
      <div>
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">B2B Requisition Fulfillment Funnel</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Throughput distribution from initial buyer submission to fulfillment dispatch.</p>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-[#52525b]">
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Pending ({pendingPct}%)</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Approved ({approvedPct}%)</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Shipped ({shippedPct}%)</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span> Rejected ({rejectedPct}%)</span>
      </div>
    </div>

    <!-- Segmented Funnel Bar -->
    <div class="w-full h-4 rounded-xl overflow-hidden flex bg-zinc-100 shadow-inner">
      <div style={`width: ${pendingPct}%`} class="bg-amber-400 transition-all" title={`Pending: ${stats.statusFunnel.pending} (${pendingPct}%)`}></div>
      <div style={`width: ${approvedPct}%`} class="bg-blue-500 transition-all" title={`Approved: ${stats.statusFunnel.approved} (${approvedPct}%)`}></div>
      <div style={`width: ${shippedPct}%`} class="bg-emerald-500 transition-all" title={`Shipped: ${stats.statusFunnel.shipped} (${shippedPct}%)`}></div>
      <div style={`width: ${rejectedPct}%`} class="bg-rose-400 transition-all" title={`Rejected: ${stats.statusFunnel.rejected} (${rejectedPct}%)`}></div>
    </div>

    <!-- Funnel Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
      <div class="p-3 rounded-xl bg-amber-50/50 border border-amber-200/60">
        <span class="text-[11px] font-semibold text-amber-800">Pending Review</span>
        <div class="text-lg font-bold font-mono text-amber-950 mt-0.5">{stats.statusFunnel.pending}</div>
      </div>
      <div class="p-3 rounded-xl bg-blue-50/50 border border-blue-200/60">
        <span class="text-[11px] font-semibold text-blue-800">Approved / Processing</span>
        <div class="text-lg font-bold font-mono text-blue-950 mt-0.5">{stats.statusFunnel.approved}</div>
      </div>
      <div class="p-3 rounded-xl bg-emerald-50/50 border border-emerald-200/60">
        <span class="text-[11px] font-semibold text-emerald-800">Dispatched / Shipped</span>
        <div class="text-lg font-bold font-mono text-emerald-950 mt-0.5">{stats.statusFunnel.shipped}</div>
      </div>
      <div class="p-3 rounded-xl bg-rose-50/50 border border-rose-200/60">
        <span class="text-[11px] font-semibold text-rose-800">Rejected / Terminated</span>
        <div class="text-lg font-bold font-mono text-rose-950 mt-0.5">{stats.statusFunnel.rejected}</div>
      </div>
    </div>
  </div>

  <!-- Panel 3: Global Buyer Geography & Top Fabric SKUs -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Top Destination Countries -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">Global Buyer Demographics</h2>
          <p class="text-xs text-[#86868b] mt-0.5">Top destination countries for commercial consignments.</p>
        </div>
        <span class="text-xs">🌍</span>
      </div>

      <div class="space-y-3">
        {stats.topCountries.length === 0 ? (
          <div class="p-8 text-center text-xs text-[#86868b]">No destination telemetry recorded yet.</div>
        ) : (
          stats.topCountries.map((c) => (
            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-[#1d1d1f]">{c.country}</span>
                <span class="font-mono text-[#86868b]">{c.count} orders ({c.percentage}%)</span>
              </div>
              <div class="w-full h-2 rounded-full bg-zinc-100 overflow-hidden">
                <div style={`width: ${c.percentage}%`} class="h-full bg-indigo-500 rounded-full"></div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>

    <!-- Top Inquired Fabric SKUs -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
      <div class="border-b border-black/5 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">Top Inquired Fabric SKUs</h2>
          <p class="text-xs text-[#86868b] mt-0.5">Most requested textiles in bulk RFQs and sample swatches.</p>
        </div>
        <span class="text-xs">🧵</span>
      </div>

      <div class="space-y-2">
        {stats.topSkus.length === 0 ? (
          <div class="p-8 text-center text-xs text-[#86868b]">No SKU item records captured.</div>
        ) : (
          stats.topSkus.map((sku, idx) => (
            <div class="p-2.5 rounded-xl bg-[#fafafa] border border-black/5 flex items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-5 h-5 rounded-full bg-black/5 flex items-center justify-center font-mono font-bold text-[10px] text-[#52525b] shrink-0">
                  {idx + 1}
                </span>
                <span class="font-semibold text-[#1d1d1f] truncate">{sku.title}</span>
              </div>
              <div class="flex items-center gap-2 shrink-0 font-mono text-[11px]">
                <span class="text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md font-semibold">{sku.count} inquiries</span>
                <span class="text-[#86868b]">{sku.totalQty} total yds</span>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>

  <!-- Panel 4: Team Workload & SLA Matrix -->
  <div class="p-5 sm:p-6 rounded-2xl bg-white border border-black/5 shadow-2xs space-y-4">
    <div class="border-b border-black/5 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h2 class="text-sm font-bold text-[#1d1d1f] tracking-tight">Sales Representative Workload & Throughput</h2>
        <p class="text-xs text-[#86868b] mt-0.5">Staff assignment distribution, backlog queues, and commercial accounts managed.</p>
      </div>
      <a
        href="/admin/members"
        class="text-xs font-semibold text-blue-600 hover:text-blue-800 inline-flex items-center gap-1"
      >
        <span>Manage Staff Assignments</span>
        <span>→</span>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-black/5 text-[#86868b] font-semibold uppercase text-[10px] tracking-wider">
            <th class="py-2.5 px-3">Team Member</th>
            <th class="py-2.5 px-3">Role</th>
            <th class="py-2.5 px-3 text-center">Total Orders</th>
            <th class="py-2.5 px-3 text-center">Pending Backlog</th>
            <th class="py-2.5 px-3 text-center">Completed (Shipped)</th>
            <th class="py-2.5 px-3 text-center">Accounts Bound</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
          {stats.repWorkloads.length === 0 ? (
            <tr>
              <td colspan="6" class="py-6 text-center text-[#86868b]">No active staff workload records found.</td>
            </tr>
          ) : (
            stats.repWorkloads.map((r) => (
              <tr class="hover:bg-[#fbfbfd] transition-colors">
                <td class="py-3 px-3">
                  <div class="font-semibold text-[#1d1d1f]">{r.name}</div>
                  <div class="text-[11px] font-mono text-[#86868b]">{r.email}</div>
                </td>
                <td class="py-3 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-black/5 text-[#52525b] uppercase">
                    {r.roleCode}
                  </span>
                </td>
                <td class="py-3 px-3 text-center font-mono font-bold text-xs">{r.totalOrders}</td>
                <td class="py-3 px-3 text-center">
                  <span class:list={[
                    'font-mono font-bold px-2 py-0.5 rounded-full text-xs',
                    r.pendingOrders > 0 ? 'bg-amber-100 text-amber-900' : 'text-[#86868b]'
                  ]}>
                    {r.pendingOrders}
                  </span>
                </td>
                <td class="py-3 px-3 text-center font-mono text-emerald-700 font-semibold">{r.shippedOrders}</td>
                <td class="py-3 px-3 text-center font-mono font-semibold text-purple-700">{r.assignedCustomers}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

