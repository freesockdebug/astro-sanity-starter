---
// src/pages/admin/logins.astro
// Admin Security Audit: 90-Day Login History & IP/Device Tracker
import AdminLayout from '@layouts/AdminLayout.astro';
import LocalTime from '@components/LocalTime.astro';
import { requireAdminContext } from '@utils/auth';
import { listAllLoginHistory } from '@utils/db';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, pendingOrdersCount, redirectResponse } = await requireAdminContext(Astro, cfEnv, '/admin/logins');
if (redirectResponse) return redirectResponse;

const currentSearch = Astro.url.searchParams.get('search')?.trim() || '';
const logins = await listAllLoginHistory(150);

// Search filter
const searchLower = currentSearch.toLowerCase();
const displayLogins = searchLower
  ? logins.filter((l) =>
      (l.email || '').toLowerCase().includes(searchLower) ||
      (l.user_id || '').toLowerCase().includes(searchLower) ||
      (l.ip || '').toLowerCase().includes(searchLower) ||
      (l.city || '').toLowerCase().includes(searchLower) ||
      (l.country || '').toLowerCase().includes(searchLower)
    )
  : logins;

// Summary metrics (calculated on raw dataset)
const uniqueUsers = new Set(logins.map((l) => l.email.toLowerCase())).size;
const uniqueIps = new Set(logins.map((l) => l.ip).filter(Boolean)).size;
const countries = Array.from(new Set(logins.map((l) => l.country).filter(Boolean)));

const pageTitle = 'Login Audit Logs | GwenVenni Atelier Admin';
---

<AdminLayout
  title={pageTitle}
  currentTab="logins"
  sessionEmail={sessionUser.email}
  pendingOrdersCount={pendingOrdersCount}
>
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-5 border-b border-black/5 gap-3">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1d1d1f]">Login & Security Audit</h1>
      <p class="text-xs text-[#86868b] mt-0.5">Real-time audit log of authenticated user sessions and IP locations (90-day retention)</p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-black/10 text-xs font-mono text-[#52525b] shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Active Retention: 90 Days
      </span>
    </div>
  </div>

  <!-- KPI Metric Cards (Compact auto-fit grid on mobile, expanded on desktop) -->
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,9.5rem),1fr))] gap-2 sm:gap-4 mb-4 sm:mb-6">
    <div class="p-2 sm:p-4 rounded-xl sm:rounded-2xl bg-white border border-black/5 shadow-2xs">
      <span class="text-[9px] sm:text-[11px] text-[#86868b] uppercase tracking-wider font-semibold block mb-0.5 sm:mb-1 truncate">Sessions</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-base sm:text-2xl font-bold font-mono tracking-tight text-[#1d1d1f]">{logins.length}</span>
        <span class="text-[9px] sm:text-xs text-[#86868b] hidden xs:inline">Events</span>
      </div>
    </div>

    <div class="p-2 sm:p-4 rounded-xl sm:rounded-2xl bg-white border border-black/5 shadow-2xs">
      <span class="text-[9px] sm:text-[11px] text-[#86868b] uppercase tracking-wider font-semibold block mb-0.5 sm:mb-1 truncate">Accounts</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-base sm:text-2xl font-bold font-mono tracking-tight text-[#1d1d1f]">{uniqueUsers}</span>
        <span class="text-[9px] sm:text-xs text-[#86868b] hidden xs:inline">Emails</span>
      </div>
    </div>

    <div class="p-2 sm:p-4 rounded-xl sm:rounded-2xl bg-white border border-black/5 shadow-2xs">
      <span class="text-[9px] sm:text-[11px] text-[#86868b] uppercase tracking-wider font-semibold block mb-0.5 sm:mb-1 truncate">Origin IPs</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-base sm:text-2xl font-bold font-mono tracking-tight text-blue-700">{uniqueIps}</span>
        <span class="text-[9px] sm:text-xs text-[#86868b] hidden xs:inline">IPs</span>
      </div>
    </div>

    <div class="p-2 sm:p-4 rounded-xl sm:rounded-2xl bg-white border border-black/5 shadow-2xs">
      <span class="text-[9px] sm:text-[11px] text-[#86868b] uppercase tracking-wider font-semibold block mb-0.5 sm:mb-1 truncate">Span</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-base sm:text-2xl font-bold font-mono tracking-tight text-purple-700">{countries.length || 1}</span>
        <span class="text-[9px] sm:text-xs text-[#86868b] hidden xs:inline">Countries</span>
      </div>
    </div>
  </div>

  <!-- Sticky Toolbar: Filters & Search Form -->
  <div class="sticky top-14 lg:top-0 z-20 bg-[#f5f5f7]/95 backdrop-blur-md pt-2 pb-3 mb-4 -mx-3.5 px-3.5 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 border-b border-black/5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
    <div class="flex items-center gap-2 text-xs">
      <span class="font-semibold text-[#1d1d1f]">Session Log Stream</span>
      <span class="text-[#86868b]">({displayLogins.length} of {logins.length} events)</span>
    </div>

    <!-- Search Form -->
    <form method="GET" action="/admin/logins" class="relative flex items-center w-full sm:w-80">
      <input
        type="text"
        name="search"
        value={currentSearch}
        placeholder="Search email, user ID, IP, city..."
        class="w-full pl-9 pr-8 py-2 text-xs rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-[#1d1d1f] shadow-2xs"
      />
      <svg class="w-4 h-4 text-[#86868b] absolute left-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      {currentSearch && (
        <a href="/admin/logins" class="absolute right-2.5 text-xs text-[#86868b] hover:text-black">
          ✕
        </a>
      )}
    </form>
  </div>

  <!-- Audit Logs Container: Mobile Cards (< md) + Desktop Table (>= md) -->
  <div class="bg-white rounded-2xl border border-black/5 shadow-xs overflow-hidden">
    {displayLogins.length === 0 ? (
      <div class="py-16 text-center text-xs text-[#86868b]">
        {currentSearch ? `No login events matching "${currentSearch}".` : 'No login activity recorded yet.'}
      </div>
    ) : (
      <>
        <!-- 1. Mobile Cards Layout (< md): 100% full width, zero horizontal scrolling -->
        <div class="block md:hidden divide-y divide-black/5">
          {displayLogins.map((entry) => {
            const locationStr = [entry.city, entry.country].filter(Boolean).join(', ') || 'Global';
            return (
              <div class="p-3.5 space-y-2 bg-white text-xs">
                <!-- Row 1: Email & Local Time -->
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <span class="font-semibold text-[#1d1d1f] truncate block">{entry.email}</span>
                    <span class="font-mono text-[10px] text-[#86868b] truncate block" title={entry.user_id}>{entry.user_id}</span>
                  </div>
                  <span class="text-[11px] text-[#86868b] shrink-0 font-mono">
                    <LocalTime datetime={entry.created_at} showSeconds={true} />
                  </span>
                </div>
                <!-- Row 2: IP, Location & Device info in light grey box -->
                <div class="p-2.5 rounded-xl bg-[#f5f5f7] border border-black/5 space-y-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="font-mono font-medium text-[#1d1d1f]">{entry.ip || '—'}</span>
                    <span class="text-[#52525b]">📍 {locationStr}</span>
                  </div>
                  <p class="text-[10px] text-[#86868b] truncate" title={entry.user_agent}>
                    {entry.user_agent || 'Unknown Device'}
                  </p>
                </div>
              </div>
            );
          })}
        </div>

        <!-- 2. Desktop High-Density Table (>= md) -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-[#fafafa] border-b border-black/5 text-[#86868b] font-medium text-[11px]">
                <th class="py-3 px-4">User Email & ID</th>
                <th class="py-3 px-4">IP Address</th>
                <th class="py-3 px-4">Location</th>
                <th class="py-3 px-4">Client User-Agent</th>
                <th class="py-3 px-4 text-right">Login Timestamp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-black/5">
              {displayLogins.map((entry) => {
                const locationStr = [entry.city, entry.country].filter(Boolean).join(', ') || 'Global / Edge';
                return (
                  <tr class="hover:bg-[#f5f5f7]/60 transition-colors">
                    <td class="py-3 px-4">
                      <div class="font-medium text-[#1d1d1f]">{entry.email}</div>
                      <div class="text-[10px] font-mono text-[#86868b] truncate max-w-[200px]" title={entry.user_id}>
                        {entry.user_id}
                      </div>
                    </td>
                    <td class="py-3 px-4 font-mono text-[11px] text-[#1d1d1f]">
                      {entry.ip ? (
                        <span class="px-2 py-0.5 rounded bg-[#f5f5f7] border border-black/5">
                          {entry.ip}
                        </span>
                      ) : (
                        <span class="text-[#86868b]">—</span>
                      )}
                    </td>
                    <td class="py-3 px-4">
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] bg-zinc-100 text-[#1d1d1f] border border-black/5">
                        📍 {locationStr}
                      </span>
                    </td>
                    <td class="py-3 px-4 text-[11px] text-[#52525b] max-w-xs truncate" title={entry.user_agent}>
                      {entry.user_agent || 'Unknown Client'}
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap font-mono text-[11px]">
                      <LocalTime datetime={entry.created_at} showSeconds={true} />
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    )}
  </div>
</AdminLayout>
