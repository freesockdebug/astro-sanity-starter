---
// src/components/SchemaSyncStatus.astro
import { getSchemaSyncSummary, type SchemaSyncSummary } from '@utils/schemaSync';

interface Props {
  initialSummary?: SchemaSyncSummary;
  showSimulateToggle?: boolean;
}

const {
  initialSummary = getSchemaSyncSummary(false),
  showSimulateToggle = true,
} = Astro.props;

const summary = initialSummary;
---

<div class="schema-sync-dashboard w-full max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 text-slate-900 font-sans" id="schema-sync-root">
  <!-- Top Header with Unboxed Metadata (Principle 1.A) -->
  <header class="border-b border-slate-200 pb-6 mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">
          <span>Sanity Studio v3</span>
          <span aria-hidden="true">·</span>
          <span>Astro Edge SSR</span>
          <span aria-hidden="true">·</span>
          <span>Principle I.6 High Cohesion</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900">
          Schema & Data Projection Sync Monitor
        </h1>
        <p class="mt-1 text-sm text-slate-600 max-w-2xl">
          Visual inspection of data contracts across Sanity document schemas, frontend GROQ projections, and shared TypeScript interfaces.
        </p>
      </div>

      <!-- Action Toolbar -->
      <div class="flex items-center gap-3">
        {showSimulateToggle && (
          <button
            type="button"
            id="toggle-drift-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium rounded-md border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 shadow-sm transition-colors cursor-pointer"
            title="Inject simulated schema drift to preview out-of-sync highlighting"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
            <span id="drift-btn-text">Simulate Out-of-Sync Drift</span>
          </button>
        )}
        <button
          type="button"
          id="refresh-sync-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-md bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Refresh Analysis</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Metric Overview Cards -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="p-5 rounded-lg border border-slate-200 bg-white shadow-xs">
      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Sync Integrity</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-3xl font-semibold tracking-tight text-slate-900" id="stat-percentage">
          {summary.overallSyncPercentage}%
        </span>
        <span class="text-xs text-slate-500">of all fields</span>
      </div>
      <div class="mt-3 w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
        <div
          id="stat-progress-bar"
          class={`h-full transition-all duration-500 ${
            summary.totalOutOfSyncFields === 0 ? 'bg-emerald-600' : 'bg-amber-500'
          }`}
          style={`width: ${summary.overallSyncPercentage}%`}
        ></div>
      </div>
    </div>

    <div class="p-5 rounded-lg border border-slate-200 bg-white shadow-xs">
      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Compared Contracts</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-3xl font-semibold tracking-tight text-slate-900" id="stat-docs">
          {summary.fullySyncedDocumentsCount}/{summary.totalDocuments}
        </span>
        <span class="text-xs text-slate-500">fully verified</span>
      </div>
      <div class="mt-3 text-xs text-slate-500">
        Covering core documents & nested blocks
      </div>
    </div>

    <div class="p-5 rounded-lg border border-slate-200 bg-white shadow-xs">
      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Fields Analyzed</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-3xl font-semibold tracking-tight text-slate-900" id="stat-fields">
          {summary.totalFieldsCompared}
        </span>
        <span class="text-xs text-slate-500">properties</span>
      </div>
      <div class="mt-3 text-xs text-slate-500">
        Studio, GROQ, and TypeScript combined
      </div>
    </div>

    <div class="p-5 rounded-lg border border-slate-200 bg-white shadow-xs">
      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Out-of-Sync Alerts</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span
          id="stat-alerts"
          class={`text-3xl font-semibold tracking-tight ${
            summary.totalOutOfSyncFields === 0 ? 'text-emerald-600' : 'text-rose-600'
          }`}
        >
          {summary.totalOutOfSyncFields}
        </span>
        <span class="text-xs text-slate-500">issues detected</span>
      </div>
      <div class="mt-3 text-xs" id="stat-alert-desc">
        {summary.totalOutOfSyncFields === 0 ? (
          <span class="text-emerald-700">✓ All contracts 100% in sync</span>
        ) : (
          <span class="text-rose-600 font-medium">Attention required on drifting fields</span>
        )}
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 rounded-lg border border-slate-200 bg-slate-50 mb-6">
    <!-- Document Selector Buttons -->
    <div class="flex flex-wrap items-center gap-1.5" id="doc-filters">
      <button
        type="button"
        data-filter-doc="all"
        class="filter-doc-btn active px-3 py-1.5 text-xs font-medium rounded-md bg-white text-slate-900 shadow-xs border border-slate-300 transition-colors cursor-pointer"
      >
        All Documents ({summary.documents.length})
      </button>
      {summary.documents.map((doc) => (
        <button
          type="button"
          data-filter-doc={doc.id}
          class="filter-doc-btn px-3 py-1.5 text-xs font-medium rounded-md bg-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-200/60 transition-colors cursor-pointer"
        >
          {doc.schemaName}
        </button>
      ))}
    </div>

    <!-- Status Tabs & Search -->
    <div class="flex flex-wrap items-center gap-3">
      <div class="inline-flex p-1 bg-slate-200/70 rounded-lg text-xs" id="status-filters">
        <button
          type="button"
          data-filter-status="all"
          class="filter-status-btn active px-2.5 py-1 font-medium rounded-md bg-white text-slate-900 shadow-xs transition-colors cursor-pointer"
        >
          All
        </button>
        <button
          type="button"
          data-filter-status="issues"
          class="filter-status-btn px-2.5 py-1 font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors cursor-pointer"
        >
          Out-of-Sync Only
        </button>
        <button
          type="button"
          data-filter-status="synced"
          class="filter-status-btn px-2.5 py-1 font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors cursor-pointer"
        >
          Synced Only
        </button>
      </div>

      <!-- Live Search Box -->
      <div class="relative w-48 sm:w-56">
        <input
          type="text"
          id="field-search-input"
          placeholder="Filter field name..."
          class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-slate-300 rounded-md placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-900 focus:border-slate-900"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Document Contract Breakdown Containers -->
  <section class="space-y-6" id="documents-container">
    {summary.documents.map((doc) => (
      <div
        class="doc-card border border-slate-200 rounded-lg bg-white overflow-hidden shadow-xs transition-shadow"
        data-doc-id={doc.id}
      >
        <!-- Card Header -->
        <div class="p-5 border-b border-slate-200 bg-slate-50/70 flex flex-col md:flex-row md:items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-base font-semibold text-slate-900 font-mono">
                {doc.schemaName}
              </h2>
              <span class="text-xs text-slate-500 font-sans">
                ({doc.title})
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 mt-1 font-mono">
              <span>Studio Schema: <strong>{doc.schemaName}</strong> ({doc.totalStudioFields} fields)</span>
              <span aria-hidden="true">·</span>
              <span>GROQ: <strong>{doc.dataLabel}</strong></span>
              <span aria-hidden="true">·</span>
              <span>TS Interface: <strong>{doc.tsInterface}</strong></span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="text-right">
              <div class="text-xs font-semibold text-slate-900">
                {doc.syncedFieldsCount} / {doc.fields.length} In Sync
              </div>
              <div class="text-xs text-slate-500">
                {doc.syncPercentage}% synchronized
              </div>
            </div>
            <span
              class={`px-2.5 py-1 text-xs font-medium rounded-md border ${
                doc.isFullySynced
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  : 'bg-rose-50 text-rose-800 border-rose-200 animate-pulse'
              }`}
            >
              {doc.isFullySynced ? '✓ 100% Synced' : `${doc.outOfSyncCount} Out of Sync`}
            </span>
          </div>
        </div>

        <!-- Field Comparison Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-100/60 text-slate-600 font-medium font-mono uppercase tracking-wider">
                <th class="py-2.5 px-4">Field Name</th>
                <th class="py-2.5 px-4">Type</th>
                <th class="py-2.5 px-4 text-center">Studio Schema</th>
                <th class="py-2.5 px-4 text-center">Frontend GROQ</th>
                <th class="py-2.5 px-4 text-center">TS Interface</th>
                <th class="py-2.5 px-4">Sync Status & Resolution</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-sans">
              {doc.fields.map((f) => {
                const isOutOfSync = !f.isAllowedExtra && f.status !== 'synced';
                let rowBg = 'hover:bg-slate-50/80';
                if (isOutOfSync) {
                  rowBg = 'bg-rose-50/40 hover:bg-rose-50/70';
                }

                return (
                  <tr
                    class={`field-row transition-colors ${rowBg}`}
                    data-field-name={f.name}
                    data-is-issue={isOutOfSync ? 'true' : 'false'}
                  >
                    <!-- Field Name -->
                    <td class="py-2.5 px-4 font-mono font-medium text-slate-900">
                      <div class="flex items-center gap-1.5">
                        {isOutOfSync && (
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span>
                        )}
                        <span>{f.name}</span>
                      </div>
                    </td>

                    <!-- Type -->
                    <td class="py-2.5 px-4 font-mono text-slate-500">
                      {f.studioType || 'string'}
                    </td>

                    <!-- Studio Schema -->
                    <td class="py-2.5 px-4 text-center font-mono">
                      {f.inStudio ? (
                        <span class="text-emerald-700 font-bold" title="Field is declared in Sanity Studio schema">✓</span>
                      ) : (
                        <span class="text-slate-300" title="Not declared in Studio schema">-</span>
                      )}
                    </td>

                    <!-- Frontend Data / GROQ -->
                    <td class="py-2.5 px-4 text-center font-mono">
                      {f.inData ? (
                        <span class="text-emerald-700 font-bold" title="Field is projected in GROQ or defaults">✓</span>
                      ) : (
                        <span class="text-rose-600 font-bold" title="Missing from frontend GROQ projection!">✖</span>
                      )}
                    </td>

                    <!-- TypeScript Interface -->
                    <td class="py-2.5 px-4 text-center font-mono">
                      {f.inTs ? (
                        <span class="text-emerald-700 font-bold" title="Field is declared in types/index.ts">✓</span>
                      ) : (
                        <span class="text-amber-600 font-bold" title="Missing from types/index.ts!">✖</span>
                      )}
                    </td>

                    <!-- Status Description & Badge -->
                    <td class="py-2.5 px-4">
                      {f.status === 'synced' && (
                        <div class="flex items-center gap-1.5 text-emerald-800">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          <span class="font-medium">In Sync</span>
                        </div>
                      )}
                      {f.status === 'missing_data' && (
                        <div class="flex flex-col gap-0.5">
                          <span class="inline-flex items-center gap-1 text-rose-700 font-semibold">
                            ✖ Missing in GROQ Projection
                          </span>
                          <span class="text-slate-500 text-[11px]">
                            Add <code>"{f.name}"</code> to <code>{doc.dataLabel}</code>
                          </span>
                        </div>
                      )}
                      {f.status === 'missing_ts' && (
                        <div class="flex flex-col gap-0.5">
                          <span class="inline-flex items-center gap-1 text-amber-700 font-semibold">
                            ✖ Missing in TypeScript Interface
                          </span>
                          <span class="text-slate-500 text-[11px]">
                            Add <code>{f.name}?: {f.studioType === 'boolean' ? 'boolean' : 'string'};</code> to <code>types/index.ts</code>
                          </span>
                        </div>
                      )}
                      {f.status === 'missing_both' && (
                        <div class="flex flex-col gap-0.5">
                          <span class="inline-flex items-center gap-1 text-rose-800 font-bold">
                            🚨 Missing in Both Frontend & TS
                          </span>
                          <span class="text-rose-600 text-[11px]">
                            Update both <code>src/data</code> and <code>types/index.ts</code>
                          </span>
                        </div>
                      )}
                      {f.status === 'extra_data' && (
                        <div class="flex items-center gap-1 text-slate-600">
                          <span class="text-slate-400">ℹ</span>
                          <span>{f.isAllowedExtra ? 'Approved Frontend Fallback' : 'Extra Ghost Property'}</span>
                        </div>
                      )}
                      {f.status === 'extra_ts' && (
                        <div class="flex items-center gap-1 text-slate-600">
                          <span class="text-slate-400">ℹ</span>
                          <span>{f.isAllowedExtra ? 'Approved UI Interface Property' : 'Unmapped TS Property'}</span>
                        </div>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>

  <!-- Empty Search Results Placeholder (Hidden by default) -->
  <div id="no-search-results" class="hidden p-12 text-center border border-dashed border-slate-300 rounded-lg bg-white my-8">
    <p class="text-sm font-medium text-slate-900">No matching fields found</p>
    <p class="text-xs text-slate-500 mt-1">Try clearing your search keyword or switching document filter.</p>
  </div>
</div>

<script is:inline>
  // Pure JavaScript client logic without any TypeScript syntax
  (function initSchemaSyncDashboard() {
    var activeDocFilter = 'all';
    var activeStatusFilter = 'all';
    var currentSearch = '';
    var isSimulatedDrift = false;

    var docButtons = document.querySelectorAll('#doc-filters button');
    var statusButtons = document.querySelectorAll('#status-filters button');
    var searchInput = document.getElementById('field-search-input');
    var toggleDriftBtn = document.getElementById('toggle-drift-btn');
    var driftBtnText = document.getElementById('drift-btn-text');
    var refreshBtn = document.getElementById('refresh-sync-btn');
    var noResultsBox = document.getElementById('no-search-results');

    function applyFilters() {
      var docCards = document.querySelectorAll('.doc-card');
      var totalVisibleFields = 0;

      docCards.forEach(function (card) {
        var docId = card.getAttribute('data-doc-id');
        var matchesDoc = (activeDocFilter === 'all' || activeDocFilter === docId);

        if (!matchesDoc) {
          card.style.display = 'none';
          return;
        }

        var rows = card.querySelectorAll('.field-row');
        var visibleRowsInDoc = 0;

        rows.forEach(function (row) {
          var fieldName = (row.getAttribute('data-field-name') || '').toLowerCase();
          var isIssue = row.getAttribute('data-is-issue') === 'true';

          var matchesStatus = true;
          if (activeStatusFilter === 'issues') {
            matchesStatus = isIssue;
          } else if (activeStatusFilter === 'synced') {
            matchesStatus = !isIssue;
          }

          var matchesSearch = true;
          if (currentSearch.trim() !== '') {
            matchesSearch = fieldName.indexOf(currentSearch.toLowerCase().trim()) !== -1;
          }

          if (matchesStatus && matchesSearch) {
            row.style.display = '';
            visibleRowsInDoc++;
            totalVisibleFields++;
          } else {
            row.style.display = 'none';
          }
        });

        if (visibleRowsInDoc > 0) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultsBox) {
        if (totalVisibleFields === 0) {
          noResultsBox.classList.remove('hidden');
        } else {
          noResultsBox.classList.add('hidden');
        }
      }
    }

    docButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        docButtons.forEach(function (b) {
          b.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'border', 'border-slate-300');
          b.classList.add('bg-transparent', 'text-slate-600');
        });
        btn.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'border', 'border-slate-300');
        btn.classList.remove('bg-transparent', 'text-slate-600');
        activeDocFilter = btn.getAttribute('data-filter-doc') || 'all';
        applyFilters();
      });
    });

    statusButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        statusButtons.forEach(function (b) {
          b.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-xs');
          b.classList.add('text-slate-600');
        });
        btn.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-xs');
        btn.classList.remove('text-slate-600');
        activeStatusFilter = btn.getAttribute('data-filter-status') || 'all';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function (e) {
        currentSearch = e.target.value || '';
        applyFilters();
      });
    }

    if (toggleDriftBtn) {
      toggleDriftBtn.addEventListener('click', function () {
        isSimulatedDrift = !isSimulatedDrift;
        var url = new URL(window.location.href);
        if (isSimulatedDrift) {
          url.searchParams.set('drift', 'true');
        } else {
          url.searchParams.delete('drift');
        }
        window.location.href = url.toString();
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () {
        window.location.reload();
      });
    }

    // Check if drift parameter is active on initial load
    var urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('drift') === 'true') {
      isSimulatedDrift = true;
      if (driftBtnText) {
        driftBtnText.innerText = 'Reset Simulated Drift (Active)';
      }
      if (toggleDriftBtn) {
        toggleDriftBtn.classList.add('border-amber-400', 'bg-amber-50');
      }
    }
  })();
</script>
