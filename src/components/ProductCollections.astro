---
// src/components/ProductCollections.astro
import { fetchNormalizedProducts, ProductService } from '@data/products';
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { SanityImageService } from '@utils/image';
import { DEFAULT_COLLECTIONS, DEFAULT_HERO } from '@data/defaults';
import { getLangFromUrl, getLocalizedPath, getLocalizedValue, toText, useTranslations } from '@i18n';
import ProductGridSkeleton from './ProductGridSkeleton.astro';

interface Props {
  elementId?: string;
  sectionAnchor?: string;
  badge?: string;
  title?: string;
  subtitle?: string;
  swatchSku?: string;
  showActionButton?: boolean;
  actionButtonText?: string;
  actionButtonUrl?: string;
  showCardQuoteButton?: boolean;
  cardDetailsButtonText?: string;
  cardQuoteButtonText?: string;
  products?: any[];
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
  elementId,
  sectionAnchor,
  badge,
  title,
  subtitle,
  swatchSku,
  showActionButton: propShowAction,
  actionButtonText: propActionText,
  actionButtonUrl = DEFAULT_HERO.primaryButtonUrl,
  showCardQuoteButton: propShowCardQuote,
  cardDetailsButtonText = t('catalog.viewDetail'),
  cardQuoteButtonText,
  products: propProducts
} = Astro.props;

const safeBadge = toText(badge, currentLang) || t('catalog.badge') || DEFAULT_COLLECTIONS.badge;
const safeTitle = toText(title, currentLang) || t('catalog.title') || DEFAULT_COLLECTIONS.title;
const safeSubtitle = toText(subtitle, currentLang) || t('catalog.subtitle') || DEFAULT_COLLECTIONS.subtitle;

const rfqSettings = await fetchRfqSettings();
const actionButtonText = toText(propActionText, currentLang) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));
const resolvedCardQuoteText = toText(cardQuoteButtonText, currentLang) || getLocalizedValue(rfqSettings?.cardQuoteBtnText, currentLang, t('catalog.requestQuote'));
const cardDetailsText = toText(cardDetailsButtonText, currentLang, t('catalog.viewDetail'));

// Only display products added to this section in Sanity Studio; unadded products fall back to normalized catalog
const normalizedProducts = propProducts !== undefined
  ? propProducts.map((p: any) => ProductService.normalize(p, 480))
  : await fetchNormalizedProducts(480);

const activeCollections = normalizedProducts.map((p) => {
  const localizedTitle = getLocalizedValue(p.title, currentLang);
  const localizedShortTitle = getLocalizedValue(p.shortTitle, currentLang) || localizedTitle;
  return {
    ...p,
    title: localizedShortTitle,
    fullTitle: localizedTitle,
    composition: getLocalizedValue(p.composition, currentLang),
    gauge: getLocalizedValue(p.gauge, currentLang),
  };
});

const isSwatchAction = (actionButtonText || "").toLowerCase().includes("swatch") || actionButtonUrl === "#inquiry";
const showHeaderActionButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowAction,
  settingOverride: rfqSettings?.showCollectionsHeaderButton,
  isSwatchAction,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: actionButtonText,
});

const showCardQuoteButton = propShowCardQuote !== undefined
  ? Boolean(propShowCardQuote)
  : (rfqSettings?.showCardQuoteButton ?? true);

const sectionId = elementId || sectionAnchor || 'collections';
---

<section id={sectionId} class="bg-canvas text-ink border-t border-hairline flex flex-col">
  <div class="apple-rail-bento w-full flex flex-col">
    <!-- Section Header (Centered & Airy) -->
    <div class="apple-rail-narrow text-center mb-10 lg:mb-14 space-y-3 shrink-0">
      <span class="text-xs font-medium uppercase tracking-[0.14em] text-muted block">{safeBadge}</span>
      <h2 class="fluid-section-title font-display font-medium text-ink">
        {safeTitle}
      </h2>
      <p class="text-[15px] sm:text-[17px] text-muted max-w-2xl mx-auto font-normal leading-relaxed">
        {safeSubtitle}
      </p>
      <div class="pt-3 flex flex-wrap items-center justify-center gap-3">
        {showHeaderActionButton && (
          <a
            href={getLocalizedPath(actionButtonUrl, currentLang)}
            data-swatch-sku={swatchSku}
            class="px-5 py-2 rounded-full text-xs sm:text-sm font-medium bg-ink text-canvas hover:opacity-85 transition-opacity inline-flex items-center gap-1.5"
          >
            <span>{actionButtonText}</span>
            <span aria-hidden="true">›</span>
          </a>
        )}
        <a
          href={getLocalizedPath('/products', currentLang)}
          class="px-5 py-2 rounded-full text-xs sm:text-sm font-medium bg-surface hover:bg-elevated text-ink border border-hairline transition-colors inline-flex items-center gap-1.5"
        >
          <span>{t('catalog.browseAll')}</span>
          <span aria-hidden="true">›</span>
        </a>
        <!-- Desktop Carousel Navigation Buttons -->
        <div id="collections-arrows-container" class="hidden sm:inline-flex items-center gap-1.5">
          <button
            id="collections-prev-btn"
            type="button"
            aria-label="Previous products"
            class="w-8 h-8 rounded-full bg-surface hover:bg-elevated text-ink flex items-center justify-center transition-colors border border-hairline cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            id="collections-next-btn"
            type="button"
            aria-label="Next products"
            class="w-8 h-8 rounded-full bg-surface hover:bg-elevated text-ink flex items-center justify-center transition-colors border border-hairline cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Collection Shelf: Lookbook Gallery Cards -->
    {activeCollections.length === 0 ? (
      <ProductGridSkeleton variant="shelf" count={4} id="collections-shelf-skeleton" />
    ) : (
      <div
        id="collections-shelf"
        class="flex overflow-x-auto snap-x snap-mandatory gap-5 sm:gap-6 pb-2 pt-1 no-scrollbar scroll-smooth items-stretch"
      >
        {activeCollections.map((item: any) => (
          <div class="group shrink-0 w-[76vw] max-w-[290px] sm:w-[300px] lg:w-[310px] snap-start flex flex-col">
            <!-- 1. 4:5 Gallery Image Container + Hover-revealed Quote Button -->
            <div class="relative w-full aspect-[4/5] rounded-[var(--gv-radius-card)] overflow-hidden bg-surface apple-skeleton-surface">
              <a href={getLocalizedPath(`/products/${item.id}`, currentLang)} class="block w-full h-full">
                <img
                  src={item.image}
                  srcset={SanityImageService.srcSet(item.image, [280, 480]) || undefined}
                  sizes="(max-width: 640px) 280px, 340px"
                  width="280"
                  height="350"
                  alt={item.title}
                  class="shelf-card-img w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                  onload="this.parentElement && (this.parentElement.parentElement?.classList.add('apple-img-loaded'), this.parentElement.parentElement?.classList.remove('is-shimmer-active'), window.__unobserveAppleShimmer && window.__unobserveAppleShimmer(this.parentElement.parentElement))"
                />
              </a>
              {showCardQuoteButton && (
                <button
                  type="button"
                  class="btn-card-add-quote absolute bottom-3 right-3 z-10 px-3.5 py-2 rounded-full text-xs font-medium bg-canvas/95 backdrop-blur-md text-ink border border-hairline hover:bg-ink hover:text-canvas transition-all duration-300 lg:opacity-0 lg:translate-y-1 lg:group-hover:opacity-100 lg:group-hover:translate-y-0 cursor-pointer flex items-center gap-1"
                  data-id={item.id}
                  data-sku={item.sku || item.id}
                  data-title={item.title}
                  data-image={item.image}
                  data-moq={item.moq}
                  title="Add to Quote Basket (RFQ)"
                >
                  <span aria-hidden="true">+</span>
                  <span>{resolvedCardQuoteText}</span>
                </button>
              )}
            </div>

            <!-- 2. Clean 3-layer Lookbook Info -->
            <div class="pt-3.5 space-y-1.5">
              <a href={getLocalizedPath(`/products/${item.id}`, currentLang)} class="block">
                <h3 class="text-[15px] sm:text-base font-medium text-ink leading-snug line-clamp-1">
                  {item.title}
                </h3>
              </a>
              <p class="text-[13px] text-muted line-clamp-1">{item.composition}</p>
              <div class="pt-1 flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  {item.colors.slice(0, 5).map((colorHex: string) => (
                    <span
                      class="w-3 h-3 rounded-full border border-hairline block"
                      style={`background-color: ${colorHex}`}
                      title={`Color: ${colorHex}`}
                    ></span>
                  ))}
                </div>
                <span class="text-xs font-mono text-muted">MOQ {item.moq}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Swipe / Scroll Visual Hint -->
    <div id="collections-scroll-hint" class="shrink-0 flex items-center justify-center gap-1.5 pt-6 text-xs font-medium text-muted">
      <span class="sm:hidden">{t('collections.swipeHint')}</span>
      <span class="hidden sm:inline">{t('collections.scrollHint')}</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</section>

<script>
  import { addToQuote } from '@stores/quoteCart';
  import { useIntersectionShimmer } from '@utils/useIntersectionShimmer';

  const shelfShimmer = useIntersectionShimmer('#collections-shelf .apple-skeleton-surface', {
    rootMargin: '160px 160px',
  });

  // Mark already-cached shelf images as loaded so progressive Apple shimmer stops cleanly
  const syncShelfLoadedImages = () => {
    document.querySelectorAll('.shelf-card-img').forEach((img) => {
      const htmlImg = img as HTMLImageElement;
      if (htmlImg.complete && htmlImg.parentElement) {
        htmlImg.parentElement.classList.add('apple-img-loaded');
        htmlImg.parentElement.classList.remove('is-shimmer-active');
        shelfShimmer.unobserve(htmlImg.parentElement);
      }
    });
  };
  syncShelfLoadedImages();
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(syncShelfLoadedImages, { timeout: 600 });
  } else {
    setTimeout(syncShelfLoadedImages, 120);
  }

  // Desktop horizontal shelf scroll arrows & dynamic centering
  const shelf = document.getElementById('collections-shelf');
  const arrowsContainer = document.getElementById('collections-arrows-container');
  const scrollHint = document.getElementById('collections-scroll-hint');
  const prevBtn = document.getElementById('collections-prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('collections-next-btn') as HTMLButtonElement | null;

  let arrowStatesRaf = 0;
  function updateArrowStates() {
    if (arrowStatesRaf) return;
    arrowStatesRaf = requestAnimationFrame(() => {
      arrowStatesRaf = 0;
      if (!shelf || !prevBtn || !nextBtn) return;
      const { scrollLeft, scrollWidth, clientWidth } = shelf;
      prevBtn.disabled = scrollLeft <= 10;
      nextBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 10;
    });
  }

  function checkShelfOverflow() {
    if (!shelf) return;
    const children = Array.from(shelf.children) as HTMLElement[];
    if (children.length === 0) return;

    let totalWidth = 0;
    children.forEach((child) => {
      totalWidth += child.offsetWidth;
    });

    const gap = parseFloat(window.getComputedStyle(shelf).gap || '24') || 24;
    totalWidth += (children.length - 1) * gap;

    // Compare total products width against container client width
    const isOverflowing = totalWidth > shelf.clientWidth + 2;

    if (isOverflowing) {
      shelf.classList.remove('justify-center');
      shelf.classList.add('justify-start');
      if (arrowsContainer) arrowsContainer.style.display = '';
      if (scrollHint) scrollHint.style.display = '';
      updateArrowStates();
    } else {
      shelf.classList.remove('justify-start');
      shelf.classList.add('justify-center');
      if (arrowsContainer) arrowsContainer.style.display = 'none';
      if (scrollHint) scrollHint.style.display = 'none';
    }
  }

  // Initial check & reactive resize observer
  checkShelfOverflow();

  if (typeof ResizeObserver !== 'undefined' && shelf) {
    const ro = new ResizeObserver(() => {
      checkShelfOverflow();
    });
    ro.observe(shelf);
  } else {
    window.addEventListener('resize', checkShelfOverflow, { passive: true });
  }

  shelf?.addEventListener('scroll', updateArrowStates, { passive: true });

  // Dynamic lattice constant step calculation (eliminating phase drift)
  function getLatticeStep(): number {
    if (!shelf) return 340;
    const firstCard = (shelf.querySelector('.group') || shelf.firstElementChild) as HTMLElement | null;
    const cardWidth = firstCard?.offsetWidth || 320;
    const gap = parseFloat(window.getComputedStyle(shelf).gap || '24') || 24;
    return cardWidth + gap;
  }

  prevBtn?.addEventListener('click', () => {
    shelf?.scrollBy({ left: -getLatticeStep(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    shelf?.scrollBy({ left: getLatticeStep(), behavior: 'smooth' });
  });

  document.querySelectorAll('.btn-card-add-quote').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.getAttribute('data-id') || '';
      const sku = btn.getAttribute('data-sku') || id.toUpperCase();
      const title = btn.getAttribute('data-title') || '';
      const imageUrl = btn.getAttribute('data-image') || '';
      const rawMoq = btn.getAttribute('data-moq') || '200';
      const moqNum = parseInt(rawMoq.replace(/\D/g, ''), 10) || 200;

      addToQuote({
        id,
        title,
        sku,
        imageUrl,
        variant: 'Curated Sample',
        quantity: moqNum,
        moq: rawMoq,
      });

      if ((window as any).openQuoteDrawer) {
        (window as any).openQuoteDrawer();
      }
    });
  });
  document.querySelectorAll<HTMLImageElement>('.shelf-card-img').forEach((img) => {
    if (img.complete && img.naturalWidth > 0 && img.parentElement) {
      img.parentElement.classList.add('apple-img-loaded');
      img.parentElement.classList.remove('is-shimmer-active');
      if ((window as any).__unobserveAppleShimmer) {
        (window as any).__unobserveAppleShimmer(img.parentElement);
      }
    }
  });
</script>
