---
// src/components/ManufacturingCapabilities.astro
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { DEFAULT_MANUFACTURING } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedPath, getLocalizedValue } from '@i18n';

interface Props {
  elementId?: string;
  sectionAnchor?: string;
  badge?: string;
  headline?: string;
  subline?: string;
  capabilities?: Array<{ title: string; description: string }>;
  actionButtonText?: string;
  actionButtonUrl?: string;
  showActionButton?: boolean;
  swatchSku?: string;
}

const {
  elementId,
  sectionAnchor,
  badge = DEFAULT_MANUFACTURING.badge,
  headline = DEFAULT_MANUFACTURING.headline,
  subline = DEFAULT_MANUFACTURING.subline,
  capabilities = DEFAULT_MANUFACTURING.capabilities,
  actionButtonText: propActionText,
  actionButtonUrl = "#inquiry",
  swatchSku,
  showActionButton: propShowAction
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Safe text extractor: resolves Sanity multilingual object ({ en: '...' }) or string safely without throwing .trim errors
const toText = (val: any, fallback = ''): string => {
  if (val === null || val === undefined) return fallback;
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    const loc = getLocalizedValue(val, currentLang);
    return typeof loc === 'string' ? loc.trim() : (loc ? String(loc).trim() : fallback);
  }
  return String(val).trim();
};

const safeBadge = toText(badge, DEFAULT_MANUFACTURING.badge);
const safeHeadline = toText(headline, DEFAULT_MANUFACTURING.headline);
const safeSubline = toText(subline, DEFAULT_MANUFACTURING.subline);

const rfqSettings = await fetchRfqSettings();
const actionButtonText = toText(propActionText) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));

const isSwatchAction = (actionButtonText || "").toLowerCase().includes("swatch") || actionButtonUrl === "#inquiry";
const showActionButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowAction,
  settingOverride: rfqSettings?.showManufacturingActionButton,
  isSwatchAction,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: actionButtonText,
});
// Helper to extract a prominent stat or badge from capability title
function extractStat(title: string, index: number) {
  const match = (title || "").match(/^([0-9]+[a-zA-Z+]*)/);
  if (match) return match[1];
  const defaults = ["350+", "72h", "100%", "ISO"];
  return defaults[index] || "✓";
}

function extractCleanTitle(title: string) {
  return (title || "").replace(/^([0-9]+[a-zA-Z+]*\s*)/, '').trim() || title;
}

const footers = [t('mfg.footer0'), t('mfg.footer1'), t('mfg.footer2'), t('mfg.footer3')];
const sectionId = elementId || sectionAnchor || 'manufacturing';
---

<section id={sectionId} class="bg-canvas text-ink border-t border-hairline">
  <div class="apple-rail-bento w-full">
    <div class="apple-rail-narrow text-center mb-12 lg:mb-16 space-y-3">
      <span class="text-xs font-medium uppercase tracking-[0.14em] text-muted block">{safeBadge}</span>
      <h2 class="fluid-section-title font-display font-medium text-ink">
        {safeHeadline}
      </h2>
      <p class="text-muted text-[15px] sm:text-[17px] font-normal leading-relaxed max-w-2xl mx-auto">
        {safeSubline}
      </p>
    </div>

    <!-- Feature Cards: Horizontal Scroll on Mobile, Grid on Desktop -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 lg:gap-5 pb-3 pt-1 no-scrollbar md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-visible md:p-0">
      {capabilities.map((cap: any, idx: number) => (
        <div class="shrink-0 w-[80vw] max-w-[300px] snap-start md:w-full md:max-w-none md:shrink md:snap-align-none p-6 rounded-[var(--gv-radius-card)] bg-surface border border-hairline flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl font-semibold tracking-tight text-ink font-mono">
                {extractStat(cap.title, idx)}
              </span>
              <div class="w-9 h-9 rounded-lg bg-elevated border border-hairline flex items-center justify-center text-ink">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
            </div>
            <h3 class="mt-4 text-base sm:text-[17px] font-medium text-ink">{extractCleanTitle(cap.title)}</h3>
            <p class="mt-1.5 text-[14px] sm:text-[15px] text-muted leading-relaxed">
              {cap.description}
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-hairline text-xs text-muted font-medium flex items-center justify-between">
            <span class="truncate">{footers[idx] || "Global Export Standard"}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Swipe Visual Hint -->
    <div class="flex md:hidden items-center justify-center gap-1.5 pt-4 text-xs font-medium text-muted">
      <span>{t('manufacturing.swipeHint')}</span>
      <span aria-hidden="true">→</span>
    </div>

    {showActionButton && (
      <div class="mt-10 sm:mt-12 text-center">
        <a
          href={getLocalizedPath(actionButtonUrl || "#inquiry", currentLang)}
          data-swatch-sku={swatchSku}
          class="inline-flex items-center justify-center gap-1.5 px-7 py-3 rounded-full text-sm font-medium bg-ink text-canvas hover:opacity-85 transition-opacity"
        >
          <span>{actionButtonText}</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    )}
  </div>
</section>
