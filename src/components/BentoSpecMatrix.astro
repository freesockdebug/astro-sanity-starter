---
// src/components/BentoSpecMatrix.astro
import { fetchRfqSettings, RfqSettingsService } from '@data/rfqSettings';
import { SanityImageService } from '@utils/image';
import { DEFAULT_SPEC_MATRIX } from '@data/defaults';
import { getLangFromUrl, useTranslations, getLocalizedPath, getLocalizedValue } from '@i18n';

interface Props {
  elementId?: string;
  sectionAnchor?: string;
  badge?: string;
  title?: string;
  description?: string;
  macroImage?: string;
  swatchSku?: string;
  showPrimaryButton?: boolean;
  primaryButtonText?: string;
  primaryButtonUrl?: string;
  showSecondaryButton?: boolean;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  // Bento 1
  bento1Tag?: string;
  bento1Title?: string;
  bento1Description?: string;
  // Bento 2
  bento2Tag?: string;
  bento2Stat?: string;
  bento2Unit?: string;
  bento2Title?: string;
  bento2Description?: string;
  bento2BadgeText?: string;
  bento2BadgeStatus?: string;
  // Bento 3
  bento3Tag?: string;
  bento3Stat?: string;
  bento3Unit?: string;
  bento3Title?: string;
  bento3Description?: string;
  bento3FooterNote?: string;
  // Bento 4
  bento4Tag?: string;
  bento4Stat?: string;
  bento4Unit?: string;
  bento4Title?: string;
  bento4Description?: string;
  bento4FooterNote?: string;
  // Bento 5
  bento5Tag?: string;
  bento5Stat?: string;
  bento5Unit?: string;
  bento5Title?: string;
  bento5Description?: string;
  bento5FooterNote?: string;
}

const {
  badge = DEFAULT_SPEC_MATRIX.badge,
  title = DEFAULT_SPEC_MATRIX.title,
  description = DEFAULT_SPEC_MATRIX.description,
  macroImage: propMacroImage,
  swatchSku,
  showPrimaryButton: propShowPrimary,
  primaryButtonText: propPrimaryText,
  primaryButtonUrl = DEFAULT_SPEC_MATRIX.primaryButtonUrl,
  showSecondaryButton: propShowSecondary,
  secondaryButtonText = DEFAULT_SPEC_MATRIX.secondaryButtonText,
  secondaryButtonUrl = DEFAULT_SPEC_MATRIX.secondaryButtonUrl,
  // Bento 1
  bento1Tag = DEFAULT_SPEC_MATRIX.bento1Tag,
  bento1Title = DEFAULT_SPEC_MATRIX.bento1Title,
  bento1Description = DEFAULT_SPEC_MATRIX.bento1Description,
  // Bento 2
  bento2Tag = DEFAULT_SPEC_MATRIX.bento2Tag,
  bento2Stat = DEFAULT_SPEC_MATRIX.bento2Stat,
  bento2Unit = DEFAULT_SPEC_MATRIX.bento2Unit,
  bento2Title = DEFAULT_SPEC_MATRIX.bento2Title,
  bento2Description = DEFAULT_SPEC_MATRIX.bento2Description,
  bento2BadgeText = DEFAULT_SPEC_MATRIX.bento2BadgeText,
  bento2BadgeStatus = DEFAULT_SPEC_MATRIX.bento2BadgeStatus,
  // Bento 3
  bento3Tag = DEFAULT_SPEC_MATRIX.bento3Tag,
  bento3Stat = DEFAULT_SPEC_MATRIX.bento3Stat,
  bento3Unit = DEFAULT_SPEC_MATRIX.bento3Unit,
  bento3Title = DEFAULT_SPEC_MATRIX.bento3Title,
  bento3Description = DEFAULT_SPEC_MATRIX.bento3Description,
  bento3FooterNote = DEFAULT_SPEC_MATRIX.bento3FooterNote,
  // Bento 4
  bento4Tag = DEFAULT_SPEC_MATRIX.bento4Tag,
  bento4Stat = DEFAULT_SPEC_MATRIX.bento4Stat,
  bento4Unit = DEFAULT_SPEC_MATRIX.bento4Unit,
  bento4Title = DEFAULT_SPEC_MATRIX.bento4Title,
  bento4Description = DEFAULT_SPEC_MATRIX.bento4Description,
  bento4FooterNote = DEFAULT_SPEC_MATRIX.bento4FooterNote,
  // Bento 5
  bento5Tag = DEFAULT_SPEC_MATRIX.bento5Tag,
  bento5Stat = DEFAULT_SPEC_MATRIX.bento5Stat,
  bento5Unit = DEFAULT_SPEC_MATRIX.bento5Unit,
  bento5Title = DEFAULT_SPEC_MATRIX.bento5Title,
  bento5Description = DEFAULT_SPEC_MATRIX.bento5Description,
  bento5FooterNote = DEFAULT_SPEC_MATRIX.bento5FooterNote,
  elementId,
  sectionAnchor,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Safe text extractor: resolves Sanity multilingual object ({ en: '...' }) or string safely without throwing .trim errors
const toText = (val: any, fallback = ''): string => {
  if (val === null || val === undefined) return fallback;
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    const loc = getLocalizedValue(val, currentLang);
    return typeof loc === 'string' ? loc.trim() : (loc ? String(loc).trim() : fallback);
  }
  return String(val).trim();
};

const rfqSettings = await fetchRfqSettings();
const rawMacroImage = (typeof propMacroImage === 'string' ? propMacroImage.trim() : (propMacroImage?.asset?.url || DEFAULT_SPEC_MATRIX.macroImage));
const macroImage = SanityImageService.macro(rawMacroImage, 600, 400, 'crop');
const macroSrcSet = SanityImageService.srcSet(rawMacroImage, [360, 480, 600, 900], { aspectRatio: 2 / 3, fit: 'crop', quality: 72 });
const primaryButtonText = toText(propPrimaryText) || getLocalizedValue(rfqSettings?.heroSwatchBtnText, currentLang, t('hero.requestSwatch'));
const safeSecondaryText = toText(secondaryButtonText, DEFAULT_SPEC_MATRIX.secondaryButtonText);
const resolvedSecondaryText = (safeSecondaryText && safeSecondaryText !== DEFAULT_SPEC_MATRIX.secondaryButtonText) ? safeSecondaryText : (currentLang !== 'en' ? t('hero.exploreLineSheets') : safeSecondaryText);

const isSwatchButton = (primaryButtonText || "").toLowerCase().includes("swatch") || primaryButtonUrl === "#inquiry";
const showPrimaryButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowPrimary,
  settingOverride: rfqSettings?.showSpecsPrimaryButton,
  isSwatchAction: isSwatchButton,
  globalSwatchSetting: rfqSettings?.showSwatchKitButton,
  buttonText: primaryButtonText,
});

const showSecondaryButton = RfqSettingsService.isButtonVisible({
  propOverride: propShowSecondary,
  settingOverride: rfqSettings?.showSpecsSecondaryButton,
  buttonText: resolvedSecondaryText,
});

// Clean accidental index numbers from CMS text (e.g. "Construction1", "Matrix2", "3We treat")
const cleanBadge = toText(badge).replace(/\d+$/, "").trim();
const cleanTitle = toText(title).replace(/\d+$/, "").trim();
const cleanDescription = toText(description).replace(/^\d+/, "").trim();
const sectionId = elementId || sectionAnchor || 'specs';
---

<section id={sectionId} class="specs-section bg-surface border-t border-hairline">
  <div class="apple-rail-bento flex flex-col">
    <!-- Header: Editorial Serif Typography on Narrow Rail (980px) - Centered -->
    <div class="apple-rail-narrow text-center mb-12 lg:mb-16 space-y-3">
      <span class="text-xs font-medium uppercase tracking-[0.14em] text-muted block">
        {cleanBadge || "Technical Architecture"}
      </span>
      <h2 class="fluid-section-title font-display font-medium text-ink">
        {cleanTitle || "Crafted to the micron."}
      </h2>
      <p class="text-[15px] sm:text-[17px] font-normal text-muted max-w-2xl mx-auto leading-relaxed">
        {cleanDescription || "Every thread engineered for retail longevity & zero friction."}
      </p>
    </div>

    <!-- Architectural Bento Grid: Left Large Image + Right 4 Spec Blocks on Desktop, Scroll Shelf on Mobile -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-3 pt-1 no-scrollbar lg:grid lg:grid-cols-12 lg:grid-rows-2 lg:gap-5 lg:overflow-visible lg:p-0 items-stretch">
      <!-- Left: Large Image Card (Span 6 cols / 2 rows) -->
      <div class="shrink-0 w-[84vw] max-w-[340px] snap-start min-h-[340px] lg:h-full lg:w-full lg:max-w-none lg:shrink lg:snap-align-none lg:col-span-6 lg:row-span-2 lg:col-start-1 lg:row-start-1 bg-elevated rounded-[var(--gv-radius-card)] p-6 xl:p-7 flex flex-col justify-between border border-hairline group">
        <div class="flex-shrink-0 space-y-1.5">
          <span class="text-xs font-medium uppercase tracking-[0.12em] text-muted min-w-0 truncate block">{bento1Tag}</span>
          <h3 class="text-lg sm:text-xl font-medium tracking-tight text-ink">
            {bento1Title}
          </h3>
          <p class="text-[14px] sm:text-[15px] text-muted max-w-xl font-normal leading-relaxed">
            {bento1Description}
          </p>
        </div>
        <div class="apple-skeleton-surface relative mt-5 rounded-lg overflow-hidden bg-surface border border-hairline aspect-[16/10] lg:flex-1 lg:min-h-[220px] w-full">
          <img
            src={macroImage}
            srcset={macroSrcSet || undefined}
            sizes="(max-width: 640px) 320px, (max-width: 1024px) 480px, 600px"
            width="600"
            height="400"
            alt="Macro ribbed textile texture"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            loading="lazy"
            decoding="async"
            onload="this.parentElement && (this.parentElement.classList.add('apple-img-loaded'), this.parentElement.classList.remove('is-shimmer-active'), window.__unobserveAppleShimmer && window.__unobserveAppleShimmer(this.parentElement))"
          />
        </div>
      </div>

      <!-- Right Top-Left: Block 1 - 0mm Seamless Toe -->
      <div class="shrink-0 w-[84vw] max-w-[340px] snap-start min-h-[240px] lg:h-full lg:w-full lg:max-w-none lg:shrink lg:snap-align-none lg:col-span-3 lg:col-start-7 lg:row-start-1 bg-elevated rounded-[var(--gv-radius-card)] p-6 xl:p-7 flex flex-col justify-between border border-hairline">
        <div>
          <div class="flex items-center justify-between gap-2 min-w-0">
            <span class="text-xs font-medium uppercase tracking-[0.12em] text-muted min-w-0 truncate">{bento2Tag}</span>
            <span class="shrink-0 max-w-[55%] truncate px-2.5 py-0.5 rounded text-xs font-mono bg-surface text-muted border border-hairline inline-flex items-center">
              {bento2BadgeStatus}
            </span>
          </div>

          <div class="mt-3 flex items-baseline gap-1.5">
            <span class="text-3xl xl:text-4xl font-semibold tracking-tight text-ink">{bento2Stat}</span>
            <span class="text-sm xl:text-base font-medium text-muted">{bento2Unit}</span>
          </div>

          <h3 class="mt-2 text-base sm:text-[17px] font-medium text-ink truncate">{bento2Title}</h3>
          <p class="mt-1.5 text-[14px] sm:text-[15px] text-muted font-normal leading-relaxed">
            {bento2Description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-hairline text-xs text-muted font-medium flex items-center justify-between gap-2 min-w-0">
          <span class="min-w-0 truncate">{bento2BadgeText}</span>
          <span class="font-mono text-xs shrink-0">0.0mm Flat</span>
        </div>
      </div>

      <!-- Right Top-Right: Block 2 - Gauge Precision (Lonati) -->
      <div class="shrink-0 w-[84vw] max-w-[340px] snap-start min-h-[240px] lg:h-full lg:w-full lg:max-w-none lg:shrink lg:snap-align-none lg:col-span-3 lg:col-start-10 lg:row-start-1 bg-elevated rounded-[var(--gv-radius-card)] p-6 xl:p-7 flex flex-col justify-between border border-hairline">
        <div>
          <div class="flex items-center justify-between gap-2 min-w-0">
            <span class="text-xs font-medium uppercase tracking-[0.12em] text-muted min-w-0 truncate">{bento3Tag}</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface text-muted border border-hairline shrink-0">Lonati</span>
          </div>
          <div class="mt-3 flex items-baseline gap-1.5">
            <span class="text-3xl xl:text-4xl font-semibold tracking-tight text-ink">{bento3Stat}</span>
            <span class="text-sm xl:text-base font-medium text-muted">{bento3Unit}</span>
          </div>
          <h3 class="mt-2 text-base sm:text-[17px] font-medium text-ink truncate">{bento3Title}</h3>
          <p class="mt-1.5 text-[14px] sm:text-[15px] text-muted font-normal leading-relaxed">
            {bento3Description}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-xs text-muted min-w-0 truncate">
          {bento3FooterNote}
        </div>
      </div>

      <!-- Right Bottom-Left: Block 3 - Elasticity & Welt (Lycra) -->
      <div class="shrink-0 w-[84vw] max-w-[340px] snap-start min-h-[240px] lg:h-full lg:w-full lg:max-w-none lg:shrink lg:snap-align-none lg:col-span-3 lg:col-start-7 lg:row-start-2 bg-elevated rounded-[var(--gv-radius-card)] p-6 xl:p-7 flex flex-col justify-between border border-hairline">
        <div>
          <div class="flex items-center justify-between gap-2 min-w-0">
            <span class="text-xs font-medium uppercase tracking-[0.12em] text-muted min-w-0 truncate">{bento4Tag}</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface text-muted border border-hairline shrink-0">Lycra®</span>
          </div>
          <div class="mt-3 flex items-baseline gap-1.5">
            <span class="text-3xl xl:text-4xl font-semibold tracking-tight text-ink">{bento4Stat}</span>
            <span class="text-sm xl:text-base font-medium text-muted">{bento4Unit}</span>
          </div>
          <h3 class="mt-2 text-base sm:text-[17px] font-medium text-ink truncate">{bento4Title}</h3>
          <p class="mt-1.5 text-[14px] sm:text-[15px] text-muted font-normal leading-relaxed">
            {bento4Description}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-xs text-muted min-w-0 truncate">
          {bento4FooterNote}
        </div>
      </div>

      <!-- Right Bottom-Right: Block 4 - Rapid Dispatch (DHL Air) -->
      <div class="shrink-0 w-[84vw] max-w-[340px] snap-start min-h-[240px] lg:h-full lg:w-full lg:max-w-none lg:shrink lg:snap-align-none lg:col-span-3 lg:col-start-10 lg:row-start-2 bg-elevated rounded-[var(--gv-radius-card)] p-6 xl:p-7 flex flex-col justify-between border border-hairline">
        <div>
          <div class="flex items-center justify-between gap-2 min-w-0">
            <span class="text-xs font-medium uppercase tracking-[0.12em] text-muted min-w-0 truncate">{bento5Tag}</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface text-muted border border-hairline shrink-0">DHL Air</span>
          </div>
          <div class="mt-3 flex items-baseline gap-1.5">
            <span class="text-3xl xl:text-4xl font-semibold tracking-tight text-ink">{bento5Stat}</span>
            <span class="text-sm xl:text-base font-medium text-muted">{bento5Unit}</span>
          </div>
          <h3 class="mt-2 text-base sm:text-[17px] font-medium text-ink truncate">{bento5Title}</h3>
          <p class="mt-1.5 text-[14px] sm:text-[15px] text-muted font-normal leading-relaxed">
            {bento5Description}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-xs text-muted min-w-0 truncate">
          {bento5FooterNote}
        </div>
      </div>
    </div>

    <!-- Mobile Swipe Visual Hint -->
    <div class="flex lg:hidden items-center justify-center gap-1.5 pt-3 text-xs font-medium text-muted">
      <span>{t('specs.swipeHint')}</span>
      <span aria-hidden="true">→</span>
    </div>

    <!-- Bottom Actions: Clean Dual Pills on Narrow Rail -->
    <div class="apple-rail-narrow flex flex-col sm:flex-row items-center justify-center gap-3 pt-10 shrink-0">
      {showPrimaryButton && (
        <a
          href={getLocalizedPath(primaryButtonUrl, currentLang)}
          data-swatch-sku={swatchSku}
          class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-ink text-canvas text-sm font-medium hover:opacity-85 transition-opacity text-center"
        >
          {primaryButtonText}
        </a>
      )}
      {showSecondaryButton && (
        <a
          href={getLocalizedPath(secondaryButtonUrl, currentLang)}
          class="w-full sm:w-auto px-6 py-2.5 rounded-full text-ink text-sm font-medium hover:bg-elevated border border-hairline transition-colors text-center"
        >
          {resolvedSecondaryText}
        </a>
      )}
    </div>
  </div>
</section>
