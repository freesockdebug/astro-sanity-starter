{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-sanity-starter",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "SANITY_PROJECT_ID": "",
    "SANITY_DATASET": "production",
    "PUBLIC_TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "",
    "ADMIN_EMAILS": "forhaisome@gmail.com",
    "LOGTO_ENDPOINT": "",
    "LOGTO_APP_ID": "",
    "LOGTO_M2M_APP_ID": "",
    "LOGTO_MANAGEMENT_RESOURCE": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b",
      "database_id": "ee9bf95f-2f23-4df7-aea4-cb81346473dd"
    }
  ],
  "observability": {
    "enabled": true
  }
}