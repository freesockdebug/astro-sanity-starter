---
// src/pages/orders/index.astro
import Layout from '@layouts/Layout.astro';
import BuyerLayout from '@layouts/BuyerLayout.astro';
import LocalTime from '@components/LocalTime.astro';
import { getSessionFromRequest } from '@utils/auth';
import { getOrdersByUserId, claimOrdersByEmail, listAdminOrders, getUserByIdOrEmail, type OrderRecord } from '@utils/db';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@i18n';
import { fetchNormalizedProducts } from '@data/products';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, max-age=0, must-revalidate');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const sessionUser = await getSessionFromRequest(Astro, cfEnv);

const viewMode = Astro.url.searchParams.get('view') || 'my';
const currentStatus = Astro.url.searchParams.get('status') || 'ALL';
const currentSearch = (Astro.url.searchParams.get('search') || '').trim().toLowerCase();

let myOrders: OrderRecord[] = [];
let allOrders: OrderRecord[] = [];
let claimedCount = 0;
let dbUser: any = null;

if (sessionUser) {
  // Session invalidation guard: check if user is BLOCKED in D1 (fail-safe non-blocking)
  try {
    dbUser = await getUserByIdOrEmail(sessionUser.id, sessionUser.email);
    if (dbUser && dbUser.status === 'BLOCKED') {
      Astro.cookies.delete('gwenvenni_session', { path: '/' });
      return Astro.redirect('/api/auth/login?error=account_suspended');
    }
  } catch (e) {
    // Non-blocking: never break order list rendering if user lookup fails
  }

  try {
    claimedCount = await claimOrdersByEmail(sessionUser.email, sessionUser.id);
  } catch (e) {
    // Non-blocking
  }
  myOrders = await getOrdersByUserId(sessionUser.id, sessionUser.email);

  if (sessionUser.isAdmin) {
    const adminRes = await listAdminOrders({ limit: 100 });
    allOrders = adminRes.orders;
  }
}

// Active dataset based on viewMode
const isViewingAll = sessionUser?.isAdmin && viewMode === 'all';
let rawActiveOrders = isViewingAll ? allOrders : myOrders;

// Status counts based on the active dataset
const stats = {
  all: rawActiveOrders.length,
  pending: rawActiveOrders.filter((o) => o.status === 'PENDING_APPROVAL').length,
  approved: rawActiveOrders.filter((o) => o.status === 'APPROVED').length,
  shipped: rawActiveOrders.filter((o) => o.status === 'SHIPPED').length,
  rejected: rawActiveOrders.filter((o) => o.status === 'REJECTED').length,
};

// Apply status filter
let filteredOrders = rawActiveOrders;
if (currentStatus !== 'ALL') {
  filteredOrders = filteredOrders.filter((o) => o.status === currentStatus);
}

// Apply search filter
if (currentSearch) {
  filteredOrders = filteredOrders.filter((o) => {
    const matchNo = o.order_no.toLowerCase().includes(currentSearch);
    const matchEmail = o.buyer_email.toLowerCase().includes(currentSearch);
    const matchCompany = (o.company_name || '').toLowerCase().includes(currentSearch);
    const matchCountry = (o.destination_country || '').toLowerCase().includes(currentSearch);
    const matchNotes = (o.customer_notes || '').toLowerCase().includes(currentSearch);
    const matchItems = (o.items || []).some((item) =>
      item.title.toLowerCase().includes(currentSearch) || (item.sku || '').toLowerCase().includes(currentSearch)
    );
    return matchNo || matchEmail || matchCompany || matchCountry || matchNotes || matchItems;
  });
}

const products = await fetchNormalizedProducts().catch(() => []);
const productMap = new Map<string, { image: string; slug: string }>();
(products || []).forEach((p) => {
  if (p?.id) productMap.set(p.id, { image: p.image, slug: p.id });
});

const pageTitle = t('orders.metaTitle');
const pageDesc = t('orders.metaDesc');

const resolveItemImage = (item: any) => {
  if (item?.image_url && item.image_url.trim()) {
    return item.image_url.replace('https://cdn.sanity.io', '/cdn-image');
  }
  const pid = item?.product_id ? String(item.product_id).trim() : '';
  if (pid && productMap.has(pid)) {
    return productMap.get(pid)!.image;
  }
  const str = `${item?.title || ''} ${item?.sku || ''} ${pid}`.toLowerCase();
  if (str.includes('spec') || str.includes('pdf') || str.includes('dossier')) {
    return '/images/spec-light.webp';
  }
  if (str.includes('ruffle') || str.includes('gv-ru') || str.includes('lace')) {
    return '/images/products/gv-ruffle-detail.webp';
  }
  return '/images/hero-light.webp';
};

const getItemProductUrl = (item: any) => {
  const pid = item?.product_id ? String(item.product_id).trim() : '';
  if (!pid) return null;
  if (pid.startsWith('spec-')) return getLocalizedPath(`/products/${pid.replace(/^spec-/, '')}`, currentLang);
  if (pid === 'swatch-kit-sample' || pid.startsWith('swatch-')) return getLocalizedPath('/#collection', currentLang);
  return getLocalizedPath(`/products/${pid}`, currentLang);
};
---

{sessionUser ? (
  <BuyerLayout
    title={pageTitle}
    description={pageDesc}
    currentTab="orders"
    sessionUser={sessionUser}
    dbUser={dbUser}
    totalOrdersCount={rawActiveOrders.length}
  >
    <div class="space-y-6">
          
          <!-- Admin View Mode Switcher & Auto Claim Banner -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            {sessionUser.isAdmin ? (
              <div class="flex items-center gap-1.5 p-1 bg-white rounded-xl border border-black/5 shadow-2xs self-start sm:self-auto">
                <a
                  href={getLocalizedPath(`/orders?view=my${currentStatus !== 'ALL' ? `&status=${currentStatus}` : ''}`, currentLang)}
                  class={`px-3 py-1 rounded-lg text-xs font-medium transition-all ${
                    !isViewingAll
                      ? 'bg-[#1d1d1f] text-white shadow-xs'
                      : 'text-[#86868b] hover:text-black'
                  }`}
                >
                  {t('orders.myOrders')} ({myOrders.length})
                </a>
                <a
                  href={getLocalizedPath(`/orders?view=all${currentStatus !== 'ALL' ? `&status=${currentStatus}` : ''}`, currentLang)}
                  class={`px-3 py-1 rounded-lg text-xs font-medium transition-all ${
                    isViewingAll
                      ? 'bg-[#1d1d1f] text-white shadow-xs'
                      : 'text-[#86868b] hover:text-black'
                  }`}
                >
                  {t('orders.allPlatformOrders')} ({allOrders.length})
                </a>
              </div>
            ) : (
              <div class="flex items-center gap-2 text-[#86868b]">
                <span>{t('orders.totalOrders')}: <strong class="text-[#1d1d1f] font-mono tabular-nums">{myOrders.length}</strong></span>
                <span>·</span>
                <span class="text-emerald-700 font-medium">{t('orders.autoClaimActive')}</span>
              </div>
            )}
          </div>

          <!-- Auto-Claim Notification Banner if claimed -->
          {claimedCount > 0 && (
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl p-3 flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{t('orders.claimedSuccess')}</span>
            </div>
          )}

          <!-- Filter & Search Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <!-- Status Tabs -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
              {[
                { key: 'ALL', label: t('orders.tabAll'), count: stats.all },
                { key: 'PENDING_APPROVAL', label: t('orders.tabPending'), count: stats.pending },
                { key: 'APPROVED', label: t('orders.tabApproved'), count: stats.approved },
                { key: 'SHIPPED', label: t('orders.tabShipped'), count: stats.shipped },
                { key: 'REJECTED', label: t('orders.tabRejected'), count: stats.rejected },
              ].map((tab) => {
                const isActive = currentStatus === tab.key;
                const viewParam = isViewingAll ? '&view=all' : '';
                const searchParam = currentSearch ? `&search=${encodeURIComponent(currentSearch)}` : '';
                const href = getLocalizedPath(`/orders?status=${tab.key}${viewParam}${searchParam}`, currentLang);

                return (
                  <a
                    href={href}
                    class={`px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all border ${
                      isActive
                        ? 'bg-[#1d1d1f] text-white border-black shadow-xs'
                        : 'bg-white text-[#52525b] border-black/5 hover:border-black/20 hover:text-black'
                    }`}
                  >
                    <span>{tab.label}</span>
                    <span class={`ml-1 font-mono text-[11px] tabular-nums ${isActive ? 'text-white/80' : 'text-[#86868b]'}`}>
                      ({tab.count})
                    </span>
                  </a>
                );
              })}
            </div>

            <!-- Search Form -->
            <form method="GET" action={getLocalizedPath('/orders', currentLang)} class="relative sm:w-64">
              {isViewingAll && <input type="hidden" name="view" value="all" />}
              {currentStatus !== 'ALL' && <input type="hidden" name="status" value={currentStatus} />}
              <input
                type="text"
                name="search"
                value={currentSearch}
                placeholder={t('orders.searchPlaceholder')}
                class="w-full pl-8 pr-7 py-1.5 rounded-xl bg-white border border-black/10 focus:outline-none focus:border-black text-xs"
              />
              <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              {currentSearch && (
                <a
                  href={getLocalizedPath(`/orders?${isViewingAll ? 'view=all&' : ''}${currentStatus !== 'ALL' ? `status=${currentStatus}` : ''}`, currentLang)}
                  class="absolute right-2.5 top-2 text-xs text-[#86868b] hover:text-black"
                >
                  ✕
                </a>
              )}
            </form>
          </div>

          <!-- Empty Orders List -->
          {filteredOrders.length === 0 && (
            <div class="bg-white rounded-2xl border border-black/5 p-12 text-center shadow-sm">
              <div class="w-12 h-12 mx-auto rounded-full bg-[#f5f5f7] flex items-center justify-center text-[#86868b] mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-base font-semibold mb-1">
                {currentSearch || currentStatus !== 'ALL' ? t('orders.noMatching') : t('orders.noOrders')}
              </h3>
              <p class="text-xs text-[#86868b] max-w-sm mx-auto mb-5">
                {currentSearch || currentStatus !== 'ALL'
                  ? t('orders.noMatchingDesc')
                  : t('orders.noOrdersDesc')}
              </p>
              {currentSearch || currentStatus !== 'ALL' ? (
                <a
                  href={getLocalizedPath(`/orders${isViewingAll ? '?view=all' : ''}`, currentLang)}
                  class="inline-flex items-center px-4 py-2 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all"
                >
                  {t('orders.clearFilters')}
                </a>
              ) : (
                <a
                  href={getLocalizedPath('/#collection', currentLang)}
                  class="inline-flex items-center px-5 py-2 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all"
                >
                  {t('orders.exploreStyles')}
                </a>
              )}
            </div>
          )}

          <!-- Orders List: Intrinsic Self-Organizing Grid -->
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,32rem),1fr))] gap-[clamp(1rem,0.5rem+1vw,1.5rem)] items-start">
            {filteredOrders.map((order) => {
              const isPending = order.status === 'PENDING_APPROVAL';
              const isApproved = order.status === 'APPROVED';
              const isShipped = order.status === 'SHIPPED';
              const isRejected = order.status === 'REJECTED';

              return (
                <div class="bg-white rounded-2xl border border-black/5 p-[clamp(1.125rem,0.8rem+0.8vw,1.5rem)] space-y-4 shadow-sm transition-all hover:shadow-md order-card-container">
                
                <!-- Print Requisition Sheet Header (Visible only when printed) -->
                <div class="hidden print:block border-b border-black/20 pb-4 mb-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <h2 class="text-xl font-bold font-mono tracking-tight text-[#1d1d1f]">GWENVENNI ATELIER</h2>
                      <p class="text-[10px] text-zinc-500 font-sans">B2B Sample & Procurement Requisition Sheet · www.gwenvenni.com</p>
                    </div>
                    <div class="text-right text-[11px] font-mono text-zinc-600">
                      <p class="font-bold text-[#1d1d1f]">{order.order_no}</p>
                      <p>Date: <LocalTime datetime={order.created_at} /></p>
                    </div>
                  </div>
                  <div class="mt-3 pt-2 border-t border-black/10 grid grid-cols-2 text-xs">
                    <div>
                      <p class="text-[11px] text-zinc-500">Buyer Company: <strong class="text-[#1d1d1f] font-sans">{order.company_name || order.buyer_email}</strong></p>
                      <p class="text-[11px] text-zinc-500">Contact / Email: <strong class="text-[#1d1d1f] font-sans">{order.contact_name || order.buyer_email}</strong></p>
                    </div>
                    <div class="text-right">
                      <p class="text-[11px] text-zinc-500">Destination: <strong class="text-[#1d1d1f] font-sans">{order.destination_country || t('orders.worldwide')}</strong></p>
                      <p class="text-[11px] text-zinc-500">Total Quantity: <strong class="text-[#1d1d1f] font-mono">{order.total_quantity} {t('orders.pcs')}</strong></p>
                    </div>
                  </div>
                </div>

                <!-- Order Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3.5 border-b border-black/5 text-xs">
                  <div>
                    <div class="flex items-center gap-2.5">
                      <span class="font-mono font-semibold text-sm tracking-tight text-[#1d1d1f]">
                        {order.order_no}
                      </span>
                      <button
                        type="button"
                        class="copy-btn text-[#86868b] hover:text-black transition-colors cursor-pointer"
                        data-copy={order.order_no}
                        title={t('orders.copy')}
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                    <p class="text-[#86868b] text-[11px] font-mono mt-0.5">
                      {t('orders.submitted')}: <LocalTime datetime={order.created_at} />
                    </p>
                  </div>

                  <!-- Status Badge -->
                  <div>
                    {isPending && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                        {t('orders.statusPending')}
                      </span>
                    )}
                    {isApproved && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800 border border-blue-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                        {t('orders.statusApproved')}
                      </span>
                    )}
                    {isShipped && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        {t('orders.statusShipped')}
                      </span>
                    )}
                    {isRejected && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
                        {t('orders.statusRejected')}
                      </span>
                    )}
                  </div>
                </div>

                <!-- 4-Step Order Progress Stepper -->
                {!isRejected ? (
                  <div class="py-2.5 px-3 bg-[#fbfbfd] rounded-xl border border-black/5">
                    <div class="relative flex items-center justify-between">
                      <!-- Background Track & Progress Fill -->
                      <div class="absolute left-6 right-6 top-1/2 -translate-y-1/2 h-0.5 bg-black/10 -z-0">
                        <div
                          class="h-full bg-emerald-500 transition-all duration-300"
                          style={`width: ${isShipped ? '66.67%' : isApproved ? '33.33%' : '0%'}`}
                        ></div>
                      </div>

                      <!-- Step 1: Submitted -->
                      <div class="relative z-10 flex flex-col items-center">
                        <div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold shadow-2xs">
                          ✓
                        </div>
                        <span class="text-[10px] font-medium text-[#1d1d1f] mt-1.5 whitespace-nowrap">{t('orders.stepSubmitted')}</span>
                      </div>

                      <!-- Step 2: Under Review / Approved -->
                      <div class="relative z-10 flex flex-col items-center">
                        <div class:list={[
                          'w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold shadow-2xs transition-all',
                          (isApproved || isShipped)
                            ? 'bg-emerald-500 text-white'
                            : 'bg-amber-400 text-white ring-4 ring-amber-100 animate-pulse'
                        ]}>
                          {(isApproved || isShipped) ? '✓' : '2'}
                        </div>
                        <span class:list={[
                          'text-[10px] mt-1.5 whitespace-nowrap',
                          (isApproved || isShipped) ? 'font-medium text-[#1d1d1f]' : 'font-semibold text-amber-700'
                        ]}>
                          {(isApproved || isShipped) ? t('orders.stepApproved') : t('orders.stepInReview')}
                        </span>
                      </div>

                      <!-- Step 3: Dispatched -->
                      <div class="relative z-10 flex flex-col items-center">
                        <div class:list={[
                          'w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold shadow-2xs transition-all',
                          isShipped
                            ? 'bg-emerald-500 text-white ring-4 ring-emerald-100'
                            : 'bg-white border-2 border-black/20 text-[#86868b]'
                        ]}>
                          {isShipped ? '✓' : '3'}
                        </div>
                        <span class:list={[
                          'text-[10px] mt-1.5 whitespace-nowrap',
                          isShipped ? 'font-semibold text-emerald-700' : 'text-[#86868b]'
                        ]}>
                          {t('orders.stepDispatched')}
                        </span>
                      </div>

                      <!-- Step 4: Delivered -->
                      <div class="relative z-10 flex flex-col items-center">
                        <div class="w-6 h-6 rounded-full bg-white border-2 border-black/20 text-[#86868b] flex items-center justify-center text-[10px] font-bold shadow-2xs">
                          4
                        </div>
                        <span class="text-[10px] text-[#86868b] mt-1.5 whitespace-nowrap">{t('orders.stepDelivered')}</span>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="bg-rose-50 border border-rose-200 rounded-xl p-3 flex items-center gap-2.5 text-xs text-rose-800">
                    <svg class="w-4 h-4 shrink-0 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <div>
                      <span class="font-semibold">Order Inquiry Closed</span>
                      {order.admin_remark && <span class="ml-1 text-rose-700">· {order.admin_remark}</span>}
                    </div>
                  </div>
                )}

                <!-- Shipping & Logistics Card (If Shipped) -->
                {isShipped && (
                  <div class="bg-[#f5f5f7] rounded-xl p-3.5 border border-black/5 text-xs space-y-1.5">
                    <div class="flex items-center justify-between">
                      <span class="font-semibold text-[#1d1d1f]">{t('orders.carrierTracking')}:</span>
                      <span class="text-[#86868b] font-mono text-[11px]">{t('orders.shippedAt')}: {order.shipped_at ? <LocalTime datetime={order.shipped_at} /> : t('orders.recently')}</span>
                    </div>
                    <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
                      <div class="flex items-center gap-4">
                        <div>
                          <span class="text-[#86868b]">{t('orders.carrier')}:</span>{' '}
                          <strong class="text-[#1d1d1f]">{order.carrier || 'Standard Express'}</strong>
                        </div>
                        {order.tracking_number && (
                          <div class="flex items-center gap-1.5">
                            <span class="text-[#86868b]">{t('orders.trackingNo')}:</span>
                            <span class="font-mono font-semibold text-[#1d1d1f]">{order.tracking_number}</span>
                            <button
                              type="button"
                              class="copy-btn text-[#86868b] hover:text-black transition-colors cursor-pointer"
                              data-copy={order.tracking_number}
                              title={t('orders.copyTracking')}
                            >
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                              </svg>
                            </button>
                          </div>
                        )}
                      </div>
                      {order.tracking_number && (
                        <a
                          href={`https://t.17track.net/en#nums=${encodeURIComponent(order.tracking_number)}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 text-[11px] font-semibold text-blue-600 hover:text-blue-800 hover:underline print:hidden"
                        >
                          <span>Track on 17TRACK</span>
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                    </div>
                    {order.admin_remark && (
                      <p class="text-[11px] text-[#52525b] border-t border-black/5 pt-1 mt-1">
                        {t('orders.note')}: {order.admin_remark}
                      </p>
                    )}
                  </div>
                )}

                <!-- Rejection Note (If Rejected) -->
                {isRejected && order.admin_remark && (
                  <div class="bg-rose-50 rounded-xl p-3 border border-rose-200 text-xs text-rose-800">
                    <strong>{t('orders.rejectionReason')}:</strong> {order.admin_remark}
                  </div>
                )}

                <!-- Items Table -->
                <div class="divide-y divide-black/5">
                  {(order.items || []).map((item) => {
                    const itemUrl = getItemProductUrl(item);
                    const itemImg = resolveItemImage(item);
                    return (
                      <div
                        class="order-item-row py-2.5 flex items-center justify-between text-xs gap-3"
                        data-product-id={item.product_id || ''}
                        data-sku={item.sku || ''}
                        data-title={item.title || ''}
                        data-variant={item.variant || ''}
                        data-quantity={item.quantity || 1}
                        data-image={itemImg}
                      >
                        <div class="flex items-center gap-3 min-w-0">
                          {itemUrl ? (
                            <a
                              href={itemUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="shrink-0 group block"
                              title={`View ${item.title}`}
                            >
                              <img
                                src={itemImg}
                                alt={item.title}
                                class="w-10 h-10 rounded-lg object-cover bg-[#f5f5f7] border border-black/5 group-hover:border-black/30 transition-all shrink-0"
                                loading="lazy"
                              />
                            </a>
                          ) : (
                            <img
                              src={itemImg}
                              alt={item.title}
                              class="w-10 h-10 rounded-lg object-cover bg-[#f5f5f7] border border-black/5 shrink-0"
                              loading="lazy"
                            />
                          )}
                          <div class="min-w-0">
                            {itemUrl ? (
                              <a
                                href={itemUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-medium text-[#1d1d1f] hover:text-black hover:underline truncate block inline-flex items-center gap-1 group"
                              >
                                <span class="truncate">{item.title}</span>
                                <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity shrink-0 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                              </a>
                            ) : (
                              <p class="font-medium text-[#1d1d1f] truncate">{item.title}</p>
                            )}
                            <p class="text-[11px] text-[#86868b] truncate font-mono">
                              {item.sku ? `${item.sku} · ` : ''}{item.variant || t('orders.standardSpec')}
                            </p>
                          </div>
                        </div>
                        <div class="font-mono tabular-nums font-semibold text-right shrink-0">
                          {item.quantity} {t('orders.pcs')}
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Footer Summary & Actions -->
                <div class="pt-3.5 border-t border-black/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                  <div class="flex items-center gap-3 text-[11px] text-[#86868b] flex-wrap">
                    <span>{t('orders.destination')}: <strong class="text-[#1d1d1f]">{order.destination_country || t('orders.worldwide')}</strong></span>
                    <span>·</span>
                    <span>{t('orders.totalQuantity')}: <strong class="text-[#1d1d1f] font-mono tabular-nums">{order.total_quantity} {t('orders.pcs')}</strong></span>
                    {order.customer_notes && (
                      <>
                        <span>·</span>
                        <span class="truncate max-w-[200px] text-zinc-500 italic" title={order.customer_notes}>"{order.customer_notes}"</span>
                      </>
                    )}
                  </div>

                  <!-- Actions: Reorder, Print, Track -->
                  <div class="flex items-center gap-2 flex-wrap order-actions print:hidden shrink-0">
                    {isShipped && order.tracking_number && (
                      <a
                        href={`https://t.17track.net/en#nums=${encodeURIComponent(order.tracking_number)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 transition-all shadow-2xs"
                      >
                        <span>{t('orders.actionTrack')}</span>
                        <svg class="w-3 h-3 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )}

                    <button
                      type="button"
                      class="reorder-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-2xs cursor-pointer active:scale-95"
                    >
                      <span>{t('orders.actionReorder')}</span>
                    </button>

                    <button
                      type="button"
                      class="print-order-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-[#52525b] hover:text-[#1d1d1f] bg-white hover:bg-[#f5f5f7] border border-black/10 transition-all shadow-2xs cursor-pointer active:scale-95"
                    >
                      <span>{t('orders.actionPrint')}</span>
                    </button>
                  </div>
                </div>

                <!-- Print Sign-off Line (Visible only on print) -->
                <div class="hidden print:flex items-center justify-between pt-8 text-xs text-zinc-600 border-t border-black/15 mt-6 font-mono">
                  <div>Authorized Signature: _______________________</div>
                  <div>Date: _______________________</div>
                </div>

              </div>
            );
          })}
          </div>

        </div>
    </BuyerLayout>
  ) : (
    <Layout title={pageTitle} description={pageDesc}>
      <main class="min-h-screen bg-[#f5f5f7] pt-24 pb-20 text-[#1d1d1f]">
        <div class="max-w-[90rem] mx-auto px-[clamp(1rem,0.4rem+2.5vw,3rem)]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-black/5 gap-4">
            <div>
              <nav class="flex items-center gap-2 text-xs text-[#86868b] mb-1">
                <a href={getLocalizedPath('/', currentLang)} class="hover:text-black transition-colors">{t('nav.home')}</a>
                <span>/</span>
                <span class="text-[#1d1d1f] font-medium">{t('orders.breadcrumb')}</span>
              </nav>
              <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
                {t('orders.title')}
              </h1>
            </div>
          </div>

          <div class="mt-12 bg-white rounded-2xl border border-black/5 p-8 sm:p-12 text-center max-w-xl mx-auto shadow-sm">
            <div class="w-16 h-16 mx-auto rounded-full bg-[#f5f5f7] flex items-center justify-center text-[#1d1d1f] mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h2 class="text-xl font-semibold mb-2">{t('orders.unauthHeading')}</h2>
            <p class="text-sm text-[#86868b] max-w-md mx-auto mb-6 leading-relaxed">
              {t('orders.unauthDesc')}
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a
                href={`/api/auth/login?returnUrl=${encodeURIComponent(Astro.url.pathname)}`}
                id="orders-signin-btn"
                class="w-full sm:w-auto px-6 py-2.5 rounded-full text-xs font-semibold bg-[#1d1d1f] text-white hover:bg-black transition-all shadow-sm cursor-pointer text-center inline-flex items-center justify-center gap-1.5"
              >
                {t('orders.signInBtn')}
              </a>
              <a
                href={getLocalizedPath('/#collection', currentLang)}
                class="w-full sm:w-auto px-6 py-2.5 rounded-full text-xs font-medium text-[#1d1d1f] bg-[#f5f5f7] hover:bg-black/10 transition-all text-center"
              >
                {t('orders.browseCollections')}
              </a>
            </div>
          </div>
        </div>
      </main>
    </Layout>
  )
}

<style>
  @media print {
    body {
      background: white !important;
    }
    header, nav, footer, #apple-nav, #apple-footer, .print\:hidden, .order-actions {
      display: none !important;
    }
    main {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    .order-card-container {
      border: 1px solid #d4d4d8 !important;
      box-shadow: none !important;
      break-inside: avoid;
      page-break-inside: avoid;
      margin-bottom: 2rem !important;
      width: 100% !important;
    }
  }
</style>

<script>
  // Copy buttons
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span style="color:#10b981;font-size:10px;">✓</span>';
        setTimeout(() => {
          btn.innerHTML = originalHtml;
        }, 1500);
      } catch (err) {
        // ignore
      }
    });
  });

  // Reorder buttons: read order items from card DOM and push into QuoteDrawer
  document.querySelectorAll<HTMLButtonElement>('.reorder-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const card = btn.closest('.order-card-container');
        if (!card) return;
        const itemRows = card.querySelectorAll<HTMLElement>('.order-item-row');
        if (!itemRows.length) return;

        itemRows.forEach((row) => {
          if ((window as any).addToQuote) {
            (window as any).addToQuote({
              id: row.dataset.productId || row.dataset.sku || 'reorder-item',
              title: row.dataset.title || 'Reorder Item',
              sku: row.dataset.sku || '',
              imageUrl: row.dataset.image || '',
              variant: row.dataset.variant || 'Standard Spec',
              quantity: parseInt(row.dataset.quantity || '1', 10) || 1,
            });
          }
        });

        if ((window as any).openQuoteDrawer) {
          (window as any).openQuoteDrawer();
        }
      } catch (e) {
        console.warn('Reorder failed:', e);
      }
    });
  });

  // Print order sheet
  document.querySelectorAll<HTMLButtonElement>('.print-order-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.order-card-container');
      const allCards = document.querySelectorAll('.order-card-container');
      
      // Temporarily mark non-target cards as print:hidden
      if (card) {
        allCards.forEach((c) => {
          if (c !== card) c.classList.add('print:hidden');
        });
      }

      window.print();

      // Reset after print dialog
      if (card) {
        allCards.forEach((c) => c.classList.remove('print:hidden'));
      }
    });
  });
</script>
