---
// src/pages/admin/dicts.astro
// Universal Data Dictionary Control Center (Saltline Table-Driven Edition)
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageToolbar from '@components/admin/AdminPageToolbar.astro';
import { requireAdminContext } from '@utils/auth';
import { listDictGroups } from '@utils/db';
import { getAllCachedDictItems } from '@utils/dicts';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { sessionUser, adminContext, pendingOrdersCount, redirectResponse } = await requireAdminContext(
  Astro,
  cfEnv,
  '/admin/dicts',
  { requiredMenu: 'dicts' }
);
if (redirectResponse) return redirectResponse;

const [groups, allItems] = await Promise.all([
  listDictGroups(),
  getAllCachedDictItems(cfEnv),
]);

const initialGroup = Astro.url.searchParams.get('group') || (groups[0]?.code || 'shipping_carriers');
const activeGroupObj = groups.find((g) => g.code === initialGroup);

const BADGE_COLORS: [string, string, string][] = [
  ['slate', 'Slate', 'bg-slate-100 text-slate-800 border-slate-300'],
  ['blue', 'Blue', 'bg-blue-100 text-blue-800 border-blue-300'],
  ['emerald', 'Emerald', 'bg-emerald-100 text-emerald-800 border-emerald-300'],
  ['amber', 'Amber', 'bg-amber-100 text-amber-800 border-amber-300'],
  ['purple', 'Purple', 'bg-purple-100 text-purple-800 border-purple-300'],
  ['rose', 'Rose', 'bg-rose-100 text-rose-800 border-rose-300'],
  ['indigo', 'Indigo', 'bg-indigo-100 text-indigo-800 border-indigo-300'],
];
---

<AdminLayout
  title="Data Dictionaries"
  currentTab="dicts"
  sessionEmail={sessionUser.email}
  adminName={adminContext?.name}
  roleName={adminContext?.role?.name}
  roleCode={adminContext?.role?.code}
  menus={adminContext?.menus}
  permissions={adminContext?.permissions}
  dataScope={adminContext?.dataScope}
  pendingOrdersCount={pendingOrdersCount}
>
  <AdminPageToolbar
    title="Data Dictionaries"
    badge="Universal Engine"
    badgeColor="purple"
    subtitle="Manage shipping carriers, multi-scene quick replies, customer tiers, CRM tags, and SLA thresholds without code deployments"
    icon="🏷️"
    class="mb-5"
  >
    <div slot="actions">
      <button id="btn-add-item" type="button" class="adm-btn-primary">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <span>Add Dictionary Item</span>
      </button>
    </div>
  </AdminPageToolbar>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start" id="dicts-root" data-initial-group={initialGroup}>
    <!-- Left Column: Dictionary Group Directory -->
    <div class="lg:col-span-4 adm-card p-3.5 space-y-3">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f]">Dictionary Categories</h2>
        <span class="text-[10px] text-[#86868b] font-mono">{groups.length} groups</span>
      </div>
      <input type="text" id="group-search" placeholder="Filter categories..." class="adm-input py-1.5" />
      <div id="groups-list" class="space-y-1">
        {groups.map((g) => {
          const isActive = g.code === initialGroup;
          return (
            <button
              type="button"
              class={`w-full text-left p-3 rounded-xl border transition-all cursor-pointer group-btn flex items-start justify-between gap-2 ${
                isActive ? 'bg-black text-white border-black shadow-xs font-semibold' : 'bg-white hover:bg-[#f5f5f7] border-transparent text-[#1d1d1f]'
              }`}
              data-group-code={g.code}
              data-group-name={g.name}
              data-group-desc={g.description}
            >
              <div class="min-w-0">
                <div class="text-xs truncate flex items-center gap-1.5">
                  <span>{g.name}</span>
                  {g.is_system && <span class={`text-[9px] px-1 py-0.2 rounded font-mono ${isActive ? 'bg-white/20 text-white' : 'bg-black/5 text-[#86868b]'}`}>SYS</span>}
                </div>
                <p class={`text-[11px] truncate mt-0.5 ${isActive ? 'text-white/70' : 'text-[#86868b]'}`}>{g.code}</p>
              </div>
              <span class={`text-[10px] px-1.5 py-0.5 rounded-md font-mono shrink-0 ${isActive ? 'bg-white/20 text-white' : 'bg-[#f0f0f2] text-[#52525b]'}`}>
                {g.enabled_count}/{g.items_count}
              </span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Right Column: Dictionary Items Workbench Table -->
    <div class="lg:col-span-8 adm-card overflow-hidden flex flex-col">
      <div class="p-4 sm:p-5 border-b border-black/5 bg-[#fafafa] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <h3 id="current-group-title" class="text-sm sm:text-base font-bold text-[#1d1d1f] tracking-tight">{activeGroupObj?.name || 'Dictionary Items'}</h3>
            <span id="current-group-code-badge" class="px-2 py-0.5 rounded text-[10px] font-mono bg-black/5 text-[#52525b]">{initialGroup}</span>
          </div>
          <p id="current-group-desc" class="text-xs text-[#86868b] mt-0.5">{activeGroupObj?.description || 'Configurable key-value dictionary items.'}</p>
        </div>
      </div>

      <div class="overflow-x-auto min-h-[360px]">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-black/5 bg-[#fbfbfd]">
              <th class="adm-th w-14 text-center">Order</th>
              <th class="adm-th">Item Key</th>
              <th class="adm-th">Visual Label & Badge</th>
              <th class="adm-th">Extended Properties (Meta)</th>
              <th class="adm-th w-24 text-center">Status</th>
              <th class="adm-th w-24 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="dict-items-tbody" class="divide-y divide-black/5 font-sans"></tbody>
        </table>
        <div id="no-items-empty" class="hidden p-10 text-center text-xs text-[#86868b]">
          No dictionary items found for this category. Click "+ Add Dictionary Item" above to add one.
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="dicts-ssr-data" set:html={JSON.stringify({ allItems })}></script>

  <!-- Add / Edit Item Modal -->
  <Fragment slot="modals">
    <dialog id="dict-item-dialog" class="backdrop:bg-black/40 backdrop:backdrop-blur-xs rounded-2xl p-0 shadow-2xl border border-black/10 bg-white w-full max-w-lg m-auto">
      <div class="p-5 sm:p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-black/5 pb-3">
          <div class="flex items-center gap-2">
            <span class="text-base">🏷️</span>
            <h3 id="modal-title" class="text-sm font-bold text-[#1d1d1f]">Add Dictionary Item</h3>
          </div>
          <button id="btn-close-modal" type="button" class="text-zinc-400 hover:text-black text-lg cursor-pointer">✕</button>
        </div>

        <form id="dict-item-form" class="space-y-3.5">
          <input type="hidden" id="form-group-code" name="group_code" value={initialGroup} />
          <div>
            <label class="adm-label">Item Key (Unique Key) *</label>
            <input type="text" id="form-item-key" name="item_key" required placeholder="e.g. dhl, VIP, swatch_request" class="adm-input font-mono" />
            <p class="text-[10px] text-[#86868b] mt-0.5">Code identifier stored in database records.</p>
          </div>
          <div>
            <label class="adm-label">Display Label *</label>
            <input type="text" id="form-item-label" name="item_label" required placeholder="e.g. DHL Express, VIP Commercial" class="adm-input" />
          </div>

          <div>
            <label class="adm-label mb-1.5">Visual Badge Color</label>
            <div class="grid grid-cols-4 min-[1760px]:grid-cols-7 gap-1.5">
              {BADGE_COLORS.map(([name, label, cls]) => (
                <label class="flex flex-col items-center gap-1 p-1.5 rounded-xl border border-black/10 hover:border-black/30 cursor-pointer text-center color-option">
                  <input type="radio" name="badge_color" value={name} class="sr-only" />
                  <span class={`w-4 h-4 rounded-full border ${cls} inline-block`}></span>
                  <span class="text-[10px] text-[#52525b] font-medium">{label}</span>
                </label>
              ))}
            </div>
          </div>

          <div id="dynamic-meta-fields" class="space-y-3 pt-1 border-t border-black/5"></div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label class="adm-label">Sort Order</label>
              <input type="number" id="form-sort-order" name="sort_order" value="100" class="adm-input font-mono" />
            </div>
            <div class="flex items-center pt-5">
              <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-[#1d1d1f]">
                <input type="checkbox" id="form-is-enabled" name="is_enabled" checked class="w-4 h-4 rounded accent-black text-black cursor-pointer" />
                <span>Enable Dictionary Item</span>
              </label>
            </div>
          </div>

          <div id="form-error" class="hidden p-2.5 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200"></div>

          <div class="flex items-center justify-end gap-2 pt-3 border-t border-black/5">
            <button id="btn-cancel-modal" type="button" class="adm-btn-secondary">Cancel</button>
            <button id="btn-submit-modal" type="submit" class="adm-btn-primary">Save Dictionary Item</button>
          </div>
        </form>
      </div>
    </dialog>
  </Fragment>
</AdminLayout>

<script>
  import { $id, $val, $chk, $txt, escapeHtml, syncUrlParams } from '@utils/adminWorkbench';
  import { getBadgeColorClasses } from '@utils/dicts';

  // Saltline Table-Driven Meta Schema: [metaKey, label, type, placeholderOrOptions, defaultVal, hint]
  type MetaFieldSpec = [string, string, 'text' | 'textarea' | 'number' | 'select', string | [string, string][], any, string?];
  const META_SCHEMA: Record<string, MetaFieldSpec[]> = {
    shipping_carriers: [
      ['tracking_url', 'Tracking URL Template', 'text', 'https://example.com/track?no={tracking}', '', 'Use {tracking} or {tracking_no} placeholder.'],
    ],
    quick_replies: [
      ['scene', 'Reply Scene Category *', 'select', [['approval', 'Order Approval (通过)'], ['shipping', 'Shipping / Dispatch (发货)'], ['rejection', 'Order Rejection (驳回)']], 'approval'],
      ['content', 'Template Content *', 'textarea', 'Enter standard English reply message...', ''],
    ],
    customer_tiers: [
      ['discount_label', 'Discount Tagline / Tier Notice', 'text', 'e.g. 15% Volume Tier', ''],
      ['description', 'Tier Benefits Description', 'text', 'e.g. Priority dispatch and custom fabric specialist', ''],
    ],
    order_statuses: [
      ['sla_hours', 'SLA Alert Threshold (Hours)', 'number', '24', '', 'Orders in this status exceeding this duration trigger urgent SLA warning tags.'],
    ],
    audit_actions: [
      ['risk_level', 'Action Risk Level', 'select', [['LOW', 'LOW (Normal Activity)'], ['MEDIUM', 'MEDIUM (Privilege/Assignment Change)'], ['HIGH', 'HIGH (Deletion / Account Lockout)']], 'LOW'],
    ],
  };

  function initDictsPage() {
    const root = $id('dicts-root');
    const ssrEl = $id('dicts-ssr-data');
    if (!root || !ssrEl) return;

    let allItems: any[] = [];
    try { allItems = JSON.parse(ssrEl.textContent || '{}').allItems || []; } catch {}
    let currentGroup = root.dataset.initialGroup || 'shipping_carriers';

    const tbody = $id('dict-items-tbody');
    const emptyEl = $id('no-items-empty');
    const dialog = $id<HTMLDialogElement>('dict-item-dialog');
    const formError = $id('form-error');

    const toast = (msg: string, ok = true) => (window as any).__showToast?.(msg, ok ? 'success' : 'error');

    const formatMetaSummary = (meta: any) => {
      if (!meta) return '<span class="text-[10px] text-zinc-300">-</span>';
      if (meta.tracking_url) return `<span class="font-mono text-[10px] text-zinc-500 truncate max-w-xs block">${escapeHtml(meta.tracking_url)}</span>`;
      if (meta.scene && meta.content) return `<div class="space-y-0.5"><span class="px-1 py-0.2 rounded text-[9px] bg-black/5 font-semibold uppercase">${escapeHtml(meta.scene)}</span><span class="text-[11px] text-zinc-600 italic block line-clamp-1">"${escapeHtml(meta.content)}"</span></div>`;
      if (meta.discount_label) return `<span class="text-[11px] font-semibold text-emerald-700">${escapeHtml(meta.discount_label)}</span>`;
      if (meta.sla_hours) return `<span class="text-[11px] font-mono font-semibold text-amber-700">SLA: ${escapeHtml(meta.sla_hours)}h threshold</span>`;
      const keys = Object.keys(meta);
      return keys.length ? `<span class="text-[10px] font-mono text-zinc-400">${keys.length} attributes</span>` : '<span class="text-[10px] text-zinc-300">-</span>';
    };

    const renderItemsTable = () => {
      if (!tbody) return;
      const filtered = allItems
        .filter((i) => i.group_code.toLowerCase() === currentGroup.toLowerCase())
        .sort((a, b) => (a.sort_order ?? 100) - (b.sort_order ?? 100));

      emptyEl?.classList.toggle('hidden', filtered.length > 0);
      tbody.innerHTML = filtered.map((item) => {
        const isEnabled = Boolean(item.is_enabled);
        const g = escapeHtml(item.group_code);
        const k = escapeHtml(item.item_key);
        return `<tr class="hover:bg-[#fbfbfd] transition-colors">
          <td class="adm-td text-center font-mono text-zinc-400">${item.sort_order}</td>
          <td class="adm-td font-mono font-bold text-[#1d1d1f]">${k}</td>
          <td class="adm-td"><span class="inline-flex items-center px-2 py-0.5 rounded-md border text-xs font-semibold ${getBadgeColorClasses(item.badge_color)}">${escapeHtml(item.item_label)}</span></td>
          <td class="adm-td">${formatMetaSummary(item.meta)}</td>
          <td class="adm-td text-center">
            <button type="button" data-action="toggle" data-group="${g}" data-key="${k}" data-enabled="${isEnabled}" class="px-2 py-0.5 rounded-full text-[10px] font-semibold transition-all cursor-pointer ${isEnabled ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-zinc-100 text-zinc-500 border border-zinc-200'}">
              ${isEnabled ? '● Active' : '○ Inactive'}
            </button>
          </td>
          <td class="adm-td text-right space-x-1">
            <button type="button" data-action="edit" data-group="${g}" data-key="${k}" class="p-1 text-zinc-400 hover:text-black hover:bg-black/5 rounded-lg transition-colors cursor-pointer" title="Edit Item">✎</button>
            <button type="button" data-action="delete" data-group="${g}" data-key="${k}" class="p-1 text-zinc-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Delete Item">🗑</button>
          </td>
        </tr>`;
      }).join('');
    };

    const renderDynamicMetaFields = (groupCode: string, meta: Record<string, any> = {}) => {
      const container = $id('dynamic-meta-fields');
      if (!container) return;
      const specs = META_SCHEMA[groupCode] || [];
      container.innerHTML = specs.map(([key, label, type, phOrOpts, defVal, hint]) => {
        const val = meta[key] ?? defVal ?? '';
        let control = '';
        if (type === 'select' && Array.isArray(phOrOpts)) {
          control = `<select data-meta-key="${key}" class="adm-input font-semibold">${phOrOpts.map(([v, l]) => `<option value="${escapeHtml(v)}" ${val === v ? 'selected' : ''}>${escapeHtml(l)}</option>`).join('')}</select>`;
        } else if (type === 'textarea') {
          control = `<textarea data-meta-key="${key}" rows="3" placeholder="${escapeHtml(phOrOpts)}" class="adm-input">${escapeHtml(val)}</textarea>`;
        } else {
          control = `<input type="${type}" data-meta-key="${key}" value="${escapeHtml(val)}" placeholder="${escapeHtml(phOrOpts)}" class="adm-input ${type === 'number' || key === 'tracking_url' ? 'font-mono' : ''}" />`;
        }
        return `<div><label class="adm-label">${escapeHtml(label)}</label>${control}${hint ? `<p class="text-[10px] text-[#86868b] mt-0.5">${escapeHtml(hint)}</p>` : ''}</div>`;
      }).join('');
    };

    const selectColorRadio = (color: string) => {
      document.querySelectorAll<HTMLElement>('.color-option').forEach((label) => {
        const radio = label.querySelector<HTMLInputElement>('input[type="radio"]');
        const matched = radio?.value === color;
        if (radio) radio.checked = matched;
        label.classList.toggle('border-black', matched);
        label.classList.toggle('bg-[#f5f5f7]', matched);
        label.classList.toggle('ring-1', matched);
        label.classList.toggle('ring-black', matched);
      });
    };

    document.querySelectorAll<HTMLElement>('.color-option').forEach((label) => {
      label.addEventListener('click', () => {
        const r = label.querySelector<HTMLInputElement>('input[type="radio"]');
        if (r) selectColorRadio(r.value);
      });
    });

    const openModal = (editItem?: any) => {
      if (!dialog) return;
      formError?.classList.add('hidden');
      $val('form-group-code', currentGroup);
      const keyInput = $id<HTMLInputElement>('form-item-key');
      if (keyInput) keyInput.disabled = Boolean(editItem);

      $txt('modal-title', editItem ? 'Edit Dictionary Item' : 'Add Dictionary Item');
      $val('form-item-key', editItem ? editItem.item_key : '');
      $val('form-item-label', editItem ? editItem.item_label : '');
      $val('form-sort-order', editItem ? editItem.sort_order ?? 100 : 100);
      $chk('form-is-enabled', editItem ? Boolean(editItem.is_enabled) : true);
      selectColorRadio(editItem?.badge_color || 'slate');
      renderDynamicMetaFields(currentGroup, editItem?.meta || {});
      dialog.showModal();
    };

    tbody?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
      if (!btn) return;
      const { action, group: g = '', key: k = '' } = btn.dataset;
      if (action === 'edit') {
        const item = allItems.find((i) => i.group_code === g && i.item_key === k);
        if (item) openModal(item);
      } else if (action === 'toggle') {
        const nextEnabled = btn.dataset.enabled !== 'true';
        btn.disabled = true;
        try {
          const res = await fetch('/api/admin/dicts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'toggle_enabled', groupCode: g, itemKey: k, isEnabled: nextEnabled }),
          });
          const data: any = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'Failed to toggle status');
          allItems.forEach((i) => { if (i.group_code === g && i.item_key === k) i.is_enabled = nextEnabled; });
          renderItemsTable();
          toast(data.message || 'Status updated');
        } catch (err: any) {
          toast(err.message, false);
          btn.disabled = false;
        }
      } else if (action === 'delete') {
        if (!confirm(`Are you sure you want to delete dictionary item "${k}"?`)) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/admin/dicts/${encodeURIComponent(g)}?itemKey=${encodeURIComponent(k)}`, { method: 'DELETE' });
          const data: any = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'Delete failed');
          allItems = allItems.filter((i) => !(i.group_code === g && i.item_key === k));
          renderItemsTable();
          toast('Item deleted successfully');
        } catch (err: any) {
          toast(err.message, false);
          btn.disabled = false;
        }
      }
    });

    document.querySelectorAll<HTMLElement>('.group-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentGroup = btn.dataset.groupCode || 'shipping_carriers';
        document.querySelectorAll<HTMLElement>('.group-btn').forEach((b) => {
          const active = b.dataset.groupCode === currentGroup;
          b.className = `w-full text-left p-3 rounded-xl border transition-all cursor-pointer group-btn flex items-start justify-between gap-2 ${
            active ? 'bg-black text-white border-black shadow-xs font-semibold' : 'bg-white hover:bg-[#f5f5f7] border-transparent text-[#1d1d1f]'
          }`;
        });
        $txt('current-group-title', btn.dataset.groupName || '');
        $txt('current-group-code-badge', currentGroup);
        $txt('current-group-desc', btn.dataset.groupDesc || '');
        syncUrlParams({ group: currentGroup }, { group: '' }, false);
        renderItemsTable();
      });
    });

    $id<HTMLInputElement>('group-search')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('.group-btn').forEach((btn) => {
        const matched = (btn.dataset.groupName || '').toLowerCase().includes(q) || (btn.dataset.groupCode || '').toLowerCase().includes(q);
        btn.style.display = matched ? '' : 'none';
      });
    });

    $id('btn-add-item')?.addEventListener('click', () => openModal());
    $id('btn-close-modal')?.addEventListener('click', () => dialog?.close());
    $id('btn-cancel-modal')?.addEventListener('click', () => dialog?.close());

    $id('dict-item-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError?.classList.add('hidden');
      const groupCode = $val('form-group-code') || currentGroup;
      const itemKey = $val('form-item-key');
      const itemLabel = $val('form-item-label');
      const sortOrder = parseInt($val('form-sort-order') || '100', 10);
      const isEnabled = $chk('form-is-enabled');
      const badgeColor = document.querySelector<HTMLInputElement>('input[name="badge_color"]:checked')?.value || 'slate';

      const meta: Record<string, any> = {};
      (META_SCHEMA[groupCode] || []).forEach(([k, , type]) => {
        const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-meta-key="${k}"]`);
        const v = el?.value.trim() || '';
        if (type === 'number') { if (v) meta[k] = Number(v); }
        else if (v) meta[k] = v;
      });

      const submitBtn = $id<HTMLButtonElement>('btn-submit-modal');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/dicts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'upsert_item', groupCode, itemKey, itemLabel, badgeColor, meta, sortOrder, isEnabled }),
        });
        const data: any = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save dictionary item');

        const idx = allItems.findIndex((i) => i.group_code === groupCode && i.item_key === itemKey);
        const updated = { group_code: groupCode, item_key: itemKey, item_label: itemLabel, badge_color: badgeColor, meta, sort_order: sortOrder, is_enabled: isEnabled };
        if (idx >= 0) allItems[idx] = updated;
        else allItems.push(updated);

        renderItemsTable();
        dialog?.close();
        toast(data.message || 'Saved successfully');
      } catch (err: any) {
        if (formError) {
          formError.textContent = err.message;
          formError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    renderItemsTable();
  }

  initDictsPage();
  document.addEventListener('shell:page-load', () => {
    if (document.getElementById('dicts-root')) initDictsPage();
  });
</script>