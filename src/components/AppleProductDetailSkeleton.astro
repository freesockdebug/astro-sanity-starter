---
// src/components/AppleProductDetailSkeleton.astro
interface Props {
  id?: string;
  class?: string;
}

const {
  id = 'pdp-skeleton',
  class: className = '',
} = Astro.props;

const thumbItems = [0, 1, 2, 3, 4];
const tierItems = [0, 1, 2];
const specCards = [0, 1, 2, 3, 4, 5];
---

<div
  id={id}
  role="status"
  aria-label="Loading product specifications and media"
  aria-busy="true"
  class:list={['apple-pdp-skeleton w-full bg-[#fdfcfb] select-none pointer-events-none', className]}
>
  <!-- 1. First-Screen Hero Overview Skeleton (Matches 12-Col Loro Piana Editorial Split below Breadcrumbs) -->
  <section class="w-full pt-3 pb-6 sm:py-6 md:py-8 lg:py-6 xl:py-8 2xl:py-10 border-b border-stone-200/70 bg-[#fdfcfb]">
    <!-- Center 12-Column Split Grid Skeleton -->
    <div class="apple-rail-bento w-full">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 md:gap-7 lg:gap-10 xl:gap-14 items-start">
        <!-- LEFT COLS: Vertical/Horizontal Thumb Rail + Main Gallery Canvas -->
        <div class="w-full min-w-0 md:col-span-6 lg:col-span-7 flex flex-col space-y-2 sm:space-y-2.5 lg:grid lg:grid-cols-[56px_minmax(0,1fr)] xl:grid-cols-[64px_minmax(0,1fr)] lg:gap-3 lg:space-y-0">
          <!-- Main Gallery Stage -->
          <div class="relative w-full max-w-full min-w-0 aspect-square sm:aspect-[4/3] md:aspect-square max-h-[min(50svh,360px)] sm:max-h-[min(54svh,430px)] md:max-h-[min(56svh,460px)] lg:aspect-auto lg:h-[clamp(340px,calc(100svh-var(--apple-header-offset)-3rem),640px)] lg:max-h-none lg:col-start-2 lg:row-start-1 rounded-xl sm:rounded-2xl overflow-hidden bg-[#f6f3ee] apple-skeleton-warm border border-stone-200/60">
            <!-- Bottom-Right Minimal Counter Pill Placeholder -->
            <div class="absolute bottom-3.5 right-3.5 h-4 w-10 rounded-full bg-stone-900/15"></div>
          </div>

          <!-- Thumbnail Strip (Horizontal below mobile/tablet, Left Vertical on lg+) -->
          <div class="flex flex-row lg:col-start-1 lg:row-start-1 lg:flex-col gap-2 sm:gap-2.5 overflow-hidden shrink-0 w-full max-w-full pb-0.5 lg:pb-0 justify-start">
            {thumbItems.map((idx) => (
              <div
                class:list={[
                  'shrink-0 w-11 h-11 sm:w-13 sm:h-13 lg:w-14 lg:h-14 xl:w-16 xl:h-16 rounded-lg sm:rounded-xl bg-[#f6f3ee] apple-skeleton-warm border',
                  idx === 0 ? 'border-stone-400/60 opacity-100' : 'border-transparent opacity-55',
                ]}
              ></div>
            ))}
          </div>
        </div>

        <!-- RIGHT COLS: Hairline Architectural Details (divide-y divide-stone-200/75) -->
        <div class="w-full min-w-0 md:col-span-6 lg:col-span-5 flex flex-col divide-y divide-stone-200/75">
          <!-- Block A: Eyebrow, Title & Tagline -->
          <div class="pb-3.5 sm:pb-4 lg:pb-3.5 xl:pb-5 space-y-2.5">
            <div class="flex items-center gap-2">
              <div class="h-3.5 w-20 rounded-sm apple-skeleton-warm"></div>
              <div class="h-3.5 w-24 rounded-sm apple-skeleton-warm"></div>
              <div class="h-3.5 w-28 rounded-sm apple-skeleton-warm"></div>
            </div>
            <div class="space-y-1.5 pt-1">
              <div class="h-6 sm:h-8 w-4/5 rounded-lg apple-skeleton-warm"></div>
              <div class="h-3.5 w-full rounded-md apple-skeleton-warm"></div>
              <div class="h-3.5 w-2/3 rounded-md apple-skeleton-warm"></div>
            </div>
          </div>

          <!-- Block B: Horizontal 3-Col Volume Tier Pricing Matrix -->
          <div class="py-3.5 sm:py-4 lg:py-3.5 xl:py-4.5 space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="h-3 w-28 rounded-sm apple-skeleton-warm"></div>
              <div class="h-3 w-16 rounded-sm apple-skeleton-warm"></div>
            </div>
            <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5">
              {tierItems.map(() => (
                <div class="rounded-lg sm:rounded-xl bg-[#f6f3ee]/70 p-2 sm:p-2.5 xl:p-3 space-y-1.5 border border-stone-200/70">
                  <div class="h-2.5 w-12 rounded-sm apple-skeleton-warm"></div>
                  <div class="h-5 w-16 rounded-md apple-skeleton-warm"></div>
                </div>
              ))}
            </div>
          </div>

          <!-- Block C: Circular Yarn Swatches Skeleton -->
          <div class="py-3.5 sm:py-4 lg:py-3.5 xl:py-4.5 space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="h-3 w-24 rounded-sm apple-skeleton-warm"></div>
              <div class="h-3 w-16 rounded-sm apple-skeleton-warm"></div>
            </div>
            <div class="flex items-center gap-2.5 sm:gap-3 pt-0.5">
              {thumbItems.map(() => (
                <div class="w-8 h-8 sm:w-7 sm:h-7 rounded-full apple-skeleton-warm border border-black/10"></div>
              ))}
            </div>
          </div>

          <!-- Block D: 3-Col Quick Specs Skeleton -->
          <div class="py-3 sm:py-3.5 xl:py-4">
            <div class="grid grid-cols-3 gap-2 sm:gap-3">
              {tierItems.map(() => (
                <div class="space-y-1">
                  <div class="h-2.5 w-12 rounded-sm apple-skeleton-warm"></div>
                  <div class="h-3.5 w-20 rounded-sm apple-skeleton-warm"></div>
                </div>
              ))}
            </div>
          </div>

          <!-- Block E: Primary & Secondary Action Buttons Skeleton -->
          <div class="pt-3.5 sm:pt-4 lg:pt-3.5 xl:pt-5 space-y-2.5">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2 gap-2 sm:gap-2.5">
              <div class="h-10 sm:h-11 w-full rounded-full apple-skeleton-warm"></div>
              <div class="h-10 sm:h-11 w-full rounded-full apple-skeleton-warm"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Below-the-Fold Editorial Craftsmanship & Product Story Skeleton -->
  <section class="py-10 sm:py-14 bg-white border-t border-black/5">
    <div class="apple-rail-bento space-y-6">
      <div class="space-y-3 pb-5 border-b border-black/5">
        <div class="h-3.5 w-28 rounded-full apple-skeleton"></div>
        <div class="h-7 sm:h-8 w-72 rounded-lg apple-skeleton"></div>
      </div>
      <div class="space-y-4 max-w-4xl">
        <div class="h-4 w-full rounded-sm apple-skeleton"></div>
        <div class="h-4 w-5/6 rounded-sm apple-skeleton"></div>
        <div class="h-4 w-3/4 rounded-sm apple-skeleton"></div>
        <div class="h-32 w-full rounded-xl apple-skeleton-warm my-4"></div>
      </div>
    </div>
  </section>
</div>
